{"slug":"The-Lost-Front-Silent-Aim-Open-Source-70512","_id":"6928873ebcda4f31979640de","title":"Silent Aim Open Source","game":{"_id":"68f30663e86c46a58a7a6247","gameId":102871156420149,"name":"The Lost Front","imageUrl":"/images/sb/rbx-c20f81d3ea5a7cf3309c672ccbdcea95-40b739727cbe.png","placeId":102871156420149},"features":"--Discord_Server : discord.gg/nJaZ88C3zE\n--KeyAuth_Server : discord.gg/ZHkDavggqB","tags":["HihiHub","Open Source","Open Src","Silent Aim"],"script":"--by Hihihub\n--Discord_Server : discord.gg/nJaZ88C3zE\n--KeyAuth_Server : discord.gg/ZHkDavggqB\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Camera = workspace.CurrentCamera\n\nlocal function getClosestTarget(maxFov)\n    local closest, closestDist = nil, maxFov or 25\n\n    for _,plr in ipairs(Players:GetPlayers()) do\n        if plr ~= LocalPlayer and plr.Character then\n            local hrp = plr.Character:FindFirstChild(\"HumanoidRootPart\")\n            if hrp then\n                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)\n                if onScreen then\n                    local dist = (Vector2.new(pos.X, pos.Y) - game:GetService(\"UserInputService\"):GetMouseLocation()).Magnitude\n                    if dist < closestDist then\n                        closestDist = dist\n                        closest = hrp\n                    end\n                end\n            end\n        end\n    end\n    return closest\nend\n--so ez\nlocal function patchFireModule(module)\n    for k,fn in pairs(module) do\n        if type(fn) == \"function\" then\n            local info = debug.getinfo(fn)\n            if info.numparams >= 4 then\n                local old = fn\n                module[k] = function(player, gunName, origin, direction, ...)\n                    if player == LocalPlayer and getgenv().SilentAimEnabled then\n                        local target = getClosestTarget(getgenv().SilentAimFov or 100)\n                        if target then\n                            direction = (target.Position - origin).Unit\n                        end\n                    end\n                    return old(player, gunName, origin, direction, ...)\n                end\n            end\n        end\n    end\nend\n\nlocal function init()\n    for _,v in ipairs(getgc(true)) do\n        if type(v) == \"table\" and rawget(v,\"Fire\") then\n            patchFireModule(v)\n        end\n    end\nend\n\ngetgenv().SilentAimEnabled = true\ngetgenv().SilentAimFov = 120\n\ninit()\n","owner":{"_id":"670d26c275fe6368ad58068a","username":"HihiHub","verified":false,"profilePicture":"/images/photo/670d26c275fe6368ad58068a-1732967510227.png","status":"offline","id":"670d26c275fe6368ad58068a","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":3518,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/102871156420149-1764263742211.png","likeCount":5,"dislikeCount":3,"createdAt":"2025-11-27T17:15:42.231Z","executes":352,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6928873ebcda4f31979640e0","editBy":{"_id":"670d26c275fe6368ad58068a","username":"HihiHub","status":"offline","id":"670d26c275fe6368ad58068a"},"message":"Create script","createdAt":"2025-11-27T17:15:42.234Z"}],"comments":[{"_id":"69289515e72e29dfc7f1f9ec","commentBy":{"_id":"68c54d7e0985bed96e33514b","username":"CatBoyy","verified":false,"role":"user","profilePicture":"/images/photo/68c54d7e0985bed96e33514b-1757760986018.png","createdAt":"2025-09-13T10:54:54.783Z","lastActive":"2026-03-05T13:24:43.441Z","status":"offline","id":"68c54d7e0985bed96e33514b","topMilestone":{"key":"creator.scripts","tier":25}},"text":"skidding ts thx","edited":false,"likeCount":4,"dislikeCount":0,"createdAt":"2025-11-27T18:14:45.738Z","liked":false,"disliked":false},{"_id":"69289be525171dff04218fb8","commentBy":{"_id":"6927ac657c8e2ffae093da67","usern