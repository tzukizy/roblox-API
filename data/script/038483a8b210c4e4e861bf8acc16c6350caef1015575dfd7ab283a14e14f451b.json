{"slug":"Universal-Script-Korblox-All-136498","_id":"69b1508311afc6c1a5d281d5","title":"Korblox All","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"simple korblox script\nworks on R15 and R6\nhas colors","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer or Players:GetPropertyChangedSignal(\"LocalPlayer\"):Wait()\n\n-- Asset IDs\nlocal KORBLOX_MESH_ID = \"rbxassetid://101851696\"\nlocal KORBLOX_TEXTURE_ID = \"rbxassetid://101851254\" -- Your requested dark grey texture\nlocal DARK_GREY_COLOR = Color3.fromRGB(64, 64, 64)\n\nlocal function applyKorblox()\n    local char = player.Character\n    if not char then return end\n    local hum = char:FindFirstChildOfClass(\"Humanoid\")\n    if not hum then return end\n\n    if hum.RigType == Enum.HumanoidRigType.R15 then\n        -- R15: MESH SWAP METHOD (Using our successful version)\n        local rf = char:FindFirstChild(\"RightFoot\")\n        local rl = char:FindFirstChild(\"RightLowerLeg\")\n        local ru = char:FindFirstChild(\"RightUpperLeg\")\n\n        if ru and rl and rf then\n            rf.Transparency = 1\n            rl.Transparency = 1\n            \n            -- Apply the mesh and texture directly to the MeshPart\n            ru.MeshId = \"http://www.roblox.com/asset/?id=902942096\"\n            ru.TextureID = \"http://roblox.com/asset/?id=902843398\"\n            ru.Color = Color3.new(1, 1, 1) -- Set to white so texture isn't tinted\n            ru.Transparency = 0\n        end\n        \n    else\n        -- R6: SPECIAL MESH METHOD\n        local rightLeg = char:FindFirstChild(\"Right Leg\")\n        if rightLeg then\n            -- Clean out old meshes/CharacterMeshes\n            for _, v in ipairs(char:GetChildren()) do\n                if v:IsA(\"CharacterMesh\") and v.BodyPart == Enum.BodyPart.RightLeg then\n                    v:Destroy()\n                end\n            end\n            \n            local mesh = rightLeg:FindFirstChildOfClass(\"SpecialMesh\")\n            if not mesh then\n                mesh = Instance.new(\"SpecialMesh\")\n                mesh.Parent = rightLeg\n            end\n            \n            -- Applying your dark grey settings\n            rightLeg.Color = DARK_GREY_COLOR\n            rightLeg.Transparency = 0\n            \n            mesh.MeshType = Enum.MeshType.FileMesh\n            mesh.MeshId = KORBLOX_MESH_ID\n            mesh.TextureId = KORBLOX_TEXTURE_ID\n            mesh.Scale = Vector3.new(1, 1, 1)\n        end\n    end\nend\n\n-- Run continuously to prevent game resets\ntask.spawn(function()\n    while true do\n        if player.Character then\n            applyKorblox()\n        end\n        task.wait(0.5)\n    end\nend)\n\nplayer.CharacterAdded:Connect(applyKorblox)","owner":{"_id":"691b09019d10588c051c4f38","username":"aar0n_exe","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e440fafc53f9fd22966c81927dab4a9d7b5829cec9e2f9d184bafcddcb625c04.webp","original":"https://scriptblox.com/images/photo/691b09019d10588c051c4f38-1764511780666.png"},"status":"offline","id":"691b09019d10588c051c4f38","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/e440fafc53f9fd22966c81927dab4a9d7b5829cec9e2f9d184bafcddcb625c04.webp","original":"https://scriptblox.com/images/photo/691b09019d10588c051c4f38-1764511780666.png"}},"verified":false,"views":5978,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/256927045894db0f38652fcd944363dc4f1ac06f397485398e368456cd074a9d.webp","original":"https://scriptblox.com/images/sb/0-1773228163971.png","scriptblox":"https://scriptblox.com/images/script/0-1773228163971.png"},"likeCount":12,"dislikeCount":3,"crea