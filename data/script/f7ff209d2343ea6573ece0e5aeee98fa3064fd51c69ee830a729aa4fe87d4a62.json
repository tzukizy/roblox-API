PS.Visible = true\nend)\n\nlocal ButtonOff = Instance.new(\"TextButton\")\nButtonOff.Size = UDim2.new(0, 100, 0, 50)\nButtonOff.Position = UDim2.new(0, 100, 0, 0)\nButtonOff.Text = \"Disable Panel\"\nButtonOff.Parent = Frame\nButtonOff.MouseButton1Click:Connect(function()\n    game:GetService(\"Players\").LocalPlayer.PlayerGui.MainGui.PS.Active = false\ngame:GetService(\"Players\").LocalPlayer.PlayerGui.MainGui.PS.Visible = false\nend)\n\nlocal CloseButton = Instance.new(\"TextButton\")\nCloseButton.Size = UDim2.new(1, 0, 0, 50)\nCloseButton.Position = UDim2.new(0, 0, 0, 50)\nCloseButton.Text = \"Close\"\nCloseButton.Parent = Frame\nCloseButton.MouseButton1Click:Connect(function()\n    ScreenGui:Destroy()\nend)\n\nScreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n","features":"Ps panel","tags":[],"discord":"","keyLink":"","owner":{"_id":"66da8cad2130b32c0c8ab7a6","username":"pudge24_or_yuragab","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fa8e21681e8c2d82bd392660bf390cec5e7cf64d3d20933027a00fda529d45f6.webp","original":"https://scriptblox.com/images/photo/66da8cad2130b32c0c8ab7a6-1730461581377.jpg"},"status":"offline","id":"66da8cad2130b32c0c8ab7a6","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/fa8e21681e8c2d82bd392660bf390cec5e7cf64d3d20933027a00fda529d45f6.webp","original":"https://scriptblox.com/images/photo/66da8cad2130b32c0c8ab7a6-1730461581377.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:15:01.748Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53f08","editBy":{"_id":"66da8cad2130b32c0c8ab7a6","username":"pudge24_or_yuragab","status":"offline","id":"66da8cad2130b32c0c8ab7a6"},"message":"Create script","createdAt":"2025-03-27T22:32:55.631Z"}],"comments":