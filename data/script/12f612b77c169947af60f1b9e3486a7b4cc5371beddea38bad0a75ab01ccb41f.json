{"slug":"Universal-Script-Sine-Wave-window-41040","_id":"6833aacabe8455278b3869d7","title":"Sine Wave window","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1748216521964.png","placeId":0},"features":"just waves","tags":["window","cool"],"script":"local RunService = game:FindService(\"RunService\")\n\nlocal t = 0\nlocal amount = 0\nlocal characters = {\"*\", \"-\", \"~\", \".\", \"o\", \"+\", \"x\", \"#\", \"%\", \"@\", \"&\", \"$\", \"^\", \"=\", \"!\"}\n\n\nRunService.RenderStepped:Connect(function()\n    local screen = {}\n    for i = 1, 1760 do\n        screen[i] = \" \"\n    end\n\n    local amplitude = 12\n    local frequency = 0.06\n\n    for x = 0, 80*(amount >= 1 and amount or 1) do\n        local y = math.floor(12 + amplitude * math.sin((x + t) * frequency))\n        local char = characters[(x % #characters) + 1]\n\n        for offset = -2, 2 do\n            local index = x + (y + offset) * 80\n            if index > 0 and index <= #screen then\n                screen[index] = char\n            end\n        end\n    end\n\n    local output = {}\n    for index = 1, #screen do\n        table.insert(output, screen[index])\n        if index % 80 == 0 then\n            table.insert(output, \"\\n\")\n        end\n    end\n\n    print(\"\\n\" .. table.concat(output))\n    rconsoleprint(\"\\n\" .. table.concat(output))\n\n    t += 1\nend)","owner":{"_id":"67954812d999edbadcd05be3","username":"POOIPOOP","verified":false,"profilePicture":"/images/photo/67954812d999edbadcd05be3-1748097053132.png","status":"offline","id":"67954812d999edbadcd05be3","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1435,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1748216521964.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-05-25T23:42:02.008Z","executes":12,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"ch