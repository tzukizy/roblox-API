{"slug":"Fling-Things-and-People-super-throw-open-source-43154","_id":"6858ab276160c66656346a4c","title":"super throw open source","game":{"_id":"67e5e1ffb360710ec3c77d21","gameId":6961824067,"name":"Fling Things and People","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":6961824067},"features":"super throw","tags":[],"script":"local Workspace = game:GetService(\"Workspace\")\nlocal Debris = game:GetService(\"Debris\")\n\nlocal strength = 850\nlocal fling = true\n\nWorkspace.ChildAdded:Connect(function(model)\n    if model.Name == \"GrabParts\" then\n        local partInfo = model:FindFirstChild(\"GrabPart\")\n        if not partInfo then return end\n\n        local weld = partInfo:FindFirstChild(\"WeldConstraint\")\n        if not weld or not weld.Part1 then return end\n\n        local part = weld.Part1\n        local velocity = Instance.new(\"BodyVelocity\")\n        velocity.Parent = part\n\n        model:GetPropertyChangedSignal(\"Parent\"):Connect(function()\n            if not model.Parent then\n                if fling then\n                    velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)\n                    velocity.Velocity = Workspace.CurrentCamera.CFrame.LookVector * strength\n                else\n                    velocity.MaxForce = Vector3.zero\n                end\n                Debris:AddItem(velocity, 1)\n            end\n        end)\n    end\nend)","owner":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b7c227c7d6637a2129f6888d5b89156a38e5e14451be44979f91ced984396df5.webp","original":"https://scriptblox.com/images/photo/67bd8d2e1ec2c16a13a94ae0-1750370853982.jpg"},"status":"offline","id":"67bd8d2e1ec2c16a13a94ae0","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/b7c227c7d6637a2129f6888d5b