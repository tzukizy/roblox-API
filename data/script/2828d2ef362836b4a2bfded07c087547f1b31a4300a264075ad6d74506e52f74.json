nd\nend","features":"Edit/Modify anything you wish with this script. Change the Names in the ToModify table to the name that you want to modify the value for. (Works for mostly all games)","tags":["roblox","robloxscript","robloxhack"],"discord":"","keyLink":"","owner":{"_id":"62b3ebc0b583da04053657a6","username":"azicity23","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62b3ebc0b583da04053657a6","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:23:34.940Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f959","editBy":{"_id":"62b3ebc0b583da04053657a6","username":"azicity23","status":"offline","id":"62b3ebc0b583da04053657a6"},"message":"Create script","createdAt":"2025-03-27T13:06:56.746Z"}],"comments":[{"_id":"64fc965f11498356c53ba56b","commentBy":{"_id":"64ce2dd3f5c7e4b04631cf67","username":"thatonecoolguy","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/dcdb4bde05fa0f726d6409e41a2389b8302d43be30579c8d883784bc0a281aaa.webp","original":"https://scriptblox.com/images/photo/64ce2dd3f5c7e4b04631cf67-1757841111445.jpg"},"createdAt":"2023-08-05T11:09:07.193Z","lastActive":"2025-11-18T12:30:05.394Z","status":"offline","id":"64ce2dd3f5c7e4b04631cf67","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/dcdb4bde05fa0f726d6409e41a2389b8302d43be30579c8d883784bc0a281aaa.webp","original":"https://scriptblox.com/images/photo/64ce2dd3f5c7e4b04631cf67-1757841111445.jpg"}},"text":"on what game did u create this script?","createdAt":"2023-09-09T15:59:27.096Z","edited":true,"likeCount":1,"liked":false,"di