{"slug":"Universal-Script-Modify-Tables-7726","_id":"64fc93bbe3e334bf0f5ef002","title":"Modify Tables","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/6225004-1694274491873.webp","placeId":0},"features":"Edit/Modify anything you wish with this script. Change the Names in the ToModify table to the name that you want to modify the value for. (Works for mostly all games)","tags":["roblox","robloxscript","robloxhack"],"script":"local toModify = {\n  CoinsPerHit = 69999999999,\n  GemsPerHit = 69999999999999,\n} -- stuff you want to modify goes here (for example if you wanted to modify gunRecoilMin you would set gunRecoilMin inside this table to your value)\n\nget_gc_objects = get_gc_objects or getgc\n\nfor i,v in pairs(get_gc_objects(true)) do\nif type(v) == \"table\" then\nif rawget(v, \"CoinsPerHit\") and rawget(v, \"GemsPerHit\") then\n          for k,v2 in pairs(toModify) do\n              rawset(v, k, v2)\n          end\n      end\n  end\nend","owner":{"_id":"62b3ebc0b583da04053657a6","username":"azicity23","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"62b3ebc0b583da04053657a6","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":9395,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-09-09T15:48:11.936Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/6225004-1694274491873.webp","executes":20,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f959","editBy":{"_id":"62b3ebc0b583da04053657a6","username":"azicity23","status":"offline","id":"62b3ebc0b583da04053657a6"},"message":"Create script","createdAt":"2025-03-27T13:06:56.746Z"}],"comments":[{"_id":"64fc965f11498356c53ba56b","commentBy":{"_id":"64ce2dd3f5c7e4b04631cf67","username":"thatonecoolguy","verified":false,"role":"user","profilePicture":"/images/photo/64ce