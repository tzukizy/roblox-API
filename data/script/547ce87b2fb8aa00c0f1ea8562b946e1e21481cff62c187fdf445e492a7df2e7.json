{"slug":"Gear-5-Blue-Lock:-Skibidi-Auto-Nice-Shot-214714","_id":"6a0332a20467c4e0da09626b","title":"Auto Nice Shot","game":{"_id":"692c441a08ad73be3a626697","gameId":77021749781226,"name":"[🎉BACK🎉] Blue Lock: Skibidi","imageUrl":"/images/sb/rbx-c93184c8847361b6dfc564731f7c3c3f-1343515f3587.png","placeId":77021749781226},"features":"Execute it when your in the match\nAnd when the match restarts you need to execute it again\nNeeds aiku and needs to be in the goal box\nThis is also made by chatgpt lol","tags":["Bluelock","Skibidi","Bluelockskibidi"],"script":"local player = game.Players.LocalPlayer\nlocal ball = workspace:WaitForChild(\"Ball\")\nlocal Event = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Events\"):WaitForChild(\"UseMove\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal triggerDistance = 60\nlocal canFire = true\n\nlocal function getHRP()\n    local character = player.Character\n    if not character then return nil end\n    return character:FindFirstChild(\"HumanoidRootPart\")\nend\n\nRunService.RenderStepped:Connect(function()\n    local hrp = getHRP()\n    if not hrp then return end\n\n    local ballPos = ball.Position\n    local distance = (hrp.Position - ballPos).Magnitude\n\n    if distance <= triggerDistance and canFire then\n        canFire = false\n\n        Event:InvokeServer(2, {\n            NiceShot = hrp.Position\n        })\n\n        task.delay(0.2, function()\n            canFire = true\n        end)\n    end\nend)","owner":{"_id":"67a72cb8bf74eb1f6851bfd7","username":"Yesyesyescharoit","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"67a72cb8bf74eb1f6851bfd7","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":3845,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/77021749781226-1778594466219.webp","likeCount":2,"dislikeCount":1,"createdAt":"2026-05-12T14:01:06.256Z","executes":14327,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":12263,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a0332a20467c4e0da09626e","editBy":{"_id":"67a72cb8bf74eb1f6851bfd7","username":"Yesyesyescharoit","status":"offline","id":"67a72cb8bf74eb1f6851bfd7"},"message":"Create script","createdAt":"2026-05-12T14:01:06.258Z"}],"comments":[{"_id":"6a03333384a03bd6bf03b25f","commentBy":{"_id":"69f5aad328fd774412ef7619","username":"noroblox440015","verified":false,"role":"user","profilePicture":"/images/photo/69f5aad328fd774412ef7619-1777707773016.png","lastActive":"2026-05-26T05:46:07.725Z","createdAt":"2026-05-02T07:42:11.198Z","status":"offline","id":"69f5aad328fd774412ef7619","topMilestone":{"key":"creator.first_script","tier":1}},"text":"sir, you got detected of lot of devices. You grouded.","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-12T14:03:31.152Z","liked":false,"disliked":false},{"_id":"6a0337d288a56328e721472f","commentBy":{"_id":"6a033119a2f6b0b9bbca6b66","username":"Bestbecause","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-06-06T06:10:03.347Z","createdAt":"2026-05-12T13:54:33.951Z","status":"offline","id":"6a033119a2f6b0b9bbca6b66"},"text":"Good script bro I literally catched a cr7 kick and a stand shot","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-12T14:23:14.516Z","liked":false,"disliked":false},{"_id":"6a0337f1611fbdd7b4b918ca","commentBy":{"_id":"6a033119a2f6b0b9bbca6b66","username":"Bestbecause","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-06-06T06:10:03.347Z","createdAt":"2026-05-12T13:54:33.951Z","status":"offline","id":"6a033119a2f6b0b9bbca6b66"},"text":"Sometimes it nice shots from full field","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-12T14:23:45.024Z","liked":false,"disliked":false},{"_id":"6a090fdf4de