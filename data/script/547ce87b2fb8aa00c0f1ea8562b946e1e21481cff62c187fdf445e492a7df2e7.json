er = player.Character\n    if not character then return nil end\n    return character:FindFirstChild(\"HumanoidRootPart\")\nend\n\nRunService.RenderStepped:Connect(function()\n    local hrp = getHRP()\n    if not hrp then return end\n\n    local ballPos = ball.Position\n    local distance = (hrp.Position - ballPos).Magnitude\n\n    if distance <= triggerDistance and canFire then\n        canFire = false\n\n        Event:InvokeServer(2, {\n            NiceShot = hrp.Position\n        })\n\n        task.delay(0.2, function()\n            canFire = true\n        end)\n    end\nend)","features":"Execute it when your in the match\nAnd when the match restarts you need to execute it again\nNeeds aiku and needs to be in the goal box\nThis is also made by chatgpt lol","tags":["Bluelock","Skibidi","Bluelockskibidi"],"discord":"","keyLink":"","owner":{"_id":"67a72cb8bf74eb1f6851bfd7","username":"Yesyesyescharoit","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67a72cb8bf74eb1f6851bfd7","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:56:02.840Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a0332a20467c4e0da09626e","editBy":{"_id":"67a72cb8bf74eb1f6851bfd7","username":"Yesyesyescharoit","status":"offline","id":"67a72cb8bf74eb1f6851bfd7"},"message":"Create script","createdAt":"2026-05-12T14:01:06.258Z"}],"comments":[{"_id":"6a03333384a03bd6bf03b25f","commentBy":{"_id":"69f5aad328fd774412ef7619","username":"noroblox440015","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/6e05a57dbbc361a8ceb2f3d84c705529824dfaada6e3d88a40c55ef8032b289f.webp","original":"h