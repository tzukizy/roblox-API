{"slug":"CLUBS!-Illegal-Soccer-INF-Stamina-230865","_id":"6abf4ee731a520be1f609679","title":"INF Stamina","game":{"_id":"6a93fe187092da06cfed4a72","gameId":126987974021910,"name":"Illegal Soccer","imageUrl":"/images/sb/rbx-5c8fd187a58d0b73e505c56b98d50e7a-65bcdd3ce685.png","placeId":126987974021910},"features":"Basically give you INF Stamina","tags":["INF","Stamina","Infinite","Unlimited","Illegal Soccer"],"script":"--pretty much it, simple\n\nlocal updateSprint = filtergc(\"function\", {Name = \"updateSprint\"}, true)\nlocal module = debug.getupvalue(updateSprint, 14)\nlocal Update = module.Update\n\nlocal oldUpdate\n\noldUpdate = hookfunction(Update, function(...)\n    local data = select(2, ...)\n\n    if data and rawget(data, \"HasUnlimitedStamina\") ~= nil then\n        rawset(data, \"HasUnlimitedStamina\", true)\n    end\n\n    return oldUpdate(...)\nend)","owner":{"_id":"66b4bc129f3985ee3d05d3a8","username":"Muhammad_Tanvirul","verified":false,"profilePicture":"/images/photo/66b4bc129f3985ee3d05d3a8-1724688724177.jpg","status":"offline","id":"66b4bc129f3985ee3d05d3a8","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyless":false,"views":1121,"executes":5712,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-e7aae66394912b42be832bf6b8dfe84f-8d3273568320.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-10-02T06:27:51.503Z","reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-06T16:51:23.208Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6abf4ee731a520be1f60967b","editBy":{"_id":"66b4bc129f3985ee3d05d3a8","username":"Muhammad_Tanvirul","status":"offline","id":"66b4bc129f3985ee3d05d3a8"},"message":"Release of INF Stamina","createdAt":"2026-10-02T06:27:51.510Z"}],"comments":[{"_id":"6ac57069c4549e18a2649505","commentBy":{"_id":"666dba6eb68e80a6c3ce56f9","username":"volte