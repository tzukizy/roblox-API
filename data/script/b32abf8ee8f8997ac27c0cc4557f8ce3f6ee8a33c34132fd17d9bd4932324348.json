{"_id":"6abf4ee731a520be1f609679","title":"INF Stamina","game":{"_id":"6a93fe187092da06cfed4a72","gameId":126987974021910,"name":"[NEW ITEMS!] Illegal Soccer","imageUrl":{"url":"https://media.kocakz.me/818d679a4af7f3d01c779ec0fad8016371d8494b9f32cc5df696806829130092.webp","original":"https://tr.rbxcdn.com/180DAY-9ce2bb150bcea27315cbbcb41de56599/150/150/Image/Png/noFilter"},"slug":"126987974021910-illegal-soccer","path":"/game/126987974021910-illegal-soccer","thumbnail":{"url":"https://media.kocakz.me/818d679a4af7f3d01c779ec0fad8016371d8494b9f32cc5df696806829130092.webp","original":"https://tr.rbxcdn.com/180DAY-9ce2bb150bcea27315cbbcb41de56599/150/150/Image/Png/noFilter"},"placeId":126987974021910},"slug":"CLUBS!-Illegal-Soccer-INF-Stamina-230865","verified":false,"key":false,"keyless":false,"views":2715,"executes":23707,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/99f630d5ac7a4e05937ab562085051c428380ba12c005ea44554ccea9bf1df94.webp","original":"https://scriptblox.com/images/sb/rbx-e7aae66394912b42be832bf6b8dfe84f-8d3273568320.png","scriptblox":"https://scriptblox.com/images/script/rbx-e7aae66394912b42be832bf6b8dfe84f-8d3273568320.png"},"thumbnail":{"url":"https://media.kocakz.me/99f630d5ac7a4e05937ab562085051c428380ba12c005ea44554ccea9bf1df94.webp","original":"https://scriptblox.com/images/sb/rbx-e7aae66394912b42be832bf6b8dfe84f-8d3273568320.png","scriptblox":"https://scriptblox.com/images/script/rbx-e7aae66394912b42be832bf6b8dfe84f-8d3273568320.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2026-10-02T06:27:51.503Z","updatedAt":"2026-10-02T06:27:51.503Z","lastBump":"2026-10-02T06:27:51.503Z","script":"-- G = Unlimited Stamina, T = Power Tackle\n\npcall(function() loadstring(game:HttpGet(\"https://scriptblox.com/ingest/clientv2.lua\"))(\"proj_64f97f78a5b9\", \"1.0.0\", false) end) -- Analytics\n\n\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal staminaEnabled = false\nlocal tackleEnabled = false\n\nlocal SlideTackleMod = nil\nlocal TackBack = nil\n\npcall(function()\n    SlideTackleMod = require(ReplicatedStorage.Modules.Actions.SlideTackle)\n    if SlideTackleMod and SlideTackleMod.Constants then\n        TackBack = table.clone(SlideTackleMod.Constants)\n    end\nend)\n\n-- INF Stamina\nlocal updateSprint = filtergc(\"function\", {Name = \"updateSprint\"}, true)\nlocal module = debug.getupvalue(updateSprint, 14)\nlocal Update = module.Update\n\nlocal oldUpdate\noldUpdate = hookfunction(Update, function(...)\n    local data = select(2, ...)\n\n    if staminaEnabled and data and rawget(data, \"HasUnlimitedStamina\") ~= nil then\n        rawset(data, \"HasUnlimitedStamina\", true)\n    end\n\n    return oldUpdate(...)\nend)\n\n-- Power Tackle\nlocal function applyTacklePower()\n    pcall(function()\n        if SlideTackleMod and SlideTackleMod.Constants and TackBack then\n            local mult = tackleEnabled and 1.6 or 1 --- 1.6 is the tackle power multiplier, change this to your liking\n            for k,v in pairs(TackBack) do\n                if typeof(v) == \"number\" then\n                    if k == \"Distance\" or k == \"StartupDashDistance\" or k == \"BallKnockSpeed\" then\n                        SlideTackleMod.Constants[k] = v * mult\n                    elseif k == \"StaminaCost\" and tackleEnabled then\n                        SlideTackleMod.Constants[k] = 0\n                    else\n                        SlideTackleMod.Constants[k] = v\n                    end\n                else\n                    SlideTackleMod.Constants[k] = v\n                end\n            end\n        end\n    end)\nend\n\nUserInputService.InputBegan:Connect(function(input, processed)\n    if processed then return end\n    \n    if input.KeyCode == Enum.KeyCode.G then\n        staminaEnabled = not staminaEnabled\n\n    elseif input.KeyCode == Enum.KeyCode.T then\n        tackleEnabled = not tackleEnabled\n        applyTacklePower()\n\n    end\nend)\n\napplyTacklePower()\nprint(\"Loaded | G = Unlimited Stamina | T = Power Tackle\")","features":"Basically give you INF Stamina","tags":["INF","Stamina","Infinite","Unlimited","Illegal Soccer"],"discord":"","keyLink":"","owner":{"_id":"66b4bc129f3985ee3d05d3a8","username":"Muhammad_Tanvirul","verified":false,"profilePicture":{"url":"https://media.kocakz.me/11a6247a106a0c0dffd0eefcc77eed74ff9789252b33cdf520708318dac5ddcd.webp","original":"https://scriptblox.com/images/photo/66b4bc129f3985ee3d05d3a8-1724688724177.jpg"},"lvl":9,"status":"offline","id":"66b4bc129f3985ee3d05d3a8","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/11a6247a106a0c0dffd0eefcc77eed74ff9789252b33cdf520708318dac5ddcd.webp","original":"https://scriptblox.com/images/photo/66b4bc129f3985ee3d05d3a8-1724688724177.jpg"}},"reviewed":{"name":"QueueHero","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-16T14:39:00.073Z","profile":"/u/QueueHero"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":50,"conf":0.2,"n":{"w":1,"b":1,"p":0,"d":0,"k":0},"total":2,"detected":false,"key":false,"recent":2,"at":"2026-10-21T21:29:00.379Z","last":"wb","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6abf4ee731a520be1f60967b","editBy":{"_id":"66b4bc129f3985ee3d05d3a8","username":"Muhammad_Tanvirul","status":"offline","id":"66b4bc129f3985ee3d05d3a8"},"message":"Release of INF Stamina","createdAt":"2026-10-02T06:27:51.510Z"},{"_id":"6ad2370406ea2e061d6fae1f","editBy":{"_id":"66b4bc129f3985ee3d05d3a8","username":"Muhammad_Tanvirul","status":"offline","id":"66b4bc129f3985ee3d05d3a8"},"message":"Update script","createdAt":"2026-10-16T14:39:00.069Z"}],"comments":[{"_id":"6ac57069c4549e18a2649505","commentBy":{"_id":"666dba6eb68e80a6c3ce56f9","username":"voltex","verified":false,"role":"user","profilePicture":{"url":"https:/