{"_id":"66e2e8d2388f07d7f5f08328","title":"Spinning donut inside the console","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/ca9b835298510d5cf6d3200be0c66632ed60ed9dd2d684e675f137aa7a94ac33.webp","original":"https://scriptblox.com/images/sb/5609588-1726146769994.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/ca9b835298510d5cf6d3200be0c66632ed60ed9dd2d684e675f137aa7a94ac33.webp","original":"https://scriptblox.com/images/sb/5609588-1726146769994.png"},"placeId":0},"slug":"Universal-Script-Spinning-donut-inside-the-console-18192","verified":false,"key":false,"keyless":false,"views":53091,"executes":92,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/0bf6c50e8c6080860166df33968dd36a9366fad76e79201a00444151bf9b0abe.webp","original":"https://scriptblox.com/images/sb/5609588-1726146769994.png","scriptblox":"https://scriptblox.com/images/script/5609588-1726146769994.png"},"thumbnail":{"url":"https://media.kocakz.me/0bf6c50e8c6080860166df33968dd36a9366fad76e79201a00444151bf9b0abe.webp","original":"https://scriptblox.com/images/sb/5609588-1726146769994.png","scriptblox":"https://scriptblox.com/images/script/5609588-1726146769994.png"},"likeCount":8,"dislikeCount":0,"createdAt":"2024-09-12T13:12:50.070Z","updatedAt":"2024-09-12T13:12:50.070Z","lastBump":"2024-09-12T13:12:50.070Z","script":"local Modules = {\n    Colors = {\n        [\"Green\"] = \"0,255,0\",\n        [\"White\"] = \"255,255,255\"\n    },\n    Services = {\n        RunService = game:GetService(\"RunService\"),\n        CoreGui = game:GetService(\"CoreGui\")\n    }\n}\n\nfor i = 1,20 do \n    print(\"\\n\")\nend \n\nModules.ChangeColor = function()\n    local Loop\n    Loop = Modules.Services.RunService.Heartbeat:Connect(function()\n        local success, err = pcall(function()\n            for _, label in pairs(Modules.Services.CoreGui:FindFirstChild(\"DevConsoleMaster\"):GetDescendants()) do\n                if label:IsA(\"TextLabel\") then\n                    label.RichText = true\n                end\n            end\n        end)\n\n        if not success then\n            warn(`An error occurred: {err}`)\n            Loop:Disconnect()\n        end\n    end)\nend\n\nModules.SpinningDonut = function(watermark, color, delay)\n    delay = delay or 0.05\n\n    local Text = watermark .. tostring(math.random(500, 20000))\n    print(Text)\n\n    local donutLabel = nil\n    repeat\n        task.wait()\n        for _, label in pairs(Modules.Services.CoreGui:FindFirstChild(\"DevConsoleMaster\"):GetDescendants()) do\n            if label:IsA(\"TextLabel\") and string.find(label.Text:lower(), Text:lower()) then\n                donutLabel = label\n                break\n            end\n        end\n    until donutLabel\n\n    local theta_spacing = 0.07\n    local phi_spacing = 0.02\n    local R1 = 1\n    local R2 = 2\n    local K2 = 5\n    local K1 = 40\n\n    local A, B = 0, 0\n\n    while true do\n        local output = {}\n        local zbuffer = {}\n\n        for i = 1, 80 do\n            output[i] = {}\n            zbuffer[i] = {}\n            for j = 1, 40 do\n                output[i][j] = ' '\n                zbuffer[i][j] = 0\n            end\n        end\n\n        for theta = 0, 2 * math.pi, theta_spacing do\n            local costheta = math.cos(theta)\n            local sintheta = math.sin(theta)\n\n            for phi = 0, 2 * math.pi, phi_spacing do\n                local cosphi = math.cos(phi)\n                local sinphi = math.sin(phi)\n\n                local circlex = R2 + R1 * costheta\n                local circley = R1 * sintheta\n\n                local x = circlex * (math.cos(B) * cosphi + math.sin(A) * math.sin(B) * sinphi) - circley * math.cos(A) * math.sin(B)\n                local y = circlex * (math.sin(B) * cosphi - math.sin(A) * math.cos(B) * sinphi) + circley * math.cos(A) * math.cos(B)\n                local z = K2 + math.cos(A) * circlex * sinphi + circley * math.sin(A)\n                local ooz = 1 / z\n\n                local xp = math.floor(40 + K1 * ooz * x)\n                local yp = math.floor(20 - K1 * ooz * y)\n\n                if xp >= 1 and xp <= 80 and yp >= 1 and yp <= 40 then\n                    local L = cosphi * costheta * math.sin(B) - math.cos(A) * costheta * sinphi - math.sin(A) * sintheta + math.cos(B) * (math.cos(A) * sintheta - costheta * math.sin(A) * sinphi)\n\n                    if L > 0 then\n                        if ooz > (zbuffer[xp][yp] or 0) then\n                            zbuffer[xp][yp] = ooz\n                            local luminance_index = math.floor(L * 8)\n                            local chars = \".,-~:;=!*#$@\"\n                            output[xp][yp] = chars:sub(luminance_index + 1, luminance_index + 1)\n                        end\n                    end\n                end\n            end\n        end\n\n        local displayText = \"\"\n        for j = 1, 40 do\n            for i = 1, 80 do\n                displayText = displayText .. (output[i][j] or ' ')\n            end\n            displayText = displayText .. \"\\n\"\n        end\n\n        donutLabel.Text = string.format(\"<font color='rgb(%s)' size='12'>%s</font>\", Modules.Colors[color], displayText)\n        A = A + 0.05\n        B = B + 0.03\n        task.wait(delay)\n    end\nend\n\n\n\nModules.ChangeColor()\n\nModules.SpinningDonut(\"Donut\", \"Green\", 0.05)","features":"Note: The math and logic behind originally came from here\n--> https://www.a1k0n.net/2011/07/20/donut-math.html\n\n--> I just converted it to be able to be used in the roblox console","tags":[],"discord":"","keyLink":"","owner":{"_id":"621948ecb61fc7cb55b28136","username":"Verified","verified":true,"profilePicture":{"url":"https://media.kocakz.me/58e1821d776058c4a51a117e899765afbe964c8a57de229da841a40d75801dd2.webp","original":"https://scriptblox.com/images/photo/621948ecb61fc7cb55b28136-1726054933516.png"},"status":"offline","id":"621948ecb61fc7cb55b28136","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/58e1821d776058c4a51a117e899765afbe964c8a57de229da841a40d75801dd2.webp","original":"https://scriptblox.com/images/photo/621948ecb61fc7cb55b28136-1726054933516.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:19:10.933Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cc16","editBy":{"_id":"621948ecb61fc7cb55b28136","username":"Verified","status":"offline","id":"621948ecb61fc7cb55b28136"},"message":"Create script","createdAt":"2024-09-12T13:13:11.689Z"},{"_id":"67e5e1e6b360710ec3c520c5","editBy":{"_id":"621948ecb61fc7cb55b28136","username":"Verified","status":"offline","id":"621948ecb61fc7cb55b28136"},"message":"Update script","createdAt":"2025-03-27T17:38:59.087Z"}],"comments":[{"_id":"66e2ee36b6977bc5c0dc7af9","commentBy":{"_id":"630d86359541ae5f4eaeb204","username":"SkireScripts","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/0a1a427ffb767435bf427d864b1ea467d292350f40c5bbad81c6194478bb5824.webp","original":"https://scriptblox.com/images/photo/630d86359541ae5f4eaeb204-1742286952028.png"},"createdAt":"2022-08-30T03:38:29.229Z","lastActive":"2026-07-01T19:12:58.489Z","status":"offline","id":"630d86359541ae5f4eaeb204","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/0a1a427ffb767435bf427d864b1ea467d292350f40c5bbad81c6194478bb5824.webp","original":"https://scriptblox.com/images/photo/630d86359541ae5f4eaeb204-1742286952028.png"}},"text":"awesome sauce","createdAt":"2024-09-12T13:35:50.374Z","edited":true,"dislikeCount":0,"likeCount":3