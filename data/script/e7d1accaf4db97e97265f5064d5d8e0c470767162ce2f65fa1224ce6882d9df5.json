{"_id":"67062922b8a7c53167f0d9d1","title":"SCRIPT AUTO PRINTER","game":{"_id":"67e5e1ffb360710ec3c77d20","gameId":4581966615,"name":"Anomic","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"4581966615-anomic","path":"/game/4581966615-anomic","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":4581966615},"slug":"Anomic-SCRIPT-AUTO-PRINTER-19888","verified":false,"key":false,"keyless":false,"views":18407,"executes":77,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6aaa7da7b9f5af205f691053bdad9b838b4c9fdc8d4d606e26ccfb48270160c9.webp","original":"https://scriptblox.com/images/sb/4581966615-1728456994732.png","scriptblox":"https://scriptblox.com/images/script/4581966615-1728456994732.png"},"thumbnail":{"url":"https://media.kocakz.me/6aaa7da7b9f5af205f691053bdad9b838b4c9fdc8d4d606e26ccfb48270160c9.webp","original":"https://scriptblox.com/images/sb/4581966615-1728456994732.png","scriptblox":"https://scriptblox.com/images/script/4581966615-1728456994732.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2024-10-09T06:56:34.763Z","updatedAt":"2024-10-09T06:56:34.763Z","lastBump":"2024-10-09T06:56:34.763Z","script":"local owned_printer_amount = 0\nlocal buying_printers = false\n\nrconsolewarn('Teleporting to autofarm location')\n\nlocal function tw(target, changes, style, dir, tim)\n    game:GetService('TweenService'):Create(target, TweenInfo.new(tim, Enum.EasingStyle[style], Enum.EasingDirection[dir]), changes):Play()\nend\n\ntw(game.Players.LocalPlayer.Character.HumanoidRootPart, {CFrame = CFrame.new(1172.96, 94.122, -878.75)}, 'Linear', 'InOut', 30)\n\ntask.wait(32)\n\nrconsolewarn('Autofarm has started successfully')\n\nworkspace.Entities.ChildRemoved:Connect(function(ty)\n    if string.find(tostring(ty.Name):lower(), 'printer') and tostring(ty.Properties.Owner.Value) == game.Players.LocalPlayer.Name then\n        owned_printer_amount = owned_printer_amount - 1\n    end\nend)\n\nwhile task.wait() do\n    pcall(function()\n        spawn(function()\n            if owned_printer_amount < 3 and not buying_printers then\n                rconsolewarn('Buying Printers')\n                buying_printers = true\n                repeat\n                    game:GetService(\"ReplicatedStorage\")[\"_CS.Events\"].PurchaseTeamItem:FireServer(\"Hotwired Printer\", \"Single\", Color3.new(0, 0, 0))\n                    owned_printer_amount = owned_printer_amount + 1\n                    task.wait(3)\n                until owned_printer_amount == 3\n                buying_printers = false\n            end\n        end)\n        \n        for i, v in next, workspace.Entities:GetChildren() do\n            if string.find(tostring(v.Name):lower(), 'printer') and tostring(v.Properties.Owner.Value) == game.Players.LocalPlayer.Name and tonumber(v.Properties.CurrentPrinted.Value) >= 200 then\n                game:GetService(\"ReplicatedStorage\")[\"_CS.Events\"].LockPrinter:FireServer(v)\n                game:GetService(\"ReplicatedStorage\")[\"_CS.Events\"].UsePrinter:FireServer(v)\n                game:GetService(\"ReplicatedStorage\")[\"_CS.Events\"].LockPrinter:FireServer(v)\n            end\n        end\n    end)\nend\n","features":"This is a script for the game Anomic, it is a basic script that lets you auto farm printers. Just Run the script and let it do its job.","tags":["anomic","auto","simple script","farm","war"],"discord":"","keyLink":"","owner":{"_id":"66fba4ddc767d83e75e7f7a4","username":"gintheworld","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66fba4ddc767d83e75e7f7a4","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:06:13.413Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52699","editBy":{"_id":"66fba4ddc767d83e75e7f7a4","username":"gintheworld","status":"offline","id":"66fba4ddc767d83e75e7f7a4"},"message":"Create script","createdAt":"2025-03-27T22:23:21.565Z"}],"comments":[{"_id":"6706402752d6fd0bb9661495","commentBy":{"_id":"66b51232c8c6e63bf1dd0ffe","username":"lemonCuzYes","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/408321f43613ab8dbd5f857c8c557fda11e4c3097f3831e24ba656c839a6c01b.webp","original":"https://scriptblox.com/images/photo/66b51232c8c6e63bf1dd0ffe-1723142863737.jpg"},"createdAt":"2024-08-08T18:45:06.540Z","lastActive":"2025-03-27T12:51:45.785Z","status":"offline","id":"66b51232c8c6e63bf1dd0ffe","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/408321f43613ab8dbd5f857c8c557fda11e4c3097f3831e24ba656c839a6c01b.webp","original":"https://scriptblox.com/images/photo/66b51232c8c6e63bf1dd0ffe-1723142863737.jpg"}},"text":"big WW!! 1!1","createdAt":"2024-10-09T08:34:47.162Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"67066a8021d3873c69425c30","commentBy":{"_id":"66feb96291d07cd524d5f6ba","username":"OPSCRIPT","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/9c9e8ac6bf91cc4b7db93d891f9355667dd5e3219b1d241b38330b7877d1c20c.webp","original":"https://scriptblox.com/images/photo/66feb96291d07cd524d5f6ba-1728576501888.png"},"createdAt":"2024-10-03T15:33:54.065Z","lastActive":"2024-10-12T09:00:26.560Z","status":"offline","id":"66feb96291d07cd524d5f6ba","profile":{"url":"https://media.kocakz.me/9c9e8ac6bf91cc4b7db93d891f9355667dd5e3219b1d241b38330b7877d1c20c.webp","original":"https://scriptblox.com/images/photo/66feb96291d07cd524d5f6ba-1728576501888.png"}},"text":"doesnt work on solara","createdAt":"2024-10-09T11:35:28.852Z","edited"