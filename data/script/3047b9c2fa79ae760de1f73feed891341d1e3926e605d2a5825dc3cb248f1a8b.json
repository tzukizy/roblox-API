{"slug":"Valentines-+-More!-Unfamiliar-Universe-Incident-EpicHub-Reborn-10951","_id":"65dd0fc2cee8e43dbba7e97b","title":"EpicHub Reborn","game":{"_id":"67e5e1ffb360710ec3c780d3","gameId":13052445757,"name":"[Valentines + More!] Unfamiliar Universe Incident","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13052445757},"features":"Script is still in *BETA*, Barely any progress has been made but because people are requesting it, Here it is\nv1.0.0:\nView player data without sending anything in chat\nAutoFarm:\nGrab all chests,\nopen all chests,\nForceStop <-- clicking this stops grabbing all chests just incase.\nInventory related:\nView all inventory items that are NOT cups","tags":[],"script":"for i, v in game:GetService \"CoreGui\":GetChildren() do\n    if v.Name == \"Discord\" then\n        v:Destroy()\n    end\nend\nlocal DiscordLib =\n    loadstring(game:HttpGet \"https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/discord\")()\n    _G.Config = { [\"Theme\"] = \"Discord\" }\nlocal NotificationLibrary = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/lobox920/Notification-Library/Main/Library.lua\"))()\nlocal win = DiscordLib:Window(\"Epic Hub Reborn\")\nfunction server(Name, AssetId)\n    return win:Server(Name, AssetId)\nend\nfunction Notify(Title, Text, ButtonText)\n    DiscordLib:Notification(Title, Text, ButtonText)\nend\nlocal serv = server(\"Main\", \"\")\n\nlocal CC = serv:Channel(\"PlayerDatas\")\nlocal Channel2 = serv:Channel(\"AutoFarm\")\nlocal chests = workspace.chests\nlocal lp = game:GetService \"Players\".LocalPlayer\nlocal Char = lp.Character or lp.CharacterAdded:Wait()\nlocal Root = Char:FindFirstChild \"HumanoidRootPart\"\nfunction GrabChest(chest)\n    local v = Root.CFrame\n    Root.CFrame = chest.CFrame\n    task.wait(.25) -- 4 chests per sec\n    fireproximityprompt(chest.ProximityPrompt)\n    Root.CFrame = v\nend\nfunction GetStats(player)\n    -- TrollStand = troll ur using\n    local Return = {Trolls = {}, Troll = nil, Items = {}}\n    for _, troll in player.TrollgeSaves:GetChildren() do\n        if troll.Value ~= \"troll\" then\n            table.insert(Return.Trolls, troll.value)\n        end\n    end\n    for _, item in player.ItemSaves:GetChildren() do\n        if item.Value ~= \"item\" then\n            table.insert(Return.Items, item.Value)\n        end\n    end\n    Return.Troll = player.trollge_data.troll_stand.Value\n    return Return\nend\nCC:Textbox(\"Enter username (Prints result)\", \"John Doe\", true, function(Value)\n function GetPlayer()\n  for i, v in game:GetService(\"Players\"):GetPlayers() do\n   if v.Name:sub(1, #Value) == Value:sub(1, #Value) then return v end\n  end\n end\n local Plr = GetPlayer()\n if not Plr then print(\"Player not found.\") return else print((\"@%s/%s's Data\"):format(Plr.Name, Plr.DisplayName)) end\n local Items, Trolls = GetStats(Plr).Items, GetStats(Plr).Trolls\n print(\"-- Troll:\",GetStats(Plr).Troll,\"--\")\n print(\"-- Items --\")\n for i, v in Items do\n  print(\"Item slot #\"..tostring(i)..\":\",v)\n end\n print(\"-- Trolls --\")\n for i, v in Trolls do\n  print(\"Troll slot #\"..tostring(i)..\":\",v)\n end\nend)\nChannel2:Button(\"Grab All Chests\", function()\n COLLECTING = true\n for i, v in chests:GetChildren() do if COLLECTING then GrabChest(v) end end\nend)\nChannel2:Button(\"ForceStop\", function()\n COLLECTING = false\nend)\nChannel2:Button(\"Open All Chests\", function()\n for i, v in lp.Backpack:GetChildren() do\n  if v.Name:lower():find(\"chest\") then\n   v.Parent = Char\n   v:Activate()\n   task.wait(.01)\n  end\n end\nend)\nlocal C3 = serv:Channel(\"Inventory\")\nC3:Button(\"List items that are not cups\", function()\n local itms = {};\n local DISPLAYING = 0\n for i, v in lp.Backpack:GetChildren() do if not v.Name:lower():find(\"cup\") then table.insert(itms, v); end end\n for _, item in itms do if DISPLAYING >= 7 then task.wait(4) DISPLAYING = 0 else NotificationLibrary:SendNotification(\"Info\",item.Name, 4) DISPLAYING += 1 end end\nend)","owner":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"},"status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13467900}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://cdn.kocakz.me/images/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"}},"verified":true,"keyLink":"","views":200781,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-02-26T22:25:06.717Z","dislikeCount":17,"likeCount":4,"image":{"url":"https://cdn.kocakz.me/images/b64f111bd4144e753ec9197b7313f5639aacb4ac9165e916efe90f660077a204.webp","original":"https://scriptblox.com/images/sb/13052445757-1708986306666.webp","scriptblox":"https://scriptblox.com/images/script/13052445757-1708986306666.webp"},"executes":381,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:22:07.413Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/b64f111bd4144e753ec9197b7313f5639aacb4ac9165e916efe90f660077a204.webp","original":"https://scriptblox.com/images/sb/13052445757-1708986306666.webp","scriptblox":"https://scriptblox.com/images/script/13052445757-1708986306666.webp"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c504db","editBy":{"_id":"64cb81f82512701e9a163c00","u