hen\n            \tlocal hrp = me.Character.HumanoidRootPart\n            \tif (hrp.Position - obj.Parent.Position).Magnitude < 20 then\n\t\t            for a=0, 15 do\n\t\t\t            task.spawn(function()\n\t\t\t            \tobj:InputHoldBegin()\n\t\t            \t\tobj:InputHoldEnd()\n\t\t\t            end)\n\t\t\t        end\n\t\t\t    end\n\t\t\tend\n\t\tend\n\tend\nend","features":"very simple and very effective\n\napproach an object and it is automatically assembled 15 times","tags":["simple","VHS"],"discord":"","keyLink":"","owner":{"_id":"66b9f4ca2fb4155fd40add65","username":"VHCK","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d0edfeac08f938c79017d90334749732b736cf0325b29470d481486b0c28c44f.webp","original":"https://scriptblox.com/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg"},"status":"offline","id":"66b9f4ca2fb4155fd40add65","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/d0edfeac08f938c79017d90334749732b736cf0325b29470d481486b0c28c44f.webp","original":"https://scriptblox.com/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:07:21.620Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c5210d","editBy":{"_id":"66b9f4ca2fb4155fd40add65","username":"VHCK","status":"offline","id":"66b9f4ca2fb4155fd40add65"},"message":"Create script","createdAt":"2025-03-27T21:40:53.256Z"}],"comments":[{"_id":"66e5c5e2d6f5dd556e8928f5","commentBy":{"_id":"66de6af5d07471fc6e4dacd5","username":"Newbie1457","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b15df32f178bfad255dec2526c5fd2b8db0dc3f746115afcfad6541ef090d610.webp","original":"https://scriptblox.com/images/photo/66de6af5d07471fc6e4dacd5-1725852523920.j