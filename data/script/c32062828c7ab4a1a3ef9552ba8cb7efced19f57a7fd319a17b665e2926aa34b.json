e.Text:lower(),text:split(\" \")[1]) then\ngame.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = x.CFrame\nend\nend\nend\nend\nend)","features":"set size to selected fish\nredeem all codes\nequip selected fish as a tier\nteleport to areas","tags":["size","cmds","commands","admin"],"discord":"","keyLink":"","owner":{"_id":"6611a459fa09038baf3b4c47","username":"sand","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e50053d2592082efc640aa509c2ff5b15e64726e3915b4d0b8fc645a925dea04.webp","original":"https://scriptblox.com/images/photo/6611a459fa09038baf3b4c47-1721552120979.png"},"lvl":15,"status":"offline","id":"6611a459fa09038baf3b4c47","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/e50053d2592082efc640aa509c2ff5b15e64726e3915b4d0b8fc645a925dea04.webp","original":"https://scriptblox.com/images/photo/6611a459fa09038baf3b4c47-1721552120979.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:04:18.991Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53bbf","editBy":{"_id":"6611a459fa09038baf3b4c47","username":"sand","status":"offline","id":"6611a459fa09038baf3b4c47"},"message":"Create script","createdAt":"2025-03-27T19:34:11.140Z"}],"comments":[{"_id":"676ce1683c24439d6cf624b0","commentBy":{"_id":"672eac3b84d50485a7cf130d","username":"UnequaledUnrivaled","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/de8babb36295935df862224cc9b920721bda9c921c54b06da6f6621337c402d8.webp","original":"https://scriptblox.com/images/photo/672eac3b84d50485a7cf130d-1731112037300.jpeg"},"createdAt":"2024-11-09T00:26:35.427Z","lastActive":"2026-07-22T04:09:35.253Z","status":"offline","id":"672eac3b84d50485a7cf130d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"ht