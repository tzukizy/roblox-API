{"_id":"672c06b7efaa549629d69bcd","title":"FTAP script (no menu)","game":{"_id":"67e5e1ffb360710ec3c77d21","gameId":6961824067,"name":"Fling Things and People","imageUrl":{"url":"https://media.kocakz.me/3a8897da8f7354085eec2a25324f9f340421a2f5a735618005d8f3bd6884fe0d.webp","original":"https://tr.rbxcdn.com/180DAY-298897e01eeb244af09a923c7c0cdbcc/150/150/Image/Png/noFilter"},"slug":"6961824067-fling-things-and-people","path":"/game/6961824067-fling-things-and-people","thumbnail":{"url":"https://media.kocakz.me/3a8897da8f7354085eec2a25324f9f340421a2f5a735618005d8f3bd6884fe0d.webp","original":"https://tr.rbxcdn.com/180DAY-298897e01eeb244af09a923c7c0cdbcc/150/150/Image/Png/noFilter"},"placeId":6961824067},"slug":"Fling-Things-and-People-no-menu-script-21779","verified":false,"key":false,"keyless":false,"views":36345,"executes":944,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-b3ceda04997ae6c5a482da2014b6ebef/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-b3ceda04997ae6c5a482da2014b6ebef/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-b3ceda04997ae6c5a482da2014b6ebef/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-b3ceda04997ae6c5a482da2014b6ebef/500/280/Image/Jpeg/noFilter"},"likeCount":1,"dislikeCount":0,"createdAt":"2024-11-07T00:15:51.484Z","updatedAt":"2024-11-07T00:15:51.484Z","lastBump":"2024-11-07T00:15:51.484Z","script":"-- made by Sleeeppy\n-- to use just grab an item or player and click right mouse button\nlocal bodyvel_Name = \"FlingVelocity\"\nlocal userinputs = game:GetService(\"UserInputService\")\nlocal w = game:GetService(\"Workspace\")\nlocal r = game:GetService(\"RunService\")\nlocal d = game:GetService(\"Debris\")\nlocal strength = 400\nw.ChildAdded:Connect(function(model)\n    if model.Name == \"GrabParts\" then\n        local part_to_impulse = model[\"GrabPart\"][\"WeldConstraint\"].Part1\n \n        if part_to_impulse then\n            print(\"Part found!\")\n \n            local inputObj\n            local velocityObj = Instance.new(\"BodyVelocity\", part_to_impulse)\n            \n            model:GetPropertyChangedSignal(\"Parent\"):Connect(function()\n                if not model.Parent then\n                    if userinputs:GetLastInputType() == Enum.UserInputType.MouseButton2 then\n                        print(\"Launched!\")\n                        velocityObj.MaxForce = Vector3.new(math.huge, math.huge, math.huge)\n                        velocityObj.Velocity = workspace.CurrentCamera.CFrame.lookVector * strength\n                        d:AddItem(velocityObj, 1)\n                    elseif userinputs:GetLastInputType() == Enum.UserInputType.MouseButton1 then\n                        velocityObj:Destroy()\n                        print(\"Cancel Launch!\")\n                    else\n                        velocityObj:Destroy()\n                        print(\"No two keys pressed!\")\n                    end\n                end\n            end)\n        end\n    end\nend)","features":"throw things further than usual (just grab an item or player and click right mouse button)\n\nyou can change the throwing force, you need to find in the script \"local strength\" and change the number from 0 to however many you want","tags":[],"discord":"","keyLink":"","owner":{"_id":"66f9b51a30b83d7bd08a3a14","username":"Sleeeppy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fa8f0d05ebcefaef364efc8950755d768324b2ba837ba53a37fa469911dc22e5.webp","original":"https://scriptblox.com/images/photo/66f9b51a30b83d7bd08a3a14-1749246112040.png"},"status":"offline","id":"66f9b51a30b83d7bd08a3a14","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/fa8f0d05ebcefaef364efc8950755d76832