{"slug":"Universal-Script-Extra-Antilag-(Open-source)-229552","_id":"6ab4cd308d605cfcd008af8a","title":"Extra Antilag (Open source)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Make games not lagging.","tags":["Antilag","Boostfps"],"script":"-- Roblox 客户端性能优化与 FPS 提升脚本\n-- 目标：降级 Lighting 渲染、强制锁定画质 Level 1，削减 GPU/CPU 负担\n\nlocal Lighting = game:GetService(\"Lighting\")\nlocal UserSettings = UserSettings():GetService(\"UserGameSettings\")\nlocal RenderingSettings = settings().Rendering\n\n--------------------------------------------------------------------\n-- 1. 强制锁死画质等级为 Level 1（忽略并覆盖用户的修改）\n--------------------------------------------------------------------\nlocal function lockQualityToLevel1()\n    pcall(function()\n        RenderingSettings.QualityLevel = Enum.QualityLevel.Level01\n        UserSettings.SavedQualityLevel = Enum.SavedQualityLevel.QualityLevel1\n    end)\nend\n\n-- 立即执行一次画质重置\nlockQualityToLevel1()\n\n-- 监听画质变更事件，防止玩家在设置菜单中手动修改画质\nUserSettings:GetPropertyChangedSignal(\"SavedQualityLevel\"):Connect(lockQualityToLevel1)\npcall(function()\n    RenderingSettings:GetPropertyChangedSignal(\"QualityLevel\"):Connect(lockQualityToLevel1)\nend)\n\n--------------------------------------------------------------------\n-- 2. Lighting 光照与风格优化\n--------------------------------------------------------------------\npcall(function()\n    -- 1) 设置光照风格为 Soft (扁平化光照，关闭高阶法线与高精度动态阴影计算)\n    Lighting.LightingStyle = Enum.LightingStyle.Soft\n\n    -- 2) 设置光照技术为 Compatibility (兼容/支持模式)\n    local success = pcall(function()\n        Lighting.Technology = Enum.Technology.Compatibility\n    end)\n    if not success then\n        -- 若引擎或场景限制不支持 Compatibility，退回最省资源的 Voxel (体素光照)\n        Lighting.Technology = Enum.Technology.Voxel\n    end\n\n    -- 3) 关闭全局阴影计算\n    Lighting.GlobalShadows = false\n\n    -- 4) 禁用 Lighting 下的所有后期特效 (Bloom, Blur, DepthOfField, SunRays 等)\n    for _, effect in ipairs(Lighting:GetChildren()) do\n        if effect:IsA(\"PostEffect\") then\n            effect.Enabled = false\n        end\n    end\nend)\n\n--------------------------------------------------------------------\n-- 3. 场景物体与粒子渲染削减（进一步降低 CPU/GPU 开销）\n--------------------------------------------------------------------\nlocal function optimizeInstance(inst)\n    if inst:IsA(\"BasePart\") then\n        inst.CastShadow = false -- 禁用场景物体的单个投影计算\n    elseif inst:IsA(\"ParticleEmitter\") or inst:IsA(\"Trail\") or inst:IsA(\"Smoke\") or inst:IsA(\"Fire\") then\n        inst.Enabled = false -- 禁用粒子与尾迹渲染\n    end\nend\n\n-- 清理当前地图所有物体\nfor _, obj in ipairs(workspace:GetDescendants()) do\n    optimizeInstance(obj)\nend\n\n-- 监听后续动态生成的物体\nworkspace.DescendantAdded:Connect(optimizeInstance)","owner":{"_id":"6a1279777f9602bdd802f0e3","username":"NPC_PlayersNoob_Alt","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/1b16e3a39197ea3a7a3813e923aedb5e55d558179c61851cc2dfbb8156a2098f.webp","original":"https://scriptblox.com/images/photo/6a1279777f9602bdd802f0e3-1785668795917.png"},"lvl":8,"status":"offline","id":"6a1279777f9602bdd802f0e3","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/1b16e3a39197ea3a7a3813e923aedb5e55d558179c61851cc2dfbb8156a2098f.webp","original":"https://scriptblox.com/images/photo/6a1279777f9602bdd802f0e3-1785668795917.png"}},"verified":false,"keyless":false,"views":991,"executes":12957,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/856916dab9ddfebb6f2dcaa0ddd0aabe092d4c9f682bc14709cf92e4f478f74f.webp","original":"https://scriptblox.com/images/sb/0-1790233904501.jpg","scriptblox":"https://scriptblox.com/images/script/0-1790233904501.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-24T07:11:44.577Z","milestones":[{"key":"script.executions","tier":10000,"value":10160,"at":"2026-10-11T23:30:06.839Z"}],"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-24T07:50:42.045Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:08:04.751Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/856916dab9ddfebb6f2dcaa0ddd0aabe092d4c9f682bc14709cf92e4f478f74f.webp","original":"https://scriptblox.com/images/sb/0-1790233904501.jpg","scriptblox":"https://scriptblox.com/images/script/0-1790233904501.jpg"},"changelog":[{"_id":"6ab4cd308d605cfcd008af8c","editBy":{"_id":"6a1279777f9602bdd802f0e3","username":"NPC_PlayersNoob_Alt","status":"offline","id":"6a1279777f9602bdd802f0e3"},"message":"Create script","createdAt":"2026-09-24T07:11:44.581Z"}],"comments":[{"_id":"6ab4e5fb213f69500f340a2a","commentBy":{"_id":"6a1279777f9602bdd802f0e3","username":"NPC_PlayersNoob_Alt","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/1b16e3a39197ea3a7a3813e923aedb5e55d558179c61851cc2dfbb8156a2098f.webp","original":"https://scriptblox.com/images/photo/6a1279777f9602bdd802f0e3-1785668795917.png"},"lastActive":"2026-10-14T07:38:21.715Z","createdAt":"2026-05-24T04:07:19.232Z","lvl":8,"status":"offline","id":"6a1279777f9602bdd802f0e3","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/1b16e3a39197ea3a7a3813e923aedb5e55d558179c61851cc2dfbb8156a2098f.webp","original":"https://scriptblox.com/images/photo/6a1279777f9602bdd802f0e3-1785668795917.png"}},"text":"Made for fun, right?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-24T08:57:31.768Z","liked":false,"disliked":false},{"_id":"6ab75d62e72d99a2f0928f3b