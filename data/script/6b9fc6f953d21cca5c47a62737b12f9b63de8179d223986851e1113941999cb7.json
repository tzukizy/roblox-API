lPlayer.Character then\n    Cpart(localPlayer.Character)\nend\n\nlocal StarterGui = game:GetService(\"StarterGui\")\nStarterGui:SetCore(\"SendNotification\", {\n    Title = \"Kill Aura\";\n    Text = \"Join The Discord For A Full Version With Other Features\";\n    Duration = 8;\n})\n\nsetclipboard(\"https://discord.gg/x8VMmm7SFA\")\n","owner":{"_id":"65dfa241b3edf2b824b66ef2","username":"Rinn","verified":false,"profilePicture":{"url":"https://media.kocakz.me/da33cae1c7fefc6fd75198f7b7e906304189f7be3d31f9513be8b14c4a5d342b.webp","original":"https://scriptblox.com/images/photo/65dfa241b3edf2b824b66ef2-1723170359584.jpg"},"status":"offline","id":"65dfa241b3edf2b824b66ef2","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/da33cae1c7fefc6fd75198f7b7e906304189f7be3d31f9513be8b14c4a5d342b.webp","original":"https://scriptblox.com/images/photo/65dfa241b3edf2b824b66ef2-1723170359584.jpg"}},"verified":false,"keyLink":"","views":27255,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-10-06T20:25:20.534Z","dislikeCount":1,"likeCount":1,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/5363d384801a4285cd61cae032ff0d70/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5363d384801a4285cd61cae032ff0d70/500/280/Image/Jpeg"},"executes":39,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:15:34.865Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/5363d384801a4285cd61cae032ff0d70/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5363d384801a4285cd61cae032ff0d70/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cddb","editBy":{"_id":"65dfa241b3edf2b824b66ef2","username":"Rinn"