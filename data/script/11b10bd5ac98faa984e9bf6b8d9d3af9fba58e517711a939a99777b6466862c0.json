{"_id":"69bb9700ba0e71e6b4e3e4c8","title":"auto keycard (legit)","game":{"_id":"6884bb9604709958d455a401","gameId":3421472751,"name":"⛓️ Stateview Prison","imageUrl":{"url":"https://media.kocakz.me/2a0d6275f6ba53145518a43b087e599aae475a093046a2355ba72123814d3768.webp","original":"https://tr.rbxcdn.com/180DAY-f48cf09c532b67fedc5041f799fce883/150/150/Image/Png/noFilter"},"slug":"3421472751-stateview-prison","path":"/game/3421472751-stateview-prison","thumbnail":{"url":"https://media.kocakz.me/2a0d6275f6ba53145518a43b087e599aae475a093046a2355ba72123814d3768.webp","original":"https://tr.rbxcdn.com/180DAY-f48cf09c532b67fedc5041f799fce883/150/150/Image/Png/noFilter"},"placeId":3421472751},"slug":"Stateview-Prison-auto-do-keycard-134558","verified":false,"key":false,"keyless":false,"views":590,"executes":139,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/e6135654cd194a820ad2c76b5f997e8f0ee5f9eb29e8ab82a8c2111a3bf78c2d.webp","original":"https://scriptblox.com/images/sb/3421472751-1773901568541.webp","scriptblox":"https://scriptblox.com/images/script/3421472751-1773901568541.webp"},"thumbnail":{"url":"https://media.kocakz.me/e6135654cd194a820ad2c76b5f997e8f0ee5f9eb29e8ab82a8c2111a3bf78c2d.webp","original":"https://scriptblox.com/images/sb/3421472751-1773901568541.webp","scriptblox":"https://scriptblox.com/images/script/3421472751-1773901568541.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-03-19T06:26:08.571Z","updatedAt":"2026-03-19T06:26:08.571Z","lastBump":"2026-03-19T06:26:08.571Z","script":"-- It's harmless only for those who play legit but too lazy to do keycard ig\n-- Made by Unknowey\n\ntask.spawn(function()\n    while task.wait() do\n        local plr = game.Players.LocalPlayer\n        local gui = plr.PlayerGui:FindFirstChild(\"LockpickUI\")\n\n        if gui then\n            local frame = gui:FindFirstChild(\"Frame\")\n            if frame then\n                local doorKey = frame:FindFirstChild(\"DoorKey\")\n                local inputKey = frame:FindFirstChild(\"InputKey\")\n\n                if doorKey and inputKey then\n                    local code = doorKey.Text\n                    local tool = plr.Character and plr.Character:FindFirstChildOfClass(\"Tool\")\n\n                    if tool then\n                        for i = 1, #code do\n                            local target = string.sub(code, i, i)\n                            repeat\n                                task.wait()\n                            until string.sub(inputKey.Text, i, i) == target\n                            tool:Activate()\n                            task.wait(0.05)\n                        end\n                    end\n                end\n            end\n        end\n    end\nend)","features":"Just look at the title","tags":[],"discord":"","keyLink":"","owner":{"_id":"69590d4e11c911ecae52ba5e","username":"Unknowey","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69590d4e11c911ecae52ba5e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:30:28.039Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bb9700ba0e71e6b4e3e4cb","editBy":{"_id":"69590d4e11c911ecae52ba5e","username":"Unknowey","status":"offline","id":"69590d4e11c911ecae52ba5e"},"message":"yaehahweha","createdAt":"2026-03-19T06:26:08.576Z"}],"comments":[{"_id":"69bb97c9dfe464b9189a3402","commentBy":{"_id":"69bb97bb67b3dcfd3607079a","username":"amelineposeyolt5602","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastAct