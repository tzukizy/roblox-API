{"_id":"67fc65db2436f4a0aa487092","title":"Fps and ping indicator","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Fps-and-ping-indicator-35490","verified":false,"key":false,"keyless":false,"views":3490,"executes":737,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/a159661f71f0a5d6058cf04d4771557c51759c6bc88b4cb69fa8badec6d0dd68.webp","original":"https://scriptblox.com/images/sb/0-1744594395919.jpg","scriptblox":"https://scriptblox.com/images/script/0-1744594395919.jpg"},"thumbnail":{"url":"https://media.kocakz.me/a159661f71f0a5d6058cf04d4771557c51759c6bc88b4cb69fa8badec6d0dd68.webp","original":"https://scriptblox.com/images/sb/0-1744594395919.jpg","scriptblox":"https://scriptblox.com/images/script/0-1744594395919.jpg"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-04-14T01:33:15.953Z","updatedAt":"2025-04-14T01:33:15.953Z","lastBump":"2025-04-14T01:33:15.953Z","script":"local player = game.Players.LocalPlayer\nlocal runService = game:GetService(\"RunService\")\nlocal textLabel\nlocal function createUI()\n    local screenGui = Instance.new(\"ScreenGui\")\n    screenGui.Name = \"FPSPingDisplay\"\n    screenGui.Parent = player:WaitForChild(\"PlayerGui\")\n    textLabel = Instance.new(\"TextLabel\")\n    textLabel.Size = UDim2.new(0, 200, 0, 50)\n    textLabel.Position = UDim2.new(0.5, -100, 0, 10)\n    textLabel.AnchorPoint = Vector2.new(0.5, 0)\n    textLabel.BackgroundTransparency = 1\n    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\n    textLabel.TextStrokeTransparency = 0\n    textLabel.Font = Enum.Font.SourceSansBold\n    textLabel.TextSize = 24\n    textLabel.Text = \"FPS: 0 | Ping: 0\"\n    textLabel.Parent = screenGui\nend\nlocal function updateStats()\n    local fps = 0\n    local lastTime = tick()\n    runService.RenderStepped:Connect(function()\n        fps = math.floor(1 / (tick() - lastTime))\n        lastTime = tick()\n    end)\n    while true do\n        local ping = math.floor(game:GetService(\"Stats\").Network.ServerStatsItem[\"Data Ping\"]:GetValue())\n        textLabel.Text = string.format(\"FPS: %d | Ping: %d ms\", fps, ping)\n        task.wait(1)\n    end\nend\ncreateUI()\ntask.spawn(updateStats)","features":"Show fps and ping (for mobiles & tablets)","tags":["Universal","Free","Fps"],"discord":"","keyLink":"","owner":{"_id":"679a35fa27aa428b99da9215","username":"GeniusofAB","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6a92c7f8125051f26b0fecfe44d6cb2b0c366d121791b99b71a144e38880df55.webp","original":"https://scriptblox.com/images/photo/679a35fa27aa428b99da9215-1740256886761.jpg"},"status":"offline","id":"679a35fa27aa428b99da9215","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/6a92c7f8125051f26b0fecfe44d6cb2b0c366d121791b99b71a144e38880df55.webp","original":"https://scriptblox.com/images/photo/679a35fa27aa428b99da9215-1740256886761.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:57:00.490Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67fc65db2436f4a0aa487094","editBy":{"_id":"679a35fa27aa428b99da9215","username":"GeniusofAB","status":"offline","id":"679a35fa27aa428b99da9215"},"message":"Create script","createdAt":"2025-04-14T01:33:15.956Z"},{"_id":"67fc66166ac1cd13ae2691c2","editBy":{"_id":"679a35fa27aa428b99da9215","username":"GeniusofAB","status":"offline","id":"679a35fa27aa428b99da9215"},"message":"Update script","createdAt":"2025-04-14T01:34:14.081Z"},{"_id":"67fc677d1ed7bd3c560a6a91