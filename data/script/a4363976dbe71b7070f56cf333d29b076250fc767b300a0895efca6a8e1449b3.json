{"slug":"Broken-Bones-IV-Ragdoll-Sim-Infinite-Money-60110","_id":"68f929fa5f8a0dedcfd1d797","title":"Infinite Money","game":{"_id":"67e5e1ffb360710ec3c78019","gameId":2551991523,"name":"Broken Bones IV","imageUrl":"/images/sb/rbx-06a9b41807fa97c3a7063da15243a9ce-876b9734e969.png","placeId":2551991523},"features":"not my script\n\ndie 1 time then should work","tags":[],"script":"--[[\n\n\t  Credit: @DownInDaNang – Should work after the first death\n\n]]\n\n\nlocal functions = game.ReplicatedStorage:WaitForChild(\"Functions\")\n\n_G.breakslevel = 1000\n_G.speedlevel = 500\n_G.jumplevel = 500\n_G.sprainslevel = 1000\n_G.dislocationslevel = 1000\n_G.flightlevel = 1000\n_G.fuellevel = 1000\n\nhookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)\n    local method = getnamecallmethod()\n    \n    if method == \"InvokeServer\" and self.Parent == functions then\n        local result = {self[method](self, ...)}\n        \n        if result[1] and type(result[1]) == \"table\" then\n            result[1].breakslevel = _G.breakslevel\n            result[1].speedlevel = _G.speedlevel\n            result[1].jumplevel = _G.jumplevel\n            result[1].sprainslevel = _G.sprainslevel\n            result[1].dislocationslevel = _G.dislocationslevel\n            result[1].flightlevel = _G.flightlevel\n            result[1].fuellevel = _G.fuellevel\n        end\n        \n        return unpack(result)\n    end\n    \n    return self[method](self, ...)\nend))\n\nfor _, connection in pairs(getconnections(functions.SendData.OnClientEvent)) do\n    if connection.Function then\n        local oldFunc = connection.Function\n        connection:Disable()\n        \n        functions.SendData.OnClientEvent:Connect(function(data, ...)\n            if data then\n                data.breakslevel = _G.breakslevel\n                data.speedlevel = _G.speedlevel\n                data.jumplevel = _G.jumplevel\n                data.sprainslevel = _G.sprainslevel\n                data.dislocationslevel = _G.dislocationslevel\n                data.flightlevel = _G.flightlevel\n                data.fuellevel = _G.fuellevel\n            end\n            return oldFunc(data, ...)\n        end)\n    end\nend","owner":{"_id":"6677438aaf90bba397e78e64","username":"FREEDIDDY","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6677438aaf90bba397e78e64","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":4900,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-4a0580a7c16e4d2e14f5af313a2d7d7c-4d28d0c78e98.png","likeCount":4,"dislikeCount":1,"createdAt":"2025-10-22T19:01:14.733Z","editBy":{"_id":"6677438aaf90bba397e78e64","username":"FREEDIDDY","status":"offline","id":"6677438aaf90bba397e78e64"},"executes":11616,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":10239,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f929fa5f8a0dedcfd1d799","editBy":{"_id":"6677438aaf90bba397e78e64","username":"FREEDIDDY","status":"offline","id":"6677438aaf90bba397e78e64"},"message":"Create script","createdAt":"2025-10-22T19:01:14.738Z"},{"_id":"68f92a2c8ff7330d967c4737","editBy":{"_id":"6677438aaf90bba397e78e64","username":"FREEDIDDY","status":"offline","id":"6677438aaf90bba397e78e64"},"message":"Update script","createdAt":"2025-10-22T19:02:04.541Z"}],"comments":[{"_id":"68f92bd1dc97b5c4c010c66c","commentBy":{"_id":"68ed543ca16f4cc5b29b214d","username":"kloose","verified":false,"role":"user","profilePicture":"/images/photo/68ed543ca16f4cc5b29b214d-1761764485188.jpg","createdAt":"2025-10-13T19:34:20.648Z","lastActive":"2025-11-10T19:34:16.877Z","status":"offline","id":"68ed543ca16f4cc5b29b214d"},"text":"bro when do i needa execute it also it isnt working","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-22T19:09:05.035Z","liked":false,"dislik