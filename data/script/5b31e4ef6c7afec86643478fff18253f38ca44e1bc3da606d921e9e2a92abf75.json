{"slug":"Universal-Script-Zinzo-UI-51534","_id":"68b84c31aa70961a6b297c47","title":"Zinzo UI","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1756908593547.png","placeId":0},"features":"This UI features; \n-Folder (Separate script, pretty much just tabs )\n-Button\n-Toggle\n-Dropdown\n-Slider\n-Keybind\n-Color Picker\n\nSo overall, this UI supports buttons, toggles, dropdowns, sliders, keybinds, and color pickers.\n\nThe UI was made by Zinzo (I think) \nI take no credit for the UI\n\nMy Github - https://github.com/DozeIsOkLol/UILibarys/blob/main/Zinzo%20UI%20Lib","tags":["UI","GUI","UILib"],"script":"local library = loadstring(\n    game:HttpGet(\n        'https://raw.githubusercontent.com/DozeIsOkLol/UILibarySource/refs/heads/main/Zinzo%20UI%20Lib'\n    )\n)()\nlocal window = library:window('Zinzo UI')\nlocal folder = window:folder('Folder')\nlocal folder1 = window:folder('Brought to u by UILib')\n\nfolder:button({\n    name = 'Button',\n    callback = function()\n        print('Button')\n    end,\n})\n\nfolder:toggle({ name = 'Toggle', flag = 'toggle' })\nlocal dropdown = folder:dropdown({\n    name = 'Dropdown',\n    flag = 'dropdown',\n    content = { 'Dropdown 1', 'Dropdown 2' },\n})\n\n--dropdown:refresh(newcontent)\nfolder:slider({ name = 'Slider', flag = 'slider', min = 0, max = 200 })\nfolder:keybind({\n    name = 'Keybind',\n    flag = 'keybind',\n    default = Enum.KeyCode.D,\n    callback = function()\n        print('Keybind')\n    end,\n})\n\nfolder:colorpicker({\n    name = 'Color Picker',\n    flag = 'colorpicker',\n    default = Color3.fromRGB(50, 255, 255),\n    function(v)\n        print('colorpicker = ' .. v)\n    end,\n})\n","owner":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","verified":false,"profilePicture":"/images/photo/68041bdbaf3d8ab50c6cb1a8-1765231278579.jpg","status":"offline","id":"68041bdbaf3d8ab50c6cb1a8","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":767,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1756908593547.png","likeCount":3,"dislikeCount":2,"createdAt":"2025-09-03T14:09:53.573Z","executes":3,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b84c31aa70961a6b297c49","editBy":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","status":"offline","id":"68041bdbaf3d8ab50c6cb1a8"},"message":"I take no credit for the UI","createdAt":"2025-09-03T14:09:53.590Z"}],"comments":[{"_id":"68b84cb929ed8f1edb1b939e","commentBy":{"_id":"68abd53e75ed45b5f6ebd390","username":"Voidsaken","verified":false,"role":"user","profilePicture":"/images/user-default.png","createdAt":"2025-08-25T03:15:10.199Z","lastActive":"2025-09-26T02:51:22.801Z","status":"offline","id":"68abd53e75ed45b5f6ebd390"},"text":"whats the key","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-03T14:12:09.970Z","liked":false,"disliked":false},{"_id":"68b84ce96ae0b7235ee94e8f","commentBy":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","verified":false,"role":"user","profilePicture":"/images/photo/68041bdbaf3d8ab50c6cb1a8-1765231278579.jpg","createdAt":"2025-04-19T21:55:39.060Z","lastActive":"2026-10-09T21:40:12.355Z","status":"offline","id":"68041bdbaf3d8ab50c6cb1a8","topMilestone":{"key":"creator.scripts","tier":25}},"text":"@DharMann there isnt a key?","parent":{"_id":"68b84cb929ed8f1edb1b939e","commentBy":{"_id":"68abd53e75ed45b5f6ebd390","username":"Voidsaken","profilePicture":"/images/user-default.png","status":"offline","id":"68abd53e75ed45b5f6ebd390"},"text":"whats the key"},"edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-09-03T14:12:57.753Z","liked":false,"disliked":false},{"_id":"68b84d0eaa70961a6b2994ff","commentBy":{"_id":"68abd53e75ed45b5f6ebd390","username":"Voidsaken","verified":false,"role":"user","profilePicture":"/images/user-default.png","createdAt":"2025-