n 1', 'Dropdown 2' },\n})\n\n--dropdown:refresh(newcontent)\nfolder:slider({ name = 'Slider', flag = 'slider', min = 0, max = 200 })\nfolder:keybind({\n    name = 'Keybind',\n    flag = 'keybind',\n    default = Enum.KeyCode.D,\n    callback = function()\n        print('Keybind')\n    end,\n})\n\nfolder:colorpicker({\n    name = 'Color Picker',\n    flag = 'colorpicker',\n    default = Color3.fromRGB(50, 255, 255),\n    function(v)\n        print('colorpicker = ' .. v)\n    end,\n})\n","features":"This UI features; \n-Folder (Separate script, pretty much just tabs )\n-Button\n-Toggle\n-Dropdown\n-Slider\n-Keybind\n-Color Picker\n\nSo overall, this UI supports buttons, toggles, dropdowns, sliders, keybinds, and color pickers.\n\nThe UI was made by Zinzo (I think) \nI take no credit for the UI\n\nMy Github - https://github.com/DozeIsOkLol/UILibarys/blob/main/Zinzo%20UI%20Lib","tags":["UI","GUI","UILib"],"discord":"","keyLink":"","owner":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4c662d4db3dbf77e87e5878b31bce97ed02b3d1ed3775325685ab16fbf787f38.webp","original":"https://scriptblox.com/images/photo/68041bdbaf3d8ab50c6cb1a8-1765231278579.jpg"},"lvl":14,"status":"offline","id":"68041bdbaf3d8ab50c6cb1a8","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/4c662d4db3dbf77e87e5878b31bce97ed02b3d1ed3775325685ab16fbf787f38.webp","original":"https://scriptblox.com/images/photo/68041bdbaf3d8ab50c6cb1a8-1765231278579.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:50:48.176Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b84c31aa70961a6b297c49","editBy":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","status":"offline","id":"68041bdbaf3d8ab50c6cb1