{"_id":"69d9505d7a851b3c4c721fd4","title":"NATURAL DISASTER GOD MODE","game":{"_id":"67e5e1ffb360710ec3c77dd3","gameId":189707,"name":"Natural Disaster Survival","imageUrl":{"url":"https://media.kocakz.me/ab0cea4ba1d32b19fe6f00cc0b6c155b74bcba1d139d63e62626cce3b4e6290b.webp","original":"https://tr.rbxcdn.com/180DAY-ac1c764a99cfae201fd4fe916170a218/150/150/Image/Png/noFilter"},"slug":"189707-natural-disaster-survival","path":"/game/189707-natural-disaster-survival","thumbnail":{"url":"https://media.kocakz.me/ab0cea4ba1d32b19fe6f00cc0b6c155b74bcba1d139d63e62626cce3b4e6290b.webp","original":"https://tr.rbxcdn.com/180DAY-ac1c764a99cfae201fd4fe916170a218/150/150/Image/Png/noFilter"},"placeId":189707},"slug":"Natural-Disaster-Survival-NATURAL-DISASTER-GOD-MODE-200705","verified":false,"key":false,"keyless":false,"views":12410,"executes":16710,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ede24e4225e6faa2601c492602bfb91c7d116584f1171c0338fc6b04efcdf996.webp","original":"https://scriptblox.com/images/sb/rbx-7ea7065a02f8cff80f8b0270a9ad2d3b-0820ff9b1f88.png","scriptblox":"https://scriptblox.com/images/script/rbx-7ea7065a02f8cff80f8b0270a9ad2d3b-0820ff9b1f88.png"},"thumbnail":{"url":"https://media.kocakz.me/ede24e4225e6faa2601c492602bfb91c7d116584f1171c0338fc6b04efcdf996.webp","original":"https://scriptblox.com/images/sb/rbx-7ea7065a02f8cff80f8b0270a9ad2d3b-0820ff9b1f88.png","scriptblox":"https://scriptblox.com/images/script/rbx-7ea7065a02f8cff80f8b0270a9ad2d3b-0820ff9b1f88.png"},"likeCount":10,"dislikeCount":4,"createdAt":"2026-04-10T19:32:45.976Z","updatedAt":"2026-04-10T19:32:45.976Z","lastBump":"2026-04-10T19:32:45.976Z","script":"local RS = game:GetService(\"RunService\")\nlocal Pl = game:GetService(\"Players\")\nlocal lp = Pl.LocalPlayer\nlocal lb = loadstring(game:HttpGet(\"https://absent.wtf/AKADMINLIB/LIB.lua\"))()\n\nlocal NDS_PLACE_ID = 189707\n\nif game.PlaceId ~= NDS_PLACE_ID then\n\tlb:notify(\"Wrong Game\", \"This command is only for Natural Disaster Survival\", nil, true)\n\treturn\nend\n\nlocal wn = lb.new(\"NDS GODMODE\")\nlocal _t = wn:addTab(\"Main\")\nwn:switchTab(_t)\n\nlocal INF = math.huge\nlocal hb = nil\nlocal gmEnabled = false\n\nlocal function applyGodmode()\n\tfor _, v in pairs(getgc(true)) do\n\t\tif type(v) == \"table\" then\n\t\t\tlocal h = rawget(v, \"Health\")\n\t\t\tif h and h ~= INF then\n\t\t\t\trawset(v, \"Health\", INF)\n\t\t\t\trawset(v, \"MaxHealth\", INF)\n\t\t\tend\n\t\tend\n\tend\n\tif lp.Character then\n\t\tlocal hu = lp.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\tif hu then\n\t\t\thu.MaxHealth = INF\n\t\t\thu.Health = INF\n\t\t\thu:SetStateEnabled(Enum.HumanoidStateType.Dead, false)\n\t\tend\n\tend\nend\n\nlocal function startGodmode()\n\tapplyGodmode()\n\tif hb then hb:Disconnect() hb = nil end\n\tlocal gcTimer = 0\n\tlocal GC_FREQ = 5\n\thb = RS.Heartbeat:Connect(function(dt)\n\t\tif lp.Character then\n\t\t\tlocal hu = lp.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tif hu then\n\t\t\t\tif hu.MaxHealth ~= INF then hu.MaxHealth = INF end\n\t\t\t\thu.Health = hu.MaxHealth\n\t\t\t\thu:SetStateEnabled(Enum.HumanoidStateType.Dead, false)\n\t\t\tend\n\t\t\tgcTimer = gcTimer + dt\n\t\t\tif gcTimer >= GC_FREQ then\n\t\t\t\tgcTimer = 0\n\t\t\t\tfor _, v in pairs(getgc(true)) do\n\t\t\t\t\tif type(v) == \"table\" then\n\t\t\t\t\t\tlocal h = rawget(v, \"Health\")\n\t\t\t\t\t\tif h and h ~= INF then\n\t\t\t\t\t\t\trawset(v, \"Health\", INF)\n\t\t\t\t\t\t\trawset(v, \"MaxHealth\", INF)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\nend\n\nlocal function stopGodmode()\n\tif hb then hb:Disconnect() hb = nil end\nend\n\nwn:addConnection(lp.CharacterAdded, function()\n\ttask.wait(1)\n\tif gmEnabled then\n\t\tstartGodmode()\n\tend\nend)\n\nwn:addToggle(\"God Mode\", false, function(state)\n\tgmEnabled = state\n\tif state then\n\t\tstartGodmode()\n\telse\n\t\tstopGodmode()\n\tend\nend)\n\nwn:onClose(function()\n\tstopGodmode()\nend)\n\nwn:switchTab(_t)\n","features":"Godmode For Natural Disasters","tags":["NATURAL DISASTER SURVIVAL","GODMODE","AK ADMIN","GOD MOD"],"discord":"https://discord.gg/akadmin","keyLink":"","owner":{"_id":"69adf61c67b3dcfd36f87414","username":"Biscuit21","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4ab6c9f50513703a263ea239c2557de5f4e8c11c99e967881e0df4441288e096.webp","original":"https://scriptblox.com/images/photo/69adf61c67b3dcfd36f87414-1773008549939.jpg"},"status":"offline","id":"69adf61c67b3dcfd36f87414","profile":{"url":"https://media.kocakz.me/4ab6c9f50513703a263ea239c2557de5f4e8c11c99e967881e0df4441288e096.webp","original":"https://scriptblox.com/images/photo/69adf61c67b3dcfd36f87414-1773008549939.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":1,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-20T01:39:23.585Z","last":"b","win":14,"math":3,"why":{"pa":1}},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d9505e7a851b3c4c721fd8","editBy":{"_id":"69adf61c67b3dcfd36f87414","username":"Biscuit21","status":"offline","id":"69adf61c67b3dcfd36f87414"},"message":"Create script","createdAt":"2026-04-10T19:32:46.002Z"}],"comments":[{"_id":"69da6606a3a154e3f0611596","commentBy":{"_id":"69847aa77caac93f6831155e","username":"Mask_real","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-04-23T05:17:37.753Z","createdAt":"2026-02-05T11:10:31.693Z","status":"offline","id":"69847aa77caac93f6831155e","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"nice script","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-11T15:17:26.502Z","liked":false,"disliked":false},{"_id":"69dc3c55a08755340fc2f52b","commentBy":{"_id":"69dc3c270afd115a954bcdc7","username":"mekusmekus"