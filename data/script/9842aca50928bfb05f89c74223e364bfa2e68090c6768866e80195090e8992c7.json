{"slug":"PERKS-Protect-The-House-From-Monsters-Anti-Lag-Remove-Trees-51069","_id":"68b4f74c36fa753ace2002ea","title":"Anti Lag Remove Trees","game":{"_id":"689d33648e79f028af63e629","gameId":115286378269814,"name":"Protect The House From Monsters","imageUrl":"/images/sb/rbx-bca0588f499a584ef4e21fd285ff4713-406d55f7f837.png","placeId":115286378269814},"features":"- Remove trees literally\n- To revert, you must rejoin","tags":["pth","protectthehousefrommonsters","protectthehouse","Antilag"],"script":"local trees = {}\n\nlocal function scan(parent)\n    for _, obj in ipairs(parent:GetChildren()) do\n        if string.find(obj.Name:lower(), \"tree\") then\n            table.insert(trees, obj)\n        else\n            local found = false\n            for _, child in ipairs(obj:GetChildren()) do\n                if string.find(child.Name:lower(), \"tree\") then\n                    found = true\n                    break\n                end\n            end\n            if found then\n                table.insert(trees, obj)\n            else\n                scan(obj)\n            end\n        end\n    end\nend\n\nscan(workspace)\n\ntask.spawn(function()\n    for _, obj in ipairs(trees) do\n        if obj and obj.Parent then\n            obj:Destroy()\n        end\n        task.wait(0.5)\n    end\nend)\n\n-- 09 01 25\n-- JAI","owner":{"_id":"680dd2ac0c691f15c001af29","username":"_JAI","verified":false,"profilePicture":"/images/photo/680dd2ac0c691f15c001af29-1783905450363.png","status":"offline","id":"680dd2ac0c691f15c001af29","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":12035,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-ce7327aa36615489f5a593517d095193-49ed63ca3a06.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-09-01T01:30:52.477Z","editBy":{"_id":"680dd2ac0c691f15c001af29","username":"_JAI","status":"offline","id":"680dd2ac0c691f15c001af29"},"executes":615,"keyless":fals