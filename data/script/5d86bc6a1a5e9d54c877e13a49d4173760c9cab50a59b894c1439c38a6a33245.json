{"slug":"Universal-Script-printidentity-Validator-15130","_id":"6682a48cd80e909010c0ce72","title":"printidentity validator","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Checks if printidentity is faked in your executor.\n(If it's not fake, You should see in console 'Your executor got a 100% rating'.)\nYes, I know the code is horrible but i'm NOT formatting it now.","tags":["wave","solara","universal","printidentity","bypass"],"script":"local Rating, TestsRan = 0, 1\nlocal conn\nlocal Identity, Identity2\nconn = game:GetService(\"LogService\").MessageOut:Connect(function(message, messageType)\n if message:find(\"Current identity is\") then\n  Identity = message\n end\n if Check2 then\n   Identity2 = message\n  conn:Disconnect()\n end\nend)\nprintidentity()\nrepeat task.wait() until Identity\nIdentity1 = tonumber(Identity:gsub('Current identity is', ''):match(\"%d+\"))\nif Identity1 > 9 then\n warn(\"Your executor is faking their identity.\\nReason: Identity cannot be over 9\")\n return\nend\n-- Start testing\nlocal Source1 = debug.info(printidentity, 's')\n-- Can be faked with newcclosure.\n\nlocal setfenvsuccess, e = pcall(function()\n setfenv(printidentity, {})\nend)\n\nlocal success\nlocal sti = set_thread_identity or setthreadidentity\n\nif sti then\n setthreadidentity(3)\n Check2 = true\n printidentity()\n repeat task.wait() until Identity2\n success = Identity2 ~= 'Current identity is 3'\nend\n\nlocal Tests = { -- Should be FALSE for all if no faking is done.\n [1] = Source1 ~= '[C]',\n [2] = setfenvsuccess,\n [3] = success,\n [4] = iscclosure and not iscclosure(printidentity)\n}\nlocal TestResults = {\n [1] = `Creates a fake function by doing:\\nfunction printidentity()\\n print('{Identity}')\\nend`,\n [2] = 'Creates a fake function and tries to hide it with newcclosure.',\n [3] = 'Detected by it\\'s own set_thread_identity.',\n [4] = 'Same as test #1'\n}\n\nlocal Passed = 0\n\nfor index, val in next, Tests do\n  if val then\n   warn(`Test #{index}: Your executor fakes their printidentity, here's how: {TestResults[index]}`)\n  else\n   Passed = Passed + 1\n  end\nend\nif Passed == #Tests then\n  print(\"Your executor does not fake it's identity!\\nIdentity:\",Identity1)\n  Rating += 1\nend\n\nprint(`Your executor got a {(Rating / TestsRan) * 100}% rating.`)","owner":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"profilePicture":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"},"status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13468205}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"}},"verified":true,"keyLink":"","views":120114,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-07-01T12:43:56.437Z","dislikeCount":19,"likeCount":10,"image":{"url":"https://media.kocakz.me/b8040de937af28d7a9fd4459c72813ecb11d0f61046e43f598dab6026b00e3d4.webp","original":"https://scriptblox.com/images/sb/1537031-1719837836215.webp","scriptblox":"https://scriptblox.com/images/script/1537031-1719837836215.webp"},"executes":110,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:16:20.594Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.koc