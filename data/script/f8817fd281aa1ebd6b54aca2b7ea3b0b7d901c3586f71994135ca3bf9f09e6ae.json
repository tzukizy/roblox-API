{"_id":"64edd64fa7695b9212b964f8","title":"Server Crasher","game":{"_id":"67e5e1ffb360710ec3c785f7","gameId":7243254032,"name":"Bloody Baseplate [🧊🍁]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"7243254032-bloody-baseplate","path":"/game/7243254032-bloody-baseplate","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":7243254032},"slug":"FIX-Bloody-Baseplate-Server-Crasher-7470","verified":false,"key":false,"keyless":false,"views":17470,"executes":9,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/7846feaa08e142228fa0f3120370d80ca48ef8a63b84c43fca1c99ebce47c467.webp","original":"https://scriptblox.com/images/sb/7243254032-1693308495050.webp","scriptblox":"https://scriptblox.com/images/script/7243254032-1693308495050.webp"},"thumbnail":{"url":"https://media.kocakz.me/7846feaa08e142228fa0f3120370d80ca48ef8a63b84c43fca1c99ebce47c467.webp","original":"https://scriptblox.com/images/sb/7243254032-1693308495050.webp","scriptblox":"https://scriptblox.com/images/script/7243254032-1693308495050.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2023-08-29T11:28:15.152Z","updatedAt":"2023-08-29T11:28:15.152Z","lastBump":"2023-08-29T11:28:15.152Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nwhile true do\n    wait()\n    local cplr = nil\n    local cdist = math.huge\n    for _, oplr in ipairs(Players:GetPlayers()) do\n        if oplr ~= LocalPlayer and oplr.Character and oplr.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local dist = (oplr.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude\n            if dist < cdist then\n                cplr = oplr\n                cdist = dist\n            end\n        end\n    end\n\tfor i = 1, 50 do --remove this if you want a semi-killaura (this right now actually is a double use as it can also shoot the closest player)\n    \tLocalPlayer.Character.Glock.RemoteEvent:FireServer(cplr.Character.HumanoidRootPart.Position, cplr.Character.HumanoidRootPart.Position)\n\tend --remove this too if you want the killaura\nend\n","features":"make sure to equip the glock before running the script, if you unequip it while running the script then after a few minutes it will eventually go back to normal after a few fps drops and ping going to 50k-100k+ then dropping down","tags":[],"discord":"","keyLink":"","owner":{"_id":"622169daab4b208e46f37c86","username":"relevant","verified":false,"profilePicture":{"url":"https://media.kocakz.me/158c956ebcff886da32c6426962518612a1de6fab96a7840a7537c618606c212.webp","original":"https://scriptblox.com/images/photo/622169daab4b208e46f37c86-1693311171897.png"},"status":"offline","id":"622169daab4b208e46f37c86","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/158c956ebcff886da32c6426962518612a1de6fab96a7840a7537c618606c212.webp","original":"https://scriptblox.com/images/photo/622169daab4b208e46f37c86-1693311171897.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:19:17.431Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f85a","editBy":{"_id":"622169daab4b208e46f37c86","username":"relevant","status":"offline","id":"622169daab4b208e46f37c86"},"message":"Create script","createdAt":"2025-03-26T22:35:14.301Z"}],"comments":[{"_id":"64ee37d758cfa8814caed218","commentBy":{"_id":"62b4a7437ebf0deda991b881","username":"reco","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c31285425774e3bcddacc7a1eea55f607c33c0ed3d6e790b93924aac7093bd40.webp","original":"https://scriptblox.com/images/photo/62b4a7437ebf0deda991b881-1767082273486.pn