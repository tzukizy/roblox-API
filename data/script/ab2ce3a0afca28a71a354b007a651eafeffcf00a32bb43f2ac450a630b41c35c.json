lder is located at /workspace/ap.net/settings/*\n\nmade by xn1781, zwag and neptune","tags":["Kill Aura","Silent Aim","ESP","Autofarm","Auto Parry"],"discord":"","keyLink":"","owner":{"_id":"630df52d9541ae5f4eb03cf3","username":"xn1781","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1a318aba17952192d6599596f7979fdaf30bd29f5f61445bf24f238fc657ce17.webp","original":"https://scriptblox.com/images/photo/630df52d9541ae5f4eb03cf3-1740462215614.png"},"status":"offline","id":"630df52d9541ae5f4eb03cf3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/1a318aba17952192d6599596f7979fdaf30bd29f5f61445bf24f238fc657ce17.webp","original":"https://scriptblox.com/images/photo/630df52d9541ae5f4eb03cf3-1740462215614.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:06:16.785Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c5598a","editBy":{"_id":"630df52d9541ae5f4eb03cf3","username":"xn1781","status":"offline","id":"630df52d9541ae5f4eb03cf3"},"message":"Create script","createdAt":"2025-03-27T23:12:36.094Z"}],"comments":[{"_id":"67d3c48001d71da76b02f7da","commentBy":{"_id":"61d110f11ee5b6ba370dff2f","username":"JohnnyD4C","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-01-02T02:41:53.175Z","lastActive":"2025-12-27T09:00:57.206Z","status":"offline","id":"61d110f11ee5b6ba370dff2f","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Someone should totally give me a free combat warriors account dc: JohnnyD4C","createdAt":"2025-03-14T05:54:08.909Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"67d561188ce55e2cd8ce6d14","commentBy":{"_id":"67d5609e8ce55e2cd8ce63b7","username":"piz