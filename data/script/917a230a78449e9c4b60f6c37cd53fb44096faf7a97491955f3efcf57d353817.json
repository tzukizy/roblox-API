{"slug":"Universal-Script-Permadeath-script-Executor-test-40007","_id":"6827ac6982ecc3177154f6c7","title":"Permadeath script Executor test","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1747430505531.png","placeId":0},"features":"Permadeath script, Kills you forever. good for fe scripts that kill you and load animations like clovr, you can respawn by going to ur roblox menu and resetting, its also customizable if ur not a skid, also this was made by gee cee hub","tags":["roblox","permadeath","fe script","script","fe"],"script":"local StarterGui = game:GetService(\"StarterGui\")\nlocal Players = game:GetService(\"Players\")\n\nlocal Player = Players.LocalPlayer\n\nStarterGui:SetCore(\"SendNotification\",{Title = \"Permadeath\",Text = \"Please wait \"..Players.RespawnTime..\" seconds\"})\n\nreplicatesignal(Player.ConnectDiedSignalBackend)\ntask.wait(Players.RespawnTime + 0.20)\nreplicatesignal(Player.Kill)\n\nlocal RespawnEvent = Instance.new(\"BindableEvent\")\n\nRespawnEvent.Event:Once(function()\n    StarterGui:SetCore(\"SendNotification\",{Title = \"Respawning\",Text = \"Please wait \"..Players.RespawnTime..\" seconds\"})\n    StarterGui:SetCore(\"ResetButtonCallback\", true)    \n\n    replicatesignal(Player.ConnectDiedSignalBackend)\nend)\n\nStarterGui:SetCore(\"ResetButtonCallback\", RespawnEvent)","owner":{"_id":"681d468d19d50c23e232ca82","username":"sirmeowsnotalot","verified":false,"profilePicture":"/images/photo/681d468d19d50c23e232ca82-1746749120586.png","status":"offline","id":"681d468d19d50c23e232ca82","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":9245,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1747430505531.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-05-16T21:21:45.597Z","executes":1171,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6827ac6982ec