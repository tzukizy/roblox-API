{"slug":"Universal-Script-Anti-fog-30771","_id":"67c57935f08a78763fc97336","title":"Anti fog","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Removes fog","tags":["Roblox","Script","Anti rig"],"script":"-- Services\nlocal Lighting = game:GetService(\"Lighting\")\nlocal RunService = game:GetService(\"RunService\")\n\n-- Function to remove fog\nlocal function removeFog()\n    Lighting.FogEnd = 1e10 -- Set very high to remove fog\n    Lighting.FogStart = 1e10\n    Lighting.Atmosphere = nil -- Remove atmosphere effects if they exist\nend\n\n-- Run the function initially\nremoveFog()\n\n-- Continuously ensure fog doesn't come back\nRunService.RenderStepped:Connect(function()\n    removeFog()\nend)","owner":{"_id":"67988e64b81fb3da1d66d8dd","username":"El_VireXus","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/534b414c9edb200335c963c3b2d849e4896d19923106191d49cfb714de60d276.webp","original":"https://scriptblox.com/images/photo/67988e64b81fb3da1d66d8dd-1740551877088.png"},"status":"offline","id":"67988e64b81fb3da1d66d8dd","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/534b414c9edb200335c963c3b2d849e4896d19923106191d49cfb714de60d276.webp","original":"https://scriptblox.com/images/photo/67988e64b81fb3da1d66d8dd-1740551877088.png"}},"verified":false,"keyLink":"","views":5179,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-03T09:41:09.353Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/5e01dcf583ee38d56e6f095926cf841afef445e84119f1a5ae0a0ecc1de6c41f.webp","original":"https://scriptblox.com/images/sb/9718426-1740994869308.png","scriptblox":"https://scriptblox.com/images/script/9718426-1740994869308.png"},"execute