{"_id":"68cce7f429661493dfcc184a","title":"Singing Me (fixed)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/e9d6814c6c400f1bee512d29be505daf2bf759307f497d76e3d6bbd229a03865.webp","original":"https://scriptblox.com/images/sb/0-1758259188272.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/e9d6814c6c400f1bee512d29be505daf2bf759307f497d76e3d6bbd229a03865.webp","original":"https://scriptblox.com/images/sb/0-1758259188272.png"},"placeId":0},"slug":"Universal-Script-Singing-Me-53898","verified":false,"key":false,"keyless":false,"views":7077,"executes":209,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/bdae199bd2ae558ea207ee22ebe95b978e203b8f1818c488d2fc472282e2bd91.webp","original":"https://scriptblox.com/images/sb/0-1758259188272.png","scriptblox":"https://scriptblox.com/images/script/0-1758259188272.png"},"thumbnail":{"url":"https://media.kocakz.me/bdae199bd2ae558ea207ee22ebe95b978e203b8f1818c488d2fc472282e2bd91.webp","original":"https://scriptblox.com/images/sb/0-1758259188272.png","scriptblox":"https://scriptblox.com/images/script/0-1758259188272.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-09-19T05:19:48.287Z","updatedAt":"2025-09-19T05:19:48.287Z","lastBump":"2025-09-19T05:19:48.287Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal plr = Players.LocalPlayer\nlocal char = plr.Character or plr.CharacterAdded:Wait()\n\nlocal head = char:WaitForChild(\"Head\")\nlocal torso = char:FindFirstChild(\"Torso\") or char:FindFirstChild(\"UpperTorso\")\nlocal neck = torso:WaitForChild(\"Neck\")\n\nlocal face = head:FindFirstChild(\"face\")\nif face then face:Destroy() end\n\nlocal sound = Instance.new(\"Sound\")\nsound.Parent = head\nsound.Volume = 1\nsound.Looped = true\n\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"AudioUI\"\ngui.ResetOnSpawn = false\ngui.Parent = plr:WaitForChild(\"PlayerGui\")\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 200, 0, 60)\nframe.Position = UDim2.new(0.5, -100, 0.5, -30)\nframe.BackgroundColor3 = Color3.fromRGB(120,120,120)\nframe.BorderSizePixel = 0\nframe.Parent = gui\n\nlocal dragBar = Instance.new(\"TextLabel\")\ndragBar.Size = UDim2.new(1, 0, 0, 20)\ndragBar.BackgroundColor3 = Color3.fromRGB(90,90,90)\ndragBar.Text = \"Drag Me\"\ndragBar.TextSize = 14\ndragBar.TextColor3 = Color3.new(1,1,1)\ndragBar.Parent = frame\ndragBar.Active = true\n\nlocal box = Instance.new(\"TextBox\")\nbox.Size = UDim2.new(1, -10, 0, 30)\nbox.Position = UDim2.new(0, 5, 0, 25)\nbox.BackgroundColor3 = Color3.fromRGB(200,200,200)\nbox.Text = \"Enter Audio ID\"\nbox.ClearTextOnFocus = true\nbox.Parent = frame\n\nbox.FocusLost:Connect(function(enterPressed)\n\tif enterPressed then\n\t\tlocal id = box.Text:gsub(\"%D\", \"\")\n\t\tif id ~= \"\" then\n\t\t\tsound:Stop()\n\t\t\tsound.SoundId = \"rbxassetid://\" .. id\n\t\t\tsound:Play()\n\t\tend\n\tend\nend)\n\nlocal dragging = false\nlocal dragStart\nlocal startPos\n\ndragBar.InputBegan:Connect(function(input)\n\tif input.UserInputType == Enum.UserInputType.MouseButton1 \n\tor input.UserInputType == Enum.UserInputType.Touch then\n\t\t\n\t\tdragging = true\n\t\tdragStart = input.Position\n\t\tstartPos = frame.Position\n\n\t\tinput.Changed:Connect(function()\n\t\t\tif input.UserInputState == Enum.UserInputState.End then\n\t\t\t\tdragging = false\n\t\t\tend\n\t\tend)\n\tend\nend)\n\nUIS.InputChanged:Connect(function(input)\n\tif dragging and (input.UserInputType == Enum.UserInputType.MouseMovement \n\tor input.UserInputType == Enum.UserInputType.Touch) then\n\t\t\n\t\tlocal delta = input.Position - dragStart\n\t\tframe.Position = UDim2.new(\n\t\t\tstartPos.X.Scale,\n\t\t\tstartPos.X.Offset + delta.X,\n\t\t\tstartPos.Y.Scale,\n\t\t\tstartPos.Y.Offset + delta.Y\n\t\t)\n\tend\nend)\n\nlocal function createPart(size, position)\n\tlocal part = Instance.new(\"Part\")\n\tpart.Size = Vector3.new(1,1,1)\n\tpart.Anchored = false\n\tpart.CanCollide = false\n\tpart.BrickColor = BrickColor.new(\"Black\")\n\tpart.Parent = head\n\n\tlocal mesh = Instance.new(\"SpecialMesh\")\n\tmesh.MeshType = Enum.MeshType.Sphere\n\tmesh.Scale = size\n\tmesh.Parent = part\n\n\tlocal weld = Instance.new(\"Weld\")\n\tweld.Part0 = part\n\tweld.Part1 = head\n\tweld.C1 = position\n\tweld.Parent = part\n\n\treturn mesh\nend\n\nlocal eye1m = createPart(Vector3.new(0.02,0.12,0.03), CFrame.new(-.17,.14,-.57))\nlocal eye2m = createPart(Vector3.new(0.02,0.12,0.03), CFrame.new(.17,.14,-.57))\nlocal mouthm = createPart(Vector3.new(.13,0.1,0.05), CFrame.new(0,-.25,-.6))\n\nlocal ogsize = mouthm.Scale\n\nRunService.RenderStepped:Connect(function()\n\tif sound.IsPlaying then\n\t\tlocal loudness = sound.PlaybackLoudness\n\n\t\tmouthm.Scale = mouthm.Scale:Lerp(\n\t\t\tVector3.new(\n\t\t\t\togsize.X + loudness/20000,\n\t\t\t\tloudness/1000,\n\t\t\t\togsize.Z\n\t\t\t),\n\t\t\t0.8\n\t\t)\n\n\t\tneck.C0 = neck.C0:Lerp(\n\t\t\tCFrame.new(0,1,0) *\n\t\t\tCFrame.Angles(\n\t\t\t\tmath.rad(mouthm.Scale.Y * 100) - math.rad(90),\n\t\t\t\t0,\n\t\t\t\tmath.rad(180)\n\t\t\t),\n\t\t\t0.1\n\t\t)\n\tend\nend)","features":"It's fixed!\nPut a sound ID in the audio box, then it'll play it and sync it's mouth with it. \nExample: 99298451577207\nThe script will sync the mouth with the sound that is currently playing.","tags":[],"discord":"","keyLink":"","owner":{"_id":"68afe80c9d3c07cb1665aedf","username":"NotJohnDoeExploits","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5d66469fc02fb887f8d16c6aa5a21004ee9ac1e09fd21dc10306519dd352e172.webp","original":"https://scriptblox.com/images/photo/68afe80c9d3c07cb1665aedf-1764924480442.jpg"},"status":"offline","id":"68afe80c9d3c07cb1665aedf","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/5d66469fc02fb887f8d16c6aa5a21004ee9ac1e09fd21dc10306519dd352e172.webp","original":"https://scriptblox.com/images/photo/68afe80c9d3c07cb1665aedf-1764924480442.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:55:53.110Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cce7f429661493dfcc184c","editBy":{"_id":"68afe80c9d3c07cb1665aedf","username":"NotJohnDoeExploits","status":"offline","id":"68afe80c9d3c07cb1665aedf"},"message":"Create script","createdAt":"2025-09-19T05:19:48.290Z"},{"_id":"69ddfd38fd16bf1310d795a6","editBy":{"_id":"68afe80c9d3c07cb1665aedf","username":"NotJohnDoeExploits","status":"offline","id":"68afe80c9d3c07cb1665aedf"},"message":"Update script","createdAt":"2026-04-14T08:39:20.800Z"}],"comments":[{"_id":"68ccf25fc691f915933230d8","commentBy":{"_id":"68b0ec497fed70a08e75f7d3","username":"ALTERRATIC","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/81238b1a39f47f1b248acb5d15b62400a617fc48bb0c40b196f1d8954b8332e0.webp","original":"https://scriptblox.com/images/photo/68b0ec497fed70a08e75f7d3-1759643184572.png"},"createdAt":"2025-08-28T23:54:49.802Z","lastActive":"2026-10-04T03:57:16.946Z","status":"offline","id":"68b0ec497fed70a08e75f7d3","profile":{"url":"https://media.kocakz.me/81238b1a39f47f1b248acb5d15b62400a617fc48bb0c40b196f1d8954b8332e0.webp","original":"https://scriptblox.com/images/photo/68b0ec497fed70a08e75f7d3-1759643184572.png"}},"text":"Is it FE?","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-09-19T06:04:15.202Z","liked":false,"disliked":false},{"_id":"68cd076c934e08306bff5f8f","commentBy":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/231a91d6e162f05365b7028fe6fbc