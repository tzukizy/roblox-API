{"_id":"68e8fe9bf16e09332dd8df63","title":"Auto Attack","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://media.kocakz.me/4d971323d4e760c0ab14aa8b1d4cf37289a279ff54af135ecbeaeb6cf138497b.webp","original":"https://tr.rbxcdn.com/180DAY-fee67c1f98361eac15c13f80b03592ae/150/150/Image/Png/noFilter"},"slug":"155615604-prison-life","path":"/game/155615604-prison-life","thumbnail":{"url":"https://media.kocakz.me/4d971323d4e760c0ab14aa8b1d4cf37289a279ff54af135ecbeaeb6cf138497b.webp","original":"https://tr.rbxcdn.com/180DAY-fee67c1f98361eac15c13f80b03592ae/150/150/Image/Png/noFilter"},"placeId":155615604},"slug":"Prison-Life-Auto-Attack-57467","verified":false,"key":false,"keyless":false,"views":5619,"executes":24,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/0a4b821499ff5d38712d79faacacda3c1be7b7a1711fe5e9f2c7391c64844e56.webp","original":"https://scriptblox.com/images/sb/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png","scriptblox":"https://scriptblox.com/images/script/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png"},"thumbnail":{"url":"https://media.kocakz.me/0a4b821499ff5d38712d79faacacda3c1be7b7a1711fe5e9f2c7391c64844e56.webp","original":"https://scriptblox.com/images/sb/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png","scriptblox":"https://scriptblox.com/images/script/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-10-10T12:39:55.646Z","updatedAt":"2025-10-10T12:39:55.646Z","lastBump":"2025-10-10T12:39:55.646Z","script":"--[[\n\n    Auto Attack (Killaura)\n    Kills the closest player towards you\n    -- [ stav.lua ] --\n\n]]\n\nshared.Aura = true\n\nlocal cloneref = cloneref or function(obj)\n    return obj\nend\nlocal playersService = cloneref(game:GetService('Players'))\nlocal replicatedStorage = cloneref(game:GetService('ReplicatedStorage'))\nlocal lplr = playersService.LocalPlayer\n\nlocal function getClosestPlayer()\n    local closestdist, closestplr = math.huge, nil\n    for i,v in playersService:GetPlayers() do\n        if v == lplr then continue end\n\n        pcall(function()\n            local dist = lplr:DistanceFromCharacter(v.Character.PrimaryPart.Position)\n            if dist < 6 and dist < closestdist then\n                closestdist = dist\n                closestplr = v\n            end\n        end)\n    end\n\n    return closestplr\nend\n\ntask.spawn(function()\n    repeat\n        local plr = getClosestPlayer()\n        if plr then\n            replicatedStorage.meleeEvent:FireServer(plr)\n        end\n\n        task.wait()\n    until not shared.Aura\nend)","features":"Automatically attacks players around you within six studs","tags":["prison","prison life","op"],"discord":"","keyLink":"","owner":{"_id":"66f7165f1c15c6b5c2ce9c9c","username":"stav","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8f6e3d3cae1f0b5dfc6f50b7b8722d28a8520a47db4679951acb31de2338d445.webp","original":"https://scriptblox.com/images/photo/66f7165f1c15c6b5c2ce9c9c-1727469218331.png"},"status":"offline","id":"66f7165f1c15c6b5c2ce9c9c","profile":{"url":"https://media.kocakz.me/8f6e3d3cae1f0b5dfc6f50b7b8722d28a8520a47db4679951acb31de2338d445.webp","original":"https://scriptblox.com/images/photo/66f7165f1c15c6b5c2ce9c9c-1727469218331.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:48:35.780Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e8fe9bf16e09332dd8df65","editBy":{"_id":"66f7165f1c15c6b5c2ce9c9c","username":"stav","status":"offline","id":"66f7165f1c15c6b5c2ce9c9c"},"message":"Create script","createdAt":"2025-10-10T12:39:55.649Z"}],"comments":[{"_id":"68e91e1d3204274c2cdc7338","commentBy":{"_id"