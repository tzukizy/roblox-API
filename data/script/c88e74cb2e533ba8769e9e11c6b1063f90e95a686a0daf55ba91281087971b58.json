{"_id":"67b1e98e04e82289cf7f5fc5","title":"School UI Library","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/66fcddd759ef28aa08b1aae8ce5443046bd71812c45149ffb8da5ccfa1d6c83c.webp","original":"https://scriptblox.com/images/sb/1768350-1739712910839.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/66fcddd759ef28aa08b1aae8ce5443046bd71812c45149ffb8da5ccfa1d6c83c.webp","original":"https://scriptblox.com/images/sb/1768350-1739712910839.png"},"placeId":0},"slug":"Universal-Script-School-UI-Library-29423","verified":false,"key":false,"keyless":false,"views":3448,"executes":36,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/56a050dfd801a565d56a2a2f9893d2540ff3704c7991b4170790df46f32f6bad.webp","original":"https://scriptblox.com/images/sb/1768350-1739712910839.png","scriptblox":"https://scriptblox.com/images/script/1768350-1739712910839.png"},"thumbnail":{"url":"https://media.kocakz.me/56a050dfd801a565d56a2a2f9893d2540ff3704c7991b4170790df46f32f6bad.webp","original":"https://scriptblox.com/images/sb/1768350-1739712910839.png","scriptblox":"https://scriptblox.com/images/script/1768350-1739712910839.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-02-16T13:35:10.952Z","updatedAt":"2025-02-16T13:35:10.952Z","lastBump":"2025-02-16T13:35:10.952Z","script":"--[[ skip the rAnDoMsTrInG function below if you are unsure how to use this UI Library to script your own + removing the function is entirely up to you ]]\nfunction randomString()\n\tlocal length = math.random(50,50)\n\tlocal array = {}\n\tfor i = 1, length do\n\t\tarray[i] = string.char(math.random(32, 126))\n\tend\n\treturn table.concat(array)\nend\n\n--[[ all the lines after 13, after this comment, are what you should look at closely ]]\nlocal components = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/frzfrsy/School/main/source.lua\"))()\n\nlocal form = components:New(\n\t\"School\", --Title of the form\n\tColor3.new(1, 0, 0), --Smoke colour (you can use fromHSV or fromHex or fromRGB)\n\tColor3.new(1, 0, 0), --Outline colour (you can use fromHSV or fromHex or fromRGB)\n\t0 --Smoke thickness (0 to 1, 0 is opaque, 1 is transparent, use decimals if needed)\n)\n\n--[[ BUTTON ]]\nform:Button(\"Print Random String\", \"A various button.\", function()\n\tprint(randomString()) -- rAnDoMsTrInG in used.\nend)\n\n--[[ TOGGLE ]]\nform:Toggle(\"Auto Print\", \"A super toggle.\", function(state)\n\tif state then\n\t\tprint(state)\n\telse\n\t\tprint(state)\n\tend\nend)\n --[[ TEXT BOXES ]]\nform:TextBox(\"Walk Speed\", \"Change your walk speed, input only numeric because you want the speed value not ABC.\", function(val)\n\tgame.Players.LocalPlayer.Character.Humanoid.WalkSpeed = val\nend)\n\nform:TextBox(\"Jump Power\", \"Change your jump power, input only numeric because you want the power value not ABC.\", function(val)\n\tgame.Players.LocalPlayer.Character.Humanoid.JumpPower = val\nend)","features":"Only have 3 elements:\nText Box\nToggle\nButton\n\nSchool is the name of the UI Lib.","tags":[],"discord":"","keyLink":"","owner":{"_id":"651c3407fb99ac3397057e7f","username":"MARIES","verified":false,"profilePicture":{"url":"https://media.kocakz.me/30d80c138925d4d90106ae6169e09300c2a361e6210242389d35081b1cefe391.webp","original":"https://scriptblox.com/images/photo/651c3407fb99ac3397057e7f-1740238178363.png"},"status":"offline","id":"651c3407fb99ac3397057e7f","profile":{"url":"https://media.kocakz.me/30d80c138925d4d90106ae6169e09300c2a361e6210242389d35081b1cefe391.webp","original":"https://scriptblox.com/images/photo/651c3407fb99ac3397057e7f-1740238178363.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:08:31.492Z","