{"slug":"UPD-Build-A-Plane-Lightning-Wheel-Spammer-59042","_id":"68f2ecff00828cede92ab8bc","title":"Lightning Wheel Spammer","game":{"_id":"687fbb66223459fd64c517d7","gameId":137925884276740,"name":"[🌋] ✈️ Build A Plane","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":137925884276740},"features":"This just spams the remote to an unreleased wheel, giving you free unreleased blocks.","tags":["Build a plane","Remotes","Spam","Spin wheel","Simple"],"script":"local ScreenGui = Instance.new(\"ScreenGui\")\nlocal ToggleFrame = Instance.new(\"Frame\")\nlocal ToggleButton = Instance.new(\"TextButton\")\nlocal UICorner = Instance.new(\"UICorner\")\n\nScreenGui.Parent = game.CoreGui\nScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\n\nToggleFrame.Parent = ScreenGui\nToggleFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)\nToggleFrame.BorderSizePixel = 0\nToggleFrame.Position = UDim2.new(0.5, -75, 0.1, 0)\nToggleFrame.Size = UDim2.new(0, 150, 0, 50)\nToggleFrame.Active = true\nToggleFrame.Draggable = true\n\nToggleButton.Parent = ToggleFrame\nToggleButton.BackgroundColor3 = Color3.fromRGB(255, 85, 85)\nToggleButton.Size = UDim2.new(1, 0, 1, 0)\nToggleButton.Font = Enum.Font.GothamBold\nToggleButton.Text = \"OFF\"\nToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\nToggleButton.TextSize = 18\nToggleButton.BorderSizePixel = 0\n\nUICorner.Parent = ToggleFrame\nUICorner.CornerRadius = UDim.new(0, 8)\n\nlocal UICorner2 = UICorner:Clone()\nUICorner2.Parent = ToggleButton\n\nlocal toggled = false\nlocal loopConnection\n\nToggleButton.MouseButton1Click:Connect(function()\n    toggled = not toggled\n    \n    if toggled then\n        ToggleButton.Text = \"ON\"\n        ToggleButton.BackgroundColor3 = Color3.fromRGB(85, 255, 127)\n        \n        loopConnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\n            loadstring(game:HttpGet(\"https://rawscripts.net/raw/Build-A-Plane-BUILD-A-PLANE-LEAK-REMOTE-52870\"))()\n        end)\n    else\n        ToggleButton.Text = \"OFF\"\n        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 85, 85)\n        \n        if loopConnection then\n            loopConnection:Disconnect()\n            loopConnection = nil\n        end\n    end\nend)\n","owner":{"_id":"66f7a05cdc60f2cb40d98e21","username":"Your_Local_Exploiter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b1cb96a18e6b888192cda0d576a771459d6d48d7825d3575931a5dd07353687e.webp","original":"https://scriptblox.com/images/photo/66f7a05cdc60f2cb40d98e21-1735769403493.png"},"status":"offline","id":"66f7a05cdc60f2cb40d98e21","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/b1cb96a18e6b888192cda0d576a771459d6d48d7825d3575931a5dd07353687e.webp","original":"https://scriptblox.com/images/photo/66f7a05cdc60f2cb40d98e21-1735769403493.png"}},"verified":false,"views":2857,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/ec55c3d1973e7d502c6804a5947d87f4164a921c380808f8583b25eab01fdeb0.webp","original":"https://scriptblox.com/images/sb/rbx-879ae885247274b6198c6626cc7c384e-5239d99975bf.png","scriptblox":"https://scriptblox.com/images/script/rbx-879ae885247274b6198c6626cc7c384e-5239d99975bf.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-10-18T01:27:27.051Z","executes":2493,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:11:09.865Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/ec55c3d1973e7d502c6804a5947d87f4164a921c380808f8583b25eab01fdeb0.webp","original":"https://scriptblox.com/images/sb/rbx-879ae885247274b6198c6626cc7c384e-5239d99975bf.png","scriptblox":"https://scriptblox.com/images/script/rbx-8