findTargets(child, depth + 1)) do\n            table.insert(targets, subTarget)\n        end\n    end\n    \n    return targets\nend\n\nspawn(function()\n    while task.wait(3) do\n    \n        local targets = {}\n        local areas = {\n            workspace.Map,\n            workspace.Items, \n            workspace.Characters\n        }\n        \n        for _, area in ipairs(areas) do\n            for _, target in ipairs(findTargets(area, 0)) do\n                table.insert(targets, target)\n            end\n        end\n        \n        for index, target in ipairs(targets) do\n            if not _G.Auto then break end\n            \n            local success = pcall(function()\n                Event:FireServer(target)\n            end)\n            task.wait(0.05)\n        end\n    end\nend)\n\n\n\n      \n\n\n\n      --please\nprint(\"please\")\n","features":"The legend returns, just under a different name... Please don't dislike. I've been sick the other day, and I have someone who pays for views of anything. Thanks for reading this far.","tags":["nightintheforest","script","infinityAll","like","please"],"discord":"","keyLink":"","owner":{"_id":"690f54bbcff51b46c5fb591e","username":"simkaHUB","verified":false,"profilePicture":{"url":"https://media.kocakz.me/39c8d09b3dfc7e580d979fa3106a7da11db80478fbbb41796cc702ec086d214f.webp","original":"https://scriptblox.com/images/photo/690f54bbcff51b46c5fb591e-1762612455765.jpg"},"status":"offline","id":"690f54bbcff51b46c5fb591e","profile":{"url":"https://media.kocakz.me/39c8d09b3dfc7e580d979fa3106a7da11db80478fbbb41796cc702ec086d214f.webp","original":"https://scriptblox.com/images/photo/690f54bbcff51b46c5fb591e-1762612455765.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:41:23.235Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[