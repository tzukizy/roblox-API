{"slug":"Flex-Your-FPS-And-Ping!-Simple-FPS-Changer-Script-open-source-95962","_id":"697ceb2287d3cdd14ec165f9","title":"Simple FPS Changer Script open source","game":{"_id":"67e5e1ffb360710ec3c7800d","gameId":18667984660,"name":"Flex Your FPS And Ping!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":18667984660},"features":"basic fps flex script fakes ur fps. Doesnt have GUI\n\ncheck settings in the script for info\n\nty <3","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Pixeluted/adoniscries/main/Source.lua\",true))() --bypass by someone\ngame:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\n    Title = \"Fps Changer script\",\n    Text = \"i hope u did configure from settings in script, whatever made by rolesional\", \n    Duration = 6\n})\nlocal SETTINGS = {\n    fpsv = 1000, -- fps\n    additionmode = true, -- addition mode (when u get 250 fps for example, if u wrote 1000 fps its gonna be about 1250 fps so will look realistic)\n    gfx = 10, --graphics quality\n    resw = 1920,\n    resh = 1080,\n    \n    togglekey = Enum.KeyCode.K  --toggle spoof\n}\n\nlocal sp = true\nlocal uis = game:GetService(\"UserInputService\")\n\nuis.InputBegan:Connect(function(input, gameProcessed)\n    if not gameProcessed and input.KeyCode == SETTINGS.togglekey then\n        sp = not sp\n        local mtxt = SETTINGS.additionmode and \"ADDITION (+)\" or \"FIXED\"\n        if sp then\n            warn(\"spoof enabled bro | mode: \" .. mtxt)\n        else\n            warn(\"spoof disabled bro\")\n        end\n    end\nend)\n\nlocal mt = getrawmetatable(game)\nlocal hookz = mt.__namecall\nsetreadonly(mt, false)\n\nmt.__namecall = newcclosure(function(self, ...)\n    local args = {...}\n    \n    if sp and getnamecallmethod() == \"FireServer\" and type(args[1]) == \"table\" and (args[1].fps or args[1].t == \"metrics\") then\n        \n        if SETTINGS.additionmode then\n            local currentf = args[1].fps or 0\n            args[1].fps = currentf + SETTINGS.fpsv\n        else\n            args[1].fps = SETTINGS.fpsv\n        end\n        args[1].gfx = SETTINGS.gfx\n        args[1].res = Vector2.new(SETTINGS.resw, SETTINGS.resh)\n        \n        return hookz(self, unpack(args))\n    end\n    \n    return hookz(self, ...)\nend)\n\nsetreadonly(mt, true)\nwarn(\"toggle key: \" .. tostring(SETTINGS.togglekey.Name))\nwarn(\"addition mode: \" .. tostring(SETTINGS.additionmode))","owner":{"_id":"691ad679b2c3383a2efb3028","username":"rolesionalUwU","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3503c419f919f1a5ee9ca60171100e784b64faaf0e2193c369be2b831ff13a07.webp","original":"https://scriptblox.com/images/photo/691ad679b2c3383a2efb3028-1763988205800.jpeg"},"status":"offline","id":"691ad679b2c3383a2efb3028","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/3503c419f919f1a5ee9ca60171100e784b64faaf0e2193c369be2b831ff13a07.webp","original":"https://scriptblox.com/images/photo/691ad679b2c3383a2efb3028-1763988205800.jpeg"}},"verified":false,"views":3424,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/94ab703e1298bf44ca3e99dbcba6034e10c8543c002065172402691d7cd7dd60.webp","original":"https://scriptblox.com/images/sb/18667984660-1769794338611.png","scriptblox":"https://scriptblox.com/images/script/18667984660-1769794338611.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-01-30T17:32:18.624Z","executes":1947,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:34:49.995Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/94ab703e1298bf44ca3e99dbcba6034e10c8543c002065172402691d7cd7dd60.webp","or