{"slug":"Universal-Script-tag-2371","_id":"626f31a428196775a0f9ba9e","title":"tag","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/6107595-1651454372274.jpg","placeId":0},"features":"tag \nit has whitelist so tag doesnt effect people not playing\n\nhttps://discord.gg/8N2M9fHJqa","tags":["TAG","universal","HUB","cool","idk"],"script":"getgenv().it = \"\" -- First Person to be it username not displayname\ngetgenv().whitelisted = {\"Player1\",\"Player2\",\"Player3\"} -- change to players playing tag use username not displayname it can be any amount of players\ngetgenv().message = \" is it.\" -- tag message\n\nlocal function tag(it)\n    local uh = game.Players[it].Character.HumanoidRootPart:GetTouchingParts()\n    return uh\nend\nlocal function code(player)\n    game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(player.DisplayName .. getgenv().message,\"All\")\nend\nwhile wait() do\n    if table.find(tag(getgenv().it),\"HumanoidRootPart\") ~= nil then\n        local oof = table.find(tag(getgenv().it),\"HumanoidRootPart\")\n        if table.find(getgenv().whitelisted,oof.Parent.Name) ~= nil then\n            getgenv().it = oof.Parent.Name\n            code(game.Players[oof.Parent.Name])\n        end\n    end\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":"/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png","status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11013831}},"topMilestone":{"key":"creator.views","tier":10000000}},"verified":true,"views":22789,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-05-02T01:19:32.296Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/6107595-1651454372274.jpg","keyLink":"","executes":42,"keyless":false,"liked":false,"disliked":false,"isHub":false