oldDuration = ProximityPrompt.HoldDuration\n                                if Skip then\n                                    ProximityPrompt.HoldDuration = 0\n                                end\n                                for i = 1, Amount or 1 do\n                                    ProximityPrompt:InputHoldBegin()\n                                    if Skip then\n                                        wait(HoldDuration)\n                                    end\n                                    ProximityPrompt:InputHoldEnd()\n                                end\n                                ProximityPrompt.HoldDuration = HoldDuration\n                            end\n\n-- NOTE: I DID NOT CODE THIS!!!\n-- You can use it like this: fireproximityprompt(path_to_proximity_prompt)\n-- Or you can also put the 2 other arguments, anyways i recommend you to read the function before.","features":"This allows you to use the fireproximityprompt function on solara.","tags":["fireproximityprompt for solara","fireproximityprompt","fireprompt","fire proximity prompt","proximityprompt"],"discord":"","keyLink":"","owner":{"_id":"660706b7db7e082694085580","username":"Catty","verified":false,"profilePicture":{"url":"https://media.kocakz.me/85ba207a9c2b61aad17d78ce9058e1e60d2985055a15b6d80218856f2bc8cfeb.webp","original":"https://scriptblox.com/images/photo/660706b7db7e082694085580-1745959631525.jpg"},"status":"offline","id":"660706b7db7e082694085580","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/85ba207a9c2b61aad17d78ce9058e1e60d2985055a15b6d80218856f2bc8cfeb.webp","original":"https://scriptblox.com/images/photo/660706b7db7e082694085580-1745959631525.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:21:54.661Z","last":"","win":14,"math":3},"isHub":false,"supportedGame