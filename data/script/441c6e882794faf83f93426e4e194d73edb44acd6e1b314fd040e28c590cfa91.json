d":"6ac2c04d48176c70dbf98d1d","commentBy":{"_id":"6a05c7276d7c309c27093037","username":"SatoshiSFX","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-10-04T21:08:33.451Z","createdAt":"2026-05-14T12:59:19.428Z","status":"offline","id":"6a05c7276d7c309c27093037","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Hello, I would like to kindly request an update for your Shogun's Reign script. The game has recently been updated, and the locations for the Fisher and Farmer have changed.\n\nAlso, regarding the Feudal Noble, the script is still functional, but it is no longer working correctly. Instead of adding Ryo, it is deducting it because the answers provided by the script are now incorrect.","edited":false,"likeCount":3,"dislikeCount":0,"createdAt":"2026-10-04T21:08:29.537Z","liked":false,"disliked":false}]}