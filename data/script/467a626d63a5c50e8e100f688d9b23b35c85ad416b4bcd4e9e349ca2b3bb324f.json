{"slug":"Universal-Script-Simple-Noclip-Script-20755","_id":"6715d9e01d8d4d9d15ba9275","title":"Simple Noclip Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Simple noclip script.\n\nPress N to activate.","tags":["Roblox","Script","Noclip"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\n\nlocal noclip = false\n\nlocal function enableNoclip()\n    noclip = true\n    while noclip do\n\n        for _, part in pairs(character:GetDescendants()) do\n            if part:IsA(\"BasePart\") and part.CanCollide then\n                part.CanCollide = false\n            end\n        end\n        game:GetService(\"RunService\").Stepped:Wait()\n    end\nend\n\nlocal function disableNoclip()\n    noclip = false\n\n    for _, part in pairs(character:GetDescendants()) do\n        if part:IsA(\"BasePart\") and not part.CanCollide then\n            part.CanCollide = true\n        end\n    end\nend\n\n-- Toggle noclip on and off with the \"N\" key\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.N then\n        if noclip then\n            disableNoclip()\n        else\n            enableNoclip()\n        end\n    end\nend)\n","owner":{"_id":"66f7a05cdc60f2cb40d98e21","username":"Your_Local_Exploiter","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b1cb96a18e6b888192cda0d576a771459d6d48d7825d3575931a5dd07353687e.webp","original":"https://scriptblox.com/images/photo/66f7a05cdc60f2cb40d98e21-1735769403493.png"},"status":"offline","id":"66f7a05cdc60f2cb40d98e21","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/b1cb96a18e6b888192cda0d576a771459d6d48d7825d3575931a5dd