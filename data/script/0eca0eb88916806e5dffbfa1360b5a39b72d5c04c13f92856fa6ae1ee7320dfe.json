n\t}\n\tlocal event = game:GetService(\"ReplicatedStorage\").CustomiseBooth\n\tevent:FireServer(A_1, A_2)\nend\n\nlocal function BenDialogue()\n\tlocal Randomize = math.random(1, 4)\n\tif Randomize == 1 then\n\t\tchangeName(\"Yes.\")\n\telseif Randomize == 2 then\n\t\tchangeName(\"No.\")\n\telseif Randomize == 3 then\n\t\tchangeName(\"HOHOHO\")\n\telseif Randomize == 4 then\n\t\tchangeName(\"Ough.\")\n\tend\nend\n\nchangeName(\"Talking Ben\")\nchangeImage(8962954473)\n\nPlayers.PlayerChatted:Connect(function(chatType, plr, message) --When a player speaks\n\tif chatType ~= Enum.PlayerChatType.All then return end\n\tif\n\t\t(Players.LocalPlayer.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude\n\t\t<= 12\n\tthen\n\t\tBenDialogue()\n\t\tprint(message, plr) -- chat log\n\t\ttask.wait(4)\n\t\tchangeName(\"Talking ben\") --The function is called\n\tend\nend)\n","features":"fixed version of https://scriptblox.com/script/Rate-My-Avatar-Talking-Ben-1532","tags":["rate my avatar","talking ben"],"discord":"","keyLink":"","owner":{"_id":"61f7d0e59df4fa27fbbc4d26","username":"Vesper","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"61f7d0e59df4fa27fbbc4d26","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:15:35.091Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b16f","editBy":{"_id":"61f7d0e59df4fa27fbbc4d26","username":"Vesper","status":"offline","id":"61f7d0e59df4fa27fbbc4d26"},"message":"Create script","createdAt":"2022-03-30T14:32:12.237Z"},{"_id":"67e5e1e3b360710ec3c4e24d","editBy":{"_id":"61f7d0e59df4fa27fbbc4d26","username":"V