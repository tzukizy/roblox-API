{"slug":"Prison-Life-inf-stam-134618","_id":"69bbd6dc10fe3271a4319bc3","title":"inf stam","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":"/images/sb/rbx-4e541a0e7376f0235f0eeb0192e96ddb-eba40abb4f32.png","placeId":155615604},"features":"infinite jumping","tags":["prison life","fixed"],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal infstam = function(char)\n    local humanoid = char:WaitForChild(\"Humanoid\")\n\n    UserInputService.JumpRequest:Connect(function()\n        if humanoid.FloorMaterial ~= Enum.Material.Air then\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end)\nend\n\nif LocalPlayer and LocalPlayer.Character then\n    infstam(LocalPlayer.Character)\nend\n\nLocalPlayer.CharacterAdded:Connect(infstam)\n\ngame:GetService(\"Players\").LocalPlayer.Character.AntiJump:Destroy()\ngame:GetService(\"StarterPlayer\").StarterCharacterScripts.AntiJump:Destroy()","owner":{"_id":"67aa1ab92ad58e3ff64bc537","username":"zosyn","verified":false,"profilePicture":"/images/photo/67aa1ab92ad58e3ff64bc537-1791192361398.png","status":"offline","id":"67aa1ab92ad58e3ff64bc537","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":1392,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-8e16b433df6f2c94391865bc438e076a-bfa26800bfff.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-19T10:58:36.117Z","editBy":{"_id":"67aa1ab92ad58e3ff64bc537","username":"zosyn","status":"offline","id":"67aa1ab92ad58e3ff64bc537"},"keyLink":"","discord":"https://discord.gg/db2wt48WtR","executes":80,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bbd6dc10fe3271a4319bc6","editBy":{"_id":"67aa1ab92ad58e3ff64bc537","username":"zosyn","status":"offline","id":"67aa1