{"slug":"Universal-Script-Center-Of-M*-viewer-56336","_id":"68e0bf7d0490b777bca9d519","createdAt":"2025-10-04T06:32:29.200Z","dislikeCount":2,"features":"Open source cuz its basic as hell, just made it as a tool for COM offset glitches (they were just patched but there are some other ways), it might not be super visible at first but thats because there is no offset happening (equip a gear or emote to see it)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"image":{"url":"https://cdn.kocakz.me/images/b6904a495e0350684e3653b459470f1b8e78a56ce64268a69a48bd97622b89d4.webp","original":"https://scriptblox.com/images/sb/0-1759559549172.png","scriptblox":"https://scriptblox.com/images/script/0-1759559549172.png"},"isPatched":false,"isUniversal":true,"likeCount":3,"owner":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"},"lvl":11,"status":"offline","id":"64ec64fa4f538af76763524a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"}},"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nif not player then return end\n\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal HumanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal function createAxis(name, color, size, orientation, meshOffset)\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = name\n\tpart.Size = size\n\tpart.Anchored = false\n\tpart.CanCollide = false\n\tpart.Massless = true\n\tpart.Color = color\n\tpart.Material = Enum.Material.Plastic\n\tpart.TopSurface = Enum.SurfaceType.Smooth\n\tpart.BottomSurface = Enum.SurfaceType.Smooth\n\tpart.Transparency = 0\n\tpart.Orientation = orientation\n\tpart.Position = Vector3.new(0, 0, 0)\n\n\tlocal mesh = Instance.new(\"SpecialMesh\")\n\tmesh.Name = \"Mesh\"\n\tmesh.MeshType = Enum.MeshType.Cylinder\n\tmesh.Offset = meshOffset\n\tmesh.Scale = Vector3.new(1, 1, 1)\n\tmesh.VertexColor = Vector3.new(1, 1, 1)\n\tmesh.Parent = part\n\n\treturn part\nend\n\nlocal COMModel = Instance.new(\"Folder\")\nCOMModel.Name = \"CenterOfMass\"\nCOMModel.Parent = HumanoidRootPart\n\nlocal XAxis = createAxis(\"XAxis\", Color3.fromRGB(255, 0, 0), Vector3.new(4, 0.5, 0.5), Vector3.new(0, 0, 0), Vector3.new(0, -0.424, 0))\nXAxis.Parent = COMModel\n\nlocal YAxis = createAxis(\"YAxis\", Color3.fromRGB(0, 255, 0), Vector3.new(4, 0.5, 0.5), Vector3.new(0, 0, 90), Vector3.new(-0.424, 0, 0))\nYAxis.Parent = COMModel\n\nlocal ZAxis = createAxis(\"ZAxis\", Color3.fromRGB(0, 0, 255), Vector3.new(4, 0.5, 0.5), Vector3.new(0, 90, 0), Vector3.new(0, -0.424, 0))\nZAxis.Parent = COMModel\n\nfor _, part in ipairs(COMModel:GetChildren()) do\n\tif part:IsA(\"BasePart\") then\n\t\tpart.CFrame = HumanoidRootPart.CFrame * (part.CFrame - part.Position)\n\t\tlocal weld = Instance.new(\"WeldConstraint\")\n\t\tweld.Part0 = HumanoidRootPart\n\t\tweld.Part1 = part\n\t\tweld.Parent = HumanoidRootPart\n\tend\nend\n\nlocal rootWeldPart = XAxis\n\nRunService.Heartbeat:Connect(function()\n\tif not rootWeldPart then return end\n\tlocal relativeCOM = rootWeldPart.CFrame:PointToObjectSpace(rootWeldPart.AssemblyCenterOfMass)\n\tXAxis.Mesh.Offset = relativeCOM\n\tYAxis.Mesh.Offset = Vector3.new(relativeCOM.Y, -relativeCOM.X, relativeCOM.Z)\n\tZAxis.Mesh.Offset = Vector3.new(-relativeCOM.Z, relativeCOM.Y, relativeCOM.X)\nend)\n","scriptType":"free","tags":["open source","com","tool","utility","center of m*"],"title":"Center Of M* viewer","verified":false,"views":4164,"visibility":"public","executes":1204,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:44:46.328Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/b6904a495e0350684e3653b459470f1b8e78a56ce64268a69a48bd97622b89d4.webp","original":"https://scriptblox.com/images/sb/0-1759559549172.png","scriptblox":"https://scriptblox.com/images/script/0-1759559549172.png"},"changelog":[{"_id":"68e0bf7d0490b777bca9d51b","createdAt":"2025-10-04T06:32:29.206Z","editBy":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","status":"offline","id":"64ec64fa4f538af76763524a"},"message":"Create script"}],"comments":[{"_id":"68e0eabdaa8b50a78d510c20","commentBy":{"_id":"6825d51c91ae140e8f4472ff","username":"floppa_scripter","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6825d51c91ae140e8f4472ff-1747310177794.png"},"createdAt":"2025-05-15T11:50:52.697Z","lastActive":"2026-09-24T17:27:50.488Z","status":"offline","id":"6825d51c91ae140e8f4472ff","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6825d51c91ae140e8f4472ff-1747310177794.png"}},"createdAt":"2025-10-04T09:37:01.948Z","dislikeCount":0,"edited":false,"likeCount":1,"text":"thats peak","liked":false,"disliked":false},{"_id":"69a12c5f1799b9f7706b3e55","commentBy":{"_id":"680234cd2e1d529faaf227c5","username":"flanirgonirgo","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/2d645898c8968356f8b5d0c431aab91a9464bf8b8a517183c0b3a3cd268bd20c.webp","original":"https://scr