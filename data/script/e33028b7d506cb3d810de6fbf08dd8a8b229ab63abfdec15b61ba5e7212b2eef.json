e.Parent = MainFrame\nTitle.Text = \"CLEITINHO HUB\"\nTitle.Size = UDim2.new(1, 0, 0, 40)\nTitle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\nTitle.TextColor3 = Color3.fromRGB(255, 255, 255)\nTitle.TextSize = 20\n\n-- AQUI TU COLOCA OS TEUS BOTÕES DE ANTES (Exemplo de Speed)\nlocal SpeedBtn = Instance.new(\"TextButton\")\nSpeedBtn.Parent = MainFrame\nSpeedBtn.Text = \"VELOCIDADE (100)\"\nSpeedBtn.Size = UDim2.new(0.9, 0, 0, 45)\nSpeedBtn.Position = UDim2.new(0.05, 0, 0.2, 0)\nSpeedBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 127)\n\nSpeedBtn.MouseButton1Click:Connect(function()\n    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 100\nend)\n\nprint(\"Cleitinho Hub carregado!\")\n","features":"Prêmio 🎖️","tags":[],"discord":"","keyLink":"","owner":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69cdcc582a07b523ef917dae","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:00:50.780Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d7b196d576ff8e44def9bb","editBy":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","status":"offline","id":"69cdcc582a07b523ef917dae"},"message":"Create script","createdAt":"2026-04-09T14:03:02.768Z"},{"_id":"69d7b39e0d7ae29b0d504721","editBy":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","status":"offline","id":"69cdcc582a07b523ef917dae"},"message":"Update script","createdAt":"2026-04-09T14:11:42.498Z"},{"_id":"69d7b41e575be71b9d095695","editBy":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","status":"offline","id":"69cdcc582a07b523ef917da