ton.Text = \"Enable Reset\"\nResetButton.TextColor3 = Color3.fromRGB(255, 255, 255)\nResetButton.TextSize = 20.000\n\n-- Your loadstring for reloading\nResetButton.MouseButton1Click:Connect(function()\n    loadstring(game:HttpGet(\"https://pastebin.com/raw/pvNpdimg\"))()\nend)\n","features":"When you die you will have to renable it","tags":[],"discord":"","keyLink":"","owner":{"_id":"6749c52da2071ed30f61d7a0","username":"Nooby","verified":false,"profilePicture":{"url":"https://media.kocakz.me/13c82ce2a204f85910f8c7ba84b3db7e0fd41287bc4fe8847be4081acc667b8f.webp","original":"https://scriptblox.com/images/photo/6749c52da2071ed30f61d7a0-1737579957940.png"},"status":"offline","id":"6749c52da2071ed30f61d7a0","profile":{"url":"https://media.kocakz.me/13c82ce2a204f85910f8c7ba84b3db7e0fd41287bc4fe8847be4081acc667b8f.webp","original":"https://scriptblox.com/images/photo/6749c52da2071ed30f61d7a0-1737579957940.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:13:11.425Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53b79","editBy":{"_id":"6749c52da2071ed30f61d7a0","username":"Nooby","status":"offline","id":"6749c52da2071ed30f61d7a0"},"message":"Create script","createdAt":"2025-03-27T14:08:06.868Z"}],"comments":[]}