{"_id":"69db0a08111606159568410e","title":"BRITISH ARMY NO JUMP COOLDOWN OPEN SOURCE","game":{"_id":"67e5e1ffb360710ec3c78540","gameId":270499015,"name":"[CHRISTMAS] Sandhurst Military Academy Roleplay","imageUrl":{"url":"https://media.kocakz.me/e3069f25e3f1b9965e0395d723739daf834c26aa5e3d7010bf9e67bacc77d3b0.webp","original":"https://tr.rbxcdn.com/180DAY-57574a1fd875cfcba39ab4e11608cd16/150/150/Image/Png/noFilter"},"slug":"270499015-sandhurst-military-academy-roleplay","path":"/game/270499015-sandhurst-military-academy-roleplay","thumbnail":{"url":"https://media.kocakz.me/e3069f25e3f1b9965e0395d723739daf834c26aa5e3d7010bf9e67bacc77d3b0.webp","original":"https://tr.rbxcdn.com/180DAY-57574a1fd875cfcba39ab4e11608cd16/150/150/Image/Png/noFilter"},"placeId":270499015},"slug":"CHRISTMAS-Sandhurst-Military-Academy-Roleplay-BRITISH-ARMY-NO-JUMP-COOLDOWN-OPEN-SOURCE-247574","verified":false,"key":false,"keyless":false,"views":1372,"executes":188,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/34cc6a136ffb8d7b746e95a720266226693504f6cfc694fdaeeb894996dee6db.webp","original":"https://scriptblox.com/images/sb/270499015-1775962632182.webp","scriptblox":"https://scriptblox.com/images/script/270499015-1775962632182.webp"},"thumbnail":{"url":"https://media.kocakz.me/34cc6a136ffb8d7b746e95a720266226693504f6cfc694fdaeeb894996dee6db.webp","original":"https://scriptblox.com/images/sb/270499015-1775962632182.webp","scriptblox":"https://scriptblox.com/images/script/270499015-1775962632182.webp"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-12T02:57:12.229Z","updatedAt":"2026-04-12T02:57:12.229Z","lastBump":"2026-04-12T02:57:12.229Z","script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\n\nlocal function setupCharacter(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n\n    humanoid.UseJumpPower = true\n    humanoid.JumpPower = 47\n\n    local canJump = true\n\n    humanoid.StateChanged:Connect(function(_, newState)\n        if newState == Enum.HumanoidStateType.Landed\n        or newState == Enum.HumanoidStateType.Running then\n            canJump = true\n        end\n    end)\n\n    UserInputService.JumpRequest:Connect(function()\n        if not humanoid or not humanoid.Parent then return end\n\n        if canJump and humanoid.FloorMaterial ~= Enum.Material.Air then\n            canJump = false\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end)\nend\n\nif player.Character then\n    setupCharacter(player.Character)\nend\n\nplayer.CharacterAdded:Connect(setupCharacter)","features":"Just no jump cooldown change humanoid.JumpPower value for jump height\n\nEnjoy","tags":["opensource","nojumpcooldown","script","britisharmy","militaryroleplay"],"discord":"","keyLink":"","owner":{"_id":"69d1413e4dce27dcfffcceb7","username":"widsfujqa","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69d1413e4dce27dcfffcceb7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:30:55.228Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69db0a081116061595684111","editBy":{"_id":"69d1413e4dce27dcfffcceb7","username":"widsfujqa","status":"offline","id":"69d1413e4dce27dcfffcceb7"},"message":"Create script","createdAt":"2026-04-12T02:57:12.235Z"}],"comments":[{"_id":"69db0a37e40517d77300335c","commentBy":{"_id":"69d1413e4dce27dcfffcceb7","username":"widsfujqa","verified":false,"role":"user","profilePicture":{"url":"https://media.koca