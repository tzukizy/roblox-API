{"slug":"BIG-Paintball!-Classic-silent-aim-22164","_id":"67337ff19f0ca359c1024911","title":"silent aim","game":{"_id":"67e5e1ffb360710ec3c77da4","gameId":3527629287,"name":"BIG Paintball! Classic 🔫","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":3527629287},"features":"silent aim","tags":["silentaim","opensource","open source","silent aim","source"],"script":"--// Made by samet.exe on discord\n--// Will not work for solara\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\");\nlocal Players = game:GetService(\"Players\");\nlocal Workspace = game:GetService(\"Workspace\");\nlocal UserInputService = game:GetService(\"UserInputService\");\nlocal RunService = game:GetService(\"RunService\");\n\nlocal LocalPlayer = Players.LocalPlayer;\nlocal Camera = Workspace.CurrentCamera;\n\nlocal Modules = {}; do\n    Modules.Library = require(ReplicatedStorage:FindFirstChild(\"Framework\"):FindFirstChild(\"Library\"));\n    Modules.Projectile = Modules.Library.Projectiles\nend;\nlocal Closest;\n\nlocal GetClosestPlayer = function(Radius)\n    local ClosestDistance = Radius or math.huge;\n    local Player = nil;\n\n    for Index, Value in Players:GetPlayers() do\n        if (Value ~= LocalPlayer) then\n            local Character = Value.Character;\n            local Root = Character and Character:FindFirstChild(\"HumanoidRootPart\");\n\n            if not Root then continue end;\n\n            local Position, Visible = Camera:WorldToViewportPoint(Root.Position);\n            local Distance = (Vector2.new(Position.X, Position.Y) - UserInputService:GetMouseLocation()).Magnitude;\n\n            if not Visible then continue end;\n\n            if Distance < ClosestDistance then\n                ClosestDistance = Distance;\n                Player = Value;\n            end;\n        end;\n    end;\n\n    return Player;\nend;\n\nRunService.Heartbeat:Connect(function()\n    Closest = GetClosestPlayer();\nend);\n\nlocal Old; Old = hookfunction(Modules.Projectile.Fire, function(Player, Cframe, ...)\n    if ((tostring(Player) == LocalPlayer.Name or tostring(Player) == LocalPlayer.DisplayName) and (Closest and Closest.Character and Closest.Character:FindFirstChild(\"HumanoidRootPart\")))then\n        local BonePosition = Closest.Character.HumanoidRootPart.CFrame;\n        Cframe = BonePosition;\n    end;\n\n    return Old(Player, Cframe, ...);\nend);\n","owner":{"_id":"65e878118649bee11545f64d","username":"sametexe","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2185fb968caadafc79e132fef3c5c8109f1b021cd0acf8a836a1184c82c2585c.webp","original":"https://scriptblox.com/images/photo/65e878118649bee11545f64d-1729269485662.jpg"},"status":"offline","id":"65e878118649bee11545f64d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/2185fb968caadafc79e132fef3c5c8109f1b021cd0acf8a836a1184c82c2585c.webp","original":"https://scriptblox.com/images/photo/65e878118649bee11545f64d-1729269485662.jpg"}},"verified":false,"keyLink":"","views":6603,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-11-12T16:18:57.138Z","dislikeCount":3,"likeCount":0,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-bee451e4697e4e68df2af5e611b43e2f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-bee451e4697e4e68df2af5e611b43e2f/500/280/Image/Jpeg/noFilter"},"executes":721,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:18:04.283Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-bee451e4697e4e68df2af5e611b43e2f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.