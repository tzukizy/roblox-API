{"slug":"Universal-Script-Nagaraja-Style-127314","_id":"69a623ab96d3ccea10c49b1c","title":"Nagaraja Style","game":{"_id":"6959526c0597a5542a8de666","gameId":0,"name":"Script hub","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"changes brute to nagaraja","tags":[],"script":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\nlocal styleToChange = \"Beast\" --Brawler = fisticuffs, Rush = frenzy, Beast = brute. you MUST use one of these 3 or else you cannot use the custom style.\n\nlocal styleToChangeTo = \"नागराज\" --堂島の龍 is dragon style. you can find the styles at game.ReplicatedStorage.Styles\n\nfor i, v in pairs(game.ReplicatedStorage.Styles:FindFirstChild(styleToChange):GetChildren()) do\n\nv:Destroy()\n\nend\n\nfor i, v in pairs(game.ReplicatedStorage.Styles:FindFirstChild(styleToChangeTo):GetChildren()) do\n\nv = v:Clone()\n\nv.Parent = game.ReplicatedStorage.Styles[styleToChange]\n\nend\n\ngame.StarterGui:SetCore(\"SendNotification\",{\n\nTitle = styleToChangeTo..\" style loaded!\";\n\nText = styleToChangeTo..\" style has replaced \"..styleToChange..\".\";\n\nButton1 = \"OK!\";\n\n})","owner":{"_id":"6956f4c46fb0b59477d9e995","username":"kartarbrar","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6956f4c46fb0b59477d9e995","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":689,"scriptType":"free","isUniversal":true,"isHub":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/39f5745cbe0403c1dee8abce629482c707cbe2ce381c034ef9893af0dae14457.webp","original":"https://scriptblox.com/images/sb/0-1772495787901.png","scriptblox":"https://scriptblox.com/images/