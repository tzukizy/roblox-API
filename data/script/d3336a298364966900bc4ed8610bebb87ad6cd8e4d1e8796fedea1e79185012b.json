l:FindFirstChild(\"Head\") and v.Character and v.Character.PrimaryPart and v.Character:FindFirstChild(\"Humanoid\") and v.Character.Humanoid.Health > 0 and (v.Character:GetPivot().Position - local_player.Character:GetPivot().Position).Magnitude < settings.max_hit_distance then\n                table.insert(cute_femboys, v.Character)\n            end\n        end\n        for _, v2 in cute_femboys do\n            if v2.PrimaryPart then\n                tool:Activate()\n                firetouchinterest(tool.Head, v2.PrimaryPart, 0)\n                firetouchinterest(tool.Head, v2.PrimaryPart, 1)\n            end\n        end\n        task.wait(tool and tool:GetAttribute(\"Cooldown\") or 0)\n    until not settings.enabled\nend","features":"Made by @kylosilly if theres any bugs report it to my dms","tags":["op","kill all","good game","script","hammers"],"discord":"","keyLink":"","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:51:08.197Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"686ead2d2cc4717be870e0e4","editBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","status":"offline","id":"677be435ea4516cd66668ea7"},"message":"Create script","createdAt":"2025-0