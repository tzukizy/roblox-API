{"_id":"6aca91e43eef7a64eab1b311","title":"OS/OLENSOURCE AUTO TP PUMPKIN","game":{"_id":"6aa86e3a1368c2fea9630fab","gameId":71704434889758,"name":"(UPDATE) Drive A Kukirin!","imageUrl":{"url":"https://media.kocakz.me/bc9ea47107a024609ed58ffbc410c7e98edd7903cfcb126d765f1409d4a075b6.webp","original":"https://tr.rbxcdn.com/180DAY-6bbbc7f73e18815784c94c47d34e4fee/150/150/Image/Png/noFilter"},"slug":"71704434889758-drive-a-kukirin","path":"/game/71704434889758-drive-a-kukirin","thumbnail":{"url":"https://media.kocakz.me/bc9ea47107a024609ed58ffbc410c7e98edd7903cfcb126d765f1409d4a075b6.webp","original":"https://tr.rbxcdn.com/180DAY-6bbbc7f73e18815784c94c47d34e4fee/150/150/Image/Png/noFilter"},"placeId":71704434889758},"slug":"UPDATE-Drive-A-Kukirin-OSOLENSOURCE-AUTO-TP-PUMPKIN-232154","verified":false,"key":false,"keyless":false,"views":1680,"executes":968,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4230fb8a8db1405d9dcf2969221a924702925422011dde7107be1b2f3f080280.webp","original":"https://scriptblox.com/images/sb/rbx-57b564e3c20f5acff76d61d855df4030-b8929df44504.png","scriptblox":"https://scriptblox.com/images/script/rbx-57b564e3c20f5acff76d61d855df4030-b8929df44504.png"},"thumbnail":{"url":"https://media.kocakz.me/4230fb8a8db1405d9dcf2969221a924702925422011dde7107be1b2f3f080280.webp","original":"https://scriptblox.com/images/sb/rbx-57b564e3c20f5acff76d61d855df4030-b8929df44504.png","scriptblox":"https://scriptblox.com/images/script/rbx-57b564e3c20f5acff76d61d855df4030-b8929df44504.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-10-10T19:28:36.862Z","updatedAt":"2026-10-10T19:28:36.862Z","lastBump":"2026-10-10T19:28:36.862Z","script":"local players = game:GetService(\"Players\")\nlocal player = players.LocalPlayer\n\nlocal visitedPumpkins = {}\n\nlocal function getRootPart()\n\tlocal character = player.Character or player.CharacterAdded:Wait()\n\treturn character:WaitForChild(\"HumanoidRootPart\", 5)\nend\n\nlocal function findNextPumpkin(currentPos)\n\tlocal nearestPumpkin = nil\n\tlocal shortestDistance = math.huge\n\t\n\t\n\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\tif not visitedPumpkins[obj] and (obj:IsA(\"BasePart\") or obj:IsA(\"Model\")) then\n\t\t\tif obj.Name:lower():find(\"pumpkin\") then\n\t\t\t\tlocal targetPart = obj:IsA(\"Model\") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA(\"BasePart\")) or obj\n\t\t\t\t\n\t\t\t\tif targetPart then\n\t\t\t\t\tlocal distance = (currentPos - targetPart.Position).Magnitude\n\t\t\t\t\tif distance < shortestDistance then\n\t\t\t\t\t\tshortestDistance = distance\n\t\t\t\t\t\tnearestPumpkin = {object = obj, part = targetPart}\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn nearestPumpkin\nend\n\n\ntask.spawn(function()\n\twhile true do\n\t\tlocal rootPart = getRootPart()\n\t\tif rootPart then\n\t\t\tlocal nextPumpkin = findNextPumpkin(rootPart.Position)\n\t\t\t\n\t\t\tif nextPumpkin then\n\t\t\t\t\n\t\t\t\tvisitedPumpkins[nextPumpkin.object] = true\n\t\t\t\t\n\t\t\t\t\n\t\t\t\trootPart.CFrame = nextPumpkin.part.CFrame + Vector3.new(0, 3, 0)\n\t\t\t\t\n\t\t\t\t\n\t\t\t\ttask.wait(1)\n\t\t\telse\n\t\t\t\t-- If you see this say hi and thnaks for using my script\n\t\t\t\ttask.wait(2)\n\t\t\tend\n\t\telse\n\t\t\ttask.wait(1)\n\t\tend\n\tend\nend)","features":"for the new quest\n*mods pls review this quickly*","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a8986d16da40c290ab02b58","username":"Sakuraguys","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":4,"status":"offline","id":"6a8986d16da40c290ab02b58","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-16T11:34:27.006Z","profile":"/u/QueueSpeedDemon"},"liked":fa