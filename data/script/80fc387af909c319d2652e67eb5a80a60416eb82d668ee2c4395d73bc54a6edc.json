{"slug":"Stair-Battles!-Auto-Stairs-NO-GUI-53632","_id":"68c9cfb4abb70cac98387e47","title":"Auto Stairs NO GUI","game":{"_id":"68c9cfb4abb70cac98387e44","gameId":132420470568123,"name":"Stair Battles!","imageUrl":"/images/sb/rbx-f7f2018c1386fc3408041bcf19ef0b97-7c2f63dd8369.png","placeId":132420470568123},"features":"Automatically builds the stairs for ONE ROUND.\n\nRecommended to execute during a round not before but it will still work.","tags":["auto","stairs","op","hub","fun"],"script":"\nlocal Config = {\n    [\"FastWin\"] = false, -- Win Faster but slower stairs?\n    --[\"AutoLoop\"] = false, -- DOES NOT WORK\n}\n\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal Functional = workspace.FunctionalFolder\n\nlocal function getRandAngles()\n    local x = math.rad(math.random(-180, 180))\n    local y = math.rad(math.random(-180, 180))\n    local z = math.rad(math.random(-180, 180))\n    return CFrame.Angles(x, y, z)\nend\n\nlocal function getCharacter()\n    return LocalPlayer.Character or (LocalPlayer.CharacterAdded:wait() and LocalPlayer.Character)\nend\n\nlocal function getTeam()\n    return getCharacter().Parent.Name:gsub(\" Team\", '')\nend\n\nlocal function getBase()\n    local baseName = getTeam() .. \"Base\"\n    return Functional:FindFirstChild(baseName)\nend\n\nlocal function getBlockGiver()\n    local Base = getBase()\n    local BlockGivers = Functional:WaitForChild(\"BlockGivers\"):GetChildren()\n    local StartStairPos = Base.StartStair.Position\n\n    local Closest = math.huge\n    local Best = nil\n    for i, BlockGiver in pairs(BlockGivers) do\n        local DistanceFromStair = (BlockGiver.Position - StartStairPos).Magnitude\n        if DistanceFromStair < Closest then\n            Closest = DistanceFromStair\n            Best = BlockGiver\n        end\n    end\n    return Best\nend\nwhile task.wait() do\n    if Config.AutoLoop == true then\n        print(\"Started with Auto Loop\")\n    end\n    repeat task.wait()\n    until getBase()\n    print(\"AUTO WIN | MATCH STARTED\", getTeam())\n\n    local PlacePreview = Functional.PlacePreview\n    local Character = getCharacter()\n    local RootPart = Character.HumanoidRootPart\n    local Humanoid = Character.Humanoid\n    Humanoid.EvaluateStateMachine = false\n\n    while task.wait() and getBase() and RootPart do\n        print(\"Looping..\")\n        local BlockGiver = getBlockGiver()\n        if BlockGiver then\n            -- Teleport to the block giver (upside down)\n            repeat\n                RootPart.CFrame = CFrame.new(BlockGiver.Position) * getRandAngles()\n                task.wait()\n                RootPart.CFrame = CFrame.new(BlockGiver.Position + Vector3.new(0, 500, 0)) * getRandAngles()\n                task.wait()\n            until Character:FindFirstChild(\"BlocksTool\")\n            local BestBlock = PlacePreview:FindFirstChildOfClass(\"Part\")\n            repeat\n                if not BestBlock then\n                    BestBlock = PlacePreview:FindFirstChildOfClass(\"Part\")\n                    continue\n                end\n                RootPart.CFrame = CFrame.new(BestBlock.Position) * getRandAngles()\n                task.wait()\n            until Character:FindFirstChild(\"BlocksTool\")\n        end\n        if Config.FastWin == true then\n            local WinTouchPart = Functional:FindFirstChild(\"WinTouchPart\", true)\n            task.wait()\n            if RootPart and getBase() then\n                getCharacter():WaitForChild(\"HumanoidRootPart\").CFrame = WinTouchPart.CFrame * getRandAngles()\n                task.wait()\n            end\n        end\n    end\n    print(\"AUTO WIN | MATCH COMPLETE\")\n    if Config.AutoLoop == false then\n        break\n    end\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":"/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png","status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11013154}},"topMilestone":{"key":"creator.views","tier":10000000}},"verified":true,"views":82590,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-f7f2018c1386fc3408041bcf19ef0b97-7c2f63dd8369.png","likeCount":0,"dislikeCount":1,"createdAt":"2025-09-16T20:59:32.438Z","executes":17,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c9cfb4abb70cac98387e49","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-09-16T20:59:32.441Z"}],"comments":[{"_id":"68c9d61d4e8ae86fddf5434e","commentBy":{"_id":"68c0212614548da8fe873ab9","username":"SyrexGenesis","verified":false,"role":"user","profilePicture":"/images/photo/68c0212614548da8fe873ab9-1757941704674.png","createdAt":"2025-09-09T12:44:22.090Z","lastActive":"2025-10-21T00:23:01.534Z","status":"offline","id":"68c0212614548da8fe873ab9"},"text":"Thanks but is buggy sometimes it doesn't works when a part of the stairs is gone","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-16T21:26:53.568Z","liked":false,"disliked":false},{"_id":"68c9fad492713e0e5846db95","commentBy":{"_id":"68af86038decc0a67744ca92","username":"Odetari","verified":false,"role":"user","profilePicture":"/images/photo/68af86038decc0a67744ca92-1762556262868.png","createdAt":"2025-08-27T22:26:11.274Z","lastActive":"2026-03-02T17:43:14.183Z","status":"offline","id":"68af86038decc0a67744ca92","topMilestone":{"key":"creator.executions","tier":10000}},"text":"one more script from the goat","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-09-17T00:03:32.802Z","liked":false,"disliked":false},{"_id":"68dc975996a1f26853c2c032","commentBy":{"_id":"68c7732aa65ae4c0f15a2fb8","username":"e213405","veri