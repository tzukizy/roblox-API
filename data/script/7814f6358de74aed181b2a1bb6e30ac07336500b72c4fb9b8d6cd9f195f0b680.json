{"slug":"Universal-Script-Testing-47495","_id":"6891af04c23f749e701d8883","title":"Testing","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1754377987904.png","placeId":0},"features":"Testing my own kick script","tags":[],"script":"-- List of usernames to kick (case-sensitive)\nlocal usernamesToKick = {\n    \"BadUser123\",\n    \"TrollPlayer456\",\n    \"Spammer789\"\n}\n\n-- Function to kick players in the list\ngame.Players.PlayerAdded:Connect(function(player)\n    for _, username in ipairs(usernamesToKick) do\n        if player.Name == username then\n            player:Kick(\"You are not allowed in this game.\")\n            warn(\"Kicked player: \" .. player.Name)\n        end\n    end\nend)\n","owner":{"_id":"67aa0f6807d63d8fb5da7fb4","username":"schylerbryce2014","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"67aa0f6807d63d8fb5da7fb4","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1231,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1754377987904.png","likeCount":0,"dislikeCount":2,"createdAt":"2025-08-05T07:13:08.031Z","executes":277,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6891af04c23f749e701d8885","editBy":{"_id":"67aa0f6807d63d8fb5da7fb4","username":"schylerbryce2014","status":"offline","id":"67aa0f6807d63d8fb5da7fb4"},"message":"Create script","createdAt":"2025-08-05T07:13:08.035Z"}],"comments":[]}