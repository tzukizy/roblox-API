{"slug":"SpaceVisor-Battle-For-Dream-Island-Roblox-Steal-Sandwiches-240132","_id":"6a429b1cd2877b53ed303dbc","title":"Steal Sandwiches","game":{"_id":"67e5e1ffb360710ec3c785e1","gameId":14737542240,"name":"[SpaceVisor] Battle For Dream Island Roblox","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14737542240},"features":"Scans the map for sandwiches and brings it to you (Event ends on July 5th)","tags":[],"script":"local ITEM_NAMES = {\n    \"Sandwich1\",\n    \"Sandwich2\",\n    \"Sandwich3\",\n    \"Sandwich4\",\n    \"Sandwich5\"\n   }\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function getHRP()\n    local character = player.Character or player.CharacterAdded:Wait()\n    return character:WaitForChild(\"HumanoidRootPart\")\nend\n\nwhile task.wait(0.25) do\n    local hrp = getHRP()\n\n    for _, itemName in ipairs(ITEM_NAMES) do\n        local part = workspace:FindFirstChild(itemName, true)\n\n        if part and part:IsA(\"BasePart\") then\n            part.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)\n        end\n    end\nend","owner":{"_id":"68b239398decc0a6778f51ca","username":"TheRealAmethyestYT","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/bbb2e9b63989a3646de0d437dca020f5223bfa2a6cb0294cc3405802c7394624.webp","original":"https://scriptblox.com/images/photo/68b239398decc0a6778f51ca-1759102896978.jpg"},"status":"offline","id":"68b239398decc0a6778f51ca","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/bbb2e9b63989a3646de0d437dca020f5223bfa2a6cb0294cc3405802c7394624.webp","original":"https://scriptblox.com/images/photo/68b239398decc0a6778f51ca-1759102896978.jpg"}},"verified":false,"views":326,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/1bbd6ed