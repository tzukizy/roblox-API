n    local TweenInfo = TweenInfo.new(Time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, reverse, 0)\n    local t = TweenService:Create(part, TweenInfo, {CFrame = pos})\n    t:Play()\n    coroutine.wrap(function()\n        repeat\n            part.Velocity = Vector3.new(0,0,0)\n            task.wait()\n        until veloset == false\n    end)()\n    thing = true\n    if thing == true then\n        t.Completed:Wait()\n        veloset = false\n    end\nend\n\nwhile true do wait()\n    for i,v in pairs(workspace.Interactions.Nodes.Harvest.Solstice.ActiveNodes:GetDescendants()) do\n        if v.Name == \"Solstice2022\" and v:FindFirstChild(\"SolsticeEggBox\") then\n            iv = v\n        end\n        if iv and iv:FindFirstChild(\"SolsticeEggBox\") then\n            tweento(game.Players.LocalPlayer.Character.HumanoidRootPart, iv.SolsticeEggBox.CFrame * CFrame.new(0,2,0), 200, false, true)\n            iv.StateRemote:InvokeServer(true)\n            wait(0.5)\n            for i = 0,4 do\n                iv.BoostRemote:InvokeServer(true, \"Solstice\" .. i)\n                wait(0.15)\n            end\n            wait(0.8)\n        end\n    end\nend\n","features":"auto collect egg box (solstice)","tags":[],"discord":"","keyLink":"","owner":{"_id":"625c870e6db0e41ac329324f","username":"eixotic07","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"625c870e6db0e41ac329324f","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T03:00:58.235Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f417","editBy":{"_id":"625c870e6db0e41ac329324f","username":"eixotic07","status":"o