{"slug":"Universal-Script-inf-health-102308","_id":"698401201a5b2310139bbd05","title":"inf health","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1770258720629.jpg","placeId":0},"features":"it just gives you inf health, sometimes it doesnt work tho:p","tags":["inf health"],"script":"local players = game:GetService(\"Players\")\nlocal player = players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\nif humanoid then\n    -- Set initial health to max\n    humanoid.Health = humanoid.MaxHealth\n    \n    -- Continuously keep health at max\n    while true do\n        wait(0.1)\n        if humanoid.Health < humanoid.MaxHealth then\n            humanoid.Health = humanoid.MaxHealth\n        end\n    end\nend","owner":{"_id":"68b5810d2141be825821d1a6","username":"nute","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68b5810d2141be825821d1a6","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":7808,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1770258720629.jpg","likeCount":5,"dislikeCount":2,"createdAt":"2026-02-05T02:32:00.656Z","editBy":{"_id":"68b5810d2141be825821d1a6","username":"nute","status":"offline","id":"68b5810d2141be825821d1a6"},"keyLink":"","executes":8184,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"698401201a5b2310139bbd08","editBy":{"_id":"68b5810d2141be825821d1a6","username":"nute","status":"offline","id":"68b5810d2141be825821d1a6"},"message":"Create script","createdAt":"2026-02-05T02:32:00.658Z"},{"_id":"6984019c35987d06cf9e2503","editBy":{"_id":"68b5810d2141be825821d1a6","username":"nute","status":"offline","id":"68b5810d2141be825821d1a6"},"message":"Update script","createdAt":"2026-02-05T02:34:04.305Z"},{"_id":"69840270a76540