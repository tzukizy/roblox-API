{"slug":"DIG-Open-Source-No-Gui-Auto-Farm-Dig-Minigame-And-Auto-Hole-43525","_id":"6862c556a429560935b87b98","title":"Open Source No Gui Auto Farm  Minigame And Auto Hole","game":{"_id":"685933839d2d67dc008ac1e6","gameId":126244816328678,"name":"DIG 💛","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":126244816328678},"features":"Made by @kylosilly report bugs in my dms or add me","tags":["auto farm","op","dig","best","open source"],"script":"-- made by @kylosilly if anyone is nice tell @23899348291 -- on discord (his user) to unblock me\nlocal local_player = game:GetService(\"Players\").LocalPlayer\nlocal workspace = game:GetService(\"Workspace\")\n\nlocal holes = workspace:FindFirstChild(\"World\"):FindFirstChild(\"Zones\"):FindFirstChild(\"_NoDig\")\n\ngetgenv().enabled = true\n\nfunction get_tool()\n    return local_player.Character:FindFirstChildOfClass(\"Tool\")\nend\n\nlocal_player.Character.ChildAdded:Connect(function(v)\n    if enabled and v:IsA(\"Tool\") and v.Name:find(\"Shovel\") then\n        task.wait(1)\n        if holes:FindFirstChild(local_player.Name..\"_Crater_Hitbox\") then\n            holes[local_player.Name..\"_Crater_Hitbox\"]:Destroy()\n        end\n        v:Activate()\n    end\nend)\n\nlocal_player.PlayerGui.ChildAdded:Connect(function(v)\n    if enabled and v.Name == \"Dig\" then\n        local strong_bar = v:FindFirstChild(\"Safezone\"):FindFirstChild(\"Holder\"):FindFirstChild(\"Area_Strong\")\n        local player_bar = v:FindFirstChild(\"Safezone\"):FindFirstChild(\"Holder\"):FindFirstChild(\"PlayerBar\")\n        player_bar:GetPropertyChangedSignal(\"Position\"):Connect(function()\n            if not enabled then return end\n            if math.abs(player_bar.Position.X.Scale - strong_bar.Position.X.Scale) <= 0.04 then\n                local tool = get_tool()\n                if tool then\n                    tool:Activate()\n                    task.wait()\n                end\n            end\n        end)\n    end\nend)\n\nlocal_player:GetAttributeChangedSignal(\"IsDigging\"):Connect(function()\n    if not enabled then return end\n    if not local_player:GetAttribute(\"IsDigging\") then\n        if holes:FindFirstChild(local_player.Name..\"_Crater_Hitbox\") then\n            holes[local_player.Name..\"_Crater_Hitbox\"]:Destroy()\n        end\n        local tool = get_tool()\n        if tool then\n            tool:Activate()\n        end\n    end\nend)","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"}},"verified":false,"views":2072,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-38334daf4b8073ee8d3d9976dfc7bfe8-1abbee8b4bb9.png","scriptblox":"https://scriptblox.com/images/script/rbx-38334daf4b8073ee8d3d9976dfc7bfe8-1abbee8b4bb9.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-06-30T17:11:50.701Z","editBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","status":"offline","id":"677be435ea4516cd66668ea7"},"executes":25,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:11:41.102Z","last":"","win":14,"math":2},"thumbnail":{"url"