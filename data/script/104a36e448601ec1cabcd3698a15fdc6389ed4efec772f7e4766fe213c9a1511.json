s\"):WaitForChild(\"RequestUpgrade\"):FireServer(unpack(args))\nend\n\nlocal function GetPlot()\n    for _, v in pairs(workspace.Plots:GetChildren()) do\n        local owner = v:GetAttribute(\"Owner\")\n        if owner and owner == Plr.UserId then\n            return v \n        end\n    end\nend\n\nlocal UserPlot = GetPlot()\nlocal BeeButton = UserPlot:FindFirstChild(\"BeeButton\")\n\nlocal function SpawnBee()\n    local ClickDe = BeeButton:FindFirstChild(\"ButtonPart\"):FindFirstChild(\"ClickDetector\")\n    fireclickdetector(ClickDe)\nend\n\ngetgenv().Settings = {\n    AutoSpawnBee = true\n}\n\nwhile getgenv().Settings.AutoSpawnBee do\n    local startTime = tick()\n    while tick() - startTime < 10 and getgenv().Settings.AutoSpawnBee do\n        task.wait()\n        SpawnBee()\n    end\n    task.wait(5)\nend","features":"Spawns bees without you needing to click","tags":[],"discord":"","keyLink":"","owner":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","verified":false,"profilePicture":{"url":"https://media.kocakz.me/44e63c7ae30cf5ca3528cd1f80a7d748897e993ab91eb3c8d74ebd8b9fdd375d.webp","original":"https://scriptblox.com/images/photo/68a0282b9b3b9b33fdf65bd7-1755326601503.png"},"status":"offline","id":"68a0282b9b3b9b33fdf65bd7","profile":{"url":"https://media.kocakz.me/44e63c7ae30cf5ca3528cd1f80a7d748897e993ab91eb3c8d74ebd8b9fdd375d.webp","original":"https://scriptblox.com/images/photo/68a0282b9b3b9b33fdf65bd7-1755326601503.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:41:42.596Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"694b532031e76adf317c3606","editBy":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","status":"offline","id":"68a0282b9b3b9b33fdf65bd7"},"message":"Create script","createdAt":"2025-12-24T02:42:40.964Z"}],"comments"