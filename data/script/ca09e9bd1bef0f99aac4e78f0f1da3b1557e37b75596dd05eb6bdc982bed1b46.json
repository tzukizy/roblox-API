{"_id":"6ac44e01229b329fe6e2dd27","title":"Noclip Script For Any Game","game":{"_id":"67e5e1ffb360710ec3c77d4f","gameId":6516141723,"name":"DOORS 🍬🍭","imageUrl":{"url":"https://media.kocakz.me/659a39c6fa1a2e3efa5ce51d1e47538a763613d695d3f0dec49a19c506360663.webp","original":"https://tr.rbxcdn.com/180DAY-6d72472d3b2a47c5441194c8cf9f002c/150/150/Image/Png/noFilter"},"slug":"6516141723-doors","path":"/game/6516141723-doors","thumbnail":{"url":"https://media.kocakz.me/659a39c6fa1a2e3efa5ce51d1e47538a763613d695d3f0dec49a19c506360663.webp","original":"https://tr.rbxcdn.com/180DAY-6d72472d3b2a47c5441194c8cf9f002c/150/150/Image/Png/noFilter"},"placeId":6516141723},"slug":"DOORS-Noclip-Script-For-Any-Game-231566","verified":false,"key":false,"keyless":false,"views":1426,"executes":6726,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ea85b0adcb599b0a8b8ebd02c581b8cf637c67cf1b91e71f6b2fade298200ec8.webp","original":"https://scriptblox.com/images/sb/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png","scriptblox":"https://scriptblox.com/images/script/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png"},"thumbnail":{"url":"https://media.kocakz.me/ea85b0adcb599b0a8b8ebd02c581b8cf637c67cf1b91e71f6b2fade298200ec8.webp","original":"https://scriptblox.com/images/sb/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png","scriptblox":"https://scriptblox.com/images/script/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-06T01:25:21.880Z","updatedAt":"2026-10-06T01:25:21.880Z","lastBump":"2026-10-06T01:25:21.880Z","script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal noclip = false\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\n\tif input.KeyCode == Enum.KeyCode.N then\n\t\tnoclip = not noclip\n\t\tprint(\"Noclip:\", noclip and \"ON\" or \"OFF\")\n\tend\nend)\n\nRunService.Stepped:Connect(function()\n\tif not player.Character then return end\n\n\tfor _, part in ipairs(player.Character:GetDescendants()) do\n\t\tif part:IsA(\"BasePart\") then\n\t\t\tpart.CanCollide = not noclip\n\t\tend\n\tend\nend)","features":"Noclip in any game","tags":[],"discord":"","keyLink":"","owner":{"_id":"6ab03416195aff22905d4783","username":"robloxcheatsaregoat","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":5,"status":"offline","id":"6ab03416195aff22905d4783","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-11T08:14:38.290Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":0,"at":"2026-10-23T21:45:06.514Z","last":"w","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ac44e01229b329fe6e2dd29","editBy":{"_id":"6ab03416195aff22905d4783","username":"robloxcheatsaregoat","status":"offline","id":"6ab03416195aff22905d4783"},"message":"Create script","createdAt":"2026-10-06T01:25:21.885Z"}],"comments":[]}