{"slug":"DOORS-Noclip-Script-For-Any-Game-231566","_id":"6ac44e01229b329fe6e2dd27","title":"Noclip Script For Any Game","game":{"_id":"67e5e1ffb360710ec3c77d4f","gameId":6516141723,"name":"DOORS 🚨","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":6516141723},"features":"Noclip in any game","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal noclip = false\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\n\tif input.KeyCode == Enum.KeyCode.N then\n\t\tnoclip = not noclip\n\t\tprint(\"Noclip:\", noclip and \"ON\" or \"OFF\")\n\tend\nend)\n\nRunService.Stepped:Connect(function()\n\tif not player.Character then return end\n\n\tfor _, part in ipairs(player.Character:GetDescendants()) do\n\t\tif part:IsA(\"BasePart\") then\n\t\t\tpart.CanCollide = not noclip\n\t\tend\n\tend\nend)","owner":{"_id":"6ab03416195aff22905d4783","username":"robloxcheatsaregoat","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":3,"status":"offline","id":"6ab03416195aff22905d4783","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyless":false,"views":1076,"executes":6300,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/ea85b0adcb599b0a8b8ebd02c581b8cf637c67cf1b91e71f6b2fade298200ec8.webp","original":"https://scriptblox.com/images/sb/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png","scriptblox":"https://scriptblox.com/images/script/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2