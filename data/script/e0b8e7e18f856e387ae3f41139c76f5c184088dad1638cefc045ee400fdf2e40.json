{"_id":"69d5af9a362501347b4d3dff","title":"NO DASH COOLDOWN HANMA BG","game":{"_id":"69d5af9a362501347b4d3dfc","gameId":132732553183665,"name":"[UPDATE] Hanma Battlegrounds","imageUrl":{"url":"https://media.kocakz.me/b3584e28778af8ca7e9ae118bd51d730d08362916a9c8b62919bbbd34a334754.webp","original":"https://tr.rbxcdn.com/180DAY-8c2874f610e992cb3525c52495a4c680/150/150/Image/Png/noFilter"},"slug":"132732553183665-hanma-battlegrounds","path":"/game/132732553183665-hanma-battlegrounds","thumbnail":{"url":"https://media.kocakz.me/b3584e28778af8ca7e9ae118bd51d730d08362916a9c8b62919bbbd34a334754.webp","original":"https://tr.rbxcdn.com/180DAY-8c2874f610e992cb3525c52495a4c680/150/150/Image/Png/noFilter"},"placeId":132732553183665},"slug":"UPDATE-Hanma-Battlegrounds-NO-DASH-COOLDOWN-HANMA-BG-193839","verified":false,"key":false,"keyless":false,"views":1128,"executes":221,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/04288952e09281478b46b74907ae8f11752da993270ed98e5be6a64434d39072.webp","original":"https://scriptblox.com/images/sb/rbx-9e1b46f8d8cdbe2cc524437218d19a76-2ce917bd37f0.png","scriptblox":"https://scriptblox.com/images/script/rbx-9e1b46f8d8cdbe2cc524437218d19a76-2ce917bd37f0.png"},"thumbnail":{"url":"https://media.kocakz.me/04288952e09281478b46b74907ae8f11752da993270ed98e5be6a64434d39072.webp","original":"https://scriptblox.com/images/sb/rbx-9e1b46f8d8cdbe2cc524437218d19a76-2ce917bd37f0.png","scriptblox":"https://scriptblox.com/images/script/rbx-9e1b46f8d8cdbe2cc524437218d19a76-2ce917bd37f0.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-04-08T01:30:02.956Z","updatedAt":"2026-04-08T01:30:02.956Z","lastBump":"2026-04-08T01:30:02.956Z","script":"-- NO DASH COOLDOWN (CharacterServer Client Bypass)\n-- Targets the \"G2.cfolder\" cooldown system\n\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n\n-- 1. Immediate Cleanup Loop\n-- This deletes cooldown folders the moment they appear\ntask.spawn(function()\n    while task.wait() do\n        if Character then\n            local side = Character:FindFirstChild(\"SideCooldown\")\n            local main = Character:FindFirstChild(\"MainCooldown\")\n            \n            if side then side:Destroy() end\n            if main then main:Destroy() end\n        end\n    end\nend)\n\n-- 2. The \"NoDash\" Attribute Bypass\n-- The script checks for a \"NoDash\" attribute before starting. We force it to false.\nCharacter:SetAttribute(\"NoDash\", false)\nCharacter:GetAttributeChangedSignal(\"NoDash\"):Connect(function()\n    Character:SetAttribute(\"NoDash\", false)\nend)\n\n-- 3. Humanoid State Fix\n-- The script disables dashing if the Humanoid is in certain states. \n-- This keeps the state clean.\nlocal humanoid = Character:FindFirstChildOfClass(\"Humanoid\")\nif humanoid then\n    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)\n    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)\nend\n\nprint(\"Infinite Dash Active: Cooldown Folders Suppressed.\")","features":"NO DASH COOLDOWN\n\n\nps made with volt","tags":[],"discord":"","keyLink":"","owner":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"profilePicture":{"url":"https://media.kocakz.me/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"},"lvl":12,"status":"offline","id":"687eba7419599ad33f38a3db","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0}