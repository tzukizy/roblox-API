 teleport you anywhere you press (ctrl + click)","tags":["Click TP","Universal","Free"],"discord":"","keyLink":"","owner":{"_id":"6653aefe009f097f4aaf75b9","username":"suborbann","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a657de033161c22773ac50cc1d8dea8e75438cfe51d1c20a81cc6374084e4e1c.webp","original":"https://scriptblox.com/images/photo/6653aefe009f097f4aaf75b9-1759409603351.jpg"},"status":"offline","id":"6653aefe009f097f4aaf75b9","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/a657de033161c22773ac50cc1d8dea8e75438cfe51d1c20a81cc6374084e4e1c.webp","original":"https://scriptblox.com/images/photo/6653aefe009f097f4aaf75b9-1759409603351.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:19:09.972Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c520c7","editBy":{"_id":"6653aefe009f097f4aaf75b9","username":"suborbann","status":"offline","id":"6653aefe009f097f4aaf75b9"},"message":"Create script","createdAt":"2025-03-27T20:49:29.406Z"}],"comments":[{"_id":"66e3047ded43a5d4f028599c","commentBy":{"_id":"6698b15ddc94f293852d1088","username":"GoonJoe","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/1e2fd4d1bd336069df1c0bb3466ea1b4c4733dd2f4e80907f0a7480498e4188a.webp","original":"https://scriptblox.com/images/photo/6698b15ddc94f293852d1088-1721539651274.png"},"createdAt":"2024-07-18T06:08:29.661Z","lastActive":"2026-10-18T16:24:58.435Z","lvl":7,"status":"offline","id":"6698b15ddc94f293852d1088","profile":{"url":"https://media.kocakz.me/1e2fd4d1bd336069df1c0bb3466ea1b4c4733dd2f4e80907f0a7480498e4188a.webp","original":"https://scriptblox.com/images/photo/6698b15ddc94f293852d1088-1721539651274.png"}},"text":"Inf yield can do the same tho","createdAt":"2024-09-12T15: