{"slug":"Universal-Script-Click-TP-18195","_id":"66e2fcf7a8ac3264260bf94f","title":"Click TP","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2390635-1726151927778.png","placeId":0},"features":"Can teleport you anywhere you press (ctrl + click)","tags":["Click TP","Universal","Free"],"script":"local UIS = game:GetService(\"UserInputService\")\n\nlocal Player = game.Players.LocalPlayer\nlocal Mouse = Player:GetMouse()\n\n\nfunction GetCharacter()\n   return game.Players.LocalPlayer.Character\nend\n\nfunction Teleport(pos)\n   local Char = GetCharacter()\n   if Char then\n       Char:MoveTo(pos)\n   end\nend\n\n\nUIS.InputBegan:Connect(function(input)\n   if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then\n       Teleport(Mouse.Hit.p)\n   end\nend)","owner":{"_id":"6653aefe009f097f4aaf75b9","username":"suborbann","verified":false,"profilePicture":"/images/photo/6653aefe009f097f4aaf75b9-1759409603351.jpg","status":"offline","id":"6653aefe009f097f4aaf75b9","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":56602,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-09-12T14:38:47.815Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/2390635-1726151927778.png","executes":97,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c520c7","editBy":{"_id":"6653aefe009f097f4aaf75b9","username":"suborbann","status":"offline","id":"6653aefe009f097f4aaf75b9"},"message":"Create script","createdAt":"2025-03-27T20:49:29.406Z"}],"comments":[{"_id":"66e3047ded43a5d4f028599c","commentBy":{"_id":"6698b15ddc94f293852d1088","username":"GoonJoe","verified":false,"role":"user","profilePicture":"/images/photo/6698b15ddc94f293852d1088-1721539651274.png","createdAt":"2024-07-18T06:08:29.661Z","lastActive":"2026-10-07T13:35:02.282Z","stat