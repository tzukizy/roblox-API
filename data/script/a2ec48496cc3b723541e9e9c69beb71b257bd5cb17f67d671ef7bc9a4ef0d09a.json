{"slug":"Universal-Script-Click-TP-18195","_id":"66e2fcf7a8ac3264260bf94f","title":"Click TP","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Can teleport you anywhere you press (ctrl + click)","tags":["Click TP","Universal","Free"],"script":"local UIS = game:GetService(\"UserInputService\")\n\nlocal Player = game.Players.LocalPlayer\nlocal Mouse = Player:GetMouse()\n\n\nfunction GetCharacter()\n   return game.Players.LocalPlayer.Character\nend\n\nfunction Teleport(pos)\n   local Char = GetCharacter()\n   if Char then\n       Char:MoveTo(pos)\n   end\nend\n\n\nUIS.InputBegan:Connect(function(input)\n   if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then\n       Teleport(Mouse.Hit.p)\n   end\nend)","owner":{"_id":"6653aefe009f097f4aaf75b9","username":"suborbann","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/a657de033161c22773ac50cc1d8dea8e75438cfe51d1c20a81cc6374084e4e1c.webp","original":"https://scriptblox.com/images/photo/6653aefe009f097f4aaf75b9-1759409603351.jpg"},"status":"offline","id":"6653aefe009f097f4aaf75b9","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/a657de033161c22773ac50cc1d8dea8e75438cfe51d1c20a81cc6374084e4e1c.webp","original":"https://scriptblox.com/images/photo/6653aefe009f097f4aaf75b9-1759409603351.jpg"}},"verified":false,"keyLink":"","views":56615,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-09-12T14:38:47.815Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/4a569fa381a8f3a4d4bef27a1a9351aeb672f2a406c06f3e24992cd6eeb2e165.webp","original":"https://scriptblox.com/images/sb/2390635-1726151927778.png","scriptblox":"https:/