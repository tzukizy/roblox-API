lr and \n                    v.NRPBS.Health.Value > 0 \n                    and v.TeamColor ~= lplr.TeamColor \n                 then\n                    game:GetService(\"Players\").LocalPlayer.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame\n                    camera.CFrame = CFrame.new(camera.CFrame.Position, v.Character[\"Head\"].Position) \n            end\n        end\n    end\nend","features":"A autofarm script","tags":[],"discord":"","keyLink":"","owner":{"_id":"66b350a01b89fe8d0dc53792","username":"Null7331","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a8a3d36259c3fd9c1969cb25221576497fad1e158e127235b30dcbc216d826d7.webp","original":"https://scriptblox.com/images/photo/66b350a01b89fe8d0dc53792-1723027673811.png"},"status":"offline","id":"66b350a01b89fe8d0dc53792","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/a8a3d36259c3fd9c1969cb25221576497fad1e158e127235b30dcbc216d826d7.webp","original":"https://scriptblox.com/images/photo/66b350a01b89fe8d0dc53792-1723027673811.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:57:58.092Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51bfc","editBy":{"_id":"66b350a01b89fe8d0dc53792","username":"Null7331","status":"offline","id":"66b350a01b89fe8d0dc53792"},"message":"Create script","createdAt":"2025-03-27T07:53:43.705Z"}],"comments":[{"_id":"66bd2184eb363260d6989b21","commentBy":{"_id":"66b948bd70a0d841291e4025","username":"subb","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/8fc7bef55179e57d1da617bdfaedec87a022aba18b69d7b4fde80129778abcae.webp","original":"https://scriptblox.com/images/photo/66b948bd70a0d841291e4025-1723418861082.png"},"createdAt":"2024-08-11T23:26:53.518Z","lastActive":