{"_id":"68d9220fa9158ee3764d9ed6","title":"See Who Are Friends in a Server","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-See-Who-Are-Friends-in-a-Server-55454","verified":false,"key":false,"keyless":false,"views":1711,"executes":102,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/aadda0e59ba8635b50c53806f44528b2de1d2e74c76f7bd673b9595c8787bb88.webp","original":"https://scriptblox.com/images/sb/0-1759060495401.png","scriptblox":"https://scriptblox.com/images/script/0-1759060495401.png"},"thumbnail":{"url":"https://media.kocakz.me/aadda0e59ba8635b50c53806f44528b2de1d2e74c76f7bd673b9595c8787bb88.webp","original":"https://scriptblox.com/images/sb/0-1759060495401.png","scriptblox":"https://scriptblox.com/images/script/0-1759060495401.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-09-28T11:54:55.420Z","updatedAt":"2025-09-28T11:54:55.420Z","lastBump":"2025-09-28T11:54:55.420Z","script":"local Players = game:GetService(\"Players\")\n\n-- 🔧 OPTIONS -----------------------------------------------------\nlocal LOOP_ENABLED = false   -- true = keep printing; false = prints once\nlocal LOOP_INTERVAL = 60     -- seconds between prints if looping\n-------------------------------------------------------------------\n\nlocal function buildFriendshipList()\n    local friendshipList = {}\n    local playerList = Players:GetPlayers()\n\n    for i = 1, #playerList do\n        local p1 = playerList[i]\n        friendshipList[p1.Name] = {}\n\n        for j = 1, #playerList do\n            if i ~= j then\n                local p2 = playerList[j]\n                local success, isFriend = pcall(function()\n                    return p1:IsFriendsWith(p2.UserId)\n                end)\n                if success and isFriend then\n                    table.insert(friendshipList[p1.Name], p2.Name)\n                end\n            end\n        end\n    end\n\n    return friendshipList\nend\n\nlocal function printFriendships()\n    local list = buildFriendshipList()\n    print(\"Friendship list:\")\n    for player, friends in pairs(list) do\n        if #friends > 0 then\n            print(player .. \" is friends with: \" .. table.concat(friends, \", \"))\n        else\n            print(player .. \" has no friends in the server.\")\n        end\n    end\nend\n\nif LOOP_ENABLED then\n    while task.wait(LOOP_INTERVAL) do\n        printFriendships()\n    end\nelse\n    printFriendships()\nend","features":"The script will print a \"Friendship List\"\nThis will generate a list of users in the server who are friends with each other, provided in the Dev Console.\nPress F9 to open the Dev Console and view the Friendship List.","tags":["friends list","friends list checker"],"discord":"","keyLink":"","owner":{"_id":"68ce4dac5100bcf3f3ef8ca6","username":"etherheaded","verified":false,"profilePicture":{"url":"https://media.kocakz.me/06c7debf4a70e0172f06c769dafe54a284a5dc51579a88f4b04eec99e5b6e92e.webp","original":"https://scriptblox.com/images/photo/68ce4dac5100bcf3f3ef8ca6-1758350881791.png"},"status":"offline","id":"68ce4dac5100bcf3f3ef8ca6","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/06c7debf4a70e0172f06c769dafe54a284a5dc51579a88f4b04eec99e5b6e92e.webp","original":"https://scriptblox.com/images/photo/68ce4dac5100bcf3f3ef8ca6-1758350881791.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:44:44.672Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d9220fa9158ee