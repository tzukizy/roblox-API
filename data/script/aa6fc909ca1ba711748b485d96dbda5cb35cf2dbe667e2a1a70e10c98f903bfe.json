{"slug":"Universal-Script-Sit-gui-51529","_id":"68b8337d3639db7147313d1d","title":"Sit gui","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1756902269842.jpg","placeId":0},"features":"A black moveable sit GUI that when you click it, it will make you sit, when your sitting jump to stand back up.","tags":[],"script":"-- Sit GUI Script (LocalScript in StarterGui)\n\n-- Create ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n\n-- Create Frame (movable part)\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 200, 0, 80)\nframe.Position = UDim2.new(0.3, 0, 0.3, 0)\nframe.BackgroundColor3 = Color3.fromRGB(35, 35, 35)\nframe.Active = true\nframe.Draggable = true -- makes it moveable\nframe.Parent = screenGui\n\n-- Create Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 180, 0, 50)\nbutton.Position = UDim2.new(0, 10, 0, 15)\nbutton.Text = \"Sit\"\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\nbutton.Parent = frame\n\n-- Button click function\nbutton.MouseButton1Click:Connect(function()\n    local player = game.Players.LocalPlayer\n    local character = player.Character or player.CharacterAdded:Wait()\n    local humanoid = character:FindFirstChildWhichIsA(\"Humanoid\")\n    if humanoid then\n        humanoid.Sit = true\n    end\nend)","owner":{"_id":"68a65f978decc0a677281f5a","username":"808songa","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68a65f978decc0a677281f5a","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":3646,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1756902269842.jpg","likeCount":0,"dislikeCount":1,"createdAt":"2025-09-03T12:24:29.861Z","executes":3576,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b8337d3639db7147313d1f","editBy":{"_id":"68a65f978decc0a677281f5a","username":"808songa","status":"offline","id":"68a65f978decc0a677281f5a"},"message":"Create script","createdAt":"2025-09-03T12:24:29.865Z"}],"comments":[{"_id":"68b8398d3639db714731ed94","commentBy":{"_id":"6819d5b4b76a6903e94d714c","username":"realpewnie","verified":false,"role":"user","profilePicture":"/images/photo/6819d5b4b76a6903e94d714c-1761676295606.jpg","createdAt":"2025-05-06T09:26:12.045Z","lastActive":"2026-02-19T14:41:23.077Z","status":"offline","id":"6819d5b4b76a6903e94d714c","topMilestone":{"key":"creator.first_script","tier":1}},"text":"very usefull script love it","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-09-03T12:50:21.621Z","liked":false,"disliked":false},{"_id":"68b83b6cb2cb9160d5ea7248","commentBy":{"_id":"65748a1c06ff53dbd23f193e","username":"hi_hi_hi","verified":false,"role":"user","profilePicture":"/images/photo/65748a1c06ff53dbd23f193e-1756906980027.png","createdAt":"2023-12-09T15:39:08.163Z","lastActive":"2026-10-09T23:28:57.899Z","keylessCreator":true,"status":"offline","id":"65748a1c06ff53dbd23f193e","leaderboard":{"tag":{"kind":"month","rank":7,"period":"month","metric":"likes","value":31}},"topMilestone":{"key":"creator.chart_topper","tier":1}},"text":"* is 😂👏","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-03T12:58:20.162Z","liked":false,"disliked":false},{"_id":"68b83b78a67dcfdb61b0c695","commentBy":{"_id":"65748a1c06ff53dbd23f193e","username":"hi_hi_hi","verified":false,"role":"user","profilePicture":"/images/photo/65748a1c06ff53dbd23f193e-1756906980027.png","createdAt":"2023-12-09T15:39:08.163Z","lastActive":"2026-10-09T23:28:57.899Z","keylessCreator":true,"status":"offline","id":"65748a1c06ff53dbd23f193e","leaderboard":{"tag":{"kind":"month","rank":7,"period":"month","metric":"likes","value":31}},"topMilestone":{"key":"creator.chart_topper","tier":1}},"text":"scrip