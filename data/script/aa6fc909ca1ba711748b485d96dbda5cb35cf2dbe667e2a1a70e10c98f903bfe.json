{"_id":"68b8337d3639db7147313d1d","title":"Sit gui","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/36a882b609eb77815842115e4be424129c31382a2f02524b0db895933eecaabe.webp","original":"https://scriptblox.com/images/sb/0-1756902269842.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/36a882b609eb77815842115e4be424129c31382a2f02524b0db895933eecaabe.webp","original":"https://scriptblox.com/images/sb/0-1756902269842.jpg"},"placeId":0},"slug":"Universal-Script-Sit-gui-51529","verified":false,"key":false,"keyless":false,"views":3696,"executes":4279,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f04265b5ee12b74a1635723c772925ee8d56389fe55afa4acacc96b6c234aafc.webp","original":"https://scriptblox.com/images/sb/0-1756902269842.jpg","scriptblox":"https://scriptblox.com/images/script/0-1756902269842.jpg"},"thumbnail":{"url":"https://media.kocakz.me/f04265b5ee12b74a1635723c772925ee8d56389fe55afa4acacc96b6c234aafc.webp","original":"https://scriptblox.com/images/sb/0-1756902269842.jpg","scriptblox":"https://scriptblox.com/images/script/0-1756902269842.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-09-03T12:24:29.861Z","updatedAt":"2025-09-03T12:24:29.861Z","lastBump":"2025-09-03T12:24:29.861Z","script":"-- Sit GUI Script (LocalScript in StarterGui)\n\n-- Create ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n\n-- Create Frame (movable part)\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 200, 0, 80)\nframe.Position = UDim2.new(0.3, 0, 0.3, 0)\nframe.BackgroundColor3 = Color3.fromRGB(35, 35, 35)\nframe.Active = true\nframe.Draggable = true -- makes it moveable\nframe.Parent = screenGui\n\n-- Create Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 180, 0, 50)\nbutton.Position = UDim2.new(0, 10, 0, 15)\nbutton.Text = \"Sit\"\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\nbutton.Parent = frame\n\n-- Button click function\nbutton.MouseButton1Click:Connect(function()\n    local player = game.Players.LocalPlayer\n    local character = player.Character or player.CharacterAdded:Wait()\n    local humanoid = character:FindFirstChildWhichIsA(\"Humanoid\")\n    if humanoid then\n        humanoid.Sit = true\n    end\nend)","features":"A black moveable sit GUI that when you click it, it will make you sit, when your sitting jump to stand back up.","tags":[],"discord":"","keyLink":"","owner":{"_id":"68a65f978decc0a677281f5a","username":"808songa","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68a65f978decc0a677281f5a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:55:15.875Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b8337d3639db7147313d1f","editBy":{"_id":"68a65f978decc0a677281f5a","username":"808songa","status":"offline","id":"68a65f978decc0a677281f5a"},"message":"Create script","createdAt":"2025-09-03T12:24:29.865Z"}],"comments":[{"_id":"68b8398d3639db714731ed94","commentBy":{"_id":"6819d5b4b76a6903e94d714c","username":"realpewnie","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/7cd82fa0e71d08f6fe0dd864d808440e1ff75a6f6b96695ccab626ad2460a675.webp","original":"https://scriptblox.com/images/photo/6819d5b4b76a6903e94d714c-1761676295606.jpg"},"createdAt":"2025-05-06T09:26:12.045Z","lastActive":"2026-02-19T14:41:23.077Z","st