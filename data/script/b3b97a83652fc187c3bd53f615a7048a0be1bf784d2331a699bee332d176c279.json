{"slug":"Natural-Disaster-Survival-No-fall-damage-68524","_id":"6920a0f4fd746b79e89707a1","title":"No fall damage","game":{"_id":"67e5e1ffb360710ec3c77dd3","gameId":189707,"name":"Natural Disaster Survival","imageUrl":"/images/sb/rbx-7ea7065a02f8cff80f8b0270a9ad2d3b-0820ff9b1f88.png","placeId":189707},"features":"No daño de caida /Anti fall damage\nEvitar el daño de caida\na simple script\nun script muy simple, da igual\nhagan lo q sea con esta tonteria","tags":[],"script":"local ServicioRun = game:GetService(\"RunService\")\nlocal Latido = ServicioRun.Heartbeat\nlocal Render = ServicioRun.RenderStepped\nlocal Jugador = game.Players.LocalPlayer\nlocal VelocidadNula = Vector3.zero\nlocal function EvitarCaida(personaje)\n    local Raiz = personaje:WaitForChild(\"HumanoidRootPart\")\n    local conexion\n    conexion = Latido:Connect(function()\n        if not Raiz.Parent then\n            conexion:Disconnect()\n            return\n        end\n        local velocidadAnt = Raiz.AssemblyLinearVelocity\n        Raiz.AssemblyLinearVelocity = VelocidadNula\n        Render:Wait()\n        Raiz.AssemblyLinearVelocity = velocidadAnt\n    end)\nend\nEvitarCaida(Jugador.Character or Jugador.CharacterAdded:Wait())\nJugador.CharacterAdded:Connect(EvitarCaida)\n\n--sexo\n","owner":{"_id":"680ec2c6349aff89e6af247c","username":"joao_mods","verified":false,"profilePicture":"/images/photo/680ec2c6349aff89e6af247c-1746556528081.png","status":"offline","id":"680ec2c6349aff89e6af247c","leaderboard":{"tag":{"kind":"week","rank":20,"period":"week","metric":"executes","value":259813}},"topMilestone":{"key":"creator.streak","tier":30}},"verified":false,"views":2402,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-40fe0f5c013d768b2025dd90653fdae9-8f1e9ce76391.png","likeCount":3,"dislikeCount":2,"createdAt":"2025-11-21T17:27:16.444Z","executes":4785,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog"