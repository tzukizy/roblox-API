{"slug":"Natural-Disaster-Survival-Growing-natural-disasters-39893","_id":"68248152f4e11a128f3bcb3a","title":"Growing natural disasters","game":{"_id":"67e5e1ffb360710ec3c77dd3","gameId":189707,"name":"Natural Disaster Survival","imageUrl":"/images/sb/rbx-7ea7065a02f8cff80f8b0270a9ad2d3b-0820ff9b1f88.png","placeId":189707},"features":"Grows a dynamic object","tags":[],"script":"local part = script.Parent\nlocal RunService = game:GetService(\"RunService\")\n\n-- Only works for unanchored parts\nif part.Anchored then\n    warn(\"Part is anchored! Unanchor it to grow properly.\")\n    return\nend\n\n-- Settings\nlocal growthRate = Vector3.new(1, 1, 1) -- how much it grows per second\n\nRunService.Heartbeat:Connect(function(deltaTime)\n    part.Size = part.Size + (growthRate * deltaTime)\nend)","owner":{"_id":"681852ed3d0cbea73e9ca4bc","username":"ryannesumera","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"681852ed3d0cbea73e9ca4bc","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":26832,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/189707-1747222866474.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-05-14T11:41:06.503Z","executes":2341,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68248152f4e11a128f3bcb3c","editBy":{"_id":"681852ed3d0cbea73e9ca4bc","username":"ryannesumera","status":"offline","id":"681852ed3d0cbea73e9ca4bc"},"message":"Create script","createdAt":"2025-05-14T11:41:06.505Z"}],"comments":[{"_id":"6825df04f8062e8f480b69d1","commentBy":{"_id":"681852ed3d0cbea73e9ca4bc","username":"ryannesumera","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-05-05T05:55:57.407Z","lastActive":"2025-09-21T04:06:54.766Z","status":"offline","id":"681852ed3d0cbea73e9ca4bc","topMilestone":{"key":"creator.scripts","tier":5}},"text":"I don't have discord","e