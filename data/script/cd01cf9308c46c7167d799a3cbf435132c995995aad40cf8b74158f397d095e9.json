{"slug":"Universal-Script-remote-hook-42010","_id":"6847380028f4e97b9e7d2675","title":"remote hook","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"just a remote hook","tags":[],"script":"local target = {\n    enabled = true,\n    value = '...'\n    position = Vector3.new(0,0,0),\n    part = cloneref(game:GetService(\"Players\"))[target.value].Character.Head\n}\n\nlocal Hooks = {}\n\nHooks.Remote = hookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)\n    local args = { ... }\n    local method = getnamecallmethod():lower()\n\n    if target.enabled and target.position and target.part and method == 'fireserver' and self.Name == 'MainEvent' and args[1] == 'ShootGun' then\n        args[4] = target.position\n        args[5] = target.part\n        return Hooks.Remote(self, unpack(args))\n    end\n\n    return Hooks.Remote(self, ...)\nend))","owner":{"_id":"6831a305c236ccc4ac1621c5","username":"gaxriexz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4f639a741f9d4a2202eb2916f958187250d9b8205bf4670f22be9d52fff54b44.webp","original":"https://scriptblox.com/images/photo/6831a305c236ccc4ac1621c5-1749496057797.jpg"},"status":"offline","id":"6831a305c236ccc4ac1621c5","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/4f639a741f9d4a2202eb2916f958187250d9b8205bf4670f22be9d52fff54b44.webp","original":"https://scriptblox.com/images/photo/6831a305c236ccc4ac1621c5-1749496057797.jpg"}},"verified":false,"views":3131,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/55e06ef31fa39fa1348e05a6a50c9e1578a3f83eda0acd4ed728ae55c50d6648.webp","original":"https://scriptblox.com/images/sb/0-1749497856903.png","scriptblox":"https://scriptblox.com/images