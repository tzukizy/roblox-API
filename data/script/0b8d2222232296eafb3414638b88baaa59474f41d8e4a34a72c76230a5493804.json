{"_id":"68fdac5827de42bf3e53a8ee","title":"Auto Guns and Ghost Doors","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://media.kocakz.me/4d971323d4e760c0ab14aa8b1d4cf37289a279ff54af135ecbeaeb6cf138497b.webp","original":"https://tr.rbxcdn.com/180DAY-fee67c1f98361eac15c13f80b03592ae/150/150/Image/Png/noFilter"},"slug":"155615604-prison-life","path":"/game/155615604-prison-life","thumbnail":{"url":"https://media.kocakz.me/4d971323d4e760c0ab14aa8b1d4cf37289a279ff54af135ecbeaeb6cf138497b.webp","original":"https://tr.rbxcdn.com/180DAY-fee67c1f98361eac15c13f80b03592ae/150/150/Image/Png/noFilter"},"placeId":155615604},"slug":"Prison-Life-Auto-Guns-and-Ghost-Doors-60847","verified":true,"key":false,"keyless":false,"views":12964,"executes":171,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5262762ad75c69486e83ec49e3971ab05b5be37cfe44b8b3cb6c45702e244423.webp","original":"https://scriptblox.com/images/sb/155615604-1761455192242.png","scriptblox":"https://scriptblox.com/images/script/155615604-1761455192242.png"},"thumbnail":{"url":"https://media.kocakz.me/5262762ad75c69486e83ec49e3971ab05b5be37cfe44b8b3cb6c45702e244423.webp","original":"https://scriptblox.com/images/sb/155615604-1761455192242.png","scriptblox":"https://scriptblox.com/images/script/155615604-1761455192242.png"},"likeCount":5,"dislikeCount":1,"createdAt":"2025-10-26T05:06:32.282Z","updatedAt":"2025-10-26T05:06:32.282Z","lastBump":"2025-10-26T05:06:32.282Z","script":"local RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character, RootPart\n\nlocal AlreadyFound = {}\nlocal function FindGunSpawner(GunName)\n    if AlreadyFound[GunName] ~= nil then\n        return AlreadyFound[GunName], true\n    end\n\tfor i,v in pairs(workspace:GetChildren()) do\n\t\tif v.Name == \"TouchGiver\" then\n\t\t\tif v:GetAttribute(\"ToolName\") == GunName then\n                AlreadyFound[GunName] = v.TouchGiver\n\t\t\t\treturn v.TouchGiver, false\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function GetTool(ToolName)\n    return LocalPlayer:FindFirstChild(\"Backpack\") and LocalPlayer.Backpack:FindFirstChild(ToolName) or LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(ToolName)\nend\n\n\nlocal function GetGun(GunName)\n    local Giver, Found = FindGunSpawner(GunName)\n    if not Found then\n        local CloneGiver = Giver:Clone()\n        CloneGiver.Parent = Giver.Parent\n        Giver.Parent = workspace.Folder\n        Giver.CanCollide = false\n        Giver.Transparency = 1\n    end\n    repeat task.wait()\n        Giver.CFrame = RootPart.CFrame * CFrame.new(math.random(-2, 2),0,0)\n    until GetTool(GunName)\nend\n\nlocal function DoorsHandler()\n    local Doors = workspace:FindFirstChild(\"Doors\")\n    for i,v in pairs(Doors:GetDescendants()) do\n        if v:IsA(\"BasePart\") then\n            v.CanCollide = false\n            v.Transparency = 0.6\n        end\n    end\n    local CellDoors = workspace:FindFirstChild(\"CellDoors\")\n    for i,v in pairs(CellDoors:GetDescendants()) do\n        if v:IsA(\"BasePart\") then\n            v.CanCollide = false\n            v.Transparency = 0.6\n        end\n    end\nend\n\nlocal Gun1 = \"AK-47\"\nlocal Gun2 = \"Remington 870\"\n\nRunService.Heartbeat:Connect(function()\n    Character = LocalPlayer.Character\n    RootPart = Character.HumanoidRootPart\n    Humanoid = Character.Humanoid\n    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)\n    if not GetTool(Gun1) then\n        GetGun(Gun1)\n    end\n    if not GetTool(Gun2) then\n        GetGun(Gun2)\n    end\n    DoorsHandler()\nend)","features":"The Only Auto Guns working on prison life right now bypassing anticheat.\nGhost doors makes all doors transparent and noclipped.","tags":["bypass","working","prison","life","guns"],"discord":"","keyLink":"","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11048742}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:51:22.997Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68fdac5827de42bf3e53a8f0","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-10-26T05:06:32.285Z"}],"comments":[{"_id":"68fdaf9dd72ed8d63fd5a137","commentBy":{"_id":"681ee2fa3d0cbea73eaba34b","username":"ape3nt","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/a9e8641a1d7913a3385a71afc1d36fae25588f74cad926051b97cb355226fcd7.webp","original":"https://scriptblox.com/images/photo/681ee2fa3d0cbea73eaba34b-1755324958015.png"},"createdAt":"2025-05-10T05:24:10.800Z","lastActive":"2025-10-30T00:07:45.971Z","status":"offline","id":"681ee2fa3d0cbea73eaba34b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/a9e8641a1d7913a3385a71afc1d36fae25588f74cad926051b97cb355226fcd7.webp","original":"https://scriptblox.com/images/photo/681ee2fa3d0cbea73eaba34b-1755324958015.png"}},"text":"boo","edited":fa