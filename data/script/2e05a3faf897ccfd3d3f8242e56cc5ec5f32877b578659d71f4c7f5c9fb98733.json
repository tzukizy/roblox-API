{"slug":"LUCKY-BLOCKS-Battlegrounds-Get-Items-201162","_id":"69dd75ede1e7194ef3cc3df8","title":"Get Items","game":{"_id":"67e5e1ffb360710ec3c77d47","gameId":662417684,"name":"❓ LUCKY BLOCKS Battlegrounds","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":662417684},"features":"Hold down the button or press it to get items","tags":["Keyless","Free","NO key"],"script":"\nlocal player = game.Players.LocalPlayer\n\nif player then\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"SafeFarmGui\"\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\nscreenGui.ResetOnSpawn = false\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 150, 0, 50)\nframe.Position = UDim2.new(0, 20, 0, 20)\nframe.BackgroundColor3 = Color3.new(0, 0, 0)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Draggable = true\nframe.Parent = screenGui\n\nlocal textb = Instance.new(\"TextButton\")\ntextb.Parent = frame\ntextb.Size = UDim2.new(0, 100, 0, 40)\ntextb.BackgroundColor3 = Color3.new(0,0,0)\ntextb.Draggable = true\ntextb.Text = \"Press For lucky blocks\"\ntextb.TextColor3 = Color3.fromRGB(50, 80, 350)\ntextb.TextScaled = true\ntextb.TextXAlignment = Enum.TextXAlignment.Center \n\n\ntextb.MouseButton1Click:Connect(function()\n\tgame:GetService(\"ReplicatedStorage\"):FindFirstChild(\"SpawnLuckyBlock\"):FireServer()\n\tgame:GetService(\"ReplicatedStorage\"):FindFirstChild(\"SpawnSuperBlock\"):FireServer()\n\tgame:GetService(\"ReplicatedStorage\"):FindFirstChild(\"SpawnDiamondBlock\"):FireServer()\n\tgame:GetService(\"ReplicatedStorage\"):FindFirstChild(\"SpawnRainbowBlock\"):FireServer()\n\tgame:GetService(\"ReplicatedStorage\"):FindFirstChild(\"SpawnGalaxyBlock\"):FireServer()\nend)\n\nlocal holding = false\n\ntextb.MouseButton1Down:Connect(function()\n    holding = true\n    while holding do\n        local RS = game:GetService(\"ReplicatedStorage\")\n        RS.SpawnLuckyBlock:FireServer()\n        RS.SpawnSuperBlock:FireServer()\n        RS.SpawnDiamondBlock:FireServer()\n        RS.SpawnRainbowBlock:FireServer()\n        RS.SpawnGalaxyBlock:FireServer()\n        task.wait(0.1)\n    end\nend)\n\ntextb.MouseButton1Up:Connect(function() holding = false end)\ntextb.MouseLeave:Connect(function() holding = false end)\n\n\nend ","owner":{"_id":"6824ca13f4e11a128f46befe","username":"tuffIsTuff","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6824ca13f4e11a128f46befe","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":1784,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/98751c94e196ff430b7cfd3b5689f25496f95d7e7b44e96215e79f5481f73792.webp","original":"https://scriptblox.com/images/sb/rbx-52e6d4ee7ff91dd45827c85c2fb26c1b-be6ef71211f7.png","scriptblox":"https://scriptblox.com/images/script/rbx-52e6d4ee7ff91dd45827c85c2fb26c1b-be6ef71211f7.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-13T23:02:05.415Z","executes":1437,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:04:39.529Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/98751c94e196ff430b7cfd3b5689f25496f95d7e7b44e96215e79f5481f73792.webp","original":"https://scriptblox.com/images/sb/rbx-52e6d4ee7ff91dd45827c85c2fb26c1b-be6ef71211f7.png","scriptblox":"https://scriptblox.com/images/script/rbx-52e6d4ee7ff91dd45827c85c2fb26c1b-be6ef71211f7.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dd75ede1e7194ef3cc3dfb","editBy":{"_id":"6824ca13f4e11a128f46befe","username":"tuffIsTuff","status":"offline","id":"6824ca13f4e11a128f4