{"slug":"Trade-a-Brainrot-DUPE-SCRIPT-OP-ANTILAG-NO-KEY-59499","_id":"68f4c0fa37c8c38d2a3732cf","title":"DUPE SCRIPT OP ANTILAG NO KEY","game":{"_id":"68a65d835165138168ebf4ff","gameId":138384544898173,"name":"[🎄] Trade a Brainrot","imageUrl":"/images/sb/rbx-66e413007c7e9e81927a665b85cc51f7-e1296b23d48b.png","placeId":138384544898173},"features":"Op script","tags":[],"script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Knit = require(ReplicatedStorage.Packages.Knit)\n\n-- Получаем сервисы\nlocal InventoryController = Knit.GetController(\"InventoryController\")\nlocal EquipmentService = Knit.GetService(\"EquipmentService\")\n\n-- Функция: достаём вес из ключа\nlocal function getWeight(key)\n    local parts = string.split(key, \"|\")\n    return tonumber(parts[2]) or 0\nend\n\n-- Функция: экипировать 2 самых тяжёлых предмета (не Egg)\nlocal function equipTwoHeaviest()\n    local items = {}\n\n    -- Собираем предметы\n    for _, stack in ipairs(InventoryController.InventoryLayout) do\n        if stack and stack.Key and stack.Count > 0 then\n            if not string.find(stack.Key, \"Egg\") then\n                table.insert(items, stack)\n            end\n        end\n    end\n\n    -- Сортируем по весу (убывание)\n    table.sort(items, function(a, b)\n        return getWeight(a.Key) > getWeight(b.Key)\n    end)\n\n    -- Берём первые два и экипируем\n    for i = 1, math.min(2, #items) do\n        local stack = items[i]\n        print(\"Экипируем:\", stack.Key, \"вес:\", getWeight(stack.Key), \"stackId:\", stack.stackId)\n        EquipmentService:EquipItem(stack.Key, stack.stackId)\n    end\nend\n\n-- Авто каждые 0.5 сек\nwhile task.wait(2) do\n    equipTwoHeaviest()\nend","owner":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"verified":false,"views":9373,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-e70d398687d58e567b3bf764cb1918ec-5f4a39c61a0c.png","likeCount":0,"dislikeCount":2,"createdAt":"2025-10-19T10:44:10.854Z","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"executes":533,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f4c0fa37c8c38d2a3732d1","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Create script","createdAt":"2025-10-19T10:44:10.858Z"},{"_id":"68f4c2b637c8c38d2a379f82","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Update script","createdAt":"2025-10-19T10:51:34.735Z"},{"_id":"68f4c32737c8c38d2a37ba31","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Update script","createdAt":"2025-10-19T10:53:27.405Z"},{"_id":"68f4c3dbb8bf0b55c09632d7","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Update script","createdAt":"2025-10-19T10:56:27.984Z"},{"_id":"68f4c747818f4ffb87c19d19","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Update script","createdAt":"2025-10-19T11:11:03.185Z"},{"_id":"68f4c7a633f48746635c2255","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Update script","createdAt":"2025-10-19T11:12:38.153Z"},{"_id":"68f4c880b839ebfe18331636","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Update script","createdAt":"2025-10-19T11:16:16.374Z"},{"_id":"68f4e1d001b98b93210e0df1","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id"