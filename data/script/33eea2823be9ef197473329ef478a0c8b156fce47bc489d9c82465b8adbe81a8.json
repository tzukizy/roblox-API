{"slug":"UPDATE-DUELIST:-PvP-(BETA)-OPEN-SOURCE-Silent-Aim-240533","_id":"6a44dbb0ddce94fb47b21969","title":"OPEN SOURCE Silent Aim","game":{"_id":"6a400397c71449d2c95432b9","gameId":122310270867133,"name":"[UPDATE] DUELIST: PvP","imageUrl":"/images/sb/rbx-f422c598b44053df399578e285133e12-51c0f1df10f0.png","placeId":122310270867133},"features":"A silent aim for this game ig note you need to reexecute every round i cba to add a connection","tags":["Silent Aim","Source","Open Source","Duelist","Duelist  Pvp"],"script":"-- // Read Description\n\nwarn(\"Start !!\")\n-- // --\nlocal Plrs = game:GetService(\"Players\")\nlocal LclPlr = Plrs.LocalPlayer\nlocal Cam = workspace.CurrentCamera\nlocal Mse = LclPlr:GetMouse()\n-- // --\nlocal function GetTgt()\n    local Tgt, Dist = nil, math.huge\n    for _, Plr in Plrs:GetPlayers()do\n        if Plr == LclPlr or not Plr.Character then\n            continue\n        end\n        local Head = Plr.Character:FindFirstChild('Head')\n        local Hum = Plr.Character:FindFirstChild('Humanoid')\n        if not Head or not Hum or Hum.Health <= 0 then\n            continue\n        end\n        local Pos, OnScr = Cam:WorldToViewportPoint(Head.Position)\n        if not OnScr then\n            continue\n        end\n        local D = (Vector2.new(Mse.X, Mse.Y) - Vector2.new(Pos.X, Pos.Y)).Magnitude\n        if D < Dist then\n            Dist = D\n            Tgt = Head\n        end\n    end\n    return Tgt\nend\n-- // --\nlocal RayFn\nfor _, Fn in getgc(true) do\n    if typeof(Fn) == \"function\" and debug.info(Fn, \"l\") == 3162 and #debug.getupvalues(Fn) == 4 then\n        RayFn = Fn\n        break\n    end\nend\nlocal ShootFn\nfor _, Fn in getgc(true) do\n    if typeof(Fn) == \"function\" and debug.info(Fn, \"l\") == 3225 then\n        for Key, Value in debug.getupvalues(Fn) do\n            if Value == RayFn then\n                ShootFn = Fn\n                break\n            end\n        end\n    end\n    if ShootFn then \n        break \n    end\nend\nlocal OldRay = debug.getupvalue(ShootFn, 21)\n-- // --\ndebug.setupvalue(ShootFn, 21, function(Spread, Origin)\n    local Tgt = GetTgt()\n    if Tgt then\n        return { Position = Tgt.Position, Normal = Vector3.new(0, 1, 0), Distance = 1, Instance = Tgt }\n    end\n    return OldRay(Spread, Origin)\nend)\n-- // --\nwarn(\"Done !!\")","owner":{"_id":"6852be67fe7b473b704f584b","username":"deaggilisspees","verified":true,"profilePicture":"/images/photo/6852be67fe7b473b704f584b-1775076993087.png","status":"offline","id":"6852be67fe7b473b704f584b","topMilestone":{"key":"creator.followers","tier":10}},"verified":true,"views":7478,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/122310270867133-1782897584098.webp","likeCount":3,"dislikeCount":4,"createdAt":"2026-07-01T09:19:44.126Z","executes":3571,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a44dbb0ddce94fb47b2196b","editBy":{"_id":"6852be67fe7b473b704f584b","username":"deaggilisspees","status":"offline","id":"6852be67fe7b473b704f584b"},"message":"Hmmmmm","createdAt":"2026-07-01T09:19:44.131Z"}],"comments":[{"_id":"6a44f59629cb000b1af01803","commentBy":{"_id":"67e8d4aa229e347e5d91d2d7","username":"ghxstnewmain","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-03-30T05:20:42.104Z","lastActive":"2026-10-07T05:56:05.251Z","status":"offline","id":"67e8d4aa229e347e5d91d2d7","topMilestone":{"key":"creator.scripts","tier":25}},"text":"doesnt work on psm?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-01T11:10:14.391Z","liked":false,"disliked":false},{"_id":"6a44fd7a0f56d137bffe14da","commentBy":{"_id":"6852be67fe7b473b704f584b","username":"deaggilisspees","verified":true,"role":"user","profilePicture":"/images/photo/6852be67fe7b473b704f584b-1775076993087.png","createdAt":"2025-06-18T13:25:59.905Z","lastActive":"2026-10-01T13:28:20.16