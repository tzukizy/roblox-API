{"_id":"6a44dbb0ddce94fb47b21969","title":"OPEN SOURCE Silent Aim","game":{"_id":"6a400397c71449d2c95432b9","gameId":122310270867133,"name":"[UPDATE] DUELIST: PvP","imageUrl":{"url":"https://media.kocakz.me/a5658f992c85276c92ecac243a248614c15f4d2ae1f07b4636ae2d3566133d54.webp","original":"https://scriptblox.com/images/sb/rbx-f422c598b44053df399578e285133e12-51c0f1df10f0.png"},"slug":"122310270867133-duelist-pvp","path":"/game/122310270867133-duelist-pvp","thumbnail":{"url":"https://media.kocakz.me/a5658f992c85276c92ecac243a248614c15f4d2ae1f07b4636ae2d3566133d54.webp","original":"https://scriptblox.com/images/sb/rbx-f422c598b44053df399578e285133e12-51c0f1df10f0.png"},"placeId":122310270867133},"slug":"UPDATE-DUELIST:-PvP-(BETA)-OPEN-SOURCE-Silent-Aim-240533","verified":true,"key":false,"keyless":false,"views":7512,"executes":3896,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/692ca417554de25fd318510c257a89f58bd2f7adc6403786e6c22c7a0e206b18.webp","original":"https://scriptblox.com/images/sb/122310270867133-1782897584098.webp","scriptblox":"https://scriptblox.com/images/script/122310270867133-1782897584098.webp"},"thumbnail":{"url":"https://media.kocakz.me/692ca417554de25fd318510c257a89f58bd2f7adc6403786e6c22c7a0e206b18.webp","original":"https://scriptblox.com/images/sb/122310270867133-1782897584098.webp","scriptblox":"https://scriptblox.com/images/script/122310270867133-1782897584098.webp"},"likeCount":3,"dislikeCount":4,"createdAt":"2026-07-01T09:19:44.126Z","updatedAt":"2026-07-01T09:19:44.126Z","lastBump":"2026-07-01T09:19:44.126Z","script":"-- // Read Description\n\nwarn(\"Start !!\")\n-- // --\nlocal Plrs = game:GetService(\"Players\")\nlocal LclPlr = Plrs.LocalPlayer\nlocal Cam = workspace.CurrentCamera\nlocal Mse = LclPlr:GetMouse()\n-- // --\nlocal function GetTgt()\n    local Tgt, Dist = nil, math.huge\n    for _, Plr in Plrs:GetPlayers()do\n        if Plr == LclPlr or not Plr.Character then\n            continue\n        end\n        local Head = Plr.Character:FindFirstChild('Head')\n        local Hum = Plr.Character:FindFirstChild('Humanoid')\n        if not Head or not Hum or Hum.Health <= 0 then\n            continue\n        end\n        local Pos, OnScr = Cam:WorldToViewportPoint(Head.Position)\n        if not OnScr then\n            continue\n        end\n        local D = (Vector2.new(Mse.X, Mse.Y) - Vector2.new(Pos.X, Pos.Y)).Magnitude\n        if D < Dist then\n            Dist = D\n            Tgt = Head\n        end\n    end\n    return Tgt\nend\n-- // --\nlocal RayFn\nfor _, Fn in getgc(true) do\n    if typeof(Fn) == \"function\" and debug.info(Fn, \"l\") == 3162 and #debug.getupvalues(Fn) == 4 then\n        RayFn = Fn\n        break\n    end\nend\nlocal ShootFn\nfor _, Fn in getgc(true) do\n    if typeof(Fn) == \"function\" and debug.info(Fn, \"l\") == 3225 then\n        for Key, Value in debug.getupvalues(Fn) do\n            if Value == RayFn then\n                ShootFn = Fn\n                break\n            end\n        end\n    end\n    if ShootFn then \n        break \n    end\nend\nlocal OldRay = debug.getupvalue(ShootFn, 21)\n-- // --\ndebug.setupvalue(ShootFn, 21, function(Spread, Origin)\n    local Tgt = GetTgt()\n    if Tgt then\n        return { Position = Tgt.Position, Normal = Vector3.new(0, 1, 0), Distance = 1, Instance = Tgt }\n    end\n    return OldRay(Spread, Origin)\nend)\n-- // --\nwarn(\"Done !!\")","features":"A silent aim for this game ig note you need to reexecute every round i cba to add a connection","tags":["Silent Aim","Source","Open Source","Duelist","Duelist  Pvp"],"discord":"","keyLink":"","owner":{"_id":"6852be67fe7b473b704f584b","username":"deaggilisspees","verified":true,"profilePicture":{"url":"https://media.kocakz.me/d54f2b22b9388edd343dc6adc8446d08e4edd138733180194c93a25edb89721c.webp","original":"https://scriptblox.com/images/photo/6852be67fe7b473b704f584b-1775076993087.pn