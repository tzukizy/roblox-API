{"slug":"Universal-Script-Forsaken-stam-change-51784","_id":"68ba4b3ce75c1ef620f04b95","title":"Forsaken stam change","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1757039420648.jpg","placeId":0},"features":"stam change","tags":[],"script":"\n]]\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function applyShitStamina()\n    local sprintingModule = require(game:GetService(\"ReplicatedStorage\").Systems.Character.Game.Sprinting)\n    if not sprintingModule.DefaultsSet then\n        sprintingModule.Init()\n    end\n    sprintingModule.StaminaLoss = 10\n    sprintingModule.StaminaGain = 20\n    sprintingModule.MinStamina = 0\n    sprintingModule.MaxStamina = 100\n    sprintingModule.Stamina = 100\n    sprintingModule.StaminaLossDisabled = false\n    if sprintingModule.__staminaChangedEvent then\n        sprintingModule.__staminaChangedEvent:Fire()\n    end\nend\n\nLocalPlayer.CharacterAdded:Connect(function()\n    task.wait(1)\n    applyShitStamina()\nend)\n\nRunService.RenderStepped:Wait()\napplyShitStamina()\n","owner":{"_id":"68a2813b8843cab44a5a4de4","username":"Bludlublues","verified":false,"profilePicture":"/images/photo/68a2813b8843cab44a5a4de4-1762639724370.jpg","status":"offline","id":"68a2813b8843cab44a5a4de4","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":5083,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1757039420648.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2025-09-05T02:30:20.673Z","executes":27,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68ba4b3ce75c1ef620f04b97","editBy":{"_id":"68a2813b8843cab44a5a4de4","username":"Bludlublues","status":"offline","id":"68a2813b8843cab44a5a4de4"},"message":"Create script","createdAt":"2025-09-05T02:30:20.677Z"}]