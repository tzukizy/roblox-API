{"slug":"Universal-Script-Forsaken-stam-change-51784","_id":"68ba4b3ce75c1ef620f04b95","title":"Forsaken stam change","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"stam change","tags":[],"script":"\n]]\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function applyShitStamina()\n    local sprintingModule = require(game:GetService(\"ReplicatedStorage\").Systems.Character.Game.Sprinting)\n    if not sprintingModule.DefaultsSet then\n        sprintingModule.Init()\n    end\n    sprintingModule.StaminaLoss = 10\n    sprintingModule.StaminaGain = 20\n    sprintingModule.MinStamina = 0\n    sprintingModule.MaxStamina = 100\n    sprintingModule.Stamina = 100\n    sprintingModule.StaminaLossDisabled = false\n    if sprintingModule.__staminaChangedEvent then\n        sprintingModule.__staminaChangedEvent:Fire()\n    end\nend\n\nLocalPlayer.CharacterAdded:Connect(function()\n    task.wait(1)\n    applyShitStamina()\nend)\n\nRunService.RenderStepped:Wait()\napplyShitStamina()\n","owner":{"_id":"68a2813b8843cab44a5a4de4","username":"Bludlublues","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/2d69c1cdf7d07567a826426e1c451fd16e0157ca2a688e5996d8fc6331863751.webp","original":"https://scriptblox.com/images/photo/68a2813b8843cab44a5a4de4-1762639724370.jpg"},"status":"offline","id":"68a2813b8843cab44a5a4de4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/2d69c1cdf7d07567a826426e1c451fd16e0157ca2a688e5996d8fc6331863751.webp","original":"https://scriptblox.com/images/photo/68a2813b8843cab44a5a4de4-1762639724370.jpg"}},"verified":false,"views":5087,"scriptType":"free","isUniversal":true,"isPatched"