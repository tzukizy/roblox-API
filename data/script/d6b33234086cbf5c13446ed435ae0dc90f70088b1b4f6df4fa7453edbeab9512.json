{"slug":"Project-Lazarus:-ZOMBIES-Lazarus-Freeze-Ammo-and-Insta-Kill-opensource-30708","_id":"67c3325785438d68782a4bb7","title":"Lazarus Freeze Ammo and Insta Kill opensource","game":{"_id":"67e5e1ffb360710ec3c77de8","gameId":443406476,"name":"Project Lazarus: 💀 ZOMBIES 💀","imageUrl":"/images/sb/rbx-d630380e57f4a958d5e9c9f7e22abb12-a7953e00cf68.png","placeId":443406476},"features":"Simple script if anyone needs","tags":[],"script":"-- infinite amoo detects ammo-related tables in the game, freezes their values\n_G.InfiniteAmmoEnabled = true\ntask.spawn(function()\n    local AmmoTables = {}\n    for i, v in next, getreg() do\n        if typeof(v) == \"table\" and v.Ammo then\n            table.insert(AmmoTables, v)\n        end\n    end\n\n    local CurrentAmmoValues = {}\n    for _, v in pairs(AmmoTables) do\n        table.insert(CurrentAmmoValues, {\n            Ammo = v.Ammo,\n            StoredAmmo = v.StoredAmmo,\n            MagSize = v.MagSize,\n            MaxAmmo = v.MaxAmmo\n        })\n    end\n\n    while _G.InfiniteAmmoEnabled do\n        for i, v in pairs(AmmoTables) do\n            v.Ammo = CurrentAmmoValues[i].Ammo\n            v.StoredAmmo = CurrentAmmoValues[i].StoredAmmo\n            v.MagSize = CurrentAmmoValues[i].MagSize\n            v.MaxAmmo = CurrentAmmoValues[i].MaxAmmo\n        end\n        task.wait(0.1)\n    end\nend)\n\n-- insta-kill script intercepts damage events, and sets all damage values to infinite\nOldNamecall = hookmetamethod(game, \"__namecall\", function(self, ...)   \n    local args = {...}  \n    if getnamecallmethod() == \"FireServer\" and self.Name == \"Damage\" then  \n        if args[1][\"Damage\"] > 0 then  \n            args[1][\"Damage\"] = math.huge  \n        end  \n    end  \n    return OldNamecall(self, unpack(args))  \nend)\n","owner":{"_id":"67b8b0b915d53f6220e26dd7","username":"ultimately_exultant","verified":false,"profilePicture":"/images/photo/67b8b0b915d53f6220e26dd7-1740157331939.jpg","status":"offline","id":"67b8b0b915d53f6220e26dd7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":7086,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-03-01T16:14:15.521Z","dislikeCount":4,"likeCount":1,"image":"/images/sb/443406476-1740845655483.png","executes":120,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c553cf","editBy":{"_id":"67b8b0b915d53f6220e26dd7","username":"ultimately_exultant","status":"offline","id":"67b8b0b915d53f6220e26dd7"},"message":"Create script","createdAt":"2025-03-27T19:13:22.047Z"}],"comments":[{"_id":"67c341a484b331e5d96cfd13","commentBy":{"_id":"66e8115b837f670aeb09ccf0","username":"cavemanstoopid","verified":false,"role":"user","profilePicture":"/images/photo/66e8115b837f670aeb09ccf0-1729860563655.png","createdAt":"2024-09-16T11:07:07.412Z","lastActive":"2026-06-21T11:35:13.296Z","status":"offline","id":"66e8115b837f670aeb09ccf0","topMilestone":{"key":"creator.first_script","tier":1}},"text":"infinite ammo doesnt work tho","createdAt":"2025-03-01T17:19:32.486Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"67c342f523a047167e6e45bc","commentBy":{"_id":"671fbbe31a53e8395b9e5b64","username":"trololoshka","verified":false,"role":"user","profilePicture":"/images/photo/671fbbe31a53e8395b9e5b64-1730133077015.png","createdAt":"2024-10-28T16:29:23.153Z","lastActive":"2026-01-16T17:37:47.409Z","status":"offline","id":"671fbbe31a53e8395b9e5b64"},"text":"solara trash doesnt works, xeno down, swift down, what executor should i use?(no emulators)","createdAt":"2025-03-01T17:25:09.965Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"67c3457ffb47df99eb8003eb","commentBy":{"_id":"67b8b0b915d53f6220e26dd7","username":"ultimately_exultant","verified":false,"role":"user","profilePicture":"/images/photo/67b8b0b915d53f6220e26dd7-1740157331939.jpg","createdAt":"2025-02-2