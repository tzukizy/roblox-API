umanoidStateType.Jumping)\n\tend\nend)\n","features":"cool duble jump script(change the value of maxJumps to the number of jumps you want)","tags":[],"discord":"","keyLink":"","owner":{"_id":"6941a23bccb38cc42792de79","username":"Timmaf","verified":false,"profilePicture":{"url":"https://media.kocakz.me/021d99a298e9920925969bb56821b51b90b2b65550549f8c3c7c9d522e45aa44.webp","original":"https://scriptblox.com/images/photo/6941a23bccb38cc42792de79-1766854191471.jpg"},"status":"offline","id":"6941a23bccb38cc42792de79","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/021d99a298e9920925969bb56821b51b90b2b65550549f8c3c7c9d522e45aa44.webp","original":"https://scriptblox.com/images/photo/6941a23bccb38cc42792de79-1766854191471.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:34:51.372Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"695a89c794780667af701f2e","editBy":{"_id":"6941a23bccb38cc42792de79","username":"Timmaf","status":"offline","id":"6941a23bccb38cc42792de79"},"message":"Create script","createdAt":"2026-01-04T15:39:51.068Z"}],"comments":[]}