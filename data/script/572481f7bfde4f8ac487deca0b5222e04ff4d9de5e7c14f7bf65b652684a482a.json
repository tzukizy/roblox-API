{"slug":"Prison-Life-AutoArrest-80922","_id":"69577167e947dde1d9c7ddd9","title":"AutoArrest","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":155615604},"features":"Automatically arrests anyone on the Criminals team\n\nPlease note: there IS a delay to prevent the anticheat from kicking you, and if you do use this script in your (script) or YouTube showcase, please credit me :)","tags":["prison life","prison","auto arrest","op","arrest"],"script":"--// AutoArrest\n--// by @._ stav on discord\n\nshared.autoArrest = true\n\nlocal cloneref = cloneref or function(obj)\n    return obj\nend\n\nlocal playersService = cloneref(game:GetService('Players'))\nlocal replicatedStorage = cloneref(game:GetService('ReplicatedStorage'))\nlocal lplr = playersService.LocalPlayer\n\nlocal function isAlive(plr)\n    return plr and plr.PrimaryPart and plr:FindFirstChildOfClass('Humanoid') and plr:FindFirstChildOfClass('Humanoid').Health > 0\nend\n\nlocal function getTool()\n    return lplr.Character and lplr.Character:FindFirstChildOfClass('Tool') or nil\nend\n\nlocal plr = nil\n\ntask.spawn(function()\n    repeat\n        plr = nil\n        for i,v in playersService:GetPlayers() do\n            if v == lplr then continue end\n\n            if isAlive(v.Character) and isAlive(lplr.Character) then\n                local attrib = v.Character:GetAttributes()\n\n                if v.Team.Name == 'Criminals' then\n                    plr = v\n                    break\n                end\n            end\n        end\n\n        task.spawn(function()\n            if plr ~= nil then\n                for i = 0.01, 8 do\n                    lplr.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0)\n                    replicatedStorage.Remotes.ArrestPlayer:InvokeServer(plr)\n                    replicatedStorage.Remotes.InteractWithItem:InvokeServer(plr.Character.HumanoidRootPart)\n                end\n            end\n        end)\n\n        task.wait(10)\n    until not shared.autoArrest\nend)","owner":{"_id":"66f7165f1c15c6b5c2ce9c9c","username":"stav","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/8f6e3d3cae1f0b5dfc6f50b7b8722d28a8520a47db4679951acb31de2338d445.webp","original":"https://scriptblox.com/images/photo/66f7165f1c15c6b5c2ce9c9c-1727469218331.png"},"status":"offline","id":"66f7165f1c15c6b5c2ce9c9c","profile":{"url":"https://cdn.kocakz.me/images/8f6e3d3cae1f0b5dfc6f50b7b8722d28a8520a47db4679951acb31de2338d445.webp","original":"https://scriptblox.com/images/photo/66f7165f1c15c6b5c2ce9c9c-1727469218331.png"}},"verified":false,"views":1847,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/4ea45f76f1a9a3d0bd4486da5eaaf956707b6df942fadc395e5577298d199fef.webp","original":"https://scriptblox.com/images/sb/rbx-9791754e51810f432383353580c40e3b-b99e8c5357cb.png","scriptblox":"https://scriptblox.com/images/script/rbx-9791754e51810f432383353580c40e3b-b99e8c5357cb.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-02T07:19:03.343Z","executes":45,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:32:59.833Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/4ea45f76f1a9a3d0bd4486da5eaaf956707b6df942fadc395e5577298d199fef.webp","original":"https://scriptblox.com/images/sb/rbx-9791754e51810f432383353580c40e3b-b99e8c5357cb.png","scriptblox":"https://scriptblox.com/images/script/rbx-9791754e51810f432383353580c40e3b-b99e8c5357cb.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69577167e947dde1d9c7dddc","editBy":{"_id":"66f7165f1c15c6