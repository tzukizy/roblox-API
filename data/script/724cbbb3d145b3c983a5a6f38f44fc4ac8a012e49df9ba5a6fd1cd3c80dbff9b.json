rstChild(\"RiotShieldPart\")\n\n            if not shield then\n                local part = Instance.new(\"Part\")\n                part.Name = \"RiotShieldPart\"\n                part.Size = Vector3.new(4,6,1)\n                part.CanCollide = true\n                part.Anchored = false\n                part.Parent = char\n\n                local weld = Instance.new(\"WeldConstraint\")\n                weld.Part0 = part\n                weld.Part1 = char:FindFirstChild(\"HumanoidRootPart\")\n                weld.Parent = part\n            end\n        end\n    end\nend)","features":"Swats don't have riot shield part.\nSwats using Riot Shield is hard","tags":[],"discord":"","keyLink":"","owner":{"_id":"68ea15b79c55f8d3c5cb2e52","username":"Zderonao","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dbade353cd513613cc0db8417ade95f7e34e5f44031ae848e178a56ede38343a.webp","original":"https://scriptblox.com/images/photo/68ea15b79c55f8d3c5cb2e52-1760171508731.jpg"},"status":"offline","id":"68ea15b79c55f8d3c5cb2e52","profile":{"url":"https://media.kocakz.me/dbade353cd513613cc0db8417ade95f7e34e5f44031ae848e178a56ede38343a.webp","original":"https://scriptblox.com/images/photo/68ea15b79c55f8d3c5cb2e52-1760171508731.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:34:08.900Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b52fc706c4bd6aa876541b","editBy":{"_id":"68ea15b79c55f8d3c5cb2e52","username":"Zderonao","status":"offline","id":"68ea15b79c55f8d3c5cb2e52"},"message":"Create script","createdAt":"2026-03-14T09:52:07.463Z"},{"_id":"69b530fb1526fb78b4a2f850","editBy":{"_id":"68ea15b79c55f8d3c5cb2e52","username":"Zderonao","status":"offline","id":"68ea15b79c55f8d3c5cb2e52"},"message":"Update script","createdAt":"2026-03-14T09:57:15.016Z"}],"comments":[]}