{"slug":"Time-Brawlers!-Anticheat-Disabler-17701","_id":"66d047eb443330bde0b7ed53","title":"Anticheat Disabler [USE NEW]","game":{"_id":"67e5e1ffb360710ec3c78a96","gameId":18815323071,"name":"[OCEAN 🌊] Time Brawlers!","imageUrl":"https://tr.rbxcdn.com/180DAY-df389cafc283ab7f0ea58a653b7b7d9a/500/280/Image/Jpeg/noFilter","placeId":18815323071},"features":"Disable the anticheat fully.\n\nMaking a full gui script with a lot of features soon be ready :)\n\n-- NOTE\nI posted a new script with a lot of features for this game, you can find it on my profile.","tags":[],"script":"local player = game.Players.LocalPlayer\n\nlocal function tool(parent)\n    for _, item in pairs(parent:GetChildren()) do\n        if item:IsA(\"Tool\") then\n            return item\n        end\n    end\n    return nil\nend\n\nlocal sword = tool(workspace:FindFirstChild(player.Name))\nlocal backpacksword = tool(player.Backpack)\nlocal feed = player.PlayerGui:FindFirstChild(\"Kill Feed\")\n\nif sword and sword:FindFirstChild(\"Anti-reach\") then\n    sword[\"Anti-reach\"]:Destroy()\n    print(\"Removed anti-reach\")\nend\n\nif backpacksword and backpacksword:FindFirstChild(\"Anti-reach\") then\n    backpacksword[\"Anti-reach\"]:Destroy()\n    print(\"Removed anti-reach\")\nend\n\nif feed and feed:FindFirstChild(\"Frame\") and feed.Frame:FindFirstChild(\"LocalScript\") then\n    feed.Frame.LocalScript:Destroy()\n    print(\"Removed reach kick\")\nend\n\nprint(\"Finished anticheat disabler!\")","owner":{"_id":"665b64ef70a0a42a69254eb3","username":"agreed","verified":true,"profilePicture":"/images/photo/665b64ef70a0a42a69254eb3-1732394080428.png","status":"offline","id":"665b64ef70a0a42a69254eb3","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"keyLink":"","views":51224,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-08-29T10:05:31.532Z","dislikeCount":0,"likeCount":4,"image":"https://tr.rbxcdn.com/df389cafc283ab7f0ea58a653b7b7d9a/500