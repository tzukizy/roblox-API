nction walk(node)\n    if node:IsA(\"TextLabel\") or node:IsA(\"TextButton\") or node:IsA(\"TextBox\") then\n        node.Text = ci_replace(node.Text, \"report\", replacement())\n    end\n\n    for _, c in ipairs(node:GetChildren()) do\n        walk(c)\n    end\nend\n\ncoroutine.wrap(function()\n    while true do\n        walk(pgui)\n        pcall(function() walk(coregui) end)\n        task.wait(0.5)\n    end\nend)()","features":"glory to nettanyahu and aipac and israel and bibi","tags":["israel"],"discord":"","keyLink":"","owner":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dff992f3b597b4c5a71ec2a7da6f4ebcce82c9821430857ce7612e65e998ec53.webp","original":"https://scriptblox.com/images/photo/64e42935e38cad1498824223-1779702017984.jpg"},"lvl":12,"status":"offline","id":"64e42935e38cad1498824223","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/dff992f3b597b4c5a71ec2a7da6f4ebcce82c9821430857ce7612e65e998ec53.webp","original":"https://scriptblox.com/images/photo/64e42935e38cad1498824223-1779702017984.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:02:32.224Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69ccabb1cb300698d238aaa5","editBy":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","status":"offline","id":"64e42935e38cad1498824223"},"message":"Create script","createdAt":"2026-04-01T05:22:57.617Z"},{"_id":"6a6ad1d8d40ec36fd30e7c48","editBy":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","status":"offline","id":"64e42935e38cad1498824223"},"message":"Update script","createdAt":"2026-07-30T04:23:52.885Z"}],"comments":[{"_id":"69ccadc0de5e196062b928fd","commentBy":{"_id":"69c7c46e6b777adfd872f40f","username":"peako","verified":false