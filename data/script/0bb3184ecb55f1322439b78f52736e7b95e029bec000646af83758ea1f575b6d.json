{"_id":"68293ed201d0755c3a4fd27a","title":"Kill All","game":{"_id":"68293ed201d0755c3a4fd272","gameId":139522132549152,"name":"Random Mafia Shooter","imageUrl":{"url":"https://media.kocakz.me/cbe88d5c4de2914920e1454ae0c10a839cb4a978728deef5034e0974680e9e88.webp","original":"https://tr.rbxcdn.com/180DAY-6e35ca94042e372f5edf61328ec2275d/150/150/Image/Png/noFilter"},"slug":"139522132549152-random-mafia-shooter","path":"/game/139522132549152-random-mafia-shooter","thumbnail":{"url":"https://media.kocakz.me/cbe88d5c4de2914920e1454ae0c10a839cb4a978728deef5034e0974680e9e88.webp","original":"https://tr.rbxcdn.com/180DAY-6e35ca94042e372f5edf61328ec2275d/150/150/Image/Png/noFilter"},"placeId":139522132549152},"slug":"Random-Mafia-Shooter-RMG-Kill-All-40131","verified":false,"key":false,"keyless":false,"views":17010,"executes":1201,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/1992fbdf313efbebd54828d78261c54b2dba3df050ffdbe2c6e7d06cadd962df.webp","original":"https://scriptblox.com/images/sb/139522132549152-1747533522868.webp","scriptblox":"https://scriptblox.com/images/script/139522132549152-1747533522868.webp"},"thumbnail":{"url":"https://media.kocakz.me/1992fbdf313efbebd54828d78261c54b2dba3df050ffdbe2c6e7d06cadd962df.webp","original":"https://scriptblox.com/images/sb/139522132549152-1747533522868.webp","scriptblox":"https://scriptblox.com/images/script/139522132549152-1747533522868.webp"},"likeCount":2,"dislikeCount":2,"createdAt":"2025-05-18T01:58:42.919Z","updatedAt":"2025-05-18T01:58:42.919Z","lastBump":"2025-05-18T01:58:42.919Z","script":"-- variables\nlocal run_service = game:GetService(\"RunService\");\nlocal players = game:GetService(\"Players\");\nlocal local_player = players.LocalPlayer;\n\n-- script variables\nlocal remote;\n\n-- functions\nlocal kill_player = function(player_humanoid)\n    -- print(\"Killed:\", player_humanoid.DisplayName);\n    remote:InvokeServer(player_humanoid, math.huge);\nend;\n\nlocal start_mafia_boss = function(player)\n    if (player == local_player or not local_player.Character) then\n        return;\n    end;\n\n    print(\"added:\", player);\n\n    local npc_mode = player.Parent.Name == \"Civilians\";\n\n    task.spawn(function()\n        while task.wait(1) do\n            if (not remote) then\n                return;\n            end;\n\n            local player_character = npc_mode and player or player.Character;\n            if (not player_character) then\n                return;\n            end;\n\n            local humanoid = player_character:FindFirstChild(\"Humanoid\");\n            if (not humanoid) then\n                return;\n            end;\n\n            kill_player(humanoid);\n        end;\n    end);\nend;\n\n-- grab remote\nremote = local_player.Character and local_player.Character.Weapons.Primary.Gun.GunScript.DealDamage;\n\n-- kill all players\nfor _,v in players:GetPlayers() do\n    start_mafia_boss(v);\nend;\n\nplayers.PlayerAdded:Connect(start_mafia_boss);\n\n-- kill all npcs\nfor _,v in workspace.Map.Civilians:GetChildren() do\n    start_mafia_boss(v);\nend;\n\nworkspace.Map.Civilians.ChildAdded:Connect(start_mafia_boss);\n\n-- connections\nlocal_player.CharacterAdded:Connect(function(v)\n    repeat task.wait(.1) until v:FindFirstChild(\"Weapons\");\n    remote = v.Weapons.Primary.Gun.GunScript.DealDamage;\nend);","features":"Just a simple Kill All Players / Civilians. Open Source for learning purposes.","tags":["kill script","random mafia shooter","open source","opensource","free"],"discord":"","keyLink":"","owner":{"_id":"6340eade631041248b2afc4b","username":"Efial","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6340eade631041248b2afc4b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"di