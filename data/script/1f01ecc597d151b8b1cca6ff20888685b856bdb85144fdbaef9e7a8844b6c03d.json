{"slug":"Getting-Over-itRemastered-it-Remastered-18057","_id":"66ddf8a73b674b9907c583a7","title":"0ver  it  Remastered","game":{"_id":"67e5e1ffb360710ec3c7839a","gameId":12452509832,"name":"Getting Over it[Remastered]🔨","imageUrl":"/images/sb/rbx-8e4d1f02fcc511b9ce1da1608f9cec19-f2b168ee342e.png","placeId":12452509832},"features":"Makes a part at your slight below cursors Location to make the game easier and deletes the previous one so they dont stack up [fixed]","tags":[],"script":"local mouse = game.Players.LocalPlayer:GetMouse()\nlocal player = game.Players.LocalPlayer\nlocal previousPart\n\nmouse.Button1Down:Connect(function()\n    if previousPart then\n        previousPart:Destroy()\n    end\n\n    local instpart = Instance.new(\"Part\")\n    instpart.Parent = game.Workspace\n    instpart.Size = Vector3.new(4, 1, 6.2) \n    instpart.Anchored = true \n\n    instpart.CFrame = CFrame.new(mouse.Hit.Position - Vector3.new(0, 3, 0))\n\n    previousPart = instpart\nend)\n--made by wafzthkin :)","owner":{"_id":"66c746b1394af5d906df4f57","username":"wafzthkin","verified":false,"profilePicture":"/images/photo/66c746b1394af5d906df4f57-1725215997583.png","status":"offline","id":"66c746b1394af5d906df4f57","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":66162,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-09-08T19:19:03.552Z","dislikeCount":0,"likeCount":2,"image":"/images/sb/12452509832-1725823705510.png","executes":234,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cb73","editBy":{"_id":"66c746b1394af5d906df4f57","username":"wafzthkin","status":"offline","id":"66c746b1394af5d906df4f57"},"message":"Create script","createdAt":"2024-09-08T20:03:08.599Z"},{"_id":"67e5e1e6b360710ec3c52027","editBy":{"_id":"66c746b1394af5d906df4f57","username":"wafzthkin","status":"offline","id":"66c746b1394af5d906df4f57"},"message