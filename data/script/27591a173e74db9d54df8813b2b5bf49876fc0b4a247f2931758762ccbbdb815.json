{"slug":"Universal-Script-Xeuk-subplace-finder-lets-you-copy-it-and-tp-21958","_id":"672feaebff36aa8fefebd0a5","title":"Xeuk subplace finder lets you copy it and tp","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Lets you copy and teleport to subplaces within the game","tags":[],"script":"getgenv().gethui = function() return game.CoreGui.RobloxGui end -- why not?\ntask.wait(0.5)\nlocal OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()\nlocal Window = OrionLib:MakeWindow({Name = \"Xeuk Subplace Finder\", HidePremium = false, SaveConfig = true, ConfigFolder = \"SubPlaces\"})\nlocal Tab = Window:MakeTab({Name = \"Main\", Icon = \"rbxassetid://4483345998\", PremiumOnly = false})\nlocal selected\nlocal Dropdown = Tab:AddDropdown({\n    Name = \"Select Place\",\n    Default = nil,\n    Options = {},\n    Callback = function(Value) \n        selected = Value:match(\"%(ID: (%d+)%)\")\n    end\n})\n\nTab:AddButton({\n    Name = \"Teleport to Selected Game\",\n    Callback = function() \n        if selected then\n            game:GetService(\"TeleportService\"):Teleport(tonumber(selected), game.Players.LocalPlayer)\n        end\n    end\n})\n\nTab:AddButton({\n    Name = \"Copy Selected Game ID\",\n    Callback = function()\n        if selected then\n            setclipboard(selected)\n            print(\"Copied Place ID: \" .. selected)\n        else\n            print(\"No Place ID selected to copy.\")\n        end\n    end\n})\n\nlocal pages = game:GetService(\"AssetService\"):GetGamePlacesAsync()\nlocal places = {}\nwhile task.wait() do\n    for _,place in pairs(pages:GetCurrentPage()) do\n        table.insert(places, place.Name .. \" (ID: \" .. tostring(place.PlaceId) .. \")\")\n    end\n    if pages.IsFinished then break end\n    pages:AdvanceToNextPageAsync()\nend\nDropdown:Refresh(places, true)\nOrionLib:Init()","owner":{"_id":"670aa956fcef0676d15fa7ba","username":"Jkkgkgkgkg","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"670aa956fcef0676d15fa7ba","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":5884,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-11-09T23:06:19.783Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://media.kocakz.me/d97baf614d1097181cf3ed08a4f380b18ad472ea515c9f4858ec552b940f739a.webp","original":"https://scriptblox.com/images/sb/7086464-1731193579758.png","scriptblox":"https://scriptblox.com/images/script/7086464-1731193579758.png"},"executes":307,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:15:11.032Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/d97baf614d1097181cf3ed08a4f380b18ad472ea515c9f4858ec552b940f739a.webp","original":"https://scriptblox.com/images/sb/7086464-1731193579758.png","scriptblox":"https://scriptblox.com/images/script/7086464-1731193579758.png"},"changelog":[{"_id":"67e5e1e6b360710ec3c52eb6","editBy":{"_id":"670aa956fcef0676d15fa7ba","username":"Jkkgkgkgkg","status":"offline","id":"670aa956fcef0676d15fa7ba"},"message":"Create script","createdAt":"2025-03-27T18:16:21.158Z"}],"comments":[{"_id":"6730049aeba08e53ffb42701","commentBy":{"_id":"672fefb9a91fd7e0d882ac87","username":"Tigo","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-11-09T23:26:49.020Z","lastActive":"2025-04-02T05:07:42.089Z",