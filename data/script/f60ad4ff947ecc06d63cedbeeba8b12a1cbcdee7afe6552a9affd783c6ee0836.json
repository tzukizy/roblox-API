{"_id":"624f5ba750cb29c1929c87f5","title":"hitbox (*FIXED*)","game":{"_id":"67e5e1ffb360710ec3c780f4","gameId":7167319176,"name":"😈Chicago Remastered","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"7167319176-chicago-remastered","path":"/game/7167319176-chicago-remastered","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":7167319176},"slug":"JEWELRY!-Chicago-Remastered-hitbox-(*FIXED*)-1752","verified":false,"key":false,"keyless":false,"views":6781,"executes":134,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/3b9daa872e506874898cec4898680cc6/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/3b9daa872e506874898cec4898680cc6/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/3b9daa872e506874898cec4898680cc6/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/3b9daa872e506874898cec4898680cc6/500/280/Image/Jpeg"},"likeCount":3,"dislikeCount":0,"createdAt":"2022-04-07T21:46:15.635Z","updatedAt":"2022-04-07T21:46:15.635Z","lastBump":"2022-04-07T21:46:15.635Z","script":"-- loop\ngame:GetService(\"RunService\").Stepped:Connect(function()\n    -- gets all players in the server\n    for _, player in next, game:GetService(\"Players\"):GetPlayers() do\n        -- checks if the player found was not the local player, so the local player doesnt get his hitbox extended\n        if player ~= game:GetService(\"Players\").LocalPlayer then\n            -- finds humanoid root part, then changes transparecy and can collide so you can walk through the hitbox and it wont be wonky\n            if player.Character:FindFirstChild(\"HumanoidRootPart\") then\n                player.Character[\"HumanoidRootPart\"].CanCollide = false\n                player.Character[\"HumanoidRootPart\"].Transparency = 0.5\n            end\n            \n            -- changes the humanoidrootpart size (basically the main code)\n            if player.Character[\"HumanoidRootPart\"].Size ~= Vector3.new(20, 20, 20) then\n                player.Character[\"HumanoidRootPart\"].Size = Vector3.new(20, 20, 20)\n            end\n        end\n    end\nend)","features":"Fixed","tags":[],"discord":"","keyLink":"","owner":{"_id":"6216d25c4fc28ba03e2ff312","username":"YTOPunisher","verified":false,"profilePicture":{"url":"https://media.kocakz.me/76f3ce49bc54b5e194f413eebd4693b69ca4a174766fe32e13fa23c1bb0ad283.webp","original":"https://scriptblox.com/images/photo/6216d25c4fc28ba03e2ff312-1702097891016.jpg"},"status":"offline","id":"6216d25c4fc28ba03e2ff312","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/76f3ce49bc54b5e194f413eebd4693b69ca4a174766fe32e13fa23c1bb0ad283.webp","original":"https://scriptblox.com/images/photo/6216d25c4fc28ba03e2ff312-1702097891016.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:15:50.719Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4ea78","editBy":{"_id":"6216d25c4fc28ba03e2ff312","username":"YTOPunisher","status":"offline","id":"6216d25c4fc28ba03e2ff312"},"message":"Create script","createdAt":"2025-03-27T23:04:59.825Z"}],"comments":[{"_id":"6250ba1484efe1ef4ebb5c3e","commentBy":{"_id":"624e70cb36a80e2ac07c02f6","username":"okrobux10","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-04-07T05:04:11.332Z","lastActive":"2022-08-20T06:39:00.663Z","status":"offline","id":"624e70cb36a80e2ac07c02f6","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"nice script goodjob!","createdAt":"2022-04-08T22:41:24.696Z