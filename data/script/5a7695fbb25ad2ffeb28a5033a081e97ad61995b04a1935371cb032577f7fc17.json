{"slug":"something-evil-will-happen-Simple-infinite-stamina-136009","_id":"69b044e511afc6c1a5c546e1","title":"Simple infinite stamina (WORKS)","game":{"_id":"67e5e1ffb360710ec3c77d53","gameId":16991287194,"name":"[🔮] 2omething evil will happen","imageUrl":"/images/sb/rbx-6647b541b6be9f93eb8dd6b3e9461716-6371879ebbe2.png","placeId":16991287194},"features":"Open sourced","tags":["InfStamina","InfiniteStamina","Sewh","sewh","something evil will happen"],"script":"local rs = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal stamina = require(rs.Resources.Client.MovementHandler.Stamina)\nlocal ev = require(rs.Communication.EventHandler)\nlocal ann = require(Players.LocalPlayer:WaitForChild(\"PlayerScripts\").UiHandler.Modules.Notifications.Logic.Announcement)\nlocal cd = false\n\ntask.wait(3)\ntask.spawn(function()\n\tann.Display(\"Thanks for using my script! Your stamina will refill at 5.<br/>If you have any suggestions comment it on my scriptblox.\", \"the script creator or smth\")\nend)\n\ntask.spawn(function()\n\twhile true do\n\t\ttask.wait(0.1)\n\t\tif stamina.Get() <= 5 and not cd then -- change the 5 to the number u want it to refill at \n\t\t\tcd = true\n\t\t\tstamina.DrainStamina(-100, 0, true)\n\t\t\tstamina.DestroyDrainer(\"BaseDrain\")\n\t\t\tev:FireSelf(\"DisplayPopup\", \"Saved\", \"Stamina refilled!\") -- comment this part out if u dont want a notification\n\t\t\ttask.wait(1)\n\t\t\tcd = false\n\t\tend\n\tend\nend)","owner":{"_id":"66d2fcd2223bfe505e3b5497","username":"tickingclock","verified":false,"profilePicture":"/images/photo/66d2fcd2223bfe505e3b5497-1791382219198.jpg","status":"offline","id":"66d2fcd2223bfe505e3b5497","leaderboard":{"tag":{"kind":"month","rank":17,"period":"month","metric":"likes","value":12}},"topMilestone":{"key":"creator.streak","tier":7}},"verified":false,"views":2640,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-55450b0fc286c45f3