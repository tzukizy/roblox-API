 closest = math.rad(fov);\n        local origin, direction = value.Position, value.LookVector;\n        for _, player in ipairs(Players:GetPlayers()) do\n            local character, team = player.Character, player.Team;\n            if character and (not team or team ~= localPlayer.Team) then\n                local cframe = CFrame.new(origin, character[hitpart].Position) * rotation;\n                local angle = math.acos(direction:Dot(cframe.LookVector));\n                if angle < closest then\n                    value = cframe;\n                    closest = angle;\n                end\n            end\n        end\n    end\n    old(self, index, value);\nend);","features":"silent aim","tags":[],"discord":"","keyLink":"","owner":{"_id":"6696b55845510a88dbaa3fae","username":"cqwe5","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6696b55845510a88dbaa3fae","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:08:14.898Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54fe8","editBy":{"_id":"6696b55845510a88dbaa3fae","username":"cqwe5","status":"offline","id":"6696b55845510a88dbaa3fae"},"message":"Create script","createdAt":"2025-03-27T22:55:31.180Z"}],"comments":[{"_id":"67b74a8c76f320547225139c","commentBy":{"_id":"66e48d5e8476a2b9b10b6349","username":"iserical","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-09-13T19:07:10.123Z","lastActive":"2025-12-13T01:40:42.478Z","status":"offline","id":"66e48d5e8476a2b9b10b6349","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Not sure if this works","cr