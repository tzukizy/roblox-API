{"slug":"NEW-MAPS!-Energy-Assault-FPS-silent-aim-29843","_id":"67b73ce5e5179f4f2e5a9052","title":"silent aim","game":{"_id":"67e5e1ffb360710ec3c782ba","gameId":6172932937,"name":"Energy Assault FPS","imageUrl":"/images/sb/rbx-670310a742f6711de3ef702079f6d3cb-0bbf48257577.png","placeId":6172932937},"features":"silent aim","tags":[],"script":"\nlocal fov = fov or 180;\nlocal hitpart = hitpart or \"Head\";\n\n\nlocal Players = game:GetService(\"Players\");\nlocal localPlayer = Players.LocalPlayer;\nlocal rotation = CFrame.Angles(0, math.pi*0.5, 0);\n\n\nlocal old;\nold = hookmetamethod(workspace, \"__newindex\", function(self, index, value)\n    if index == \"CFrame\" and debug.info(3, \"n\") == \"firebullet\" then\n        local closest = math.rad(fov);\n        local origin, direction = value.Position, value.LookVector;\n        for _, player in ipairs(Players:GetPlayers()) do\n            local character, team = player.Character, player.Team;\n            if character and (not team or team ~= localPlayer.Team) then\n                local cframe = CFrame.new(origin, character[hitpart].Position) * rotation;\n                local angle = math.acos(direction:Dot(cframe.LookVector));\n                if angle < closest then\n                    value = cframe;\n                    closest = angle;\n                end\n            end\n        end\n    end\n    old(self, index, value);\nend);","owner":{"_id":"6696b55845510a88dbaa3fae","username":"cqwe5","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6696b55845510a88dbaa3fae"},"verified":false,"keyLink":"","views":12063,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-20T14:32:05.116Z","dislikeCount":2,"likeCount":3,"image":"https://tr.rbxcdn.com/180DAY-4b14c58449658ef1906f7a0ab155da64/500/280/Image/Jpeg/noFilter","executes":651,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6