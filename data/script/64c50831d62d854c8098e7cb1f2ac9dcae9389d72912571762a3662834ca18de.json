{"slug":"Universal-Script-Untitled-Hub-Testing-28017","_id":"679c12da19686d4b13dafa30","title":"Untitled Hub Testing","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"this is a open source hub for beginners, ignore all comments, their there due to the fact that when i was using the UI library it came with them and i don't really need to remove them, stuff in their may seem generated by AI, it i not, sure I used AI once to make the spinning thing, but it was because I simply didn't know how exactly to make that, enjoy!","tags":[],"script":"\n\nlocal Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua\"))()\n\nlocal Window = Library.CreateLib(game.Players.LocalPlayer.Name .. \"'s Hub\", \"Synapse\")\n\nlocal Mod = Window:NewTab(\"Player Modifications\")\n\nlocal Section1 = Mod:NewSection(\"Simple\")\n\nSection1:NewSlider(\"Speed\", \"Changes your walkspeed\", 1000, 0, function(s) -- 500 (MaxValue) | 0 (MinValue)\n    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = s\nend)\n\nSection1:NewSlider(\"Jump\", \"Changes your jumppower\", 1000, 0, function(s) -- 500 (MaxValue) | 0 (MinValue)\n    game.Players.LocalPlayer.Character.Humanoid.JumpPower = s\nend)\n\nSection1:NewSlider(\"Gravity\", \"Changes your Gravity\", 1000, 0, function(s) -- 500 (MaxValue) | 0 (MinValue)\n    workspace.Gravity = s\nend)\n\nSection1:NewButton(\"Reset Gravity\", \"Reset Gravity in the Workspace\", function()\n    workspace.Gravity = 196.2\nend)\n\nSection1:NewButton(\"Reset Jump\", \"Reset JumpPower to the Humanoid of \" .. game.Players.LocalPlayer.Name, function()\n    game.Players.LocalPlayer.Character.Humanoid.JumpPower = 50\nend)\n\nSection1:NewButton(\"Reset Speed\", \"Reset WalkSpeed to the Humanoid of \" .. game.Players.LocalPlayer.Name, function()\n    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16\nend)\n\nSection1:NewSlider(\"Spin Speed\", \"Adjust rotation speed\", 50, 0, function(s) spinSpeed = s end) \n\nspawn(function() \n    while task.wait(0.01) do  -- Faster updates for smoother rotation\n        local char = game.Players.LocalPlayer.Character\n        if char and char:FindFirstChild(\"HumanoidRootPart\") then\n            char.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad((spinSpeed or 0) * 0.1), 0)\n        end\n    end\nend)\n\nSection1:NewButton(\"Fly Gui\", \"Runs the fly gui loadstring i mean buddy there is no point in checking here\", function()\n    loadstring(game:HttpGet(\"https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt\"))()\nend)\n\n\nlocal Con = Window:NewTab(\"Configs\")\n\nlocal Section2 = Con:NewSection(\"Configurations\")\n\nSection2:NewKeybind(\"KeybindText\", \"KeybindInfo\", Enum.KeyCode.T, function()\n\tLibrary:ToggleUI()\nend)\n\nSection2:NewLabel(\"Hello \" .. game.Players.LocalPlayer.Name)\n\nSection2:NewLabel(\"Press the X button \" .. game.Players.LocalPlayer.Name .. \" if you wanna unload\" )\n\n\n\n","owner":{"_id":"67915ab4bef4a15ae7b1c4e7","username":"French","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/2575c51a98465f9a92b6fdca2996d211ac7cf07601f74e0b475479c1007903e5.webp","original":"https://scriptblox.com/images/photo/67915ab4bef4a15ae7b1c4e7-1757794394789.png"},"status":"offline","id":"67915ab4bef4a15ae7b1c4e7","profile":{"url":"https://cdn.kocakz.me/images/2575c51a98465f9a92b6fdca2996d211ac7cf07601f74e0b475479c1007903e5.webp","original":"https://scriptblox.com/images/photo/67915ab4bef4a15ae7b1c4e7-1757794394789.png"}},"verified":false,"keyLink":"","views":4211,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-01-31T00:01:30.203Z","dislikeCount":0,"likeCount":3,"image":{"url":"https://cdn.kocakz.me/images/9a43dfb83d1a8d5