{"slug":"Universal-Script-Raknet-Desync-224931","_id":"6a895d01d7413985f2fb7e64","title":"Raknet Desync","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1787387137807.png","placeId":0},"features":"Latest Raknet Desync (FIX)","tags":["raknet","desync","volt"],"script":"local uis = game:GetService(\"UserInputService\")\nlocal hooked = false\nlocal toggle = Enum.KeyCode.U -- Keybind is U Press U To Activate Desync and Turn it off\n\nlocal function rakhook(packet)\n    if packet.PacketId == 0xA1 then\n        local buf = packet.AsBuffer\n        buffer.writeu32(buf, 1, 0xFFFFFFFF)\n        packet:SetData(buf)\n    end\nend\n\nuis.InputBegan:Connect(function(obj)\n    if obj.KeyCode ~= toggle then return end\n\n    if hooked then\n        raknet.remove_send_hook(rakhook)\n    else\n        raknet.add_send_hook(rakhook)\n    end\n\n    hooked = not hooked\nend)","owner":{"_id":"69194b03b74d0b541cbd1642","username":"sasadsds","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69194b03b74d0b541cbd1642","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":370,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1787387137807.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-08-22T08:25:37.823Z","executes":2700,"keyless":false,"editBy":{"_id":"69194b03b74d0b541cbd1642","username":"sasadsds","status":"offline","id":"69194b03b74d0b541cbd1642"},"keyLink":"","liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a895d01d7413985f2fb7e66","editBy":{"_id":"69194b03b74d0b541cbd1642","username":"sasadsds","status":"offline","id":"69194b03b74d0b541cbd1642"},"message":"Create script","createdAt":"2026-08-22T08:25:37.826Z"},{"_id":"6aa29a396139410ad13ad307","editBy":{"_id":"69194b03b74d0b541cbd1642","username":"sasadsds","status":"offline","id":"69194b03b74d0b541cbd1642"},"message":"Update script","createdAt":"2026-09-10T11:53:29.455Z"}],"comments":[]}