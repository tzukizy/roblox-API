ndex(Object, Property)\nend))\n\nLighting:GetPropertyChangedSignal(\"Ambient\"):Connect(function()\n    local Current = OldIndex(Lighting, \"Ambient\")\n\n    if Current ~= SpoofColor then\n        Ambience = Current\n    end\nend)\n\nLighting.Ambient = SpoofColor\n\n-- print(Lighting.Ambient)\n\t-- Returns the original game value","features":"Changes Ambience and bypasses detections\n\nCould make nights brigher","tags":["fullbright","bypass"],"discord":"","keyLink":"","owner":{"_id":"69e9b662dc390fd8755053e8","username":"xyvk","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69e9b662dc390fd8755053e8","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:53:31.600Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a37fcfdb1b6d471663b06c1","editBy":{"_id":"69e9b662dc390fd8755053e8","username":"xyvk","status":"offline","id":"69e9b662dc390fd8755053e8"},"message":"Create script","createdAt":"2026-06-21T15:02:21.221Z"},{"_id":"6a6a61d5b07007f2c49970c2","editBy":{"_id":"69e9b662dc390fd8755053e8","username":"xyvk","status":"offline","id":"69e9b662dc390fd8755053e8"},"message":"Update script","createdAt":"2026-07-29T20:25:57.194Z"}],"comments":[]}