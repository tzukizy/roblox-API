{"_id":"668e2fd70796a797e11f0e83","title":"Trash autofarm FOR NPCS","game":{"_id":"67e5e1ffb360710ec3c78308","gameId":7446466648,"name":"[🔥UPDATE 14] Dragon Ball: Legendary Forces","imageUrl":{"url":"https://media.kocakz.me/e901282fe9350dfdd311a1df56ed9747273811c105f83714345d03215a081267.webp","original":"https://tr.rbxcdn.com/180DAY-4d4e2a6a9229385978f7083ffece76fc/150/150/Image/Png/noFilter"},"slug":"7446466648-dragon-ball-legendary-forces","path":"/game/7446466648-dragon-ball-legendary-forces","thumbnail":{"url":"https://media.kocakz.me/e901282fe9350dfdd311a1df56ed9747273811c105f83714345d03215a081267.webp","original":"https://tr.rbxcdn.com/180DAY-4d4e2a6a9229385978f7083ffece76fc/150/150/Image/Png/noFilter"},"placeId":7446466648},"slug":"EVENT-Dragon-Ball:-Legendary-Forces-Trash-autofarm-FOR-NPCS-15471","verified":false,"key":false,"keyless":false,"views":20437,"executes":278,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d6750fe70c039678659f0eb427e4d855142fefa01468893887cf7ac0f33e27b4.webp","original":"https://scriptblox.com/images/sb/7446466648-1720594391543.png","scriptblox":"https://scriptblox.com/images/script/7446466648-1720594391543.png"},"thumbnail":{"url":"https://media.kocakz.me/d6750fe70c039678659f0eb427e4d855142fefa01468893887cf7ac0f33e27b4.webp","original":"https://scriptblox.com/images/sb/7446466648-1720594391543.png","scriptblox":"https://scriptblox.com/images/script/7446466648-1720594391543.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-07-10T06:53:11.576Z","updatedAt":"2024-07-10T06:53:11.576Z","lastBump":"2024-07-10T06:53:11.576Z","script":"\ngetgenv().AutoFarm = true -- Determinds if you want it off or on\ngetgenv().Npc = {\"Npc1\",\"Npc2\",\"Npc3\",\"Npc4\",\"Npc5\"} -- List of Npcs. [So it goes in array it will solo all the npcs from the first named one to the last] -- Names can be shortened but be spesific\n\ngetgenv().Position = Vector3.new(0,nil,5) -- x y z but dont touch \"nil\" cause it does nothing, [5] is what determinds how far away behind npc. The lower value the closer to the npc max [1].\ngetgenv().OffsetY = -1.5 -- Adjust this instead of the \"nil\".\n\ngetgenv().MethodX = \"Tween\" -- MethodXs: [\"Tween\",\"Teleport\"].\ngetgenv().TweenDurationX = 0.15 -- 0.25 Recommended, The higher the value the more slower it becomes, 0.1 is almost like teleportion.\n\ngetgenv().Press = function(v)\n    return game:GetService(\"VirtualInputManager\"):SendKeyEvent(true, v, false, game);\nend\n\ngetgenv().Unpress = function(v)\n    return game:GetService(\"VirtualInputManager\"):SendKeyEvent(false, v, false, game);\nend\n\ngetgenv().Attacking = function()\n    game:GetService(\"VirtualInputManager\"):SendMouseButtonEvent(0, 0, 0, true, game, 1) -- Auto clicker [Better to use a remote event]\n    -- Your Attacking remote here or the things I listed below: [You can also put multiple buttons to press to do multiple attacks at once]\nend\n\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/Lvl9999/AutoFarmer/main/Universal\"))();","features":"Not that good auto farm you need to change the names to the npcs and add the combat remote yourself This isn't my autofarm just one that works isn't the best but it works if you think it's that bad go and make your own autofarm this is just one that works and it works really good on the MUI chamber you can get 100% mui in 15 minutes","tags":[],"discord":"","keyLink":"","owner":{"_id":"6682740e2cd189052e6105d2","username":"Bing","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6682740e2cd189052e6105d2","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"