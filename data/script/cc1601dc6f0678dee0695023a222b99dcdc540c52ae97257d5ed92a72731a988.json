acter.HumanoidRootPart\n    for i, v in pairs(f:GetDescendants()) do\n        if v:IsA(\"RayValue\") and v.Name == \"Mine\" then\n            if v:FindFirstChild(\"Flagged\") then return end\n            local args = {\n                v.Parent\n            }\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Events\"):WaitForChild(\"Remotes\"):WaitForChild(\"AddFlag\")\n                :FireServer(unpack(args))\n        end\n    end\n\n    for i, v in pairs(f:GetChildren()) do\n        if v.Name == \"Unactivated\" and not v:FindFirstChild(\"Flagged\") then\n            if v.FindFirstChild(\"Mine\") then return end\n            firetouchinterest(hrp, v.Activator, 0)\n        end\n    end\nend)\n","features":"hi join my discord for funsies and more random stuff","tags":[],"discord":"https://discord.gg/SW7km6m3pF","keyLink":"","owner":{"_id":"660aed3f3ac90cfbaaa0ef0f","username":"tiam","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d4fac5d01733ece9f2b1571cf0fc05534c14a2defe143e16cc8ada5462600635.webp","original":"https://scriptblox.com/images/photo/660aed3f3ac90cfbaaa0ef0f-1717016771142.png"},"status":"offline","id":"660aed3f3ac90cfbaaa0ef0f","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/d4fac5d01733ece9f2b1571cf0fc05534c14a2defe143e16cc8ada5462600635.webp","original":"https://scriptblox.com/images/photo/660aed3f3ac90cfbaaa0ef0f-1717016771142.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:33:41.097Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"696f4721b75108960a1a1470","editBy":{"_id":"660aed3f3ac90cfbaaa0ef0f","username":"tiam","status":"offline","id":"660aed3f3ac90cfbaaa0ef0f"},"message":"Create script","createdAt":"2026-01-20T09:13:05.411Z"},{"_id":"696f49531282876fea122230","editBy":