{"slug":"ROGUESWEEPER-auto-flag-and-play-wtvr-88250","_id":"696f4721b75108960a1a146d","title":"auto flag and play wtvr","game":{"_id":"696e0d4b89eac87a1492b8e7","gameId":106370203481422,"name":"// ROGUESWEEPER","imageUrl":"/images/sb/rbx-c27f1aba2a209b3db676f106ab642330-52daa9fc8976.png","placeId":106370203481422},"features":"hi join my discord for funsies and more random stuff","tags":[],"script":"-- join my discord ! https://discord.gg/SW7km6m3pF\nlocal tool = Instance.new(\"Tool\")\ntool.Parent = game.Players.LocalPlayer.Character\ntool.RequiresHandle = false\ntool.Activated:Connect(function()\n    local f = workspace.Tiles\n    local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart\n    for i, v in pairs(f:GetDescendants()) do\n        if v:IsA(\"RayValue\") and v.Name == \"Mine\" then\n            if v:FindFirstChild(\"Flagged\") then return end\n            local args = {\n                v.Parent\n            }\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Events\"):WaitForChild(\"Remotes\"):WaitForChild(\"AddFlag\")\n                :FireServer(unpack(args))\n        end\n    end\n\n    for i, v in pairs(f:GetChildren()) do\n        if v.Name == \"Unactivated\" and not v:FindFirstChild(\"Flagged\") then\n            if v.FindFirstChild(\"Mine\") then return end\n            firetouchinterest(hrp, v.Activator, 0)\n        end\n    end\nend)\n","owner":{"_id":"660aed3f3ac90cfbaaa0ef0f","username":"tiam","verified":false,"profilePicture":"/images/photo/660aed3f3ac90cfbaaa0ef0f-1717016771142.png","status":"offline","id":"660aed3f3ac90cfbaaa0ef0f","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"discord":"https://discord.gg/SW7km6m3pF","views":917,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-c27f1aba2a209b3db676f106ab642330-52daa9fc8976.png","likeCount":6,"dislikeCount":1,"createdAt":"2026-01-20T09:13:05.407Z","editBy":{"_id":"660aed3f3ac90cfbaaa0ef0f"