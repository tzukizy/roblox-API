{"slug":"Minesweeper-Duels-Alpha-Unlock-All-Flags-148262","_id":"69c34c8422aa30fb14b5dca4","title":"Unlock All Flags","game":{"_id":"69c34c8422aa30fb14b5dca1","gameId":80801264745741,"name":"Minesweeper Duels [Alpha]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":80801264745741},"features":"Unlocks All Flags Visually","tags":[],"script":"local flags = game:GetService(\"ReplicatedStorage\").Flags\nlocal listofFlags = game:GetService(\"Players\").LocalPlayer.PlayerGui.Main.Inventory.ItemsFrame.Items.Flags\n\nfor i,v in next, flags:GetDescendants() do\n    if v.Name:find(\"Flag\") and v:isA(\"Model\") then\n        local flag = Instance.new('StringValue')\n        local name = v.Name:gsub('Flag', '')\n        flag.Name = name\n        flag.Parent = game.Players.LocalPlayer.Inventory.Flags \n    end\nend\n\ntask.wait(1)\n\nfor i,v in next, listofFlags:GetChildren() do\n    if v:isA(\"ImageButton\") then \n        local button = v \n        button.MouseButton1Click:Connect(function()\n            warn('hitler')\n            game.Players.LocalPlayer.EquippedFlag.Value = v.Name\n        end)\n    end\nend","owner":{"_id":"69963b7935987d06cfd0a153","username":"ghfrgrq8y7tr4q32y7r7","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/971de917e626d698953b4b51fe34f9d0d3b44c6d38d7eb8c3e8a7d5a41e31105.webp","original":"https://scriptblox.com/images/photo/69963b7935987d06cfd0a153-1773542159027.jpg"},"status":"offline","id":"69963b7935987d06cfd0a153","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/971de917e626d698953b4b51fe34f9d0d3b44c6d38d7eb8c3e8a7d5a41e31105.webp","original":"https://scriptblox.com/images/photo/69963b7935987d06cfd0a153-1773542159027.jpg"}},"verified":false,"views":2444,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cd