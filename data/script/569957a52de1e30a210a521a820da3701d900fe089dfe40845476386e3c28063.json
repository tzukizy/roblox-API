{"_id":"6972cdbb18bb57eef0ae8909","title":"Perfect shot and reach open source","game":{"_id":"67e5e1ffb360710ec3c77dca","gameId":14259168147,"name":"[🎃]🏀Basketball Legends🏀","imageUrl":{"url":"https://media.kocakz.me/ff8885249ab0ed1058ba93dc8d90f904605884f03bf746c559076384afe8eb8a.webp","original":"https://tr.rbxcdn.com/180DAY-417a98472ea5b2330740d08792681e7a/150/150/Image/Png/noFilter"},"slug":"14259168147-basketball-legends","path":"/game/14259168147-basketball-legends","thumbnail":{"url":"https://media.kocakz.me/ff8885249ab0ed1058ba93dc8d90f904605884f03bf746c559076384afe8eb8a.webp","original":"https://tr.rbxcdn.com/180DAY-417a98472ea5b2330740d08792681e7a/150/150/Image/Png/noFilter"},"placeId":14259168147},"slug":"Basketball-Legends-Perfect-shot-and-reach-open-source-89897","verified":false,"key":false,"keyless":false,"views":6019,"executes":22601,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/e35cd613a7e1ffe98c2cf402cac685b670a629f598edae6fe1f9a860a99da037.webp","original":"https://scriptblox.com/images/sb/rbx-14d5d2f1dcc77df006d46c5c3f99e679-12840c478e7e.png","scriptblox":"https://scriptblox.com/images/script/rbx-14d5d2f1dcc77df006d46c5c3f99e679-12840c478e7e.png"},"thumbnail":{"url":"https://media.kocakz.me/e35cd613a7e1ffe98c2cf402cac685b670a629f598edae6fe1f9a860a99da037.webp","original":"https://scriptblox.com/images/sb/rbx-14d5d2f1dcc77df006d46c5c3f99e679-12840c478e7e.png","scriptblox":"https://scriptblox.com/images/script/rbx-14d5d2f1dcc77df006d46c5c3f99e679-12840c478e7e.png"},"likeCount":13,"dislikeCount":0,"createdAt":"2026-01-23T01:24:11.836Z","updatedAt":"2026-01-23T01:24:11.836Z","lastBump":"2026-01-23T01:24:11.836Z","script":"--// Config made by @primary\nlocal Config = {\n    -- Perfect Shot\n    ShootKey = Enum.KeyCode.E,   -- keyboard key for shooting\n    TweenTime = 0.001,           -- how fast the bar fills\n\n    -- Steal Hitbox\n    ReachSize = 5,               -- how big the arm hitbox is\n    ArmTransparency = 0.9,       -- 0 = fully visible, 1 = invisible\n    ArmColor = Color3.fromRGB(255,224,189), -- skin tone\n}\n\n--// Services\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal player = Players.LocalPlayer\nlocal gui = player.PlayerGui\n\n--// Perfect Shot\nlocal bar = gui.Visual.Shooting.Bar\nlocal btn = gui.Main.Mobile.Holder.Shoot\n\nlocal function shoot()\n    local char = player.Character\n    if char and char:FindFirstChild(\"Basketball\") then\n        bar:TweenSize(UDim2.fromScale(1,1), Enum.EasingDirection.Out, Enum.EasingStyle.Linear, Config.TweenTime, true)\n        bar.Size = UDim2.fromScale(1,1)\n    end\nend\n\nfor _, e in ipairs({\"MouseButton1Click\",\"MouseButton1Down\",\"Activated\"}) do\n    btn[e]:Connect(shoot)\nend\n\nUserInputService.InputBegan:Connect(function(i,g)\n    if not g and i.KeyCode == Config.ShootKey then\n        shoot()\n    end\nend)\n\n--// Steal Hitbox\nlocal armNames = {\n    \"RightHand\",\"LeftHand\",\n    \"RightLowerArm\",\"LeftLowerArm\",\n    \"RightUpperArm\",\"LeftUpperArm\"\n}\n\nlocal function resizeArms(character)\n    for _, name in ipairs(armNames) do\n        local arm = character:FindFirstChild(name)\n        if arm then\n            arm.Size = Vector3.new(Config.ReachSize, Config.ReachSize, Config.ReachSize)\n            arm.Transparency = Config.ArmTransparency\n            arm.Material = Enum.Material.SmoothPlastic\n            arm.Color = Config.ArmColor\n            arm.Massless = true\n            arm.CanCollide = false\n        end\n    end\nend\n\nlocal function setupCharacter(character)\n    task.wait(1)\n    resizeArms(character)\n    character.DescendantAdded:Connect(function(desc)\n        if table.find(armNames, desc.Name) then\n            resizeArms(character)\n        end\n    end)\nend\n\nif player.Character then setupCharacter(player.Character) end\nplayer.CharacterAdded:Connect(setupCharacter)\n","features":"Basketball legend open source \nPc/mobile you can adjust it, if it not ur liking.","tags":["Basketball","Basketball legend","Basket","Ball","Shot"],"discord":"","keyLink":"","owner":{"_id":"68c29e021b42f67750716877","username":"Zerelle","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f6295a3989e34416fa06b7ac4ebd2b2011e5f7c67922acfc7e6f419acf25ca7f.webp","original":"https://scriptblox.com/images/photo/68c29e021b42f67750716877-1788270923576.jpg"},"status":"offline","id":"68c29e021b42f67750716877","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/f6295a3989e34416fa06b7ac4ebd2b2011e5f7c67922acfc7e6f419acf25ca7f.webp","original":"https://scriptblox.com/images/photo/68c29e021b42f67750716877-1788270923576.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:46:27.954Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6972cdbb18bb57eef0ae890c","editBy":{"_id":"68c29e021b42f67750716877","username":"Zerelle","status":"offline","id":"68c29e021b42f67750716877"},"message":"Create script","createdAt":"2026-01-23T01:24:11.839Z"}],"comments":[{"_id":"6972ce02ff3b2b4dbcf69c7e","commentBy":{"_id":"68c29e021b42f67750716877","username":"Zerelle","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/f6295a3989e34416fa06b7ac4ebd2b2011e5f7c67922acfc7e6f419acf25ca7f.webp","original":"https://scriptblox.com/images/photo/68c29e021b42f67750716877-1788270923576.jpg"},"createdAt":"2025-09-11T10:01:38.756Z","lastActive":"2026-09-05T21:38:12.033Z","status":"offline","id":"68c29e021b42f67750716877","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/f6295a3989e34416fa06b7ac4ebd2b2011e5f7c67922acfc7e6f419acf25ca7f.webp","original":