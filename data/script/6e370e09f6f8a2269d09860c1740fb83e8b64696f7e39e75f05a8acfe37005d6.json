{"slug":"Universal-Script-e-43371","_id":"68609aaa3f22202dfd8a79d0","title":"multi damage","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1751161514865.jpg","placeId":0},"features":"idk whats this script is but only works on other games that give you multi gear or multi damage","tags":[],"script":"\n--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\nlocal settings = {repeatamount = 100, exceptions = {\"SayMessageRequest\",\"MeleeUpdateEvent\",\"NinjaBombEvent\",\"BulletUpdateEvent\"}}\n\nlocal mt = getrawmetatable(game)\nlocal old = mt.__namecall\nsetreadonly(mt, false)\n\nmt.__namecall = function(uh, ...)\n  local args = {...}\n  local method = getnamecallmethod()\n  for i,o in next, settings.exceptions do\n      if uh.Name == o then\n          return old(uh, ...)\n      end\n  end\n  if method == \"FireServer\" or method == \"InvokeServer\" then\n      for i = 1,settings.repeatamount do\n          old(uh, ...)\n      end\n  end\n  return old(uh, ...)\nend\n\nsetreadonly(mt, true)\n","owner":{"_id":"67ab05dc7f145078bde3c57c","username":"stupid_cat","verified":false,"profilePicture":"/images/photo/67ab05dc7f145078bde3c57c-1739261514049.jpeg","status":"offline","id":"67ab05dc7f145078bde3c57c","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":7917,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1751161514865.jpg","likeCount":3,"dislikeCount":0,"createdAt":"2025-06-29T01:45:14.919Z","executes":1229,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68609aaa3f22202dfd8a79d2","editBy":{"_id":"67ab05dc7f145078bde3c57c","username":"stupid_cat","status":"offline","id":"67ab05dc7f145078bde3c57c"},"message":"Create script","createdAt":"2025-06-29T01:45:14.924Z"}],"comments":[{"_id":"68609f142206934a9c6f17a0","commentBy":{"_id":"67a5b58