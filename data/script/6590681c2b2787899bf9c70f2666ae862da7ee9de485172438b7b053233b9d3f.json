AREYOU = HOWAREYOU .. c\n    end\nend\n\nlocal NEWVEROBF = \"\"\nfor i = 1, #HOWAREYOU, 2 do\n    local byte_str = string.sub(HOWAREYOU, i, i+1)\n    local byte_val = tonumber(byte_str, 16)\n    if byte_val then\n        NEWVEROBF = NEWVEROBF .. string.char(byte_val)\n    end\nend\n\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[Q%]\", '\"')\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[A%]\", \"'\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[N%]\", \"\\n\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[R%]\", \"\\r\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[B%]\", \"\\\\\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[P%]\", \"%%\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[E%]\", \"=\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[C%]\", \":\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[H%]\", \"#\")\nNEWVEROBF = string.gsub(NEWVEROBF, \"%[D%]\", \"-\")\n\nlocal BBOBF = loadstring(NEWVEROBF)\nif BBOBF then\n    BBOBF()\nelse\n    error(\"Load error\")\nend\n","features":"Just AUTO WallHop script\nto turn off this script you need reset character.","tags":["FE","univ","Universal","WH","WallHop"],"discord":"","keyLink":"","owner":{"_id":"68ceeb4910a427f26ca3a2e4","username":"blindboot","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68ceeb4910a427f26ca3a2e4","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:41:16.792Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6904c31ddb000b89340b42ce","editBy":{"_id":"68ceeb4910a427f26ca3a2e4","username":"blindboot","status":"offline","id":"68ceeb4910a427f26ca3a2e4"},"message":"Create script","createdAt":"2025-10-31T14:09:33.299Z"},{"_id":"6904c352a19d085c35e9f148","editBy":{"_i