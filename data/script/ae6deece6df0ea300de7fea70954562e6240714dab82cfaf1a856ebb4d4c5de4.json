{"slug":"generic-roleplay-gaem.-Simple-OG-Money-tree-tp-42804","_id":"6854795e745af8377c2e022e","title":"Simple OG Money tree tp","game":{"_id":"67e5e1ffb360710ec3c7853f","gameId":4598019433,"name":"generic roleplay gaem.","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":4598019433},"features":"Open source.\nAllowed paste.\nHave error Teleport bug .\nIt was established on 19.06.2025. If it does not work, it means the anticheat is advanced.","tags":["Simple"],"script":"local RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\n\nlocal function WorkingTp()\n    hrp.CFrame = CFrame.new(-49, 28, 255)\nend\n\nlocal function getFirstFreeTree() -- can change OG_Fruit\n    for _, tree in pairs(workspace.Trees:GetChildren()) do\n        if tree.Name == \"OG_Money\" and not tree:FindFirstChild(\"Owner\") then\n            return tree\n        end\n    end\n    return nil\nend\n\nlocal function getBehindCFrame(tree)\n    local pivot = tree:GetPivot()\n    local lookVector = pivot.LookVector\n    local behindPosition = pivot.Position - (lookVector * 3) + Vector3.new(0, 1, 0)\n    return CFrame.new(behindPosition, pivot.Position)\nend\n\n\n\nlocal function teleportAndStart()\n    local tree = getFirstFreeTree()\n    if tree then\n        WorkingTp()\n        task.wait(0.25)\n        hrp.CFrame = getBehindCFrame(tree)\n        \n    else\n        warn(\"🌲 No free OG_Money tree found!\")\n        game:GetService(\"StarterGui\"):SetCore(\"ChatMakeSystemMessage\", {\n            Text = \"❌ No free OG_Money tree found!\",\n            Color = Color3.fromRGB(255, 100, 100)\n        })\n    end\nend\n\nteleportAndStart()\n","owner":{"_id":"68480180059a9781e070833f","us