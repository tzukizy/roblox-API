{"_id":"69d0cf36bcb47fa3d9d41620","title":"silent aim open source","game":{"_id":"6817644419d50c23e2317836","gameId":15555246249,"name":"⭐DoW⭐ -  Dogs of War: WW2","imageUrl":{"url":"https://media.kocakz.me/aa1217945e74d8f2196459e195641a5927f03616ecc2aece0548bb2224a70d42.webp","original":"https://tr.rbxcdn.com/180DAY-a4674c0e7a1c44f530916a965c1eb1c8/150/150/Image/Png/noFilter"},"slug":"15555246249-dow-dogs-of-war-ww2","path":"/game/15555246249-dow-dogs-of-war-ww2","thumbnail":{"url":"https://media.kocakz.me/aa1217945e74d8f2196459e195641a5927f03616ecc2aece0548bb2224a70d42.webp","original":"https://tr.rbxcdn.com/180DAY-a4674c0e7a1c44f530916a965c1eb1c8/150/150/Image/Png/noFilter"},"placeId":15555246249},"slug":"DoW-Dogs-of-War:-WW2-silent-aim-open-source-180679","verified":false,"key":false,"keyless":false,"views":1820,"executes":1231,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/e000699e1a4bbe58c3c01fcd0e572ceb7ba778aa8d64f134fcd2d26017d30370.webp","original":"https://scriptblox.com/images/sb/rbx-391223b421ea6f21276af1f6147dbf23-c318d8e3e4fc.png","scriptblox":"https://scriptblox.com/images/script/rbx-391223b421ea6f21276af1f6147dbf23-c318d8e3e4fc.png"},"thumbnail":{"url":"https://media.kocakz.me/e000699e1a4bbe58c3c01fcd0e572ceb7ba778aa8d64f134fcd2d26017d30370.webp","original":"https://scriptblox.com/images/sb/rbx-391223b421ea6f21276af1f6147dbf23-c318d8e3e4fc.png","scriptblox":"https://scriptblox.com/images/script/rbx-391223b421ea6f21276af1f6147dbf23-c318d8e3e4fc.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-04-04T08:43:34.889Z","updatedAt":"2026-04-04T08:43:34.889Z","lastBump":"2026-04-04T08:43:34.889Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal targetPos = nil\nlocal function getClosestTarget()\n    local camera = workspace.CurrentCamera\n    local mousePos = UserInputService:GetMouseLocation()\n    local closestDist = math.huge\n    local closestPos = nil\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player == LocalPlayer then continue end\n        local char = player.Character\n        if not char then continue end\n        local head = char:FindFirstChild(\"Head\")\n        if not head then continue end\n        local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)\n        if not onScreen then continue end\n        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude\n        if dist < closestDist then\n            closestDist = dist\n            closestPos = head.Position\n        end\n    end\n    targetPos = closestPos\nend\nlocal oldNamecall\noldNamecall = hookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)\n    local method = getnamecallmethod():lower()\n    if method == \"raycast\" and targetPos and typeof(self) == \"Instance\" and self == workspace then\n        local args = {...}\n        if typeof(args[1]) == \"Vector3\" then\n            local camera = workspace.CurrentCamera\n            args[2] = (targetPos - camera.CFrame.Position).Unit * 500\n            return oldNamecall(self, table.unpack(args))\n        end\n    end\n    return oldNamecall(self, ...)\nend))\nRunService.Heartbeat:Connect(getClosestTarget)","features":"Credits: Phemonaz","tags":[],"discord":"","keyLink":"","owner":{"_id":"69af5f1c942b0cf7aa3d6a94","username":"phemonazLEX","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c7b116a1a55c9e04f05bc63f0b147e62db4a66fa4b6accfd53c2b810836f4b96.webp","original":"https://scriptblox.com/images/photo/69af5f1c942b0cf7aa3d6a94-1774060477809.jpg"},"status":"offline","id":"69af5f1c942b0cf7aa3d6a94","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/c7b116a1a55c9e04f05bc63f0b147e62db4a66fa4b6accfd53c2b