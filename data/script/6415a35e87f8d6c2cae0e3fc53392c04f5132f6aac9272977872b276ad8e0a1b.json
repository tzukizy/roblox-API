{"slug":"(QOL-+-DESTRUCTION)-NPC-Builders-Demo-Auto-Destroy-all-Builds-246186","_id":"6a6967fb4aac101356428eb1","title":"Auto Destroy all Builds","game":{"_id":"6a6967fb4aac101356428eb0","gameId":123728734372819,"name":"(QOL + DESTRUCTION) NPC Builders Demo","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":123728734372819},"features":"Automatically destroys everyone's build extremely fast\n() Opensourced","tags":[],"script":"_G.Enabled = true\n\n-- hold out the fists tool upon exection\n-- Also works as a server lagger/crasher\n\nlocal idk = game:GetService(\"ReplicatedStorage\").RemoteEvent\nlocal wows = game:GetService(\"RunService\")\n\nlocal function gab()\n    local parts = {}\n    local buildFolder = workspace:FindFirstChild(\"NPCBuildFolder\")\n    if not buildFolder then return parts end\n    for _, folder in pairs(buildFolder:GetChildren()) do\n        if string.match(folder.Name, \"'s Folder$\") then\n            for _, child in pairs(folder:GetChildren()) do\n                if child.Name == \"Model\" then\n                    for _, part in pairs(child:GetChildren()) do\n                        if part:IsA(\"BasePart\") then\n                            table.insert(parts, part)\n                        end\n                    end\n                end\n            end\n        end\n    end\n    return parts\nend\n\nlocal function damn()\n    local parts = gab()\n    if #parts == 0 then return end\n    for _, part in pairs(parts) do\n        if not _G.Enabled then break end\n        local punchCFrame = CFrame.new(\n            part.Position.X,\n            part.Position.Y + 1,\n            part.Position.Z\n        )\n        idk:FireServer(\"BreakFists\", punchCFrame)\n    end\nend\n\nwow = wows.Heartbeat:Connect(function()\n    if _G.Enabled then\n        damn()\n    end\nend)","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"verified":false,"views":3336,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-72f64efcd354ecff0807a49265997650-112aa8abe198.png","scriptblox":"https://scriptblox.com/images/script/rbx-72f64efcd354ecff0807a49265997650-112aa8abe198.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-29T02:39:55.752Z","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"keyLink":"","executes":450,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:12:42.629Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-72f64efcd354ecff0807a49265997650-112aa8abe198.png","scriptblox":"https://scriptblox.com/images/script/rbx-72f64efcd354ecff0807a49265997650-112aa8abe198.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a6967fb4aac101356428eb3","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Create script","createdAt":"2026-07-29T02:39:55.755Z"},{"_id":"6a696849a5286d69a5e2931d","