{"slug":"Foxy-from-FNAF-Doom-LEGACY-HALLOWEEN-UPDATE-Inf-Stamina-61165","_id":"68ff4a1a4ee6309892ddd90d","title":"Inf Stamina","game":{"_id":"688ca7cc5c54342b5420d5e0","gameId":71544145522719,"name":"[CHAOS UPDATE] Foxy from FNAF Doom","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":71544145522719},"features":"Inf Stamina (Stays After Death)","tags":["foxy from fnaf doom"],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer= Players.LocalPlayer\n\nlocal function maintainStamina()\nwhile task.wait(0.1) do\npcall(function()\nlocal playerFolder = workspace:FindFirstChild(\"Players\")\nif playerFolder then\nlocal player = playerFolder:FindFirstChild(LocalPlayer.Name)\nif player then\nlocal values = player:FindFirstChild(\"Values\")\nif values then\nlocal stamina = values:FindFirstChild(\"Stamina\")\nif stamina then\nstamina.Value = 100\nend\nend\nend\nend\nend)\nend\nend\n\nmaintainStamina()\n\nLocalPlayer.CharacterAdded:Connect(function()\ntask.wait(2)\nmaintainStamina()\nend)\n\nprint(\"i think it works yeh\")","owner":{"_id":"68d7ba04512e4b48babbd1dd","username":"zeid","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/320bbb7380a22f77b56c62a94e378f1e7526973022b5cba8a439a3607a2bebf9.webp","original":"https://scriptblox.com/images/photo/68d7ba04512e4b48babbd1dd-1764596175601.jpg"},"status":"offline","id":"68d7ba04512e4b48babbd1dd","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/320bbb7380a22f77b56c62a94e378f1e7526973022b5cba8a439a3607a2bebf9.webp","original":"https://scriptblox.com/images/photo/68d7ba04512e4b48babbd1dd-1764596175601.jpg"}},"verified":false,"views":5249,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/af1616a7642e2e2635d44f8ab25580c5b575bfc4cb5390c68294250694099c8b