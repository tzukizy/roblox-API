{"slug":"Foxy-from-FNAF-Doom-LEGACY-HALLOWEEN-UPDATE-Inf-Stamina-61165","_id":"68ff4a1a4ee6309892ddd90d","title":"Inf Stamina","game":{"_id":"688ca7cc5c54342b5420d5e0","gameId":71544145522719,"name":"[CHAOS UPDATE] Foxy from FNAF Doom","imageUrl":"/images/sb/rbx-b388f37f630732c866dc3fcf159a1d8b-be72f396ba0e.png","placeId":71544145522719},"features":"Inf Stamina (Stays After Death)","tags":["foxy from fnaf doom"],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer= Players.LocalPlayer\n\nlocal function maintainStamina()\nwhile task.wait(0.1) do\npcall(function()\nlocal playerFolder = workspace:FindFirstChild(\"Players\")\nif playerFolder then\nlocal player = playerFolder:FindFirstChild(LocalPlayer.Name)\nif player then\nlocal values = player:FindFirstChild(\"Values\")\nif values then\nlocal stamina = values:FindFirstChild(\"Stamina\")\nif stamina then\nstamina.Value = 100\nend\nend\nend\nend\nend)\nend\nend\n\nmaintainStamina()\n\nLocalPlayer.CharacterAdded:Connect(function()\ntask.wait(2)\nmaintainStamina()\nend)\n\nprint(\"i think it works yeh\")","owner":{"_id":"68d7ba04512e4b48babbd1dd","username":"zeid","verified":false,"profilePicture":"/images/photo/68d7ba04512e4b48babbd1dd-1764596175601.jpg","status":"offline","id":"68d7ba04512e4b48babbd1dd","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":5242,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-a64ca0eb55c0ea5e885a78c8cad52c87-5e14042e7706.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-10-27T10:31:54.124Z","executes":586,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68ff4a1a4ee6309892ddd90f","editBy":{"_id":"68d7ba04512e4b48babbd1dd","username":"zeid","status":"offline","id":"68d7ba04512e4b48babbd1dd"},"message":"Create script","createdAt":"2025-10-27T10:31:54.128Z"}],"comments":[{"_id":"698f7c1c12004551b6454da4","commentBy":{"_id":"6988b58f1