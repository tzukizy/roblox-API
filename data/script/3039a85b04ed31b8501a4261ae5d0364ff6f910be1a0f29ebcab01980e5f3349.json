{"slug":"blade-battleNew-Level-Cap-Player-Kill-All-84025","_id":"6962fa0589eac87a14c6ac39","title":"Player Kill All","game":{"_id":"693412436c272a905cf5aeb9","gameId":88929752766075,"name":"❄️blade battle[New Level Cap]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":88929752766075},"features":"Just kills all player on execute and disables it on reexecute, made it in like 2 mins","tags":["idk"],"script":"_G.PlayerKillAll = not _G.PlayerKillAll\n\nwhile _G.PlayerKillAll and task.wait(.1) do\n    for _,Knife in game.Players.LocalPlayer.Character.Weapon:GetChildren() do\n        if not Knife:IsA(\"Model\") then continue end\n        for i,v in game.Players:GetChildren() do\n            if v.Name == game.Players.LocalPlayer.Name then continue end\n            if not v.Character then continue end\n            if not v.Character:FindFirstChild(\"HumanoidRootPart\") then continue end\n\n            firetouchinterest(v.Character.HumanoidRootPart, Knife.PrimaryPart, 0)\n            firetouchinterest(v.Character.HumanoidRootPart, Knife.PrimaryPart, 1)\n        end\n    end\nend","owner":{"_id":"61b4ff6e66c4ed24724702da","username":"Pryxo","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/539e1a0ae7ada9c28294c330d6cf0ee14c9aca988ce072ae42efb64173e948ba.webp","original":"https://scriptblox.com/images/photo/61b4ff6e66c4ed24724702da-1768094397311.png"},"status":"offline","id":"61b4ff6e66c4ed24724702da","leaderboard":{"tag":null},"topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://cdn.kocakz.me/images/539e1a0ae7ada9c28294c330d6cf0ee14c9aca988ce072ae42efb64173e948ba.webp","original":"https://scriptblox.com/images/photo/61b4ff6e66c4ed24724702da-1768094397311.png"}},"verified":true,"views":970,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/