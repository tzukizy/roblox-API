tion = game:GetService(\"RunService\").Heartbeat:Connect(function()\n    roll()\nend)\n\nend)\n\nTab:CreateButton(\"Rejoin for more\", function()\n\nlocal player = game.Players.LocalPlayer\nlocal gamePlaceId = game.PlaceId\nlocal teleportService = game:GetService(\"TeleportService\")\nteleportService:Teleport(gamePlaceId, player)\n\nend)\n\n\nlocal Tab = Window:NewSection(\"Links\")\n \nTab:CreateButton(\"Discord Group\", function()\nprint(\"HI\")\n \nsetclipboard(\"https://discord.gg/8A6k73JqCM\")\ntoclipboard(\"https://discord.gg/8A6k73JqCM\")\n \nend)\n ","owner":{"_id":"6830a134c236ccc4acf59745","username":"KMAN","verified":false,"profilePicture":"/images/photo/6830a134c236ccc4acf59745-1758858349070.png","status":"offline","id":"6830a134c236ccc4acf59745","leaderboard":{"tag":{"kind":"hall","rank":8,"period":"all","metric":"likes","value":542}},"topMilestone":{"key":"creator.hall_of_fame","tier":1}},"verified":false,"discord":"https://discord.gg/kZSu8R4grU","views":2761,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/13704594433-1757727398162.webp","likeCount":4,"dislikeCount":1,"createdAt":"2025-09-13T01:36:38.188Z","executes":14,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c4caa65e919d64b3b3f7dc","editBy":{"_id":"6830a134c236ccc4acf59745","username":"KMAN","status":"offline","id":"6830a134c236ccc4acf59745"},"message":"Create script","createdAt":"2025-09-13T01:36:38.192Z"}],"comments":[{"_id":"68c4cab8f3c1ae23ef8d268c","commentBy":{"_id":"6830a134c236ccc4acf59745","username":"KMAN","verified":false,"role":"user","profilePicture":"/images/photo/6830a134c236ccc4acf59745-1758858349070.png","createdAt":"2025-05-23T16:24:20.959Z","lastActive":"2026-10-10T04:12:58.409Z","status":"offline","id":"6830a134c236ccc4acf59745","leaderboard":{"tag":{"kind":"hall","rank":8,"period":"all","metric":"likes","value":542}},"topMilestone":{"key":"creator.hall_of_fame","tier"