{"slug":"Universal-Script-Fly-for-free-160783","_id":"69c92e7ae30209b0a2e8f660","title":"Fly for free","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1774792314485.png","placeId":0},"features":"Fly","tags":[],"script":"local plr = game.Players.LocalPlayer\nlocal fly = false\nlocal speed = 40\n\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.F then\n        fly = not fly\n        if fly then\n            plr.Character.Humanoid.PlatformStand = true\n            local bv = Instance.new(\"BodyVelocity\")\n            bv.Parent = plr.Character.HumanoidRootPart\n            bv.MaxForce = Vector3.new(9e9,9e9,9e9)\n            while fly do\n                bv.Velocity = plr.Character.Humanoid.MoveDirection * speed\n                wait()\n            end\n            bv:Destroy()\n            plr.Character.Humanoid.PlatformStand = false\n        end\n    end\nend)","owner":{"_id":"69bf3f8cd61594f771b936ba","username":"gregoryhagen11","verified":false,"profilePicture":"/images/photo/69bf3f8cd61594f771b936ba-1774797234272.jpg","status":"offline","id":"69bf3f8cd61594f771b936ba","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":361,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1774792314485.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-29T13:51:54.502Z","editBy":{"_id":"69bf3f8cd61594f771b936ba","username":"gregoryhagen11","status":"offline","id":"69bf3f8cd61594f771b936ba"},"keyLink":"","executes":121,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c92e7ae30209b0a2e8f664","editBy":{"_id":"69bf3f8cd61594f771b936ba","username":"gregoryhagen11","status":"offline","id":"69bf3f8cd61594f771b936ba"},"message":"67","createdAt":"2026-03-29T13:51:54.516Z"},{"_id":"69c92fec9049858e8796c44c","editBy":{"_id":"69bf3f8cd61