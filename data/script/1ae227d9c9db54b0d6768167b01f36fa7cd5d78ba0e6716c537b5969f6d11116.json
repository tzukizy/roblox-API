{"slug":"Universal-Script-trip-31273","_id":"67ccba0d1bfd28d76bde7cf8","title":"trip","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/3778944-1741470221144.png","placeId":0},"features":"this will make your player trip :)\n\nhow to use \n\nexecute the script","tags":["script","trip","fun","proohio","pro"],"script":"local plrs = game.Players\nlocal plr = plrs.LocalPlayer\nlocal char = plr.Character or plr.CharacterAdded:Wait()\n\nlocal function gt(char)\n\treturn char:FindFirstChild(\"HumanoidRootPart\") or char:FindFirstChild(\"Torso\") or char:FindFirstChild(\"UpperTorso\")\nend\n\nif char and char:FindFirstChildOfClass(\"Humanoid\") and gt(char) then\n\tlocal hum = char:FindFirstChildOfClass(\"Humanoid\")\n\tlocal root = gt(char)\n\thum:ChangeState(0)\n\troot.Velocity = root.CFrame.LookVector * 30\nend\n","owner":{"_id":"655a2348063f67522da3be29","username":"proohio","verified":false,"profilePicture":"/images/photo/655a2348063f67522da3be29-1741462797884.png","status":"offline","id":"655a2348063f67522da3be29","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":5220,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-08T21:43:41.192Z","dislikeCount":1,"likeCount":0,"image":"/images/sb/3778944-1741470221144.png","executes":1054,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c556da","editBy":{"_id":"655a2348063f67522da3be29","username":"proohio","status":"offline","id":"655a2348063f67522da3be29"},"message":"Create script","createdAt":"2025-03-27T21:56:34.120Z"}],"comments":[{"_id":"6a54264eaffd30f7ff43b27b","commentBy":{"_id":"67ad50af1ddbdc4ea170ec30","username":"pearlrezpeltzer","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-02-13T01:53:51.751Z","lastActive":"2026-08-07T22:04:22.353Z","status":"offline","id":"6