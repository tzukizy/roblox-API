{"slug":"Universal-Script-2D-Universal-Box-ESP-110683","_id":"698e052d35987d06cf3add89","title":"2D Universal Box ESP","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Just box esp","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function createESP(player)\n\tif player == LocalPlayer then return end\n\n\tlocal function onCharacterAdded(character)\n\t\tlocal hrp = character:WaitForChild(\"HumanoidRootPart\", 5)\n\t\tlocal humanoid = character:WaitForChild(\"Humanoid\", 5)\n\t\tif not hrp or not humanoid then return end\n\n\t\tlocal gui = Instance.new(\"BillboardGui\")\n\t\tgui.Name = \"ESP\"\n\t\tgui.Adornee = hrp\n\t\tgui.Size = UDim2.fromScale(4, 6)\n\t\tgui.StudsOffset = Vector3.new(0, 0, 0)\n\t\tgui.AlwaysOnTop = true\n\t\tgui.Parent = character\n\n\t\tlocal box = Instance.new(\"Frame\")\n\t\tbox.Size = UDim2.fromScale(1, 1)\n\t\tbox.BackgroundTransparency = 1\n\t\tbox.Parent = gui\n\n\t\tlocal stroke = Instance.new(\"UIStroke\")\n\t\tstroke.Thickness = 2\n\t\tstroke.Color = Color3.fromRGB(255, 255, 255)\n\t\tstroke.Parent = box\n\n\t\tlocal nameLabel = Instance.new(\"TextLabel\")\n\t\tnameLabel.Size = UDim2.new(1, 0, 0.15, 0)\n\t\tnameLabel.Position = UDim2.new(0, 0, -0.18, 0)\n\t\tnameLabel.BackgroundTransparency = 1\n\t\tnameLabel.Text = player.Name\n\t\tnameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\n\t\tnameLabel.TextStrokeTransparency = 0\n\t\tnameLabel.TextScaled = true\n\t\tnameLabel.Font = Enum.Font.SourceSansBold\n\t\tnameLabel.Parent = box\n\tend\n\n\tif player.Character then\n\t\tonCharacterAdded(player.Character)\n\tend\n\n\tplayer.CharacterAdded:Connect(onCharacterAdded)\nend\n\nfor _, player in ipairs(Players:GetPlayers()) do\n\tcreateESP(player)\nend\n\nPlayers.PlayerAdded:Connect(createESP)\n","owner":{"_id":"698486d2e96ccd2956932475","username":"Coolguy8","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"698486d2e96ccd2956932475","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":659,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/8ba099ee5ac1768bcea71b368ce77d1ea35d2086af3abc3f7b32206feff18fe2.webp","original":"https://scriptblox.com/images/sb/0-1770915116982.png","scriptblox":"https://scriptblox.com/images/script/0-1770915116982.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-12T16:51:57.005Z","executes":563,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:06:39.165Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/8ba099ee5ac1768bcea71b368ce77d1ea35d2086af3abc3f7b32206feff18fe2.webp","original":"https://scriptblox.com/images/sb/0-1770915116982.png","scriptblox":"https://scriptblox.com/images/script/0-1770915116982.png"},"changelog":[{"_id":"698e052d35987d06cf3add8c","editBy":{"_id":"698486d2e96ccd2956932475","username":"Coolguy8","status":"offline","id":"698486d2e96ccd2956932475"},"message":"Create script","createdAt":"2026-02-12T16:51:57.009Z"}],"comments":[{"_id":"698e0537839c20a317cdd5d9","commentBy":{"_id":"698486d2e96ccd2956932475","username":"Coolguy8","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-02-19T07:06:05.477Z","createdAt":"2026-02-05T12:02:26.643Z","status":"offline","id":"698486d2e96ccd2956932475","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url