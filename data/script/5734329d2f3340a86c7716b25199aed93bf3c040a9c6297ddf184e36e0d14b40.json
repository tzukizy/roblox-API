{"slug":"Climb-1000-Ladders-Script-19165","_id":"66f7f6dd2009368deec05f67","title":"Script","game":{"_id":"67e5e1ffb360710ec3c788c1","gameId":16957492218,"name":"Climb 1,000 Ladders","imageUrl":"https://t7.rbxcdn.com/180DAY-0bcd154845703767a3c8bb10eb6f4f83","placeId":16957492218},"features":"- Win","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\n\nlocal spawnFolder = game.Workspace:FindFirstChild(\"Spawns\")\nif spawnFolder then\n    local winnerSpawn = spawnFolder:FindFirstChild(\"WinnerSpawn\")\n    if winnerSpawn then\n        local characterHeight = character:FindFirstChild(\"Humanoid\").HipHeight\n        character:SetPrimaryPartCFrame(CFrame.new(winnerSpawn.Position.X, winnerSpawn.Position.Y + characterHeight, winnerSpawn.Position.Z))\n    else\n        return\n    end\nelse\n    return\nend","owner":{"_id":"661802cf043bbefaf7b314b7","username":"d9_6","verified":false,"profilePicture":"/images/photo/661802cf043bbefaf7b314b7-1767478547778.jpg","status":"offline","id":"661802cf043bbefaf7b314b7","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":11239,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-09-28T12:30:21.122Z","dislikeCount":0,"likeCount":0,"image":"https://tr.rbxcdn.com/9c62bc9bc16109ae7b965736fb221aab/500/280/Image/Jpeg","editBy":{"_id":"661802cf043bbefaf7b314b7","username":"d9_6","status":"offline","id":"661802cf043bbefaf7b314b7"},"executes":12,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c523fe","editBy":{"_id":"661802cf043bbefaf7b314b7","username":"d9_6","status":"offline","id":"661802cf043bbefaf7b314b7"},"message":"Create script","createdAt":"2025-03-27T20:47:00.174Z"},{"_id":"68a06723902f2de0222c5ada","editBy":{"_id":"661802cf043bbefaf7b314b7","username":"d9_6","status":"offline","id":"661802cf043bbefaf7b31