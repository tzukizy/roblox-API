nd\n\tend\n\t\n\t-- olhos brilhando (simples)\n\tlocal head = character:FindFirstChild(\"Head\")\n\tif head then\n\t\tlocal light = Instance.new(\"PointLight\")\n\t\tlight.Color = Color3.fromRGB(255,255,255)\n\t\tlight.Brightness = 2\n\t\tlight.Range = 5\n\t\tlight.Parent = head\n\tend\nend\n\n-- Ativar com tecla (ex: tecla \"K\")\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input)\n\tif input.KeyCode == Enum.KeyCode.K then\n\t\taplicarShadow()\n\tend\nend)","features":"slendytubbies vs redux \nScript de skins","tags":[],"discord":"","keyLink":"","owner":{"_id":"68984857dc62a53b9c5405c7","username":"Newborn_hacker","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c02795eddafd9746e7060499a2cb006e9520581cd4ed953e8841f712d2e9defb.webp","original":"https://scriptblox.com/images/photo/68984857dc62a53b9c5405c7-1774653628426.jpg"},"status":"offline","id":"68984857dc62a53b9c5405c7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/c02795eddafd9746e7060499a2cb006e9520581cd4ed953e8841f712d2e9defb.webp","original":"https://scriptblox.com/images/photo/68984857dc62a53b9c5405c7-1774653628426.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:39:00.955Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e6c074467c47b2c3db37e7","editBy":{"_id":"68984857dc62a53b9c5405c7","username":"Newborn_hacker","status":"offline","id":"68984857dc62a53b9c5405c7"},"message":"Create script","createdAt":"2025-10-08T19:50:12.125Z"},{"_id":"68e6c8f639260d0283fdf9a1","editBy":{"_id":"68984857dc62a53b9c5405c7","username":"Newborn_hacker","status":"offline","id":"68984857dc62a53b9c5405c7"},"message":"Update script","createdAt":"2025-10-08T20:26:30.437Z"},{"_id":"68e6ccce39260d0283fe9fff","editBy":{"_id":"68984857dc62a53b9c5405c7",