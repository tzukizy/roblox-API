{"slug":"Fling-Everyone_1049","_id":"622257f4d33a26d1fda17d6a","title":"Fling Everyone","game":{"_id":"67e5e1ffb360710ec3c78027","gameId":8296412506,"name":"(3+ NEW EMOTES) Home Simulator","imageUrl":"https://tr.rbxcdn.com/61f0f7784c5babed772d19e9d2cadbc3/500/280/Image/Jpeg","placeId":8296412506},"features":"script literally just flings everyone","tags":["fling"],"script":"--[[\nThis script requires the knockback car to be equipped, you can use catware if you want to get the car for free\nhttp://cdn.scriptblox.com/script/Catware-or-Home-Simulator_1047\n\n]]\n\nlocal players,runService,touch = game:GetService(\"Players\"),game:GetService(\"RunService\")\nlocal localPlayer = players.LocalPlayer\nwhile runService.RenderStepped:Wait() do\n    if localPlayer.Character and localPlayer.Character:FindFirstChild(\"KnockbackCar\") then\n        touch = localPlayer.Character.KnockbackCar:WaitForChild(\"car\",3)\n        for i,v in next, players:GetPlayers() do\n            if i~=1 and v.Character and v.Character.PrimaryPart then\n                firetouchinterest(touch,v.Character.PrimaryPart,0)\n                firetouchinterest(touch,v.Character.PrimaryPart,1)\n            end\n        end\n    end\nend","owner":{"_id":"61afb8b7047ce2dcaea84d13","username":"Shaymin","verified":true,"profilePicture":"/images/photo/61afb8b7047ce2dcaea84d13-1721572256064.png","status":"offline","id":"61afb8b7047ce2dcaea84d13","topMilestone":{"key":"creator.views","tier":1000000}},"verified":true,"views":359874,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-03-04T18:18:28.562Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/8296412506-1646417947115.jpg","executes":73,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4de08","editBy":{"_id":"61afb8b7047ce2dcaea84d13","username":"Shaymin","status":"offline","id":"61afb8b7047ce2dcaea84d13"},"message":"Create script","createdAt