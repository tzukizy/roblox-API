{"slug":"Universal-Script-mollerspy-1798","_id":"625113a4b9937a9e840af597","title":"mollerspy","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2600222-1649480612920.jpg","placeId":0},"features":"Allows you to read calls on HttpGet\n\nCurrently only supports Script-Ware, Synapse X, Krnl and Fluxus\nIf your exploit is currently not supported but works post it in the comments and I will add them to the list or vice versa","tags":["mollersuite"],"script":"local exploitName\n\nif getexecutorname and getexecutorname() == \"ScriptWare\" then\n    exploitName = \"Script-Ware\"\n    rconsolecreate()\n    rconsolesettitle(\"mollerspy - Script-Ware edition\")\nelseif syn then\n    exploitName = \"Synapse X\"\n    rconsolename(\"mollerspy - Synapse X edition\")\nelseif Krnl then -- exact same as synapse x but just incase the exploit needs to use different functions at a later date\n    exploitName = \"Krnl\"\n    rconsolename(\"mollerspy - Krnl edition\")\nelseif identifyexecutor and identifyexecutor() == \"Fluxus\" then\n    exploitName = \"Fluxus\"\n    rconsoletitle(\"mollerspy - Fluxus edition\")\nend\n\nlocal httpget\nhttpget = hookfunction(game.HttpGet, newcclosure(function(game, url)\n    if exploitName == \"Script-Ware\" then\n        rconsoleprint(\"[HTTP] \" .. url .. \"\\n\", \"cyan\")\n    elseif exploitName == \"Synapse X\" or exploitName == \"Krnl\" or exploitName == \"Fluxus\" then\n        rconsoleprint(\"@@CYAN@@[HTTP] \" .. url .. \"\\n\")\n    end\n    return httpget(game, url)\nend))","owner":{"_id":"624ff5b428fd9cc3df0d0ee1","username":"trollar","verified":false,"profilePicture":"/images/photo/624ff5b428fd9cc3df0d0ee1-1649407450471.png","status":"offline","id":"624ff5b428fd9cc3df0d0ee1","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":8395,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-04-09T05:03:32.935Z","dislikeCount":0