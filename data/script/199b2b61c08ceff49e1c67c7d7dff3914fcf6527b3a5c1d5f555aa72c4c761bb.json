me == \"Synapse X\" or exploitName == \"Krnl\" or exploitName == \"Fluxus\" then\n        rconsoleprint(\"@@CYAN@@[HTTP] \" .. url .. \"\\n\")\n    end\n    return httpget(game, url)\nend))","features":"Allows you to read calls on HttpGet\n\nCurrently only supports Script-Ware, Synapse X, Krnl and Fluxus\nIf your exploit is currently not supported but works post it in the comments and I will add them to the list or vice versa","tags":["mollersuite"],"discord":"","keyLink":"","owner":{"_id":"624ff5b428fd9cc3df0d0ee1","username":"trollar","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"624ff5b428fd9cc3df0d0ee1","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:13:46.678Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b286","editBy":{"_id":"624ff5b428fd9cc3df0d0ee1","username":"trollar","status":"offline","id":"624ff5b428fd9cc3df0d0ee1"},"message":"Create script","createdAt":"2022-04-09T05:28:34.577Z"},{"_id":"67e5e1e2b360710ec3c4b287","editBy":{"_id":"624ff5b428fd9cc3df0d0ee1","username":"trollar","status":"offline","id":"624ff5b428fd9cc3df0d0ee1"},"message":"Update script","createdAt":"2022-04-09T08:51:53.563Z"},{"_id":"67e5e1e4b360710ec3c4ef97","editBy":{"_id":"624ff5b428fd9cc3df0d0ee1","username":"trollar","status":"offline","id":"624ff5b428fd9cc3df0d0ee1"},"message":"Update script","createdAt":"2025-03-27T08:50:53.136Z"}],"comments":[{"_id":"62515552a966296794dc2311","commentBy":{"_id":"6241a0833ff2822efe36d9d3","username":"Keycan","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/06d101c34920c42aa5ff885d9054938c391c9723e079