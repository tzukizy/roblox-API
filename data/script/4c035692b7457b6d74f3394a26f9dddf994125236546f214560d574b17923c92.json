{"_id":"66605364fdf16ad325dddf09","title":"Opensource autoparry v2","game":{"_id":"67e5e1ffb360710ec3c77d8c","gameId":13772394625,"name":"Blade Ball","imageUrl":{"url":"https://media.kocakz.me/f3475fe1a1f48648db0d0610236c15d3af07856184f9e3ba538174f923e00a9e.webp","original":"https://tr.rbxcdn.com/180DAY-38e75c9ff1051ad6ca868f39be2cf095/150/150/Image/Png/noFilter"},"slug":"13772394625-blade-ball","path":"/game/13772394625-blade-ball","thumbnail":{"url":"https://media.kocakz.me/f3475fe1a1f48648db0d0610236c15d3af07856184f9e3ba538174f923e00a9e.webp","original":"https://tr.rbxcdn.com/180DAY-38e75c9ff1051ad6ca868f39be2cf095/150/150/Image/Png/noFilter"},"placeId":13772394625},"slug":"Blade-Ball-Opensource-autoparry-v2-13752","verified":false,"key":false,"keyless":false,"views":21505,"executes":226,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/1ee3583226f33369d2afc37796401d20aa9da6ce91e00b81ff553ec73796b6c0.webp","original":"https://scriptblox.com/images/sb/13772394625-1717588835967.webp","scriptblox":"https://scriptblox.com/images/script/13772394625-1717588835967.webp"},"thumbnail":{"url":"https://media.kocakz.me/1ee3583226f33369d2afc37796401d20aa9da6ce91e00b81ff553ec73796b6c0.webp","original":"https://scriptblox.com/images/sb/13772394625-1717588835967.webp","scriptblox":"https://scriptblox.com/images/script/13772394625-1717588835967.webp"},"likeCount":2,"dislikeCount":0,"createdAt":"2024-06-05T12:00:36.005Z","updatedAt":"2024-06-05T12:00:36.005Z","lastBump":"2024-06-05T12:00:36.005Z","script":"local Players = game:GetService(\"Players\")\nlocal VirtualInputManager = game:GetService(\"VirtualInputManager\")\n\nlocal Player = Players.LocalPlayer or Players.PlayerAdded:Wait()\nlocal Balls = workspace:WaitForChild(\"Balls\", 9e9)\n\nlocal function VerifyBall(Ball)\n    if typeof(Ball) == \"Instance\" and Ball:IsA(\"BasePart\") and Ball:IsDescendantOf(Balls) and Ball:GetAttribute(\"realBall\") == true then\n        return true\n    end\nend\n\nlocal function IsTarget()\n    return (Player.Character and Player.Character:FindFirstChild(\"Highlight\"))\nend\n\nlocal function Parry()\n    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)\nend\n\nBalls.ChildAdded:Connect(function(Ball)\n    if not VerifyBall(Ball) then\n        return\n    end\n\n    local OldPosition = Ball.Position\n    local OldTick = tick()\n\n    Ball:GetPropertyChangedSignal(\"Position\"):Connect(function()\n        if IsTarget() then\n            local Distance = (Ball.Position - workspace.CurrentCamera.Focus.Position).Magnitude\n            local Velocity = (OldPosition - Ball.Position).Magnitude\n\n            if (Distance / Velocity) <= 10 then\n                Parry()\n            end\n        end\n\n        if (tick() - OldTick >= 1/60) then\n            OldTick = tick()\n            OldPosition = Ball.Position\n        end\n    end)\nend)","features":"-- Working Parry Method\nbro you skid from this idgaf just be sigma and do wtv you want","tags":["opensource","open source","Blade ball"],"discord":"","keyLink":"","owner":{"_id":"65dd533169445cd64ed1fc06","username":"disser1ng","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9af0bf3b46fef1d87b431c10479b4a1652f736194dc7d87324474873facca0b2.webp","original":"https://scriptblox.com/images/photo/65dd533169445cd64ed1fc06-1791583337961.jpg"},"lvl":8,"status":"offline","id":"65dd533169445cd64ed1fc06","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/9af0bf3b46fef1d87b431c10479b4a1652f736194dc7d87324474873facca0b2.webp","original":"https://scriptblox.com/images/photo/65dd533169445cd64ed1fc06-1791583337961.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recen