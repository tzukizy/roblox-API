{"_id":"6929fe34e8674bf06e860561","title":"Open Source Silent Aim And Insta Hit","game":{"_id":"68fa6d7511ee6116892cf6af","gameId":136801880565837,"name":"[FPS] Flick","imageUrl":{"url":"https://media.kocakz.me/f7e37fca9307601e7fddba371223c8e51db1160e3fde58199c345f054373f678.webp","original":"https://tr.rbxcdn.com/180DAY-a18207a09f9bb198a153eb40402d169a/150/150/Image/Png/noFilter"},"slug":"136801880565837-flick","path":"/game/136801880565837-flick","thumbnail":{"url":"https://media.kocakz.me/f7e37fca9307601e7fddba371223c8e51db1160e3fde58199c345f054373f678.webp","original":"https://tr.rbxcdn.com/180DAY-a18207a09f9bb198a153eb40402d169a/150/150/Image/Png/noFilter"},"placeId":136801880565837},"slug":"FPS-Flick-Open-Source-Silent-Aim-And-Insta-Hit-70800","verified":false,"key":false,"keyless":false,"views":2376,"executes":592,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/17c024e7ee7702c2fe4bc317260da61c6274683de5a536ecf469c3c7d6ba75c7.webp","original":"https://scriptblox.com/images/sb/rbx-6520033018c6162771a61aac035963ef-a2b62ba4b43f.png","scriptblox":"https://scriptblox.com/images/script/rbx-6520033018c6162771a61aac035963ef-a2b62ba4b43f.png"},"thumbnail":{"url":"https://media.kocakz.me/17c024e7ee7702c2fe4bc317260da61c6274683de5a536ecf469c3c7d6ba75c7.webp","original":"https://scriptblox.com/images/sb/rbx-6520033018c6162771a61aac035963ef-a2b62ba4b43f.png","scriptblox":"https://scriptblox.com/images/script/rbx-6520033018c6162771a61aac035963ef-a2b62ba4b43f.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-11-28T19:55:32.710Z","updatedAt":"2025-11-28T19:55:32.710Z","lastBump":"2025-11-28T19:55:32.710Z","script":"local workspace = game:GetService(\"Workspace\");\nlocal players = game:GetService(\"Players\");\n\nlocal local_player = players.LocalPlayer;\nlocal camera = workspace.CurrentCamera;\n\nlocal bullet_handler = require(game:GetService(\"ReplicatedStorage\").ModuleScripts.GunModules.BulletHandler);\n\nfunction get_closest_target(range: number)\n    local closest_part, closest_distance = nil, range;\n\n    for _, player in (players:GetPlayers()) do\n        if (player == local_player) then\n            continue;\n        end\n        local character = player.Character;\n        if (not character) then\n            continue;\n        end\n        local humanoid = character:FindFirstChild(\"Humanoid\");\n        local head = character:FindFirstChild(\"Head\");\n        if (not head) or (not humanoid) or (humanoid.Health == 0) then\n            continue;\n        end\n        local screen_position, on_screen = camera:WorldToViewportPoint(head.Position);\n        if (not on_screen) then\n            continue;\n        end\n        local distance = (Vector2.new(screen_position.X, screen_position.Y) - camera.ViewportSize / 2).Magnitude;\n        if (distance < closest_distance) then\n            closest_part = head;\n            closest_distance = distance;\n        end\n    end\n\n    return closest_part;\nend\n\nlocal old = bullet_handler.Fire;\nbullet_handler.Fire = function(data)\n    local closest = get_closest_target(999);\n    if (closest) then\n        data.Force = data.Force * 1000;\n        data.Direction = (closest.Position - data.Origin).Unit;\n    end\n    return old(data);\nend","features":"Made by @kylosilly","tags":["FPS Flick","FPS Flick Script","FPS Flick Silent Aim","FPS Flick Script Undetected","SIlent Aim"],"discord":"","keyLink":"","owner":{"_id":"68c54d7e0985bed96e33514b","username":"CatBoyy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/91cc1b7e6cb57e82c46a1d70783107012e27ef6f960522852ee487d37bc849f8.webp","original":"https://scriptblox.com/images/photo/68c54d7e0985bed96e33514b-1757760986018.png"},"status":"offline","id":"68c54d7e0985bed96e33514b","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/91cc1b7e6cb57e82c46a1d70783107012e27ef6f960522852ee487d37bc849f8.webp","original":"https://scriptblox.com/images/photo/68c54d7e0985bed96e33514b-1757760986018.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:37:32.111Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6929fe34e8674bf06e860563","editBy":{"_id":"68c54d7e0985bed96e33514b","username":"CatBoyy","status":"offline","id":"68c54d7e0985bed96e33514b"},"message":"Create script","createdAt":"2025-11-28T19:55:32.712Z"}],"comments":[{"_id":"692abeda24749804a601361b","commentBy":{"_id":"64e516660a3f25e1149567dc","username":"DraWatX","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2023-08-22T20:11:18.731Z","lastActive":"2026-06-23T02:13:39.505Z","status":"offline","id":"64e516660a3f25e1149567dc","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Thanks for sharing Open Source.","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-29T09:37:30.054Z","liked":false,"disliked":false},{"_id":"692b00cca1db514033e6ea15","commentBy":{"_id":"6906aabc85617b62bc6751bd","username":"_kazama","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-11-02T00:50:04.438Z","lastActive":"2025-12-28T05:02:31.358Z","status":"offline","id":"6906aabc85617b62bc6751bd","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"@DraWatX yeye","parent":{"_id":"692abeda24749804a601361b","commentBy":{"_id":"64e516660a3f25e1149567dc","username":"DraWatX","profilePicture":"/images/user-default.webp","status":"offline","id":"64e516660a3f25e1149567dc"},"text":"Thanks for sharing Open Source."},"edited":false,"likeCount":1,"dislikeCount":0