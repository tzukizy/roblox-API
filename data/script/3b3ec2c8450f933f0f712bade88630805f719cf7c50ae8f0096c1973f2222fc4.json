{"_id":"69226c73222d0d7614f17305","title":"Rpg aura open source","game":{"_id":"67e5e1ffb360710ec3c77dc1","gameId":4639625707,"name":"[KF-41] War Tycoon","imageUrl":{"url":"https://media.kocakz.me/038677078ad94224a04dbfd5fb8f9f8e82c806e5cd291eb179d64b6ccea9912d.webp","original":"https://tr.rbxcdn.com/180DAY-2a6bcb2b9c41a379764775b308e93092/150/150/Image/Png/noFilter"},"slug":"4639625707-war-tycoon","path":"/game/4639625707-war-tycoon","thumbnail":{"url":"https://media.kocakz.me/038677078ad94224a04dbfd5fb8f9f8e82c806e5cd291eb179d64b6ccea9912d.webp","original":"https://tr.rbxcdn.com/180DAY-2a6bcb2b9c41a379764775b308e93092/150/150/Image/Png/noFilter"},"placeId":4639625707},"slug":"Stryker-War-Tycoon-Rpg-aura-open-source-69073","verified":false,"key":false,"keyless":false,"views":2617,"executes":84,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-44b6797cac8b3773d38d06f79cd465bf-24fe2c4930f6.png","scriptblox":"https://scriptblox.com/images/script/rbx-44b6797cac8b3773d38d06f79cd465bf-24fe2c4930f6.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-44b6797cac8b3773d38d06f79cd465bf-24fe2c4930f6.png","scriptblox":"https://scriptblox.com/images/script/rbx-44b6797cac8b3773d38d06f79cd465bf-24fe2c4930f6.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-23T02:07:47.775Z","updatedAt":"2025-11-23T02:07:47.775Z","lastBump":"2025-11-23T02:07:47.775Z","script":"-- lol\n\nlocal plr = game.Players.LocalPlayer\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal tool = char:WaitForChild(\"RPG\")\nlocal ev = game.ReplicatedStorage.RocketSystem.Events\nlocal fx = ev.RocketReloadedFX\nlocal fire = ev.FireRocket\nlocal hit = ev.RocketHit\nlocal cnt = 0\nlocal idx = 1\n\nlocal function tgt()\nlocal lst = {}\nfor _, w in pairs(game.Players:GetPlayers()) do\n if w ~= plr and w.Character and w.Character:FindFirstChild(\"HumanoidRootPart\") then\n  lst[#lst + 1] = w\n end\nend\nreturn lst\nend\n\nlocal function atk(w)\nlocal pos = w.Character.HumanoidRootPart.Position\nlocal dir = (pos - hrp.Position).Unit\nfx:FireServer(tool, true)\nfire:InvokeServer(vector.create(dir.X, dir.Y, dir.Z), tool, tool, vector.create(pos.X, pos.Y, pos.Z))\nhit:FireServer(\n vector.create(pos.X, pos.Y, pos.Z),\n vector.create(dir.X, dir.Y, dir.Z),\n tool,\n tool,\n w.Character.HumanoidRootPart,\n nil,\n plr.Name .. \"Rocket\" .. cnt\n)\ncnt = cnt + 1\nend\n\nspawn(function()\nwhile true do\n local lst = tgt()\n if #lst > 0 then\n  if idx > #lst then idx = 1 end\n  atk(lst[idx])\n  idx = idx + 1\n end\n wait(0.1)\nend\nend)","features":"source code","tags":["rpg"],"discord":"","keyLink":"","owner":{"_id":"680c3794a89fd911d90c8d30","username":"Cboh","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b701e59bb13da76cdd8ea6c1ac95326ff4ed420c5f00d690ec1a47ee3c3db662.webp","original":"https://scriptblox.com/images/photo/680c3794a89fd911d90c8d30-1764989424463.png"},"status":"offline","id":"680c3794a89fd911d90c8d30","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/b701e59bb13da76cdd8ea6c1ac95326ff4ed420c5f00d690ec1a47ee3c3db662.webp","original":"https://scriptblox.com/images/photo/680c3794a89fd911d90c8d30-1764989424463.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:53:24.221Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69226c73222d0d7614f17307","editBy":{"_id":"680c3794a89fd911d90c8d30","username":"Cboh","status":"offline","id":"680c3794a89fd911d90c8d30"},"message":"Create script","createdAt":"2025-11-23T02:07:47.778Z"}],"comments":[]}