{"_id":"6243f09568351ca3490ac58d","title":"Chatbot","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Chatbot-1530","verified":false,"key":false,"keyless":false,"views":18414,"executes":19,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/6758217-1648619669454.jpg","scriptblox":"https://scriptblox.com/images/script/6758217-1648619669454.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/6758217-1648619669454.jpg","scriptblox":"https://scriptblox.com/images/script/6758217-1648619669454.jpg"},"likeCount":3,"dislikeCount":1,"createdAt":"2022-03-30T05:54:29.467Z","updatedAt":"2022-03-30T05:54:29.467Z","lastBump":"2022-03-30T05:54:29.467Z","script":"local HttpService = game:GetService(\"HttpService\")\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\n--I based this script on ChatBot, but with the SimSimi api, therefore it has more accurate and fun answers XD\n\n--Modify these parameters as you want--\n\nlocal idioma = \"en\" --Here is the language you want SimSImi to respond to, es for \"Español\", en for \"English\"\n\nlocal chatfuel = \"True\" --If you want me to censor the swearing \"True\" or \"False\"\n\n--From here down I don't recommend moving him if you don't know Lua\n\nlocal function mensajepro(mensaje, jugador) --In this function the magic happens\n    local texto = mensaje\n    local Responde = game:HttpGet(\"https://api.simsimi.net/v2/?text=\"..texto..\"&lc=\"..idioma..\"&cf=\"..chatfuel) --The SimSImi api is called\n    local datos = HttpService:JSONDecode(Responde)\n    \n   wait()\n   \n   game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(jugador..\" \"..datos.success, \"All\") --A message is sent with the response of SimSImi\nend\n\n\nPlayers.PlayerChatted:Connect(function(type, plr, message) --When a player speaks\n    for _,plrs in pairs(game.Players:GetPlayers()) do\n\t\n\tif (Players.LocalPlayer.Character.HumanoidRootPart.Position - plrs.Character.HumanoidRootPart.Position).magnitude <= 10 then --If the player is nearby, SimSimi will read their message.\n\t\tif plr.Name == plrs.Name then\n\t\t    mensajepro(message, plr.Name) --The function is called\n\t\tend\n\tend\n\t\nend\nend)","features":"this is chatbot lelelel you can use it in game to troll or whatever u want \n- it will reply to anyone near you\n(i didn't make this)","tags":[],"discord":"","keyLink":"","owner":{"_id":"61f5cba968bf4a9061f9a721","username":"lucid","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61f5cba968bf4a9061f9a721-1653078972257.jpg"},"status":"offline","id":"61f5cba968bf4a9061f9a721","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61f5cba968bf4a9061f9a721-1653078972257.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:34:00.021Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4eefb","editBy":{"_id":"61f5cba968bf4a9061f9a721","username":"lucid","status":"offline","id":"61f5cba968bf4a9061f9a721"},"message":"Create script","createdAt":"2025-03-27T22:03:36.874Z"}],"comments":[{"_id":"6243f4537a1211c131df4488","commentBy":{"_id":"6241a0833ff2822efe36d9d3","usernam