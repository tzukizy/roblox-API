{"slug":"Find-the-Gubbys-(DESERT!)-Get-Every-Gubbys-42748","_id":"68542c05ee17c9140146d4cc","title":"Get Every Gubbys","game":{"_id":"6839a36edf5a1e3916423bf7","gameId":105834035548197,"name":"Find the Gubbys (134)","imageUrl":"/images/sb/rbx-6f01ed0257ee7880b3a09b773bcf5dcc-65873104bcdc.png","placeId":105834035548197},"features":"Open Source of course cuz it's simple\ntake a few minute to get Asteroid Gubby","tags":[],"script":"local a = nil\nlocal b = workspace.ToFind\nlocal c = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()\nrepeat task.wait() until c:FindFirstChild\"Head\"\n\nfor i, v in next, b:GetChildren() do\nif v:FindFirstChildWhichIsA\"TouchTransmitter\" then\nfiretouchinterest(v, c.Head, 1)\nfiretouchinterest(v, c.Head, 0)\nend\nend\n\nrepeat task.wait(.01)\nfireclickdetector(workspace.Buttons.Button1)\nfireclickdetector(workspace.Buttons.Button2)\nfireclickdetector(workspace.Buttons.Button3)\nuntil b[\"Asteroid Gubby\"].CanTouch == true\nfiretouchinterest(b[\"Asteroid Gubby\"], c.Head, 1)\nfiretouchinterest(b[\"Asteroid Gubby\"], c.Head, 0)","owner":{"_id":"659a5f3f004ff80c8fd8142b","username":"Kkk1_","verified":false,"profilePicture":"/images/photo/659a5f3f004ff80c8fd8142b-1725763402875.png","status":"offline","id":"659a5f3f004ff80c8fd8142b","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":4318,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/105834035548197-1750346757514.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-06-19T15:25:57.558Z","editBy":{"_id":"659a5f3f004ff80c8fd8142b","username":"Kkk1_","status":"offline","id":"659a5f3f004ff80c8fd8142b"},"executes":82,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68542c05ee17c9140146d4ce","editBy":{"_id":"659a5f3f004ff80c8fd8142b","username":"Kkk1_","status":"offline","id":"659a5f3f004ff80c8fd8142b"},"message":"Create script","cre