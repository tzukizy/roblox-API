{"slug":"Hood-Modded-Stomp-Skin-Changer-Open-Source-141022","_id":"69bfe7ab9d51f4c9b64bb2ee","title":"Stomp Skin Changer Open Source","game":{"_id":"67e5e1ffb360710ec3c77fe3","gameId":5602055394,"name":"[VERITY!] Hood Modded","imageUrl":"/images/sb/rbx-e6b34a60e1566cae7cfaf4180befa805-c7ada63af8a7.png","placeId":5602055394},"features":"Made by @kylosilly","tags":["Hood Modded Script","Hood Modded Stomp Changer","Hood Modded Script Keyless","Hood Modded","Hood Modded Cool Script"],"script":"-- Replace Dragon with any killfx you like make sure the name exist in killfx folder\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nReplicatedStorage.MainRemote.OnClientEvent:Connect(function(Action, ...)\n    if Action == \"FX_KILL\" then\n        local Args = {...}\n\n        local Player = Args[3]\n\n        if (Player == game:GetService(\"Players\").LocalPlayer) then\n            require(ReplicatedStorage.KillFX:FindFirstChild(\"Dragon\")).RunStompFx(\"Dragon\", Args[2], Player, Player, {function() end})\n        end\n    end\nend)","owner":{"_id":"6959d05ce248e163a217ec23","username":"BoyWife","verified":false,"profilePicture":"/images/photo/6959d05ce248e163a217ec23-1767493741070.PNG","status":"offline","id":"6959d05ce248e163a217ec23","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1072,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-836d9e7ec76e60c8f5de7ec19b6e5291-4a53ba5bec9a.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-22T12:59:23.494Z","editBy":{"_id":"6959d05ce248e163a217ec23","username":"BoyWife","status":"offline","id":"6959d05ce248e163a217ec23"},"keyLink":"","executes":177,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bfe7ab9d51f4c9b64bb2f2","editBy":{"_id":"6959d05ce248e163a217ec23","username":"BoyWife","status":"offline","id":"6959d05ce248e163a217ec23"},"message":"Create script","createdAt":