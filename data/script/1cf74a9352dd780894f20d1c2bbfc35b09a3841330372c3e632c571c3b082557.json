{"_id":"6950c82c426a0c4abcd3d11a","title":"egg","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/a95d0609be5e9c3cfecd394e789a1a9315b8c91a9d333116e0b5726b6b1382e2.webp","original":"https://scriptblox.com/images/sb/0-1766901804025.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/a95d0609be5e9c3cfecd394e789a1a9315b8c91a9d333116e0b5726b6b1382e2.webp","original":"https://scriptblox.com/images/sb/0-1766901804025.jpg"},"placeId":0},"slug":"Universal-Script-egg-79202","verified":false,"key":false,"keyless":false,"views":560,"executes":121,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/79a62048c1877ec9263118cc731f80e8305f9327548cdf942f5a04a11475e224.webp","original":"https://scriptblox.com/images/sb/0-1766901804025.jpg","scriptblox":"https://scriptblox.com/images/script/0-1766901804025.jpg"},"thumbnail":{"url":"https://media.kocakz.me/79a62048c1877ec9263118cc731f80e8305f9327548cdf942f5a04a11475e224.webp","original":"https://scriptblox.com/images/sb/0-1766901804025.jpg","scriptblox":"https://scriptblox.com/images/script/0-1766901804025.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-28T06:03:24.040Z","updatedAt":"2025-12-28T06:03:24.040Z","lastBump":"2025-12-28T06:03:24.040Z","script":"-- Egg Eating Tool Script for Executors (2025)\nlocal Player = game:GetService(\"Players\").LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\n-- 1. Tạo Tool\nlocal eggTool = Instance.new(\"Tool\")\neggTool.Name = \"EatEggTool\"\neggTool.RequiresHandle = true\neggTool.Parent = Player:WaitForChild(\"Backpack\")\n\n-- 2. Tạo hình dáng quả trứng (Handle)\nlocal handle = Instance.new(\"Part\")\nhandle.Name = \"Handle\"\nhandle.Size = Vector3.new(0.8, 1, 0.8)\nhandle.Shape = Enum.PartType.Ball\nhandle.Color = Color3.fromRGB(255, 240, 200) -- Màu trắng kem\nhandle.Material = Enum.Material.Plastic\nhandle.Parent = eggTool\n\n-- 3. Thêm âm thanh khi ăn\nlocal eatSound = Instance.new(\"Sound\")\neatSound.SoundId = \"rbxassetid://131237241\" -- ID âm thanh nhai (Crunch)\neatSound.Volume = 1\neatSound.Parent = handle\n\n-- 4. Xử lý sự kiện khi nhấn chuột để ăn\neggTool.Activated:Connect(function()\n    eggTool.Enabled = false -- Chặn nhấn liên tục\n    \n    -- Hiệu ứng ăn (Đưa tay lên)\n    local anim = Instance.new(\"Animation\")\n    anim.AnimationId = \"rbxassetid://204328711\" -- ID hành động ăn cơ bản\n    local loadAnim = Humanoid:LoadAnimation(anim)\n    loadAnim:Play()\n    \n    -- Đợi một chút rồi phát âm thanh\n    task.wait(0.3)\n    eatSound:Play()\n    \n    -- Thông báo\n    game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\n        Title = \"Yummy!\",\n        Text = \"you ate the egg!\",\n        Duration = 2\n    })\n    \n    -- Xóa quả trứng sau khi ăn xong\n    task.wait(0.5)\n    eggTool:Destroy() \n    \n    -- Gửi lệnh nhận thưởng đến Server (Nếu bạn biết RemoteEvent của game)\n    -- Ví dụ: game:GetService(\"ReplicatedStorage\").Events.AddHealth:FireServer(20)\nend)\n","features":"idk","tags":[],"discord":"","keyLink":"","owner":{"_id":"69423bf6062c3834e2e722bb","username":"sweet_orange","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5b4bbeb3c8f0764540c9d7e1f3890a0a6b0333be9370c841a17aa9d57bad75de.webp","original":"https://scriptblox.com/images/photo/69423bf6062c3834e2e722bb-1765948455389.jpg"},"status":"offline","id":"69423bf6062c3834e2e722bb","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/5b4bbeb3c8f0764540c9d7e1f3890a0a6b0333be9370c841a17aa9d57bad75de.webp","original":"https://scriptblox.com/images/photo/69423bf6062c3834e2e722bb-1765948455389.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b