st\") or descendente:IsA(\"ValueBase\") then\n                descendente:Destroy()\n            end\n            \n            if descendente:IsA(\"BasePart\") then\n                descendente.CanTouch = false\n                descendente.CanQuery = false\n            end\n        end\n    end\nend\n\nworkspace.DescendantAdded:Connect(function(novo)\n    if nomesAlvos[novo.Name] or (novo.Parent and nomesAlvos[novo.Parent.Name]) then\n        desarmar(nomesAlvos[novo.Name] and novo or novo.Parent)\n    end\nend)\n\nfor _, v in pairs(workspace:GetDescendants()) do\n    desarmar(v)\nend","features":":)","tags":["open source","IA","Brainrot"],"discord":"","keyLink":"","owner":{"_id":"67a69b7587f82a0c8825f644","username":"4Mine","verified":false,"profilePicture":{"url":"https://media.kocakz.me/110f95bbb458c3d316c8b87fed5cfac8fd61d0a71ee1f6cb93f96dc38e80177b.webp","original":"https://scriptblox.com/images/photo/67a69b7587f82a0c8825f644-1762558525959.png"},"status":"offline","id":"67a69b7587f82a0c8825f644","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/110f95bbb458c3d316c8b87fed5cfac8fd61d0a71ee1f6cb93f96dc38e80177b.webp","original":"https://scriptblox.com/images/photo/67a69b7587f82a0c8825f644-1762558525959.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:45:25.777Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"698036570969f10d577e296e","editBy":{"_id":"67a69b7587f82a0c8825f644","username":"4Mine","status":"offline","id":"67a69b7587f82a0c8825f644"},"message":"Create script","createdAt":"2026-02-02T05:29:59.961Z"}],"comments":[{"_id":"6980371410146ba1eeff00fc","commentBy":{"_id":"68fc56dcdc97b5c4c08990c6","username":"ameloxick","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","orig