e\")\n\n    if remote and sound then\n        print(\"[*] RemoteEvent located. Starting continuous stat gain...\")\n\n        while true do\n            sound:Play(\"KameFire\")\n\n            remote:FireServer(\"SphereDestruction\", Vector3.new(-20212.90625, 1291.672067421875, -21308.94921875))\n            wait(0.1)\n        end\n    else\n        print(\"[!] RemoteEvent or Sound not found.\")\n    end\nelse\n    print(\"[!] Tool not found.\")\nend\n","features":"I got tired of farming KI so i made a script that's 10x faster than doing it yourself go to any area with a training multiplier and watch the numbers go up\n\n(The Script sometimes takes a few minutes to start)\n(DO NOT CHARGE KI IT WILL BREAK THE SCRIPT)","tags":["DragonballZ","Dragon","Dragon Ball","Dragon Ball Legend","Dragon Ball Legendary Forces"],"discord":"","keyLink":"","owner":{"_id":"67541b4dab3917973b2118b7","username":"Rizukuu","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dd38f4cef4f411535e1dfa37591735c5faa2197d8dcfad95e80d27864c11fe95.webp","original":"https://scriptblox.com/images/photo/67541b4dab3917973b2118b7-1735545244452.png"},"status":"offline","id":"67541b4dab3917973b2118b7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/dd38f4cef4f411535e1dfa37591735c5faa2197d8dcfad95e80d27864c11fe95.webp","original":"https://scriptblox.com/images/photo/67541b4dab3917973b2118b7-1735545244452.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:12:47.231Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d4da","editBy":{"_id":"67541b4dab3917973b2118b7","username":"Rizukuu","status":"offline","id":"67541b4dab3917973b2118b7"},"message":"Create script","createdAt":"2024-12-30T09:10:23.072Z"},{"_id":"67e5e1e6b360710ec3c53d46","edi