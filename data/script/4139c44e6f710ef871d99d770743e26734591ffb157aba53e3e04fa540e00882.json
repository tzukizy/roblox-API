{"_id":"6942e39149abd0da143efbf8","title":"open source old","game":{"_id":"67e5e1ffb360710ec3c77d92","gameId":15002061926,"name":"[UPD] Death Ball","imageUrl":{"url":"https://media.kocakz.me/c971893b367614f77a1562f4585f25f7a9b4f1d4597df6122c6aa3ea447e1a4d.webp","original":"https://tr.rbxcdn.com/180DAY-7c9478c13cac3874f35f736d5db1f2b7/150/150/Image/Png/noFilter"},"slug":"15002061926-death-ball","path":"/game/15002061926-death-ball","thumbnail":{"url":"https://media.kocakz.me/c971893b367614f77a1562f4585f25f7a9b4f1d4597df6122c6aa3ea447e1a4d.webp","original":"https://tr.rbxcdn.com/180DAY-7c9478c13cac3874f35f736d5db1f2b7/150/150/Image/Png/noFilter"},"placeId":15002061926},"slug":"Death-Ball-open-source-75728","verified":false,"key":false,"keyless":false,"views":6541,"executes":84,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/1e910e59746940bad45d2c8cfa6db9e32a927d5b94b3cb6c870ccc7f7f6469fa.webp","original":"https://scriptblox.com/images/sb/rbx-0ec094471a4413b54a2ed36a3fcf0c3e-bb594616976c.png","scriptblox":"https://scriptblox.com/images/script/rbx-0ec094471a4413b54a2ed36a3fcf0c3e-bb594616976c.png"},"thumbnail":{"url":"https://media.kocakz.me/1e910e59746940bad45d2c8cfa6db9e32a927d5b94b3cb6c870ccc7f7f6469fa.webp","original":"https://scriptblox.com/images/sb/rbx-0ec094471a4413b54a2ed36a3fcf0c3e-bb594616976c.png","scriptblox":"https://scriptblox.com/images/script/rbx-0ec094471a4413b54a2ed36a3fcf0c3e-bb594616976c.png"},"likeCount":11,"dislikeCount":3,"createdAt":"2025-12-17T17:08:33.278Z","updatedAt":"2025-12-17T17:08:33.278Z","lastBump":"2025-12-17T17:08:33.278Z","script":"local RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal VirtualInputManager = game:GetService(\"VirtualInputManager\")\n\nlocal Player = Players.LocalPlayer\nlocal BallShadow = nil\nlocal BallObject = nil\nlocal PreviousPosition = nil\nlocal LastParry = 0\n\nlocal function GetBallColor(target)\n\tif not target then return Color3.new(1, 1, 1) end\n\tlocal highlight = target:FindFirstChildOfClass(\"Highlight\")\n\tif highlight then return highlight.FillColor end\n\treturn target:IsA(\"Part\") and target.Color or Color3.new(1, 1, 1)\nend\n\nlocal function GetVisualHeight(shadow)\n\tif not shadow then return 0 end\n\treturn math.min(((math.max(0, shadow.Size.X - 5)) * 20) + 3, 100)\nend\n\nlocal function TriggerParry()\n\tVirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)\n\tVirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)\nend\n\nRunService.RenderStepped:Connect(function(dt)\n\tBallShadow = (BallShadow and BallShadow.Parent) and BallShadow or workspace.FX:FindFirstChild(\"BallShadow\")\n\tBallObject = (BallObject and BallObject.Parent) and BallObject or (workspace:FindFirstChild(\"Ball\") or workspace:FindFirstChild(\"Part\"))\n\n\tif not BallShadow or not BallObject or not Player.Character or not Player.Character.PrimaryPart then\n\t\tPreviousPosition = nil\n\t\treturn\n\tend\n\n\tlocal rootPart = Player.Character.PrimaryPart\n\tlocal height = GetVisualHeight(BallShadow)\n\tlocal currentPos = Vector3.new(BallShadow.Position.X, BallShadow.Position.Y + height, BallShadow.Position.Z)\n\n\tif PreviousPosition then\n\t\tlocal velocity = (currentPos - PreviousPosition).Magnitude / dt\n\t\tlocal ping = Player:GetNetworkPing()\n\t\t\n\t\tlocal dynamicDistance = 15 + (velocity * ping * 0.3)\n\t\tlocal flatDistance = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(currentPos.X, 0, currentPos.Z)).Magnitude\n\n\t\tif GetBallColor(BallObject) ~= Color3.new(1, 1, 1) then\n\t\t\tif flatDistance <= dynamicDistance and (tick() - LastParry) > 0.01 then\n\t\t\t\tTriggerParry()\n\t\t\t\tLastParry = tick()\n\t\t\tend\n\t\tend\n\tend\n\n\tPreviousPosition = currentPos\nend)","features":"very good auto parry","tags":[],"discord":"","keyLink":"","owner":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b7c227c7d6637a2129f6888d5b89156a38e5e14451be44979f91ced984396df5.webp","original":"https://scriptblox.com/images/photo/67bd8d2e1ec2c16a13a94ae0-1750370853982.jpg"},"status":"offline","id":"67bd8d2e1ec2c16a13a94ae0","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/b7c227c7d6637a2129f6888d5b89156a38e5e14451be44979f91ced984396df5.webp","original":"https://scriptblox.com/images/photo/67bd8d2e1ec2c16a13a94ae0-1750370853982.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:42:29.167Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6942e39149abd0da143efbfa","editBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0"},"message":"Create script","createdAt":"2025-12-17T17:08:33.281Z"},{"_id":"6942eb34591af5a223c03aed","editBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0"},"message":"Update script","createdAt":"2025-12-17T17:41:08.343Z"},{"_id":"69438fba581c677782858602","editBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0"},"message":"Update script","createdAt":"2025-12-18T05:23:06.886Z"},{"_id":"6943a9330d904aa5d114a165","editBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0"},"message":"Update script","createdAt":"2025-12-18T07:11:47.381Z"},{"_id":"6943ab93cfad1856c5d55945","editBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0"},"message":"Update script","createdAt":"2025-12-18T07:21:55.110Z"},{"_id":"6943b2780d904aa5d1150fb3","editBy":{"_id":"67bd8d2e1ec2c