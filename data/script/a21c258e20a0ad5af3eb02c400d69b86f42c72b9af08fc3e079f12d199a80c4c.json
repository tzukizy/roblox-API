ild(\"monochrome\"):WaitForChild(\"Keypad\")\n\nlocal cleanCode = string.gsub(digitsLabel.Text, \"%D\", \"\")\n\nif #cleanCode == 4 then\n\ttask.wait(0.5)\n\n\tfor index = 1, 4 do\n\t\tlocal digitValue = tonumber(string.sub(cleanCode, index, index))\n\t\tlocal digitPart = keypadFolder:FindFirstChild(\"Digit\" .. index)\n\n\t\tif digitPart then\n\t\t\tlocal clickDetector = digitPart:FindFirstChildOfClass(\"ClickDetector\")\n\t\t\tif clickDetector then\n\t\t\t\tfor i = 1, digitValue do\n\t\t\t\t\tfireclickdetector(clickDetector)\n\t\t\t\t\ttask.wait(0.15)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\ttask.wait(0.4)\n\tend\nend","features":"So basically this code only works in Part 1 and when you execute it, it automatically enters the code in the elevator lock and unlocks the code lock (open source)","tags":["monochrome","code","instant code"],"discord":"","keyLink":"","owner":{"_id":"6a43793c3e2fa9b241749d7a","username":"expresso5184","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a020f80f163856baf760fc4b1106178d228a79c5889de8241c174d3a22fa59ce.webp","original":"https://scriptblox.com/images/photo/6a43793c3e2fa9b241749d7a-1782806890557.jpg"},"lvl":5,"status":"offline","id":"6a43793c3e2fa9b241749d7a","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/a020f80f163856baf760fc4b1106178d228a79c5889de8241c174d3a22fa59ce.webp","original":"https://scriptblox.com/images/photo/6a43793c3e2fa9b241749d7a-1782806890557.jpg"}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-11T06:33:34.936Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-19T16:36:27.794Z","last":"w","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ac3f09d0935020175405f45","editBy":{"_id":"6a43793c3e2fa9b241749d7a","username"