{"slug":"UPD-Sword-Fishing-Instant-Inf-Fish-71706","_id":"692d6df23f362f81e6c0aea9","title":"Instant Inf Fish","game":{"_id":"6928528d667f7c83443beaa2","gameId":104237125762426,"name":" [⚔️ UPD] Sword Fishing","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":104237125762426},"features":"Instant Inf Fish I guess\n\n•How to use : first of all throw your hook in the water, then click the button for it to work.\n\n•Yes it will definitely lag🤓","tags":["weaponfishing","script","free"],"script":"\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"RodEventGui\"\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 140, 0, 40)\nbutton.Position = UDim2.new(0.5, -70, 0.5, -20)\nbutton.Text = \"Catch With Rods\"\nbutton.BackgroundColor3 = Color3.fromRGB(40, 170, 255)\nbutton.TextColor3 = Color3.new(1,1,1)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextScaled = true\nbutton.Parent = screenGui\nbutton.Active = true\n\nlocal dragging\nlocal dragInput\nlocal dragStart\nlocal startPos\n\nlocal function update(input)\n    local delta = input.Position - dragStart\n    button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\nend\n\nbutton.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n        dragging = true\n        dragStart = input.Position\n        startPos = button.Position\n\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\nbutton.InputChanged:Connect(function(input)\n    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then\n        dragInput = input\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputChanged:Connect(function(input)\n    if dragging and input == dragInput then\n        update(input)\n    end\nend)\n\n\nbutton.MouseButton1Click:Connect(function()\n    for _, tool in ipairs(player.Character:GetChildren()) do\n        if tool:FindFirstChild(\"RodEvent\") and tool.RodEvent.FireServer then\n            local args = {\n                [1] = { [\"action\"] = \"Catch\" }\n            }\n            for i = 1, 1000 do\n                tool.RodEvent:FireServer(unpack(args))\n            end\n        end\n    end\nend)","owner":{"_id":"6649aca304e17bb63806e0ea","username":"1kzuya","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3a029cab0f1e2222fa27e59c12940272bcc562923d625a63bb56def83a89e28d.webp","original":"https://scriptblox.com/images/photo/6649aca304e17bb63806e0ea-1771732170530.jpg"},"status":"offline","id":"6649aca304e17bb63806e0ea","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/3a029cab0f1e2222fa27e59c12940272bcc562923d625a63bb56def83a89e28d.webp","original":"https://scriptblox.com/images/photo/6649aca304e17bb63806e0ea-1771732170530.jpg"}},"verified":false,"views":4473,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-b32a15285561a359464497a84986e9f1-f7f165225f32.png","scriptblox":"https://scriptblox.com/images/script/rbx-b32a15285561a359464497a84986e9f1-f7f165225f32.png"},"likeCount":15,"dislikeCount":3,"createdAt":"2025-12-01T10:29:06.432Z","keyLink":"","executes":26,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":