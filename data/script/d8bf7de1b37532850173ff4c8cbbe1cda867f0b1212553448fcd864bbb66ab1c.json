Players.LocalPlayer.UserId, 3401104590, true)\n    end,\n})\n\nWindow:AddButton({\n    text = \"Instant Rebirth\",\n    flag = \"button\",\n    callback = function()\n        game.MarketplaceService:SignalPromptProductPurchaseFinished(game.Players.LocalPlayer.UserId, 3401108845, true)\n    end,\n})\n\nWindow:AddButton({\n    text = \"Scare All\",\n    flag = \"button\",\n    callback = function()\n        game.MarketplaceService:SignalPromptProductPurchaseFinished(game.Players.LocalPlayer.UserId, 3450911952, true)\n    end,\n})\n\nWindow:AddToggle({\n    text = \"Spam Strength\",\n    flag = \"toggle\",\n    state = false,\n    callback = function(state)\n        _G.Strength = state\n        print(\"Strength: \", state)\n        if state then\n            Strength()\n        end\n    end,\n})\n\nfunction Strength()\n    spawn(function()\n        _G.Strength = true\n        while _G.Strength do\n            wait()\n            pcall(function()\n                game.MarketplaceService:SignalPromptProductPurchaseFinished(game.Players.LocalPlayer.UserId, 3401104590, true)\n                wait()\n            end)\n        end\n    end)\nend\n\nWindow:AddLabel({ text = \"YouTube: Tora IsMe\" })\nLibrary:Init()","owner":{"_id":"66f2a832f104938f6ef096dd","username":"ToraIsMeSource","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0336ba26575c62925df7bce10efa2a88e28370f51720e294a17b3cd6c9d92c09.webp","original":"https://scriptblox.com/images/photo/66f2a832f104938f6ef096dd-1763989263245.jpg"},"status":"offline","id":"66f2a832f104938f6ef096dd","profile":{"url":"https://cdn.kocakz.me/images/0336ba26575c62925df7bce10efa2a88e28370f51720e294a17b3cd6c9d92c09.webp","original":"https://scriptblox.com/images/photo/66f2a832f104938f6ef096dd-1763989263245.jpg"}},"verified":false,"views":3694,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/f1d8ab6b5c1684ee88d621c78444b30774b858da23cf74977ab