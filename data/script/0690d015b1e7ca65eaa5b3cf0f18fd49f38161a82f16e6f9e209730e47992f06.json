{"_id":"620924a8bdc15d40607ca7cc","title":"⭐ 'Optifine' Zoom Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"'Optifine'-Zoom-Script_720","verified":false,"key":false,"keyless":false,"views":10776,"executes":475,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/7332477-1644766376962.jpg","scriptblox":"https://scriptblox.com/images/script/7332477-1644766376962.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/7332477-1644766376962.jpg","scriptblox":"https://scriptblox.com/images/script/7332477-1644766376962.jpg"},"likeCount":3,"dislikeCount":0,"createdAt":"2022-02-13T15:32:56.968Z","updatedAt":"2022-02-13T15:32:56.968Z","lastBump":"2022-02-13T15:32:56.968Z","script":"local oldZoom = game.Workspace.CurrentCamera.FieldOfView\n\nlocal Settings = {\n    ZoomTime = 0.2,\n    ZoomedAmount = 10\n}\n\nlocal function createZoom(time, amount)\n    local Tween_Info = TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) \n    local Tween = game:GetService(\"TweenService\"):Create(game.Workspace.CurrentCamera, Tween_Info, {FieldOfView = amount})\n    return Tween\nend\n\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.C then\n        createZoom(Settings.ZoomTime, Settings.ZoomedAmount):Play()\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputEnded:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.C then\n        createZoom(Settings.ZoomTime, oldZoom):Play()\n    end\nend)","features":"Basic zoom / FOV script for any game, the lower the 'ZoomedAmount' the more it zooms in. 10 is the recommended number. Double executing will not work, I recommend you play around with the number if you aren't happy with 10. First-person is also recommended.\n\nBIND: C","tags":["zoom","optifine","universal"],"discord":"","keyLink":"","owner":{"_id":"61d1176e18cdb53bdd66c89c","username":"skem","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"61d1176e18cdb53bdd66c89c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:14:52.964Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e739","editBy":{"_id":"61d1176e18cdb53bdd66c89c","username":"skem","status":"offline","id":"61d1176e18cdb53bdd66c89c"},"message":"Create script","createdAt":"2025-03-27T22:52:36.606Z"}],"comments":[{"_id":"62094cee7c5fa9a06bc9f3f3","commentBy":{"_id":"620644a20419909dd6f9cdde","username":"zenya","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/44747cd5d8c2ed1b616bb583ba888ae5d62e33dc425def8ff1e7accb66aa3d86.webp","original":"https://scriptblox.com/images/photo/620644a20419909dd6f9cdde-1743207307219.jpg"},"createdAt":"2022-02-11T11:12:34.339Z","lastActive":"2025-03-30T02:20:58.678Z","status":"offline","id":"620644a20419909dd6f9cdde","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/44747cd5d8c2ed1b616bb583ba888ae5d62e33dc425def8ff1e7accb66aa3d86.webp","original":"https://scriptblox.com/images/photo/620644a20419909dd6f9cdde-1743207307219.jpg"}},"text":"minecraft?","createdAt":"2022-02-13T18:24:46.087Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"620966158b3671e7d681c511","commentBy":{"_id":"62057fe6fd73e7969948d771","username":"VampireKiller","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-02-10T21:13:10.288Z","lastActive":"2024-01-26T09:26:22.433Z","status":"offline","id":"62057fe6fd73e7969948d771","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Finally i can now play minecraft copy games with optifine and esp mods","createdAt":"2022-02-13T20:12:05.927Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"6232284b19a567642f88a9fc","commentBy":{"_id":"62136fd3835db1c8d573e7b9","username":"casofe6027","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-02-21T10:56:19.963Z","lastActive":"2022-03-25T07:46:46.713Z","status":"offline","id":"62136fd3835db1c8d573e7b9","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"finally i can play roblox without the ugly *** 60 FOV","createdAt":"2022-03-16T18:11:23.225Z","edited":true,"likeCount":1,"liked":false,"disliked":false}]}