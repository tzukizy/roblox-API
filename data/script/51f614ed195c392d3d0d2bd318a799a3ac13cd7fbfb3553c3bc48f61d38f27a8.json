ath.clamp(_G.DodgeSize,1.5,3)\nlocal Sizeto = v.Size + Vector3.new(side,100,side)\na.Size = Vector3.new(0,100,v.Size.Z)\nif v.ClassName == \"MeshPart\" then\na.Size = Vector3.new(0,0,100)\nSizeto = v.Size + Vector3.new(side,side,100)\nend\ngame:GetService(\"TweenService\"):Create(a,TweenInfo.new(0.08),{Size = Sizeto}):Play()\na.Anchored = true\na.Transparency = 1\na.CanCollide = true\na.Name = \"DODGEPART\"\na.Parent = v.Parent\nlocal start = tick()\nrepeat\nwait()\nuntil tick() - start > _G.NoClipAfter or not v.Parent\na:Destroy()\nend\nend)\nlocal Barrier = workspace.GameMap:FindFirstChild(\"Barrier\",true)\nif Barrier then Barrier:ClearAllChildren() end\nfunction GetPing()\nspawn(function()\nif not list.get_ping_cd then\nlist.get_ping_cd = true\nlocal PacketSend = tick()\nlocal Packet = game:GetService(\"ReplicatedStorage\").RemoteFunctions.MainRemoteFunction:InvokeServer(\"CompleteDailyQuest\",\"DailyQuest_DungeonClear\")\nrepeat task.wait() until Packet\nlocal Ping = tick() - PacketSend\nlist.ping = Ping\ndelay(1,function()\nlist.get_ping_cd = false\nend)\nend\nend)\nreturn list.ping\nend\nfunction Connection(Char)\nlocal Human = Char:WaitForChild(\"Humanoid\")\nlocal Root = Char:WaitForChild(\"HumanoidRootPart\")\nlocal Name = Char:FindFirstChild(\"PlayerName\",true)\nif _G.NameProof and Name then Name:Destroy() end\nwhile task.wait() do\nif not Root then break end\nlocal SpawnLocation = game.Players.LocalPlayer.RespawnLocation\nlocal CFR = Root.CFrame\nif SpawnLocation.Position.Y - CFR.p.Y > 30 then\nlocal RayParams = RaycastParams.new()\nRayParams.FilterDescendantsInstances = Char:GetDescendants()\nRayParams.FilterType = Enum.RaycastFilterType.Blacklist\nlocal Ray = workspace:Raycast(CFR.p,Vector3.new(0,-100,0),RayParams)\nif Ray then\nRoot.CFrame = CFrame.new(CFR.X,SpawnLocation.Position.Y+15,CFR.Z)\nelse\nRoot.CFrame = SpawnLocation.CFrame\nend\nend\nHuman:SetStateEnabled(14,false)\nHuman:SetStateEnabled(1,false)\nif not Char then break end\nend\nend\ngame.Players.LocalPlayer.CharacterAdded:Connect(Connection)\nConnection(game.Players.LocalPlayer.Character)","features":"Auto Dodge.","tags":[],"discord":"","keyLink":"","owner":{"_id":"6207bd548b3671e7d67e2fe9","username":"XetzuScripts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/21ac7d4bbd56aecd234991fd6fd403eab5782580d392d2b31a184319d42e2517.webp","original":"https://scriptblox.com/images/photo/6207bd548b3671e7d67e2fe9-1747254716708.jpg"},"status":"offline","id":"6207bd548b3671e7d67e2fe9","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/21ac7d4bbd56aecd234991fd6fd403eab5782580d392d2b31a184319d42e2517.webp","original":"https://scriptblox.com/images/photo/6207bd548b3671e7d67e2fe9-1747254716708.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:12:00.601Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4ef75","editBy":{"_id":"6207bd548b3671e7d67e2fe9","username":"XetzuScripts","status":"offline","id":"6207bd548b3671e7d67e2fe9"},"message":"Create script","createdAt":"2025-03-27T21:44:17.913Z"}],"comments":[{"_id":"6245cb0d81648d274b849440","commentBy":{"_id":"623d3b79adca6025b846c2ae","username":"yomikooeo","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-03-25T03:48:09.550Z","lastActive":"2022-04-26T14:46:45.158Z","status":"offline","id":"623d3b79adca6025b846c2ae","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"how do i use this","createdAt":"2022-03-31T15:38:53.667Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"6245e39f81e18cfd33f1500c","commentBy":{"_id":"621d1f234432ac2d233c97db","username":"hacker999","verified":false,"role":"user","profilePicture":{"u