{"_id":"6949d62731e76adf3164a884","title":"Ultra Instinct","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/f2dfce04ea37f1db978cc8d5ecf34394e53cfcbe0d1bd4e139041729926c71d4.webp","original":"https://scriptblox.com/images/sb/0-1766446631839.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/f2dfce04ea37f1db978cc8d5ecf34394e53cfcbe0d1bd4e139041729926c71d4.webp","original":"https://scriptblox.com/images/sb/0-1766446631839.jpg"},"placeId":0},"slug":"Universal-Script-Ultra-Instinct-77417","verified":false,"key":false,"keyless":false,"views":2487,"executes":5129,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5f7d0d9f1300cd70a21620a30e012ace4098cd063f7544108599e5965e177ace.webp","original":"https://scriptblox.com/images/sb/0-1766446631839.jpg","scriptblox":"https://scriptblox.com/images/script/0-1766446631839.jpg"},"thumbnail":{"url":"https://media.kocakz.me/5f7d0d9f1300cd70a21620a30e012ace4098cd063f7544108599e5965e177ace.webp","original":"https://scriptblox.com/images/sb/0-1766446631839.jpg","scriptblox":"https://scriptblox.com/images/script/0-1766446631839.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-22T23:37:11.853Z","updatedAt":"2025-12-22T23:37:11.853Z","lastBump":"2025-12-22T23:37:11.853Z","script":"--Hello :D\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal enabled = false\n\nlocal CHECK_DISTANCE = 8\nlocal TELEPORT_DISTANCE = 10\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\tif input.KeyCode == Enum.KeyCode.U then\n\t\tenabled = not enabled\n\t\tprint(\"Teleport Avoidance:\", enabled and \"ON\" or \"OFF\")\n\tend\nend)\n\nRunService.Heartbeat:Connect(function()\n\tif not enabled then return end\n\n\tlocal character = player.Character\n\tif not character then return end\n\n\tlocal root = character:FindFirstChild(\"HumanoidRootPart\")\n\tif not root then return end\n\n\tfor _, otherPlayer in ipairs(Players:GetPlayers()) do\n\t\tif otherPlayer ~= player then\n\t\t\tlocal otherChar = otherPlayer.Character\n\t\t\tif otherChar then\n\t\t\t\tlocal otherRoot = otherChar:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif otherRoot then\n\t\t\t\t\tlocal distance = (root.Position - otherRoot.Position).Magnitude\n\n\t\t\t\t\tif distance <= CHECK_DISTANCE then\n\t\t\t\t\t\tlocal direction = (root.Position - otherRoot.Position).Unit\n\t\t\t\t\t\tlocal newPosition = root.Position + direction * TELEPORT_DISTANCE\n\n\t\t\t\t\t\troot.CFrame = CFrame.new(newPosition)\n\t\t\t\t\t\tbreak\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend)\n","features":"It dodges players coming near you, and it isnt that good i know, but mybe ill update it","tags":[],"discord":"","keyLink":"","owner":{"_id":"6889f581e2afed33bdfceef6","username":"ronasang1","verified":false,"profilePicture":{"url":"https://media.kocakz.me/92bdd2cfe418478c2cde597b28fb6eabae72422465b503c6bad50dabf6089bae.webp","original":"https://scriptblox.com/images/photo/6889f581e2afed33bdfceef6-1753872637741.jpeg"},"status":"offline","id":"6889f581e2afed33bdfceef6","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/92bdd2cfe418478c2cde597b28fb6eabae72422465b503c6bad50dabf6089bae.webp","original":"https://scriptblox.com/images/photo/6889f581e2afed33bdfceef6-1753872637741.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:36:09.834Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6949d62731e76adf3164a886","editBy":{"