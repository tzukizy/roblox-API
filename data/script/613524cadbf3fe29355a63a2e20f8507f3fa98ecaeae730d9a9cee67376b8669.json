{"_id":"69a67c12fe48cdb2262e1360","title":"Enable jumping","game":{"_id":"6981359728b1bd57abd38ca9","gameId":95031942074003,"name":"🌋 AnkleBreakers 🌋","imageUrl":{"url":"https://media.kocakz.me/3a811571975d74c727bec71f14385b62dc2a6f6568224a4cfb0acb760cad96ff.webp","original":"https://tr.rbxcdn.com/180DAY-b7a604b089fecec5d70007f9e6a1e85a/150/150/Image/Png/noFilter"},"slug":"95031942074003-anklebreakers","path":"/game/95031942074003-anklebreakers","thumbnail":{"url":"https://media.kocakz.me/3a811571975d74c727bec71f14385b62dc2a6f6568224a4cfb0acb760cad96ff.webp","original":"https://tr.rbxcdn.com/180DAY-b7a604b089fecec5d70007f9e6a1e85a/150/150/Image/Png/noFilter"},"placeId":95031942074003},"slug":"AnkleBreakers-Enable-jumping-127511","verified":false,"key":false,"keyless":false,"views":429,"executes":169,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f1856592ea2e0932a76c575e972784649f508317e6ebea5045554a06f28589b1.webp","original":"https://scriptblox.com/images/sb/rbx-70bd3c1de63e4d7d7353aab4160ab839-3e22f1091e27.png","scriptblox":"https://scriptblox.com/images/script/rbx-70bd3c1de63e4d7d7353aab4160ab839-3e22f1091e27.png"},"thumbnail":{"url":"https://media.kocakz.me/f1856592ea2e0932a76c575e972784649f508317e6ebea5045554a06f28589b1.webp","original":"https://scriptblox.com/images/sb/rbx-70bd3c1de63e4d7d7353aab4160ab839-3e22f1091e27.png","scriptblox":"https://scriptblox.com/images/script/rbx-70bd3c1de63e4d7d7353aab4160ab839-3e22f1091e27.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-03T06:13:38.382Z","updatedAt":"2026-03-03T06:13:38.382Z","lastBump":"2026-03-03T06:13:38.382Z","script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal DEFAULT_JUMP_POWER = 50\n\npcall(function()\n    game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\n        Title = \"Script Loaded\",\n        Text = \"Made By Swisher\",\n        Duration = 5\n    })\nend)\n\nUserInputService.JumpRequest:Connect(function()\n    local character = player.Character\n    if not character then return end\n    \n    local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    if not humanoid then return end\n\n    if humanoid.FloorMaterial ~= Enum.Material.Air then\n        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)\n        \n        if humanoid.UseJumpPower then\n            if humanoid.JumpPower <= 0 then humanoid.JumpPower = DEFAULT_JUMP_POWER end\n        else\n            if humanoid.JumpHeight <= 0 then humanoid.JumpHeight = 7.2 end\n        end\n\n        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n    end\nend)","features":"Enable jumping","tags":["Anklebreakers"],"discord":"","keyLink":"","owner":{"_id":"696f4719c2959559a8c851e7","username":"Swisher","verified":false,"profilePicture":{"url":"https://media.kocakz.me/04b6e5104bc0013e16a847b973e384b16a8ad274b6b8f9079d148a5793f01709.webp","original":"https://scriptblox.com/images/photo/696f4719c2959559a8c851e7-1770449644050.jpeg"},"status":"offline","id":"696f4719c2959559a8c851e7","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/04b6e5104bc0013e16a847b973e384b16a8ad274b6b8f9079d148a5793f01709.webp","original":"https://scriptblox.com/images/photo/696f4719c2959559a8c851e7-1770449644050.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:31:21.751Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a67c12fe48cdb2262e1363","editBy":{"_id":"696f4719c2959559a8c851e7","username":"Swisher","status":"offline","id":"696f4719c2959559a8c851e7"},"message":"Create script","createdAt":"2026-03-03T06:13:38.385Z"}],"comments":[]}