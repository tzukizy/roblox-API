{"_id":"66f5f20d6ff82bde29ba1703","title":"Rdite Script","game":{"_id":"67e5e1ffb360710ec3c78d6f","gameId":11108419601,"name":"Slide Into Rdite!","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"11108419601-slide-into-rdite","path":"/game/11108419601-slide-into-rdite","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":11108419601},"slug":"Slide-Into-Rdite!-Rdite-Script-19070","verified":false,"key":false,"keyless":false,"views":20608,"executes":4,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/e5ad613d63aa9eeaf0d77fd6a2490540/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/e5ad613d63aa9eeaf0d77fd6a2490540/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/e5ad613d63aa9eeaf0d77fd6a2490540/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/e5ad613d63aa9eeaf0d77fd6a2490540/500/280/Image/Jpeg"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-09-26T23:45:17.489Z","updatedAt":"2024-09-26T23:45:17.489Z","lastBump":"2024-09-26T23:45:17.489Z","script":"game.Workspace.Finish.Teleporter.Name = \"Teleporter1\"\nlocal fixedSpeed = 1400\n\nlocal function startTweening()\n    local TweenService = game:GetService(\"TweenService\")\n    local player = game.Players.LocalPlayer\n\n    while true do\n        wait()\n        local character = player.Character or player.CharacterAdded:Wait()\n        local finishSpawn = workspace.FinishSpawn.Position\n        local teleporter = workspace.Finish.Teleporter.Position\n        local teleporter1 = workspace.Finish.Teleporter1\n\n        local function tweenToPosition(targetPosition)\n            local distance = (character.PrimaryPart.Position - targetPosition).magnitude\n            local duration = distance / fixedSpeed\n            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)\n            local goal = {Position = targetPosition}\n            \n            local tween = TweenService:Create(character.PrimaryPart, tweenInfo, goal)\n            tween:Play()\n            tween.Completed:Wait()\n        end\n        \n        wait(2)\n        \n        tweenToPosition(finishSpawn)\n        \n        wait(3)\n\n        if teleporter1.Color == Color3.fromRGB(13, 105, 172) then\n            tweenToPosition(teleporter1.Position)\n        else\n            tweenToPosition(teleporter.Position)\n        end\n    end\nend\n\ngame.Players.LocalPlayer.CharacterAdded:Connect(function()\n    startTweening()\nend)\n\nif game.Players.LocalPlayer.Character then\n    startTweening()\nend","features":"Autofarm wins","tags":["autofarm","rdite"],"discord":"","keyLink":"","owner":{"_id":"661802cf043bbefaf7b314b7","username":"d9_6","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f28f9c2ce4f952897959933008d5478601a6fb940a8f04d13d5aaa5f71c03901.webp","original":"https://scriptblox.com/images/photo/661802cf043bbefaf7b314b7-1767478547778.jpg"},"status":"offline","id":"661802cf043bbefaf7b314b7","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/f28f9c2ce4f952897959933008d5478601a6fb940a8f04d13d5aaa5f71c03901.webp","original":"https://scriptblox.com/images/photo/661802cf043bbefaf7b314b7-1767478547778.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:09:52.114Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cd19","editBy":{"_id":"661802cf043bbefaf7b314b7","username":"d9_6","status":"offline","id":"661802cf043bbefaf7b314b7"},"message":"Create script","createdAt":"2024-09-28T14:24:53.143Z"},{"_id":"67e5e1e3b360710ec3c4cd1a","editBy":{"