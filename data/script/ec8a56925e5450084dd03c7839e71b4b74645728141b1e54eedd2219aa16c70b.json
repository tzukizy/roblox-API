{"_id":"686bea18fff90ed8077bcb1d","title":"Blackhole Nuke Server Crasher","game":{"_id":"67e5e1ffb360710ec3c78195","gameId":8657766101,"name":"[GREENLANTERN] Marvellous Smackdown","imageUrl":{"url":"https://media.kocakz.me/e51761f070f0ff5ee2d5f6f31da3f751bfab81157ec09b4a0282e7ad8d7b6774.webp","original":"https://tr.rbxcdn.com/180DAY-2ea0667b1f48e12d945fabcfa11decc5/150/150/Image/Png/noFilter"},"slug":"8657766101-marvellous-smackdown","path":"/game/8657766101-marvellous-smackdown","thumbnail":{"url":"https://media.kocakz.me/e51761f070f0ff5ee2d5f6f31da3f751bfab81157ec09b4a0282e7ad8d7b6774.webp","original":"https://tr.rbxcdn.com/180DAY-2ea0667b1f48e12d945fabcfa11decc5/150/150/Image/Png/noFilter"},"placeId":8657766101},"slug":"AMAZOMarvellous-Playground-Blackhole-Nuke-44234","verified":false,"key":false,"keyless":false,"views":11168,"executes":1132,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/bbb4acb6828ffafe1cd7a2dd7dcaba18cd064183d293a0926f680c0c5f96e708.webp","original":"https://scriptblox.com/images/sb/8657766101-1751902744875.webp","scriptblox":"https://scriptblox.com/images/script/8657766101-1751902744875.webp"},"thumbnail":{"url":"https://media.kocakz.me/bbb4acb6828ffafe1cd7a2dd7dcaba18cd064183d293a0926f680c0c5f96e708.webp","original":"https://scriptblox.com/images/sb/8657766101-1751902744875.webp","scriptblox":"https://scriptblox.com/images/script/8657766101-1751902744875.webp"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-07-07T15:39:04.926Z","updatedAt":"2025-07-07T15:39:04.926Z","lastBump":"2025-07-07T15:39:04.926Z","script":"local Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/TwiRwal/TwiWare/main/uilib.lua\"))()\n\nlocal player = game:GetService(\"Players\").LocalPlayer\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal window = Library.CreateLib(\"Blackhole Burst\", \"Ocean\")\nlocal tab = window:NewTab(\"Blackholes\")\nlocal section = tab:NewSection(\"Effects\")\n\nlocal remotes = ReplicatedStorage:FindFirstChild(\"Characters\")\n    and ReplicatedStorage.Characters:FindFirstChild(\"Thanos\")\n    and ReplicatedStorage.Characters.Thanos:FindFirstChild(\"Remotes\")\n\nlocal blackhole = remotes and remotes:FindFirstChild(\"Blackhole\")\nif not blackhole then\n    warn(\"Blackhole remote not found\")\n    return\nend\n\nlocal function spawnBlackholes()\n    local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return end\n\n    local center = root.Position\n    local radius = 40\n    local amount = 100000\n\n    for i = 0, amount - 1 do\n        local angle = (2 * math.pi / amount) * i\n        local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius\n        local position = center + offset\n\n        task.spawn(function()\n            blackhole:FireServer({Position = position})\n        end)\n    end\nend\n\nsection:NewButton(\"Spawn 100 Blackholes [H]\", \"Spawns a cool ring of blackholes\", spawnBlackholes)\n\nUserInputService.InputBegan:Connect(function(input, gpe)\n    if gpe then return end\n    if input.KeyCode == Enum.KeyCode.H then\n        spawnBlackholes()\n    end\nend)","features":"It spawns 100k blackholes you can change the value too","tags":[],"discord":"","keyLink":"","owner":{"_id":"680acf3e8a886f65e3b74a74","username":"Mathguy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/078bd3f26746d8af29f49c49d73e6cb7c6e46c28bd094f28a199a519f91b15fe.webp","original":"https://scriptblox.com/images/photo/680acf3e8a886f65e3b74a74-1778268135126.jpg"},"status":"offline","id":"680acf3e8a886f65e3b74a74","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/078bd3f26746d8af29f49c49d73e6cb7c6e46c28bd094f28a199a519f91b15fe.webp","original":"https://scriptblox.com/images/photo/680acf3e8a