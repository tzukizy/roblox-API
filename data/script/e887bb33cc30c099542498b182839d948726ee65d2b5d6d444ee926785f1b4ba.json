{"slug":"generic-roleplay-gaem.-Click-teleport-grg-version-42662","_id":"6852ff83ac15ee5efbadcb20","title":"Click teleport grg version","game":{"_id":"67e5e1ffb360710ec3c7853f","gameId":4598019433,"name":"generic roleplay gaem.","imageUrl":"/images/sb/rbx-948c5286bcc855c76a6ee962cd0c4686-504c319ef40d.png","placeId":4598019433},"features":"Open source.\nAllowed paste.\nNo error .\nIt was established on 18.06.2025. If it does not work, it means the anticheat is advanced.","tags":["clicktp"],"script":"local plr = game:GetService(\"Players\").LocalPlayer\nlocal backpack = plr:WaitForChild(\"Backpack\")\n\nlocal tpTool = Instance.new(\"Tool\")\ntpTool.Name = \"Telleport tool\"\ntpTool.RequiresHandle = false\ntpTool.Parent = backpack\n\nlocal function teleportSequence(destination)\n    local char = plr.Character or plr.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n\n    \n    hrp.CFrame = CFrame.new(-48, 28, 255)\n    task.wait(0.25)\n    hrp.CFrame = CFrame.new(destination)\nend\n\ntpTool.Activated:Connect(function()\n    local mouse = plr:GetMouse()\n    if mouse and mouse.Hit then\n        teleportSequence(mouse.Hit.Position)\n    end\nend)\n","owner":{"_id":"68480180059a9781e070833f","username":"ultraware","verified":false,"profilePicture":"/images/photo/68480180059a9781e070833f-1749549675845.jpg","status":"offline","id":"68480180059a9781e070833f","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":5142,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-c0dbfae41ac45a04e745b27392aad4ed-d9b380f94a64.png","likeCount":5,"dislikeCount":0,"createdAt":"2025-06-18T18:03:47.001Z","editBy":{"_id":"68480180059a9781e070833f","username":"ultraware","status":"offline","id":"68480180059a9781e070833f"},"executes":321,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6852ff83ac15ee5efbadcb22","editBy":{"_id":"68480180059a9