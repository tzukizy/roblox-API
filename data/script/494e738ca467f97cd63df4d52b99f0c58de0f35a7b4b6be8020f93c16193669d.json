Players\").LocalPlayer\n    local money = player.stored.Money\n    local depositAmount = money.Value\n    game:GetService(\"ReplicatedStorage\").ATM:FireServer(\"Deposit\", depositAmount)\n\n    wait(0.2)\n\n    local bank = player.stored.Bank\n    local bankAmount = bank.Value\n    game:GetService(\"ReplicatedStorage\").ControllerRemote:FireServer(\"SaveCrosshair\", \"\\255\")\n\n    local recipient = game:GetService(\"Players\")[username]\n    game:GetService(\"ReplicatedStorage\").Phone:FireServer(\"SendMoney\", recipient, bankAmount)\nend\n\nwhile true do\n    executeMoneyTransfer()\n    wait()\n    game:GetService(\"TeleportService\"):Teleport(game.PlaceId, game:GetService(\"Players\").LocalPlayer)\nend","features":"READ BELOW PLEASE\n------------------\n\nPUT THIS IN UR AUTO EXECUTE THEN JOIN THE PERSON U PUTS USERNAME IN\n\nCHANGE THE \"put user here\" to the persons user ur giving the money to, then put the script in ur executors \"autoexecute\" and join them through friends list and there you go.\n\nId recommend deleting it from ur auto execute when ur done to avoid getting anticheat banned from other games\n\n\nBOTH ACCOUNTS KEEP MONEY, HOWEVER MUCH UR 1st account is trading you will keep :)\n\n1. Change the username in the script \"put user here\" like this \"skibidirizzler\" \n\n2. ur executor should have a autoexecute where it automatically executes for instance waves is here C:\\Users\\user\\AppData\\Local\\Programs\\Wave\\autoexec u make a .txt file and paste the entire script in it\n\n 3. join and ur done\n\n 4. feel free to dm me on discord","tags":["zins","new","OP","automatic","cuh"],"discord":"","keyLink":"","owner":{"_id":"6604b4e7f58740913b138cdd","username":"zins","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e219f8fd8aa61df07b25e84ef6122dd359425a6adca7c6d50b5ce6a0ccc79b5e.webp","original":"https://scriptblox.com/images/photo/6604b4e7f58740913b138cdd-1720414788178.png"},"status":"offline","id":"6604b4e7f58740913b138cdd","to