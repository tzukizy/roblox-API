{"_id":"699f4b1f308dd7335e878766","title":"Bypass Walkspeed OPEN SOURCE","game":{"_id":"6957738915942ffdefb51204","gameId":131623223084840,"name":"Escape Tsunami For Brainrots!","imageUrl":{"url":"https://media.kocakz.me/a3d2bd74ef98d909ef5ea5ab1caf6ee5d4fa1f58c47ceedfde22018b5e898225.webp","original":"https://tr.rbxcdn.com/180DAY-d5b1f93fc3a4f23ef18b166a3fbea10c/150/150/Image/Png/noFilter"},"slug":"131623223084840-escape-tsunami-for-brainrots","path":"/game/131623223084840-escape-tsunami-for-brainrots","thumbnail":{"url":"https://media.kocakz.me/a3d2bd74ef98d909ef5ea5ab1caf6ee5d4fa1f58c47ceedfde22018b5e898225.webp","original":"https://tr.rbxcdn.com/180DAY-d5b1f93fc3a4f23ef18b166a3fbea10c/150/150/Image/Png/noFilter"},"placeId":131623223084840},"slug":"Escape-Tsunami-For-Brainrots!-Bypass-Walkspeed-OPEN-SOURCE-122056","verified":false,"key":false,"keyless":false,"views":440,"executes":33,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2d8453cb13165348198788499eb629ab2223b90aa5001098d919b5299b36c3fe.webp","original":"https://scriptblox.com/images/sb/131623223084840-1772047135407.jpg","scriptblox":"https://scriptblox.com/images/script/131623223084840-1772047135407.jpg"},"thumbnail":{"url":"https://media.kocakz.me/2d8453cb13165348198788499eb629ab2223b90aa5001098d919b5299b36c3fe.webp","original":"https://scriptblox.com/images/sb/131623223084840-1772047135407.jpg","scriptblox":"https://scriptblox.com/images/script/131623223084840-1772047135407.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-25T19:18:55.421Z","updatedAt":"2026-02-25T19:18:55.421Z","lastBump":"2026-02-25T19:18:55.421Z","script":"local Players = game:GetService(\"Players\")\r\nlocal RunService = game:GetService(\"RunService\")\r\nlocal UserInputService = game:GetService(\"UserInputService\")\r\n\r\nlocal Player = Players.LocalPlayer\r\nlocal SPEED_ALVO = Player.Character.Humanoid.WalkSpeed * 2 -- Do not change the speed to prevent bugs.\r\nlocal TOGGLE_KEY = Enum.KeyCode.V -- Change it to whatever letter you want.\r\nlocal isEnabled = false\r\n\r\nUserInputService.InputBegan:Connect(function(input, processed)\r\n    if not processed and input.KeyCode == TOGGLE_KEY then\r\n        isEnabled = not isEnabled\r\n    end\r\nend)\r\n\r\nRunService.Heartbeat:Connect(function(deltaTime)\r\n    if not isEnabled then return end\r\n    \r\n    local char = Player.Character\r\n    if not char then return end\r\n\r\n    local hrp = char:FindFirstChild(\"HumanoidRootPart\")\r\n    local hum = char:FindFirstChild(\"Humanoid\")\r\n\r\n    if hrp and hum and hum.MoveDirection.Magnitude > 0 then\r\n        local oldY = hrp.AssemblyLinearVelocity.Y\r\n        hrp.AssemblyLinearVelocity = Vector3.new(0, oldY, 0)\r\n\r\n        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (SPEED_ALVO * deltaTime))\r\n        \r\n        hrp:SetNetworkOwner(Player) \r\n    end\r\nend)","features":"Not detectable (i think so), enjoy!","tags":[],"discord":"","keyLink":"","owner":{"_id":"666c29ef125491c00f2c28fa","username":"archiveswag","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3cfa2a5e8e5e743553b62e7e6b5c33aa3f9306b3681715a6d70b79429677befa.webp","original":"https://scriptblox.com/images/photo/666c29ef125491c00f2c28fa-1772100244944.jpg"},"status":"offline","id":"666c29ef125491c00f2c28fa","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/3cfa2a5e8e5e743553b62e7e6b5c33aa3f9306b3681715a6d70b79429677befa.webp","original":"https://scriptblox.com/images/photo/666c29ef125491c00f2c28fa-1772100244944.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:35:22.754Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"699f4b1f308dd7335e87876b","editBy":{"_id":"