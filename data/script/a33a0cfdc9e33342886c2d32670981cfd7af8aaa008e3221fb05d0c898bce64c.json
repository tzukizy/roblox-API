{"_id":"679d1b4eaa088fe55266795b","title":"Print Detected Humanoid Parts in Console","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d3b7fd69ebd787e9ecd6caa191b9e7ddfe0482d205e4e5c73bb57215da33997d.webp","original":"https://scriptblox.com/images/sb/7946354-1738349390519.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d3b7fd69ebd787e9ecd6caa191b9e7ddfe0482d205e4e5c73bb57215da33997d.webp","original":"https://scriptblox.com/images/sb/7946354-1738349390519.png"},"placeId":0},"slug":"Universal-Script-Print-Detected-Humanoid-Parts-in-Console-28085","verified":false,"key":false,"keyless":false,"views":2315,"executes":32,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/65fb6b469c3d4f342f930da1316bbbd57de693871398c69b0aa984f9ce684919.webp","original":"https://scriptblox.com/images/sb/7946354-1738349390519.png","scriptblox":"https://scriptblox.com/images/script/7946354-1738349390519.png"},"thumbnail":{"url":"https://media.kocakz.me/65fb6b469c3d4f342f930da1316bbbd57de693871398c69b0aa984f9ce684919.webp","original":"https://scriptblox.com/images/sb/7946354-1738349390519.png","scriptblox":"https://scriptblox.com/images/script/7946354-1738349390519.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-01-31T18:49:50.992Z","updatedAt":"2025-01-31T18:49:50.992Z","lastBump":"2025-01-31T18:49:50.992Z","script":"local function detectAllBodyParts(player)\n    if player and player.Character then\n        local character = player.Character\n        local humanoid = character:WaitForChild(\"Humanoid\", 5)  \n\n        if humanoid then\n            local printedParts = {} \n            \n            for _, part in pairs(character:GetChildren()) do\n                if part:IsA(\"BasePart\") and not printedParts[part.Name] then\n                    print(part.Name .. \" exists!\")\n                    printedParts[part.Name] = true  \n                end\n            end\n        else\n            print(\"Humanoid not found or not Correctly Loaded\")\n        end\n    else\n        print(\"Humanoid Does not exist\")\n    end\nend\n\ngame.Players.PlayerAdded:Connect(function(player)\n    player.CharacterAdded:Connect(function(character)\n        detectAllBodyParts(player)\n    end)\nend)\n","features":"Detects Humanoid Parts","tags":[],"discord":"","keyLink":"","owner":{"_id":"662c2711c5d4b02999f5ff9d","username":"Proton","verified":false,"profilePicture":{"url":"https://media.kocakz.me/171c9114c4983144994a737a9ff567806ad033c4386112bfb15acb0803aae3a3.webp","original":"https://scriptblox.com/images/photo/662c2711c5d4b02999f5ff9d-1738267254502.png"},"status":"offline","id":"662c2711c5d4b02999f5ff9d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/171c9114c4983144994a737a9ff567806ad033c4386112bfb15acb0803aae3a3.webp","original":"https://scriptblox.com/images/photo/662c2711c5d4b02999f5ff9d-1738267254502.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:06:12.047Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c5481c","editBy":{"_id":"662c2711c5d4b02999f5ff9d","username":"Proton","status":"offline","id":"662c2711c5d4b02999f5ff9d"},"message":"Create script","createdAt":"2025-03-27T22:39:20.342Z"}],"comments":[]}