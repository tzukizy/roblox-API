if sound then\n            sound:Destroy()\n        end\n    end)\nend\n\nlocal function isBlacklisted(username)\n    for _, blacklistedName in ipairs(blacklist) do\n        if blacklistedName:lower() == username:lower() then\n            return true\n        end\n    end\n    return false\nend\n\nlocal function handlePlayer(player)\n    if isBlacklisted(player.Name) then\n        playKickSound()\n        player:Kick(\"You are blacklisted, Please contact the owner of the script to whitelist\")\n    end\nend\n\nPlayers.PlayerAdded:Connect(handlePlayer)\n\nfor _, player in ipairs(Players:GetPlayers()) do\n    handlePlayer(player)\nend","features":"Can kick anyone it blacklists.","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a12e32fc8bbd73ad17ae7b2","username":"RealGood_050","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6acdb28169e3f79162f1d07c5daa0c42c60ef3c2a2f90c41526ab0131eccfe78.webp","original":"https://scriptblox.com/images/photo/6a12e32fc8bbd73ad17ae7b2-1787699494876.jpeg"},"status":"offline","id":"6a12e32fc8bbd73ad17ae7b2","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/6acdb28169e3f79162f1d07c5daa0c42c60ef3c2a2f90c41526ab0131eccfe78.webp","original":"https://scriptblox.com/images/photo/6a12e32fc8bbd73ad17ae7b2-1787699494876.jpeg"}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-09T22:40:50.411Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:33:48.813Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6aa1de3e2d6a9f5b60c79e40","editBy":{"_id":"6a12e32fc8bbd73ad17ae7b2","username":"RealGood_050","status":"offline","id":"6a12e32fc8bbd73ad17ae7b2"},"message":"Create script","createdAt":"2026-09-09T22:31:26.745Z"}],"comments":[]}