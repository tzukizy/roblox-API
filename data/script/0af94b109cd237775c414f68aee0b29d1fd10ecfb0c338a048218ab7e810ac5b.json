{"slug":"Universal-Script-Open-Source-Velocity-Changer-10392","_id":"65c19f61b96263873de6ad82","title":"Open Source Velocity Changer","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Literally just velocity changer\n\nYep, is only a velocity changer","tags":["Opensource"],"script":"getgenv().VelocityChanger = true \ngetgenv().XVelocity = 90\ngetgenv().YVelocity = 90\ngetgenv().ZVelocity = 90\n\ngame:GetService(\"RunService\").PostSimulation:Connect(function()\n        local PlayerVelocity = game.Players.LocalPlayer.Character.HumanoidRootPart.Velocity\n        if getgenv().VelocityChanger then\n                game.Players.LocalPlayer.Character.PrimaryPart.Velocity = Vector3.new(getgenv().XVelocity, getgenv().YVelocity, getgenv().ZVelocity) \n    game:GetService(\"RunService\").PreRender:Wait()\n    game.Players.LocalPlayer.Character.HumanoidRootPart.Velocity = PlayerVelocity\n    end \nend)","owner":{"_id":"64d3f4e9992ff6b802bb4ab3","username":"CMDS","verified":false,"profilePicture":{"url":"https://media.kocakz.me/041e4783b9541907b3d7678e8ed7fc0ef1fa703376a3975627e54538c2effae8.webp","original":"https://scriptblox.com/images/photo/64d3f4e9992ff6b802bb4ab3-1712427214412.png"},"status":"offline","id":"64d3f4e9992ff6b802bb4ab3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/041e4783b9541907b3d7678e8ed7fc0ef1fa703376a3975627e54538c2effae8.webp","original":"https://scriptblox.com/images/photo/64d3f4e9992ff6b802bb4ab3-1712427214412.png"}},"verified":false,"keyLink":"","views":9573,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-02-06T02:54:25.908Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://media.kocakz.me/fe8952a8d096cb46fc4a92bd292012723e125cba432e2d4699e0b83a732