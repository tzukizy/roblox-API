a then\n                for _, v in next, b.data do\n                    if type(v) == \"table\" and tonumber(v.playing) and tonumber(v.maxPlayers) and v.playing < v.maxPlayers and v.id ~= o and v.playing >= math.floor(v.maxPlayers * 0.5) then\n                        table.insert(s, v.id)\n                    end\n                end\n            end\n        end\n        if #s > 0 then\n            t:TeleportToPlaceInstance(i, s[math.random(#s)], p.LocalPlayer)\n            break\n        end\n    end\nend","features":"i have to make my own api bcz solara sucks cant decode json","tags":[],"discord":"","keyLink":"","owner":{"_id":"67599c8f97714078296d3e07","username":"playvoraalt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/053e41377691978642645035167aab9e789e2671114dcf26723b2bf19bae1f53.webp","original":"https://scriptblox.com/images/photo/67599c8f97714078296d3e07-1751970236228.png"},"status":"offline","id":"67599c8f97714078296d3e07","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/053e41377691978642645035167aab9e789e2671114dcf26723b2bf19bae1f53.webp","original":"https://scriptblox.com/images/photo/67599c8f97714078296d3e07-1751970236228.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:04:40.997Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c5578c","editBy":{"_id":"67599c8f97714078296d3e07","username":"playvoraalt","status":"offline","id":"67599c8f97714078296d3e07"},"message":"Create script","createdAt":"2025-03-27T18:13:15.190Z"}],"comments":[]}