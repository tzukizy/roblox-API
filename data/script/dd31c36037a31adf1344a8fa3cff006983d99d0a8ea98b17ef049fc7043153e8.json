{"slug":"Universal-Script-script-spinning-skybox-52757","_id":"68c411edd26f895692f2b918","title":"script spinning skybox","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":".","tags":["whatever the scripter"],"script":"local sky = game.Lighting.Sky\nlocal rotationSpeedX = 50 -- Speed for X axis\nlocal rotationSpeedZ = 50 -- Speed for Z axis\nlocal rotationSpeedY = 50 -- Speed for Y axis\n\ngame:GetService(\"RunService\").Heartbeat:Connect(function(deltaTime)\nlocal newX = (sky.SkyboxOrientation.X + rotationSpeedX * deltaTime) % 360\nlocal newZ = (sky.SkyboxOrientation.Z + rotationSpeedZ * deltaTime) % 360\nlocal newY = (sky.SkyboxOrientation.Y + rotationSpeedY * deltaTime) % 360\nsky.SkyboxOrientation = Vector3.new(newX, newY, newZ)\nend)\n\n-- This will spin the skybox around all three axes.","owner":{"_id":"681c89f5b9b00726ece2eb66","username":"TankiddOfficial","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/e161b8a19ebda2c45ad6df7f2eb5d0cf88ad328d5b3f300f474e757647a97a23.webp","original":"https://scriptblox.com/images/photo/681c89f5b9b00726ece2eb66-1776907241089.png"},"status":"offline","id":"681c89f5b9b00726ece2eb66","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/e161b8a19ebda2c45ad6df7f2eb5d0cf88ad328d5b3f300f474e757647a97a23.webp","original":"https://scriptblox.com/images/photo/681c89f5b9b00726ece2eb66-1776907241089.png"}},"verified":false,"views":3514,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/fcd51d08a31358cbda3f53792781302310438f8ecdb06c0e3a446ff1415529eb.webp","original":"https://scriptblox.com/images/sb/0-1757680109466.png","scriptblox":"https://scriptblox.com/images/script/0-1757680109466.png"}