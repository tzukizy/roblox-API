{"slug":"Beat-up-Gubby-in-His-Own-Home-FLAMETHROWER!-Infinite-Cash-open-source-49466","_id":"68a623e81047f74e8f20f686","title":"Infinite Cash open source","game":{"_id":"68a60f3d10f454d7ee5e6626","gameId":111452220770252,"name":"Beat up Gubby in His Own Home","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":111452220770252},"features":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\n\n--== Feature ==--\n\nToggle ( Loops DMG = Cash per 0.1 )\n\nDon't forget leave a like or Follow 🎀 \nEnjoy 😊","tags":["Aux hub","Infinite Cash","Op script","Scriptbloxcom","Open Source"],"script":"--== Here Script ==--\nlocal Venix = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/darkMaster549/Aux-Hub-Script-/refs/heads/main/Venix.lua\"))()\n\n--// Create Window \\\\ --\nlocal win = Venix.CreateWindow({\n    Title = \"•Aux♠Hub•\",\n    Size = UDim2.fromOffset(200, 150),\n    Position = UDim2.fromOffset(120, 100)\n})\n\n--// Services \\\\--\nlocal RS = game:GetService(\"ReplicatedStorage\")\nlocal Remotes = RS:WaitForChild(\"Networking\"):WaitForChild(\"Server\"):WaitForChild(\"RemoteEvents\"):WaitForChild(\"DamageEvents\")\n\n-- args for each remote\nlocal baseballArgs = {\n    Vector3.new(-3.72346568107605, 2.8309199810028076, -0.013234120793640614),\n    12.168801650810206\n}\nlocal grenadeArgs = {\n    Vector3.new(-21.8129825592041, 3.0931053161621094, -0.0006826695171184838),\n    1.6589272022247314\n}\nlocal physicsArgs = {\n    43.28071975708008,\n    Vector3.new(-13.374950408935547, 3.483245611190796, 0.08221215754747391)\n}\nlocal taserArgs = {\n    Vector3.new(-21.883464813232422, 2.7776761054992676, -0.00024636523448862135)\n}\n\n-- toggle state--\nlocal farming = false\n\n--// Add Toggle \\\\ --\nwin:AddToggle(\"Infinite Cash\", false, function(state)\n    farming = state\n    if farming then\n        task.spawn(function()\n            while farming do\n                for i = 1, 2 do -- Change The 2 to whatever you want Make it more Faster \n                    Remotes:WaitForChild(\"BaseballDamage\"):FireServer(unpack(baseballArgs))\n                    Remotes:WaitForChild(\"GrenadeDamage\"):FireServer(unpack(grenadeArgs))\n                    Remotes:WaitForChild(\"PhysicsDamage\"):FireServer(unpack(physicsArgs))\n                    Remotes:WaitForChild(\"TaserDamage\"):FireServer(unpack(taserArgs))\n                end\n                task.wait(0.1) \n            end\n        end)\n    end\nend)","owner":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/d37dc0cd827a226c8e89ef84a9232ddb4a5c5847d9cb0f0bdb0643915a73f7aa.webp","original":"https://scriptblox.com/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg"},"status":"offline","id":"6870b2fb95671adabe1b7905","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/d37dc0cd827a226c8e89ef84a9232ddb4a5c5847d9cb0f0bdb0643915a73f7aa.webp","original":"https://scriptblox.com/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg"}},"verified":false,"views":37547,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/b56d311711a3e5d20d5d88a9ab080c3b4bd52a6d5787119e29c616b41e24ac88.webp","original":"https://scriptblox.com/images/sb/111452220770252-1755718632820.webp","scriptblox":"https://scriptblox.com/images/script/111452220770252-1755718632820.webp"},"likeCount":9,"dislikeCount":0,"createdAt":"2025-08-20T19:37:12.844Z","executes":76,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:49:21.700Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.m