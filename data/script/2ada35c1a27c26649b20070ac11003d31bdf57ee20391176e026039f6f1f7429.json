{"_id":"68f4c8beb839ebfe1833259a","title":"NO KEY DUPE SCRIPT ANTILAG NO VISUAL","game":{"_id":"68a65d835165138168ebf4ff","gameId":138384544898173,"name":"[🎄] Trade a Brainrot","imageUrl":{"url":"https://media.kocakz.me/132047dae39ea6a3758167362e1aed80a2ce261402a00471ab3a8014f489efc7.webp","original":"https://tr.rbxcdn.com/180DAY-8c91f77d7f5a47a5573b598819636cbd/150/150/Image/Png/noFilter"},"slug":"138384544898173-trade-a-brainrot","path":"/game/138384544898173-trade-a-brainrot","thumbnail":{"url":"https://media.kocakz.me/132047dae39ea6a3758167362e1aed80a2ce261402a00471ab3a8014f489efc7.webp","original":"https://tr.rbxcdn.com/180DAY-8c91f77d7f5a47a5573b598819636cbd/150/150/Image/Png/noFilter"},"placeId":138384544898173},"slug":"Trade-a-Brainrot-NO-KEY-DUPE-SCRIPT-ANTILAG-NO-VISUAL-59508","verified":false,"key":false,"keyless":false,"views":9486,"executes":671,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/3b8521304ce91eef2a9d62339a11960b8a874fd8bd5b7d601b975dad3b9055b6.webp","original":"https://scriptblox.com/images/sb/rbx-e70d398687d58e567b3bf764cb1918ec-5f4a39c61a0c.png","scriptblox":"https://scriptblox.com/images/script/rbx-e70d398687d58e567b3bf764cb1918ec-5f4a39c61a0c.png"},"thumbnail":{"url":"https://media.kocakz.me/3b8521304ce91eef2a9d62339a11960b8a874fd8bd5b7d601b975dad3b9055b6.webp","original":"https://scriptblox.com/images/sb/rbx-e70d398687d58e567b3bf764cb1918ec-5f4a39c61a0c.png","scriptblox":"https://scriptblox.com/images/script/rbx-e70d398687d58e567b3bf764cb1918ec-5f4a39c61a0c.png"},"likeCount":0,"dislikeCount":4,"createdAt":"2025-10-19T11:17:18.086Z","updatedAt":"2025-10-19T11:17:18.086Z","lastBump":"2025-10-19T11:17:18.086Z","script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Knit = require(ReplicatedStorage.Packages.Knit)\n\n-- Получаем сервисы\nlocal InventoryController = Knit.GetController(\"InventoryController\")\nlocal EquipmentService = Knit.GetService(\"EquipmentService\")\n\n-- Функция: достаём вес из ключа\nlocal function getWeight(key)\n    local parts = string.split(key, \"|\")\n    return tonumber(parts[2]) or 0\nend\n\n-- Функция: экипировать 2 самых тяжёлых предмета (не Egg)\nlocal function equipTwoHeaviest()\n    local items = {}\n\n    -- Собираем предметы\n    for _, stack in ipairs(InventoryController.InventoryLayout) do\n        if stack and stack.Key and stack.Count > 0 then\n            if not string.find(stack.Key, \"Egg\") then\n                table.insert(items, stack)\n            end\n        end\n    end\n\n    -- Сортируем по весу (убывание)\n    table.sort(items, function(a, b)\n        return getWeight(a.Key) > getWeight(b.Key)\n    end)\n\n    -- Берём первые два и экипируем\n    for i = 1, math.min(2, #items) do\n        local stack = items[i]\n        print(\"Экипируем:\", stack.Key, \"вес:\", getWeight(stack.Key), \"stackId:\", stack.stackId)\n        EquipmentService:EquipItem(stack.Key, stack.stackId)\n    end\nend\n\n-- Авто каждые 0.5 сек\nwhile task.wait(2) do\n    equipTwoHeaviest()\nend","features":"Op script","tags":[],"discord":"","keyLink":"","owner":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68e8337f6d2a648c0cfe46d7","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:47:44.416Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f4c8beb839ebfe1833259c","editBy":{"_id":"68e8337f6d2a648c0cfe46d7","username":"yytop","status":"offline","id":"68e8337f6d2a648c0cfe46d7"},"message":"Create script","createdAt":"2025-10-19T11:17:18.091Z"},{"_id":"68f4e15ef17bf77b0aee3