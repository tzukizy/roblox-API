{"_id":"61d21cef06b289703ecad601","title":"FE Invisibility keybind","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"FE-Invisibility-keybind_178","verified":true,"key":false,"keyless":false,"views":210342,"executes":1430,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/2982916-1641159919744.jpg","scriptblox":"https://scriptblox.com/images/script/2982916-1641159919744.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/2982916-1641159919744.jpg","scriptblox":"https://scriptblox.com/images/script/2982916-1641159919744.jpg"},"likeCount":13,"dislikeCount":0,"createdAt":"2022-01-02T21:45:19.751Z","updatedAt":"2022-01-02T21:45:19.751Z","lastBump":"2022-01-02T21:45:19.751Z","script":"local key = Enum.KeyCode.X -- key to toggle invisibility\n\n--// dont edit script below\nlocal invis_on = false\nfunction onKeyPress(inputObject, chat)\n    if chat then return end\n    if inputObject.KeyCode == key then\n\t    invis_on = not invis_on\n    \tif invis_on then\n            local savedpos = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame\n            wait()\n            game.Players.LocalPlayer.Character:MoveTo(Vector3.new(-25.95, 84, 3537.55))\n            wait(.15)\n            local Seat = Instance.new('Seat', game.Workspace)\n            Seat.Anchored = false\n            Seat.CanCollide = false\n            Seat.Name = 'invischair'\n            Seat.Transparency = 1\n            Seat.Position = Vector3.new(-25.95, 84, 3537.55)\n            local Weld = Instance.new(\"Weld\", Seat)\n            Weld.Part0 = Seat\n            Weld.Part1 = game.Players.LocalPlayer.Character:FindFirstChild(\"Torso\") or game.Players.LocalPlayer.Character.UpperTorso\n            wait()\n            Seat.CFrame = savedpos\n            game.StarterGui:SetCore(\"SendNotification\", {\n                Title = \"Invis On\";\n                Duration = 1;\n                Text = \"\";\n            })\n        else\n            workspace:FindFirstChild('invischair'):Remove()\n            game.StarterGui:SetCore(\"SendNotification\", {\n                Title = \"Invis Off\";\n                Duration = 1;\n                Text = \"\";\n            })\n        end\n    end\nend\n\ngame:GetService(\"UserInputService\").InputBegan:connect(onKeyPress)","features":"- Toggle between visible and invisible on a whim\n- Still be able to use \"Touchable\" tools like swords while invisible\n- Others usually can't attack you while invisible","tags":["fe invis","invisiblity","invisibility toggle","invisible"],"discord":"","keyLink":"","owner":{"_id":"61d10c6e2e29907e43674fae","username":"____","verified":true,"profilePicture":{"url":"https://media.kocakz.me/63529015a1a95a4d69facd76422d866ecaecd568b13725c05868206de848ef3a.webp","original":"https://scriptblox.com/images/photo/61d10c6e2e29907e43674fae-1697384675150.gif"},"status":"offline","id":"61d10c6e2e29907e43674fae","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/63529015a1a95a4d69facd76422d866ecaecd568b13725c05868206de848ef3a.webp","original":"https://scriptblox.com/images/photo/61d10c6e2e29907e43674fae-1697384675150.gif"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T03:03:51.442Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4deea","editBy":{"_id":"61d10c6e2e29907e43674fae","username":"____","status":"offline","id