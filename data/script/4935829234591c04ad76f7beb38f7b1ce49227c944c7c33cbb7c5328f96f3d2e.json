{"_id":"68f2b53554707a2d5cd661b4","title":"opscripts KICK ALL","game":{"_id":"68f2b53554707a2d5cd661ad","gameId":15318113891,"name":"Lethal Ape (?)","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"15318113891-lethal-ape","path":"/game/15318113891-lethal-ape","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":15318113891},"slug":"Lethal-Ape-(massive-update)-opscripts-KICK-ALL-59007","verified":false,"key":false,"keyless":false,"views":4694,"executes":5162,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/64007640d5e9bcee652a311e84a2640079a946ce4c7fe4fe1c97ab4a56e0c3bd.webp","original":"https://scriptblox.com/images/sb/rbx-f9877137e5b8d5771832cee958ee93fd-d2ac3b2f3051.png","scriptblox":"https://scriptblox.com/images/script/rbx-f9877137e5b8d5771832cee958ee93fd-d2ac3b2f3051.png"},"thumbnail":{"url":"https://media.kocakz.me/64007640d5e9bcee652a311e84a2640079a946ce4c7fe4fe1c97ab4a56e0c3bd.webp","original":"https://scriptblox.com/images/sb/rbx-f9877137e5b8d5771832cee958ee93fd-d2ac3b2f3051.png","scriptblox":"https://scriptblox.com/images/script/rbx-f9877137e5b8d5771832cee958ee93fd-d2ac3b2f3051.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-10-17T21:29:25.499Z","updatedAt":"2025-10-17T21:29:25.499Z","lastBump":"2025-10-17T21:29:25.499Z","script":"local library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua\"))()\nlocal window = library.CreateLib(\"OpScripts - Lethal ape\", \"DarkTheme\")\nlocal tab = window:NewTab(\"Main\")\nlocal section = tab:NewSection(\"Main\")\n\nsection:NewButton(\"KICK ALL (Patched)\", \"Kicks everyone! SERVER SIDED\", function()\n    workspace.OwnerPanel.AdminPanelGui.Events.ShutdownEvent:FireServer()\nend)\n\nsection:NewButton(\"Zoom out\", \"Lets you zoom out\", function()\n    game.Players.LocalPlayer.CameraMode = Enum.CameraMode.Classic\nend)\n\nlocal antimodactive = false\nlocal modlist = {\"gubdev\", \"anothermod\", \"badplayer\"}\n\nsection:NewToggle(\"Anti Mod\", \"Makes you leave if a mod is in\", function(state)\n    antimodactive = state\nend)\n\nlocal function checkplayer(player)\n    if antimodactive then\n        for _, name in pairs(modlist) do\n            if player.Name == name then\n                game.Players.LocalPlayer:Kick(\"OpScripts - anti mod\")\n                break\n            end\n        end\n    end\nend\n\nfor _, player in pairs(game.Players:GetPlayers()) do\n    if player.Name == \"hteigdpi\" then\n        game.StarterGui:SetCore(\"SendNotification\", {\n            Title = \"Alert\";\n            Text = \"The owner of the script is in!\";\n            Duration = 5;\n        })\n    end\n    checkplayer(player)\nend\n\ngame.Players.PlayerAdded:Connect(function(player)\n    if player.Name == \"hteigdpi\" then\n        game.StarterGui:SetCore(\"SendNotification\", {\n            Title = \"Alert\";\n            Text = \"The owner of the script is in!\";\n            Duration = 5;\n        })\n    end\n    checkplayer(player)\nend)\n","features":"KICK ALL (Patched!) - kicks everyone by firing event (tested with 2 accounts)\nZoom out - Lets you zoom out\nAnti Mod - if any known mods join you will leave","tags":["kick","op","kickall","crasher","popular"],"discord":"","keyLink":"","owner":{"_id":"683aa0380f380c18ee525781","username":"scripter132","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"683aa0380f380c18ee525781","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:42:51.660Z","last":"","win":14,"math":3},"isHub":