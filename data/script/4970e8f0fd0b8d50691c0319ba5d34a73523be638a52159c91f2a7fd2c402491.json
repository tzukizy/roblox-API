{"_id":"676e429477b2ca0f7eea9fe9","title":"BBFT Nutcrcker","game":{"_id":"67e5e1ffb360710ec3c77d84","gameId":537413528,"name":"Build A Boat For Treasure","imageUrl":{"url":"https://media.kocakz.me/e0439889a7a2d03f338c746011a00e38cc63054c8daacc81c94de3c0ca3998bd.webp","original":"https://tr.rbxcdn.com/180DAY-88172459d6aec8bf28e99556fc0562a8/150/150/Image/Png/noFilter"},"slug":"537413528-build-a-boat-for-treasure","path":"/game/537413528-build-a-boat-for-treasure","thumbnail":{"url":"https://media.kocakz.me/e0439889a7a2d03f338c746011a00e38cc63054c8daacc81c94de3c0ca3998bd.webp","original":"https://tr.rbxcdn.com/180DAY-88172459d6aec8bf28e99556fc0562a8/150/150/Image/Png/noFilter"},"placeId":537413528},"slug":"Build-A-Boat-For-Treasure-BBFT-Nutcrcker-25290","verified":false,"key":false,"keyless":false,"views":6501,"executes":106,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-df13f1ab1dad86d09316f06b40df8161/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-df13f1ab1dad86d09316f06b40df8161/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-df13f1ab1dad86d09316f06b40df8161/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-df13f1ab1dad86d09316f06b40df8161/500/280/Image/Jpeg/noFilter"},"likeCount":3,"dislikeCount":2,"createdAt":"2024-12-27T06:00:52.230Z","updatedAt":"2024-12-27T06:00:52.230Z","lastBump":"2024-12-27T06:00:52.230Z","script":"workspace:WaitForChild(\"ClearAllPlayersBoatParts\"):FireServer()\ntask.wait(.5)\nworkspace:WaitForChild(\"QuestMakerEvent\"):FireServer(101)\nlocal playerteamcolor, playerzone = game.Players.LocalPlayer.Team.TeamColor\nfor _, v in pairs(game.workspace:GetChildren()) do\n    if string.find(v.Name, \"Zone\") ~= nil then\n        print('foundzone')\n        if v.TeamColor.Value == playerteamcolor then\n            playerzone = v\n        end\n    end\nend\nprint(playerzone)\nlocal args = {\n    [1] = \"WoodBlock\",\n    [2] = game.Players.LocalPlayer.Data.WoodBlock.Value,\n    [3] = playerzone,\n    [4] = CFrame.new(1, 6.100000381469727, -15, 1, 0, 0, 0, 1, 0, 0, 0, 1),\n    [5] = true,\n    [6] = playerzone.CFrame*CFrame.new(0, 10, 0),\n    [7] = false\n}\nif game.Players.LocalPlayer.Backpack:FindFirstChild(\"BuildingTool\") then\n    game.Players.LocalPlayer.Backpack:FindFirstChild(\"BuildingTool\").Parent = game.Players.LocalPlayer.Character\nend\ngame:GetService(\"Players\").LocalPlayer.Character.BuildingTool.RF:InvokeServer(unpack(args))\ntask.wait(.5)\ngame.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = playerzone.CFrame*CFrame.new(125,7,-50)\ntask.wait(.5)\ngame.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = playerzone.CFrame*CFrame.new(125,7,-50)\ngame.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = true\ntask.wait(1)\nplayerzone:WaitForChild(\"VoteLaunchRE\"):FireServer()\nrepeat\n    task.wait(1)\nuntil game:GetService(\"Players\").LocalPlayer.Character:FindFirstChild(\"CandyCaneWeapon\") or game:GetService(\"Players\").LocalPlayer.Backpack:FindFirstChild(\"CandyCaneWeapon\")\nrepeat\n    for _, v in pairs(playerzone.Quest.NutCrackerBattle.Enemies:GetChildren()) do\n        if v:FindFirstChild(\"HumanoidRootPart\") then\n            if game:GetService(\"Players\").LocalPlayer.Backpack:FindFirstChild(\"CandyCaneWeapon\") then\n                game:GetService(\"Players\").LocalPlayer.Backpack:FindFirstChild(\"CandyCaneWeapon\").Parent = game:GetService(\"Players\").LocalPlayer.Character\n            end\n            if game:GetService(\"Players\").LocalPlayer.Character:FindFirstChild(\"CandyCaneWeapon\") then\n                game:GetService(\"Players\").LocalPlayer.Character.CandyCaneWeapon.ThrowEvent:FireServer(v.HumanoidRootPart.CFrame)\n            end\n        end\n    end\n    task.wait(.01)\nuntil playerzone.Quest.NutCrackerBattle.Timer.Value == 0","features":"Auto complete the quest\n\nFixed team problem. What a careless mistake!","tags":["babft","build a boat","nutcracker","probaconhub"],"discord":"","keyLink":"","owner":{"_id":"64ce5d5efbbf5eb080abe152","username":"ProBaconHub","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9adaad543fefcb78b22cb3859bb124e80ab1912aa342c2bb3ec6c13c4a41ca4d.webp","original":"https://scriptblox.com/images/photo/64ce5d5efbbf5eb080abe152-1743575713534.png"},"status":"offline","id":"64ce5d5efbbf5eb080abe152","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/9adaad543fefcb78b22cb3859bb124e80ab1912aa342c2bb3ec6c13c4a41ca4d.webp","original":"https://scriptblox.com/images/photo/64ce5d5efbbf5eb080abe152-1743575713534.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:10:53.271Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d484","editBy":{"_id":"64ce5d5efbbf5eb080abe152","username":"ProBaconHub","status":"offline","id":"64ce5d5efbbf5eb080abe152"},"message":"Create script","createdAt":"2024-12-29T13:40:54.592Z"},{"_id":"67e5e1e6b360710ec3c53c2f","editBy":{"_id":"64ce5d5efbbf5eb080abe152","username":"ProBaconHub","status":"offline","id":"64ce5d5efbbf5eb080abe152"},"message":"Update script","createdAt":"2025-03-27T21:35:13.477Z"}],"comments":[{"_id":"676e5b47e5e0c047756cd4c8","commentBy":{"_id":"67135d003bea9dbc3c632781","username":"Smorgasbord","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/1669e2435756523b0e77a9a54251a240e9a64a60652c0a6e3572c8c8e9fd2e06.webp","original":"https://scriptblox.com/images/photo/67135d003bea9dbc3c632781-1729322302052.png"},"createdAt":"2024-10-19T07:17:20.743Z","lastActive":"2025-05-31T15:33: