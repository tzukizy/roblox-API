{"slug":"Universal-Script-Universal-esp-box-4269","_id":"62d55bdccd57341187dd817e","title":"Universal esp box","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"box esp which works on almost all games","tags":["esp","box","universal","script"],"script":"while wait(0.5) do\n    for i, box in ipairs(workspace:GetDescendants()) do\n        if box:FindFirstChild(\"Humanoid\") then\n            if not box:FindFirstChild(\"EspBox\") then\n                if box ~= game.Players.LocalPlayer.Character then\n                    local esp = Instance.new(\"BoxHandleAdornment\",box)\n                    esp.Adornee = box\n                    esp.ZIndex = 0\n                    esp.Size = Vector3.new(5, 6, 2)\n                    esp.Transparency = 0.5 --Changes Transparency \n                    esp.Color3 = Color3.fromRGB(0,255,0) --Color change\n                    esp.AlwaysOnTop = true\n                    esp.Name = \"EspBox\"\n                end\n            end\n        end\n    end\nend","owner":{"_id":"62ab5da99b0bb90fc263f12a","username":"Frakki","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/62ab5da99b0bb90fc263f12a-1658080608331.jpg"},"status":"offline","id":"62ab5da99b0bb90fc263f12a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/62ab5da99b0bb90fc263f12a-1658080608331.jpg"}},"verified":false,"views":25181,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-07-18T13:10:52.429Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/imag