stChild(\"HumanoidRootPart\") then\n        local root = character.HumanoidRootPart\n        \n        for _, monster in pairs(workspace.Monsters:GetChildren()) do\n            if monster:FindFirstChild(\"HumanoidRootPart\") then\n                local distance = (root.Position - monster.HumanoidRootPart.Position).Magnitude\n                if distance < auraDistance then\n                    ZAP.meleeAttack.fire({\n                        monsters = {monster},\n                        civilians = {},\n                        activeSlot = slotNumber\n                    })\n                    break\n                end\n            end\n        end\n    end\nend","features":"Just Kill Aura let me know if u guys want more features i can make a full GUI","tags":["Bake or Die","roblox","script","Bake or Die script"],"discord":"","keyLink":"","owner":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:37:12.398Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69203625608735c6799deaba","editBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","status":"offline","id":"6227c42f7944271798ea1b15"},"message":"Create script","createdAt":"2025-11-21T09:51:33.562Z"