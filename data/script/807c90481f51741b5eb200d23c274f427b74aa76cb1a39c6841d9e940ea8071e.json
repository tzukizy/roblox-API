"Players\")\nlocal player = Players.LocalPlayer\n\n-- =========================\n-- Hacks Section\n-- =========================\n\nlocal Section = Window:NewSection(\"Hacks\")\n\n-- Spearton Throw\nlocal SpeartonThrow = false\n\nSection:CreateToggle(\"Spearton throw OP\", function(value)\n    SpeartonThrow = value\n\n    if value then\n        task.spawn(function()\n            while SpeartonThrow do\n                local character = player.Character or player.CharacterAdded:Wait()\n                local throw = character:WaitForChild(\"ThrowEvent\", 5)\n\n                if throw and throw:IsA(\"RemoteEvent\") then\n                    throw:FireServer()\n                end\n\n                task.wait(0.1)\n            end\n        end)\n    end\nend)\n\nSection:CreateButton(\"Hack Panel\", function()\n    player.PlayerGui.game.Panels.HackPanel.Visible = true\nend)\n\nSection:CreateButton(\"Sword wrath rage\", function()\n    game:GetService(\"Players\").LocalPlayer.Character.Rage\nend)\n\n\n","features":"Spearton throw spam hack panel and Xiphos rage it can be used on sword wrath 3000","tags":[],"discord":"","keyLink":"","owner":{"_id":"699669611a5b231013d0fff7","username":"enadla2","verified":false,"profilePicture":{"url":"https://media.kocakz.me/66765cc30aa7e8c5f0deb83ba0c55ed608f8a3057d9067f46ddaea84ccc1e1f0.webp","original":"https://scriptblox.com/images/photo/699669611a5b231013d0fff7-1771731297692.jpg"},"lvl":8,"status":"offline","id":"699669611a5b231013d0fff7","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/66765cc30aa7e8c5f0deb83ba0c55ed608f8a3057d9067f46ddaea84ccc1e1f0.webp","original":"https://scriptblox.com/images/photo/699669611a5b231013d0fff7-1771731297692.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:03:28.758Z","last":"","win":14,"math":3