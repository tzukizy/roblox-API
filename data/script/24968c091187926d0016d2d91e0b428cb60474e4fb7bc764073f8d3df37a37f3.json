{"slug":"Math-Madness-AUTO-MATH-34487","_id":"67f2e1768b60f61a1008b3e8","title":"AUTO MATH","game":{"_id":"67f2e1768b60f61a1008b3e5","gameId":104069911827692,"name":"Math Madness","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":104069911827692},"features":"auto math for you lol","tags":["math","madness","math madness"],"script":"local path = workspace.Billboard.gui.frame.main.main.question\npath.RichText = true\nlocal lastQuestion = \"\"\n\nwhile true do\n    local currentText = path.Text\n\n    if currentText ~= lastQuestion and not currentText:match(\"<font\") then\n        local expression = currentText\n            :gsub(\"=\", \"\")\n            :gsub(\"%s+\", \"\")\n            :gsub(\"x\", \"*\")\n\n        local func = loadstring(\"return \" .. expression)\n        if func then\n            local success, result = pcall(func)\n            if success then\n                local coloredResult = string.format('<font color=\"#34c3eb\">%s</font>', result)\n                path.Text = currentText .. \" \" .. coloredResult\n                lastQuestion = path.Text\n            end\n        end\n    end\n    wait(0.2)\nend","owner":{"_id":"6748e5f8b319ed7a65743d21","username":"Siffori","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/015036d6fc9b3e0bb740abf34ea6855c47f3ae83cb0a5c39f807f5e3cdface55.webp","original":"https://scriptblox.com/images/photo/6748e5f8b319ed7a65743d21-1751730714208.png"},"status":"offline","id":"6748e5f8b319ed7a65743d21","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/015036d6fc9b3e0bb740abf34ea6855c47f3ae83cb0a5c39f807f5e3cdface55.webp","original":"https://scriptblox.com/images/photo/6748e5f8b319ed7a65743d21-1751730714208.png"}},"verified":false,"views":2181,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url