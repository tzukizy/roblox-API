{"slug":"Universal-Script-Mundo-vermelho-240395","_id":"6a43f705cd168a942388fa9d","title":"Mundo vermelho","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Era pra ser céu de sangue mas acabou sendo mundo vermelho/eu fiz esse script com chat gpt se tiver oque tu dúvida de uma ia","tags":[],"script":"-- Coloque em ServerScriptService\n\nlocal Lighting = game:GetService(\"Lighting\")\n\n-- Deixa o ambiente avermelhado\nLighting.Ambient = Color3.fromRGB(120, 0, 0)\nLighting.OutdoorAmbient = Color3.fromRGB(180, 0, 0)\nLighting.ColorShift_Top = Color3.fromRGB(255, 0, 0)\nLighting.ColorShift_Bottom = Color3.fromRGB(100, 0, 0)\nLighting.Brightness = 2\n\n-- Cria efeito vermelho\nlocal cc = Instance.new(\"ColorCorrectionEffect\")\ncc.Parent = Lighting\ncc.TintColor = Color3.fromRGB(255, 40, 40)\ncc.Saturation = -0.2\ncc.Contrast = 0.3\n\nprint(\"Céu de sangue ativado\")","owner":{"_id":"69fa18eed07a35ab8b5b85ad","username":"Nitary","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/06cda72338025c3cc9026eec9b53317ef04c4d4d4d6a8efa7c0b64bcef30907a.webp","original":"https://scriptblox.com/images/photo/69fa18eed07a35ab8b5b85ad-1782838257669.jpg"},"lvl":5,"status":"offline","id":"69fa18eed07a35ab8b5b85ad","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/06cda72338025c3cc9026eec9b53317ef04c4d4d4d6a8efa7c0b64bcef30907a.webp","original":"https://scriptblox.com/images/photo/69fa18eed07a35ab8b5b85ad-1782838257669.jpg"}},"verified":false,"views":847,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/9834e78d59297b4cb10c3052d1db29ce5e4b22c2765c22ac41a60d52c3514a1c.webp","original":"https://scriptblox.com/images/sb/0-1782839045948.p