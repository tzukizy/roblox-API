(0.1)\n\tuntil not getgenv().moneyrandom\nend\n\n-- Clear all money\ngame:GetService(\"ReplicatedStorage\").CratesUtilities.Remotes.RemoveMoney:FireServer(game:GetService(\"Players\").LocalPlayer.leaderstats.Money.Value)\n\n-- Give money (HERE IS NO GOING BACK IF YOU USE MATH.HUGE)\ngame:GetService(\"ReplicatedStorage\").CratesUtilities.Remotes.GiveReward:FireServer(10)\n\n-- Give 10,000\ngame:GetService(\"ReplicatedStorage\").GiveClaimMoney:FireServer()\n\n-- Give 1K\ngame:GetService(\"ReplicatedStorage\").GlassMoney.Give_1k:FireServer()\\\n\n-- Give 1\ngame:GetService(\"ReplicatedStorage\").GiveCoins:FireServer()\n\n-- Show all paths\ngame:GetService(\"Players\").LocalPlayer.ShowPath.Value = false\n\n-- Carpet 100% from creat\nfor _,v in pairs(game:GetService(\"ReplicatedStorage\").CratesUtilities.Itens.Basic:GetChildren()) do\n    if v.Name == \"Carpet\" then\n        v:SetAttribute(\"porcentage\", 100)\n    else\n        v:SetAttribute(\"porcentage\", 0)\n    end\nend\nfor _,v in pairs(game:GetService(\"ReplicatedStorage\").CratesUtilities.Itens.Lucky:GetChildren()) do\n    if v.Name == \"Carpet\" then\n        v:SetAttribute(\"porcentage\", 100)\n    else\n        v:SetAttribute(\"porcentage\", 0)\n    end\nend\nfor _,v in pairs(game:GetService(\"ReplicatedStorage\").CratesUtilities.Itens.Robux:GetChildren()) do\n    if v.Name == \"Carpet\" then\n        v:SetAttribute(\"porcentage\", 100)\n    else\n        v:SetAttribute(\"porcentage\", 0)\n    end\nend","features":"Trolling","tags":[],"discord":"","keyLink":"","owner":{"_id":"64ce5d5efbbf5eb080abe152","username":"ProBaconHub","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9adaad543fefcb78b22cb3859bb124e80ab1912aa342c2bb3ec6c13c4a41ca4d.webp","original":"https://scriptblox.com/images/photo/64ce5d5efbbf5eb080abe152-1743575713534.png"},"status":"offline","id":"64ce5d5efbbf5eb080abe152","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/9adaad543fef