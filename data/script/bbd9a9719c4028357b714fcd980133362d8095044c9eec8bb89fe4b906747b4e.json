{"slug":"NEW!-Devil-Hunter-Free-Kill-Aura-script-85233","_id":"6966416a89eac87a1400368e","title":"Free Kill Aura script","game":{"_id":"69586c69e2dbbe97e22041d6","gameId":131079272918660,"name":"[RELEASE] Devil Hunter","imageUrl":"/images/sb/rbx-d6fa35181cde46f632f0fc00542990d6-575db3d5e635.png","placeId":131079272918660},"features":"Kill Aura (void mobs)","tags":["Kill Aura","Keyless","Free","Open Source","Devil Hunter"],"script":"_G.test = true\nlocal LP = game:GetService(\"Players\").LocalPlayer\n\ntask.spawn(function()\n    while _G.test do\n        task.wait(0.1)\n        \n\n        pcall(function()\n\n            sethiddenproperty(LP, \"SimulationRadius\", math.huge)\n            \n\n            local entities = workspace.World:FindFirstChild(\"Entities\")\n            if entities then\n                for _, v in pairs(entities:GetChildren()) do\n          \n                    if v:IsA(\"Model\") and v.Name ~= LP.Name then\n                        local hum = v:FindFirstChildOfClass(\"Humanoid\")\n                        local hrp = v:FindFirstChild(\"HumanoidRootPart\")\n                        \n                        if hum and hum.Health > 0 then\n                           \n                            hum.Health = 0\n                            \n                           \n                            if hrp then\n                                hrp.CanCollide = false\n                                hrp.CFrame = CFrame.new(hrp.Position.X, -500, hrp.Position.Z)\n                            end\n                            \n                            print(\"Targeted: \" .. v.Name)\n                        end\n                    end\n                end\n            end\n        end)\n    end\nend)","owner":{"_id":"6957a17502a6e4afdc7936c7","username":"7rqxy","verified":false,"profilePicture":"/images/photo/6957a17502a6e4afdc7936c7-1767350853416.jpg","status":"offline","id":"6957a17502a6e4afdc7936c7","topMilestone":{"key":"creator.executions","ti