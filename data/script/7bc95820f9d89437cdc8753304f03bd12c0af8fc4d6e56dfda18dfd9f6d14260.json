{"_id":"69a868ee11afc6c1a5645273","title":"Simple Anti Afk","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Simple-Anti-Afk-128622","verified":false,"key":false,"keyless":false,"views":832,"executes":23373,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/a52f66fa53eb38cd4dd97d3c95a6b5b9b1442c9c9e50a2f4f8c1c6086d6b6884.webp","original":"https://scriptblox.com/images/sb/0-1772644590562.png","scriptblox":"https://scriptblox.com/images/script/0-1772644590562.png"},"thumbnail":{"url":"https://media.kocakz.me/a52f66fa53eb38cd4dd97d3c95a6b5b9b1442c9c9e50a2f4f8c1c6086d6b6884.webp","original":"https://scriptblox.com/images/sb/0-1772644590562.png","scriptblox":"https://scriptblox.com/images/script/0-1772644590562.png"},"likeCount":6,"dislikeCount":1,"createdAt":"2026-03-04T17:16:30.575Z","updatedAt":"2026-03-04T17:16:30.575Z","lastBump":"2026-03-04T17:16:30.575Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nif player:WaitForChild(\"PlayerGui\"):FindFirstChild(\"AntiAFKGui\") then\n\tplayer.PlayerGui.AntiAFKGui:Destroy()\nend\n\nlocal ScreenGui = Instance.new(\"ScreenGui\")\nScreenGui.Name = \"AntiAFKGui\"\nScreenGui.ResetOnSpawn = false\nScreenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal Frame = Instance.new(\"Frame\")\nFrame.Size = UDim2.new(0, 200, 0, 100)\nFrame.Position = UDim2.new(0.5, -100, 0.5, -50)\nFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nFrame.Active = true\nFrame.Draggable = true\nFrame.Parent = ScreenGui\n\nlocal ToggleButton = Instance.new(\"TextButton\")\nToggleButton.Size = UDim2.new(1, -20, 0, 50)\nToggleButton.Position = UDim2.new(0, 10, 0, 25)\nToggleButton.Text = \"Anti AFK: OFF\"\nToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\nToggleButton.TextColor3 = Color3.new(1,1,1)\nToggleButton.Parent = Frame\n\nlocal antiAFK = false\n\ntask.spawn(function()\n\twhile true do\n\t\tif antiAFK then\n\t\t\tlocal character = player.Character\n\t\t\tif character and character:FindFirstChild(\"Humanoid\") then\n\t\t\t\tcharacter.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n\t\t\tend\n\t\tend\n\t\ttask.wait(1)\n\tend\nend)\n\nToggleButton.MouseButton1Click:Connect(function()\n\tantiAFK = not antiAFK\n\tif antiAFK then\n\t\tToggleButton.Text = \"Anti AFK: ON\"\n\t\tToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)\n\telse\n\t\tToggleButton.Text = \"Anti AFK: OFF\"\n\t\tToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\n\tend\nend)","features":"jumps every second so u don't disconnect.","tags":["anti","afk","antiafk","anti afk"],"discord":"","keyLink":"","owner":{"_id":"699dc23d11afc6c1a5b66ba8","username":"H7O_","verified":false,"profilePicture":{"url":"https://media.kocakz.me/cfa697ac4dc43a317ef0b2cf22d05a4f1c75d34c36ee7b6433e973d6ac5f037e.webp","original":"https://scriptblox.com/images/photo/699dc23d11afc6c1a5b66ba8-1772996719082.png"},"status":"offline","id":"699dc23d11afc6c1a5b66ba8","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/cfa697ac4dc43a317ef0b2cf22d05a4f1c75d34c36ee7b6433e973d6ac5f037e.webp","original":"https://scriptblox.com/images/photo/699dc23d11afc6c1a5b66ba8-1772996719082.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:27:07.124Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a868ee11afc6c1a5645276","editBy":{"_id":"699dc23d11afc6c1a5b66ba8","username":"H7O_","status":"offline","id":"699dc23d11afc6c1a5b66ba8"},