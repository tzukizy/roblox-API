n\nlocal sprays = {}\nlocal number = 10\nif backpack:FindFirstChild(\"Spray\") or char:FindFirstChild(\"Spray\") then\n    error(\"You must not have any sprays when executing this script\")\nend\nwhile #sprays < number do\n    root.CFrame = spraybutton.CFrame\n    local spray = char:WaitForChild(\"Spray\")\n    spray.Parent = workspace\n    sprays[#sprays+1] = spray\nend\nroot.CFrame = root.CFrame + Vector3.new(0,100,0)\ntask.wait(0.1)\nfor i,v in pairs(sprays) do\n    if v.Parent == workspace then\n        root.Velocity = Vector3.zero\n        root.CFrame = v.Handle.CFrame\n        v.AncestryChanged:Wait()\n        task.wait()\n        v.Parent = backpack\n    end\nend\ntask.wait()\nhumanoid:UnequipTools()\ntask.wait()\nfor i,v in pairs(backpack:GetChildren()) do\n    if v.Name == \"Spray\" and not table.find(sprays, v) then\n        root.Velocity = Vector3.zero\n        root.CFrame = CFrame.new(1500,-400,1500)\n        v.Parent = char\n        task.wait()\n        v.Parent = workspace\n        task.wait(0.1)\n    end\nend\ntask.wait()\nroot.CFrame = old\nhumanoid:ChangeState(\"GettingUp\")","features":"Because the spray can is droppable, you can dupe it easily due to how the script works of getting it. You can change the number in 'local number = 10' to how many sprays you need","tags":[],"discord":"","keyLink":"","owner":{"_id":"68aab9df8decc0a677b7629d","username":"joey9876a","verified":false,"profilePicture":{"url":"https://media.kocakz.me/512bf1ff8446e6b5bbdb3363883092d2220035dce506cdde581371ca67a3e703.webp","original":"https://scriptblox.com/images/photo/68aab9df8decc0a677b7629d-1758293753460.png"},"status":"offline","id":"68aab9df8decc0a677b7629d","profile":{"url":"https://media.kocakz.me/512bf1ff8446e6b5bbdb3363883092d2220035dce506cdde581371ca67a3e703.webp","original":"https://scriptblox.com/images/photo/68aab9df8decc0a677b7629d-1758293753460.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b"