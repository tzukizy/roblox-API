{"slug":"Universal-Script-1x9x8x7x6xC-f3x-gui-51192","_id":"68b5cf4aa642645be712e38d","title":"1x9x8x7x6xC f3x gui","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Very op script, skybox, decal, music, trollroast, crash,  realm, Entire page of music, and etc,","tags":["Fx gui","Fx","Gui","Op"],"script":"loadstring([[\n    local player = game.Players.LocalPlayer\n    local gui = Instance.new(\"ScreenGui\")\n    gui.Name = \"BeastGUI\"\n    gui.ResetOnSpawn = false\n    gui.Parent = player:WaitForChild(\"PlayerGui\")\n\n    -- Main Frame\n    local frame = Instance.new(\"Frame\")\n    frame.Size = UDim2.new(0.5, 0, 0.5, 0)\n    frame.Position = UDim2.new(0.25, 0, 0.25, 0)\n    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)\n    frame.BorderSizePixel = 4\n    frame.Active = true\n    frame.Draggable = true\n    frame.Parent = gui\n\n    -- UICorner (rounded edges)\n    local corner = Instance.new(\"UICorner\")\n    corner.CornerRadius = UDim.new(0, 12)\n    corner.Parent = frame\n\n    -- Rainbow Text Label\n    local text = Instance.new(\"TextLabel\")\n    text.Size = UDim2.new(1, 0, 0.2, 0)\n    text.Position = UDim2.new(0, 0, 0.4, 0)\n    text.BackgroundTransparency = 1\n    text.Text = \"sorry skid\"\n    text.Font = Enum.Font.SourceSansBold\n    text.TextScaled = true\n    text.Parent = frame\n\n    -- Rainbow effect\n    task.spawn(function()\n        local hue = 0\n        while task.wait(0.05) do\n            hue = (hue + 0.01) % 1\n            text.TextColor3 = Color3.fromHSV(hue, 1, 1)\n        end\n    end)\n]])()","owner":{"_id":"68a4dfc110f454d7ee406649","username":"1x9x8x7x6xC","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/1ec045a0a1037015f92126bbfa421eff0e5d60460987db851e58a1c1b0f2373d.webp","original":"https://s