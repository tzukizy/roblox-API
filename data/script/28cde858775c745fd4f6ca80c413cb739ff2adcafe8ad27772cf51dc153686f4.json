{"slug":"Universal-Script-ProximityPromt-No-Cooldown-115177","_id":"69994bb6ee9430ea80e16016","title":"ProximityPromt No Cooldown","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1771654070636.png","placeId":0},"features":"适用于具有 e 键的游戏 ☕🤠","tags":[],"script":"-- 适用于所有 e 键位。\n-- Fixed Lag\nlocal ProximityPromptService = game:GetService(\"ProximityPromptService\")\n\nlocal function optimizePrompt(prompt)\n    if prompt:IsA(\"ProximityPrompt\") then\n        prompt.HoldDuration = 0\n        prompt.RequiresLineOfSight = false\n    end\nend\n\nfor _, object in pairs(game:GetDescendants()) do\n    optimizePrompt(object)\nend\n\ngame.DescendantAdded:Connect(function(object)\n    optimizePrompt(object)\nend)\n\nProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)\n    prompt.HoldDuration = 0\nend)","owner":{"_id":"6979936318bb57eef02a3fb7","username":"Sw4p","verified":false,"profilePicture":"/images/photo/6979936318bb57eef02a3fb7-1771392794481.jpg","status":"offline","id":"6979936318bb57eef02a3fb7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":776,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1771654070636.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-02-21T06:07:50.649Z","editBy":{"_id":"6979936318bb57eef02a3fb7","username":"Sw4p","status":"offline","id":"6979936318bb57eef02a3fb7"},"keyLink":"","executes":363,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69994bb6ee9430ea80e16019","editBy":{"_id":"6979936318bb57eef02a3fb7","username":"Sw4p","status":"offline","id":"6979936318bb57eef02a3fb7"},"message":"Create script","createdAt":"2026-02-21T06:07:50.652Z"},{"_id":"69996546439e779867481e26","editBy":{"_id":"6979936318bb57eef02a3fb7","username":"Sw4p","status":"offline","id":"6979936318bb57eef02a3fb7"},"message":"Update script","createdAt":"2026-02-21T