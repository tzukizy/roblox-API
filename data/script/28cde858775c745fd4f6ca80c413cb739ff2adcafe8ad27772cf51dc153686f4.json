{"slug":"Universal-Script-ProximityPromt-No-Cooldown-115177","_id":"69994bb6ee9430ea80e16016","title":"ProximityPromt No Cooldown","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"适用于具有 e 键的游戏 ☕🤠","tags":[],"script":"-- 适用于所有 e 键位。\n-- Fixed Lag\nlocal ProximityPromptService = game:GetService(\"ProximityPromptService\")\n\nlocal function optimizePrompt(prompt)\n    if prompt:IsA(\"ProximityPrompt\") then\n        prompt.HoldDuration = 0\n        prompt.RequiresLineOfSight = false\n    end\nend\n\nfor _, object in pairs(game:GetDescendants()) do\n    optimizePrompt(object)\nend\n\ngame.DescendantAdded:Connect(function(object)\n    optimizePrompt(object)\nend)\n\nProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)\n    prompt.HoldDuration = 0\nend)","owner":{"_id":"6979936318bb57eef02a3fb7","username":"Sw4p","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/7356f9ea6752d77bc364be8d12c3e0014c7ce543c202c7720aad172033bdfd85.webp","original":"https://scriptblox.com/images/photo/6979936318bb57eef02a3fb7-1771392794481.jpg"},"status":"offline","id":"6979936318bb57eef02a3fb7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/7356f9ea6752d77bc364be8d12c3e0014c7ce543c202c7720aad172033bdfd85.webp","original":"https://scriptblox.com/images/photo/6979936318bb57eef02a3fb7-1771392794481.jpg"}},"verified":false,"views":790,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/d767bed0a2079be56d2bcedb5c887919e80376f3b19b75efd7af56db0cf249ea.webp","original":"https://scriptblox.com/images/sb/0-1771654070636.png","scriptblox":"https://scriptblox.com/images/script/0-1771654070636.png"},"likeCount":1,"dislikeCount":0,"c