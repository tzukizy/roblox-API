\n            end\n        end)\n    end\nend\n\n-- Handle existing ProximityPrompts\nfor _, v in ipairs(Workspace:GetDescendants()) do\n    hookPrompt(v)\nend\n\n-- Handle ProximityPrompts added in the future\nWorkspace.DescendantAdded:Connect(function(v)\n    hookPrompt(v)\nend)","features":"You won't need to hold any proximity prompt for now!!","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a2fee89d7d7c359b8702d29","username":"AI_Made","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a2fee89d7d7c359b8702d29","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:50:44.624Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a4fcc4d9f8807fd0fc5735c","editBy":{"_id":"6a2fee89d7d7c359b8702d29","username":"AI_Made","status":"offline","id":"6a2fee89d7d7c359b8702d29"},"message":"RFY","createdAt":"2026-07-09T16:29:01.181Z"}],"comments":[]}