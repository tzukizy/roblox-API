{"_id":"665c0f7d752515dd5c64d96e","title":"Change skin every die","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/26495bdb9bd9eeaa643d66306e56ce469a4d10f8f1d80a1b1359df31592edbdf.webp","original":"https://scriptblox.com/images/sb/7567681-1717309309611.webp"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/26495bdb9bd9eeaa643d66306e56ce469a4d10f8f1d80a1b1359df31592edbdf.webp","original":"https://scriptblox.com/images/sb/7567681-1717309309611.webp"},"placeId":0},"slug":"Universal-Script-Change-skin-every-die-13671","verified":false,"key":false,"keyless":false,"views":19626,"executes":444,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c2cb08c2286b4ece3e49a3ad6b1176b1f0aee6f119a4801084f147cb12cecce5.webp","original":"https://scriptblox.com/images/sb/7567681-1717309309611.webp","scriptblox":"https://scriptblox.com/images/script/7567681-1717309309611.webp"},"thumbnail":{"url":"https://media.kocakz.me/c2cb08c2286b4ece3e49a3ad6b1176b1f0aee6f119a4801084f147cb12cecce5.webp","original":"https://scriptblox.com/images/sb/7567681-1717309309611.webp","scriptblox":"https://scriptblox.com/images/script/7567681-1717309309611.webp"},"likeCount":3,"dislikeCount":0,"createdAt":"2024-06-02T06:21:49.660Z","updatedAt":"2024-06-02T06:21:49.660Z","lastBump":"2024-06-02T06:21:49.660Z","script":"local AvatarEditorService = game:GetService(\"AvatarEditorService\")\nlocal VirtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal pf = game:GetService(\"CoreGui\").ThemeProvider.PromptFrame\nlocal ButtonOkPos\nlocal hd = Instance.new('HumanoidDescription')\nlocal x,y = 0,0\nlocal lp = game:GetService(\"Players\").LocalPlayer\n\nlocal function changeColors()\n    hd.HeadColor = BrickColor.Random().Color\n    hd.TorsoColor = BrickColor.Random().Color\n    hd.LeftArmColor = BrickColor.Random().Color\n    hd.RightArmColor = BrickColor.Random().Color\n    hd.LeftLegColor = BrickColor.Random().Color\n    hd.RightLegColor = BrickColor.Random().Color\n\n    AvatarEditorService:PromptSaveAvatar(hd, Enum.HumanoidRigType.R6)\n\n    ButtonOkPos = pf:WaitForChild('Prompt').AlertContents.Footer.Buttons:FindFirstChild('2').AbsolutePosition\n\n    x = ButtonOkPos.x + 15\n    y = ButtonOkPos.y + 45\n\n    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, nil, 0)\n    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, nil, 0)\nend\n\nlp.CharacterAdded:Connect(changeColors)\nchangeColors()","features":"This script changes skin color when you die. It also deletes your accessories and converts you to R6.","tags":["all","cool","useless","troll","change character"],"discord":"","keyLink":"","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"},"status":"offline","id":"64cde94eedb1b218a6931bfe","profile":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:17:11.929Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50efe","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Create script","createdAt":"2025-03-27T21:46:06.956Z"}],"comments":[{"_id":"665c492d31fb5302adb696c4","commentBy":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","verified":f