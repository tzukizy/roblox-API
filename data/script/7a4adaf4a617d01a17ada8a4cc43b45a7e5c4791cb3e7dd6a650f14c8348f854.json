{"slug":"Universal-Script-Change-skin-every-die-13671","_id":"665c0f7d752515dd5c64d96e","title":"Change skin every die","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/7567681-1717309309611.webp","placeId":0},"features":"This script changes skin color when you die. It also deletes your accessories and converts you to R6.","tags":["all","cool","useless","troll","change character"],"script":"local AvatarEditorService = game:GetService(\"AvatarEditorService\")\nlocal VirtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal pf = game:GetService(\"CoreGui\").ThemeProvider.PromptFrame\nlocal ButtonOkPos\nlocal hd = Instance.new('HumanoidDescription')\nlocal x,y = 0,0\nlocal lp = game:GetService(\"Players\").LocalPlayer\n\nlocal function changeColors()\n    hd.HeadColor = BrickColor.Random().Color\n    hd.TorsoColor = BrickColor.Random().Color\n    hd.LeftArmColor = BrickColor.Random().Color\n    hd.RightArmColor = BrickColor.Random().Color\n    hd.LeftLegColor = BrickColor.Random().Color\n    hd.RightLegColor = BrickColor.Random().Color\n\n    AvatarEditorService:PromptSaveAvatar(hd, Enum.HumanoidRigType.R6)\n\n    ButtonOkPos = pf:WaitForChild('Prompt').AlertContents.Footer.Buttons:FindFirstChild('2').AbsolutePosition\n\n    x = ButtonOkPos.x + 15\n    y = ButtonOkPos.y + 45\n\n    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, nil, 0)\n    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, nil, 0)\nend\n\nlp.CharacterAdded:Connect(changeColors)\nchangeColors()","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":"/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg","status":"offline","id":"64cde94eedb1b218a6931bfe"},"verified":false,"keyLink":"","views":19568,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-06-02T06:21:49.660Z","dislikeCount":0,"likeCount":3,"image":"/images/sb/7567681-1717309309611.webp","executes":369,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50efe","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Create script","createdAt":"2025-03-27T21:46:06.956Z"}],"comments":[{"_id":"665c492d31fb5302adb696c4","commentBy":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","verified":false,"role":"user","profilePicture":"/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png","createdAt":"2022-06-06T13:08:55.114Z","lastActive":"2026-09-01T01:11:17.927Z","status":"offline","id":"629dfc67ee6d3da00eafbd2e","topMilestone":{"key":"creator.scripts","tier":25}},"text":"fe?","createdAt":"2024-06-02T10:27:57.359Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"665c8866e10214e361ba195b","commentBy":{"_id":"65e74a2886285cc6cc640fbc","username":"crucifixnew","verified":false,"role":"user","profilePicture":"/images/photo/65e74a2886285cc6cc640fbc-1712795134227.png","createdAt":"2024-03-05T16:36:56.138Z","lastActive":"2024-08-12T16:14:43.358Z","status":"offline","id":"65e74a2886285cc6cc640fbc","topMilestone":{"key":"creator.first_script","tier":1}},"text":"dont know @Nooby","createdAt":"2024-06-02T14:57:42.557Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"665c89d431fb5302adbb027a","commentBy":{"_id":"665c895f5f2b3fd04bf69439","username":"t00pj00lan","verified":false,"role":"user","profilePicture":"/images/photo/665c895f5f2b3fd04bf69439-1721619334706.png","createdAt":"2024-06-02T15:01:51.117Z","lastActive":"2026-03-13T23:24:07.922Z","status":"offline","id":"665c895f5f2b3fd04bf69439"},"text":"aaa","createdAt":"2024-06-02T15:03:49.000Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"665d4d1c48b57fca1231ba9d","commentBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"role":"user","profilePicture":"/images/photo