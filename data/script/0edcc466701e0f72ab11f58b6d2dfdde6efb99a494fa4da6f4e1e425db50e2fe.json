d)\nend","features":"If you change line 3 to not have \"and v.Color ~= Color3.fromRGB(163,162,165)\" it will paint the entire board. This can be very laggy and will take a long time to work, it's not a good idea in my opinion but it's there if you want it.\n\nHow to use:\n1) Execute the script during a round. This will paint everyones tiles.\n2) Walk out and back in of a tile you already own (eg your starting tile)\n3) This will paint over all the highlighted tiles\n-- This may need one or two goes as sometimes people paint more than this can claim","tags":["auto","grief","automatic","farm"],"discord":"","keyLink":"","owner":{"_id":"62e7364da190000aea61f6e1","username":"CraX","verified":true,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62e7364da190000aea61f6e1-1659319968412.jpg"},"status":"offline","id":"62e7364da190000aea61f6e1","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62e7364da190000aea61f6e1-1659319968412.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:32:22.750Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f4eb","editBy":{"_id":"62e7364da190000aea61f6e1","username":"CraX","status":"offline","id":"62e7364da190000aea61f6e1"},"message":"Create script","createdAt":"2025-03-27T22:54:08.089Z"}],"comments":[]}