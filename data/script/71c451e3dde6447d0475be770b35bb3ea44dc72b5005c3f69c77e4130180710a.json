to-completes golf rounds\n\nInfinite Stamina & Infinite Hunger\n\n🚗 Vehicle\n\nLive speedometer + gear readout (mph / studs)\n\nFull tuning: max speed, reverse, acceleration, braking, coast drag\n\nCruise Control, Collision Stop (auto-brake before walls)\n\nGround Lock, Float & ride-height control\n\nAnd alot more!","tags":["San Aurie","Aim *ist","San Aurie Script","AntiArrest","Hack All"],"script":"loadstring(game:HttpGet(\"https://vxsans.xyz/loader.lua\"))()","owner":{"_id":"6a5e0ce1b6bcd52816fc42f7","username":"VxSans","verified":false,"profilePicture":"/images/photo/6a5e0ce1b6bcd52816fc42f7-1785269417964.png","status":"offline","id":"6a5e0ce1b6bcd52816fc42f7","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"discord":"https://discord.com/invite/94NxBGZPw","keyLink":"https://vxsans.xyz/#execute","views":6936,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/104841616983113-1785484341071.png","likeCount":29,"dislikeCount":1,"createdAt":"2026-07-31T07:52:21.093Z","executes":34567,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":25276,"at":"2026-09-29T05:45:00.006Z"}],"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-07T05:36:50.884Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a6c5435c51ea3701b62fbe3","editBy":{"_id":"6a5e0ce1b6bcd52816fc42f7","username":"VxSans","status":"offline","id":"6a5e0ce1b6bcd52816fc42f7"},"message":"Create script","createdAt":"2026-07-31T07:52:21.096Z"}],"comments":[{"_id":"6a84c02c25bfa7e5688d6d58","commentBy":{"_id":"6a84bff325bfa7e5688d6d56","username":"lagordadejuan099","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-08-21T20:55:37.121Z","createdAt":"2026-08-18T20:26:27.539Z","status":"offline","id":"6a84bff325bfa7e5688d6d56"},"text":"The best script for San Aurie","edited":