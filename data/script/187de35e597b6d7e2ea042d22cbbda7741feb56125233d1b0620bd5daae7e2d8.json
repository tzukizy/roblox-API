tinue end\n            \n            local Weapon = Client.Character:FindFirstChildWhichIsA(\"Tool\") or Client.Backpack:FindFirstChildWhichIsA(\"Tool\")\n            \n            Event:FireServer(Weapon.Name, \"OnHit\", Part, Character.Humanoid, {\n                [\"Instance\"] = Part,\n                [\"Material\"] = Enum.Material.Plastic,\n                [\"Normal\"] = Part.Position,\n                [\"Position\"] = Part.Position\n            }, false)\n        end\n    end)\nend","features":"k","tags":[],"discord":"","keyLink":"","owner":{"_id":"62b05e7ba390ed912c4c1255","username":"Unkn0wn","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2fc734c0894f01797dca541baefa21bfea7edc44e47ba70eb83cbc1e18808c9c.webp","original":"https://scriptblox.com/images/photo/62b05e7ba390ed912c4c1255-1743944389130.jpg"},"status":"offline","id":"62b05e7ba390ed912c4c1255","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/2fc734c0894f01797dca541baefa21bfea7edc44e47ba70eb83cbc1e18808c9c.webp","original":"https://scriptblox.com/images/photo/62b05e7ba390ed912c4c1255-1743944389130.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:14:23.675Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e139","editBy":{"_id":"62b05e7ba390ed912c4c1255","username":"Unkn0wn","status":"offline","id":"62b05e7ba390ed912c4c1255"},"message":"Create script","createdAt":"2025-03-27T19:32:22.405Z"}],"comments":[{"_id":"62fe5ab1716b5c4f32884321","commentBy":{"_id":"62c990be1b5c9eb83fe5e095","username":"Nera","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/5bcb0e4b90101b7fa36ea367a85daf6aa75957d9017a98412db205c3aa7e1988.webp","original":"https://scriptblox.com/images/photo/62c990be1b5c9eb83fe5e095-172469744