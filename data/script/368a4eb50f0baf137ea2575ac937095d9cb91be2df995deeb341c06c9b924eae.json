\"):Destroy()\nwait(1)\n\nrm()\nwait(0.5)\nHumanoid:FindFirstChild(\"BodyWidthScale\"):Destroy()\nwait(1)\n\nrm()\nwait(0.5)\nHumanoid:FindFirstChild(\"BodyDepthScale\"):Destroy()\nwait(1)\n\nrm()\nwait(0.5)\nHumanoid:FindFirstChild(\"HeadScale\"):Destroy()\nwait(1)","features":"Makes your avatar character tiny.\nHead to Avatar, Body then scale, and do the following.\n\nHeight 0%\nWidth 0%\nHead 100%\nProportions 100%\nBody Type 0%","tags":["small avatar","small avatar fe","avatar small fe","da hood small avatar","small fe"],"discord":"","keyLink":"","owner":{"_id":"6238fc9733d05e4bc9e0bcb8","username":"Michi","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a95b79c5becc144408ece2a7454f8e67b4832da172432f0502c045f358227217.webp","original":"https://scriptblox.com/images/photo/6238fc9733d05e4bc9e0bcb8-1716997459106.png"},"status":"offline","id":"6238fc9733d05e4bc9e0bcb8","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/a95b79c5becc144408ece2a7454f8e67b4832da172432f0502c045f358227217.webp","original":"https://scriptblox.com/images/photo/6238fc9733d05e4bc9e0bcb8-1716997459106.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:21:04.792Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4eee3","editBy":{"_id":"6238fc9733d05e4bc9e0bcb8","username":"Michi","status":"offline","id":"6238fc9733d05e4bc9e0bcb8"},"message":"Create script","createdAt":"2025-03-27T23:09:36.780Z"}],"comments":[{"_id":"623930e6dac5606052374487","commentBy":{"_id":"61e843274be2e78dec48c1c6","username":"BlxckJack","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-01-19T16:58:15.038Z","lastActive":"2022-07-18T13:32:23.759Z","status":"offline","id":"61