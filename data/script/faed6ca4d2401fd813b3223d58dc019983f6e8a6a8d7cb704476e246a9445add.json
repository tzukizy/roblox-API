{"_id":"66bb370a9bf19cdbdf5df0ac","title":"Eat hats","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/8f03f36c787536f3d81735c420e0b69e333c50c6e6566adc5ad51609b27cdb55.webp","original":"https://scriptblox.com/images/sb/3634396-1723545354749.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/8f03f36c787536f3d81735c420e0b69e333c50c6e6566adc5ad51609b27cdb55.webp","original":"https://scriptblox.com/images/sb/3634396-1723545354749.png"},"placeId":0},"slug":"Universal-Script-Eat-hats-17151","verified":false,"key":false,"keyless":false,"views":92715,"executes":102,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/20c64168f8d8f940ea5699636ef28c3b262eacdb16b47b2a599f41d56bed05f8.webp","original":"https://scriptblox.com/images/sb/3634396-1723545354749.png","scriptblox":"https://scriptblox.com/images/script/3634396-1723545354749.png"},"thumbnail":{"url":"https://media.kocakz.me/20c64168f8d8f940ea5699636ef28c3b262eacdb16b47b2a599f41d56bed05f8.webp","original":"https://scriptblox.com/images/sb/3634396-1723545354749.png","scriptblox":"https://scriptblox.com/images/script/3634396-1723545354749.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2024-08-13T10:35:54.808Z","updatedAt":"2024-08-13T10:35:54.808Z","lastBump":"2024-08-13T10:35:54.808Z","script":"--made by Nightmare#0930\nlocal lp = game.Players.LocalPlayer\nlocal char = lp.Character\n\nfor i, v in pairs(char:GetChildren()) do\n    if v:IsA(\"BallSocketConstraint\") then\n        v:Destroy()\n    end\nend\n\nfor i, v in pairs(char:GetChildren()) do\n    if v:IsA(\"HingeConstraint\") then\n        v:Destroy()\n    end\nend\n\nfor i, v in pairs(char.Humanoid:GetAccessories()) do\nlocal hat = v.Name\n\nchar[hat].Archivable = true\nlocal fake = char[hat]:Clone()\nfake.Parent = char\nfake.Handle.Transparency = 1\n\nlocal hold = false\nlocal enabled = false\n\nchar[hat].Handle.AccessoryWeld:Destroy()\n\nlocal tool = Instance.new(\"Tool\", lp.Backpack)\ntool.RequiresHandle = true\ntool.CanBeDropped = false\ntool.Name = hat\n\nlocal handle = Instance.new(\"Part\", tool)\nhandle.Name = \"Handle\"\nhandle.Size = Vector3.new(1, 1, 1)\nhandle.Massless = true\nhandle.Transparency = 1\n\nlocal positions = {\n    forward = tool.GripForward,\n    pos = tool.GripPos,\n    right = tool.GripRight,\n    up = tool.GripUp\n}\n\ntool.Equipped:connect(function()\n hold = true\nend)\n\ntool.Unequipped:connect(function()\n   hold = false\nend)\n\ntool.Activated:connect(function()\n    if enabled == false then\n        enabled = true\n        tool.GripForward = Vector3.new(-0.976,0,-0.217)\n    tool.GripPos = Vector3.new(.95,-0.76,1.4)\n    tool.GripRight = Vector3.new(0.217,0, 0.976)\n    tool.GripUp = Vector3.new(0,1,0)\n    wait(.8)\n    tool.GripForward = positions.forward\n    tool.GripPos = positions.pos\n    tool.GripRight = positions.right\n    tool.GripUp = positions.up\n    enabled = false\n    end\nend)\n\ngame:GetService(\"RunService\").Heartbeat:connect(function()\n    pcall(function()\n       char[hat].Handle.Velocity = Vector3.new(30, 0, 0)\nif hold == false then\n    char[hat].Handle.CFrame = fake.Handle.CFrame\nelseif hold == true then\n    char[hat].Handle.CFrame = handle.CFrame\n    end\nend)\nend)\nend","features":"Eat Self Hats","tags":[],"discord":"","keyLink":"","owner":{"_id":"6319c9c2c51e6fcc56a31beb","username":"BlackDevGokussjGod","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5a1b203ce25329b587c70c05a293c9c3be964e769b5f14a92c08cde3d7955252.webp","original":"https://scriptblox.com/images/photo/6319c9c2c51e6fcc56a31beb-1723496242484.png"},"status":"offline","id":"6319c9c2c51e6fcc56a31beb","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/5a1b203ce25329b587c70c05a293c9c3be964e769b5f14a92c08cde3d7955252.webp","original"