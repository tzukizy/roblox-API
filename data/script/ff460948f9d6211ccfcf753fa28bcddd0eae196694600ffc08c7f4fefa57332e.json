{"_id":"699a0599904f3dece0d91b3b","title":"auto farm - kills & credits","game":{"_id":"67e5e1ffb360710ec3c77d23","gameId":4282985734,"name":"Combat Warriors","imageUrl":{"url":"https://media.kocakz.me/b997ff564942617e52a6b0ef46e0d83c4eb9d6863da2ee88d19763dde0dd8520.webp","original":"https://tr.rbxcdn.com/180DAY-aceb5959312903e9ffd26462c3584fcc/150/150/Image/Png/noFilter"},"slug":"4282985734-combat-warriors","path":"/game/4282985734-combat-warriors","thumbnail":{"url":"https://media.kocakz.me/b997ff564942617e52a6b0ef46e0d83c4eb9d6863da2ee88d19763dde0dd8520.webp","original":"https://tr.rbxcdn.com/180DAY-aceb5959312903e9ffd26462c3584fcc/150/150/Image/Png/noFilter"},"placeId":4282985734},"slug":"Combat-Warriors-CW-Auto-Farm-115821","verified":false,"key":false,"keyless":false,"views":6072,"executes":6997,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-3e930b16aa240db7470e6416718fb4dc-88554d517f8e.png","scriptblox":"https://scriptblox.com/images/script/rbx-3e930b16aa240db7470e6416718fb4dc-88554d517f8e.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-3e930b16aa240db7470e6416718fb4dc-88554d517f8e.png","scriptblox":"https://scriptblox.com/images/script/rbx-3e930b16aa240db7470e6416718fb4dc-88554d517f8e.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2026-02-21T19:20:57.296Z","updatedAt":"2026-02-21T19:20:57.296Z","lastBump":"2026-02-21T19:20:57.296Z","script":"getgenv().AutoFarm = true\n\nlocal username = \"PlantMeAStar\" -- put the target username here\n\nlocal function MainAccount()\n    for i, v in pairs(game:GetService(\"Players\"):GetPlayers()) do\n        if v.Name == username then\n            return v\n        end\n    end\n    return nil \nend\n\nlocal function TTM()\n    local target = MainAccount()\n\n    if not target then\n        warn(\"Target player '\" .. username .. \"' not found in server.\")\n        return\n    end\n    if not target.Character then\n        warn(\"Target player's character is not loaded yet.\")\n        return\n    end\n\n    local Players = game.Players.LocalPlayer\n\n    if not Players.Character then return end\n\n    local Target = target.Character:FindFirstChild(\"HumanoidRootPart\")\n    if not Target then return end\n\n    local TweenService = game:GetService(\"TweenService\")\n    local tweenInfo = TweenInfo.new(\n        0,\n        Enum.EasingStyle.Linear,\n        Enum.EasingDirection.Out,\n        0,\n        false,\n        0\n    )\n\n    local tweenGoal = { CFrame = Target.CFrame }\n    local tween = TweenService:Create(Players.Character.HumanoidRootPart, tweenInfo, tweenGoal)\n    tween:Play()\nend\n\nwhile getgenv().AutoFarm do\n    task.wait()\n    TTM()\nend","features":"This script will teleport all your alt accounts to your 'Main' where you can endless farm them. If this does well I'll make every way better and maybe even turn it into a project. \n\n[Beware Bugs] - I made this in 5 Minutes.","tags":[],"discord":"","keyLink":"","owner":{"_id":"6958169312e556facd862a0d","username":"rhetoric","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1536bc0bee436e06e545fe6db8859614ecb3f782c3cc92323a0076f2f14969d7.webp","original":"https://scriptblox.com/images/photo/6958169312e556facd862a0d-1776945879537.png"},"status":"offline","id":"6958169312e556facd862a0d","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/1536bc0bee436e06e545fe6db8859614ecb3f782c3cc92323a0076f2f14969d7.webp","original":"https://scriptblox.com/images/photo/6958169312e556facd862a0d-1776945879537.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:39:59.351Z","last":"","win":14,"math