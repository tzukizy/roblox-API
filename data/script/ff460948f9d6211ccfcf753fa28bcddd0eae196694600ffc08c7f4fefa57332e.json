{"slug":"Combat-Warriors-CW-Auto-Farm-115821","_id":"699a0599904f3dece0d91b3b","title":"auto farm - kills & credits","game":{"_id":"67e5e1ffb360710ec3c77d23","gameId":4282985734,"name":"Combat Warriors","imageUrl":"/images/sb/rbx-a631d6d73730a77f93b02eb3b0e8b06c-11edcb05786b.png","placeId":4282985734},"features":"This script will teleport all your alt accounts to your 'Main' where you can endless farm them. If this does well I'll make every way better and maybe even turn it into a project. \n\n[Beware Bugs] - I made this in 5 Minutes.","tags":[],"script":"getgenv().AutoFarm = true\n\nlocal username = \"PlantMeAStar\" -- put the target username here\n\nlocal function MainAccount()\n    for i, v in pairs(game:GetService(\"Players\"):GetPlayers()) do\n        if v.Name == username then\n            return v\n        end\n    end\n    return nil \nend\n\nlocal function TTM()\n    local target = MainAccount()\n\n    if not target then\n        warn(\"Target player '\" .. username .. \"' not found in server.\")\n        return\n    end\n    if not target.Character then\n        warn(\"Target player's character is not loaded yet.\")\n        return\n    end\n\n    local Players = game.Players.LocalPlayer\n\n    if not Players.Character then return end\n\n    local Target = target.Character:FindFirstChild(\"HumanoidRootPart\")\n    if not Target then return end\n\n    local TweenService = game:GetService(\"TweenService\")\n    local tweenInfo = TweenInfo.new(\n        0,\n        Enum.EasingStyle.Linear,\n        Enum.EasingDirection.Out,\n        0,\n        false,\n        0\n    )\n\n    local tweenGoal = { CFrame = Target.CFrame }\n    local tween = TweenService:Create(Players.Character.HumanoidRootPart, tweenInfo, tweenGoal)\n    tween:Play()\nend\n\nwhile getgenv().AutoFarm do\n    task.wait()\n    TTM()\nend","owner":{"_id":"6958169312e556facd862a0d","username":"rhetoric","verified":false,"profilePicture":"/images/photo/6958169312e556facd862a0d-1776945879537.png","status":"offline","id":"6958169312e556facd862a0d","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":5834,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-3e930b16aa240db7470e6416718fb4dc-88554d517f8e.png","likeCount":2,"dislikeCount":1,"createdAt":"2026-02-21T19:20:57.296Z","keyLink":"","editBy":{"_id":"6958169312e556facd862a0d","username":"rhetoric","status":"offline","id":"6958169312e556facd862a0d"},"executes":5651,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"699a0599904f3dece0d91b3f","editBy":{"_id":"6958169312e556facd862a0d","username":"rhetoric","status":"offline","id":"6958169312e556facd862a0d"},"message":"Create script","createdAt":"2026-02-21T19:20:57.305Z"},{"_id":"699ac9c5f698b519589da576","editBy":{"_id":"6958169312e556facd862a0d","username":"rhetoric","status":"offline","id":"6958169312e556facd862a0d"},"message":"Update script","createdAt":"2026-02-22T09:17:57.725Z"}],"comments":[{"_id":"699a198f1adc66c197bc5128","commentBy":{"_id":"663c3746d0f41df927fd0cac","username":"6nnn","verified":false,"role":"user","profilePicture":"/images/photo/663c3746d0f41df927fd0cac-1773067966368.png","createdAt":"2024-05-09T02:39:02.374Z","lastActive":"2026-05-24T07:58:04.261Z","status":"offline","id":"663c3746d0f41df927fd0cac","topMilestone":{"key":"creator.scripts","tier":5}},"text":"dont work","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-21T20:46:07.083Z","liked":false,"disliked":false},{"_id":"699abcf45313a8861d15cda0","commentBy":{"_id":"6958169312e556facd862a0d","username":"rhetoric","verified":false,"role":"user","profilePicture":"/images/photo/6958169312e556facd862a0d-1776945879537.png","lastActive":"2026-07-09T12:43:05.059Z","createdAt":"2026-01-02T19:03:47.286Z","status":"offline","id":"6958169312e556facd862a0d","topMilestone":{"key":"creator.executions","tier":10000}},"text":"@6nnn does","parent":{"_i