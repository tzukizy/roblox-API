{"slug":"Survive-Flight-871-ZOMBIE-mode-UPDATE-Script-16398","_id":"66a90fbccc0072b436304eb8","title":"Script","game":{"_id":"67e5e1ffb360710ec3c78bd8","gameId":16884010485,"name":"Survive Flight 871 ","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":16884010485},"features":"- Auto Collect Meat (in range)\n- Auto Collect Wood (Infinity Range)\n- Build Truck Faster (in range)\n- Faster Player (speed 60)\n\nspd no limit my gui has no slider\n\ncontact, discord: vateq","tags":["op","dupe","instant","survival","cheats"],"script":"local lib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/vateq/EZZ/main/nextui3coregui\"))()\n\nlocal main = lib.Load(\"Survival\")\nlocal TabNum1 = main:AddTab(\"Main\")\nmain:SelectTab(1) -- Selects the first tab\n\n_G.main = {\n    collectwood = false,\n    collect_collectables = false,\n    attackbears = false\n}\n\nlocal section = TabNum1:AddSection(\"Main\")\n\nsection:AddToggle({\n    Name = \"Collect Collectables\",\n    Default = false,\n    Callback = function(Value)\n        _G.main.collect_collectables = Value\n\n        while _G.main.collect_collectables and task.wait() do\n            for i, item in workspace:GetChildren() do\n                if item:FindFirstChild(\"ProximityPrompt\") then\n                    fireproximityprompt(item:FindFirstChild(\"ProximityPrompt\"),1)\n                end\n            end\n        end\n    end\n})\n\nsection:AddToggle({\n    Name = \"Collect Wood\",\n    Default = false,\n    Callback = function(Value)\n        _G.main.collectwood = Value\n        while _G.main.collectwood and task.wait() do\n            for i, item in workspace:GetChildren() do\n                if item.Name == \"wood\" then\n                    firetouchinterest(item, game.Players.LocalPlayer.Character.HumanoidRootPart, 0)\n                    firetouchinterest(item, game.Players.LocalPlayer.Character.HumanoidRootPart, 1)\n                end\n            end\n        end\n    end\n})\n\nsection:AddButton({\n    Title = \"Quick Truck Complete\",\n    Callback = function()\n        local item = workspace.truck\n\n        for i, zack in item:GetChildren() do\n            if zack:FindFirstChild(\"ProximityPrompt\") then\n                fireproximityprompt(zack:FindFirstChild(\"ProximityPrompt\"),1)\n            end\n        end\n    end\n})\n\nsection:AddToggle({\n    Name = \"Faster Character\",\n    Default = false,\n    Callback = function(Value)\n        if Value then\n            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 60\n        else\n            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16\n        end\n    end\n})","owner":{"_id":"662c002c61d29c1291f500cb","username":"VateQ","verified":false,"profilePicture":{"url":"https://media.kocakz.me/bfce58fd3fa8c6186d615190eaff561fbc6c93076368965819e445e1d556e26b.webp","original":"https://scriptblox.com/images/photo/662c002c61d29c1291f500cb-1754571111816.png"},"status":"offline","id":"662c002c61d29c1291f500cb","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/bfce58fd3fa8c6186d615190eaff561fbc6c93076368965819e445e1d556e26b.webp","original":"https://scriptblox.com/images/photo/662c002c61d29c1291f500cb-1754571111816.png"}},"verified":false,"keyLink":"","views":54731,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-30T16:07:24.652Z","dislikeCount":2,"likeCount":2,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/f5ebff46d5822d8e0b294096218d82ec/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/f5ebff46d5822d8e0b294096218d82ec/500/280/Image/Jpeg"},"executes":353,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-