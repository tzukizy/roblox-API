{"slug":"Escape-Jail-Obby-2-Fast-Coins-Script-50177","_id":"68ae396f8f824dfe93c88c5a","title":"Fast Coins Script","game":{"_id":"68ae396f8f824dfe93c88c57","gameId":163729669,"name":"Escape Jail Obby 2","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":163729669},"features":"Get's you alot of coins, very fast.\n\nHow to use:\nExecute the script.\nIf you don't have an executor this isn't for you.","tags":["coins","fast","auto","script","escape jail obby"],"script":"print(\"Bro\")\nlocal Character = game.Players.LocalPlayer.Character\nlocal hrp = Character.HumanoidRootPart\n\nlocal CoinGiver = workspace.TeleportStuff.CoinGiver\nlocal BackToMoutain = workspace.TeleportStuff:GetChildren()[4].Head\nlocal Coins = (function()\n\tlocal CoinsFound = {}\n\tfor i,v in pairs(workspace.Coins:GetDescendants()) do\n\t\tif v.ClassName == \"Part\" then\n\t\t\ttable.insert(CoinsFound, v)\n\t\tend\n\tend\n\treturn CoinsFound\nend)()\n\n\nlocal function QuickTouch(Part)\n\tfiretouchinterest(hrp, Part, 0)\n\tfiretouchinterest(hrp, Part, 1)\nend\n\nlocal function InstaExtraCredit()\n\tQuickTouch(CoinGiver)\n\tQuickTouch(BackToMoutain)\nend\n\nlocal function CollectAllCoins()\n\tfor i, Coin in pairs(Coins) do\n\t\tQuickTouch(Coin)\n\tend\nend\n\nlocal OldCFrame = hrp.CFrame\nhrp:GetPropertyChangedSignal(\"CFrame\"):Connect(function()\n\tlocal old_hrpPos = OldCFrame.Position\n\tlocal hrpPos = hrp.Position\n\tif (hrpPos - old_hrpPos).Magnitude > hrp.Velocity.Magnitude * 2 then\n\t\thrp.CFrame = OldCFrame\n\t\tprint(\"Corrected Teleport.\")\n\tend\nend)\n\nwhile task.wait() do\n\tOldCFrame = hrp.CFrame\n\tInstaExtraCredit()\n\tCollectAllCoins()\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://script