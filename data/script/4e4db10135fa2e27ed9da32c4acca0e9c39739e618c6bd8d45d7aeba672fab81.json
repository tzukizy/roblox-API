== \"]\" then\n            if tape[tapePointer] ~= 0 then\n                codePointer = loopStack[#loopStack]\n            else\n                table.remove(loopStack, #loopStack)\n            end\n        end\n\n        codePointer = codePointer + 1\n    end\nend\n\ninterpretBF(program)\nprint(output)","owner":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/1484268a0ad67e2b36aae926e758be00a4b3350756596ca549814fd03a6696fa.webp","original":"https://scriptblox.com/images/photo/67bc97cb97d44a5622870c63-1779784138529.png"},"status":"offline","id":"67bc97cb97d44a5622870c63","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/1484268a0ad67e2b36aae926e758be00a4b3350756596ca549814fd03a6696fa.webp","original":"https://scriptblox.com/images/photo/67bc97cb97d44a5622870c63-1779784138529.png"}},"verified":false,"views":445,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/753e38c3b0787632d69b15852418ab04c96392652614c19cdd8f094254e90fd0.webp","original":"https://scriptblox.com/images/sb/0-1765307813638.png","scriptblox":"https://scriptblox.com/images/script/0-1765307813638.png"},"likeCount":1,"dislikeCount":3,"createdAt":"2025-12-09T19:16:53.664Z","editBy":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","status":"offline","id":"67bc97cb97d44a5622870c63"},"keyLink":"","executes":120,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:42:23.169Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/753e38c3b0787632d69b15852418ab04c96392652614c19cdd8f094254e90fd0.webp","original":"https://scriptblox.com/images/sb/0-1765307813638.png","scriptblox":"https://scriptblox.com/images/script/0-1765307813638.png"}