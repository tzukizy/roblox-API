{"_id":"695304f339aa8f16143cd648","title":"Hitbox Expander","game":{"_id":"6942878defa5e4fa55a8d249","gameId":73526576502092,"name":"Sonic.EXE: The Disaster Eclipsed v1.4","imageUrl":{"url":"https://media.kocakz.me/bc3e849737b03b1d4e58f47d788fae7d41775fb0cee0ab52533d1a1b1a448d4f.webp","original":"https://tr.rbxcdn.com/180DAY-a04719c4b9112aee5b4ae16f4ddc4410/150/150/Image/Png/noFilter"},"slug":"73526576502092-sonic-exe-the-disaster-eclipsed-v1-4","path":"/game/73526576502092-sonic-exe-the-disaster-eclipsed-v1-4","thumbnail":{"url":"https://media.kocakz.me/bc3e849737b03b1d4e58f47d788fae7d41775fb0cee0ab52533d1a1b1a448d4f.webp","original":"https://tr.rbxcdn.com/180DAY-a04719c4b9112aee5b4ae16f4ddc4410/150/150/Image/Png/noFilter"},"placeId":73526576502092},"slug":"Sonic.EXE:-The-Disaster-Eclipsed-v1.39-Hitbox-Expander-79743","verified":false,"key":false,"keyless":false,"views":5915,"executes":22881,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4b49ac8489e591a2bc60da5c6f6a7b5ad2670e8fe8d87600aea6ce04667c5c9c.webp","original":"https://scriptblox.com/images/sb/rbx-2d3e1eb3b51d1e90ac2dd644abe276a5-212fb098cfd6.png","scriptblox":"https://scriptblox.com/images/script/rbx-2d3e1eb3b51d1e90ac2dd644abe276a5-212fb098cfd6.png"},"thumbnail":{"url":"https://media.kocakz.me/4b49ac8489e591a2bc60da5c6f6a7b5ad2670e8fe8d87600aea6ce04667c5c9c.webp","original":"https://scriptblox.com/images/sb/rbx-2d3e1eb3b51d1e90ac2dd644abe276a5-212fb098cfd6.png","scriptblox":"https://scriptblox.com/images/script/rbx-2d3e1eb3b51d1e90ac2dd644abe276a5-212fb098cfd6.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-29T22:47:15.752Z","updatedAt":"2025-12-29T22:47:15.752Z","lastBump":"2025-12-29T22:47:15.752Z","script":"local Players = game:GetService(\"Players\")\nlocal LP = Players.LocalPlayer\n\nfor _, v in ipairs(Players:GetPlayers()) do\n    if v ~= LP then\n        local char = v.Character\n        if char then\n            local torso = char:FindFirstChild(\"torso\")\n            if torso then\n                local collision = torso:FindFirstChild(\"collision\")\n                if collision then\n                    collision.Size = Vector3.new(30, 30, 30)\n                    collision.Transparency = 1\n                end\n            end\n        end\n    end\nend","features":"Extends player hitbox into size which written in (30, 30, 30) you can change that number to whatever size you want-\nAlso you can change transparency to whatever you want - 0 will show full collision and 1 will fully hide it.","tags":["sonicexe","roblox","script"],"discord":"","keyLink":"","owner":{"_id":"673359e0bdaef29285037406","username":"StewBradar","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b5a562b87d03bd9795fde9235d0443bcbb62bab815f5ac605592ead2d327f103.webp","original":"https://scriptblox.com/images/photo/673359e0bdaef29285037406-1790446588742.png"},"lvl":8,"status":"offline","id":"673359e0bdaef29285037406","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/b5a562b87d03bd9795fde9235d0443bcbb62bab815f5ac605592ead2d327f103.webp","original":"https://scriptblox.com/images/photo/673359e0bdaef29285037406-1790446588742.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-22T02:45:10.913Z","last":"w","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"695304f339aa8f16143cd64a","editBy":{"_id":"673359e0bdaef29285037406","username":"StewBradar","status":"offline","id":"673359e0bdaef29285037406"},"message":"Create script","createdAt":"2025-12-29T22:47:15.753Z"}],"comments":[{"_id":"69533bc8412eaa14dbbacf03","commentBy":{"_id":"6945dd901da100534bff0405","username":"mrsnipero890","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz