{"slug":"Universal-Script-Leave-When-Someone-Joins-90957","_id":"6974766a63b88be833d227a0","title":"Leave When Someone Joins","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"You can choose to automatically leave the game if players are currently detected in your server, or if players join leater.","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal localPlayer = Players.LocalPlayer\n\n-- Toggles\nlocal kickIfAlreadyInServer = true   -- kicks if someone is already in server\nlocal kickOnPlayerJoin = true        -- kicks if someone joins later\n\nif kickIfAlreadyInServer then\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tif player ~= localPlayer then\n\t\t\tlocalPlayer:Kick(\"Another player is already in the server.\")\n\t\t\treturn\n\t\tend\n\tend\nend\n\nif kickOnPlayerJoin then\n\tPlayers.PlayerAdded:Connect(function(player)\n\t\tif player ~= localPlayer then\n\t\t\tlocalPlayer:Kick(\"Another player joined the server.\")\n\t\tend\n\tend)\nend","owner":{"_id":"68ce4dac5100bcf3f3ef8ca6","username":"etherheaded","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/06c7debf4a70e0172f06c769dafe54a284a5dc51579a88f4b04eec99e5b6e92e.webp","original":"https://scriptblox.com/images/photo/68ce4dac5100bcf3f3ef8ca6-1758350881791.png"},"status":"offline","id":"68ce4dac5100bcf3f3ef8ca6","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/06c7debf4a70e0172f06c769dafe54a284a5dc51579a88f4b04eec99e5b6e92e.webp","original":"https://scriptblox.com/images/photo/68ce4dac5100bcf3f3ef8ca6-1758350881791.png"}},"verified":false,"views":764,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/e55af3d80f8e2a489b2ce