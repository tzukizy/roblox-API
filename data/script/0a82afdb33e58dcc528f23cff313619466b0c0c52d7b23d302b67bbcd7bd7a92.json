er = function()\n    local closest_distance, player = math.huge, nil;\n\n    for _, value in players:GetPlayers() do\n        if not (value == local_player) then\n            local character = value.Character;\n            local root_part = character and character:FindFirstChild(\"HumanoidRootPart\");\n                \n            if not (root_part) then continue end;\n\n            local screen_position, visible = camera:WorldToViewportPoint(root_part.Position);\n            local distance = (Vector2.new(screen_position.X, screen_position.Y) - user_input_service:GetMouseLocation()).Magnitude;\n\n            if not visible then continue end;\n\n            if distance < closest_distance then\n                player = value;\n                closest_distance = distance;\n            end;\n        end;\n    end;\n\n    return player;\nend;\n\nrun_service.RenderStepped:Connect(function()\n    if (silent_aim_enabled) then\n        closest = get_closest_player();\n    end\nend)\n\nlocal old_func = common_functions.RayCast;\ncommon_functions.RayCast = function(origin, direction, i_dont_know_what_this_is, idk_either_but_probably_ignore_list) --// detected, use hookfunc\n    if (silent_aim_enabled and closest) then\n        local bone_position = closest.Character.Head.Position;\n        direction = bone_position; --// not accurate\n    end;\n    \n    return old_func(origin, direction, i_dont_know_what_this_is, idk_either_but_probably_ignore_list);\nend;","features":"shit silent","tags":[],"discord":"","keyLink":"","owner":{"_id":"65e878118649bee11545f64d","username":"sametexe","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2185fb968caadafc79e132fef3c5c8109f1b021cd0acf8a836a1184c82c2585c.webp","original":"https://scriptblox.com/images/photo/65e878118649bee11545f64d-1729269485662.jpg"},"status":"offline","id":"65e878118649bee11545f64d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/2185fb968caadafc79e132fef3c5c