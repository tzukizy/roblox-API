ompleted:Wait()\n        end\n    end\n    task.wait()\nend","owner":{"_id":"684ed1e0f85943d0727e8335","username":"Metal","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/79c351bc8bb75435a24d53dbb8bdfa783b35e3a77ce2dd950d4ebbb1daef06c6.webp","original":"https://scriptblox.com/images/photo/684ed1e0f85943d0727e8335-1766591232749.jpg"},"status":"offline","id":"684ed1e0f85943d0727e8335","leaderboard":{"tag":null},"topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/79c351bc8bb75435a24d53dbb8bdfa783b35e3a77ce2dd950d4ebbb1daef06c6.webp","original":"https://scriptblox.com/images/photo/684ed1e0f85943d0727e8335-1766591232749.jpg"}},"verified":false,"discord":"https://discord.gg/TR3quUFgT6","views":7879,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-0458177ee998eb2ffd882ad46207e4c5-bfa6ab60a3fb.png","scriptblox":"https://scriptblox.com/images/script/rbx-0458177ee998eb2ffd882ad46207e4c5-bfa6ab60a3fb.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2025-11-08T16:08:52.941Z","editBy":{"_id":"684ed1e0f85943d0727e8335","username":"Metal","status":"offline","id":"684ed1e0f85943d0727e8335"},"keyLink":"","executes":339,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:40:23.641Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-0458177ee998eb2ffd882ad46207e4c5-bfa6ab60a3fb.png","scriptblox":"https://scriptblox.com/images/script/rbx-0458177ee998eb2ffd882ad46207e4c5-bfa6ab60a3fb.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"690f6b146044b91300fbb273","editBy":{"_id":"684ed1e0f85943d0727e8335","username":"Metal","status":"offl