{"slug":"Universal-Script-invisibility-43672","_id":"6864dbbfe2d436c13bda9e11","title":"invisibility","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"make u invisible to other player + open source CLICK x TO TOGGLE NO MOBILE","tags":["invisibility"],"script":"local UIS = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal LP = Players.LocalPlayer\nlocal Char = LP.Character or LP.CharacterAdded:Wait()\nlocal HRP = Char:WaitForChild(\"HumanoidRootPart\")\nlocal key = Enum.KeyCode.X\nlocal invis_on = false\nlocal seat\nlocal function setTransparency(char, value)\n\tfor _, part in ipairs(char:GetDescendants()) do\n\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\tpart.Transparency = value\n\t\telseif part:IsA(\"Decal\") then\n\t\t\tpart.Transparency = value\n\t\tend\n\tend\nend\nlocal function toggleInvisibility()\n\tinvis_on = not invis_on\n\n\tif invis_on then\n\t\tlocal savedPos = HRP.CFrame\n\t\tChar:MoveTo(Vector3.new(-25.95, 84, 3537.55))\n\t\ttask.wait(0.15)\n\t\tseat = Instance.new(\"Seat\")\n\t\tseat.Anchored = false\n\t\tseat.CanCollide = false\n\t\tseat.Name = \"invischair\"\n\t\tseat.Transparency = 1\n\t\tseat.Position = Vector3.new(-25.95, 84, 3537.55)\n\t\tseat.Parent = workspace\n\t\tlocal torso = Char:FindFirstChild(\"Torso\") or Char:FindFirstChild(\"UpperTorso\")\n\t\tlocal weld = Instance.new(\"WeldConstraint\")\n\t\tweld.Part0 = seat\n\t\tweld.Part1 = torso\n\t\tweld.Parent = seat\n\t\ttask.wait(0.1)\n\t\tHRP.CFrame = savedPos\n\t\tsetTransparency(Char, 0.5)\n\t\tgame.StarterGui:SetCore(\"SendNotification\", {\n\t\t\tTitle = \"Invisibility On\";\n\t\t\tDuration = 3;\n\t\t\tText = \"You are now fully invisible.\";\n\t\t})\n\telse\n\t\tif seat and seat.Parent then\n\t\t\tseat:Destroy()\n\t\tend\n\t\tsetTransparency(Char, 0)\n\t\tgame.StarterGui:SetCore(\"SendNotification\", {\n\t\t\tTitle = \"Invisibility Off\";\n\t\t\tDuration = 3;\n\t\t\tText = \"You are now visible.\";\n\t\t})\n\tend\nend\nUIS.InputBegan:Connect(function(input, gpe)\n\tif not gpe and input.KeyCode == key then\n\t\ttoggleInvisibility()\n\tend\nend)\n","owner":{"_id":"6832672134b8aa44421efab8","username":"exploitingrobloxian","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/774685d2de89b370985c345e765981e4cb9b93d3853b98e6fd8387ce66b5ed49.webp","original":"https://scriptblox.com/images/photo/6832672134b8aa44421efab8-1751506484755.png"},"status":"offline","id":"6832672134b8aa44421efab8","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/774685d2de89b370985c345e765981e4cb9b93d3853b98e6fd8387ce66b5ed49.webp","original":"https://scriptblox.com/images/photo/6832672134b8aa44421efab8-1751506484755.png"}},"verified":false,"views":6764,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/684dc29fd33801fd276ad6231329df782068770122d57f4e2e6fdd07037e9c21.webp","original":"https://scriptblox.com/images/sb/0-1751440319318.png","scriptblox":"https://scriptblox.com/images/script/0-1751440319318.png"},"likeCount":4,"dislikeCount":2,"createdAt":"2025-07-02T07:11:59.397Z","executes":101,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:54:53.854Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/684dc29fd33801fd276ad6231329df782068770122d57f4e2e6fdd07037e9c21.webp","original":"https://scriptblox.com/images/sb/0-1751440319318.png","scriptblox":"https://scriptblox.com/images/script/0-1751440319318.png"},"changelog":[{"_id":"6864dbbfe2d436c1