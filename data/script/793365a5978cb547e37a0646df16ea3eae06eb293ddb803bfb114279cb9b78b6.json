ild(\"Activation\")\n\nlocal function getClosestEnemy()\n    local closestEnemy, shortestDist = nil, math.huge\n    local myChar = LocalPlayer.Character\n    if not myChar or not myChar:FindFirstChild(\"HumanoidRootPart\") then return nil end\n\n    local myPos = myChar.HumanoidRootPart.Position\n\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Team ~= LocalPlayer.Team then\n            local char = player.Character\n            if char and char:FindFirstChild(\"HumanoidRootPart\") and char:FindFirstChildOfClass(\"Humanoid\").Health > 0 then\n                local dist = (char.HumanoidRootPart.Position - myPos).Magnitude\n                if dist < shortestDist then\n                    shortestDist = dist\n                    closestEnemy = char\n                end\n            end\n        end\n    end\n\n    return closestEnemy\nend\n\nlocal function aimAtEnemy()\n    local enemy = getClosestEnemy()\n    if enemy then\n        Activation:FireServer(\"Aim\", enemy.HumanoidRootPart.Position)\n    end\nend\n\nwhile task.wait(1) do\n    aimAtEnemy()\nend","features":"It's will check team & auto fire","tags":["Red vs Blue"],"discord":"","keyLink":"","owner":{"_id":"675c69e1021803dea1db824f","username":"gojohdkaisenkt_alt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/20e6189234f07d6f9f54ff71bd3030733351f952c6b8bd08e33e34e7b448f5d6.webp","original":"https://scriptblox.com/images/photo/675c69e1021803dea1db824f-1750062339650.png"},"status":"offline","id":"675c69e1021803dea1db824f","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/20e6189234f07d6f9f54ff71bd3030733351f952c6b8bd08e33e34e7b448f5d6.webp","original":"https://scriptblox.com/images/photo/675c69e1021803dea1db824f-1750062339650.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":fals