nGroup(part, \"Default\")\n        end\n     end\n  end\nend\n\n  Players.PlayerAdded:Connect(function(player)\n    player.CharacterAdded:Connect(function(character)\n      wait(1)\n      local noclipEnabled = true\n      setNoClip(character, noclipEnabled)\n  end)\nend)","features":"NoClip","tags":[],"discord":"","keyLink":"","owner":{"_id":"69966ec3ebbf6df38e0b31b5","username":"SlimTrix","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69966ec3ebbf6df38e0b31b5","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:31:56.722Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b8e1dd88a9c0cf6487fa0a","editBy":{"_id":"69966ec3ebbf6df38e0b31b5","username":"SlimTrix","status":"offline","id":"69966ec3ebbf6df38e0b31b5"},"message":"Create script","createdAt":"2026-03-17T05:08:45.801Z"}],"comments":[]}