e(\"SendNotification\",{Title=\"HACK\",Text=\"JUMP ON\"})\n    elseif k==\"c\" then \n        for _,v in pairs(workspace:GetDescendants()) do if v:IsA(\"TouchTransmitter\") then v:Destroy() end end\n        game.StarterGui:SetCore(\"SendNotification\",{Title=\"HACK\",Text=\"LAVA REMOVED (GODMODE)\"})\n    elseif k==\"v\" then H.WalkSpeed=16; H.JumpPower=50\n        game.StarterGui:SetCore(\"SendNotification\",{Title=\"HACK\",Text=\"RESET\"})\n    end\nend)\n","features":"Functions (on the keys): * Z — Super-speed (you run faster). * X — Mega jump (you'll jump half the map). * C — REMOVE THE LAVA (The most important thing is that the script finds all the killing blocks and breaks them, now you can walk on the red blocks!). * V — Return everything as it was (normal speed and jump).","tags":["Barrys Prison Run","Obby","Obby Destroyer","Obby God Mode"],"discord":"","keyLink":"","owner":{"_id":"6925b0e9de5baa1e5ba4d4b4","username":"Bingus0us","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4a739c8bfb4deccb9bb63cc8cf1b4f8d54a42d9320e3d8fc4ca6a0d40bff48b4.webp","original":"https://scriptblox.com/images/photo/6925b0e9de5baa1e5ba4d4b4-1766180053237.jpg"},"status":"offline","id":"6925b0e9de5baa1e5ba4d4b4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/4a739c8bfb4deccb9bb63cc8cf1b4f8d54a42d9320e3d8fc4ca6a0d40bff48b4.webp","original":"https://scriptblox.com/images/photo/6925b0e9de5baa1e5ba4d4b4-1766180053237.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:42:11.458Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69456cdefb35c78b20310922","editBy":{"_id":"6925b0e9de5baa1e5ba4d4b4","username":"Bingus0us","status":"offline","id":"6925b0e9de5baa1e5ba4d4b4"},"message":"Create script","createdAt":"2025-12-19T15:18:54.992Z"