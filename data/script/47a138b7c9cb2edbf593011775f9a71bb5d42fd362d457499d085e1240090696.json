{"slug":"Universal-Script-Basic-First-Person-script-111394","_id":"6990bb1fa232c638459e0463","title":"Basic First Person script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Only features are a high FoV and you can see your body on first person.\nIn some games it bugs when you reset and gets your camera stuck on first person until you rejoin.","tags":["firstperson","realistic"],"script":"-- initialize local variables\nlocal camera = workspace.CurrentCamera\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character\nlocal humanoid = character.Humanoid\n \n-- camera settings\nplayer.CameraMaxZoomDistance = 0.5 -- force first person\ncamera.FieldOfView = 100\nhumanoid.CameraOffset = Vector3.new(0, 0, -1)\n \n-- set and keep every body part Transparency to its real transparency\nfor childIndex, child in pairs(character:GetChildren()) do\n    if child:IsA(\"BasePart\") and child.Name ~= \"Head\" then\n        \n        child:GetPropertyChangedSignal(\"LocalTransparencyModifier\"):Connect(function()\n            child.LocalTransparencyModifier = child.Transparency\n        end)\n        \n        child.LocalTransparencyModifier = child.Transparency\n        \n    end\nend\n \n-- if the player steps in a vehicle\ncamera:GetPropertyChangedSignal(\"CameraSubject\"):Connect(function()\n    if camera.CameraSubject:IsA(\"VehicleSeat\") then\n        camera.CameraSubject = humanoid\n    end\nend)","owner":{"_id":"69814a1ad112a6adf2f3a42d","username":"allr359","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/494db0bd3a84b14f5fbf72d5cc830b6c440260372d4e60ac25c0dccb84f2e9c7.webp","original":"https://scriptblox.com/images/photo/69814a1ad112a6adf2f3a42d-1771095753718.png"},"status":"offline","id":"69814a1ad112a6adf2f3a42d","topMi