{"_id":"6990bb1fa232c638459e0463","title":"Basic First Person script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/af582d5a4902d76e5221579e83e4569bd4b56aa5067d734d7f19be39138fd93c.webp","original":"https://scriptblox.com/images/sb/0-1771092767873.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/af582d5a4902d76e5221579e83e4569bd4b56aa5067d734d7f19be39138fd93c.webp","original":"https://scriptblox.com/images/sb/0-1771092767873.png"},"placeId":0},"slug":"Universal-Script-Basic-First-Person-script-111394","verified":false,"key":false,"keyless":false,"views":813,"executes":470,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6e53ce57e59f8a3cc36c019091b1c7f1be2587882829e9c5b020ac99763dfa0a.webp","original":"https://scriptblox.com/images/sb/0-1771092767873.png","scriptblox":"https://scriptblox.com/images/script/0-1771092767873.png"},"thumbnail":{"url":"https://media.kocakz.me/6e53ce57e59f8a3cc36c019091b1c7f1be2587882829e9c5b020ac99763dfa0a.webp","original":"https://scriptblox.com/images/sb/0-1771092767873.png","scriptblox":"https://scriptblox.com/images/script/0-1771092767873.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-14T18:12:47.924Z","updatedAt":"2026-02-14T18:12:47.924Z","lastBump":"2026-02-14T18:12:47.924Z","script":"-- initialize local variables\nlocal camera = workspace.CurrentCamera\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character\nlocal humanoid = character.Humanoid\n \n-- camera settings\nplayer.CameraMaxZoomDistance = 0.5 -- force first person\ncamera.FieldOfView = 100\nhumanoid.CameraOffset = Vector3.new(0, 0, -1)\n \n-- set and keep every body part Transparency to its real transparency\nfor childIndex, child in pairs(character:GetChildren()) do\n    if child:IsA(\"BasePart\") and child.Name ~= \"Head\" then\n        \n        child:GetPropertyChangedSignal(\"LocalTransparencyModifier\"):Connect(function()\n            child.LocalTransparencyModifier = child.Transparency\n        end)\n        \n        child.LocalTransparencyModifier = child.Transparency\n        \n    end\nend\n \n-- if the player steps in a vehicle\ncamera:GetPropertyChangedSignal(\"CameraSubject\"):Connect(function()\n    if camera.CameraSubject:IsA(\"VehicleSeat\") then\n        camera.CameraSubject = humanoid\n    end\nend)","features":"Only features are a high FoV and you can see your body on first person.\nIn some games it bugs when you reset and gets your camera stuck on first person until you rejoin.","tags":["firstperson","realistic"],"discord":"","keyLink":"","owner":{"_id":"69814a1ad112a6adf2f3a42d","username":"allr359","verified":false,"profilePicture":{"url":"https://media.kocakz.me/494db0bd3a84b14f5fbf72d5cc830b6c440260372d4e60ac25c0dccb84f2e9c7.webp","original":"https://scriptblox.com/images/photo/69814a1ad112a6adf2f3a42d-1771095753718.png"},"status":"offline","id":"69814a1ad112a6adf2f3a42d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/494db0bd3a84b14f5fbf72d5cc830b6c440260372d4e60ac25c0dccb84f2e9c7.webp","original":"https://scriptblox.com/images/photo/69814a1ad112a6adf2f3a42d-1771095753718.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:33:33.012Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6990bb1fa232c638459e0467","editBy":{"_id":"69814a1ad112a6adf2f3a42d","username":"allr359","status":"offline","id":"69814a1ad112a6adf2f3a42d"},"message":"Create script","createdAt":"2026-02-14T18:12:47.925Z"}],"comments":[{"_id":"6990bd4b1a5b231013690824","commentBy":{"_id":"698a9faf35987d06cf0a57b3","username":"user346346346","verified":false,"role":"u