{"_id":"68cf55e253f222a76a31a1c5","title":"roblo pra","game":{"_id":"68c762a0b4f75ef997a4a1f7","gameId":88829149289682,"name":"Brainrot Jumping","imageUrl":{"url":"https://media.kocakz.me/ab279d24517aa47bd4fe246bae5827993eae754a050e0e1c873be5ce7120620c.webp","original":"https://tr.rbxcdn.com/180DAY-786f95f64004f253c0558640776e43a2/150/150/Image/Png/noFilter"},"slug":"88829149289682-brainrot-jumping","path":"/game/88829149289682-brainrot-jumping","thumbnail":{"url":"https://media.kocakz.me/ab279d24517aa47bd4fe246bae5827993eae754a050e0e1c873be5ce7120620c.webp","original":"https://tr.rbxcdn.com/180DAY-786f95f64004f253c0558640776e43a2/150/150/Image/Png/noFilter"},"placeId":88829149289682},"slug":"FIXED-Brainrot-Jumping-roblo-pra-54205","verified":false,"key":false,"keyless":false,"views":3408,"executes":81,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/916096a3dbca1be68f6c891957df3bae5132b18f3d5e197ac63605286080d476.webp","original":"https://scriptblox.com/images/sb/88829149289682-1758418402460.jpg","scriptblox":"https://scriptblox.com/images/script/88829149289682-1758418402460.jpg"},"thumbnail":{"url":"https://media.kocakz.me/916096a3dbca1be68f6c891957df3bae5132b18f3d5e197ac63605286080d476.webp","original":"https://scriptblox.com/images/sb/88829149289682-1758418402460.jpg","scriptblox":"https://scriptblox.com/images/script/88829149289682-1758418402460.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-09-21T01:33:22.475Z","updatedAt":"2025-09-21T01:33:22.475Z","lastBump":"2025-09-21T01:33:22.475Z","script":"-- Script para andar sobre a água no Roblox Studio\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n-- Altura acima da água\nlocal alturaAcimaAgua = 3\n\n-- Atualiza a posição constantemente\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n    local pos = rootPart.Position\n    -- Verifica se há água abaixo do personagem\n    local region = Region3.new(pos - Vector3.new(2,5,2), pos + Vector3.new(2,0,2))\n    local partes = workspace:FindPartsInRegion3(region, nil, 100)\n    \n    for _, parte in ipairs(partes) do\n        if parte.Material == Enum.Material.Water then\n            -- Mantém o personagem flutuando sobre a água\n            rootPart.Position = Vector3.new(pos.X, parte.Position.Y + alturaAcimaAgua, pos.Z)\n        end\n    end\nend)","features":"y","tags":[],"discord":"","keyLink":"","owner":{"_id":"68c4bed03e04f522d5830469","username":"heithorchiavegattide","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68c4bed03e04f522d5830469","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:55:47.835Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cf55e253f222a76a31a1c7","editBy":{"_id":"68c4bed03e04f522d5830469","username":"heithorchiavegattide","status":"offline","id":"68c4bed03e04f522d5830469"},"message":"Create script","createdAt":"2025-09-21T01:33:22.479Z"}],"comments":[]}