{"_id":"69bf66b550ebee851b743bfd","title":"inf money","game":{"_id":"69bf66b550ebee851b743bfa","gameId":129716608655168,"name":"⚙️ Create A Factory [Weather🌩️]","imageUrl":{"url":"https://media.kocakz.me/c98b9110776ef3235176d345187594cf2a380d95c6c3c86f5674959049397b70.webp","original":"https://scriptblox.com/images/sb/rbx-505e9ca7824e3f8d23c191ece2605a3a-66f228a9bb71.png"},"slug":"129716608655168-create-a-factory","path":"/game/129716608655168-create-a-factory","thumbnail":{"url":"https://media.kocakz.me/c98b9110776ef3235176d345187594cf2a380d95c6c3c86f5674959049397b70.webp","original":"https://scriptblox.com/images/sb/rbx-505e9ca7824e3f8d23c191ece2605a3a-66f228a9bb71.png"},"placeId":129716608655168},"slug":"Create-A-Factory-Weather-inf-money-138847","verified":false,"key":false,"keyless":false,"views":1545,"executes":82,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c48d2f75104dc0a60ec1a491539e701d4c0da8960d4db3daf3e44d398a459959.webp","original":"https://scriptblox.com/images/sb/rbx-505e9ca7824e3f8d23c191ece2605a3a-66f228a9bb71.png","scriptblox":"https://scriptblox.com/images/script/rbx-505e9ca7824e3f8d23c191ece2605a3a-66f228a9bb71.png"},"thumbnail":{"url":"https://media.kocakz.me/c48d2f75104dc0a60ec1a491539e701d4c0da8960d4db3daf3e44d398a459959.webp","original":"https://scriptblox.com/images/sb/rbx-505e9ca7824e3f8d23c191ece2605a3a-66f228a9bb71.png","scriptblox":"https://scriptblox.com/images/script/rbx-505e9ca7824e3f8d23c191ece2605a3a-66f228a9bb71.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-22T03:49:09.128Z","updatedAt":"2026-03-22T03:49:09.128Z","lastBump":"2026-03-22T03:49:09.128Z","script":"--// Services\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n--// Remove old GUI\npcall(function()\n    player.PlayerGui:FindFirstChild(\"MyGui\"):Destroy()\nend)\n\n--// GUI\nlocal gui = Instance.new(\"ScreenGui\", player.PlayerGui)\ngui.Name = \"MyGui\"\n\nlocal frame = Instance.new(\"Frame\", gui)\nframe.Size = UDim2.new(0, 240, 0, 140)\nframe.Position = UDim2.new(0.35, 0, 0.35, 0)\nframe.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nframe.Active = true\nframe.Draggable = true\n\nInstance.new(\"UICorner\", frame)\n\n--// Title\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1, 0, 0, 30)\ntitle.Text = \"Inf Money GUI\"\ntitle.BackgroundTransparency = 1\ntitle.TextColor3 = Color3.new(1,1,1)\ntitle.TextScaled = true\n\n--// Credit\nlocal credit = Instance.new(\"TextLabel\", frame)\ncredit.Size = UDim2.new(1, 0, 0, 20)\ncredit.Position = UDim2.new(0, 0, 1, -20)\ncredit.BackgroundTransparency = 1\ncredit.Text = \"Made by _OpenSource_\"\ncredit.TextColor3 = Color3.fromRGB(180,180,180)\ncredit.TextScaled = true\n\n--// State\n_G.InfMoney = false\n\n--// Button\nlocal btn = Instance.new(\"TextButton\", frame)\nbtn.Size = UDim2.new(1, -20, 0, 50)\nbtn.Position = UDim2.new(0, 10, 0, 45)\nbtn.BackgroundColor3 = Color3.fromRGB(40,40,40)\nbtn.TextColor3 = Color3.new(1,1,1)\nbtn.TextScaled = true\nbtn.Text = \"Inf Money [OFF]\"\n\nInstance.new(\"UICorner\", btn)\n\n--// Function\nbtn.MouseButton1Click:Connect(function()\n    _G.InfMoney = not _G.InfMoney\n    btn.Text = \"Inf Money [\"..(_G.InfMoney and \"ON\" or \"OFF\")..\"]\"\n    \n    task.spawn(function()\n        while _G.InfMoney do\n            local args = {\n                -7e999,\n                \"StraightConveyor\",\n                \"Item1\"\n            }\n            game:GetService(\"ReplicatedStorage\")\n                :WaitForChild(\"Events\")\n                :WaitForChild(\"Shop\")\n                :FireServer(unpack(args))\n            \n            task.wait(0.2)\n        end\n    end)\nend)","features":"inf money. follow me to stay update on my new scripts. also comment on my new scripts which game i should make expoilts for","tags":[],"discord":"","keyLink":"","owner":{"_id":"67cbc14c6e7623d225a5710