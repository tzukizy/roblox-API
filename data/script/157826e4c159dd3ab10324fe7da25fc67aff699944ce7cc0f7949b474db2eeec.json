{"slug":"!Tsunami-Escape-By-Delujo-Cars!-Escape-the-tsunami-by-wrecked-cars-byp*ed-103609","_id":"69860d6c35987d06cfbab12f","title":"Escape the tsunami by wrecked cars byp*ed","game":{"_id":"69860d6c35987d06cfbab12c","gameId":96473982750086,"name":"🌊!Tsunami Escape By Delujo Cars🌊🚘!🌊","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":96473982750086},"features":"-Bypass too\n-U can't get banned lol.","tags":["Fun","Undetected","Steall","Brainrot","Tsunami"],"script":"loadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Adonis-actul-bypass-20697\"))()\n\n-- Crear el ScreenGui en la interfaz del jugador\nlocal player = game.Players.LocalPlayer\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"TeleportGui\"\ngui.Parent = player:WaitForChild(\"PlayerGui\")\n\n-- Crear un Frame contenedor (Ajustado el alto a 160 para 3 botones)\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 200, 0, 160) \nframe.AnchorPoint = Vector2.new(1, 1) \nframe.Position = UDim2.new(0.98, 0, 0.98, 0)\nframe.BackgroundColor3 = Color3.fromRGB(45, 45, 45)\nframe.BorderSizePixel = 2\nframe.Parent = gui\n\n-- Función para crear botones\nlocal function createButton(name, text, pos, color, targetPos)\n    local btn = Instance.new(\"TextButton\")\n    btn.Name = name\n    btn.Text = text\n    btn.Size = UDim2.new(0, 180, 0, 40)\n    btn.Position = pos\n    btn.BackgroundColor3 = color\n    btn.TextColor3 = Color3.new(1, 1, 1)\n    btn.Font = Enum.Font.SourceSansBold\n    btn.TextSize = 18\n    btn.Parent = frame\n\n    btn.MouseButton1Click:Connect(function()\n        local character = player.Character\n        if character and character:FindFirstChild(\"HumanoidRootPart\") then\n            -- Se mantiene el offset de +20 de altura para seguridad\n            local offsetPos = targetPos + Vector3.new(0, 20, 0)\n            character.HumanoidRootPart.CFrame = CFrame.new(offsetPos)\n        end\n    end)\nend\n\n--- BOTONES ---\n-- Botón 1: Home\ncreateButton(\"HomeBtn\", \"A casa\", UDim2.new(0, 10, 0, 10), Color3.fromRGB(0, 120, 215), Vector3.new(-67, 19, -517))\n\n-- Botón 2: Silencioso\ncreateButton(\"SilentBtn\", \"Ir silencioso\", UDim2.new(0, 10, 0, 60), Color3.fromRGB(75, 75, 75), Vector3.new(37, 13, 382))\n\n-- NUEVO Botón 3: Zona Secreta (Posicionado en Y=110)\ncreateButton(\"SecretBtn\", \"Zona Secreta (admin abuses?) \", UDim2.new(0, 10, 0, 110), Color3.fromRGB(150, 0, 200), Vector3.new(405, 58, -465))\n\nprint(\"Panel actualizado con Zona Secreta.\")\n","owner":{"_id":"6972bca1ff3b2b4dbcf59202","username":"Facurs73","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f4314d1a182a126dcbf6ac21ca2fab2a2ec9346385a5ada3419e5c92ef1b7674.webp","original":"https://scriptblox.com/images/photo/6972bca1ff3b2b4dbcf59202-1769385101197.png"},"status":"offline","id":"6972bca1ff3b2b4dbcf59202","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/f4314d1a182a126dcbf6ac21ca2fab2a2ec9346385a5ada3419e5c92ef1b7674.webp","original":"https://scriptblox.com/images/photo/6972bca1ff3b2b4dbcf59202-1769385101197.png"}},"verified":false,"views":732,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/0993cf1383367d18e8e2bbf09b1e5c8a6a50b7fe33f19d5f3db3ed9204d4ccf4.webp","original":"https://scriptblox.com/images/sb/96473982750086-1770392940916.png","scriptblox":"https://scriptblox.com/images/script/96473982750086-1770392940916.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-06T15:49:00.935Z","keyLink":"","editBy":{"_id":"6972bca1ff3b2b4dbcf59202","username":"Facurs73","status":"offline","id":"6972bca1ff3b2b4dbcf59202"},"executes":592,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected"