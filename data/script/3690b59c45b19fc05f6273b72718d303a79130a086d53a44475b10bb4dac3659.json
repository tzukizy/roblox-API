{"slug":"Universal-Script-discord-sender-59419","_id":"68f47f792b3ef5e06b439f88","title":"discord sender","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"READ MEEE !!!!!!!!!!!!!!!!!!!!\n\n\n\n\n\n\nso what this script does is that it will use your discord bot in your discord server to say what player is using your script in the game they are in and what script they are using by making the bot say the screengui name\n\nhow to use this: to use this you need to put this script in a screen gui then edit the script and the change the \"local webhookUrl = \"YOUR WEBHOOK URL HERE\" \" to your discord web hook url and then you need to name your screengui so you know what script they are using","tags":[],"script":"local webhookUrl = \"YOUR WEBHOOK URL HERE\"\n\nlocal Players = game:GetService(\"Players\")\nlocal HttpService = game:GetService(\"HttpService\")\nlocal MarketplaceService = game:GetService(\"MarketplaceService\")\n\nlocal player = Players.LocalPlayer\nlocal username = player.Name\nlocal placeId = game.PlaceId\nlocal gameInfo = MarketplaceService:GetProductInfo(placeId, Enum.InfoType.Asset)\nlocal gameName = gameInfo.Name or \"Unknown Game\" \n\nlocal screenGui = script.Parent\nlocal scriptName = \"Unknown Script\"\nif screenGui:IsA(\"ScreenGui\") then\n\tscriptName = screenGui.Name\nend\n\nlocal message = \"@\" .. username .. \" \t\t\t\tis using the script:\t\" .. scriptName .. \" \t\t\t\tin \t\" .. gameName\n\nlocal function sendWebhook()\n\tlocal http = http_request or request or syn.request or http.request or function(data)\n\t\treturn HttpService:PostAsync(data.Url, data.Body, Enum.HttpContentType.ApplicationJson)\n\tend\n\n\tlocal success, err = pcall(function()\n\t\thttp({\n\t\t\tUrl = webhookUrl,\n\t\t\tMethod = \"POST\",\n\t\t\tHeaders = {\n\t\t\t\t[\"Content-Type\"] = \"application/json\"\n\t\t\t},\n\t\t\tBody = HttpService:JSONEncode({\n\t\t\t\tcontent = message\n\t\t\t})\n\t\t})\n\tend)\n\n\tif success then\n\t\tprint(\"Webhook sent automatically for \" .. username .. \" (\" .. scriptName .. \") in \" .. gameName)\n\telse\n\t\twarn(\"Failed to send webhook: \" .. tostring(err))\n\tend\nend\n\nsendWebhook()\n\nprint(\"Script fully executed by \" .. username .. \" (\" .. scriptName .. \") in \" .. gameName)","owner":{"_id":"6874d2d7d0c8ec52cbf76f9a","username":"Astell","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c5610fffce023e2d1cff3d841fd7457d5f45c987d2161ea9c709c65e78a6f6a0.webp","original":"https://scriptblox.com/images/photo/6874d2d7d0c8ec52cbf76f9a-1774689506847.png"},"lvl":10,"status":"offline","id":"6874d2d7d0c8ec52cbf76f9a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/c5610fffce023e2d1cff3d841fd7457d5f45c987d2161ea9c709c65e78a6f6a0.webp","original":"https://scriptblox.com/images/photo/6874d2d7d0c8ec52cbf76f9a-1774689506847.png"}},"verified":false,"views":1008,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/54630694c0c3a6f9f546393f02d323d469794a4d82d1b2144309781c19221cc6.webp","original":"https://scriptblox.com/images/sb/0-1760853881471.png","scriptblox":"https://scriptblox.com/images/script/0-1760853881471.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-10-19T06:04:41.483Z","executes":98,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:52:50.436Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/54630694c0c3a6f9f546393f02d323d469794a4d82d1b2144309781c19221cc6.webp","original":"https://scriptblox.com/images/sb/0-1760853881471.png","scriptblox":"https://