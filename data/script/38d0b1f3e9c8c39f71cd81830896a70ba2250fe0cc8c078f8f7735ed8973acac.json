{"slug":"Find-the-Needle!-Simple-Needle-ESP-(Open-Source)-226468","_id":"6a974282b5d0169cc8b1af6c","title":"Simple Needle ESP (Open-Source)","game":{"_id":"6a974282b5d0169cc8b1af6b","gameId":83238501165241,"name":"🔍 Find the Needle!","imageUrl":"/images/sb/rbx-c2ce40fae4dfdd5edae37d8f3241a467-e73dec92afbc.png","placeId":83238501165241},"features":"Open Source\nNo GUI","tags":["Source","ESP","find the needle","needle ESP","game helper"],"script":"local espEnabled = true\nlocal espObjects = {}\nlocal targetObject = Workspace.Main.Needle\nlocal function createHighlightESP(target)\n    if not target then return end\n    \n    local highlight = Instance.new(\"Highlight\")\n    highlight.Adornee = target\n    highlight.FillColor = Color3.fromRGB(255, 0, 0)\n    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n    highlight.FillTransparency = 0.3\n    highlight.OutlineTransparency = 0\n    highlight.Parent = target\n    \n    espObjects[target] = {highlight = highlight}\nend\n\ncreateHighlightESP(targetObject)","owner":{"_id":"6894c7f74ca0926b17c9270b","username":"SpyDot","verified":false,"profilePicture":"/images/photo/6894c7f74ca0926b17c9270b-1773861302064.jpg","status":"offline","id":"6894c7f74ca0926b17c9270b","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":7869,"executes":42797,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/83238501165241-1788297858587.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-09-01T21:24:18.730Z","keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":39733,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a974282b5d0169cc8b1af6e","editBy":{"_id":"6894c7f74ca0926b17c9270b","username":"SpyDot","status":"offline","id":"6894c7f74ca0926b17c9270b"},"message":"Create script","createdAt":"2026-09-01T21:24:18.733Z"}],"comments":[{"_id":"6a9b272edfc52cb733883774",