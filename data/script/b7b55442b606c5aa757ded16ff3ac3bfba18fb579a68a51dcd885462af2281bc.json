{"slug":"Universal-Script-FE-DROP-ITEM-110919","_id":"698f151572bc47e288d3ad38","title":"FE DROP ITEM","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"This script allow you to drop any item and yes is FE and universal,\n\nWho dislike is GAY 🥀💀 click equip first then drop it is work on classic item\n\nAnd another player can take and use it,\n\nSorry for the Script not work for loadstring  you need to copy here,\n\nEnjoy and have fun...","tags":["Drop item"],"script":"-- Gui to Lua\n-- Version: 3.2 (Rainbow Edition)\n\n-- Instances:\nlocal DropGUI = Instance.new(\"ScreenGui\")\nlocal main = Instance.new(\"Frame\")\nlocal DropTool = Instance.new(\"TextButton\")\nlocal Equip = Instance.new(\"TextButton\")\nlocal Version = Instance.new(\"TextButton\")\nlocal Cred = Instance.new(\"TextButton\")\n\n-- Properties:\n\nDropGUI.Name = \"Drop GUI\"\nDropGUI.Parent = game.CoreGui\nDropGUI.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\nDropGUI.ResetOnSpawn = false\n\nmain.Name = \"main\"\nmain.Parent = DropGUI\nmain.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nmain.Position = UDim2.new(0.0809101239, 0, 0.203790441, 0)\nmain.Size = UDim2.new(0, 150, 0, 128)\nmain.Active = true\nmain.Draggable = true\n\n-- Button setup (all buttons get rainbow effect)\nlocal buttons = {DropTool, Equip, Version, Cred}\n\nDropTool.Name = \"Drop Tool\"\nDropTool.Parent = main\nDropTool.Position = UDim2.new(0.0597826242, 0, 0.119906127, 0)\nDropTool.Size = UDim2.new(0, 55, 0, 50)\nDropTool.Font = Enum.Font.SourceSans\nDropTool.Text = \"Drop\"\nDropTool.TextColor3 = Color3.fromRGB(0, 0, 0)\nDropTool.TextScaled = true\nDropTool.TextSize = 14\nDropTool.TextWrapped = true\nDropTool.MouseButton1Down:Connect(function()\n    local tool = game.Players.LocalPlayer.Character:FindFirstChildOfClass(\"Tool\")\n    if tool then tool.Parent = game.Workspace end\nend)\n\nEquip.Name = \"Equip\"\nEquip.Parent = main\nEquip.Position = UDim2.new(0.55251956, 0, 0.119906083, 0)\nEquip.Size = UDim2.new(0, 58, 0, 50)\nEquip.Font = Enum.Font.SourceSans\nEquip.Text = \"Equip\"\nEquip.TextColor3 = Color3.fromRGB(0, 0, 0)\nEquip.TextScaled = true\nEquip.TextSize = 14\nEquip.TextWrapped = true\nEquip.MouseButton1Down:Connect(function()\n    local tool = game.Players.LocalPlayer.Backpack:FindFirstChildOfClass(\"Tool\")\n    if tool then tool.Parent = game.Players.LocalPlayer.Character end\nend)\n\nVersion.Name = \"Version\"\nVersion.Parent = main\nVersion.Position = UDim2.new(0, 0, 0.999885917, 0)\nVersion.Size = UDim2.new(0, 151, 0, 34)\nVersion.Font = Enum.Font.SourceSans\nVersion.Text = \"Version 1\"\nVersion.TextColor3 = Color3.fromRGB(0, 0, 0)\nVersion.TextScaled = true\nVersion.TextSize = 14\nVersion.TextWrapped = true\n\nCred.Name = \"Cred\"\nCred.Parent = main\nCred.Position = UDim2.new(0, 0, -0.266169071, 0)\nCred.Size = UDim2.new(0, 151, 0, 34)\nCred.Font = Enum.Font.SourceSans\nCred.Text = \"Script by Scripterblabla\"\nCred.TextColor3 = Color3.fromRGB(0, 0, 0)\nCred.TextSize = 14\nCred.TextWrapped = true\n\n-- Rainbow effect\nlocal RunService = game:GetService(\"RunService\")\nlocal hue = 0\n\nRunService.Heartbeat:Connect(function(deltaTime)\n    hue = (hue + deltaTime * 60) % 360  -- speed of color change (60 = nice pace)\n    \n    local color = Color3.fromHSV(hue / 360, 1, 1)  -- full saturation & value = bright rainbow\n    \n    for _, btn in ipairs(buttons) do\n        btn.BackgroundColor3 = color\n    end\nend)","owner":{"_id":"69369d525d930bd43fc1cb5f","username":"Scripterblabla","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/6a9b2a21cf549984c4d308dd5f6908b0b05b0ea170cfd6dba70fcfb4fb888a84.webp","original":"https://scriptblox.com/images/photo/69369d525d930bd43fc1cb5f-1784338560695.png"},"lvl":11,"status":"offline","id":"69369d525d930bd43fc1