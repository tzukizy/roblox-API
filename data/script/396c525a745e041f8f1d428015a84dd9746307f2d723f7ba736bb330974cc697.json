{"slug":"SCP:-Roleplay-OPEN-SOURCE-Report-all-players-20408","_id":"670fb8855e092a4dd1bd4cbd","title":"OPEN SOURCE Report all players","game":{"_id":"67e5e1ffb360710ec3c77d86","gameId":5041144419,"name":"SCP: Roleplay","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":5041144419},"features":"Yeah some mod just straight up banned my 9yo account in SCP:Roleplay, which I have bought lots of gamepass, so here's a little script","tags":["report","scp roleplay","reporter","auto report","scp"],"script":"repeat task.wait() until game:IsLoaded()\n\nif game.PlaceId == 5041144419 then\n    local Players = game:GetService(\"Players\")\n    local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n    local HttpService = game:GetService(\"HttpService\")\n    local TeleportService = game:GetService(\"TeleportService\")\n    \n    local gameId = game.PlaceId\n    local localPlayer = Players.LocalPlayer\n\n    local function serverHop()\n        local serversUrl = \"https://games.roblox.com/v1/games/\" .. gameId .. \"/servers/Public?sortOrder=Asc&limit=100\"\n        local serversData = HttpService:JSONDecode(game:HttpGet(serversUrl))\n\n        for _, server in ipairs(serversData.data) do\n            if server.id ~= game.JobId and server.playing < server.maxPlayers then\n                TeleportService:TeleportToPlaceInstance(gameId, server.id, localPlayer)\n                break\n            end\n        end\n    end\n\n    local screenGui = Instance.new(\"ScreenGui\")\n    local textLabel = Instance.new(\"TextLabel\")\n\n    screenGui.Parent = game:GetService(\"CoreGui\")\n\n    textLabel.Parent = screenGui\n    textLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)\n    textLabel.BackgroundTransparency = 1.000\n    textLabel.BorderColor3 = Color3.fromRGB(0, 0, 0)\n    textLabel.BorderSizePixel = 0\n    textLabel.Position = UDim2.new(0.212657391, 0, 0.0501222499, 0)\n    textLabel.Size = UDim2.new(0, 1074, 0, 50)\n    textLabel.Font = Enum.Font.SourceSans\n    textLabel.Text = \"Last Reported Player: 'None' for 'nothing'\"\n    textLabel.TextColor3 = Color3.fromRGB(255, 105, 105)\n    textLabel.TextScaled = true\n    textLabel.TextSize = 14.000\n    textLabel.TextWrapped = true\n\n    local reportTypes = {\n        {0, \"Harassment\"},\n        {1, \"Announcement Abuse\"},\n        {2, \"Radio Spam\"},\n        {3, \"Breaching\"},\n        {4, \"Exploiting\"}\n    }\n\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= localPlayer then\n            for _, report in ipairs(reportTypes) do\n                local args = {\n                    [1] = report[1],\n                    [2] = player.Name\n                }\n\n                ReplicatedStorage.Remotes.Report:InvokeServer(unpack(args))\n\n                textLabel.Text = \"Last Reported Player: '\" .. player.Name .. \"' for '\" .. report[2] .. \"'.\"\n            end\n        end\n    end\n\n    serverHop()\nelse\n    game:GetService(\"TeleportService\"):Teleport(5041144419)\nend","owner":{"_id":"66e6be89ab8109ee911a81eb","username":"hi_grind","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/66a2e272cd553c21fde05be77143450e9b16b3117c9c6e22e51912f1f09d8316.webp","original":"https://scriptblox.com/images/photo/66e6be89ab8109ee911a81eb-1726398169931.png"},"status":"offline","id":"66e6be89ab8109ee911a81eb","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/66a2e272cd553c21fde05be77143450e9b16b3117c9c6e22e51912f1f09d8316.webp","original":"https://scriptblox.com/images/photo/66e6be89ab8109ee911a81eb-1726398169931.png"}},"verified":false,"keyLink":"","views":18436,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-10-16T12:58:45.841Z","dislikeCount":1,"likeCount":9,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp",