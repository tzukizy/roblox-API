{"slug":"Universal-Script-GFX-Script-5278","_id":"630978919541ae5f4e9ba324","title":"GFX Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/5527722-1661565073753.jpg","placeId":0},"features":"Makes your game look better \n(My Script)","tags":[],"script":"repeat\n        wait()\n    until game.Players.LocalPlayer and game.Players.LocalPlayer.Character and game:IsLoaded()\n\n    local function loadassets()\n        sethiddenproperty(workspace.Terrain, \"Decoration\", true)\n        sethiddenproperty(game.Lighting, \"Technology\", \"ShadowMap\")\n        sethiddenproperty(game.Lighting, \"ShadowSoftness\", .2)\n        sethiddenproperty(game.Lighting, \"Brightness\", 3)\n        sethiddenproperty(game.Lighting, \"ExposureCompensation\", -.9)\n\n        local CC = Instance.new(\"ColorCorrectionEffect\", game.Lighting)\n        local Atmosphere = Instance.new(\"Atmosphere\", game.Lighting)\n        \n        local Bloom = Instance.new(\"BloomEffect\", game.Lighting)\n        local DOP = Instance.new(\"DepthOfFieldEffect\", game.Lighting)\n        local Blur = Instance.new(\"BlurEffect\", game.Lighting)\n        local SunRays = Instance.new(\"SunRaysEffect\", game.Lighting)\n        \n        CC.Saturation = .25\n        \n\n        Atmosphere.Color = Color3.fromRGB(199, 170, 107)\n        Atmosphere.Decay = Color3.fromRGB(92, 60, 13)\n        \n        Bloom.Intensity = .8\n        Bloom.Size = 50\n        Bloom.Threshold = .9\n\n        DOP.FarIntensity = .75\n        DOP.InFocusRadius = 200\n        DOP.NearIntensity = .75\n        \n        Blur.Size = 2\n\n        SunRays.Intensity = .04\n        SunRays.Spread = .4\n        \n        local function refreshparticles()\n            while wait(5) do\n                for i, v in pairs(game:GetDescendants()) do\n                    if v.ClassName == \"ParticleEmitter\" then\n                        v.Brightness = 5\n                    end\n                end\n            end\n        end\n\n        task.spawn(refreshparticles)\n    end\n\n    local Success, Failed = pcall(function()\n        loadassets()\n    end)\n\n    if Failed then \n        task.delay(3, loadassets)\n    end","owner":{"_id":"62fa7806a9946ba07d38c060","username":"Scxtt","verified":false,"profilePicture":"/images/photo/62fa7806a9946ba07d38c060-1661540901058.png","status":"offline","id":"62fa7806a9946ba07d38c060","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":7222,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-08-27T01:51:13.781Z","dislikeCount":3,"likeCount":1,"image":"/images/sb/5527722-1661565073753.jpg","executes":15,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f418","editBy":{"_id":"62fa7806a9946ba07d38c060","username":"Scxtt","status":"offline","id":"62fa7806a9946ba07d38c060"},"message":"Create script","createdAt":"2025-03-27T21:25:29.321Z"}],"comments":[{"_id":"63097b9d6b518281def587be","commentBy":{"_id":"6300a42d6b518281ded30467","username":"Sly3","verified":false,"role":"user","profilePicture":"/images/user-default.png","createdAt":"2022-08-20T09:06:53.320Z","lastActive":"2022-10-18T04:34:07.005Z","status":"offline","id":"6300a42d6b518281ded30467"},"text":"it dont work","createdAt":"2022-08-27T02:04:13.967Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"63097c14774d59be4f7576b5","commentBy":{"_id":"62fa7806a9946ba07d38c060","username":"Scxtt","verified":false,"role":"user","profilePicture":"/images/photo/62fa7806a9946ba07d38c060-1661540901058.png","createdAt":"2022-08-15T16:44:54.749Z","lastActive":"2022-10-18T02:17:28.709Z","status":"offline","id":"62fa7806a9946ba07d38c060","topMilestone":{"key":"creator.scripts","tier":10}},"text":"@Sly3 wym it works for me","createdAt":"2022-08-27T02:06:12.230Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"6