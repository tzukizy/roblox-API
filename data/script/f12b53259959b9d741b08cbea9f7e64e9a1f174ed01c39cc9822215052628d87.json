      \"hip1\", \"hip2\",\n        \"leg1\", \"leg2\"\n    }\n\n    local function getPartList()\n        if targetMode == \"head_only\" then\n            return { \"head\" }\n        end\n        return customParts\n    end\n\n    local function pickAimPart()\n        local best, best_d2 = nil, math.huge\n        local mouse = input:GetMouseLocation()\n        local cam = world.CurrentCamera\n\n        local function consider(p)\n            if not p or not p:IsA(\"BasePart\") then\n                return\n            end\n\n            local v2, ok = cam:WorldToViewportPoint(p.Position)\n            if not ok then\n                return\n            end\n\n            local dx = v2.X - mouse.X\n            local dy = v2.Y - mouse.Y\n            local d2 = dx * dx + dy * dy\n            if d2 <= radius_sq and d2 < best_d2 then\n                best = p\n                best_d2 = d2\n            end\n        end\n\n        local viewmodels = world:FindFirstChild(\"Viewmodels\")\n        if viewmodels then\n            for _, vm in ipairs(viewmodels:GetChildren()) do\n                if vm.Name == \"LocalViewmodel\" then\n                    continue\n                end\n                if vm.Name ~= \"Viewmodel\" then\n                    continue\n                end\n\n                local torso = vm:FindFirstChild(\"torso\")\n                if torso and torso.Transparency == 1 then\n                    continue\n                end\n\n                for _, name in ipairs(getPartList()) do\n                    consider(vm:FindFirstChild(name))\n                end\n            end\n        end\n\n        return best\n    end\n\n    gunClass.get_shoot_look = function(self)\n        local look = oldLook(self)\n        local target = pickAimPart()\n        if not target then\n            return look\n        end\n\n        local origin = look.Position\n        local dir = (target.Position - origin).Unit\n        return CFrame.lookAt(origin, origin + dir)\n    end\n]==])\n","features":"might be detected but yall got it. its open source for a reason, do yall thing and make it UD\n\nworks with (PC/Mobile)\n\n*Silent Aim (u need to aim first for it to work) \n\nno dogshit executor(Xeno,Solara) \n\nlmk if does work just wrote it out of the dome(tested using velocity)","tags":["Operation One","Operation"],"discord":"https://discord.gg/MVYqH6nMjk","keyLink":"","owner":{"_id":"69664a3df79be71fb1046d5c","username":"oieee1","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a6d3eeacc33c6992e428c13bc62de4e91e101e0bddbd1e34f2193d2dfedbd6a1.webp","original":"https://scriptblox.com/images/photo/69664a3df79be71fb1046d5c-1774846119951.jpg"},"lvl":7,"status":"offline","id":"69664a3df79be71fb1046d5c","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/a6d3eeacc33c6992e428c13bc62de4e91e101e0bddbd1e34f2193d2dfedbd6a1.webp","original":"https://scriptblox.com/images/photo/69664a3df79be71fb1046d5c-1774846119951.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:24:31.088Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69cb94c0375b541479191adc","editBy":{"_id":"69664a3df79be71fb1046d5c","username":"oieee1","status":"offline","id":"69664a3df79be71fb1046d5c"},"message":"Create script","createdAt":"2026-03-31T09:32:48.727Z"}],"comments":[{"_id":"69cb95ee35c1508d452addbd","commentBy":{"_id":"69bad73e942b0cf7aa24eb8f","username":"steps","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/5b918c27e16748bf2cde02e41a1600971f055fa14a529062c9036ca5a0d878c5.webp","original":"https://scriptblox.com/images/photo/69bad73e942b0cf7aa24eb8f-1774949856391.jpg"},"lastActive":"2026-03-31T10:26:00.722Z","createdAt":"2026-03-18T16:47:58.159Z","status":"offline","id":"69bad73e942b0cf7aa24