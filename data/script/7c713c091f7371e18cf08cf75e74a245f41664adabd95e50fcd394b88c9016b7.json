{"_id":"682a64a67a7cccf9d376c734","title":"autofarm","game":{"_id":"67e5e1ffb360710ec3c78b60","gameId":4375458071,"name":"Elemental Grind Game","imageUrl":{"url":"https://media.kocakz.me/006e6102ccd50b282bd4378e5e734eaabeeb3191c9ea4dbf74aad4467c90524b.webp","original":"https://tr.rbxcdn.com/180DAY-5873f125a229ea4f86821af54377d330/150/150/Image/Png/noFilter"},"slug":"4375458071-elemental-grind-game","path":"/game/4375458071-elemental-grind-game","thumbnail":{"url":"https://media.kocakz.me/006e6102ccd50b282bd4378e5e734eaabeeb3191c9ea4dbf74aad4467c90524b.webp","original":"https://tr.rbxcdn.com/180DAY-5873f125a229ea4f86821af54377d330/150/150/Image/Png/noFilter"},"placeId":4375458071},"slug":"Elemental-Grind-Game-Elemental-Grind-game-40293","verified":false,"key":false,"keyless":false,"views":4116,"executes":130,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/a7d4e1baaa91bdc4cd7f4d22a22d0c15da1ee89c44e83666f3dc8b06870522df.webp","original":"https://scriptblox.com/images/sb/4375458071-1747608742769.webp","scriptblox":"https://scriptblox.com/images/script/4375458071-1747608742769.webp"},"thumbnail":{"url":"https://media.kocakz.me/a7d4e1baaa91bdc4cd7f4d22a22d0c15da1ee89c44e83666f3dc8b06870522df.webp","original":"https://scriptblox.com/images/sb/4375458071-1747608742769.webp","scriptblox":"https://scriptblox.com/images/script/4375458071-1747608742769.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-05-18T22:52:22.830Z","updatedAt":"2025-05-18T22:52:22.830Z","lastBump":"2025-05-18T22:52:22.830Z","script":"local VirtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal safePosition = CFrame.new(0, 50, 0) -- Adjust to your safe location\n\nlocal moveKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four} -- Moves you want to farm\nlocal player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal root = char:FindFirstChild(\"HumanoidRootPart\")\n\nlocal function autoFarm()\n    while true do\n        for _, key in ipairs(moveKeys) do\n            task.wait(1) -- Adjust farming speed\n\n            -- Simulate key press for ability activation\n            VirtualInputManager:SendKeyEvent(true, key, false, game)\n            task.wait(0.1)\n            VirtualInputManager:SendKeyEvent(false, key, false, game)\n\n            -- Simulate mouse click\n            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)\n            task.wait(0.1)\n            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)\n\n            -- **Teleport Back to Safe Position After Move**\n            if root then\n                root.CFrame = safePosition\n            end\n        end\n    end\nend\n\ntask.spawn(autoFarm)\n","features":"Auto farm Exp","tags":[],"discord":"","keyLink":"","owner":{"_id":"65f5e6720a6da50e22cc7477","username":"Itach1Uch1Ha","verified":false,"profilePicture":{"url":"https://media.kocakz.me/356f59a84053960e0093316296dc33ecb39063a0c3d96ca8587c2135bcb367c2.webp","original":"https://scriptblox.com/images/photo/65f5e6720a6da50e22cc7477-1730677710352.png"},"status":"offline","id":"65f5e6720a6da50e22cc7477","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/356f59a84053960e0093316296dc33ecb39063a0c3d96ca8587c2135bcb367c2.webp","original":"https://scriptblox.com/images/photo/65f5e6720a6da50e22cc7477-1730677710352.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:02:43.125Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"682a64a67a7cccf9d376c736","editBy":{"_id":"65f5e6720a6da50e22cc7477","username":"Itach1Uch1Ha","status":"offline","id":"65f5e6720a6da50e22cc7477"},"message":"Create script","createdA