{"slug":"RELEASE-Dungeon-Raiders-RELEASE-Dungeon-Raiders-Script-V2-Fast-Farm-And-More-Keyless-50966","_id":"68b42e8b8decc0a677cdcdf9","title":"RELEASE Dungeon Raiders Script V4 Fast Farm And More Keyless","game":{"_id":"68a91a66326497772542e264","gameId":93020124129850,"name":"🔥RELEASE ⚔️ Dungeon Raiders","imageUrl":"/images/sb/rbx-08dc8cbeff614bedaf81158db9a2f73d-fc44c4f5be38.png","placeId":93020124129850},"features":"RELEASE Dungeon Raiders V2 updates script more added?? \n\n~~Features New Added~~\n-  Auto Swing/No cd\n-  No Cooldown any Abilities \n-   Auto Retry Play\n-  Auto Increase Health When Damage \n-  Auto Purchase Slots\n- Auto Save Slots (diff num)\n- And More","tags":["RELEASE Dungeon Raiders","RELEASE Dungeon Raiders Script","Dungeons Raiders Script","Dungeons Raiders"],"script":"loadstring(game:HttpGet(\"https://gist.githubusercontent.com/MjContiga1/ae3ff9d408113578484793ba85e87182/raw/07eed1eb36d633a099ad2e7358a3dde6c8e33278/Dungeons%2520v4.lua\"))()\n\nlocal player = game:GetService(\"Players\").LocalPlayer\nlocal retryButton = player.PlayerGui:WaitForChild(\"RetryGui\"):WaitForChild(\"RetryFrame\"):WaitForChild(\"RetryButton\")\nlocal timerLabel = player.PlayerGui:WaitForChild(\"RetryGui\"):WaitForChild(\"RetryFrame\"):WaitForChild(\"TimerLabel\")\nlocal retryEvent = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RetryEvent\")\n\n\nlocal autoRetry = true \n\nlocal previousTime = nil\n\nspawn(function()\n    while autoRetry do\n        local currentText = timerLabel.Text -- e.g., \"10s\"\n        local currentTime = tonumber(currentText:match(\"(%d+)\")) \n\n        if previousTime then\n            if previousTime == 10 and currentTime == 9 then\n                if retryButton.BackgroundColor3 ~= Color3.fromRGB(0, 127, 0) then\n                    retryEvent:FireServer()\n                    retryButton.BackgroundColor3 = Color3.fromRGB(0, 127, 0) \n                end\n            end\n        end\n\n        previousTime = currentTime\n        wait(0.05)\n    end\nend)","owner":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","verified":false,"profilePicture":"/images/photo/68563e11c2bf0525a9fc5a26-1751138311530.jpg","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"verified":false,"views":2101,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/93020124129850-1756638859627.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-08-31T11:14:19.651Z","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"executes":24,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b42e8b8decc0a677cdcdfb","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"message":"Create script","createdAt":"2025-08-31T11:14:19.653Z"},{"_id":"68b4a679091e899fc5e30c8c","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"message":"Update script","createdAt":"2025-08-31T19:46:01.684Z"},{"_id":"68b5282c2141be825817f921","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"message":"Update script","createdAt":"2025-09-01T04:59:24.761Z"},{"_id":"68b5502ba642645be7028d60","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"message":"Update script","createdAt":"2025-09-01T07:50:03.451Z"},{"_id":"68b5caa751e6cdd37e2edd95","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"message":"Update script","createdAt":"2025-09-01T16:32:39.296Z"},{"_id":"68b5d4a4957e82e34679d9b5","editBy":{"_id":"68563e11c2bf0525a9fc5a26","username":"mjcontega","status":"offline","id":"68563e11c2bf0525a9fc5a26"},"message":"Update script","createdAt":"2025-09-01T17:15: