t Info\", colors)\n\n-- Create the main tab\nlocal Tab = Window:NewTab(\"Account Details\")\n\n-- Create a section for the account information\nlocal Section = Tab:NewSection(\"Your Roblox Account\")\n\n-- Add a label for the player's username\nlocal username = game.Players.LocalPlayer.Name\nSection:NewLabel(\"Username: \" .. username)\n\n-- Add a label for the player's account age\nlocal accountAge = game.Players.LocalPlayer.AccountAge\nSection:NewLabel(\"Account Age: \" .. tostring(accountAge) .. \" days old\")\n\n-- Detect the type of executor being used\nlocal executor = nil\nif syn then\n    executor = \"Synapse X\"\nelseif KRNL_LOADED then\n    executor = \"KRNL\"\nelseif ScriptWare then\n    executor = \"Script-Ware\"\nelseif Fluxus then\n    executor = \"Fluxus\"\nelseif Sentinel then\n    executor = \"Sentinel\"\nelseif is_sirhurt_closure then\n    executor = \"Sirhurt\"\nelseif Vega_Loaded then\n    executor = \"Vega X\"\nelse\n    executor = \"Unknown\"\nend\n\n-- Add a label for the executor type\nSection:NewLabel(\"Executor: \" .. executor)\n\n-- Create a new section for additional features\nlocal FeatureSection = Tab:NewSection(\"Additional Features\")\n\n-- Add a button to copy the player's username to the clipboard\nFeatureSection:NewButton(\"Copy Username\", \"Copies your username to the clipboard\", function()\n    setclipboard(username)\n    Library:Notify(\"Username copied to clipboard!\")\nend)\n\n-- Add a button to copy the player's account age to the clipboard\nFeatureSection:NewButton(\"Copy Account Age\", \"Copies your account age to the clipboard\", function()\n    setclipboard(tostring(accountAge))\n    Library:Notify(\"Account age copied to clipboard!\")\nend)\n\n-- Add a button to copy the executor type to the clipboard\nFeatureSection:NewButton(\"Copy Executor\", \"Copies the executor type to the clipboard\", function()\n    setclipboard(executor)\n    Library:Notify(\"Executor type copied to clipboard!\")\nend)","features":"Sorry for the wrong executor name","tags":[],"discord":"","keyLink":"","owner":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"},"status":"offline","id":"6570eb9b5d75332ca0540983","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:21:46.368Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c36a","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","status":"offline","id":"6570eb9b5d75332ca0540983"},"message":"Create script","createdAt":"2024-05-16T03:18:45.296Z"},{"_id":"67e5e1e3b360710ec3c4c36b","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","status":"offline","id":"6570eb9b5d75332ca0540983"},"message":"Update script","createdAt":"2024-05-16T03:24:37.359Z"},{"_id":"67e5e1e3b360710ec3c4c36c","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","status":"offline","id":"6570eb9b5d75332ca0540983"},"message":"Update script","createdAt":"2024-05-16T03:27:48.768Z"},{"_id":"67e5e1e3b360710ec3c4c36d","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","status":"offline","id":"6570eb9b5d75332ca0540983"},"message":"Update script","createdAt":"2024-05-16T03:40:06.050Z"},{"_id":"67e5e1e5b360710ec3c50d19","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibe