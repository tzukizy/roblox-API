{"slug":"Phenom-NBA-2547","_id":"627ac86d739b32dd21571072","title":"NBA","game":{"_id":"67e5e1ffb360710ec3c78740","gameId":623694595,"name":"Phenom","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":623694595},"features":"AUTO DEFEND","tags":[],"script":"_G.brah = false\n_G.keybind = \"z\"\ngame.Players.LocalPlayer:GetMouse().KeyDown:connect(\nfunction(key)\nif key:lower() == _G.keybind and _G.brah == false then\n_G.brah = true\nfor i, v in pairs(game.Players:GetPlayers()) do\nif v.Name ~= game.Players.LocalPlayer.Character.Name and (v.Character.Torso.CFrame.p - game.Players.LocalPlayer.Character.Torso.CFrame.p).Magnitude < 20 and v.Character.Basketball then\nwhile _G.brah == true do\nif v.Character.Torso.Velocity.magnitude > 0.2 then\ngame.Players.LocalPlayer.Character.Humanoid:MoveTo(v.Character.Torso.CFrame.p + v.Character.Torso.Velocity.unit * 7)\nelse\ngame.Players.LocalPlayer.Character.Humanoid:MoveTo(v.Character.Torso.CFrame.p)\nend\nwait()\nend\nend\nend\nelseif key:lower() == _G.keybind and _G.brah == true then\n_G.brah = false\nend\nend)","owner":{"_id":"6277ab3228196775a0106be1","username":"pull","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6277ab3228196775a0106be1-1708340673263.jpg"},"status":"offline","id":"6277ab3228196775a0106be1","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6277ab3228196775a0106be1-1708340673263.jpg"}},"verified":false,"views":10921,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-05-10T20:17:49.946Z","dislikeCount":2,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/fc9ed3594976f9333a223e222e5796ed/500/28