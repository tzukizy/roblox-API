ayer = Players.LocalPlayer\n\nlocal Events = RepStorage.Events\nlocal RemoteFunctions = Events.RemoteFunction\n\nlocal SecretFunCodes = RemoteFunctions.SecretFunCodes\n\nlocal PlayerGui = LocalPlayer.PlayerGui\n\nlocal Count = 0\n\nlocal LastPrint = tick()\n\ngetgenv().yes = PlayerGui.ChildAdded:Connect(function(Object)\n\tif Object.Name == \"AFKMode\" then\n\t\tObject.Enabled = false\n\t\tObject:WaitForChild(\"AFKScript\").Enabled = false\n\t\tRunService.RenderStepped:Wait()\n\t\tObject:Destroy()\n\t\tCount = Count + 1\n\t\tif tick() - LastPrint >= 0.5 then\n\t\t\tLastPrint = tick()\n\t\t\tprint(\"Got new afk gui, count: \" .. tostring(Count))\n\t\tend\n\tend\nend)\n\nfor i = 1, Amount do\n\ttask.spawn(function()\n\t\tSecretFunCodes:InvokeServer(\"afk\")\n\tend)\n\ttask.wait()\nend","features":"Execute it and wait around 20 minutes, do not start any battles just afk and your gonna see your bricks rise automatically.","tags":["TBB"],"discord":"","keyLink":"","owner":{"_id":"6a2c49fdb31fa12b8509634d","username":"ujswastedurtime","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a2c49fdb31fa12b8509634d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:32:27.392Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a6c58ee7c3548f562df6aef","editBy":{"_id":"6a2c49fdb31fa12b8509634d","username":"ujswastedurtime","status":"offline","id":"6a2c49fdb31fa12b8509634d"},"message":"Create script","createdAt":"2026-07-31T08:12:30.888Z"}],"comments":[{"_id":"6a98c2a2d344266740c0a84d","commentBy":{"_id":"6a5667b9079671f5ce9a8e0c","username":"Tick1","verified":false,"role":"user","profilePicture":