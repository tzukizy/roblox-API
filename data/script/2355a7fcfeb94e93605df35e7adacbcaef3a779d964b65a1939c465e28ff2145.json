{"slug":"The-first-to-join-the-server-owns-the-server-vulnerabilities-21714","_id":"67291929581b5312742f539e","title":"vulnerabilities","game":{"_id":"67e5e1ffb360710ec3c787ba","gameId":109262366317994,"name":"The first to join the server, owns the server!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":109262366317994},"features":"execute the function or comment them","tags":[],"script":"-- game name is first to join get admin (with the dog avatar) https://www.roblox.com/fr/games/109262366317994/The-first-to-join-the-server-owns-the-server\n-- https://www.youtube.com/watch?v=ZGiERGtc6A4\nlocal lp = game.Players.LocalPlayer\n\nlocal char = lp.Character \nlocal root = char:FindFirstChild(\"HumanoidRootPart\")\n\nlocal function ShowPanel()\nlp.PlayerGui.AnnouncementMenu.Frame.Visible = true\nend\n\nlocal function killall()\ngame:GetService(\"Players\").LocalPlayer.PlayerGui.AdminButtons.main.remotes.touchey:FireServer(true)\nfor i,v in pairs(game.Players:GetPlayers()) do \n    if v~= lp then\n        local PROOT = v.Character:FindFirstChild(\"HumanoidRootPart\")\n        if PROOT then\n          root.CFrame = PROOT.CFrame\n          wait(0) -- change\n        end\n    end\nend\nend\n\nShowPanel()\nkillall() -- reset admin panel when u die","owner":{"_id":"671e1eb515909d3457e7e6d6","username":"water_hax","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/87632460dcacb45e58f5d75063f7bdf4a59c1375b08ca8a4e1344f38d277b630.webp","original":"https://scriptblox.com/images/photo/671e1eb515909d3457e7e6d6-1730027301478.png"},"status":"offline","id":"671e1eb515909d3457e7e6d6","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/87632460dcacb45e58f5d75063f7bdf4a59c1375b08ca8a4e1344f38d277b630.webp","original":"https://scriptblox.com/images/photo/671e1eb515909d3457e7e6d6-1730027301478.png"}},"verif