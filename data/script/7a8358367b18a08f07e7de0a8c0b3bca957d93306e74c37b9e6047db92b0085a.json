{"slug":"I-HATE-BRAINROT-simple-gun-mods-by-Raggy-v2-202192","_id":"69e29eca0fca9c3df2baeb67","title":"simple gun mods by Raggy v2","game":{"_id":"69d52a73e52e8dc73f6d50de","gameId":119405710070223,"name":"I HATE BRAINROT","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":119405710070223},"features":"simple gun mode, but with gui\n\nthe original script u can find here https://scriptblox.com/script/I-HATE-BRAINROT-simple-gun-mods-193772\n\nits just update for people who dont understand how to use it","tags":[],"script":"local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()\n\nlocal Window = Rayfield:CreateWindow({\n   Name = \"Gun Modifier\",\n   LoadingTitle = \"Loading...\",\n   LoadingSubtitle = \"by you\",\n   ConfigurationSaving = {\n      Enabled = false,\n   }\n})\n\nlocal Tab = Window:CreateTab(\"Main\", 4483362458)\n\nlocal running = false\n\nlocal function getGunStats()\n    local player = game.Players.LocalPlayer\n    local character = player.Character or player.CharacterAdded:Wait()\n\n    local tool = character:FindFirstChildOfClass(\"Tool\")\n    if not tool then return nil end\n\n    local stats = tool:FindFirstChild(\"CurrentStats\")\n    return stats\nend\n\n-- toggle\nTab:CreateToggle({\n   Name = \"OP Gun\",\n   CurrentValue = false,\n   Callback = function(Value)\n      running = Value\n\n      if running then\n         task.spawn(function()\n            while running do\n               local gunstats = getGunStats()\n\n               if gunstats then\n                  gunstats:SetAttribute(\"magazineSize\", 999999999)\n                  gunstats:SetAttribute(\"rateOfFire\", 10000)\n                  gunstats:SetAttribute(\"rayRadius\", 3)   \n                  gunstats:SetAttribute(\"raysPerShot\", 1)\n                  gunstats:SetAttribute(\"damage\", 999999999)\n                  gunstats:SetAttribute(\"reloadTime\", 0)\n                  gunstats:SetAttribute(\"spread\", 0)\n               end\n\n               task.wait(0.1)\n            end\n         end)\n      end\n   end\n})\n\nRayfield:Notify({\n   Title = \"Loaded\",\n   Content = \"Script successfully loaded\",\n   Duration = 3\n})","owner":{"_id":"676b5d361000e2930b4d3b11","username":"nikitacemeris9","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"676b5d361000e2930b4d3b11","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":5668,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/f89e2b7f77cc2304a92b3395f9913e9ac2c7bd33b7db2f228be6bb3b6af06188.webp","original":"https://scriptblox.com/images/sb/rbx-94542258b976eeaed7f99c48bcb93970-e57fe4f90242.png","scriptblox":"https://scriptblox.com/images/script/rbx-94542258b976eeaed7f99c48bcb93970-e57fe4f90242.png"},"likeCount":0,"dislikeCount":1,"createdAt":"2026-04-17T20:57:46.796Z","editBy":{"_id":"676b5d361000e2930b4d3b11","username":"nikitacemeris9","status":"offline","id":"676b5d361000e2930b4d3b11"},"keyLink":"","executes":1198,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:04:09.326Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/f89e2b7f77cc2304a92b3395f9913e9ac2c7bd33b7db2f228be6bb3b6af06188.webp","original":"https://scriptblox.com/images/sb/rbx-94542258b976eeaed7f99c48bcb93970-e57fe4f90242.png","scriptblox":"https://scriptblox.com/images/script/rbx-94542258b976eeaed7f99c48bcb93970-e57fe4f90242.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69e29eca0fca9c3df2baeb6a","editBy":{"_id":"676b5d361000e2930b4d3b11","username":"nikitacemer