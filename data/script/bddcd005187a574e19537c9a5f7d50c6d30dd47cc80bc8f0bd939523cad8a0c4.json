{"slug":"Brainrot-Seas-Change-stats-76561","_id":"6946e5ff40f162cbcf081756","title":"Change stats [Works on old servers]","game":{"_id":"6946de34afbb1a762c10f6dd","gameId":128351182573701,"name":"Brainrot Seas","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":128351182573701},"features":"Change your stats to desired values\nMake sure to not set value to math.huge as it breaks the stat","tags":[],"script":"local Desired_Values = 999999 -- Amount\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.UI.UIRemoteEvent\n    \nlocal ObtainInfPoints = function()\n    Event:FireServer(\n        (function(bytes)\n            local b = buffer.create(#bytes)\n            for i = 1, #bytes do\n                buffer.writeu8(b, i - 1, bytes[i])\n            end\n            return b\n        end)({ 82, 69, 81, 85, 69, 83, 84, 95, 65, 80, 80, 76, 89, 95, 83, 84, 65, 84, 80, 79, 73, 78, 84 }),\n        \"Blade\",\n        -math.huge\n    )\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"StatRefundService\"):WaitForChild(\"FreeRefund\"):FireServer()\nend\nlocal AddPoints = function(Stat,Amount)\n    Event:FireServer(\n        (function(bytes)\n            local b = buffer.create(#bytes)\n            for i = 1, #bytes do\n                buffer.writeu8(b, i - 1, bytes[i])\n            end\n            return b\n        end)({ 82, 69, 81, 85, 69, 83, 84, 95, 65, 80, 80, 76, 89, 95, 83, 84, 65, 84, 80, 79, 73, 78, 84 }),\n        Stat,\n        Amount\n    )\nend\n\nObtainInfPoints()\nAddPoints(\"Strength\",Desired_Values)\nAddPoints(\"Ability\",Desired_Values)\nAddPoints(\"Health\",Desired_Values)\nAddPoints(\"Stamina\",Desired_Values)\nAddPoints(\"Blade\",Desired_Values)","owner":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/1afd482b22ce78f80ccf2