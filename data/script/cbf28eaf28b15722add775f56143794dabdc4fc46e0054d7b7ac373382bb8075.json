{"slug":"Universal-Script-first-person-camera-IN-TEST-44835","_id":"68739856d0c8ec52cbc5368c","title":"camera follow head IN TEST","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"im gonna test it to make sure it work","tags":[],"script":"-- Camera Lock to Head Movement\n-- Put this in a LocalScript (StarterPlayerScripts)\n\nlocal player = game.Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\nlocal runService = game:GetService(\"RunService\")\n\nlocal function updateCamera()\n    local character = player.Character\n    if not character or not character:FindFirstChild(\"Head\") then return end\n\n    local head = character.Head\n\n    -- Position camera at the head + slight offset\n    camera.CFrame = CFrame.new(head.Position) * CFrame.Angles(head.Rotation.X, head.Rotation.Y, head.Rotation.Z)\nend\n\n-- Update every frame\nrunService.RenderStepped:Connect(updateCamera)","owner":{"_id":"67051004b8a7c53167de463e","username":"TWgamble","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/4e989728ee7d1413b073b041eb21ad8d18f7460259b7abe6c6b71737ac1578c4.webp","original":"https://scriptblox.com/images/photo/67051004b8a7c53167de463e-1746362454752.png"},"status":"offline","id":"67051004b8a7c53167de463e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/4e989728ee7d1413b073b041eb21ad8d18f7460259b7abe6c6b71737ac1578c4.webp","original":"https://scriptblox.com/images/photo/67051004b8a7c53167de463e-1746362454752.png"}},"verified":false,"views":2066,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6b5d78df2d823c7338980a1819e4579388afb0269240f01730797b253f6fa2d1.webp","original":"https://scriptblox.com/images/sb/0-17