{"slug":"Universal-Script-first-person-camera-IN-TEST-44835","_id":"68739856d0c8ec52cbc5368c","title":"camera follow head IN TEST","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1752406102342.png","placeId":0},"features":"im gonna test it to make sure it work","tags":[],"script":"-- Camera Lock to Head Movement\n-- Put this in a LocalScript (StarterPlayerScripts)\n\nlocal player = game.Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\nlocal runService = game:GetService(\"RunService\")\n\nlocal function updateCamera()\n    local character = player.Character\n    if not character or not character:FindFirstChild(\"Head\") then return end\n\n    local head = character.Head\n\n    -- Position camera at the head + slight offset\n    camera.CFrame = CFrame.new(head.Position) * CFrame.Angles(head.Rotation.X, head.Rotation.Y, head.Rotation.Z)\nend\n\n-- Update every frame\nrunService.RenderStepped:Connect(updateCamera)","owner":{"_id":"67051004b8a7c53167de463e","username":"TWgamble","verified":false,"profilePicture":"/images/photo/67051004b8a7c53167de463e-1746362454752.png","status":"offline","id":"67051004b8a7c53167de463e","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2056,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1752406102342.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-07-13T11:28:22.428Z","editBy":{"_id":"67051004b8a7c53167de463e","username":"TWgamble","status":"offline","id":"67051004b8a7c53167de463e"},"executes":77,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68739856d0c8ec52cbc5368e","editBy":{"_id":"67051004b8a7c53167de463e","username":"TWgamble","status":"offline","id":"67051004b8a7c53167de463e"},"message":"Create script","createdAt":"2025-07-13T11:28:22.433Z"},{"_id":"68739ad2995b54f5a48e4399","editBy":{"_id":"67051004b8a7c53167de463e","us