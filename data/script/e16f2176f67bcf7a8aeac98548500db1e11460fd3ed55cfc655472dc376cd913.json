y anyone would need this)","tags":[],"discord":"","keyLink":"","owner":{"_id":"66f5ec60b2bee2a1c4717ba7","username":"truelyanonymous1234","verified":false,"profilePicture":{"url":"https://media.kocakz.me/95fce0feccd3c88d16dba6b3b2db7c86e0a777c539d5c9ba264de9b2113d2743.webp","original":"https://scriptblox.com/images/photo/66f5ec60b2bee2a1c4717ba7-1792328829142.jpeg"},"lvl":10,"status":"offline","id":"66f5ec60b2bee2a1c4717ba7","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/95fce0feccd3c88d16dba6b3b2db7c86e0a777c539d5c9ba264de9b2113d2743.webp","original":"https://scriptblox.com/images/photo/66f5ec60b2bee2a1c4717ba7-1792328829142.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:02:43.403Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53c7d","editBy":{"_id":"66f5ec60b2bee2a1c4717ba7","username":"truelyanonymous1234","status":"offline","id":"66f5ec60b2bee2a1c4717ba7"},"message":"Create script","createdAt":"2025-03-27T20:56:44.667Z"}],"comments":[]}