{"slug":"Easy-Obby-but-you-get-banned-if-you-die!-delete-all-killbricks-49629","_id":"68a8225f202bfdc83050eefe","title":"delete all killbricks","game":{"_id":"68a8225f202bfdc83050eefb","gameId":11466522121,"name":"Easy Obby but you get banned if you die!","imageUrl":"/images/sb/rbx-faba111dfae32d0163481b8293a9e468-2430f3d0492b.png","placeId":11466522121},"features":"Deletes all killbricks so you will never banned again. Made by chatgpt","tags":["obby","Obby","killbricks","idontknowwhatineedtotypeinthis","xd"],"script":"local killFolder = workspace:FindFirstChild(\"KillObjects\")\nif not killFolder then\n    warn(\"Папка KillObjects не найдена в workspace.\")\n    return\nend\n\nfor _, part in ipairs(killFolder:GetChildren()) do\n    if part:IsA(\"BasePart\") then\n        -- Проверяем наличие объекта TouchInterest среди дочерних элементов\n        local hasTouchInterest = false\n        for _, child in ipairs(part:GetChildren()) do\n            if child.Name == \"TouchInterest\" then\n                hasTouchInterest = true\n                break\n            end\n        end\n\n        -- Если есть TouchInterest, удаляем часть\n        if hasTouchInterest then\n            part:Destroy()\n        end\n    end\nend","owner":{"_id":"66acd6feee0491e4f2a69750","username":"glebbuba686","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66acd6feee0491e4f2a69750","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1817,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/11466522121-1755849311573.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-08-22T07:55:11.595Z","executes":17,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68a8225f202bfdc83050ef00","editBy":{"_id":"66acd6feee0491e4f2a69750","username":"glebbuba686","status":"offline","id":"66acd6feee0491e4f2a69750"},"message":"Create script","createdA