({\n            version = 5,\n            bytecode = crypt.base64.encode(bytecode)\n        })\n    })\n\n    local decoded = httpService:JSONDecode(response.Body)\n    if decoded.status ~= 'ok' then\n        return `decompilation failed: { decoded.status }`\n    end\n\n    return decoded.output\nend\n\ngetgenv().decompile = decompile","features":"- Decompiles scripts\n- Ideally stick in autoexec so it executes on attach\n- !! ONLY WORKS FOR KRAMPUS !! no android/ios/whatever skidsploits allowed","tags":["decompiler","universal","any game","esp","aimbot"],"discord":"","keyLink":"","owner":{"_id":"660aef3a5e44e28871dea791","username":"gamering","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"660aef3a5e44e28871dea791","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:10:01.831Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c1a4","editBy":{"_id":"660aef3a5e44e28871dea791","username":"gamering","status":"offline","id":"660aef3a5e44e28871dea791"},"message":"Create script","createdAt":"2024-04-01T18:02:50.865Z"},{"_id":"67e5e1e5b360710ec3c5083a","editBy":{"_id":"660aef3a5e44e28871dea791","username":"gamering","status":"offline","id":"660aef3a5e44e28871dea791"},"message":"Update script","createdAt":"2025-03-27T23:06:01.909Z"}],"comments":[{"_id":"660b09c0bbb8031d6272a9e0","commentBy":{"_id":"64ca9f2be16cfc5251ebd249","username":"REDz","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/3f0d834cce2f911e2ad9deffb8c239a6c352b419c648f82ca8ba73a18ed203fa.webp","original":"https://scriptblox.com/images/photo/64ca9f2be16cfc5251ebd249-1782281217235.jpg"},"createdAt":"2023-08-02T18:23:39.374Z","la