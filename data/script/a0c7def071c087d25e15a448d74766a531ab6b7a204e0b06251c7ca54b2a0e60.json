{"_id":"67e52e59dd0c603509be2bee","title":"roblox studio script that makes A math game","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/2ffe2d43db04932b412e7db248fbde01f7c473cdc47a3ecbc61bfcc9635f353c.webp","original":"https://scriptblox.com/images/sb/6178486-1743072857933.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/2ffe2d43db04932b412e7db248fbde01f7c473cdc47a3ecbc61bfcc9635f353c.webp","original":"https://scriptblox.com/images/sb/6178486-1743072857933.png"},"placeId":0},"slug":"Universal-Script-roblox-studio-script-that-makes-A-math-game-33427","verified":false,"key":false,"keyless":false,"views":5111,"executes":45,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d79c06eaf1022fb0ce6ac5490a4b80780e2c8b519db4b8c27d09d8098b99bdda.webp","original":"https://scriptblox.com/images/sb/6178486-1743072857933.png","scriptblox":"https://scriptblox.com/images/script/6178486-1743072857933.png"},"thumbnail":{"url":"https://media.kocakz.me/d79c06eaf1022fb0ce6ac5490a4b80780e2c8b519db4b8c27d09d8098b99bdda.webp","original":"https://scriptblox.com/images/sb/6178486-1743072857933.png","scriptblox":"https://scriptblox.com/images/script/6178486-1743072857933.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-03-27T10:54:17.981Z","updatedAt":"2025-03-27T10:54:17.981Z","lastBump":"2025-03-27T10:54:17.981Z","script":"\n\nlocal Players = game:GetService(\"Players\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal minPlayers = 10\nlocal maxPlayers = 10\nlocal gameStarted = false\n\nlocal equations = {\n    {question = \"1+1\", answer = 2, difficulty = \"Easy\"},\n    {question = \"900/1\", answer = 900, difficulty = \"Impossible\"},\n    {question = \"9+9\", answer = 18, difficulty = \"Hard\"},\n    {question = \"3+1\", answer = 4, difficulty = \"Easy\"},\n    {question = \"(1000*2)+500\", answer = 2500, difficulty = \"Professional\"},\n}\n\nlocal function assignSeats()\n    local players = Players:GetPlayers()\n    if #players >= minPlayers then\n        gameStarted = true\n        for i, player in ipairs(players) do\n            local seat = workspace.Seats:FindFirstChild(\"Seat\" .. i)\n            if seat then\n                player.Character:SetPrimaryPartCFrame(seat.CFrame)\n            end\n        end\n    end\nend\n\nlocal function showEquation(player, equation)\n    local gui = ServerStorage.QuestionGui:Clone()\n    gui.Question.Text = equation.question\n    gui.Parent = player.PlayerGui\nend\n\nlocal function checkAnswer(player, input, equation)\n    if tonumber(input) == equation.answer then\n        player.leaderstats.Winstreak.Value = player.leaderstats.Winstreak.Value + 1\n        game:GetService(\"SoundService\"):PlayLocalSound(workspace.WinSound) -- Play win sound\n    else\n        game:GetService(\"SoundService\"):PlayLocalSound(workspace.KillSound) -- Play kill sound\n        player:Kick(\"Wrong answer!\")\n    end\nend\n\nlocal function startGame()\n    if gameStarted then return end\n    assignSeats()\n    local players = Players:GetPlayers()\n    for _, player in ipairs(players) do\n        local randomEquation = equations[math.random(1, #equations)]\n        showEquation(player, randomEquation)\n    end\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n    if #Players:GetPlayers() >= minPlayers then\n        startGame()\n    end\nend)\n\n-- Teacher Buttons for Correct/Wrong\nlocal function teacherButtons()\n    local teacher = workspace.Teacher -- Assuming there's a teacher model\n    local correctButton = Instance.new(\"TextButton\")\n    correctButton.Text = \"✔ Correct\"\n    correctButton.Parent = teacher\n    \n    local wrongButton = Instance.new(\"TextButton\")\n    wrongButton.Text = \"✖ Wrong\"\n    wrongButton.Parent = teacher\nend\nteacherButtons()\n","features":"-put this in server script service\n-server script\nBY CHATGPT","tags":[],"discord":"","keyLink":"","owner":{"_id":"67954812d999edbadcd05be3","username":"POOIPOOP","verified":false,"profilePicture":{"url":"https://media.kocakz.me/073c6179f96914db2993d3bc140fe667319aedb02b774c1235c83cefea5520e4.webp","original":"https://scriptblox.com/images/photo/67954812d999edbadcd05be3-1748097053132.png"},"status":"offline","id":"67954812d999edbadcd05be3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/073c6179f96914db2993d3bc140fe667319aedb02b774c1235c83cefea5520e4.webp","original":"https://scriptblox.com/images/photo/67954812d999edbadcd05be3-1748097053132.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:04:04.777Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c56086","editBy":{"_id":"67954812d999edbadcd05be3","username":"POOIPOOP","status":"offline","id":"67954812d999edbadcd05be3"},"message":"Create script","createdAt":"2025-03-27T23:11:20.892Z"}],"comments":[{"_id":"67e52f55355683b49ff7cece","commentBy":{"_id":"67954812d999edbadcd05be3","username":"POOIPOOP","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/073c6179f96914db2993d3bc140fe667319aedb02b774c1235c83cefea5520e4.webp","original":"https://scriptblox.com/images/photo/67954812d999edbadcd05be3-1748097053132.png"},"createdAt":"2025-01-25T20:22:42.924Z","lastActive":"2026-09-29T02:40:52.365Z","status":"offline","id":"67954812d999edbadcd05be3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/073c6179f96914db2993d3bc140fe667319aedb02b774c1235c83cefea5520e4.webp","original":"https://scriptblox.com/images/photo/67954812d999edbadcd05be3-1748097053132.png"}},"text":"good?","createdAt":"2025-03-27T10:58:29.183Z","edite