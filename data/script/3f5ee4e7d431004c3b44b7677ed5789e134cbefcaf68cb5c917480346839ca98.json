{"slug":"CVR-cvr-jump-script-53002","_id":"68c596f01103eb330cc0d45c","title":"jump script","game":{"_id":"68c596f01103eb330cc0d459","gameId":114786545831333,"name":"CVR","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":114786545831333},"features":"jumppower changer","tags":["script","cvr","free","power","volleyball"],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\n\n-- MET\nlocal function onCharacterAdded(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n\n    -- STOP\n    humanoid:GetPropertyChangedSignal(\"JumpPower\"):Connect(function()\n        if humanoid.JumpPower ~= 0 then\n            humanoid.JumpPower = 24.3\n        end\n    end)\n\n    -- STEALING\n    local connection\n    connection = RunService.Heartbeat:Connect(function()\n        if humanoid.Parent then\n            if humanoid.JumpPower ~= 0 and humanoid.JumpPower ~= 24.3 then\n                humanoid.JumpPower = 24.3\n            end\n        else\n            connection:Disconnect()\n        end\n    end)\nend\n\n-- GAMES\nif player.Character then\n    onCharacterAdded(player.Character)\nend\n\nplayer.CharacterAdded:Connect(onCharacterAdded)","owner":{"_id":"666b134bf2de8bb3b7d96985","username":"asdjkasdjk","verified":false,"profilePicture":{"url":"https://media.kocakz.me/085def38d373b06eaa76f2a30adeaeff46150d9adda700953d9d9c2cf4bf8e31.webp","original":"https://scriptblox.com/images/photo/666b134bf2de8bb3b7d96985-1756596896270.jpg"},"status":"offline","id":"666b134bf2de8bb3b7d96985","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/085def38d373b06eaa76f2a30adeaeff46150d9adda700953d9d9c2cf4bf8e31.webp","original":"https://scriptblox.com/images/photo/666b134bf2de8bb3b7d96985-1756596896270.jpg"}},"verified":false,"views":9158,"sc