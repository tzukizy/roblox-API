{"slug":"CVR-cvr-jump-script-53002","_id":"68c596f01103eb330cc0d45c","title":"jump script","game":{"_id":"68c596f01103eb330cc0d459","gameId":114786545831333,"name":"CVR","imageUrl":"/images/sb/rbx-17b6352efced30db6b72bd412a85b830-251bb288a7e6.png","placeId":114786545831333},"features":"jumppower changer","tags":["script","cvr","free","power","volleyball"],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\n\n-- MET\nlocal function onCharacterAdded(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n\n    -- STOP\n    humanoid:GetPropertyChangedSignal(\"JumpPower\"):Connect(function()\n        if humanoid.JumpPower ~= 0 then\n            humanoid.JumpPower = 24.3\n        end\n    end)\n\n    -- STEALING\n    local connection\n    connection = RunService.Heartbeat:Connect(function()\n        if humanoid.Parent then\n            if humanoid.JumpPower ~= 0 and humanoid.JumpPower ~= 24.3 then\n                humanoid.JumpPower = 24.3\n            end\n        else\n            connection:Disconnect()\n        end\n    end)\nend\n\n-- GAMES\nif player.Character then\n    onCharacterAdded(player.Character)\nend\n\nplayer.CharacterAdded:Connect(onCharacterAdded)","owner":{"_id":"666b134bf2de8bb3b7d96985","username":"asdjkasdjk","verified":false,"profilePicture":"/images/photo/666b134bf2de8bb3b7d96985-1756596896270.jpg","status":"offline","id":"666b134bf2de8bb3b7d96985","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":9108,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-17b6352efced30db6b72bd412a85b830-251bb288a7e6.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-09-13T16:08:16.777Z","editBy":{"_id":"666b134bf2de8bb3b7d96985","username":"asdjkasdjk","status":"offline","id":"666b134bf2de8bb3b7d96985"},"executes":842,"keyless":false,"liked":false,"disliked":false,"isHub":fal