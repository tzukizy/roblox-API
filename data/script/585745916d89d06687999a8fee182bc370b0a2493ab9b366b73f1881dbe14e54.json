layer()\n            wait(1)  -- Teleport interval (1 second)\n        end\n    end\n})\n\n-- Add a button for manual teleport\nTab:AddButton({\n    Name = \"Teleport\",\n    Callback = function()\n        teleportPlayer()\n    end    \n})\n\n-- Initialize the UI\nOrionLib:Init()","owner":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"},"status":"offline","id":"6570eb9b5d75332ca0540983","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"}},"verified":false,"keyLink":"","views":118569,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-08-16T15:59:39.388Z","dislikeCount":1,"likeCount":3,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/c8768638cd7d1b8aa997d2e46572561e/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/c8768638cd7d1b8aa997d2e46572561e/500/280/Image/Jpeg"},"executes":2,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:19:18.436Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/c8768638cd7d1b8aa997d2e46572561e/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/c8768638cd7d1b8aa997d2e46572561e/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c9fe","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy"