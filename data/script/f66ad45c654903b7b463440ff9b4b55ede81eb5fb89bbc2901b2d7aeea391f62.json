{"slug":"Dead-Rails-Alpha-Simple-map-loader-48574","_id":"689dda3dacfea3fe43292eb8","title":"Simple map loader","game":{"_id":"67e5e1ffb360710ec3c77d11","gameId":116495829188952,"name":"Dead Rails","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":116495829188952},"features":"Just loads the map of 99 nights in the forest\n\n\nNeed level 6 campfire","tags":["nights in the forest"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal center = Vector3.new(0, 100, 0)\nlocal radius = 1300\nlocal step = 20\nlocal delayTime = 0.01\n\n\nfor x = -radius, radius, step do\n    for z = -radius, radius, step do\n        -- Check if (x, z) lies within the circle\n        if x^2 + z^2 <= radius^2 then\n            local targetPos = Vector3.new(center.X + x, center.Y, center.Z + z)\n            hrp.CFrame = CFrame.new(targetPos)\n            task.wait(delayTime)\n        end\n    end\nend\n\nhrp.CFrame = CFrame.new(center)","owner":{"_id":"685f9df5c09d53c1e5743744","username":"Making","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2af366bebaa3b44e643ac2987127cb5b83691983ed830b4d4521831c07827bda.webp","original":"https://scriptblox.com/images/photo/685f9df5c09d53c1e5743744-1751097096257.jpg"},"status":"offline","id":"685f9df5c09d53c1e5743744","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/2af366bebaa3b44e643ac2987127cb5b83691983ed830b4d4521831c07827bda.webp","original":"https://scriptblox.com/images/photo/685f9df5c09d53c1e5743744-1751097096257.jpg"}},"verified":false,"views":2405,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/ea256b4d0dd68618170b9161020b44b61adcf456f060a1c408ca550f4068fd8f.webp","original":"http