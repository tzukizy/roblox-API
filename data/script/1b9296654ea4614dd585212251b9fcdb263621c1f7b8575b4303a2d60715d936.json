{"_id":"64cddbb63b9c9d498e8ced55","title":"Esp mm2","game":{"_id":"67e5e1ffb360710ec3c77d5a","gameId":142823291,"name":"Murder Mystery 2","imageUrl":{"url":"https://media.kocakz.me/ee97389b1d75a123928656ce42e80e4470147cb12af60d30b2601829f029c788.webp","original":"https://tr.rbxcdn.com/180DAY-ab1484ff8063476d413da09dd25df93f/150/150/Image/Png/noFilter"},"slug":"142823291-murder-mystery-2","path":"/game/142823291-murder-mystery-2","thumbnail":{"url":"https://media.kocakz.me/ee97389b1d75a123928656ce42e80e4470147cb12af60d30b2601829f029c788.webp","original":"https://tr.rbxcdn.com/180DAY-ab1484ff8063476d413da09dd25df93f/150/150/Image/Png/noFilter"},"placeId":142823291},"slug":"Murder-Mystery-2-Ken-Esp-mm-Sheriff-and-er-6681","verified":false,"key":false,"keyless":false,"views":119955,"executes":605,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"unlisted","indexUnlisted":true,"image":{"url":"https://media.kocakz.me/b2ae32ddebee3a6b5db22dffde57761d1896106cb00eae5c443970cebcd88ba1.webp","original":"https://scriptblox.com/images/sb/142823291-1691212726448.webp","scriptblox":"https://scriptblox.com/images/script/142823291-1691212726448.webp"},"thumbnail":{"url":"https://media.kocakz.me/b2ae32ddebee3a6b5db22dffde57761d1896106cb00eae5c443970cebcd88ba1.webp","original":"https://scriptblox.com/images/sb/142823291-1691212726448.webp","scriptblox":"https://scriptblox.com/images/script/142823291-1691212726448.webp"},"likeCount":2,"dislikeCount":0,"createdAt":"2023-08-05T05:18:46.474Z","updatedAt":"2023-08-05T05:18:46.474Z","lastBump":"2023-08-05T05:18:46.474Z","script":"\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal localPlayer = Players.LocalPlayer\n\n\nlocal function getPlayerRole(player)\n\tif player == localPlayer then return nil end\n\n\tlocal character = player.Character\n\tlocal backpack = player:FindFirstChildOfClass(\"Backpack\")\n\tif not character or not backpack then return \"Inocente\" end\n\n\tlocal function checkTool(tool)\n\t\tlocal name = tool.Name:lower()\n\t\tif name:find(\"gun\") or name:find(\"revolver\") then\n\t\t\treturn \"Sheriff\"\n\t\telseif name:find(\"knife\") or name:find(\"blade\") then\n\t\t\treturn \"Murder\"\n\t\tend\n\t\treturn nil\n\tend\n\n\n\tlocal tool = character:FindFirstChildOfClass(\"Tool\")\n\tif tool then\n\t\tlocal role = checkTool(tool)\n\t\tif role then return role end\n\tend\n\n\tfor _, item in pairs(backpack:GetChildren()) do\n\t\tif item:IsA(\"Tool\") then\n\t\t\tlocal role = checkTool(item)\n\t\t\tif role then return role end\n\t\tend\n\tend\n\n\treturn \"Inocente\"\nend\n\n\nlocal function getOrCreateHighlight(player)\n\tlocal existing = player.Character:FindFirstChild(\"RoleHighlight\")\n\tif existing then return existing end\n\n\t\n\tlocal highlight = Instance.new(\"Highlight\")\n\thighlight.Name = \"RoleHighlight\"\n\thighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n\thighlight.FillTransparency = 0.45\n\thighlight.OutlineTransparency = 0 \n\thighlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- borda branca visível\n\thighlight.Adornee = player.Character\n\thighlight.Parent = player.Character\n\treturn highlight\nend\n\n\nlocal function updateHighlights()\n\tlocal foundMurder, foundSheriff = false, false\n\tlocal roles = {}\n\n\tfor _, player in pairs(Players:GetPlayers()) do\n\t\tif player ~= localPlayer then\n\t\t\tlocal role = getPlayerRole(player)\n\t\t\troles[player] = role\n\t\t\tif role == \"Murder\" then foundMurder = true end\n\t\t\tif role == \"Sheriff\" then foundSheriff = true end\n\t\tend\n\tend\n\n\tif foundMurder or foundSheriff then\n\t\tfor player, role in pairs(roles) do\n\t\t\tif player.Character then\n\t\t\t\tlocal hl = getOrCreateHighlight(player)\n\t\t\t\tif role == \"Murder\" then\n\t\t\t\t\thl.FillColor = Color3.fromRGB(255, 0, 0)\n\t\t\t\telseif role == \"Sheriff\" then\n\t\t\t\t\thl.FillColor = Color3.fromRGB(0, 0, 255)\n\t\t\t\telse\n\t\t\t\t\thl.FillColor = Color3.fromRGB(0, 255, 0)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\telse\n\n\t\tfor _, player in pairs(Players:GetPlayers()) do\n\t\t\tif player ~= localPlayer and player.Character then\n\t\t\t\tlocal hl = player.Character:FindFirstChild(\"RoleHighlight\")\n\t\t\t\tif hl then hl:Destroy() end\n\t\t\tend\n\t\tend\n\tend\nend\n\n\nRunService.RenderStepped:Connect(updateHighlights)\n\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function()\n\t\twait(1)\n\t\tupdateHighlights()\n\tend)\nend)\n","features":"mm2  esp /all credit to the creator (**)","tags":[],"discord":"","keyLink":"","owner":{"_id":"64cd743296384140753c9eff","username":"ScriptNoKeys","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f845dbeca8132f860353dbfc59a6068a9626471e1df9e19a01f0c872cafa4f63.webp","original":"https://scriptblox.com/images/photo/64cd743296384140753c9eff-1696279486573.jpg"},"status":"offline","id":"64cd743296384140753c9eff","topMilestone":{"key":"creator.executions","tier":1000000},"profile":{"url":"https://media.kocakz.me/f845dbeca8132f860353dbfc59a6068a9626471e1df9e19a01f0c872cafa4f63.webp","original":"https://scriptblox.com/images/photo/64cd743296384140753c9eff-1696279486573.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T03:03:27.006Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bada","editBy":{"_id":"64cd743296384140753c9eff","username":"ScriptNoKeys","status":"offline","id":"64cd743296384140753c9eff"},"message":"Create script","createdAt":"2023-09-18T02:03:07.337Z"},{"_id":"67e5e1e2b360710ec3c4badb","editBy":{"_id":"64cd743296384140753c9eff","username":"ScriptNoKeys","status":"offline","id":"64cd743296384140753c9eff"},"message":"Update script","createdAt":"2024-04-10T15:53:53.703Z"},{"_id":"67e5e1e2b360710ec3c4badc","editBy":{"_