{"slug":"Universal-Script-REDzHUB-Ui-Library-12740","_id":"663205f3257f0aeb50b7273b","title":"REDzHUB Ui Library","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/6826676-1714554355385.webp","placeId":0},"features":"Redz Ui Library!","tags":[],"script":"--[[\nCredits goes to REDz.\nAnd you can find more here! [This is v5 version]\nhttps://github.com/REDzHUB/RedzLibV5\nAnd maybe some things may not work correctly (doesn't to me)\n]]--\n\nlocal redzlib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/REDzHUB/RedzLibV5/main/Source.Lua\"))()\n\nlocal Window = redzlib:MakeWindow({\n  Title = \"Test\",\n  SubTitle = \"hello\",\n  SaveFolder = \"Redz Config\"\n})\n\n--Tabs\n\nlocal Tab1 = Window:MakeTab({\"Tab 1\", \"cool\"})\n\n--Buttons\n\nTab1:AddButton({\"Print\", function()\nprint(\"Hello World!\")\nend})\n\nlocal Toggle1 = Tab1:AddToggle({\n  Name = \"Speed\",\n  Description = \"Idk\",\n  Default = false\n})\n\nTab1:AddSlider({\n  Name = \"Speed\",\n  Min = 1,\n  Max = 100,\n  Increase = 1,\n  Default = 16,\n  Callback = function(Value)\n  game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value\n  end\n})","owner":{"_id":"65c8f3c9cd3cb06a4250c7b7","username":"Zephyr","verified":false,"profilePicture":"/images/photo/65c8f3c9cd3cb06a4250c7b7-1753303450364.jpeg","status":"offline","id":"65c8f3c9cd3cb06a4250c7b7","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"keyLink":"","views":480159,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-05-01T09:05:55.421Z","dislikeCount":0,"likeCount":4,"image":"/images/sb/6826676-1714554355385.webp","executes":131,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50baf","editBy":{"_id":"65c8f3c9cd3cb06a4250c7b7","username":"Zephyr","status":"offline","id":"65c8f3c9cd3cb06a4250c7b7"},"message":"Create script","createdAt":"2025-0