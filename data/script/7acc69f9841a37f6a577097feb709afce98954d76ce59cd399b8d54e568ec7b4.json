{"slug":"SCP-Games-and-SCP-Monsters-OPEN-SOURCE-FE-Kill-All-and-God-Mode-75834","_id":"6943a96263d9054d72c8be92","title":"OPEN SOURCE FE Kill All and God Mode","game":{"_id":"67e5e1ffb360710ec3c783c6","gameId":7253149844,"name":"SCP Games and SCP Monsters","imageUrl":"/images/sb/rbx-74a371e5dd2599c8285d2b10dd61e2ae-1a0e0eb3771f.png","placeId":7253149844},"features":"Loop Kill All + God mode yourself","tags":["KIll All","God Mode","Fe","Open Source"],"script":"-- @build-failed\n-- Kill All + God Mode\n\nlocal getservice, waitforchild, findfirstchildofclass, findfirstchild = game.GetService, game.WaitForChild, game.FindFirstChildOfClass, game.FindFirstChild\n\nlocal players = getservice(game, \"Players\")\nlocal localplayer = players.LocalPlayer\nlocal localcharacter = localplayer.Character\n\nlocal backpack = waitforchild(localplayer, \"Backpack\")\n\nlocal uniform = waitforchild(workspace, \"Uniform\")\nlocal uniformgiver = nil\n\n-- get uniform giver\nfor _, obj in uniform:GetChildren() do\n    if not obj then continue end\n    if obj.Name ~= \"Uniform Giver\" then continue end\n\n    local coathanger = findfirstchild(obj, \"Coathanger\")\n    if not coathanger then continue end\n\n    local shirt = findfirstchildofclass(coathanger, \"Shirt\")\n    if not shirt then continue end\n    if shirt.ShirtTemplate ~= \"http://www.roblox.com/asset/?id=316069182\" then continue end\n\n    uniformgiver = obj\nend\n\nlocal clickpart = waitforchild(uniformgiver, \"ClickPart\")\nlocal prompt = waitforchild(clickpart, \"ProximityPrompt\")\n\nlocal function triggerProximityPrompt()\n    prompt:InputHoldBegin()\n    task.wait()\n    prompt:InputHoldEnd()\nend\n\nlocal humanoidrootpart = waitforchild(localcharacter, \"HumanoidRootPart\")\nhumanoidrootpart.CFrame = clickpart.CFrame\ntask.wait(0.1)\ntriggerProximityPrompt(prompt)\n\n\nwhile task.wait(0.1) do\n    for _, player in players:GetPlayers() do\n        local tool = findfirstchildofclass(localcharacter, \"Tool\") or findfirstchildofclass(backpack, \"Tool\")\n        if not tool then continue end\n        local remoteEvent = findfirstchildofclass(tool, \"RemoteEvent\")\n        if not remoteEvent then continue end\n        if not remoteEvent.Name ~= \"Receiver\" then continue end\n        tool.Parent = localcharacter\n\n        if not player then continue end\n\n        local character = player.Character\n        if not character then continue end\n\n        local humanoid = findfirstchildofclass(character, \"Humanoid\")\n        if not humanoid then continue end\n\n        if player == localplayer then\n            remoteEvent:FireServer(\"Damage\", humanoid, 0/0)\n        else\n            remoteEvent:FireServer(\"Damage\", humanoid, humanoid.MaxHealth)\n        end\n    end\nend","owner":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","verified":false,"profilePicture":"/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png","status":"offline","id":"69295f649aebc6b6d35f1e1f","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"discord":"https://discord.com/invite/mjRvvRjt6B","views":3302,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-cdbbed6d35bf6af101d7ed59fe1dd502-cd3cef1bcf8d.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-12-18T07:12:34.208Z","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"keyLink":"","executes":1767,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6943a96263d9054d72c8be94","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"message":"Create script","createdAt":"2025-12-18T07:12:34.210Z"},{"_id":"6944ebb0993d764372c78cfe","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"message":"Update script","createdAt":"