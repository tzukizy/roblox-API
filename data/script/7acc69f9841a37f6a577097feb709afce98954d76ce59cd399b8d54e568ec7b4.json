{"_id":"6943a96263d9054d72c8be92","title":"OPEN SOURCE FE Kill All and God Mode","game":{"_id":"67e5e1ffb360710ec3c783c6","gameId":7253149844,"name":"SCP Games and SCP Monsters","imageUrl":{"url":"https://media.kocakz.me/f559d69d3191bf7c867a0e0e4faf5af10049abb260a267c68bdba6e38adb6b00.webp","original":"https://tr.rbxcdn.com/180DAY-e81f05230cf1e4cadea532083c5b8c05/150/150/Image/Png/noFilter"},"slug":"7253149844-scp-games-and-scp-monsters","path":"/game/7253149844-scp-games-and-scp-monsters","thumbnail":{"url":"https://media.kocakz.me/f559d69d3191bf7c867a0e0e4faf5af10049abb260a267c68bdba6e38adb6b00.webp","original":"https://tr.rbxcdn.com/180DAY-e81f05230cf1e4cadea532083c5b8c05/150/150/Image/Png/noFilter"},"placeId":7253149844},"slug":"SCP-Games-and-SCP-Monsters-OPEN-SOURCE-FE-Kill-All-and-God-Mode-75834","verified":false,"key":false,"keyless":false,"views":3414,"executes":2193,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/11cb1066feb3a797c7b13ed7cd0130725685363b7398e70c2ec364225a61c486.webp","original":"https://scriptblox.com/images/sb/rbx-cdbbed6d35bf6af101d7ed59fe1dd502-cd3cef1bcf8d.png","scriptblox":"https://scriptblox.com/images/script/rbx-cdbbed6d35bf6af101d7ed59fe1dd502-cd3cef1bcf8d.png"},"thumbnail":{"url":"https://media.kocakz.me/11cb1066feb3a797c7b13ed7cd0130725685363b7398e70c2ec364225a61c486.webp","original":"https://scriptblox.com/images/sb/rbx-cdbbed6d35bf6af101d7ed59fe1dd502-cd3cef1bcf8d.png","scriptblox":"https://scriptblox.com/images/script/rbx-cdbbed6d35bf6af101d7ed59fe1dd502-cd3cef1bcf8d.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-12-18T07:12:34.208Z","updatedAt":"2025-12-18T07:12:34.208Z","lastBump":"2025-12-18T07:12:34.208Z","script":"-- @build-failed\n-- Kill All + God Mode\n\nlocal getservice, waitforchild, findfirstchildofclass, findfirstchild = game.GetService, game.WaitForChild, game.FindFirstChildOfClass, game.FindFirstChild\n\nlocal players = getservice(game, \"Players\")\nlocal localplayer = players.LocalPlayer\nlocal localcharacter = localplayer.Character\n\nlocal backpack = waitforchild(localplayer, \"Backpack\")\n\nlocal uniform = waitforchild(workspace, \"Uniform\")\nlocal uniformgiver = nil\n\n-- get uniform giver\nfor _, obj in uniform:GetChildren() do\n    if not obj then continue end\n    if obj.Name ~= \"Uniform Giver\" then continue end\n\n    local coathanger = findfirstchild(obj, \"Coathanger\")\n    if not coathanger then continue end\n\n    local shirt = findfirstchildofclass(coathanger, \"Shirt\")\n    if not shirt then continue end\n    if shirt.ShirtTemplate ~= \"http://www.roblox.com/asset/?id=316069182\" then continue end\n\n    uniformgiver = obj\nend\n\nlocal clickpart = waitforchild(uniformgiver, \"ClickPart\")\nlocal prompt = waitforchild(clickpart, \"ProximityPrompt\")\n\nlocal function triggerProximityPrompt()\n    prompt:InputHoldBegin()\n    task.wait()\n    prompt:InputHoldEnd()\nend\n\nlocal humanoidrootpart = waitforchild(localcharacter, \"HumanoidRootPart\")\nhumanoidrootpart.CFrame = clickpart.CFrame\ntask.wait(0.1)\ntriggerProximityPrompt(prompt)\n\n\nwhile task.wait(0.1) do\n    for _, player in players:GetPlayers() do\n        local tool = findfirstchildofclass(localcharacter, \"Tool\") or findfirstchildofclass(backpack, \"Tool\")\n        if not tool then continue end\n        local remoteEvent = findfirstchildofclass(tool, \"RemoteEvent\")\n        if not remoteEvent then continue end\n        if not remoteEvent.Name ~= \"Receiver\" then continue end\n        tool.Parent = localcharacter\n\n        if not player then continue end\n\n        local character = player.Character\n        if not character then continue end\n\n        local humanoid = findfirstchildofclass(character, \"Humanoid\")\n        if not humanoid then continue end\n\n        if player == localplayer then\n            remoteEvent:FireServer(\"Damage\", humanoid, 0/0)\n        else\n            remoteEvent:FireServer(\"Damage\", humanoid, humanoid.MaxHealth)\n        end\n    end\nend","features":"Loop Kill All + God mode yourself","tags":["KIll All","God Mode","Fe","Open Source"],"discord":"https://discord.com/invite/mjRvvRjt6B","keyLink":"","owner":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","verified":false,"profilePicture":{"url":"https://media.kocakz.me/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"},"lvl":13,"status":"offline","id":"69295f649aebc6b6d35f1e1f","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:00:58.569Z","last":"w","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6943a96263d9054d72c8be94","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"message":"Create script","createdAt":"2025-12-18T07:12:34.210Z"},{"_id":"6944ebb0993d764372c78cfe","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"message":"Update script","createdAt":"2025-12-19T06:07:44.981Z"},{"_id":"6944eca70d904aa5d125b93a","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"message":"Update script","createdAt":"2025-12-19T06:11:51.268Z"},{"_id":"6944ee26591af5a223db410c","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"message":"Update sc