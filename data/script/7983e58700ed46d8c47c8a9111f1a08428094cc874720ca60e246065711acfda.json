on()\nfor i,v in next, p.Character:GetChildren() do\nif v.ClassName == \"Model\" and v:FindFirstChild(\"Handle\") then\nreturn v\nend\nend\nend\n\nwhile wait() do\nfor i,v in pairs(workspace.Enemies:GetChildren()) do\nif v:FindFirstChild(\"HumanoidRootPart\") and v:FindFirstChild(\"Humanoid\") and v.Humanoid.Health > 0 then\nrepeat\nwait()\np.Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame*CFrame.Angles(math.rad(-90),0,0) + Vector3.new(0,-11,0)\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Modules\"):WaitForChild(\"Network\"):WaitForChild(\"RemoteEvent\"):FireServer(\n    \"WeaponDamage\",\n    GetWeapon().Name,\n    v.Humanoid\n)\nuntil v.Humanoid.Health <= 0 \nend\nend\nend","features":"Auto complete dungeon\n\njoin dungeon and execute script","tags":[],"discord":"","keyLink":"","owner":{"_id":"65bda39f94bada8a7e39ce59","username":"filthydsr","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"65bda39f94bada8a7e39ce59","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:59:42.429Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c5096f","editBy":{"_id":"65bda39f94bada8a7e39ce59","username":"filthydsr","status":"offline","id":"65bda39f94bada8a7e39ce59"},"message":"Create script","createdAt":"2025-03-27T20:15:31.609Z"}],"comments":[{"_id":"661602cd9ac4c964ea75efb6","commentBy":{"_id":"628a0bef61ec488c4939bc87","username":"demokritoss","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-05-22T10:09:51.532Z","lastActive":"2024-06-06T11:43:22.691Z","status":"offline","id":