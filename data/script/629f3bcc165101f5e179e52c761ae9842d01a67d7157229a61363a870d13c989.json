)\n\nRunService.RenderStepped:Connect(function()\n    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n    if Toggle and Character and Character:FindFirstChild(\"HumanoidRootPart\") then\n        local hrp = Character.HumanoidRootPart\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Pickup\") then\n                local pos\n                if v:IsA(\"Model\") then\n                    pos = v.PrimaryPart and v.PrimaryPart.Position or v:GetPivot().Position\n                elseif v:IsA(\"BasePart\") then\n                    pos = v.Position\n                end\n                if pos and (hrp.Position - pos).Magnitude <= 22.5 then\n                    ReplicatedStorage.Events.Pickup:FireServer(v)\n                end\n            end\n        end\n    end\nend)","features":"Pickup Aura","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:50:30.824Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c0c7d896fcf2ac358009e0","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","c