ce(\"Workspace\").Mobs:GetChildren()) do\nif v:FindFirstChild(\"Zombie\").Health ~= 0 then\nv:FindFirstChild(\"HumanoidRootPart\").Anchored = true\nv:FindFirstChild(\"HumanoidRootPart\").CFrame = CFrame.new(getgenv().FrontPos)\nprint(\"TP'ed\",v.Name,\"at\",getgenv().FrontPos)\nend\nend\nend\nend)","features":"Teleport \"Mobs\" at a certain chosen distance with a set keybind","tags":[],"discord":"","keyLink":"","owner":{"_id":"64e690059e7dd8ee3d5dd5a7","username":"CasualScripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"64e690059e7dd8ee3d5dd5a7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:12:53.478Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f7e9","editBy":{"_id":"64e690059e7dd8ee3d5dd5a7","username":"CasualScripter","status":"offline","id":"64e690059e7dd8ee3d5dd5a7"},"message":"Create script","createdAt":"2025-03-27T20:12:36.246Z"}],"comments":[{"_id":"64e69a8191125e236249a9c5","commentBy":{"_id":"64e690059e7dd8ee3d5dd5a7","username":"CasualScripter","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2023-08-23T23:02:29.316Z","lastActive":"2023-09-07T20:35:19.919Z","status":"offline","id":"64e690059e7dd8ee3d5dd5a7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Idk might think of adding a autofarm","createdAt":"2023-08-23T23:47:13.464Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64f69ff405915d3a783b87ba","commentBy":{"_id":"64e365ffad5a963acd64daa0