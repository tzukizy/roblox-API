{"slug":"2X-The-Cul-De-Sac-RPG-Give-All-Items-224937","_id":"6a8979a53dea8dceb67d5fd2","title":"Give All Items","game":{"_id":"699d528950c4786007bc8ce0","gameId":14414833351,"name":"[2X🍀] The Cul De Sac RPG","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14414833351},"features":"Gives how ever much you want of all items in the game\nchange getgenv().Amount value to however much you want of all items","tags":[],"script":"getgenv().Amount = 1000000\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal EReplication = ReplicatedStorage.ClientToServer.DataEvents.EReplication\nlocal ClaimItem = ReplicatedStorage.LocalReplicated.Items.ClaimItem\n\nlocal Items = require(ReplicatedStorage.Modules.ItemDescriptions).Items\n\nfor i = 1,50 do\n    task.wait()\n    EReplication:FireServer(\"secret\",\"LuckyChest\",vector.create(0,0,0))\nend\n\nClaimItem:FireServer(\"MaterialOrb\")\nClaimItem:FireServer(\"MaterialOrbClaim\",\"MaterialOrb\",10000)\n\nfor i,_ in Items do\n    task.wait()\n    ClaimItem:FireServer(\"MaterialOrb\")\n    ClaimItem:FireServer(\"MaterialOrbClaim\",i,getgenv().Amount)\nend","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"views":260,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"p