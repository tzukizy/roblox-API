orial in discord)\n\nCosmic Hub: Auras (fun version of cosmic hub)\norbit aura\nsparkler noclip\nkeyboard (spell anything from sparklers)\nChristmas tree shape\nwings shape\ngrid pattern shape\n\nUPDATES OFTEN, ACTIVE COMMUNITY\nTHANKS LOVE ALL <3\n- Cosmic\n\nShow less\nShow changelog","tags":["ftap","fling things and people"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Jeffepicy/CosmicHub/refs/heads/main/CosmicHub\",true))()\n\n-- if laggy\ngetgenv().gethui = function() return game.CoreGui end\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/Jeffepicy/CosmicHub/refs/heads/main/CosmicHub\",true))()\n","owner":{"_id":"680e7b0c1366519d3cc08320","username":"Cosmic_TCU","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"680e7b0c1366519d3cc08320","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"discord":"https://discord.gg/mzkKQhyNqv","keyLink":"https://discord.gg/mzkKQhyNqv","views":73040,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/416b31d1d5ce55063f83d8071fc718da72824fda072d36c401fa6a7e7b965086.webp","original":"https://scriptblox.com/images/sb/6961824067-1746568712154.png","scriptblox":"https://scriptblox.com/images/script/6961824067-1746568712154.png"},"likeCount":0,"dislikeCount":4,"createdAt":"2025-05-06T21:58:32.218Z","executes":932,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:02:58.636Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/416b31d1d5ce55063f83d8071fc718da72824fda072d36c401fa6a7e7b965086.webp","original":"https://scriptblox.com/images/sb/6961824067-1746568712154.png","scriptblox":"https://scriptblo