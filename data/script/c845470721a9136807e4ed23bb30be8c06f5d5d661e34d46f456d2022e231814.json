{"_id":"68184dd8b76a6903e9091805","title":"Skins Unlocker","game":{"_id":"67e5e1ffb360710ec3c78075","gameId":3203685552,"name":"BEAR (Alpha)","imageUrl":{"url":"https://media.kocakz.me/2ab53dff2123afb6b2378e95a0fa82ccdcd7706a0830a9157f181d3e7dd3b2e9.webp","original":"https://tr.rbxcdn.com/180DAY-2eef8ff1624f586e7635404214bba080/150/150/Image/Png/noFilter"},"slug":"3203685552-bear","path":"/game/3203685552-bear","thumbnail":{"url":"https://media.kocakz.me/2ab53dff2123afb6b2378e95a0fa82ccdcd7706a0830a9157f181d3e7dd3b2e9.webp","original":"https://tr.rbxcdn.com/180DAY-2eef8ff1624f586e7635404214bba080/150/150/Image/Png/noFilter"},"placeId":3203685552},"slug":"BEAR-(Alpha)-Inventory-Unlocker-38657","verified":false,"key":false,"keyless":false,"views":11122,"executes":128,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-989d23c8503944f3678e19c715f133db-13281618bf1f.png","scriptblox":"https://scriptblox.com/images/script/rbx-989d23c8503944f3678e19c715f133db-13281618bf1f.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-989d23c8503944f3678e19c715f133db-13281618bf1f.png","scriptblox":"https://scriptblox.com/images/script/rbx-989d23c8503944f3678e19c715f133db-13281618bf1f.png"},"likeCount":6,"dislikeCount":5,"createdAt":"2025-05-05T05:34:16.968Z","updatedAt":"2025-05-05T05:34:16.968Z","lastBump":"2025-05-05T05:34:16.968Z","script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal gui = player:WaitForChild(\"PlayerGui\"):WaitForChild(\"GameUI\")\nlocal displayFrame = gui:WaitForChild(\"Inventory\"):WaitForChild(\"DisplayFrame\")\nlocal equipBox = gui:WaitForChild(\"Inventory\"):WaitForChild(\"EquipBox\")\n\n-- Find the first ImageButton in DisplayFrame (to clone)\nlocal imageButton = displayFrame:FindFirstChildOfClass(\"ImageButton\")\n\nlocal bearSkinsFolder = ReplicatedStorage:WaitForChild(\"GameContent\"):WaitForChild(\"BearSkins\")\n\n-- Function to delay execution\nlocal function waitFor(ms)\n    wait(ms / 1000)  -- Convert milliseconds to seconds\nend\n\nfor _, moduleScript in pairs(bearSkinsFolder:GetChildren()) do\n    if moduleScript:IsA(\"ModuleScript\") then\n        -- Try requiring the module and checking for its structure\n        local success, module = pcall(require, moduleScript)\n        \n        if success and typeof(module) == \"table\" then\n            -- Print the contents of the module for debugging\n            print(\"Module data for\", moduleScript.Name)\n            for key, value in pairs(module) do\n                print(key, value)\n            end\n            \n            -- Check if Name exists and fallback if missing\n            if type(module.Name) == \"string\" then\n                print(\"Module Name: \", module.Name)\n            else\n                warn(\"Module missing 'Name' property, setting fallback to moduleScript name:\", moduleScript.Name)\n                module.Name = moduleScript.Name  -- Use moduleScript's name as fallback\n            end\n\n            -- Set Onsale to true\n            module.Onsale = true\n\n            -- Add a delay here to allow the data to process before cloning the ImageButton\n            waitFor(500)  -- Wait for 500 milliseconds (adjust this value as necessary)\n\n            -- Clone the ImageButton and set the image\n            local newButton = imageButton:Clone()\n            newButton.Name = module.Name\n            newButton.Image = module.Thumbnail or \"rbxassetid://0\"  -- Default image if not set\n            newButton.Visible = true\n            newButton.Parent = displayFrame\n\n            -- Connect click event to update EquipBox with the module data\n            newButton.MouseButton1Click:Connect(function()\n                -- Update EquipBox with the data from the selected module\n                equipBox.ItemName.Text = module.Name\n                equipBox.Description.Text = module.Description or \"No description available\"\n                equipBox.Creator.Text = module.Creator or \"Unknown Creator\"\n                equipBox.Icon.Image = module.Thumbnail or \"rbxassetid://0\"  -- Fallback if missing\n\n                print(\"Selected skin:\", module.Name)\n            end)\n\n            print(\"Loaded skin:\", module.Name)\n        else\n            warn(\"Failed to load module:\", moduleScript.Name)\n        end\n    end\nend\n","features":"Tired of grinding try this script!\nJust wait a few minutes before getting to the shop","tags":["bear","roblox","game","playervsplayers","bestexploits"],"discord":"","keyLink":"","owner":{"_id":"6739a1a60a9caf676b450b1a","username":"ProScripts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a4d53cc07f1973cb69288c6f99ec272f6444e480286a3228c88b1f86df79f239.webp","original":"https://scriptblox.com/images/photo/6739a1a60a9caf676b450b1a-1790904475090.png"},"status":"offline","id":"6739a1a60a9caf676b450b1a","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/a4d53cc07f1973cb69288c6f99ec272f6444e480286a3228c88b1f86df79f239.webp","original":"https://scriptblox.com/images/photo/6739a1a60a9caf676b450b1a-1790904475090.png"}},"reviewed":{"name":"mcdaggitt","role":"staff","roleLabel":"ScriptBlox staff","at":"2026-09-29T20:29:21.212Z","profile":"/u/mcdaggitt"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:00:10.739Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68184dd8b76a6903e9091808","editBy":{"_id":"6739a1a60a9caf676b450b1a","username":"ProScripts","status":"offline","id":"6739a1a60a9caf676b450b1a"},"messag