:Wait()\nhh.Parent = game.Players.LocalPlayer.Character\nend\nend)\nend)","owner":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","verified":false,"profilePicture":"/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png","status":"offline","id":"629dfc67ee6d3da00eafbd2e","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":22020,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-04-13T20:03:32.392Z","dislikeCount":4,"likeCount":5,"image":"/images/sb/730951264-1713038612282.webp","executes":893,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c509f3","editBy":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","status":"offline","id":"629dfc67ee6d3da00eafbd2e"},"message":"Create script","createdAt":"2025-03-27T21:53:33.531Z"}],"comments":[{"_id":"661ae9dfc91bb3262a2ddbe0","commentBy":{"_id":"64d28c8d3112d780bc5a62d2","username":"SCREEPSTU","verified":false,"role":"user","profilePicture":"/images/photo/64d28c8d3112d780bc5a62d2-1735436455923.png","createdAt":"2023-08-08T18:42:21.941Z","lastActive":"2025-12-12T12:44:05.723Z","status":"offline","id":"64d28c8d3112d780bc5a62d2","topMilestone":{"key":"creator.scripts","tier":5}},"text":"Thank you bro","createdAt":"2024-04-13T20:23:59.117Z","edited":true,"dislikeCount":0,"likeCount":3,"liked":false,"disliked":false},{"_id":"661af35482af4af1797044ab","commentBy":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","verified":false,"role":"user","profilePicture":"/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png","createdAt":"2022-06-06T13:08:55.114Z","lastActive":"2026-09-01T01:11:17.927Z","status":"offline","id":"629dfc67ee6d3da00eafbd2e","topMilestone":{"key":"creator.scripts","tier":25}},"text":"ty for like and follow @4BV6","createdAt":"2024-04-13T21:04:20.879Z","edited":true,"dislikeCount":0,"likeCount":3,"liked":false,"disliked":false},{"_id":"661b0e2152bf