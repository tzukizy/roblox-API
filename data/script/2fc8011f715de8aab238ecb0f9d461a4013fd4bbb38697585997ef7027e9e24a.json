int(\"=== SEARCHING FOR REVIVE & ARREST TOOLS ===\")\n\nlocal wantedTools = {\n    [\"revive\"] = false,\n    [\"arrest\"] = false\n}\n\nlocal function isWantedTool(name)\n    name = name:lower()\n    return name:find(\"revive\") or name:find(\"arrest\")\nend\n\nlocal function deepSearch(parent, depth)\n    depth = depth or 0\n    if depth > 10 then return end\n\n    for _, obj in pairs(parent:GetChildren()) do\n        if obj:IsA(\"Tool\") then\n            local lowerName = obj.Name:lower()\n\n            if isWantedTool(lowerName) then\n                local key = lowerName:find(\"revive\") and \"revive\" or \"arrest\"\n\n                if not wantedTools[key] then\n                    wantedTools[key] = true\n\n                    print(\"🔍 FOUND: \" .. obj:GetFullName())\n                    local clone = obj:Clone()\n                    clone.Parent = backpack\n                    print(\"✅ ADDED TO BACKPACK: \" .. obj.Name)\n                end\n            end\n\n        elseif obj:IsA(\"Folder\") or obj:IsA(\"Model\") or obj:IsA(\"Configuration\") then\n            deepSearch(obj, depth + 1)\n        end\n    end\nend\n\n-- Search all major containers\ndeepSearch(ReplicatedStorage)\npcall(function() deepSearch(ServerStorage) end)\ndeepSearch(workspace)\ndeepSearch(backpack)\n\nprint(\"\\n=== SEARCH COMPLETE ===\")\nprint(\"Revive tool found:\", wantedTools[\"revive\"])\nprint(\"Arrest tool found:\", wantedTools[\"arrest\"])\n\nprint(\"\\nBackpack contents:\")\nfor _, tool in pairs(backpack:GetChildren()) do\n    if tool:IsA(\"Tool\") then\n        print(\" - \" .. tool.Name)\n    end\nend","features":"idk if patched","tags":[],"discord":"","keyLink":"","owner":{"_id":"62f3438d9541ae5f4e4212e9","username":"wsg9384y","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62f3438d9541ae5f4e4212e9","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.