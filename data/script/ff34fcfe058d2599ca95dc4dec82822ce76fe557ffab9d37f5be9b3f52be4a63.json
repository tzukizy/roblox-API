{"slug":"Prison-Life-Arrest-Aura-OPEN-SOURCE-61190","_id":"68ff43d1e1a1477ec1abd37d","title":"Arrest Aura OPEN SOURCE [Handcuffs not needed equip]","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":155615604},"features":"Arrest Player's nearby\n[Handcuffs not needed equip]\n\nRange is 10","tags":["Prison Life"],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal me = Players.LocalPlayer\nlocal remote = ReplicatedStorage.Remotes.ArrestPlayer\n\nRunService.Heartbeat:Connect(function()\n    local root = me.Character and me.Character:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return end\n    \n    for _, plr in Players:GetPlayers() do\n        if plr == me then continue end\n        local char = plr.Character\n        if not char then continue end\n        local hrp = char:FindFirstChild(\"HumanoidRootPart\")\n        local hum = char:FindFirstChild(\"Humanoid\")\n        if not hrp or not hum or hum.Health <= 0 then continue end\n        if (root.Position - hrp.Position).Magnitude <= 10 then\n            task.spawn(function()\n                pcall(remote.InvokeServer, remote, plr)\n            end)\n        end\n    end\nend)","owner":{"_id":"6770e9d05213f1918bcc81cf","username":"ScripterCoder","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/de9c829cded539a151f617c26f6bd0b8e2c6f693d493573daf5c05d5fb0a6c48.webp","original":"https://scriptblox.com/images/photo/6770e9d05213f1918bcc81cf-1735453216660.png"},"status":"offline","id":"6770e9d05213f1918bcc81cf","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/de9c829cded539a151f617c26f6bd0b8e2c6f693d493573daf5c05d5fb