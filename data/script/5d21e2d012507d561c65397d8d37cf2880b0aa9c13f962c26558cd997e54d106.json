{"slug":"Universal-Script-made-just-because-of-boredom-38064","_id":"6810b246219af807bf21f7c4","title":"made just because of boredom","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"infinite yield with ctrl tp\n\nctto","tags":[],"script":"loadstring(game:HttpGet(\"https://rawscripts.net/raw/Infinite-Yield_500\"))()\n\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal Player = game.Players.LocalPlayer\nlocal Mouse = Player:GetMouse()\n\n\nfunction GetCharacter()\n   return game.Players.LocalPlayer.Character\nend\n\nfunction Teleport(pos)\n   local Char = GetCharacter()\n   if Char then\n       Char:MoveTo(pos)\n   end\nend\n\n\nUIS.InputBegan:Connect(function(input)\n   if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then\n       Teleport(Mouse.Hit.p)\n   end\nend)","owner":{"_id":"62b28152f5f20be73eaea3a6","username":"mod3_mj","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/38aa9d452e6e3b13f111c4fcf94edf4aa68a1f457f08bf2ac263fd04dcbd6c7e.webp","original":"https://scriptblox.com/images/photo/62b28152f5f20be73eaea3a6-1774961649671.jpg"},"status":"offline","id":"62b28152f5f20be73eaea3a6","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/38aa9d452e6e3b13f111c4fcf94edf4aa68a1f457f08bf2ac263fd04dcbd6c7e.webp","original":"https://scriptblox.com/images/photo/62b28152f5f20be73eaea3a6-1774961649671.jpg"}},"verified":false,"views":4665,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/46602de642de23e881c159a3e5db7f54265ae2e6d70d880b5c906164a92257bb.webp","original":"https://scriptblox.com/images/sb/0-1745924678721.webp","scriptblox":"https://scriptblox.com/imag