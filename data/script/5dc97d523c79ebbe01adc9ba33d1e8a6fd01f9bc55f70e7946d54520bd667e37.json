{"slug":"Universal-Script-Collision-enabler-7314","_id":"64e36dff65fb04d1b2d9c816","title":"Collision enabler","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/7833648-1692626431842.webp","placeId":0},"features":"Can let u touch players, credits to the owner of the script","tags":[],"script":"--makes it so that you can collide with players and their limbs (Use with scripts like Snake)\n--NOTE: collision is not server sided and only happens on your client (Fling scripts only work on you not others)\n\nLP = game.Players.LocalPlayer\nwhile wait(3) do\n    for i,v in pairs(game.Players:GetDescendants()) do\n        if v:IsA(\"Player\") and workspace:FindFirstChild(v.Name) and v ~= LP and workspace[v.Name]:FindFirstChild(\"CHECKER\") == nil then\n            checker = Instance.new(\"BoolValue\",workspace[v.Name])\n            checker.Name = \"CHECKER\"\n            for i,v in pairs(workspace:WaitForChild(v.Name):GetDescendants()) do\n                if v:IsA(\"Part\") or v:IsA(\"MeshPart\") then\n                    local collider = Instance.new(\"Part\",v)\n                    collider.Size = v.Size\n                    collider.Position = v.Position\n                    collider.Transparency = 1\n                    local weld = Instance.new(\"Weld\",v)\n                    weld.Part0 = v\n                    weld.Part1 = collider\n                end\n            end\n        end\n    end\nend","owner":{"_id":"64d106a6bb0cd5565b3f4dc1","username":"Ytsmells123","verified":false,"profilePicture":"/images/photo/64d106a6bb0cd5565b3f4dc1-1691420388920.jpg","status":"offline","id":"64d106a6bb0cd5565b3f4dc1","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"keyLink":"","views":26549,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-08-21T14:00:31.961Z","dislikeCount":0,"likeCount":2,"image":"/images/sb/7833648-1692626431842.webp","executes":469,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f7bb","editBy":{"_id":"64d106a6bb0cd5565b3f4dc1","username":"Ytsmells123","status":"offline","id":"64d106a6bb0cd5565b3f4dc1"},"message":"Create script","createdAt":"2025-03-27T22:19:11.552Z"}],"comments":[{"_id":"64e36f82745e83246e28a75c","commentBy":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"role":"user","profilePicture":"/images/photo/64cb81f82512701e9a163c00-1699804719964.gif","createdAt":"2023-08-03T10:31:20.738Z","lastActive":"2026-10-04T08:41:27.719Z","status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13466058}},"topMilestone":{"key":"creator.views","tier":10000000}},"text":"what's the point of this if it's not even serversided lmao","createdAt":"2023-08-21T14:06:58.149Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64e3898ac7e5b92e280af659","commentBy":{"_id":"64e382019e7dd8ee3d4cecf9","username":"Opsnonman","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-08-21T15:25:53.507Z","lastActive":"2026-03-26T15:02:52.797Z","status":"offline","id":"64e382019e7dd8ee3d4cecf9","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Clientsided moment","createdAt":"2023-08-21T15:58:02.239Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64e52f0209694308308aa13a","commentBy":{"_id":"62e367bc60aabc5a2f0c69aa","username":"shaaficoffee","verified":false,"role":"user","profilePicture":"/images/user-default.png","createdAt":"2022-07-29T04:53:16.316Z","lastActive":"2023-11-06T01:26:04.785Z","status":"offline","id":"62e367bc60aabc5a2f0c69aa"},"text":"@vxsty you could probably try to use a fling script","createdAt":"2023-08-22T21:56:18.365Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64e61177ca1bc199f37e14c7","commentBy":{"_id":"64cb81f82