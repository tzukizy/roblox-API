,0)\nactual.Visible = true\nactual.Position = UDim2.new(0,0,0,0)\nactual.Playing = true\nactual.Looped = true\n\nactual.Video = getcustomasset(\"funny_vid.webm\")","features":"[First video player script on roblox]\n\nIt just plays an video on your screen.\nLike all of my scripts, open source\n\nJust change the github link into another one if you want to change the video\n\nBy the way, the video right there is SUPPOSED to be pixelized a bit, its a random meme i got, so dont worry its not gonna pixelize your videos or others.","tags":["Universal","Video","Fun","Useless"],"discord":"","keyLink":"","owner":{"_id":"679694326eca977d7136761c","username":"HelloRoblox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a182ed55ec659a99d0d888668211a63665b4712672e98fabc8b48b3f9925c502.webp","original":"https://scriptblox.com/images/photo/679694326eca977d7136761c-1737921652524.png"},"status":"offline","id":"679694326eca977d7136761c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/a182ed55ec659a99d0d888668211a63665b4712672e98fabc8b48b3f9925c502.webp","original":"https://scriptblox.com/images/photo/679694326eca977d7136761c-1737921652524.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:00:21.211Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54c7b","editBy":{"_id":"679694326eca977d7136761c","username":"HelloRoblox","status":"offline","id":"679694326eca977d7136761c"},"message":"Create script","createdAt":"2025-03-27T15:55:35.943Z"}],"comments":[{"_id":"67accf7cd9c566978510ac49","commentBy":{"_id":"679694326eca977d7136761c","username":"HelloRoblox","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/a182ed55ec659a99d0d888668211a63665b4712672e98fabc8b48b3f9925c502.webp","original"