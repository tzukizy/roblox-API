{"slug":"Final-Nerve-Obby-Simple-Checkpoint-Teleporter-212704","_id":"69fd193c255dc895a9ee5136","title":"Simple Checkpoint Teleporter","game":{"_id":"69fd193c255dc895a9ee5133","gameId":134048975793062,"name":"Final Nerve Obby","imageUrl":"/images/sb/rbx-fb4a4821277c92c87e5a7d563bac8420-3460d1cd20c7.png","placeId":134048975793062},"features":"Teleports you through every checkpoint from 1 to 180\n0.3 second delay between each teleport\nAutomatically deletes itself when finished","tags":[],"script":"local checkpoints = workspace.Checkpoints\nlocal player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal root = char:WaitForChild(\"HumanoidRootPart\")\n\nfor i = 1, 180 do\n\tlocal cp = checkpoints:FindFirstChild(tostring(i))\n\tif cp then\n\t\troot.CFrame = cp.CFrame + Vector3.new(0, 3, 0)\n\tend\n\ttask.wait(0.3)\nend\n\nscript:Destroy()","owner":{"_id":"67feabf9b5e1e2a41ee4c7c7","username":"Koxy","verified":false,"profilePicture":"/images/photo/67feabf9b5e1e2a41ee4c7c7-1778194962669.jpg","status":"offline","id":"67feabf9b5e1e2a41ee4c7c7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":728,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-fb4a4821277c92c87e5a7d563bac8420-3460d1cd20c7.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-05-07T22:59:08.668Z","executes":47,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69fd193c255dc895a9ee5139","editBy":{"_id":"67feabf9b5e1e2a41ee4c7c7","username":"Koxy","status":"offline","id":"67feabf9b5e1e2a41ee4c7c7"},"message":"Create script","createdAt":"2026-05-07T22:59:08.678Z"}],"comments":[{"_id":"69fd1a4b62aef26827f64083","commentBy":{"_id":"67feabf9b5e1e2a41ee4c7c7","username":"Koxy","verified":false,"role":"user","profilePicture":"/images/photo/67feabf9b5e1e2a41ee4c7c7-1778194962669.jpg","createdAt":"2025-04-15T18:56:57.701Z","lastActive":"