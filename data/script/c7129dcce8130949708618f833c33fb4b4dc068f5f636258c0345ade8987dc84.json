{"slug":"Fall-Block-Click-to-drop-tile-tool-4584","_id":"62e8e6e9ce02c7ac21a49cc9","title":"Click to drop tile tool","game":{"_id":"67e5e1ffb360710ec3c78338","gameId":6155643742,"name":"Fall Block","imageUrl":"https://tr.rbxcdn.com/49f0f3c2cf73c1d748973eb4c1e216fa/500/280/Image/Jpeg","placeId":6155643742},"features":"If you click a tile it will be activated to fall. Best combined with an autoclicker.","tags":["troll","grief"],"script":"mouse = game.Players.LocalPlayer:GetMouse()\ntool = Instance.new(\"Tool\")\ntool.RequiresHandle = false\ntool.Name = \"ClickFall\"\ntool.Activated:connect(function()\n   if mouse.Target:FindFirstChildWhichIsA(\"TouchTransmitter\") then\n       game:GetService(\"ReplicatedStorage\").Events.TouchRE:FireServer(mouse.Target)\n   end\nend)\ntool.Parent = game.Players.LocalPlayer.Backpack\ngame.Players.LocalPlayer.Character.Humanoid:EquipTool(tool)","owner":{"_id":"62e7364da190000aea61f6e1","username":"CraX","verified":true,"profilePicture":"/images/photo/62e7364da190000aea61f6e1-1659319968412.jpg","status":"offline","id":"62e7364da190000aea61f6e1","topMilestone":{"key":"creator.scripts","tier":5}},"verified":true,"views":159136,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-08-02T08:57:13.955Z","dislikeCount":0,"likeCount":8,"image":"https://tr.rbxcdn.com/49f0f3c2cf73c1d748973eb4c1e216fa/500/280/Image/Jpeg","executes":30,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f4ec","editBy":{"_id":"62e7364da190000aea61f6e1","username":"CraX","status":"offline","id":"62e7364da190000aea61f6e1"},"message":"Create script","createdAt":"2025-03-27T22:42:28.593Z"}],"comments":[{"_id":"62e90ddea226d25733aa4d5c","commentBy":{"_id":"626341e30d24ab41434258f4","username":"Arcturus","verified":true,"role":"admin","profilePicture":"/images/photo/626341e30d24ab41434258f4-1752912578751.jpeg","createdAt":"2022-04-23T00:01:39.528Z","lastActiv