{"_id":"69bb716eed9548b283402ab3","title":"speed scripto","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/1b7582e5bcddcb05bc622fd5d758cf3ec9a08dfb8aa4fb9f70064ba073208d09.webp","original":"https://scriptblox.com/images/sb/0-1773891950327.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/1b7582e5bcddcb05bc622fd5d758cf3ec9a08dfb8aa4fb9f70064ba073208d09.webp","original":"https://scriptblox.com/images/sb/0-1773891950327.jpg"},"placeId":0},"slug":"Universal-Script-speed-scripto-134511","verified":false,"key":false,"keyless":false,"views":247,"executes":79,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/895f4e146373b46aed12987f2aeb6f8de36dc112d32b663769bd0e122786ea04.webp","original":"https://scriptblox.com/images/sb/0-1773891950327.jpg","scriptblox":"https://scriptblox.com/images/script/0-1773891950327.jpg"},"thumbnail":{"url":"https://media.kocakz.me/895f4e146373b46aed12987f2aeb6f8de36dc112d32b663769bd0e122786ea04.webp","original":"https://scriptblox.com/images/sb/0-1773891950327.jpg","scriptblox":"https://scriptblox.com/images/script/0-1773891950327.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-03-19T03:45:50.347Z","updatedAt":"2026-03-19T03:45:50.347Z","lastBump":"2026-03-19T03:45:50.347Z","script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal humanoid = char:WaitForChild(\"Humanoid\")\n\n-- speed\nlocal walkSpeed = 5   \nlocal runSpeed = 20  \nlocal currentSpeed = walkSpeed\n\n\nlocal running = false\n\nUserInputService.InputBegan:Connect(function(input, gpe)\n    if gpe then return end\n    if input.KeyCode == Enum.KeyCode.LeftShift then\n        running = true\n        currentSpeed = runSpeed\n    end\nend)\n\nUserInputService.InputEnded:Connect(function(input, gpe)\n    if input.KeyCode == Enum.KeyCode.O then\n        running = false\n        currentSpeed = walkSpeed\n    end\nend)\n\n\nRunService.RenderStepped:Connect(function(dt)\n    local moveDir = humanoid.MoveDirection\n    if moveDir.Magnitude > 0 then\n        \n        hrp.CFrame = hrp.CFrame + (moveDir * currentSpeed * dt)\n    end\nend)\n","features":"sppeeedddd","tags":[],"discord":"","keyLink":"","owner":{"_id":"69af8ae81526fb78b4401833","username":"elchapo101019","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69af8ae81526fb78b4401833","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:05:28.126Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bb716eed9548b283402ab6","editBy":{"_id":"69af8ae81526fb78b4401833","username":"elchapo101019","status":"offline","id":"69af8ae81526fb78b4401833"},"message":"Create script","createdAt":"2026-03-19T03:45:50.351Z"},{"_id":"69bb73f1ec95ce09d1587fb4","editBy":{"_id":"69af8ae81526fb78b4401833","username":"elchapo101019","status":"offline","id":"69af8ae81526fb78b4401833"},"message":"Update script","createdAt":"2026-03-19T03:56:33.126Z"}],"comments":[]}