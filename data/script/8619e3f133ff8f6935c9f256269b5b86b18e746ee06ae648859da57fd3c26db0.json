 _G.aqua then\n\t\t\t\t_G.aqua.superfarmer = false\n\t\t\tend\n\t\tend\n\tend\nend)\n\nprint(\"Press T to toggle\") --- All of the Prints are in the  console Bro","owner":{"_id":"6288134d5dc60d198ceb7c67","username":"TheSandMan","verified":false,"profilePicture":"/images/photo/6288134d5dc60d198ceb7c67-1771196043584.jpg","status":"offline","id":"6288134d5dc60d198ceb7c67","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":2358,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/137925884276740-1774313098155.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-24T00:44:58.174Z","executes":8353,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c1de8ab3a74e9b4a8a3a64","editBy":{"_id":"6288134d5dc60d198ceb7c67","username":"TheSandMan","status":"offline","id":"6288134d5dc60d198ceb7c67"},"message":"Create script","createdAt":"2026-03-24T00:44:58.179Z"}],"comments":[{"_id":"69c1de99ee0ba316fcdab992","commentBy":{"_id":"6288134d5dc60d198ceb7c67","username":"TheSandMan","verified":false,"role":"user","profilePicture":"/images/photo/6288134d5dc60d198ceb7c67-1771196043584.jpg","createdAt":"2022-05-20T22:16:45.476Z","lastActive":"2026-09-18T00:03:35.588Z","status":"offline","id":"6288134d5dc60d198ceb7c67","topMilestone":{"key":"creator.likes","tier":100}},"text":"by @megaskidwtf","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-24T00:45:13.301Z","liked":false,"disliked":false},{"_id":"69c1e0ce22aa30fb149fcdec","commentBy":{"_id":"69b9d5ab9994db3519b9fde5","username":"stronk1735","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-03-24T23:26:36.106Z","createdAt":"2026-03-17T22:28:59.325Z","status":"offline","id":"69b9d5ab9994db3519b9fde5"},"text":"who cares this game is dead dead dead","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-24T00:54:38.721Z","liked":false,"dislike