{"_id":"680fcee08335c1f55801b4da","title":"Escape Cuffs","game":{"_id":"67e5e1ffb360710ec3c78b0c","gameId":6022383883,"name":"⚙️UPD⚙️ Military Roleplay ","imageUrl":{"url":"https://media.kocakz.me/2a119abb2f5985890eb93e3d6264cade605331eed07c27c19fab545c7fafe561.webp","original":"https://tr.rbxcdn.com/180DAY-8fcc532ae0c16fda8166dc02613a2e66/150/150/Image/Png/noFilter"},"slug":"6022383883-upd-military-roleplay","path":"/game/6022383883-upd-military-roleplay","thumbnail":{"url":"https://media.kocakz.me/2a119abb2f5985890eb93e3d6264cade605331eed07c27c19fab545c7fafe561.webp","original":"https://tr.rbxcdn.com/180DAY-8fcc532ae0c16fda8166dc02613a2e66/150/150/Image/Png/noFilter"},"placeId":6022383883},"slug":"EASTER-Military-Roleplay-Escape-Cuffs-38063","verified":true,"key":false,"keyless":false,"views":30664,"executes":172,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d78c87c013082d2bb984ea707703c3126efbf5ff1a75f47738655f47e943166e.webp","original":"https://scriptblox.com/images/sb/rbx-2f4247807be2c026db66f2e2f8fb11f3-0c1e8459e515.png","scriptblox":"https://scriptblox.com/images/script/rbx-2f4247807be2c026db66f2e2f8fb11f3-0c1e8459e515.png"},"thumbnail":{"url":"https://media.kocakz.me/d78c87c013082d2bb984ea707703c3126efbf5ff1a75f47738655f47e943166e.webp","original":"https://scriptblox.com/images/sb/rbx-2f4247807be2c026db66f2e2f8fb11f3-0c1e8459e515.png","scriptblox":"https://scriptblox.com/images/script/rbx-2f4247807be2c026db66f2e2f8fb11f3-0c1e8459e515.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-04-28T18:54:24.141Z","updatedAt":"2025-04-28T18:54:24.141Z","lastBump":"2025-04-28T18:54:24.141Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\ngetgenv().cuffEvade = true\n\n--[[\n    insta respawn method was found in https://github.com/AnthonyIsntHere/anthonysrepository/blob/main/scripts/%5Breplicatesignal%5D%20Instant%20Respawn.lua\n    if your executor doesn't support replicatesignal, you'll just reset normally instead\n--]]\nlocal function instaRespawn()\n    if not cuffEvade then return end\n    \n    if not replicatesignal then \n        LocalPlayer.Character.Humanoid.Health = 0 \n        return \n    end\n    \n    replicatesignal(LocalPlayer.ConnectDiedSignalBackend)\n    task.wait(Players.RespawnTime - .01)\n    replicatesignal(LocalPlayer.Kill)\nend\n\nLocalPlayer.CharacterAdded:Connect(function(char)\n    char.ChildAdded:Connect(function(child)\n        if child.Name == \"LeftArmWeld\" then\n            instaRespawn()\n        end\n    end)\nend)\n\nif LocalPlayer.Character then\n    if LocalPlayer.Character:FindFirstChild(\"LeftArmWeld\") then \n        instaRespawn()\n    end\n\n    LocalPlayer.Character.ChildAdded:Connect(function(child)\n        if child.Name == \"LeftArmWeld\" then\n            instaRespawn()\n        end\n    end)\nend\n","features":"- Respawns you whenever you're cuffed\n- Toggle getgenv().cuffEvade to enable/disable the script\n\n(you will be jailed for 300s when you rejoin however)","tags":[],"discord":"","keyLink":"","owner":{"_id":"66ac0f24fe9897618101237a","username":"xMurderer","verified":true,"profilePicture":{"url":"https://media.kocakz.me/a4b2b201adcf4beb0684260be9ed1842040a4112cf8846df863256e94e9e5c90.webp","original":"https://scriptblox.com/images/photo/66ac0f24fe9897618101237a-1723471234370.png"},"status":"offline","id":"66ac0f24fe9897618101237a","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/a4b2b201adcf4beb0684260be9ed1842040a4112cf8846df863256e94e9e5c90.webp","original":"https://scriptblox.com/images/photo/66ac0f24fe9897618101237a-1723471234370.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:01:12.774Z","last":"","win":14,"math":3},"i