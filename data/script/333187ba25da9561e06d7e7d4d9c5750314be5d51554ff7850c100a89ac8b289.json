{"slug":"Universal-Script-Anti-teleport-script-35206","_id":"67f9b5ce482f224a484b852f","title":"Anti teleport script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Fixes getting teleported when in a restricted place with noclip\n\nUseful for getting through restricted places that teleport you back","tags":["universal","no key","free","anti","op"],"script":"local players = game:GetService('Players')\nlocal lplr = players.LocalPlayer\nlocal lastCF, stop, heartbeatConnection\nlocal function start()\n    heartbeatConnection = game:GetService('RunService').Heartbeat:Connect(function()\n        if stop then\n            return \n        end \n        lastCF = lplr.Character:FindFirstChildOfClass('Humanoid').RootPart.CFrame\n    end)\n    lplr.Character:FindFirstChildOfClass('Humanoid').RootPart:GetPropertyChangedSignal('CFrame'):Connect(function()\n        stop = true\n        lplr.Character:FindFirstChildOfClass('Humanoid').RootPart.CFrame = lastCF\n        game:GetService('RunService').Heartbeat:Wait()\n        stop = false\n    end)    \n    lplr.Character:FindFirstChildOfClass('Humanoid').Died:Connect(function()\n        heartbeatConnection:Disconnect()\n    end)\nend\n\nlplr.CharacterAdded:Connect(function(character)\n    repeat \n        game:GetService('RunService').Heartbeat:Wait() \n    until character:FindFirstChildOfClass('Humanoid')\n    repeat \n        game:GetService('RunService').Heartbeat:Wait() \n    until character:FindFirstChildOfClass('Humanoid').RootPart\n    start()\nend)\n\nlplr.CharacterRemoving:Connect(function()\n    heartbeatConnection:Disconnect()\nend)\n\nstart()","owner":{"_id":"66f75b84bad6558f11b01148","username":"sampangmatthew","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"66f75b84bad6558f11b01148","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":11625,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/e6e42eda829cf2111afaa9b0bcad20ecd983c026ac35fbf2a6964660cdcf778c.webp","original":"https://scriptblox.com/images/sb/0-1744418254788.jpg","scriptblox":"https://scriptblox.com/images/script/0-1744418254788.jpg"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-04-12T00:37:34.857Z","executes":1601,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:51:57.897Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/e6e42eda829cf2111afaa9b0bcad20ecd983c026ac35fbf2a6964660cdcf778c.webp","original":"https://scriptblox.com/images/sb/0-1744418254788.jpg","scriptblox":"https://scriptblox.com/images/script/0-1744418254788.jpg"},"changelog":[{"_id":"67f9b5ce482f224a484b8531","editBy":{"_id":"66f75b84bad6558f11b01148","username":"sampangmatthew","status":"offline","id":"66f75b84bad6558f11b01148"},"message":"Create script","createdAt":"2025-04-12T00:37:34.859Z"}],"comments":[{"_id":"694e9aa2426a0c4abcadebcf","commentBy":{"_id":"68305e2f51e1bfc46b124575","username":"I6996I","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"createdAt":"2025-05-23T11:38:23.620Z","lastActive":"2026-05-22T23:26:36.823Z","status":"offline","id":"68305e2f51e1bfc46b124575","profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"text":"it makes ur root part glitch a lot, only fly fixing it","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-26T14:24:34.057Z","liked":false,"disl