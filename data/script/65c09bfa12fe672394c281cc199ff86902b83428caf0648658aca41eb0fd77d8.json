.id\n\t\t\t\tdecal.Face = i\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal particles = function(id)\n\tfor _, v in pairs(game:GetService(\"Players\"):GetPlayers()) do\n\t\tlocal pe = Instance.new(\"ParticleEmitter\", v.Character.Head)\n\t\tpe.Texture = \"rbxassetid://\"..id\n\tend\nend","features":"SkyBox, Decal Spam, Particles","tags":["skybox","decal spam","particles","function"],"discord":"","keyLink":"","owner":{"_id":"67bed47e85438d6878d045dd","username":"Humanoid1337","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c73564b178def0fe8195b8a6259f86ae4d0285a2d3197bbb41b655aea2f9b5d6.webp","original":"https://scriptblox.com/images/photo/67bed47e85438d6878d045dd-1740559544586.jpg"},"status":"offline","id":"67bed47e85438d6878d045dd","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/c73564b178def0fe8195b8a6259f86ae4d0285a2d3197bbb41b655aea2f9b5d6.webp","original":"https://scriptblox.com/images/photo/67bed47e85438d6878d045dd-1740559544586.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:55:59.879Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a04ac85b77f98a7bd7e31f6","editBy":{"_id":"67bed47e85438d6878d045dd","username":"Humanoid1337","status":"offline","id":"67bed47e85438d6878d045dd"},"message":"Create script","createdAt":"2026-05-13T16:53:25.748Z"}],"comments":[{"_id":"6a056db394e00deb6ae05a7e","commentBy":{"_id":"67bed47e85438d6878d045dd","username":"Humanoid1337","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c73564b178def0fe8195b8a6259f86ae4d0285a2d3197bbb41b655aea2f9b5d6.webp","original":"https://scriptblox.com/images/photo/67bed47e85438d6878d045dd-1740559544586.jpg"},"createdAt":"2025-02-26T08:44:46.333Z","lastActive":"2026-06-02T18:47:02.998Z","status":"offline","id":"67bed47