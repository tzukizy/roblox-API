{"slug":"Universal-Script-Functions-for-skids-215182","_id":"6a04ac85b77f98a7bd7e31f3","title":"Functions for skids","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1778691205723.png","placeId":0},"features":"SkyBox, Decal Spam, Particles","tags":["skybox","decal spam","particles","function"],"script":"local skybox = function(id)\n\tlocal a = Instance.new(\"Sky\", game:GetService(\"Lighting\"))\n\ta.SkyboxBk = id\n\ta.SkyboxDn = id\n\ta.SkyboxFt = id\n\ta.SkyboxLf = id\n\ta.SkyboxRt = id\n\ta.SkyboxUp = id\nend\n\nlocal decalspam = function(id)\n\tfor _,v in pairs(workspace:GetDescendants()) do\n\t\tif v:IsA(\"Decal\") or v:IsA(\"Texture\") then\n\t\t\tv.Texture = \"rbxassetid://\"..id\n\t\tend\n\t\tif v:IsA(\"BasePart\") then\n\t\t\tfor i = 1,5 do\n\t\t\t\tlocal decal = Instance.new(\"Decal\", v)\n\t\t\t\tdecal.Texture = \"rbxassetid://\"..id\n\t\t\t\tdecal.Face = i\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal particles = function(id)\n\tfor _, v in pairs(game:GetService(\"Players\"):GetPlayers()) do\n\t\tlocal pe = Instance.new(\"ParticleEmitter\", v.Character.Head)\n\t\tpe.Texture = \"rbxassetid://\"..id\n\tend\nend","owner":{"_id":"67bed47e85438d6878d045dd","username":"Humanoid1337","verified":false,"profilePicture":"/images/photo/67bed47e85438d6878d045dd-1740559544586.jpg","status":"offline","id":"67bed47e85438d6878d045dd","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1247,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1778691205723.png","likeCount":0,"dislikeCount":1,"createdAt":"2026-05-13T16:53:25.743Z","executes":93,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a04ac85b77f98a7bd7e31f6","editBy":{"_id":"67bed47e85438d6878d045dd","username":"Humanoid1337","status":"offline","id":"67bed47e85438d6878d045dd"},"message":"Create script","createdAt":"2026-05-13T16:53:25