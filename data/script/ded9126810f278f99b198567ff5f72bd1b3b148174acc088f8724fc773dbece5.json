{"slug":"+1-Jump-Per-Step-Released-auto-teleport-to-win-open-source-129051","_id":"69a8dfb7dfe464b9182cf9e6","title":"auto teleport to win open source","game":{"_id":"69a8dfb7dfe464b9182cf9e3","gameId":97558670495422,"name":"+1 Jump Per Step [Released]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":97558670495422},"features":"Auto teleport to win — 8000 per win.\nPlease, do not abuse 😭","tags":["auto win","jump per step"],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- Create GUI\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"TeleportToggleGui\"\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\n-- Main Frame\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 200, 0, 100)\nframe.Position = UDim2.new(0.5, -100, 0.4, 0)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Draggable = true\nframe.Parent = screenGui\n\n-- Toggle Button\nlocal toggleButton = Instance.new(\"TextButton\")\ntoggleButton.Size = UDim2.new(1, -20, 0, 50)\ntoggleButton.Position = UDim2.new(0, 10, 0, 25)\ntoggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\ntoggleButton.TextColor3 = Color3.new(1,1,1)\ntoggleButton.TextScaled = true\ntoggleButton.Text = \"Teleport: OFF\"\ntoggleButton.Parent = frame\n\nlocal teleporting = false\nlocal targetPosition = Vector3.new(-413, 6656, 1423)\n\ntoggleButton.MouseButton1Click:Connect(function()\n\tteleporting = not teleporting\n\t\n\tif teleporting then\n\t\ttoggleButton.Text = \"Teleport: ON\"\n\t\ttoggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\n\telse\n\t\ttoggleButton.Text = \"Teleport: OFF\"\n\t\ttoggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\n\tend\nend)\n\n-- Teleport Loop\ntask.spawn(function()\n\twhile true do\n\t\tif teleporting then\n\t\t\tlocal character = player.Character\n\t\t\tif character and character:FindFirstChild(\"HumanoidRootPart\") then\n\t\t\t\tcharacter.HumanoidRootPart.CFrame = CFrame.new(targetPosition)\n\t\t\tend\n\t\tend\n\t\ttask.wait(0)\n\tend\nend)","owner":{"_id":"693bf8b18ca0397aaf9c1d6b","username":"voidhates","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/002a59d0cd2a350551c1ae1e0dc5b2bccf53ecadef9fd3b52666a1776b99d4b7.webp","original":"https://scriptblox.com/images/photo/693bf8b18ca0397aaf9c1d6b-1765538144519.jpg"},"status":"offline","id":"693bf8b18ca0397aaf9c1d6b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/002a59d0cd2a350551c1ae1e0dc5b2bccf53ecadef9fd3b52666a1776b99d4b7.webp","original":"https://scriptblox.com/images/photo/693bf8b18ca0397aaf9c1d6b-1765538144519.jpg"}},"verified":false,"views":462,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/be71c2fe003af05892d71123b9cee49a044a156fb0cef3d04a70aa5c496d2ce8.webp","original":"https://scriptblox.com/images/sb/97558670495422-1772674999446.jpg","scriptblox":"https://scriptblox.com/images/script/97558670495422-1772674999446.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-03-05T01:43:19.470Z","executes":53,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T01:47:42.936Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/be71c2fe003af05892d71123b9cee49a044a156fb0cef3d04a70aa5c496d2ce8.webp","original":"https://scriptblox.com/images/sb/97558670495422-1772674999446.jpg","scriptblox":"https://scriptblox.com/images/script/97558670495422-1772674999446.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a8dfb7dfe464b9182cf9e9","editBy":{"_id":"693bf8b18ca0397aaf9c1d6b","username":"voidhates","status":"of