{"slug":"Brookhaven-RP-speed-and-jump-script-35945","_id":"680113ac2e1d529faac2543b","title":"speed and jump script","game":{"_id":"67e5e1ffb360710ec3c77d10","gameId":4924922222,"name":"Brookhaven 🏡RP","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":4924922222},"features":"erm what the sigma","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal gui = Instance.new(\"ScreenGui\", player.PlayerGui)\ngui.ResetOnSpawn = true\nlocal Button = Instance.new(\"TextButton\", gui)\nButton.Position = UDim2.new(0.158, 0, 0.051, 0)\nButton.Size = UDim2.new(0, 80, 0, 50)\n\nlocal speed = false\n\nButton.Text = \"Original\"\n\nButton.MouseButton1Click:Connect(function()\n\tif not speed then\n\t\tspeed = true\n\t\tButton.Text = \"Custom\"\n\t\tplayer.Character.Humanoid.WalkSpeed = 100\n\t\tplayer.Character.Humanoid.JumpPower = 200\n\telse\n\t\tspeed = false\n\t\tButton.Text = \"Original\"\n\t\tplayer.Character.Humanoid.WalkSpeed = 16\n\t\tplayer.Character.Humanoid.JumpPower = 50\n\tend\nend)\n\nplayer.CharacterAdded:Connect(function()\n\tButton.Text = \"Original\"\n\tspeed = false\nend)","owner":{"_id":"67d44102c616eb83483853e2","username":"cheedabob333","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67d44102c616eb83483853e2","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":17376,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-8f1234005f4bcc5bf85549fb2f301347-8d17cd51b815.png","scriptblox":"https://scriptblox.com/images/script/rbx-8f1234005f4bcc5bf85549fb2f301347-8d17cd51b815.png"},"likeCount":0,"dislikeCoun