{"_id":"69205ef40e547a9631550746","title":"Silent Aim Open Source","game":{"_id":"69205ef40e547a9631550743","gameId":109966870454726,"name":"Zee Hood [MACRO!]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"109966870454726-zee-hood","path":"/game/109966870454726-zee-hood","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":109966870454726},"slug":"Zee-Hood-MACRO!-Silent-Aim-Open-Source-68414","verified":true,"key":false,"keyless":false,"views":14262,"executes":4272,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://t6.rbxcdn.com/180DAY-4f0fb4ce8b1e079f32e7f15d967eeea2","scriptblox":"https://t6.rbxcdn.com/180DAY-4f0fb4ce8b1e079f32e7f15d967eeea2"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://t6.rbxcdn.com/180DAY-4f0fb4ce8b1e079f32e7f15d967eeea2","scriptblox":"https://t6.rbxcdn.com/180DAY-4f0fb4ce8b1e079f32e7f15d967eeea2"},"likeCount":6,"dislikeCount":3,"createdAt":"2025-11-21T12:45:40.916Z","updatedAt":"2025-11-21T12:45:40.916Z","lastBump":"2025-11-21T12:45:40.916Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Mouse = LocalPlayer:GetMouse()\nlocal Camera = workspace.CurrentCamera\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal fovAmount = 300\nlocal teamCheck = false\n\nlocal fovCircle = Drawing.new(\"Circle\")\nfovCircle.Radius = fovAmount\nfovCircle.Visible = true\nfovCircle.Color = Color3.fromRGB(212, 34, 255)\nfovCircle.Thickness = 1\nfovCircle.NumSides = 11\nfovCircle.Position = Vector2.new(Mouse.X, Mouse.Y)\n\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n    fovCircle.Position = Vector2.new(Mouse.X, Mouse.Y)\nend)\n\nlocal function GetClosestPlayer()\n    local closestDistance, closestPlayer = math.huge, nil\n    local mousePos = Vector2.new(Mouse.X, Mouse.Y)\n\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer then\n            local character = player.Character\n            if character and character:FindFirstChild(\"Humanoid\") and character.Humanoid.Health > 0 then\n                local humanoidRootPart = character:FindFirstChild(\"HumanoidRootPart\")\n                if humanoidRootPart then\n                    local screenPos, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)\n                    if onScreen then\n                        local distance = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude\n                        if distance <= fovAmount and (not teamCheck or player.Team ~= LocalPlayer.Team) then\n                            if distance < closestDistance then\n                                closestPlayer = player\n                                closestDistance = distance\n                            end\n                        end\n                    end\n                end\n            end\n        end\n    end\n\n    return closestPlayer\nend\n\nlocal GunHandler = require(ReplicatedStorage.Modules.GunHandler)\n\nif GunHandler then\n    local originalShoot = GunHandler.Shoot\n    \n    GunHandler.Shoot = function(params)\n        local target = GetClosestPlayer()\n        if target and target.Character then\n            local targetHead = target.Character:FindFirstChild(\"Head\")\n            if targetHead then\n                \n                params.AimPosition = targetHead.Position\n                params.Hit = targetHead\n                params.Normal = Vector3.new(0, 1, 0)\n                \n                if params.BeamTarget then\n                    params.BeamTarget = targetHead\n                end\n            end\n        end\n        \n        return originalShoot(params)\n    end\n    \n    print(\"GunHandler hooked successfully\")\nelse\n    warn(\"GunHandler module not found\")\nend\n\n","features":"Silent Aim","tags":[],"discord":"","keyLink":"","owner":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:37:53.302Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69205ef40e547a9631550748","editBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","status":"offline","id":"6227c42f7944271798ea1b15"},"message":"Create script","createdAt":"2025-11-21T12:45:40.921Z"}],"comments":[{"_id":"692160a223ff3deee38c482b","commentBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"role":"user","profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"createdAt":"2022-03-08T21:01:35.262Z","lastActive":"2026-10-15T21:00:12.655Z","lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}