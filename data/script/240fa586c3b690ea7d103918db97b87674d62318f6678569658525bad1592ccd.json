{"slug":"Universal-Script-Fe-Omniman-49493","_id":"68a70d96202bfdc8302fe1ee","title":"Fe Omniman","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1755778454670.jpg","placeId":0},"features":"Create toggle to play ugc anim\n omniman pose\nOnly work in r15 rigs","tags":[],"script":"local gui = Instance.new(\"ScreenGui\", cloneref(game:GetService(\"CoreGui\")))\ngui.ResetOnSpawn = false\n\nlocal btn = Instance.new(\"TextButton\", gui)\nbtn.Size = UDim2.new(0, 120, 0, 40)\nbtn.Position = UDim2.new(0, 20, 0, 20)\nbtn.Text = \"omniman\"\nbtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\nbtn.TextColor3 = Color3.new(1, 1, 1)\nbtn.Draggable = true\n\nlocal track\n\nbtn.MouseButton1Click:Connect(function()\n    local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()\n    local humanoid = char:WaitForChild(\"Humanoid\")\n    local animator = humanoid:FindFirstChildOfClass(\"Animator\") or Instance.new(\"Animator\", humanoid)\n    if not track or not track.IsPlaying then\n        local anim = Instance.new(\"Animation\")\n        anim.AnimationId = \"rbxassetid://81636895937131\"\n        track = animator:LoadAnimation(anim)\n        track.Looped = true\n        track.Priority = Enum.AnimationPriority.Action\n        track:Play(0, 99)\n        track:AdjustSpeed(0)\n        btn.Text = \"omniman\"\n    else\n        track:Stop(0)\n        track:Destroy()\n        track = nil\n        btn.Text = \"OMNIMAN\"\n    end\nend)","owner":{"_id":"671146b7e6e1427a889ba30e","username":"Gaze_","verified":false,"profilePicture":"/images/photo/671146b7e6e1427a889ba30e-1754827690760.png","status":"offline","id":"671146b7e6e1427a889ba30e"},"verified":false,"views":10278,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1755778454670.jpg","likeCount":5,"dislikeCount":0,"createdAt":"2025-08-21T12:14:14.695Z","executes":4054,"keyless":false,"liked":fal