ion\")\n        anim.AnimationId = \"rbxassetid://81636895937131\"\n        track = animator:LoadAnimation(anim)\n        track.Looped = true\n        track.Priority = Enum.AnimationPriority.Action\n        track:Play(0, 99)\n        track:AdjustSpeed(0)\n        btn.Text = \"omniman\"\n    else\n        track:Stop(0)\n        track:Destroy()\n        track = nil\n        btn.Text = \"OMNIMAN\"\n    end\nend)","features":"Create toggle to play ugc anim\n omniman pose\nOnly work in r15 rigs","tags":[],"discord":"","keyLink":"","owner":{"_id":"671146b7e6e1427a889ba30e","username":"Gaze_","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9dbab0de0e98aec1be3628bc6d19e6a78d91bfe8a2506ef4b252d01218bc87fa.webp","original":"https://scriptblox.com/images/photo/671146b7e6e1427a889ba30e-1754827690760.png"},"status":"offline","id":"671146b7e6e1427a889ba30e","profile":{"url":"https://media.kocakz.me/9dbab0de0e98aec1be3628bc6d19e6a78d91bfe8a2506ef4b252d01218bc87fa.webp","original":"https://scriptblox.com/images/photo/671146b7e6e1427a889ba30e-1754827690760.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:47:40.930Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68a70d96202bfdc8302fe1f0","editBy":{"_id":"671146b7e6e1427a889ba30e","username":"Gaze_","status":"offline","id":"671146b7e6e1427a889ba30e"},"message":"Create script","createdAt":"2025-08-21T12:14:14.698Z"}],"comments":[{"_id":"68a712515165138168084435","commentBy":{"_id":"688902c8c8c2b1ab28d8ac76","username":"MARV_CNC3TW","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/2fe4553e8a6ae8ac183607cff995f84ae70585ff91bc1040c3d99f924e15edde.webp","original":"https://scriptblox.com/images/photo/688902c8c8c2b1ab28d8ac76-1754237690972.png"},"createdAt":"2025-07-29T17:20:08.833Z","lastActive":"2