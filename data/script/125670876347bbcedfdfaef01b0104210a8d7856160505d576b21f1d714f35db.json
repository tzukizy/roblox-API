id and humanoid:FindFirstChildOfClass(\"Animator\")\n\n\t\t\tif animator then\n\n\t\t\t\tlocal anim = Instance.new(\"Animation\")\n\n\t\t\t\tanim.AnimationId = \"rbxassetid://2410679501\"\n\n\t\t\t\tlocal track = animator:LoadAnimation(anim)\n\n\t\t\t\ttrack:Play()\n\n\t\t\tend\n\n\t\tend)\n\n\tend\n\nend)\n\ntool.Unequipped:Connect(function()\n\n\tgame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"ResetCharacterAppearance\"):FireServer()\n\nend)\n\ntool.Parent = game.Players.LocalPlayer.Backpack","owner":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"},"status":"offline","id":"6675627a3249494a4c405096","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"}},"verified":false,"views":74792,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/35f6f0e13c1ed6270d92744b92ad6eb1b15e1237251c3b9356b6691be5c4939d.webp","original":"https://scriptblox.com/images/sb/rbx-b56897801909363166c4520c96495ee4-553cf3d879b0.png","scriptblox":"https://scriptblox.com/images/script/rbx-b56897801909363166c4520c96495ee4-553cf3d879b0.png"},"likeCount":2,"dislikeCount":5,"createdAt":"2025-05-20T12:34:12.480Z","executes":815,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:58:44.492Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/35f6f0e13c1ed6270d92744b92ad6eb1b15e1237251c3b