{"slug":"Universal-Script-CTRL-TP-56048","_id":"68de8d07534ebaa33d6e007f","title":"CTRL TP","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"CTRL + MOUSE = TP","tags":[],"script":"local UIS = game:GetService(\"UserInputService\")\n\nlocal Player = game.Players.LocalPlayer\nlocal Mouse = Player:GetMouse()\n\n\nfunction GetCharacter()\n   return game.Players.LocalPlayer.Character\nend\n\nfunction Teleport(pos)\n   local Char = GetCharacter()\n   if Char then\n       Char:MoveTo(pos)\n   end\nend\n\n\nUIS.InputBegan:Connect(function(input)\n   if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then\n       Teleport(Mouse.Hit.p)\n   end\nend)","owner":{"_id":"68d3f7a90f185f588adbc12d","username":"panmaxim200","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"68d3f7a90f185f588adbc12d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":1916,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/3075252470984a4e87eaa1b113c3357ae0e3f686373b47da33cc85a225afc478.webp","original":"https://scriptblox.com/images/sb/0-1759415559121.png","scriptblox":"https://scriptblox.com/images/script/0-1759415559121.png"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-10-02T14:32:39.139Z","executes":299,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:59:12.476Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://c