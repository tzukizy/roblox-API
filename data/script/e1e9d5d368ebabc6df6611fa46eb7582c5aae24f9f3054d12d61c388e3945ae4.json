{"slug":"Universal-Script-Teleport-tool-131546","_id":"69ac25da43eb3299c53755f9","title":"Teleport tool","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Teleport","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal mouse = player:GetMouse()\n\n-- Create tool\nlocal tool = Instance.new(\"Tool\")\ntool.Name = \"Teleport Tool\"\ntool.RequiresHandle = false\ntool.Parent = player.Backpack\n\nlocal maxDistance = 500\n\ntool.Activated:Connect(function()\n    local char = player.Character\n    if not char then return end\n    \n    local root = char:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return end\n    \n    local target = mouse.Hit.Position\n    local distance = (root.Position - target).Magnitude\n    \n    if distance <= maxDistance then\n        root.CFrame = CFrame.new(target + Vector3.new(0,3,0))\n    else\n        warn(\"Too far!\")\n    end\nend)","owner":{"_id":"678df183790040685499331a","username":"L1laqxz","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/1cc31c8bcc48b22c7308d34c269d8d45fdb6f7aa8d29557b27ef1c4bb8b1cc74.webp","original":"https://scriptblox.com/images/photo/678df183790040685499331a-1766827188516.jpg"},"status":"offline","id":"678df183790040685499331a","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/1cc31c8bcc48b22c7308d34c269d8d45fdb6f7aa8d29557b27ef1c4bb8b1cc74.webp","original":"https://scriptblox.com/images/photo/678df183790040685499331a-1766827188516.jpg"}},"verified":false,"views":594,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/3a793d4686c8eb8812dfa66401d0d6c91ff03f88a6c67dd68a53069fa222ceb1.webp","original":"https://scriptblox.com/images/sb/0-