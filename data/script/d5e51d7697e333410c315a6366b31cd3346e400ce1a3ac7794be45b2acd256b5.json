{"slug":"Universal-Script-esp-script-19414","_id":"66fd7af6c94480814f5ec6f4","title":"esp script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"esp script","tags":[],"script":"local players = game:GetService(\"Players\")\nlocal localPlayer = players.LocalPlayer\n\nlocal function highlightCharacter(character)\n    local humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\", 5)\n    if humanoidRootPart then\n        local highlight = Instance.new(\"Highlight\")\n        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Red highlight color\n        highlight.OutlineColor = Color3.fromRGB(0, 0, 0) -- Black outline\n        highlight.Parent = character\n    end\nend\n\nlocal function onCharacterAdded(character)\n    highlightCharacter(character)\nend\n\nlocal function onPlayerAdded(newPlayer)\n    if newPlayer ~= localPlayer then\n        newPlayer.CharacterAdded:Connect(function(character)\n            onCharacterAdded(character)\n        end)\n\n        -- If the character is already loaded for players\n        if newPlayer.Character then\n            onCharacterAdded(newPlayer.Character)\n        end\n    end\nend\n\n-- Apply to all existing players in the game\nfor _, player in pairs(players:GetPlayers()) do\n    onPlayerAdded(player)\nend\n\n-- Handle any new players who join the game\nplayers.PlayerAdded:Connect(onPlayerAdded)\n","owner":{"_id":"66ba76279631d73e8a859652","username":"AX67","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7fcd6bb21ad6861ed978824d91e8980be68dc59c559733283702358e0adb8016.webp","original":"https://scriptblox.com/images/photo/66ba76279631d73e8a859652-1727887996418.png"},"status":"offline","id":"66ba76279631d73e8a859652","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.k