{"slug":"Wind-Slayers-UPD5-Kill-Aura-Closest-Enemy-46949","_id":"688aa2f7b735234094d6e1f5","title":"Kill Aura Closest Enemy","game":{"_id":"68054e5908d1fe2f79bded1d","gameId":91186930813603,"name":"Wind Slayers [UPD5]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":91186930813603},"features":"Yes I know this is pointless but im just seeing what i can do with chatgpt","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal HRP = Character:WaitForChild(\"HumanoidRootPart\")\n\nlocal RemoteEvent = ReplicatedStorage.API.network.RemoteEvent\nlocal EnemiesFolder = workspace:WaitForChild(\"Enemies\")\n\nwhile true do\n    local closestEnemy = nil\n    local closestDist = math.huge\n\n    for _, enemy in ipairs(EnemiesFolder:GetChildren()) do\n        if enemy:FindFirstChild(\"Model\") and enemy.Model:FindFirstChild(\"Torso\") then\n            local enemyTorso = enemy.Model.Torso\n            local dist = (enemyTorso.Position - HRP.Position).Magnitude\n            if dist < closestDist then\n                closestDist = dist\n                closestEnemy = enemy\n            end\n        end\n    end\n\n    if closestEnemy then\n        RemoteEvent:FireServer(\"attack\", closestEnemy.Name)\n        print(\"Attacking closest enemy:\", closestEnemy.Name)\n    else\n        print(\"No enemies found.\")\n    end\n\n    task.wait(0.01) -- super fast loop (10 milliseconds)\nend\n","owner":{"_id":"632741de2362bb8dea88f3c8","username":"Chocolatewater","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0b733e8958d353d0d5ce46dcf0a7715476dba2866e7a470db3f44c77388e3067.webp","original":"https://scriptblox.com/images/photo/632741de2362bb8dea88f3c8-1753409321673.jpeg"},"status":"offline","id":"632741de2362bb8dea88f3c8","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/0b733e8958d353d0d5ce46dcf0a7715476dba2866e7a470db3f44c77388e3067.webp","original":"https://scriptblox.com/images/photo/632741de2362bb8dea88f3c8-1753409321673.jpeg"}},"verified":false,"views":2271,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-31119ff03be780c15d21d636c554861c-f1984724705d.png","scriptblox":"https://scriptblox.com/images/script/rbx-31119ff03be780c15d21d636c554861c-f1984724705d.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-07-30T22:55:51.180Z","executes":13,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:11:12.067Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-31119ff03be780c15d21d636c554861c-f1984724705d.png","scriptblox":"https://scriptblox.com/images/script/rbx-31119ff03be780c15d21d636c554861c-f1984724705d.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"688aa2f7b735234094d6e1f7","editBy":{"_id":"632741de2362bb8dea88f3c8","username":"Chocolatewater","status":"offline","id":"632741de2362bb8dea88f3c8"},"message":"Create script","createdAt":"2025-07-30T22:55:51.185Z"}],"comments":[{"_id":"688aaaca13be08f4950698b3","commentBy":{"_id":"65c6b26d94bada8a7e74fb61","username":"exzy","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/f5f9f4165f38b33d56467ad0d2e9df8c2bb43b11e499f587cd2efbd515379cbd.webp","original":"https://scriptblox.com/images/photo/65c6b26d94bada8a7e74fb61-1721272162993.jpg"},"createdAt":"2024-02-09T23:17:01.817Z","lastActive":"2026-04-04T05:29:50.059Z","status":"