{"slug":"Noobs-in-Combat-v5.0-Show-enemy-on-map-7030","_id":"64d94d5412452fc644b493da","title":"Show enemy on map","game":{"_id":"67e5e1ffb360710ec3c780e2","gameId":5734383673,"name":"Noobs in Combat [5.10]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":5734383673},"features":"Show enemy on map","tags":[],"script":"local replicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal workspace = game:GetService(\"Workspace\")\n\nlocal hiddenUnitsFolder = replicatedStorage:WaitForChild(\"HIDDEN_UNITS\")\n\nlocal thExFolder = workspace:FindFirstChild(\"THex\") or Instance.new(\"Folder\")\nthExFolder.Name = \"THex\"\nthExFolder.Parent = workspace\n\nwhile true do\n    for _, child in ipairs(thExFolder:GetChildren()) do\n        if not hiddenUnitsFolder:FindFirstChild(child.Name) then\n            child:Destroy()\n        end\n    end\n\n    for _, hiddenUnit in ipairs(hiddenUnitsFolder:GetChildren()) do\n        if hiddenUnit:IsA(\"Model\") and not thExFolder:FindFirstChild(hiddenUnit.Name) then\n            hiddenUnit:Clone().Parent = thExFolder\n        end\n    end\n\n    wait(5)\nend","owner":{"_id":"61d1198e4f087e95f81854ea","username":"True_Gamer","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"61d1198e4f087e95f81854ea","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":18936,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-08-13T21:38:28.582Z","dislikeCount":1,"likeCount":3,"image":{"url":"https://cdn.kocakz.me/images/eb7d24d66584362662be0bca73b5dcbc4f47a367ddaebd3896f9ed3bb4f5aba9.webp","original":"https://scriptblox.com/images/sb/5734383673-1691962708483.webp","scriptblox":"https://scriptblo