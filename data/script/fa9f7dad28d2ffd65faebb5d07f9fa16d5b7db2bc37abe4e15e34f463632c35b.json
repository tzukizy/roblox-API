    [\"Chapter5\"] = 30,\n    [\"CoilChaos\"] = 20,\n    [\"CommunityPack1\"] = 20,\n    [\"CommunityPack2\"] = 20,\n    [\"CommunityPack3\"] = 20,\n    [\"CommunityPack4\"] = 20,\n    [\"CrimsonSkies\"] = 15,\n    [\"FrozenNorth\"] = 20,\n    [\"RedHerring\"] = 15,\n    [\"UncookedBusiness\"] = 20\n}\n\nlocal player = game.Players.LocalPlayer\nlocal stageFolder = player:WaitForChild(\"PlayerData\"):WaitForChild(\"Unlocked\"):WaitForChild(\"Stage\")\n\nlocal function updateStars(modeFolder, newValue)\n    if modeFolder then\n        for i = 1, 3 do\n            local starName = \"Star\" .. i\n            local starObj = modeFolder:FindFirstChild(starName)\n            if starObj and starObj:IsA(\"NumberValue\") then\n                starObj.Value = newValue\n            end\n        end\n    end\nend\n\nfor folderName, value in pairs(settings) do\n    local folder = stageFolder:FindFirstChild(folderName)\n    if folder then\n        updateStars(folder:FindFirstChild(\"Easy\"), value)\n        updateStars(folder:FindFirstChild(\"Hard\"), value)\n    end\nend\n","features":"Visual all enemy's (btw you can spawn normal enemy's like funk1d on tumore, except gamek1d)","tags":[],"discord":"","keyLink":"","owner":{"_id":"69e2d58bdca1830b26666262","username":"Execgaming61","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69e2d58bdca1830b26666262","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:38:45.335Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69ec3094cd30ad421b72f471","editBy":{"_id":"69e2d58bdca1830b26666262","username":"Execgaming61","status":"offline","id":"69e2d58bdca183