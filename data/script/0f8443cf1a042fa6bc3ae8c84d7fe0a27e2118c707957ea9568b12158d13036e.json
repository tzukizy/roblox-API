{"slug":"Universal-Script-Get-Reset-Button-Back-7363","_id":"64e65f72cb2e89d7ef75bf38","title":"Get Reset Button Back","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"I know you can bypass all this by simply setting your humanoid health to zero, but this is just for people who wanna do it faster.\nIt automatically brings the Reset button back so you don't have to worry about executing it each death.","tags":["reset button","bring back","retriever","reset character","auto"],"script":"game.Loaded:Wait()\n\n--incase its already disabled\nstarterthing:SetCore(\"ResetButtonCallback\", true)\n\n--the automation\nlocal starterthing = game:GetService(\"StarterGui\")\nwhile true do\n    starterthing.Changed:Wait()\n    if starterthing:GetCore(\"ResetButtonCallback\") == false then\n        starterthing:SetCore(\"ResetButtonCallback\", true)\n    end\nend","owner":{"_id":"634839d2631041248b6155f4","username":"ultraproscripter44","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/634839d2631041248b6155f4-1665677898884.png"},"status":"offline","id":"634839d2631041248b6155f4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/634839d2631041248b6155f4-1665677898884.png"}},"verified":false,"keyLink":"","views":21726,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-08-23T19:35:14.728Z","dislikeCount":0,"likeCount":3,"image":{"url":"https://media.kocakz.me/90f82895baa2bc0debfaaf4f2a6cf7656eb556ea0820a2f6ccab6e19e06438ce.webp","original":"https://scriptblox.com/images/sb/1856779-1692819314533.webp","scriptblox":"https://scriptblox.com/images/scrip