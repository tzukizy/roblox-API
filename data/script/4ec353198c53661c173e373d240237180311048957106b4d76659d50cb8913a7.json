)\n\n* V-Cycle:  Cycles through all valid targets twice. (WIP)\n\n* Keybinds — E previous, R next, T clear, U position mode, K victim cam, Q snap combat, LMB sticky, 1/2/3 positioning, 4+LMB push back, V V-cycle, P prediction, I instant interact, Y smart mode, H HUD, N sidebar, O stop / delete script completly","tags":["Divine","Divine Battlegrounds","easy","free","no key"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/fischisreal/LarpingHub/refs/heads/main/docs/tsb/DivineBgScript.lua\"))()","owner":{"_id":"698a4a09ae295815dacd27fe","username":"derfisch08","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/4d3dc9628706dcc670a31fe216ac5ff334645cb5f5312a87aabfa4c6a2062f76.webp","original":"https://scriptblox.com/images/photo/698a4a09ae295815dacd27fe-1789413920945.png"},"lvl":6,"status":"offline","id":"698a4a09ae295815dacd27fe","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/4d3dc9628706dcc670a31fe216ac5ff334645cb5f5312a87aabfa4c6a2062f76.webp","original":"https://scriptblox.com/images/photo/698a4a09ae295815dacd27fe-1789413920945.png"}},"verified":false,"keyless":false,"views":3390,"executes":6457,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/17d475a0421fcfdec55912ba758837132a35b7d33db66d3c08fffc411a66b8c6.webp","original":"https://scriptblox.com/images/sb/rbx-1f6796663df96f6a4c0b591af76ff831-8baa861a873e.png","scriptblox":"https://scriptblox.com/images/script/rbx-1f6796663df96f6a4c0b591af76ff831-8baa861a873e.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-14T17:19:02.551Z","editBy":{"_id":"698a4a09ae295815dacd27fe","username":"derfisch08","status":"offline","id":"698a4a09ae295815dacd27fe"},"keyLink":"","discord":"https://discord.gg/es9yUG72gg","liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false