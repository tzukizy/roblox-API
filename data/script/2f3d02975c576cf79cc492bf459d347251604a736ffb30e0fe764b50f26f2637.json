{"slug":"KAT-X-Invisibility-60053","_id":"68f8ef0f5f8a0dedcfc6b321","title":"Invisibility","game":{"_id":"68a1105925481d5d6f3ad03e","gameId":111163066268338,"name":"Knife Ability Test","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":111163066268338},"features":"Turns you invisible while still letting you shoot other people and knife them.\n\nExecute ingame not before\nReexecute if you die(probably wont)\nReset your character at round end to spawn in lobby.","tags":["invisible","god mode","keyless","free","kat"],"script":"local Depth = 6\nlocal TargetSpeed = 40\n\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\nlocal RootPart = Character:WaitForChild(\"HumanoidRootPart\")\nlocal ClonePart = RootPart:Clone()\n\nClonePart.Parent = Character\nRootPart.RootJoint.Enabled = false\nRootPart.Name = \"RHumanoidRootPart\"\nRootPart.Transparency = 0\nlocal Highlight = Instance.new(\"Highlight\", RootPart)\n\n-- Keep player near ground.\nworkspace.Gravity = 1000\nHumanoid.JumpPower = 0\nCharacter.Animate.Disabled = true\n\nlocal currentPitch = 0\nwhile task.wait() do\n    Humanoid.WalkSpeed = TargetSpeed\n    local velocity = ClonePart.AssemblyLinearVelocity\n    local horizontalSpeed = Vector2.new(velocity.X, velocity.Z).Magnitude\n    local targetPitch = 0\n    if horizontalSpeed > 0.1 then\n        targetPitch = math.atan2(velocity.Y, horizontalSpeed)\n    end\n\n    currentPitch = currentPitch + (targetPitch - currentPitch) * 0.1\n    local rotation = CFrame.Angles(math.rad(90) + currentPitch, 0, 0)\n    \n    RootPart.CFrame = ClonePart.CFrame * CFrame.new(0, -Depth, 0) * rotation\n    RootPart.Velocity = Vector3.zero\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11023698}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"verified":true,"views":21120,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/f1f961124977ef3ece7503c1b5b1d924674621a8b7e7dd2e718101b2414a45db.webp","original":"https://scriptblox.com/images/sb/rbx-a2598b9719b1c091a185ac168c009ee8-91faa2044d81.png","scriptblox":"https://scriptblox.com/images/script/rbx-a2598b9719b1c091a185ac168c009ee8-91faa2044d81.png"},"likeCount":5,"dislikeCount":2,"createdAt":"2025-10-22T14:49:51.760Z","executes":711,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:51:33.242Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/f1f961124977ef3ece7503c1b5b1d924674621a8b7e7dd2e718101b2414a45db.webp","original":"https://scriptblox.com/images/sb/rbx-a2598b9719b1c091a185ac168c009ee8-91faa2044d81.png","scriptblox":"https://scriptblox.com/images/script/rbx-a2598b9719b1c091a185ac168c009ee8-91faa2044d81.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f8ef0f5f8a0dedcfc6b323","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-10-22T14:49:51.766Z"}],"comments":[{"_id":"68