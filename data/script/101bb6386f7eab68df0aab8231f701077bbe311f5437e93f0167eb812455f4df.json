ht.Name = \"highlight\"\n        highlight.Adornee = char\n        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n        highlight.FillColor = Color3.new(255, 0, 0)\n        highlight.FillTransparency = 0.9 -- do not change to 1 or it will become invisible\n        highlight.OutlineColor = Color3.new(0, 255, 0)\n        highlight.OutlineTransparency = 0\n        highlight.Enabled = true\n        char:FindFirstChild(\"Humanoid\").Died:Connect(function()\n            if getgenv().espIsEnabled == true then\n                task.wait(players.RespawnTime + 1) -- adding 1 to make sure the character is loaded\n                local highlight = Instance.new(\"Highlight\", char)\n                highlight.Name = \"highlight\"\n                highlight.Adornee = char\n                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n                highlight.FillColor = Color3.new(255, 0, 0)\n                highlight.FillTransparency = 0.9 -- do not change to 1 or it will become invisible\n                highlight.OutlineColor = Color3.new(0, 255, 0)\n                highlight.OutlineTransparency = 0\n                highlight.Enabled = true\n            end\n        end)\n    else\n        for _,v in pairs(char:GetChildren()) do\n            if v.Name == \"highlight\" then\n                v:Destroy()\n            end\n        end \n    end\nend\n\nplayers.PlayerAdded:Connect(function(player)\n    if getgenv().espIsEnabled == true then\n        local char = player.Character\n        local highlight = Instance.new(\"Highlight\", char)\n        highlight.Name = \"highlight\"\n        highlight.Adornee = char\n        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n        highlight.FillColor = Color3.new(255, 0, 0)\n        highlight.FillTransparency = 0.9 -- do not change to 1 or it will become invisible\n        highlight.OutlineColor = Color3.new(0, 255, 0)\n        highlight.OutlineTransparency = 0\n        highlight.Enabled = true\n    end\nend)","features":"tested in:\n✅ Solara\n❌ Celery\nworks in games without anticheat\nfeatures:\n- esp","tags":["esp"],"discord":"","keyLink":"","owner":{"_id":"6602d3d9997d7a4d3fcf3f7a","username":"scriptbloxuser22","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6602d3d9997d7a4d3fcf3f7a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:08:16.592Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c517eb","editBy":{"_id":"6602d3d9997d7a4d3fcf3f7a","username":"scriptbloxuser22","status":"offline","id":"6602d3d9997d7a4d3fcf3f7a"},"message":"Create script","createdAt":"2025-03-27T18:39:20.094Z"}],"comments":[{"_id":"66a430e64e937fb5d8b6cb9b","commentBy":{"_id":"669eabf6653124f73d136b5e","username":"UselessScripter","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/25bd1eb0596fe6253c361769312b5496ef0c2ab7c2ae5c28ad7421bfd0e7eb52.webp","original":"https://scriptblox.com/images/photo/669eabf6653124f73d136b5e-1721674838158.png"},"createdAt":"2024-07-22T18:59:02.639Z","lastActive":"2024-08-22T07:28:30.444Z","status":"offline","id":"669eabf6653124f73d136b5e","profile":{"url":"https://media.kocakz.me/25bd1eb0596fe6253c361769312b5496ef0c2ab7c2ae5c28ad7421bfd0e7eb52.webp","original":"https://scriptblox.com/images/photo/669eabf6653124f73d136b5e-1721674838158.png"}},"text":"would you like to modify your esp.\ni could make a gui for it and make it better.","createdAt":"2024-07-26T23:27:34.352Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"66a4326f09414f59161f001b","commentBy":{"_id":"6602d3d9997d7a4d3fc