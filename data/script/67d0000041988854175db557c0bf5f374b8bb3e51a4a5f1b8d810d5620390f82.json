{"slug":"Blade-Ball-09baravenaas-script-11494","_id":"65fc1a0b7aeadffed8515979","title":"09baravenaas   script","game":{"_id":"67e5e1ffb360710ec3c77d8c","gameId":13772394625,"name":"Blade Ball","imageUrl":"/images/sb/rbx-bb25a2cda73447c7c7b8179e4869cab0-295212c54b07.png","placeId":13772394625},"features":"Auto parry script for blade ball","tags":[],"script":"local paddle = script.Parent \nlocal function onBallTouched(ball)\n    local ballVelocity = ball.Velocity\n    local paddlePosition = paddle.Position\n\n    if ballVelocity:Dot(paddlePosition) > 0 then\n        local forceMagnitude = ballVelocity.Magnitude * 2\n        local forceDirection = -ballVelocity.Unit\n\n        ball.BodyForce.Force = forceMagnitude * forceDirection\n    end\nend\n\npaddle.Touched:Connect(onBallTouched)","owner":{"_id":"656ba638835d37c991fbf7e8","username":"S33dedL0rdz","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"656ba638835d37c991fbf7e8"},"verified":false,"keyLink":"","views":14826,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-03-21T11:29:15.076Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/13772394625-1711020554977.webp","executes":45,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c506ef","editBy":{"_id":"656ba638835d37c991fbf7e8","username":"S33dedL0rdz","status":"offline","id":"656ba638835d37c991fbf7e8"},"message":"Create script","createdAt":"2025-03-27T07:36:00.454Z"}],"comments":[{"_id":"65fc25fc6909332df1650070","commentBy":{"_id":"656ba638835d37c991fbf7e8","username":"S33dedL0rdz","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-12-02T21:48:40.351Z","lastActive":"2024-04-10T13:16:49.142Z","status":"offline","id":"656ba638835d37c991fbf7e8"},"text":"It Might seem not to work but it will, auto parry","createdAt":"2024-03-21T12:20:12.210Z","edited":true,"likeCount":1