{"slug":"Universal-Script-OP-best-Edge-jump-GOAT-FOR-OBBIES-72925","_id":"6934260cb27af85c809dcac9","title":"OP best Edge jump GOAT FOR OBBIES","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"OPEN SOURCE\nPERFECTLY EDGE JUMP\nBETTER THAN INFINITE YIELD EDGE JUMP (Iy's edge jump makes you jump mid air, bannable)\nSUPPORTS:\nLADDER\nSLOPE\nSWIMMING\nTRIP\nR15/R6","tags":[],"script":"--OPEN SOURCE ALL TIME\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function setup(char)\n    local humanoid = char:WaitForChild(\"Humanoid\")\n    local root = char:WaitForChild(\"HumanoidRootPart\")\n\n    local dropHeight = 14\n    local jumpCooldown = 0.000001\n    local lastJump = 0\n\n    local params = RaycastParams.new()\n    params.FilterType = Enum.RaycastFilterType.Exclude\n\n    RunService.RenderStepped:Connect(function()\n        if humanoid.Parent ~= char then return end\n        if humanoid:GetState() == Enum.HumanoidStateType.Climbing then return end\n        if humanoid.MoveDirection.Magnitude < 0.1 then return end\n        if tick() - lastJump < jumpCooldown then return end\n\n        params.FilterDescendantsInstances = { char }\n\n        local footOffset = root.CFrame.RightVector * 1.2\n        local down = Vector3.new(0, -dropHeight, 0)\n        local base = root.Position - Vector3.new(0, humanoid.HipHeight, 0)\n\n        local left = workspace:Raycast(base + footOffset, down, params)\n        local right = workspace:Raycast(base - footOffset, down, params)\n\n        if not left and not right and root.Velocity.Y <= 0 then\n            humanoid.Jump = true\n            lastJump = tick()\n        end\n    end)\nend\n\nplayer.CharacterAdded:Connect(setup)\nif player.Character then setup(player.Character) end\n","owner":{"_id":"6910bfe129cba83e8296bf84","username":"Valzx","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/8957a66c022f1a30915c1ebc0e69d968368abcfaafb3c810e1173cea8461e59a.webp","original":"https://scriptblox.com/images/photo/6910bfe129cba83e8296bf84-1762705456704.jpg"},"status":"offline","id":"6910bfe129cba83e8296bf84","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/8957a66c022f1a30915c1ebc0e69d968368abcfaafb3c810e1173cea8461e59a.webp","original":"https://scriptblox.com/images/photo/6910bfe129cba83e8296bf84-1762705456704.jpg"}},"verified":false,"views":1565,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/b40503987b64db1bc2bb19e934842b24f2bf4493d22baaf783dd8ac6d73d4e10.webp","original":"https://scriptblox.com/images/sb/0-1765025292719.jpg","scriptblox":"https://scriptblox.com/images/script/0-1765025292719.jpg"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-12-06T12:48:12.733Z","executes":155,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:37:10.643Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/b40503987b64db1bc2bb19e934842b24f2bf4493d22baaf783dd8ac6d73d4e10.webp","original":"https://scriptblox.com/images/sb/0-1765025292719.jpg","scriptblox":"https://scriptblox.com/images/script/0-1765025292719.jpg"},"changelog":[{"_id":"6934260cb27af85c809dcacb","editBy":{"_id":"6910bfe129cba83e8296bf84","username":"Valzx","status":"offline","id":"6910bfe129cba83e8296bf84"},"message":"Create script","createdAt":"2025-12-06T12:48:12.737Z"}],"comments":[{"_id":"6934265224d3178d6dcb7adc","commentBy":{"_id":"65748a1c06ff53dbd23f193e","username":"hi_hi_hi","verified":fals