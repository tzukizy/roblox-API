{"_id":"69079d1a796d6aaf3c2b672c","title":"hitbox expender (head)","game":{"_id":"68718783e35839cbda7d0e98","gameId":10165583746,"name":"Examination","imageUrl":{"url":"https://media.kocakz.me/89b7967a59626f8c481f9e1e993a703259923d0bea4da3fdf45d4516b97566c4.webp","original":"https://tr.rbxcdn.com/180DAY-2b21d6d9f8859e19bdb3fe5583cd3eba/150/150/Image/Png/noFilter"},"slug":"10165583746-examination","path":"/game/10165583746-examination","thumbnail":{"url":"https://media.kocakz.me/89b7967a59626f8c481f9e1e993a703259923d0bea4da3fdf45d4516b97566c4.webp","original":"https://tr.rbxcdn.com/180DAY-2b21d6d9f8859e19bdb3fe5583cd3eba/150/150/Image/Png/noFilter"},"placeId":10165583746},"slug":"Examination-Hitbox-expender-62674","verified":false,"key":false,"keyless":false,"views":6566,"executes":28650,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/808e75e06f58944af8ed72aa7affc2d939104873cf87d3ebbd1af1bcd5bbd84e.webp","original":"https://scriptblox.com/images/sb/10165583746-1762106650785.png","scriptblox":"https://scriptblox.com/images/script/10165583746-1762106650785.png"},"thumbnail":{"url":"https://media.kocakz.me/808e75e06f58944af8ed72aa7affc2d939104873cf87d3ebbd1af1bcd5bbd84e.webp","original":"https://scriptblox.com/images/sb/10165583746-1762106650785.png","scriptblox":"https://scriptblox.com/images/script/10165583746-1762106650785.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-02T18:04:10.829Z","updatedAt":"2025-11-02T18:04:10.829Z","lastBump":"2025-11-02T18:04:10.829Z","script":"local Workspace = game:GetService(\"Workspace\")\nlocal Players = game:GetService(\"Players\")\n\nlocal function isPlayerCharacter(model)\n    if not model or not model:IsA(\"Model\") then return false end\n    return Players:GetPlayerFromCharacter(model) ~= nil\nend\n\nlocal function isHumanoidModel(model)\n    if not model or not model:IsA(\"Model\") then return false end\n    return model:FindFirstChildWhichIsA(\"Humanoid\") ~= nil\nend\n\nlocal function applyToPart(part)\n    if not part or not part:IsA(\"BasePart\") then return end\n    if part.Name ~= \"Head\" then return end\n\n    local model = part.Parent\n    if isHumanoidModel(model) and not isPlayerCharacter(model) then\n        pcall(function()\n            part.Size = Vector3.new(4, 4, 4)\n            part.CanCollide = false\n            part.Transparency = 0.5\n        end)\n    end\nend\n\nlocal function watchNameChanges(part)\n    if not part or not part:IsA(\"BasePart\") then return end\n    part:GetPropertyChangedSignal(\"Name\"):Connect(function()\n        applyToPart(part)\n    end)\nend\n\nfor _, desc in ipairs(Workspace:GetDescendants()) do\n    applyToPart(desc)\n    if desc:IsA(\"BasePart\") then\n        watchNameChanges(desc)\n    end\nend\n\nWorkspace.DescendantAdded:Connect(function(desc)\n    applyToPart(desc)\n    if desc:IsA(\"BasePart\") then\n        watchNameChanges(desc)\n    end\nend)","features":"Head expender","tags":["hitbox expender head"],"discord":"","keyLink":"","owner":{"_id":"68f8cd44a9328457b1afc995","username":"Fun_Skip","verified":false,"profilePicture":{"url":"https://media.kocakz.me/921610d0db61ef8e64ff97bdd8550984f0a3f7f0eb1e0210fdcc5e680d9d8938.webp","original":"https://scriptblox.com/images/photo/68f8cd44a9328457b1afc995-1764764130330.png"},"status":"offline","id":"68f8cd44a9328457b1afc995","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/921610d0db61ef8e64ff97bdd8550984f0a3f7f0eb1e0210fdcc5e680d9d8938.webp","original":"https://scriptblox.com/images/photo/68f8cd44a9328457b1afc995-1764764130330.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:46:27.825Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69079d1a796d6