{"_id":"68661ed89febb50fe7d5f3f4","title":"Anti Water","game":{"_id":"67e5e1ffb360710ec3c78668","gameId":12998806177,"name":"Kill Streak  ","imageUrl":{"url":"https://media.kocakz.me/05e484b06ff294984b65a76b1cfa06f7e4fb8659474e5ef407ad50dd4f708db0.webp","original":"https://tr.rbxcdn.com/180DAY-d7ade5154e46ea81438b4feb41ccb291/150/150/Image/Png/noFilter"},"slug":"12998806177-kill-streak","path":"/game/12998806177-kill-streak","thumbnail":{"url":"https://media.kocakz.me/05e484b06ff294984b65a76b1cfa06f7e4fb8659474e5ef407ad50dd4f708db0.webp","original":"https://tr.rbxcdn.com/180DAY-d7ade5154e46ea81438b4feb41ccb291/150/150/Image/Png/noFilter"},"placeId":12998806177},"slug":"Kill-Streak-Kill-Streak-Anti-Water-43777","verified":false,"key":false,"keyless":false,"views":8938,"executes":2180,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5f2b654a74adcc46efc5fd42e5e81b654a12d7e5c8935e09bb3d4a331b3ae85c.webp","original":"https://scriptblox.com/images/sb/rbx-767df4a1914bdbac41e972b223c4db9f-22127948145b.png","scriptblox":"https://scriptblox.com/images/script/rbx-767df4a1914bdbac41e972b223c4db9f-22127948145b.png"},"thumbnail":{"url":"https://media.kocakz.me/5f2b654a74adcc46efc5fd42e5e81b654a12d7e5c8935e09bb3d4a331b3ae85c.webp","original":"https://scriptblox.com/images/sb/rbx-767df4a1914bdbac41e972b223c4db9f-22127948145b.png","scriptblox":"https://scriptblox.com/images/script/rbx-767df4a1914bdbac41e972b223c4db9f-22127948145b.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-07-03T06:10:32.712Z","updatedAt":"2025-07-03T06:10:32.712Z","lastBump":"2025-07-03T06:10:32.712Z","script":"-- Set starting coordinates for the central part\nlocal x = 1795\nlocal y = 14\nlocal z = 8\n\n-- Size of each segment and number of segments for the infinite effect\nlocal segmentLength = 500\nlocal segmentWidth = 500\nlocal numSegments = 100 -- Increase this for a longer effect\n\n-- Function to create an invisible \"paper-thin\" part\nlocal function createPaperThinSegment(posX, posY, posZ)\n    local part = Instance.new(\"Part\")\n    part.Size = Vector3.new(segmentLength, 0.1, segmentWidth) -- Paper-thin height\n    part.Position = Vector3.new(posX, posY, posZ)\n    part.Anchored = true\n    part.Transparency = 1 -- Invisible\n    part.CanCollide = true\n    part.Parent = game.Workspace\nend\n\n-- Create segments to the right and left to simulate an \"infinite\" 2D plane\nfor i = 0, numSegments do\n    createPaperThinSegment(x + (i * segmentLength), y, z) -- Right side\n    createPaperThinSegment(x - (i * segmentLength), y, z) -- Left side\nend","features":"Just Makes it so you cant die from the water","tags":[],"discord":"","keyLink":"","owner":{"_id":"6692f3a09b1cb583d419f497","username":"StarProjectz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/317bd5f27ff7b39679262efdea7c9365d77cd4fba9015824d771eea031337fe2.webp","original":"https://scriptblox.com/images/photo/6692f3a09b1cb583d419f497-1720906768514.png"},"status":"offline","id":"6692f3a09b1cb583d419f497","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/317bd5f27ff7b39679262efdea7c9365d77cd4fba9015824d771eea031337fe2.webp","original":"https://scriptblox.com/images/photo/6692f3a09b1cb583d419f497-1720906768514.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:46:47.730Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68661ed89febb50fe7d5f3f6","editBy":{"_id":"6692f3a09b1cb583d419f497","username":"StarProjectz","status":"offline","id":"6692f3a09b1cb583d419f497"},"message":"Create script","createdAt":"2025-07-03T06:10:32.715Z"}],"comments":[]}