()) do\n        if tool:IsA(\"Tool\") and tool:FindFirstChild(\"Scripts\") then\n            local scripts = tool.Scripts\n\n            pcall(function()\n                if scripts:FindFirstChild(\"Shake\") then\n                    scripts.Shake:FireServer()\n                end\n            end)\n\n            pcall(function()\n                if scripts:FindFirstChild(\"Collect\") then\n                    scripts.Collect:InvokeServer(unpack(args))\n                end\n            end)\n\n            pcall(function()\n                if scripts:FindFirstChild(\"Pan\") then\n                    scripts.Pan:InvokeServer()\n                end\n            end)\n        end\n    end\n\n    wait(0.5)\nend","features":"Auto shake, Pan, sand","tags":["Auto","Prospecting"],"discord":"","keyLink":"","owner":{"_id":"6541b02f6817a65ee628a47e","username":"Kuroyami","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8e5601fa0b7452c03f70cff826eebc1e935af9d417516420000e3ad2227cb932.webp","original":"https://scriptblox.com/images/photo/6541b02f6817a65ee628a47e-1760894395597.jpg"},"lvl":12,"status":"offline","id":"6541b02f6817a65ee628a47e","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/8e5601fa0b7452c03f70cff826eebc1e935af9d417516420000e3ad2227cb932.webp","original":"https://scriptblox.com/images/photo/6541b02f6817a65ee628a47e-1760894395597.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:58:21.153Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6879dab11e65d03dfedd3b75","editBy":{"_id":"6541b02f6817a65ee628a47e","username":"Kuroyami","status":"offline","id":"6541b02f6817a65ee628a47e"},"message":"Create script","createdAt":"2025-07-18T05:25:05.705Z"}],"comments":[]}