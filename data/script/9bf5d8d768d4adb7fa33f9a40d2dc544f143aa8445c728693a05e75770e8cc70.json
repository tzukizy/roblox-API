{"slug":"Prospecting!-auto-shake-auto-pan-auto-sand-open-source-45292","_id":"6879dab11e65d03dfedd3b73","title":"auto shake auto pan auto sand open source","game":{"_id":"6879dab11e65d03dfedd3b66","gameId":129827112113663,"name":"[UPD] Prospecting! 💎","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":129827112113663},"features":"Auto shake, Pan, sand","tags":["Auto","Prospecting"],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal args = {1}\n\nwhile true do\n    local character = player.Character or player.CharacterAdded:Wait()\n\n    for _, tool in pairs(character:GetChildren()) do\n        if tool:IsA(\"Tool\") and tool:FindFirstChild(\"Scripts\") then\n            local scripts = tool.Scripts\n\n            pcall(function()\n                if scripts:FindFirstChild(\"Shake\") then\n                    scripts.Shake:FireServer()\n                end\n            end)\n\n            pcall(function()\n                if scripts:FindFirstChild(\"Collect\") then\n                    scripts.Collect:InvokeServer(unpack(args))\n                end\n            end)\n\n            pcall(function()\n                if scripts:FindFirstChild(\"Pan\") then\n                    scripts.Pan:InvokeServer()\n                end\n            end)\n        end\n    end\n\n    wait(0.5)\nend","owner":{"_id":"6541b02f6817a65ee628a47e","username":"Kuroyami","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/8e5601fa0b7452c03f70cff826eebc1e935af9d417516420000e3ad2227cb932.webp","original":"https://scriptblox.com/images/photo/6541b02f6817a65ee628a47e-1760894395597.jpg"},"status":"offline","id":"6541b02f6817a65ee628a47e","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/8e5601fa0b7452c03f70cff826eebc1e935af9d417516420000e3ad2227cb932.webp","original":"ht