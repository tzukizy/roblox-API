{"_id":"692c4d46898c71d78e1c085b","title":"Find the aura script","game":{"_id":"67e5e1ffb360710ec3c77d38","gameId":17589670912,"name":"Find The Auras [650]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"17589670912-find-the-auras","path":"/game/17589670912-find-the-auras","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":17589670912},"slug":"Find-The-Auras-630-Find-the-aura-scirip-71381","verified":false,"key":false,"keyless":false,"views":2719,"executes":1180,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/02781485b1ce59b3e9a3f675c46307b87cbc8d4d932973e4ece560611f086b41.webp","original":"https://scriptblox.com/images/sb/17589670912-1764511046885.jpg","scriptblox":"https://scriptblox.com/images/script/17589670912-1764511046885.jpg"},"thumbnail":{"url":"https://media.kocakz.me/02781485b1ce59b3e9a3f675c46307b87cbc8d4d932973e4ece560611f086b41.webp","original":"https://scriptblox.com/images/sb/17589670912-1764511046885.jpg","scriptblox":"https://scriptblox.com/images/script/17589670912-1764511046885.jpg"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-11-30T13:57:26.913Z","updatedAt":"2025-11-30T13:57:26.913Z","lastBump":"2025-11-30T13:57:26.913Z","script":"--// if ur the dev dw i still gon find method to make stuff for ur game\n\nlocal OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/NymeraAnHomie/Library/refs/heads/main/OrionLib/Source.lua')))()\n\nOrionLib.SelectedTheme = \"Eclipse\"\n\nlocal Window = OrionLib:MakeWindow({\n    Name = \"Find the Aura\",\n    HidePremium = false,\n    SaveConfig = true,\n    ConfigFolder = \"findtheaura\",\n    IntroEnabled = false\n})\n\nlocal Tab = Window:MakeTab({\n    Name = \"Teleport\",\n    Icon = \"rbxassetid://4483345998\",\n    PremiumOnly = false\n})\n\nlocal SelectedObject\nlocal DropdownOptions = {}\nlocal YOffset = 5\n\nfor _, obj in pairs(game:GetService(\"Workspace\").Morphs:GetChildren()) do\n    table.insert(DropdownOptions, obj.Name)\nend\n\nlocal Dropdown = Tab:AddDropdown({\n    Name = \"Select Object\",\n    Default = \"\",\n    Options = DropdownOptions,\n    Callback = function(Value)\n        SelectedObject = game:GetService(\"Workspace\").Morphs:FindFirstChild(Value)\n    end\n})\n\nTab:AddTextbox({\n    Name = \"Search Object\",\n    Default = \"\",\n    TextDisappear = true,\n    Callback = function(Value)\n        local filteredOptions = {}\n        for _, obj in pairs(game:GetService(\"Workspace\").Morphs:GetChildren()) do\n            if string.find(string.lower(obj.Name), string.lower(Value)) then\n                table.insert(filteredOptions, obj.Name)\n            end\n        end\n        Dropdown:Refresh(filteredOptions, true)\n        if #filteredOptions > 0 then\n            SelectedObject = game:GetService(\"Workspace\").Morphs:FindFirstChild(filteredOptions[1])\n            Dropdown:Set(filteredOptions[1])\n        else\n            SelectedObject = nil\n        end\n    end\n})\n\nTab:AddButton({\n    Name = \"Teleport\",\n    Callback = function()\n        if SelectedObject and SelectedObject:IsA(\"BasePart\") then\n            local player = game.Players.LocalPlayer\n            local rootPart = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n            if rootPart then\n                rootPart.CFrame = SelectedObject.CFrame + Vector3.new(0, YOffset, 0)\n            end\n        else\n            OrionLib:MakeNotification({\n                Name = \"Error\",\n                Content = \"Invalid object selected!\",\n                Image = \"rbxassetid://4483345998\",\n                Time = 3\n            })\n        end\n    end\n})\n\nlocal IsMobile = OrionLib:WindowMobileToggle({})\nTab:AddLabel(IsMobile and \"Mobile Mode Enabled\" or \"PC Mode Enabled\")\n\nOrionLib:Init()","features":"Op auto find all aura\nNote: if you get tp to the void mean the aura can only be obtainable form quest or exclusive aura\nWorking on: delta codex krnl executor\nI haven't try on PC yet\nCredit:to the owner who made this script (I'm not made this)","tags":[],"discord":"","keyLink":"","owner":{"_id":"6921c86b1a3068896754781b","username":"Ghibah","verified":false,"profilePicture":{"url":"https://media.kocakz.me/76092f26f56e1870f0379033318ef333e6069610682aeec36c5f65ecc7b56094.webp","original":"https://scriptblox.com/images/photo/6921c86b1a3068896754781b-1763868697014.jpg"},"status":"offline","id":"6921c86b1a3068896754781b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/76092f26f56e1870f0379033318ef333e6069610682aeec36c5f65ecc7b56094.webp","original":"https://scriptblox.com/images/photo/6921c86b1a3068896754781b-1763868697014.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:38:29.768Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"692c4d46898c71d78e1c085d","editBy":{"_id":"6921c86b1a3068896754781b","username":"Ghibah","status":"offline","id":"6921c86b1a3068896754781b"},"message":"Create script","createdAt":"2025-11-30T13:57:26.921Z"}],"comments":[{"_id":"6937ed872127f38390a1b1f3","commentBy":{"_id":"6937ebe7f002b181cab3ed59","username":"laqueue","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-01-01T04:43:55.683Z","createdAt":"2025-12-09T09:29:11.482Z","status":"offline","id":"6937ebe7f002b181cab3ed59","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"for xeno the gui doesnt work","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-09T09:36:07.236Z","liked":false,"disliked":false},{"_id":"69392e7306da572cb7ec5d37","commentBy":{"_id":"6921c86b1a30