{"_id":"672d84ec7b00136ed677a904","title":"BunnyHop","game":{"_id":"67e5e1ffb360710ec3c77d96","gameId":10118559731,"name":"nico's nextbots 🌸  ","imageUrl":{"url":"https://media.kocakz.me/58aff20d6cafa2b1b32b5aca2993dd8fe58ff5a2093a406c59edd6fd664e906e.webp","original":"https://tr.rbxcdn.com/180DAY-6cfd96fd875014c6bcabdfba3c6d0acf/150/150/Image/Png/noFilter"},"slug":"10118559731-nico-s-nextbots","path":"/game/10118559731-nico-s-nextbots","thumbnail":{"url":"https://media.kocakz.me/58aff20d6cafa2b1b32b5aca2993dd8fe58ff5a2093a406c59edd6fd664e906e.webp","original":"https://tr.rbxcdn.com/180DAY-6cfd96fd875014c6bcabdfba3c6d0acf/150/150/Image/Png/noFilter"},"placeId":10118559731},"slug":"nico's-nextbots-BunnyHop-21840","verified":false,"key":false,"keyless":false,"views":21378,"executes":1360,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c0488f65085735286b4b67c2602a75d0ba24fe083b0f2c09ccc8b147f7acc00b.webp","original":"https://scriptblox.com/images/sb/10118559731-1731036396405.png","scriptblox":"https://scriptblox.com/images/script/10118559731-1731036396405.png"},"thumbnail":{"url":"https://media.kocakz.me/c0488f65085735286b4b67c2602a75d0ba24fe083b0f2c09ccc8b147f7acc00b.webp","original":"https://scriptblox.com/images/sb/10118559731-1731036396405.png","scriptblox":"https://scriptblox.com/images/script/10118559731-1731036396405.png"},"likeCount":3,"dislikeCount":2,"createdAt":"2024-11-08T03:26:36.463Z","updatedAt":"2024-11-08T03:26:36.463Z","lastBump":"2024-11-08T03:26:36.463Z","script":"-- Configuração de Auto Bunnyhop com GUI no Roblox (atualizado)\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\n\nlocal bunnyhopEnabled = false -- Estado inicial do Bunnyhop (desativado)\n\n-- Função para criar a GUI de Bunnyhop\nlocal function createGUI()\n    local screenGui = Instance.new(\"ScreenGui\")\n    local toggleButton = Instance.new(\"TextButton\")\n\n    -- Adicionando o ScreenGui ao PlayerGui\n    screenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\n    -- Configurando o Botão de Alternância\n    toggleButton.Parent = screenGui\n    toggleButton.Size = UDim2.new(0, 100, 0, 50)\n    toggleButton.Position = UDim2.new(0.1, 0, 0.1, 0)\n    toggleButton.Text = \"Bunnyhop: OFF\"\n    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho (desativado)\n\n    -- Função para alternar o Bunnyhop\n    toggleButton.MouseButton1Click:Connect(function()\n        bunnyhopEnabled = not bunnyhopEnabled\n        if bunnyhopEnabled then\n            toggleButton.Text = \"Bunnyhop: ON\"\n            toggleButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0) -- Verde (ativado)\n        else\n            toggleButton.Text = \"Bunnyhop: OFF\"\n            toggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Vermelho (desativado)\n        end\n    end)\nend\n\n-- Função para configurar o Bunnyhop rítmico\nlocal function setupBunnyhop()\n    humanoid.StateChanged:Connect(function(_, newState)\n        if bunnyhopEnabled and newState == Enum.HumanoidStateType.Landed then\n            wait(0.05) -- Intervalo curto para Bunnyhop rápido e preciso\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end)\nend\n\n-- Inicializa o GUI e Bunnyhop\ncreateGUI()\nsetupBunnyhop()\n\n-- Reconecta o GUI e o Bunnyhop ao renascer\nplayer.CharacterAdded:Connect(function(newCharacter)\n    character = newCharacter\n    humanoid = character:WaitForChild(\"Humanoid\")\n    createGUI()  -- Garante que o GUI seja recriado após renascer\n    setupBunnyhop() -- Configura o Bunnyhop novamente para o novo personagem\nend)","features":"Automatic BunnyHop Jump, you get more points and faster, Works on Mobile and PC, I don't know about PC, Good Luck! (I am Brazil)","tags":[],"discord":"","keyLink":"","owner":{"_id":"671bfe5fa749b30ec8fad7c7","username":"murillomirandar2008","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"671bfe5fa749b30ec8fad7c7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":1,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-23T01:23:02.844Z","last":"b","win":14,"math":4,"why":{"pa":1}},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52e44","editBy":{"_id":"671bfe5fa749b30ec8fad7c7","username":"murillomirandar2008","status":"offline","id":"671bfe5fa749b30ec8fad7c7"},"message":"Create script","createdAt":"2025-03-27T23:08:17.455Z"}],"comments":[{"_id":"672d851db499f2ddd6b6a669","commentBy":{"_id":"671bfe5fa749b30ec8fad7c7","username":"murillomirandar2008","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-10-25T20:23:59.870Z","lastActive":"2024-11-20T01:00:03.348Z","status":"offline","id":"671bfe5fa749b30ec8fad7c7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"(I'm sorry, I'm Brazil, 😅👍)","createdAt":"2024-11-08T03:27:25.004Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"672d8927a9d6ba29ed873c26","commentBy":{"_id":"66ea2cecee1749312e6812e3","username":"DumbRobloxUser","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/d0df5d2c2b7aeb105e6c19bfae6af65d8feae23b09ad0c667639c2c3017434a7.webp","original":"https://scriptblox.com/images/photo/66ea2cecee1749312e6812e3-1726623067830.png"},"createdAt":"2024-09-18T01:29:16.036Z","lastActive":"2026-01-20T14:07:23.249Z","status":"offline","id":"66ea2cecee1749312e6812e3","topMilestone":{"