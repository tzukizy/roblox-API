{"slug":"Wizard-Tycoon-2-Player-Rapid-Fire-15249","_id":"6686cce915d8ad8fba5527cc","title":"Rapid Fire","game":{"_id":"67e5e1ffb360710ec3c77f2b","gameId":281489669,"name":"Wizard Tycoon - 2 Player","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":281489669},"features":"- Fires really fast\n- Bullets are 8x faster\n- Bullets last basically forever","tags":[],"script":"_G.rapidfire = true\n\nlocal Players = game:GetService(\"Players\")\nlocal plr = Players.LocalPlayer\nlocal mouse = plr:GetMouse()\n\nwhile _G.rapidfire do\n    local Wand = plr.Character:FindFirstChild(\"Wand\")\n    if Wand then\n        local mousePos = mouse.Hit.Position\n        local aim = CFrame.new(plr.Character.HumanoidRootPart.Position, mousePos)\n\n        local args = {\n            [1] = aim,\n            [2] = 800,\n            [3] = 999,\n            [4] = Wand,\n            [5] = 15,\n            [6] = plr.Character\n        }\n\n        Wand.Fire:FireServer(unpack(args))\n    end\n    wait()\nend","owner":{"_id":"665b64ef70a0a42a69254eb3","username":"agreed","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98a2cc32959bd26038e591bd75fdf7aaa56af6932e185c7e5dcb2c7bdeffba3f.webp","original":"https://scriptblox.com/images/photo/665b64ef70a0a42a69254eb3-1732394080428.png"},"status":"offline","id":"665b64ef70a0a42a69254eb3","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/98a2cc32959bd26038e591bd75fdf7aaa56af6932e185c7e5dcb2c7bdeffba3f.webp","original":"https://scriptblox.com/images/photo/665b64ef70a0a42a69254eb3-1732394080428.png"}},"verified":false,"keyLink":"","views":15660,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-04T16:25:13.189Z","dislikeCount":2,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.r