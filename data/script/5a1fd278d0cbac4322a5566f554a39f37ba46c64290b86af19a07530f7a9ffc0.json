{"slug":"Wizard-Tycoon-2-Player-Rapid-Fire-15249","_id":"6686cce915d8ad8fba5527cc","title":"Rapid Fire","game":{"_id":"67e5e1ffb360710ec3c77f2b","gameId":281489669,"name":"Wizard Tycoon - 2 Player","imageUrl":"/images/sb/rbx-4d2ad7018c540b79253479a61b1bf71e-69ca567969ce.png","placeId":281489669},"features":"- Fires really fast\n- Bullets are 8x faster\n- Bullets last basically forever","tags":[],"script":"_G.rapidfire = true\n\nlocal Players = game:GetService(\"Players\")\nlocal plr = Players.LocalPlayer\nlocal mouse = plr:GetMouse()\n\nwhile _G.rapidfire do\n    local Wand = plr.Character:FindFirstChild(\"Wand\")\n    if Wand then\n        local mousePos = mouse.Hit.Position\n        local aim = CFrame.new(plr.Character.HumanoidRootPart.Position, mousePos)\n\n        local args = {\n            [1] = aim,\n            [2] = 800,\n            [3] = 999,\n            [4] = Wand,\n            [5] = 15,\n            [6] = plr.Character\n        }\n\n        Wand.Fire:FireServer(unpack(args))\n    end\n    wait()\nend","owner":{"_id":"665b64ef70a0a42a69254eb3","username":"agreed","verified":true,"profilePicture":"/images/photo/665b64ef70a0a42a69254eb3-1732394080428.png","status":"offline","id":"665b64ef70a0a42a69254eb3","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"keyLink":"","views":15648,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-04T16:25:13.189Z","dislikeCount":2,"likeCount":2,"image":"https://tr.rbxcdn.com/1be544052cb9a00a432831a8ba00b0a7/500/280/Image/Jpeg","executes":1853,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c51442","editBy":{"_id":"665b64ef70a0a42a69254eb3","username":"agreed","status":"offline","id":"665b64ef70a0a42a69254eb3"},"message":"Create script","createdAt":"2025-03-27T19:18:05.965Z"}],"comments":[{"_id":"6904b32ad2aad229554df3b0","commentBy":{"_id":"67a764dbad43c27089ae1cf5","username":"evgen