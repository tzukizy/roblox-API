{"_id":"692b32bcab9871c187605021","title":"negative effect toggle universal open source","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/964824e3a784ce73cac3885bf216469b9b4f7b660baeaee7bed825c7328a7d03.webp","original":"https://scriptblox.com/images/sb/0-1764438716008.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/964824e3a784ce73cac3885bf216469b9b4f7b660baeaee7bed825c7328a7d03.webp","original":"https://scriptblox.com/images/sb/0-1764438716008.png"},"placeId":0},"slug":"Universal-Script-negative-effect-toggle-universal-open-source-71120","verified":false,"key":false,"keyless":false,"views":259,"executes":89,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/bf8ad88f9c2f77178d8eee2186cf73f6c0e103ff57a8bce403bb2b2d5bcc5935.webp","original":"https://scriptblox.com/images/sb/0-1764438716008.png","scriptblox":"https://scriptblox.com/images/script/0-1764438716008.png"},"thumbnail":{"url":"https://media.kocakz.me/bf8ad88f9c2f77178d8eee2186cf73f6c0e103ff57a8bce403bb2b2d5bcc5935.webp","original":"https://scriptblox.com/images/sb/0-1764438716008.png","scriptblox":"https://scriptblox.com/images/script/0-1764438716008.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-29T17:51:56.028Z","updatedAt":"2025-11-29T17:51:56.028Z","lastBump":"2025-11-29T17:51:56.028Z","script":"local Lighting = game:GetService(\"Lighting\")\n\n-- Crear los 2 efectos de ColorCorrection\nlocal invert1 = Instance.new(\"ColorCorrectionEffect\")\ninvert1.Name = \"Invert1\"\ninvert1.Parent = Lighting\ninvert1.Contrast = -1\ninvert1.Saturation = 0\ninvert1.Brightness = 0\n\nlocal invert2 = Instance.new(\"ColorCorrectionEffect\")\ninvert2.Name = \"Invert2\"\ninvert2.Parent = Lighting\ninvert2.Contrast = -1\ninvert2.Saturation = 0\ninvert2.Brightness = 0\n\n-- Toggle GUI\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.ResetOnSpawn = false   -- <<--- lo que pediste\nscreenGui.Name = \"InvertToggleGUI\"\nscreenGui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\")\n\nlocal toggleBtn = Instance.new(\"TextButton\")\ntoggleBtn.Size = UDim2.new(0,50,0,50)\ntoggleBtn.Position = UDim2.new(0,20,0,20)\ntoggleBtn.Text = \"Toggle Invert\"\ntoggleBtn.Parent = screenGui\ntoggleBtn.Draggable = true\n\nlocal enabled = true\n\ntoggleBtn.MouseButton1Click:Connect(function()\n\n\t-- multiplicar por -1 elimina bugs visuales\n\tinvert1.Contrast = invert1.Contrast * -1\n\tinvert2.Contrast = invert2.Contrast * -1\n\n\tenabled = not enabled\n\tinvert1.Enabled = enabled\n\tinvert2.Enabled = enabled\nend)","features":"makes the entire world have negative colors and with a toggle button draggable open source MADE WITH CHATGPT","tags":["negative colors","negative","colors"],"discord":"","keyLink":"","owner":{"_id":"6919ff0e47c8b83f1bcab47b","username":"owlguy17","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c20800025a2a680af953ff81115ed6d5373e038aab87eb35b8ed612192c765f5.webp","original":"https://scriptblox.com/images/photo/6919ff0e47c8b83f1bcab47b-1770843956742.jpg"},"status":"offline","id":"6919ff0e47c8b83f1bcab47b","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/c20800025a2a680af953ff81115ed6d5373e038aab87eb35b8ed612192c765f5.webp","original":"https://scriptblox.com/images/photo/6919ff0e47c8b83f1bcab47b-1770843956742.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:29:42.636Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"692b32bcab9871c187605023","editBy":{"_id":"6919ff0e47c8b83f1bcab47b","username":"owlguy17","status":"offline"