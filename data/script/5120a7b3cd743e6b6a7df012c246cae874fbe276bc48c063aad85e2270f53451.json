frame\n\nlocal unAscendButton = Instance.new(\"TextButton\")\nunAscendButton.Text = \"UnAscend\"\nunAscendButton.Size = UDim2.new(0, 80, 0, 40)\nunAscendButton.Position = UDim2.new(0.6, 0, 0.5, -20)\nunAscendButton.Parent = frame\n\nlocal ascendVelocity = Vector3.new(0, 2, 0)\nlocal bodyVelocity\n\nascendButton.MouseButton1Click:Connect(function()\n    local character = player.Character\n    if character then\n        local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n        if humanoid then\n            bodyVelocity = Instance.new(\"BodyVelocity\")\n            bodyVelocity.Velocity = ascendVelocity\n            bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0) -- Biarkan kekuatan vertikal tak terbatas\n            bodyVelocity.Parent = character.HumanoidRootPart\n        end\n    end\nend)\n\nunAscendButton.MouseButton1Click:Connect(function()\n    if bodyVelocity then\n        bodyVelocity:Destroy()\n    end\nend)","features":"This Script maded by Erfanhiro1 aka Galiska Youtube, And this gui can make you ascended and i mean there's 2 button, Its Ascend And UnAscend Enjoy it! (I hope an youtuber showcasing this)","tags":["Ascend","Heaven","Fly","Lil nas"],"discord":"","keyLink":"","owner":{"_id":"6623a93f2c09e948d91305fe","username":"Erfanhiro1","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6623a93f2c09e948d91305fe","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:09:46.335Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50b61","editBy":{"_id":"6623a93f2c09e948d91305fe","username":"Erfanhiro1","status":"offline","id":"6623a93f2c09e948d