er = players.LocalPlayer;\n\n-- script variables\nlocal skin_walkers = workspace.Runners.Skinwalkers;\nlocal shoot_remote = replicated_storage.Remotes.SniperShot;\nlocal store_remote = replicated_storage.Remotes.Store;\n\n-- functions\nlocal kill_player = function(player)\n    local head = player:FindFirstChild(\"Head\");\n    if (not head) then\n        return;\n    end;\n\n    -- variables\n    local head_position = head.Position;\n\n    -- auto shoot\n    if (getgenv().settings[\"auto_shoot\"]) then\n        shoot_remote:FireServer(head_position, head_position, head);\n    end;\n    \n    -- auto store\n    if (getgenv().settings[\"auto_store\"]) then\n        store_remote:FireServer(player);\n    end;\nend;\n\nfor _,v in skin_walkers:GetChildren() do\n    kill_player(v);\nend;\n\nskin_walkers.ChildAdded:Connect(kill_player);","features":"Auto Shoot & Auto Store SkinWalkers please comment any bugs so I can fix.","tags":["script","open source","opensource"],"discord":"","keyLink":"","owner":{"_id":"6340eade631041248b2afc4b","username":"Efial","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6340eade631041248b2afc4b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:49:16.846Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"682966a047c4ba573400f489","editBy":{"_id":"6340eade631041248b2afc4b","username":"Efial","status":"offline","id":"6340eade631041248b2afc4b"},"message":"Create script","createdAt":"2025-05-18T04:48:32.764Z"}],"comments":[{"_id":"6829e3038ec63ac5eadfe1f3","commentBy":{"_id":"680b10128335c1f5582d1033","username":"zjld","verified":false,"role":"user","profilePic