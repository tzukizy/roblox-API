{"slug":"NEW-BOSS!-Anime-Fighting-Simulator-Money-Autofarm-Anime-Fighting-4751","_id":"62f29b0c797de5f180f2c374","title":"Money Autofarm","game":{"_id":"67e5e1ffb360710ec3c77f4b","gameId":4042427666,"name":"NEW BOSS!😈 Anime Fighting Simulator","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":4042427666},"features":"+ Inf yen \n+ Inf Chikara\n(Disclaimer it does not give actual infinite but it gives a lot of yen and chikara)","tags":[],"script":"-- enter your own dungeon is better \n\nrepeat wait() until game:IsLoaded() and game.Players.LocalPlayer ~= nil and game.Players.LocalPlayer.Character ~= nil\nlocal plr = game.Players.LocalPlayer\nlocal dung = {7220975160,7220986579}\ngetgenv().amount = 15 -- lower this if ur lagging\n\nif not table.find(dung,game.PlaceId) then\n    game:GetService(\"TeleportService\"):Teleport(dung[math.random(1,#dung)])\n    return\nend\nrepeat wait() until plr.PlayerGui ~= nil and plr.PlayerGui.Main ~= nil and plr.PlayerGui.Main.Notifs ~= nil\ngame.Players.LocalPlayer.PlayerGui.Main.Notifs:Destroy()\nrepeat wait() until workspace.MouseIgnore ~= nil\nworkspace.MouseIgnore:Destroy()\nwhile true do\n    for i = 1,getgenv().amount do\n        task.spawn(function()\n            game:GetService(\"ReplicatedStorage\").RSPackage.Events.GeneralFunction:InvokeServer(\"LotteryRandomDraw\")\n        end)\n        task.spawn(function()\n            game:GetService(\"ReplicatedStorage\").RSPackage.Events.GeneralEvent:FireServer(\"SpinFinished\")\n        end)\n    end\n    task.wait()\nend","owner":{"_id":"620644a20419909dd6f9cdde","username":"zenya","verified":false,"profilePicture":{"url":"https://media.kocakz.me/44747cd5d8c2ed1b616bb583ba888ae5d62e33dc425def8ff1e7accb66aa3d86.webp","original":"https://scriptblox.com/images/photo/620644a20419909dd6f9cdde-1743207307219.jpg"},"status":"offline","id":"620644a20419909dd6f9cdde","topMilestone":{"ke