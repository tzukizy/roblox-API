{"slug":"Universal-Script-Chill-guy-script-FE-31918","_id":"67d37c35ea8e2711ef086cba","title":"Chill guy script FE","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"It well.. it just make you a chill guy..","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal rotationSpeed = 1 -- Adjust the speed of rotation\nlocal radius = 5 -- Distance from the center point\n\nwhile true do\n    for angle = 0, 360, rotationSpeed do\n        local radians = math.rad(angle)\n        local x = math.cos(radians) * radius\n        local z = math.sin(radians) * radius\n        humanoidRootPart.Position = humanoidRootPart.Position + Vector3.new(x, 0, z)\n        wait(0.1) -- Adjust the wait time for smoother or faster rotation\n    end\nend\n","owner":{"_id":"67b657fbfe85e7185612af5e","username":"geolev3","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67b657fbfe85e7185612af5e","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":5725,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-14T00:45:41.822Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://media.kocakz.me/006b5d0d95eb663629d8f85ff8310870408ade16af962e243b83d77d4a11b8cb.webp","original":"https://scriptblox.com/images/sb/9676038-1741913141760.png","scriptblox":"https://scriptblox.com/images/script/9676038-1741913141760.png"},"executes":66,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detecte