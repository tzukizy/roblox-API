{"slug":"The-Final-Nail-+-Gun-Mod-39556","_id":"68206e8ff17977d63728de6c","title":"Gun Mod","game":{"_id":"68206e8ff17977d63728de69","gameId":6675215258,"name":"The Final Nail +","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":6675215258},"features":"Makes your shit REALLY overpowered. Like overpowered.","tags":[],"script":"local FireRate = 0.01\nlocal BaseDamage = 10000\nlocal Spread = 5\nlocal Auto = true\n\nlocal Clips = math.huge\nlocal MaxClips = math.huge\nlocal AmmoPerClip = math.huge\n\nlocal Explosive = true\nlocal Radius = 25\nlocal Piercing = 100\nlocal Lifesteal = 100\nlocal Knockback = 100\nlocal FlamingBullet = true\n\nlocal Players = game:GetService(\"Players\")\nlocal lp = Players.LocalPlayer\n\nlocal function init(gun)\n    local Setting = gun and gun:WaitForChild(\"Setting\", 1)\n    if gun and gun:IsA(\"Tool\") and Setting then\n        local req = require(Setting)\n        req.FireRate = FireRate\n        req.Spread = Spread\n        req.Auto = true\n        req.Clips = Clips\n        req.MaxClips = MaxClips\n        req.ExplosiveEnabled = Explosive\n        req.Radius = Radius\n        req.Piercing = Piercing\n        req.Lifesteal = Lifesteal\n        req.Knockback = Knockback\n        req.FlamingBullet = FlamingBullet\n        req.AmmoPerClip = AmmoPerClip\n        req.BaseDamage = BaseDamage\n    end\nend\n\nfor _,v in pairs(lp.Backpack:GetChildren()) do\n    init(v)\nend\nfor _,v in pairs(lp.Character:GetChildren()) do\n    init(v)\nend\nlp.Backpack.ChildAdded:Connect(init)","owner":{"_id":"620b4026729d9f4c1fd2f981","username":"CatAutism","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/e9a6fecd5a72cb8e26696db44ed3dc3f088a53699862d45485e1c7a96a67bc3f.webp","original":"https://scriptblox.com/images/photo/620b4026729d9f4c1fd2f981-1693789040768.png"},"status":"offline","id":"620b4026729d9f4c1fd2f981","to