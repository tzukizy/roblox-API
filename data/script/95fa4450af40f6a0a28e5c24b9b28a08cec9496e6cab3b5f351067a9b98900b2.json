{"slug":"How-High-Can-You-Leap-In-A-Single-Jump-Auto-Squat-Open-Source-40008","_id":"6827afedfd574670d29a3cec","title":"Auto Squat Open Source","game":{"_id":"6823d75856e666d257da7532","gameId":107901997399037,"name":"[🎃] Highest Jump Ever?","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":107901997399037},"features":"Auto Finds the Squat Tool  Automatically looks for the \"Squat\" tool in ur backpack or character. No need to scroll around and search for it.\n\n Remote Detection It checks if the \"Squat\" RemoteEvent exists inside the tool. If it ain't there it throws a warning.\n\nCooldown Patch If there's any local cooldown on the tool, it tries to patch it out. Basically, it digs into the script and sets any cooldown timers to 0.\n\n15 Second Run Time It runs at max speed for 15 seconds and then chills out. u can obviously change that if you wanna go forever lol.\n\n Crash Warning Tbh, if this script is running wild, it might crash your game. Roblox servers sometimes be trippin when u spam that fast.","tags":["open source","auto","keyless"],"script":"local player = game.Players.LocalPlayer\nlocal tool = player.Backpack:FindFirstChild(\"Squat\") or player.Character:FindFirstChild(\"Squat\")\nlocal remote = tool and tool:FindFirstChild(\"Squat\")\n\nif not (tool and remote and remote:IsA(\"RemoteEvent\")) then\n    return warn(\"Squat tool or RemoteEvent not found.\")\nend\n\nlocal localScript = tool:FindFirstChildOfClass(\"LocalScript\")\n\nif localScript and debug and debug.getupvalues and debug.setupvalue then\n    for _, func in pairs(getgc(true)) do\n        if type(func) == \"function\" and getfenv(func).script == localScript then\n            local ok, upvalues = pcall(debug.getupvalues, func)\n            if ok and upvalues then\n                for i, v in pairs(upvalues) do\n                    if type(v) == \"boolean\" and v == true then\n                        debug.setupvalue(func, i, false)\n                    elseif type(v) == \"number\" and v > 0 then\n                        debug.setupvalue(func, i, 0)\n                    end\n                end\n            end\n        end\n    end\nend\n\nlocal run = true\nspawn(function()\n    while run do\n        local success, err = pcall(function()\n            remote:FireServer()\n        end)\n        if not success then\n            run = false\n            break\n        end\n        task.wait(0.001)\n    end\nend)\n\ntask.delay(15, function()\n    run = false\nend)\n","owner":{"_id":"66c27c8ba6bcc14dc4657ff4","username":"YFMZombie","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/568ebb3d4730607ab6e340cf43d30fc12b5cce91f0c98538ab9db704b77c36fd.webp","original":"https://scriptblox.com/images/photo/66c27c8ba6bcc14dc4657ff4-1730557379001.png"},"status":"offline","id":"66c27c8ba6bcc14dc4657ff4","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/568ebb3d4730607ab6e340cf43d30fc12b5cce91f0c98538ab9db704b77c36fd.webp","original":"https://scriptblox.com/images/photo/66c27c8ba6bcc14dc4657ff4-1730557379001.png"}},"verified":false,"views":13461,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/c2d1741077b237c25476810c12ceace9287e4416d27251511238ca22bf4be0f6.webp","original":"https://scriptblox.com/images/sb/107901997399037-1747431405476.png","scriptblox":"https://scriptblox.com/images/script/107901997399037-1747431405476.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-05-16T21:36:45.549Z","executes":544,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:59:05.771Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/c2d1741077b237c2