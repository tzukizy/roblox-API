icatedStorage.Modules.Shared.RemoteService)\nlocal Cooldown = 0\n\nLocalPlayer.CharacterAdded:Connect(function(NewCharacter)\n    Character = NewCharacter\nend)\n\nRunService.RenderStepped:Connect(function(Delta)\n    if not Character then return end\n    local Targets = {}\n    for _, Mob in workspace.Mobs:GetDescendants() do\n        if Mob and Mob:FindFirstChild(\"Enemy\") and Mob:GetAttribute(\"Health\") and Mob:GetAttribute(\"Health\") > 0 and Mob:FindFirstChild(\"HumanoidRootPart\") and (Character.HumanoidRootPart.Position - Mob.HumanoidRootPart.Position).Magnitude < 250 then\n            table.insert(Targets, Mob)\n        end\n    end\n    if #Targets > 0 then\n        RemoteService:InvokeServer(\"Damage\",Targets)\n    end\nend)","features":"Best when used with ranged/magic/throwing weapons","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:50:16.134Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c83fd8ede9cc6ba7c213b6","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2025-09-15T16:33:28.874Z"},{"_id"