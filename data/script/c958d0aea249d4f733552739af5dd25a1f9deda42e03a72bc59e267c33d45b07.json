{"slug":"INFINITY-RPG-(REVAMPED)-Kill-Aura-53458","_id":"68c83fd8ede9cc6ba7c213b4","title":"Kill Aura","game":{"_id":"68c83fd8ede9cc6ba7c213b1","gameId":380305410,"name":"INFINITY RPG","imageUrl":"/images/sb/rbx-91ce274198511fe1637a00ccbaa8c9d8-4f3aec5be96b.png","placeId":380305410},"features":"Best when used with ranged/magic/throwing weapons","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal RemoteService = require(ReplicatedStorage.Modules.Shared.RemoteService)\nlocal Cooldown = 0\n\nLocalPlayer.CharacterAdded:Connect(function(NewCharacter)\n    Character = NewCharacter\nend)\n\nRunService.RenderStepped:Connect(function(Delta)\n    if not Character then return end\n    local Targets = {}\n    for _, Mob in workspace.Mobs:GetDescendants() do\n        if Mob and Mob:FindFirstChild(\"Enemy\") and Mob:GetAttribute(\"Health\") and Mob:GetAttribute(\"Health\") > 0 and Mob:FindFirstChild(\"HumanoidRootPart\") and (Character.HumanoidRootPart.Position - Mob.HumanoidRootPart.Position).Magnitude < 250 then\n            table.insert(Targets, Mob)\n        end\n    end\n    if #Targets > 0 then\n        RemoteService:InvokeServer(\"Damage\",Targets)\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":8776,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-ecfc199972f9b39859a4043ab75f1db5-fd3ff73bc2bd.png","likeCount":7,"dislikeCount":3,"createdAt":"2025-09-15T16:33:28.870Z","editBy":{"_id":"663f0f