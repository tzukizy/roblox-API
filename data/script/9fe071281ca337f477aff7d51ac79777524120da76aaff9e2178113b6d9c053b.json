rterGui:SetCore(\"ChatMakeSystemMessage\", {\n            Text = msgs[math.random(1,#msgs)],\n            Color = Color3.fromRGB(255,0,0),\n            Font = Enum.Font.SourceSansBold\n        })\n    end\nend)\n\n-- caméra qui tremble\nspawn(function()\n    local cam = workspace.CurrentCamera\n    while true do\n        wait(0.1)\n        cam.CFrame = cam.CFrame * CFrame.new(\n            math.random(-1,1)/10,\n            math.random(-1,1)/10,\n            0\n        )\n    end\nend)","features":"Jhghj","tags":[],"discord":"","keyLink":"","owner":{"_id":"69d3dee6b697067c2e886af7","username":"Pro360cool","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69d3dee6b697067c2e886af7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:39:13.817Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dfb2bd306e2a79e3d68cf1","editBy":{"_id":"69d3dee6b697067c2e886af7","username":"Pro360cool","status":"offline","id":"69d3dee6b697067c2e886af7"},"message":"Create script","createdAt":"2026-04-15T15:46:05.380Z"},{"_id":"69dfb40d068cdc92ac84b288","editBy":{"_id":"69d3dee6b697067c2e886af7","username":"Pro360cool","status":"offline","id":"69d3dee6b697067c2e886af7"},"message":"Update script","createdAt":"2026-04-15T15:51:41.698Z"}],"comments":[{"_id":"69dfb2e3ea07cb201ca8143a","commentBy":{"_id":"69d3dee6b697067c2e886af7","username":"Pro360cool","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-04-15T19:04:49.306Z","createdAt":"2026-04-06T16:27:18.672Z","status":"offline","id":"69d3dee6b697067c2e886af7","topMilestone":{