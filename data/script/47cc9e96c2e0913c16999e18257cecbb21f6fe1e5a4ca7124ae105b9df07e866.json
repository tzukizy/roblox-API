", \"Pistol\", \"RPG\", \"Revolver\", \"SA58\",\n    \"SawnOff\", \"Shotgun\", \"Uzi\"\n}\n\nlocal SwitchValue = true\n\nlocal SetSwitch = function(Gun)\n    if not Gun:IsA(\"Tool\") or not table.find(GunNames, Gun.Name) then return end\n\n    local Switch = Gun:FindFirstChild(\"Switch\") then\n  \n        Switch.Value = SwitchValue\n    end\nend\n\n\nlocal OnChildAdded = function(Child)\n    SetSwitch(Child)\nend\n\nPlayer.Backpack.ChildAdded:Connect(OnChildAdded)\n\nfor _, Object in ipairs(Player.Backpack:GetChildren()) do\n    SetSwitch(Object)\nend","features":"Basicly what is does is it triggers the BoolValue for the Switch (of the starter pistol) and its basicly you have G Switch but without really having it\n\nshould work every exploit\n\nONLY WORKS ON PISTOL (G17)","tags":[],"discord":"","keyLink":"","owner":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c7e7f0518d9a6fa042e7459ceef6258d16aacc0baea47017f8db17047ac34be7.webp","original":"https://scriptblox.com/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png"},"status":"offline","id":"66c63d08f2b2900a0fcb7b0a","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/c7e7f0518d9a6fa042e7459ceef6258d16aacc0baea47017f8db17047ac34be7.webp","original":"https://scriptblox.com/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:10:04.919Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c548ce","editBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","status":"offline","id":"66c63d08f2b2900a0fcb7b0a"},"message":"Create script","createdAt":"2025-03-27T22:27:16.193Z"}],"comments":[{"_id":"679f1148838723a30814952e","commentBy":{"_id":"67