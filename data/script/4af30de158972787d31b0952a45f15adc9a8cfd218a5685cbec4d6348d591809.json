     end\n    elseif checkpoint:IsA(\"BasePart\") then\n        h.CFrame = CFrame.new(checkpoint.Position + Vector3.new(0, 5, 0))\n        wait(0.07)\n    end\nend","features":"Just ez win - by Nescoroco.\n\nIt simply teleports to all the models inside Workspace/Checkpoints, with a speed of 0.07 to avoid bugs when obtaining the checkpoint.","tags":["Win","Script","Nescoroco","Auto","OP"],"discord":"https://discord.gg/XsyfvJrk4B","keyLink":"","owner":{"_id":"6928574f7c94f7b697a005a5","username":"Nesco","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ecd2b48fa9660341c9016ef7336bc642b4bbd5fc43b436af7f1a2adca9472ba9.webp","original":"https://scriptblox.com/images/photo/6928574f7c94f7b697a005a5-1764251754207.png"},"status":"offline","id":"6928574f7c94f7b697a005a5","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/ecd2b48fa9660341c9016ef7336bc642b4bbd5fc43b436af7f1a2adca9472ba9.webp","original":"https://scriptblox.com/images/photo/6928574f7c94f7b697a005a5-1764251754207.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:46:40.263Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69413ec59aa5db97af0b5fdf","editBy":{"_id":"6928574f7c94f7b697a005a5","username":"Nesco","status":"offline","id":"6928574f7c94f7b697a005a5"},"message":"Create script","createdAt":"2025-12-16T11:13:09.689Z"},{"_id":"6941e7f85d930bd43f5b0ac6","editBy":{"_id":"6928574f7c94f7b697a005a5","username":"Nesco","status":"offline","id":"6928574f7c94f7b697a005a5"},"message":"Update script","createdAt":"2025-12-16T23:15:04.996Z"}],"comments":[]}