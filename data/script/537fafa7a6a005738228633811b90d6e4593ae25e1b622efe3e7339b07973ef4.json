ut getting that ban. This can broke gui.\nThis is Dandy's world Survival. Don't misunderstood that it's dandy's world(not dws) script or use in whole different games.\nJust only use it in dws or else it will not working at all.","tags":[],"discord":"","keyLink":"","owner":{"_id":"6906207908acd387da0fae23","username":"Uhwhydanworld","verified":false,"profilePicture":{"url":"https://media.kocakz.me/397078a1b70c4866f5559d92e51ec05bb99c0336910597ac2eff0c782eac6caa.webp","original":"https://scriptblox.com/images/photo/6906207908acd387da0fae23-1770641633745.jpg"},"status":"offline","id":"6906207908acd387da0fae23","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/397078a1b70c4866f5559d92e51ec05bb99c0336910597ac2eff0c782eac6caa.webp","original":"https://scriptblox.com/images/photo/6906207908acd387da0fae23-1770641633745.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:34:39.166Z","last":"","win":14,"math":3},"isHub":true,"supportedGames":[{"_id":"690f5dfb57bb16813c3819fd","gameId":89431908884578,"placeId":89431908884578,"name":"dws","imageUrl":{"url":"https://media.kocakz.me/2339e859d288152a6cdca6c961303f20857518ab2437d120cac558d485912391.webp","original":"https://tr.rbxcdn.com/180DAY-950708626319e299abab674f3b11816b/480/270/GameIcon11/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/2339e859d288152a6cdca6c961303f20857518ab2437d120cac558d485912391.webp","original":"https://tr.rbxcdn.com/180DAY-950708626319e299abab674f3b11816b/480/270/GameIcon11/Png/noFilter"}}],"changelog":[{"_id":"695806b1d2a92a3bd75daefa","editBy":{"_id":"6906207908acd387da0fae23","username":"Uhwhydanworld","status":"offline","id":"6906207908acd387da0fae23"},"message":"Hi","createdAt":"2026-01-02T17:56:01.773Z"}],"comments":[{"_id":"6958071bd2a92a3bd75db755","commentBy":{"_id":"6906207908acd387