tes\nteleportToCoordinates(3803, 4, -224)","features":"Nothing","tags":[],"discord":"","keyLink":"","owner":{"_id":"6684f88ca5ae0d4edf1504be","username":"alexalexalex1234lol","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6684f88ca5ae0d4edf1504be","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:08:05.228Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53568","editBy":{"_id":"6684f88ca5ae0d4edf1504be","username":"alexalexalex1234lol","status":"offline","id":"6684f88ca5ae0d4edf1504be"},"message":"Create script","createdAt":"2025-03-26T23:32:45.330Z"}],"comments":[]}