{"slug":"Easy-Choose-The-Right-Path-Obby-Teleport-at-end-23759","_id":"6750a37aa9b2d9bd617ba089","title":"Teleport at end","game":{"_id":"67e5e1ffb360710ec3c78cdf","gameId":12824140164,"name":"Easy Choose The Right Path Obby","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":12824140164},"features":"Nothing","tags":[],"script":"-- Teleport script to coordinates 3803, 4, -224\n-- Make sure Delta Executor is open and the script is executed correctly.\n\nlocal player = game.Players.LocalPlayer -- Get the local player\nlocal character = player.Character or player.CharacterAdded:Wait() -- Wait for the character to load\n\n-- Teleport function\nlocal function teleportToCoordinates(x, y, z)\n    if character and character:FindFirstChild(\"HumanoidRootPart\") then\n        character.HumanoidRootPart.CFrame = CFrame.new(x, y, z)\n    else\n        warn(\"Character or HumanoidRootPart not found!\")\n    end\nend\n\n-- Teleport to the specified coordinates\nteleportToCoordinates(3803, 4, -224)","owner":{"_id":"6684f88ca5ae0d4edf1504be","username":"alexalexalex1234lol","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6684f88ca5ae0d4edf1504be","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":2643,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-12-04T18:46:18.440Z","dislikeCount":2,"likeCount":0,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-a938af31f381ff7ee39da569a7385cbf/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-a938af31f381ff7ee39da569a7385cbf/500/280/Image/Jpeg/noFilter"},"executes":5,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verd