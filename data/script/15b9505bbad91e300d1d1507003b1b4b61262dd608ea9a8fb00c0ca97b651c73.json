usiques en boucle\nlocal index = 1\nlocal function playNext()\n    Sound.SoundId = \"rbxassetid://\" .. playlist[index]\n    Sound:Play()\n    Sound.Ended:Connect(function()\n        index = index + 1\n        if index > #playlist then\n            index = 1\n        end\n        playNext()\n    end)\nend\n\nplayNext()","features":"Musique berry avenue française","tags":[],"discord":"","keyLink":"","owner":{"_id":"68c1c33896aa8f73dce31b32","username":"Raniabnh","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68c1c33896aa8f73dce31b32","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:55:23.463Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d9dee78ab7229d3c5eadf5","editBy":{"_id":"68c1c33896aa8f73dce31b32","username":"Raniabnh","status":"offline","id":"68c1c33896aa8f73dce31b32"},"message":"Create script","createdAt":"2025-09-29T01:20:39.914Z"}],"comments":[]}