racter:FindFirstChild(\"Humanoid\") and v.Character.Humanoid.Health > 0 and (v.Character:GetPivot().Position - local_player.Character:GetPivot().Position).Magnitude < settings.max_distance then\n                table.insert(targets, v.Character)\n            end\n        end\n\n        for _, v2 in next, targets do\n            local tool = local_player.Character and local_player.Character:FindFirstChildOfClass(\"Tool\")\n            if tool and tool:FindFirstChild(\"Handle\") and v2:FindFirstChildWhichIsA(\"BasePart\") then\n                tool:FindFirstChild(\"Use\"):FireServer()\n                firetouchinterest(tool.Handle, v2:FindFirstChildWhichIsA(\"BasePart\"), 0)\n                firetouchinterest(tool.Handle, v2:FindFirstChildWhichIsA(\"BasePart\"), 1)\n                task.wait()\n            end\n        end\n        task.wait()\n    until not settings.swing_aura\nend","features":"Made by @kylosilly\nMUST HOLD SWORD TO KILL ALL","tags":["Player Battle Tycoon","kill all","kill aura","script","troll"],"discord":"","keyLink":"","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:56:43.647Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6845b3cb887257f460408