{"slug":"Universal-Script-Vr7-HUB-206184","_id":"69ec72aeb0c9933aa6748006","title":"VR7 HUB V999","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"👑 VR7 HUB ULTRA v2.3 \nحماية فائقة ضد HD Admin وكل Ranks (0-5)\nإعلان فخم + Potato Hub + Wa7eed + Touch Fling\nسيرفر دائم | God Mode + Anti Fling + Anti Kick/Ban/Rank\nحماية قوية في أي ماب فيها أدمن 🔥","tags":[],"script":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\n--[[\n    💔 تم اعتزال اسكندراني 💔😔\n    بعد تعب اسكندراني سوا المستحين في الهاك وا الماب \n    صانع سكربتات دالتا وا مابات ادمن 💔😔\n    احب اقولكم اسكندراني اعتزل💔😔😩للءبدد😥\n]]\n\nif not game:IsLoaded() then game.Loaded:Wait() end\n\nlocal Players = game:GetService(\"Players\")\nlocal LP = Players.LocalPlayer\nlocal RS = game:GetService(\"RunService\")\nlocal TS = game:GetService(\"TeleportService\")\nlocal SG = game:GetService(\"StarterGui\")\nlocal CG = game:GetService(\"CoreGui\")\n\nlocal Stats = {Kicks = 0, Bans = 0, Ranks = 0, Remotes = 0, Total = 0, Fling = 0, Protects = 0}\n\nlocal function Notify(title, text, duration)\n    pcall(function()\n        SG:SetCore(\"SendNotification\", {\n            Title = title,\n            Text = text,\n            Duration = duration or 4\n        })\n    end)\nend\n\n-- ==================== LOAD NAMELESS ADMIN ====================\ntask.spawn(function()\n    pcall(function()\n        loadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Nameless-admin-v250-script-87765\"))()\n        Notify(\"⚡ NAMELESS ADMIN\", \"✅ Loaded Successfully!\\nPrefix: ;\", 6)\n    end)\nend)\n\n-- ==================== LOAD POTATO HUB ====================\ntask.spawn(function()\n    pcall(function()\n        loadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-POTATO-HUB-209233\"))()\n        Notify(\"🍠 POTATO HUB\", \"✅ Loaded Successfully!\", 4)\n    end)\nend)\n\n-- ==================== DESTROY HD ADMIN ====================\npcall(function()\n    for _, v in pairs(getgc(true)) do\n        if typeof(v) == \"table\" and (rawget(v, \"HDAdminMain\") or rawget(v, \"HDAdmin\")) then\n            v.HDAdminMain = nil\n            v.HDAdmin = nil\n        end\n    end\n    _G.HDAdminMain = nil\n    getgenv().HDAdminMain = nil\n    getgenv().HDAdmin = nil\nend)\n\n-- ==================== LOAD OTHER HUBS ====================\ntask.spawn(function()\n    task.wait(4)\n    pcall(function() loadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Wa7eed-67426\"))() end)\n    pcall(function() loadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-TOUCH-FLING-30401\"))() end)\nend)\n\n-- ==================== قائمة أوامر الأدمن (للحماية) ====================\nlocal AllAdminCommands = {\n    \"kick\",\"ban\",\"permban\",\"serverban\",\"globalban\",\"tempban\",\"unban\",\n    \"rank\",\"permrank\",\"temprank\",\"unrank\",\"setrank\",\"changerank\",\n    \"punish\",\"kill\",\"smite\",\"crash\",\"explode\",\"ff\",\"forcefield\",\n    \"jail\",\"freeze\",\"fling\",\"tp\",\"teleport\",\"bring\",\"to\",\"goto\",\"spectate\",\n    \"moderation\",\"admin\",\"owner\",\"headadmin\",\"giveadmin\",\"hwalk\",\"fly\",\n    \"noclip\",\"god\",\"invisible\"\n}\n\n-- ==================== ULTIMATE METATABLE PROTECTION ====================\npcall(function()\n    local mt = getrawmetatable(game)\n    local oldNC = mt.__namecall\n    setreadonly(mt, false)\n\n    mt.__namecall = newcclosure(function(self, ...)\n        local method = getnamecallmethod()\n        local args = {...}\n        local myName = LP.Name:lower()\n\n        -- Direct Kick / Ban Protection\n        if (method == \"Kick\" or method == \"Ban\") and self == LP then\n            Stats.Kicks += 1\n            Stats.Total += 1\n            Stats.Protects += 1\n            Notify(\"🚫 ULTIMATE BLOCK\", \"Direct Kick/Ban BLOCKED! 💀\", 2)\n            return nil\n        end\n\n        -- Remote Protection\n        if method == \"FireServer\" or method == \"InvokeServer\" then\n            local argStr = \"\"\n            for _, v in ipairs(args) do\n                if type(v) == \"string\" then\n                    argStr = argStr .. \" \" .. v:lower()\n                elseif type(v) == \"table\" then\n                    for _, val in pairs(v) do\n                        if type(val) == \"string\" then argStr = argStr .. \" \" .. val:lower() end\n                    end\n                end\n            end\n\n            if argStr:find(myName) or argStr:find(\"all\") or argStr:find(\"everyone\") or argStr:find(\"others\") or argStr:find(\"me\") then\n                for _, cmd in ipairs(AllAdminCommands) do\n                    if argStr:find(cmd) then\n                        if cmd:find(\"kick\") or cmd:find(\"ban\") then Stats.Bans += 1\n                        elseif cmd:find(\"rank\") then Stats.Ranks += 1\n                        else Stats.Remotes += 1 end\n                        \n                        Stats.Total += 1\n                        Stats.Protects += 1\n                        Notify(\"🛡️ ULTIMATE PROTECTION\", cmd:upper() .. \" BLOCKED!\", 2)\n                        return nil\n                    end\n                end\n            end\n        end\n\n        return oldNC(self, ...)\n    end)\n    setreadonly(mt, true)\nend)\n\n-- ==================== EXTRA PROTECTION ====================\npcall(function()\n    hookfunction(LP.Kick, function()\n        Stats.Kicks += 1\n        Notify(\"🚫 DIRECT KICK BLOCKED\", \"ULTIMATE PROTECTION ACTIVE!\", 2)\n        return nil\n    end)\n\n    TS.Teleport = function(...) return nil end\nend)\n\n-- ==================== GOD MODE + ANTI FLING ====================\nRS.Heartbeat:Connect(function()\n    pcall(function()\n        local char = LP.Character\n        if char then\n            local hum = char:FindFirstChildOfClass(\"Humanoid\")\n            local root = char:FindFirstChild(\"HumanoidRootPart\")\n            if hum then\n                hum.MaxHealth = math.huge\n                hum.Health = math.huge\n                hum.PlatformStand = false\n                hum.Sit = false\n            end\n            if root then\n                root.Anchored = false\n                root.CanCollide = true\n                local vel = root.Velocity\n                if vel.Magnitude > 60 then\n                    root.Velocity = Vector3.new(0, vel.Y, 0)\n                    Stats.Fling += 1\n                end\n            end\n        end\n    end)\nend)\n\n-- ==================== الإعلان الحزين الجديد 💔 ====================\ntask.spawn(function()\n    task.wait(3)\n    local Gui = Instance.new(\"ScreenGui\", CG)\n    Gui.Name = \"SadAnnouncement\"\n    Gui.ResetOnSpawn = false\n\n    local Frame = Instance.new(\"Frame\", Gui)\n    Frame.Size = UDim2.new(0, 600, 0, 450)\n    Frame.Position = UDim2.new(0.5, -300, 0.5, -225)\n    Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 25)\n    Frame.BorderSizePixel = 0\n    Instance.new(\"UICorner\", Frame).CornerRadius = UDim.new(0, 20)\n\n    -- حزين gradient\n    local Gradient = Instance.new(\"UIGradient\", Frame)\n    Gradient.Color = ColorSequence.new{\n        ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 20, 60)),\n        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(25, 15, 40)),\n        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 10, 30))\n    }\n    Gradient.Rotation = 45\n\n    -- عنوان حزين كبير\n    local Title = Instance.new(\"TextLabel\", Frame)\n    Title.Size = UDim2.new(1, -40, 0, 80)\n    Title.Position = UDim2.new(0, 20, 0, 20)\n    Title.BackgroundTransparency = 1\n    Title.Text = \"💔 تم اعتزال اسكندراني إلى الأبد 💔\"\n    Title.TextColor3 = Color3.fromRGB(220, 50, 50)\n    Title.Font = Enum.Font.GothamBlack\n    Title.TextSize = 32\n    Title.TextStrokeTransparency = 0\n    Title.TextStrokeColor3 = Color3.fromRGB(100, 20, 20)\n\n    -- نص حزين\n    local Desc = Instance.new(\"TextLabel\", Frame)\n    Desc.Size = UDim2.new(1, -40, 0, 120)\n    Desc.Position = UDim2.new(0, 20, 0, 110)\n    Desc.BackgroundTransparency = 1\n    Desc.Text = \"😔 بعد تعب اسكندراني سوا المستحيل في الهاك والماب\\nصانع سكربتات دالتا ومابات أدمن\\n💔 أحب أقولكم اسكندراني اعتزل للأبد 😩😥\"\n    Desc.TextColor3 = Color3.fromRGB(200, 180, 180)\n    Desc.Font = Enum.Font.Gotham\n    Desc.TextSize = 18\n    Desc.TextWrapped = true\n    Desc.TextStrokeTransparency = 0.5\n    Desc.TextStrokeColor3 = Color3.fromRGB(50, 30, 50)\n\n    -- قلب مكسور متحرك\n    local Heart = Instance.new(\"TextLabel\", Frame)\n    Heart.Size = UDim2.new(0, 100, 0, 100)\n    Heart.Position = UDim2.new(0.5, -50, 0, 250)\n    Heart.BackgroundTransparency = 1\n    Heart.Text = \"💔\"\n    Heart.TextColor3 = Color3.fromRGB(255, 100, 100)\n    Heart.Font = Enum.Font.SourceSans\n    Heart.TextSize = 80\n\n    -- تأثير نبض حزين للقلب\n    task.spawn(function()\n        while Heart.Parent do\n            for i = 1, 10 do\n                Heart.TextSize = 80 + (i * 2)\n                Heart.Position = UDim2.new(0.5, -50 - i, 0, 250 - i)\n                task.wait(0.05)\n            end\n            for i = 10, 1, -1 do\n                Heart.TextSize = 80 + (i * 2)\n                Heart.Position = UDim2.new(0.5, -50 - i, 0, 250 - i)\n                task.wait(0.05)\n            end\n        end\n    end)\n\n    -- زر الإغلاق ❌\n    local CloseBtn = Instance.new(\"TextButton\", Frame)\n    CloseBtn.Size = UDim2.new(0, 50, 0, 50)\n    CloseBtn.Position = UDim2.new(1, -60, 0, 15)\n    CloseBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)\n    CloseBtn.Text = \"❌\"\n    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\n    CloseBtn.Font = Enum.Font.GothamBold\n    CloseBtn.TextSize = 24\n    Instance.new(\"UICorner\", CloseBtn).CornerRadius = UDim.new(0, 12)\n    \n    -- تأثير hover للزر\n    CloseBtn.MouseEnter:Connect(function()\n        CloseBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)\n    end)\n    CloseBtn.MouseLeave:Connect(function()\n        CloseBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)\n    end)\n\n    CloseBtn.MouseButton1Click:Connect(function()\n        Gui:Destroy()\n    end)\n\n    -- تأثير دخول الإعلان\n    Frame.Size = UDim2.new(0, 0, 0, 0)\n    Frame.Position = UDim2.new(0.5, 0, 0.5, 0)\n    for i = 1, 30 do\n        Frame.Size = UDim2.new(0, 600 * (i/30), 0, 450 * (i/30))\n        Frame.Position = UDim2.new(0.5, -300 * (i/30), 0.5, -225 * (i/30))\n        task.wait(0.03)\n    end\nend)\n\n-- ==================== FINAL NOTIFICATION ====================\nNotify(\"💔 اسكندراني اعتزل 💔\", \"✅ Nameless Admin + VR7 HUB Loaded\\n⚡ أوامر أدمن + حماية فائقة\\n🛡️ ضد أي نظام أدمن!\", 10)\n\nprint(\"💔 ULTIMATE ANTI-KICK/BAN v3.1 + NAMELESS ADMIN LOADED - اسكندراني اعتزل 💔\")","owner":{"_id":"69db8fcbb451197e187b4c97","username":"alskndranyalskndran","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/d81efe25320407207f1520303d8d07165f21e44afc6c7e754f080b9dcc3d5819.webp","original":"https://scriptblox.com/images/photo/69db8fcbb451197e187b4c97-1775997055725.png"},"status":"offline","id":"69db8fcbb451197e187b4c97","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/d81efe25320407207f1520303d8d07165f21e44afc6c7e754f080b9dcc3d5819.webp","original":"https://scriptblox.com/images/photo/69db8fcbb451197e187b4c97-1775997055725.png"}},"verified":false,"views":6523,"scriptType":"free","isUniversal":true,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/d65281f3d6745f2a6320f5f27a327c57fa14bb57f2155a2972a5efed6942deda.webp","original":"https://scriptblox.com/images/sb/0-1777103534249.png","scriptblox":"https://scriptblox.com/images/script/0-1777103534249.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026