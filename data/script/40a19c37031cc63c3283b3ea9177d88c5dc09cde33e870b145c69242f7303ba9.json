ce:GetDescendants()) do\n        if obj:IsA(\"BasePart\") then\n            local distance = (obj.Position - rootPart.Position).Magnitude\n            if distance <= radius then\n                local fullPath = getFullPath(obj)\n                print(\"Object name: \" .. obj.Name .. \" | Path: \" .. fullPath .. \" | Distance: \" .. distance) -- print\n            end\n        end\n    end\nend\n\nwhile true do\n    checkNearbyObjects()\n    wait(2) -- delayy \nend\n","features":"detect object","tags":[],"discord":"","keyLink":"","owner":{"_id":"664f55f354353f1b09cd4e9a","username":"Basic","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ebd658488db47cbb70fd365ae1767510ed3cceec9580d845d6bf01ac590ddd3e.webp","original":"https://scriptblox.com/images/photo/664f55f354353f1b09cd4e9a-1716475953382.jpg"},"status":"offline","id":"664f55f354353f1b09cd4e9a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/ebd658488db47cbb70fd365ae1767510ed3cceec9580d845d6bf01ac590ddd3e.webp","original":"https://scriptblox.com/images/photo/664f55f354353f1b09cd4e9a-1716475953382.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:10:01.480Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c5220c","editBy":{"_id":"664f55f354353f1b09cd4e9a","username":"Basic","status":"offline","id":"664f55f354353f1b09cd4e9a"},"message":"Create script","createdAt":"2025-03-26T23:04:23.201Z"}],"comments":[]}