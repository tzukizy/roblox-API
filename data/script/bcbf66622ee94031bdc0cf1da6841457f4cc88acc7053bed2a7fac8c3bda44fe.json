{"slug":"Universal-Script-disco-script-56983","_id":"68e4d828203e8800d2bb6ad0","title":"disco script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1759828008081.png","placeId":0},"features":"free","tags":[],"script":"local Lighting = game:GetService(\"Lighting\")\nlocal ColorCorrection = Instance.new(\"ColorCorrectionEffect\")\nColorCorrection.Parent = Lighting\n\nlocal function zigzag(X)\n\treturn math.acos(math.cos(X * math.pi)) / math.pi\nend\n\nlocal Counter = 0\nLighting.TimeOfDay = \"12:00\"\n\nwhile task.wait(0.1) do\n\tlocal color = Color3.fromHSV(zigzag(Counter), 1, 1)\n\tColorCorrection.TintColor = color\n\tLighting.Ambient = color\n\tCounter += 0.01\nend\n","owner":{"_id":"6877a27928075f48017490c6","username":"skurb3rZploit","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6877a27928075f48017490c6","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1998,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1759828008081.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-10-07T09:06:48.097Z","executes":1992,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e4d828203e8800d2bb6ad2","editBy":{"_id":"6877a27928075f48017490c6","username":"skurb3rZploit","status":"offline","id":"6877a27928075f48017490c6"},"message":"Create script","createdAt":"2025-10-07T09:06:48.102Z"}],"comments":[{"_id":"68e4e37c0a4d2f0cfacfd6b7","commentBy":{"_id":"67abe6a04114c8c3c604a5aa","username":"ReactorCoreDev","verified":false,"role":"user","profilePicture":"/images/photo/67abe6a04114c8c3c604a5aa-1743629312282.png","createdAt":"2025-02-12T00:09:04.751Z","lastActive":"2025-10-12T16:25:25.444Z","status":"offline","id":"67abe6a04114c8c3c604a5aa"},"text":"i made it smoother","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-07T09:55:08.455Z","like