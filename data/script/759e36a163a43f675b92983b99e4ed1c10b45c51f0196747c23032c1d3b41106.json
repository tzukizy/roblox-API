{"slug":"Universal-Script-ctrl-tp-37160","_id":"680a00148335c1f558040520","title":"ctrl tp","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"ctrl + click = tp\n\nopen source, found in: https://rbxscript.com/scripts-copy/RobloxCtrlclicktp-85wwS","tags":[],"script":"local UIS = game:GetService(\"UserInputService\")\n\nlocal Player = game.Players.LocalPlayer\nlocal Mouse = Player:GetMouse()\n\n\nfunction GetCharacter()\n   return game.Players.LocalPlayer.Character\nend\n\nfunction Teleport(pos)\n   local Char = GetCharacter()\n   if Char then\n       Char:MoveTo(pos)\n   end\nend\n\n\nUIS.InputBegan:Connect(function(input)\n   if input.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then\n       Teleport(Mouse.Hit.p)\n   end\nend)","owner":{"_id":"62b28152f5f20be73eaea3a6","username":"mod3_mj","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/38aa9d452e6e3b13f111c4fcf94edf4aa68a1f457f08bf2ac263fd04dcbd6c7e.webp","original":"https://scriptblox.com/images/photo/62b28152f5f20be73eaea3a6-1774961649671.jpg"},"status":"offline","id":"62b28152f5f20be73eaea3a6","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/38aa9d452e6e3b13f111c4fcf94edf4aa68a1f457f08bf2ac263fd04dcbd6c7e.webp","original":"https://scriptblox.com/images/photo/62b28152f5f20be73eaea3a6-1774961649671.jpg"}},"verified":false,"views":3046,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/a3b9dc88cea293e786cbf975f4893bcb44372b6b26dfa33390eb03fd8afaccec.webp","original":"https://scriptblox.com/images/sb/0-1745485844609.webp","scriptblox":"https://scriptblox.com/images/script/0-1745485844609.webp"},"likeCount":1,"dislikeC