{"slug":"Universal-Script-Roblox-Console-Require-Script-Executer-11510","_id":"65fcacfc1ec5210d195abdf4","title":"Roblox Console Require  Script Executer","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Perfect for executing Require scripts.","tags":[],"script":"Title):Require Executer Roblox Console\nCreator):09baRavenaaAlt\nDescription):09baRavenaaAlt Made this script do not skid it or you will pay.im lazy to create.\n\nlocal textBox = Instance.new(\"TextBox\")\ntextBox.Size = UDim2.new(0, 200, 0, 99)\ntextBox.Position = UDim2.new(0, 0, 0, 0)\ntextBox.Parent = script.Parent\n\nlocal button = Instance.new(\"TextButton\")\n\nbutton.Size = UDim2.new(0, 50, 0, 99)\nbutton.Position = UDim2.new(1, -50, 0, 0)\nbutton.Text = \"Execute\"\nbutton.Parent = script.Parent\n\nlocal textLabel = Instance.new(\"TextLabel\")\ntextLabel.Size = UDim2.new(1, 0, 0, 20)\ntextLabel.Position = UDim2.new(0, 0, -1, 0)\ntextLabel.Text = \"Roblox Console Require Executer\"\ntextLabel.Parent = script.Parent\n\nbutton.MouseButton1Click:Connect(function()\n    local requireScript = textBox.Text\n    require(requireScript)\nend)\n\nlocal dragGui = script.Parent:FindFirstChildOfClass(\"ClickDetector\")\nif not dragGui then\n    dragGui = Instance.new(\"ClickDetector\")\n    dragGui.Parent = script.Parent\nend\n\nlocal isDragging = false\nlocal offset = Vector3.new()\n\ndragGui.MouseClick:Connect(function()\n    isDragging = not isDragging\n    if isDragging then\n        offset = script.Parent.Position - game:GetService(\"UserInputService\"):GetMouseLocation()\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputChanged:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseMovement and isDragging then\n        script.Parent.Position = game:GetService(\"UserInputService\"):GetMouseLocation() + offset\n    end\nend)","owner":{"_id":"656ba638835d37c991fbf7e8","username":"S33dedL0rdz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"656ba638835d37c991fbf7e8","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":30771,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-03-21T21:56:12.245Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://media.kocakz.me/a10e1680c9eff7e06ed9883ef89c5b659bc0df7374efe8376b1528c485d575e3.webp","original":"https://scriptblox.com/images/sb/6246845-1711058172192.webp","scriptblox":"https://scriptblox.com/images/script/6246845-1711058172192.webp"},"executes":733,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:20:27.848Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/a10e1680c9eff7e06ed9883ef89c5b659bc0df7374efe8376b1528c485d575e3.webp","original":"https://scriptblox.com/images/sb/6246845-1711058172192.webp","scriptblox":"https://scriptblox.com/images/script/6246845-1711058172192.webp"},"changelog":[{"_id":"67e5e1e5b360710ec3c50701","editBy":{"_id":"656ba638835d37c991fbf7e8","username":"S33dedL0rdz","status":"offline","id":"656ba638835d37c991fbf7e8"},"message":"Create script","createdAt":"2025-03-27T23:10:33.859Z"}],"comments":[{"_id":"65fe72925a0898221fe9e0ba","commentBy":{"_id":"65d84a3f305a5f39220c9f0a","username":"LostSezUa","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/7b1172eda18e749a7b3639ec7cc07fca8407fc74d4abe6c6070bc572e2ee0f22.webp","original":"https://scriptblox.com/images/photo/65d84a3f305a5f39220c9f0a-1708673661332.png"},"createdAt":"2024-02-23T07:33:19.990Z","la