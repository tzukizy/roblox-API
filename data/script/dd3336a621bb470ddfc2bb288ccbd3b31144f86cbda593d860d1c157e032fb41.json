{"_id":"669ef87e637f1e7babd04070","title":"Roblox Script","game":{"_id":"67e5e1ffb360710ec3c77d3f","gameId":12355337193,"name":"MVSD | Murderers VS Sheriffs Duels","imageUrl":{"url":"https://media.kocakz.me/9dd01012cb8a196eaad091c04d09bebd9e29d2338f55bd7793b01baa0b2fcc0e.webp","original":"https://tr.rbxcdn.com/180DAY-2cac25a28b32e71c8c3c94368e6d6b9c/150/150/Image/Png/noFilter"},"slug":"12355337193-mvsd-murderers-vs-sheriffs-duels","path":"/game/12355337193-mvsd-murderers-vs-sheriffs-duels","thumbnail":{"url":"https://media.kocakz.me/9dd01012cb8a196eaad091c04d09bebd9e29d2338f55bd7793b01baa0b2fcc0e.webp","original":"https://tr.rbxcdn.com/180DAY-2cac25a28b32e71c8c3c94368e6d6b9c/150/150/Image/Png/noFilter"},"placeId":12355337193},"slug":"Murderers-VS-Sheriffs-Duels-Roblox-Script-MD-15937","verified":false,"key":false,"keyless":false,"views":149837,"executes":793,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/b9dfbfa0c09e3b7977cd43d75cbd7cc309364a5560e71176117a4b97ae37f3c5.webp","original":"https://scriptblox.com/images/sb/12355337193-1721694334328.png","scriptblox":"https://scriptblox.com/images/script/12355337193-1721694334328.png"},"thumbnail":{"url":"https://media.kocakz.me/b9dfbfa0c09e3b7977cd43d75cbd7cc309364a5560e71176117a4b97ae37f3c5.webp","original":"https://scriptblox.com/images/sb/12355337193-1721694334328.png","scriptblox":"https://scriptblox.com/images/script/12355337193-1721694334328.png"},"likeCount":8,"dislikeCount":0,"createdAt":"2024-07-23T00:25:34.379Z","updatedAt":"2024-07-23T00:25:34.379Z","lastBump":"2024-07-23T00:25:34.379Z","script":"local ScreenGui = Instance.new(\"ScreenGui\")\nlocal Frame = Instance.new(\"Frame\")\nlocal MinimizeButton = Instance.new(\"TextButton\")\nlocal MVSDButton = Instance.new(\"TextButton\")\nlocal MVSD2Button = Instance.new(\"TextButton\")\nlocal UICorner = Instance.new(\"UICorner\")\n\nScreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n\nFrame.Parent = ScreenGui\nFrame.BackgroundColor3 = Color3.new(0, 0, 0)\nFrame.Size = UDim2.new(0.5, 0, 0.5, 0)\nFrame.Position = UDim2.new(0.25, 0, 0.25, 0)\nFrame.Active = true\nFrame.Draggable = true\n\nUICorner.Parent = Frame\nUICorner.CornerRadius = UDim.new(0, 20)\n\nMinimizeButton.Parent = Frame\nMinimizeButton.Text = \"-\"\nMinimizeButton.Size = UDim2.new(0.1, 0, 0.1, 0)\nMinimizeButton.Position = UDim2.new(0.9, 0, 0, 0)\nMinimizeButton.MouseButton1Click:Connect(function()\n    Frame:Destroy()\nend)\n\nMVSDButton.Parent = Frame\nMVSDButton.Text = \"MVSD\"\nMVSDButton.Size = UDim2.new(0.3, 0, 0.1, 0)\nMVSDButton.Position = UDim2.new(0.35, 0, 0.2, 0)\nMVSDButton.MouseButton1Click:Connect(function()\n    loadstring(game:HttpGet(\"https://pastebin.com/raw/vjTWQ8wW\"))()\nend)\n\nMVSD2Button.Parent = Frame\nMVSD2Button.Text = \"MVSD 2 Oly Hitbox\"\nMVSD2Button.Size = UDim2.new(0.3, 0, 0.1, 0)\nMVSD2Button.Position = UDim2.new(0.35, 0, 0.35, 0)\nMVSD2Button.MouseButton1Click:Connect(function()\n    _G.HeadSize = 10\n    _G.Disabled = true\n\n    game:GetService('RunService').RenderStepped:connect(function()\n        if _G.Disabled then\n            for i,v in next, game:GetService('Players'):GetPlayers() do\n                if v.Name ~= game:GetService('Players').LocalPlayer.Name then\n                    pcall(function()\n                        v.Character.HumanoidRootPart.Size = Vector3.new(_G.HeadSize,_G.HeadSize,_G.HeadSize)\n                        v.Character.HumanoidRootPart.Transparency = 0.7\n                        v.Character.HumanoidRootPart.BrickColor = BrickColor.new(\"Really blue\")\n                        v.Character.HumanoidRootPart.Material = \"Neon\"\n                        v.Character.HumanoidRootPart.CanCollide = false\n                    end)\n                end\n            end\n        end\n    end)\nend)","features":"Roblox MVSD Script  1-6 options, +2 scripts, the first script is more complete than Orion library, The second contains only Hitbox (Lite) Recommended Executor- Fluxus, Delta, Hydrogen, !no key needed!","tags":["Roblox","Script","MVSD","Hitbox","Murderers Vs Sheriffs"],"discord":"","keyLink":"","owner":{"_id":"669315d3f7c78abd32effd7d","username":"ydont024","verified":false,"profilePicture":{"url":"https://media.kocakz.me/85648900c30ffd23e258fe77ce9ad6fab1049bd2b10fb522f825e44a9b2e3e23.webp","original":"https://scriptblox.com/images/photo/669315d3f7c78abd32effd7d-1721694562484.jpg"},"status":"offline","id":"669315d3f7c78abd32effd7d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/85648900c30ffd23e258fe77ce9ad6fab1049bd2b10fb522f825e44a9b2e3e23.webp","original":"https://scriptblox.com/images/photo/669315d3f7c78abd32effd7d-1721694562484.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:22:33.204Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c5173f","editBy":{"_id":"669315d3f7c78abd32effd7d","username":"ydont024","status":"offline","id":"669315d3f7c78abd32effd7d"},"message":"Create script","createdAt":"2025-03-27T23:09:44.880Z"}],"comments":[{"_id":"669ef9c2d28083cc6f231da9","commentBy":{"_id":"669315d3f7c78abd32effd7d","username":"ydont024","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/85648900c30ffd23e258fe77ce9ad6fab1049bd2b10fb522f825e44a9b2e3e23.webp","original":"https://scriptblox.com/images/photo/669315d3f7c78abd32effd7d-1721694562484.jpg"},"createdAt":"2024-07-14T00:03:31.069Z","lastActive":"2025-06-03T21:21:26.841Z","status":"offline","id":"669315d3f7c78abd32effd7d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/85648900c30ffd23e258fe77ce9ad6fab1049bd2b10fb522f825e44a9b2e3e23.webp","original":"https://scriptblox.