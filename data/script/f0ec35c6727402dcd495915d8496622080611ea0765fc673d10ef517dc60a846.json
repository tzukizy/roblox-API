{"slug":"Universal-Script-Sunset-Ui-Libary-202143","_id":"69e25adeacbdb9fc7b2f868f","title":"Sunset Ui Libary","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Simple UI libary mobile/pc","tags":["ui libary","open source"],"script":"local Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/doenteexploiter/sunsetlibary/refs/heads/main/sunset.lua\"))()\n\n-- Criar a janela\nlocal win = Library:CreateWindow(\"Sunset UI\")\n\n-- Configurar cores (opcional)\nwin:SetToggleColor(Color3.fromRGB(255, 106, 0))\nwin:SetToggleSize(50)\nwin:SetThemeColor(Color3.fromRGB(255, 106, 0))\n\n\n-- Criar aba principal\nlocal tab = win:CreateTab(\"Principal\")\nlocal section = tab:AddSection(\"Informações\")\n\n-- TEXTBOX funcionando\nsection:AddTextBox(\"Digite seu nome aqui...\", function(text)\n\tprint(\"Texto digitado:\", text)\n\twin:Notify(\"Mensagem\", \"Você digitou: \" .. text, 3)\nend)\n\n-- Botão normal\nsection:AddButton(\"Clique aqui\", function()\n\tprint(\"Botão clicado!\")\n\twin:Notify(\"Aviso\", \"Você clicou no botão!\", 3)\nend)\n\n-- Toggle\nsection:AddToggle(\"Ativar modo\", function(state)\n\tprint(\"Modo ativado:\", state)\nend)\n\n-- Slider\nsection:AddSlider(\"Volume\", 0, 100, function(value)\n\tprint(\"Volume:\", value)\nend)\n\n-- DROPDOWN CORRIGIDO (agora funciona)\nsection:AddDropdown(\"Escolha uma opção\", {\"Opção 1\", \"Opção 2\", \"Opção 3\"}, function(selected)\n\tprint(\"Selecionado:\", selected)\n\twin:Notify(\"Dropdown\", \"Você selecionou: \" .. selected, 2)\nend)\n\n-- Discord invite\nsection:AddDiscordInvite(\"Meu Servidor\", \"https://discord.gg/exemplo\", \"91401836326849\")\n\n-- Segunda aba\nlocal tab2 = win:CreateTab(\"Configurações\")\nlocal section2 = tab2:AddSection(\"Ajustes\")\n\nsection2:AddLabel(\"Bem vindo ao Sunset UI!\")\nsection2:AddButton(\"Sair\", function()\n\tprint(\"Saindo...\")\nend)\n\nprint(\"UI carregada! Procure o botão no canto esquerdo da tela.\")","owner":{"_id":"65b80febb926d5fa20ae5b87","username":"doente","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0a74018c56c83f0cb7b47ea94ca5e96e38266be75b7dd07f00320c7875e6b184.webp","original":"https://scriptblox.com/images/photo/65b80febb926d5fa20ae5b87-1776441850047.jpg"},"status":"offline","id":"65b80febb926d5fa20ae5b87","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/0a74018c56c83f0cb7b47ea94ca5e96e38266be75b7dd07f00320c7875e6b184.webp","original":"https://scriptblox.com/images/photo/65b80febb926d5fa20ae5b87-1776441850047.jpg"}},"verified":false,"views":329,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/7a2e5903ee62f4f1d72b551275ff83a3dda06d25e3c71c5c3b0a6fda6506aac5.webp","original":"https://scriptblox.com/images/sb/0-1776442078471.jpg","scriptblox":"https://scriptblox.com/images/script/0-1776442078471.jpg"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-04-17T16:07:58.492Z","executes":235,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:04:09.632Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/7a2e5903ee62f4f1d72b551275ff83a3dda06d25e3c71c5c3b0a6fda6506aac5.webp","original":"https://scriptblox.com/images/sb/0-1776442078471.jpg","scriptblox":"https://scriptblox.com/images/script/0-1776442078471.jpg"},"changelog":[{"_id":"69e25adeacbdb9fc7b2f8692","editBy":{"_id":"65b80febb926d5fa20ae5b87","username":"doente","status":"offline","id":"65b80febb926d5fa20ae5b87"},"message":"Create script","createdAt":"2026-04-17T16:07:58.496Z"}],"comments":[{"_id":"69e8ac39b3208f4ea8503