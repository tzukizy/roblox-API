{"slug":"Universal-Script-Midnight-esp-23192","_id":"67465d4303c43cc2b84bb5e9","title":"Midnight esp","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Esp green simple","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal function highlightPlayers()\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player.Character and player.Character:FindFirstChild(\"Humanoid\") then\n            local highlight = Instance.new(\"Highlight\")\n            highlight.Parent = player.Character\n            highlight.FillColor = Color3.fromRGB(0, 255, 0)\n            highlight.FillTransparency = 0.5\n            highlight.OutlineColor = Color3.fromRGB(0, 0, 0)\n            highlight.OutlineTransparency = 0\n        end\n    end\nend\n\nRunService.Heartbeat:Connect(function()\n    highlightPlayers()\nend)\n","owner":{"_id":"670489c091d07cd5246c0980","username":"techmidnite","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"670489c091d07cd5246c0980","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":4038,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-11-26T23:44:03.436Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/095e716b4e827a9ff6bbf7b3a3510f2f77c648befbe62e2999628e2abb929e07.webp","original":"https://scriptblox.com/images/sb/9752612-1732664643409.png","scriptblox":"https://scriptblox.com/images/script/9752612-1732664643409.png"},"executes":10,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdi