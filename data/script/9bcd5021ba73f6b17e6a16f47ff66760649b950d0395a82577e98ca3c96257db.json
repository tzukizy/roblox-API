und plot\")\n            return plot\n        end\n    end\n\n    warn(\"couldnt find plot\")\n    return nil\nend\n\nlocal function getPigeon()\n    local pigeons = findPlayerPlot():FindFirstChild(\"Pigeons\")\n\n    if pigeons then\n        for i, model in pairs(pigeons:GetChildren()) do\n            if model:GetAttribute(\"PigeonID\") then\n                print(\"found pigeon\")\n                return model\n            end\n        end\n    end\n\n    warn(\"could not fin any pigeons (you need atleast one pigeon on your plot)\")\n    return nil\nend\n\n\nlocal pigeonId = getPigeon():GetAttribute(\"PigeonID\")\n\nwhile true do \n    task.wait(0.1)\n    local args = {\n        pigeonId,\n        math.huge + 0.9439858923809532\n    }\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"PigeonCollectRequest\"):FireServer(unpack(args))\nend","features":"(YOU NEED AT LEAST 1 PIGEON FOR THIS TO WORK)\n\ninf money","tags":["My Pooping Pigeons","keyless"],"discord":"","keyLink":"","owner":{"_id":"692b1160cac386e648345a79","username":"lpzrs","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b779b7a199959c0a5705b3fac3ba82422ef43197da44f48c643b3e05f39dcb8a.webp","original":"https://scriptblox.com/images/photo/692b1160cac386e648345a79-1765147705892.jpg"},"status":"offline","id":"692b1160cac386e648345a79","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/b779b7a199959c0a5705b3fac3ba82422ef43197da44f48c643b3e05f39dcb8a.webp","original":"https://scriptblox.com/images/photo/692b1160cac386e648345a79-1765147705892.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:36:09.833Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6949b83131e76adf3162b9c2","editBy":{"_id":"692b1160cac386e648345a79","user