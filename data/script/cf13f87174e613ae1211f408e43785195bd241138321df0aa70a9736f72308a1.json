{"slug":"Trepidation-NEW-CODE-Gui-Script-14224","_id":"666efd83007c32a4b2fe14a8","title":"Gui Script [PATCHED]","game":{"_id":"67e5e1ffb360710ec3c78cbd","gameId":6375883252,"name":"Trepidation [NEW CODE]","imageUrl":"https://tr.rbxcdn.com/6c6bceaa5528b94b86c57ab3d9c1941e/500/280/Image/Jpeg","placeId":6375883252},"features":"- Infinite Money\n- Instant level up","tags":[],"script":"local lib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/AZYsGithub/Arceus-X-UI-Library/main/source.lua\"))()\nlib:SetTitle(\"Trepidation | Agreed69\")\n\nlocal cash = 1000000000000\n\nlib:AddButton(\"Infinite Money\", function()\n   game:GetService(\"ReplicatedStorage\").DailyRewardGrantEvent:FireServer(\"Coins\", cash, 1)\nend)\n\nlib:AddComboBox(\"Money\", {\"1T\", \"1QA\", \"1QI\", \"math.huge\"}, function(selection)\n    if selection == \"1T\" then\n        cash = 1000000000000\n    elseif selection == \"1QA\" then\n        cash = 1000000000000000\n    elseif selection == \"1QI\" then\n        cash = 1000000000000000000\n    elseif selection == \"math.huge\" then\n        cash = math.huge\n    end\nend)\n\nlib:AddToggle(\"Auto Level Up\", function(state)\n    _G.levelup = state\n    while _G.levelup do\n        game:GetService(\"ReplicatedStorage\").LevelUpEvent:FireServer()\n        wait()\n    end\nend)","owner":{"_id":"665b64ef70a0a42a69254eb3","username":"agreed","verified":true,"profilePicture":"/images/photo/665b64ef70a0a42a69254eb3-1732394080428.png","status":"offline","id":"665b64ef70a0a42a69254eb3","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"keyLink":"","views":6588,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-06-16T14:58:11.490Z","dislikeCount":0,"likeCount":2,"image":"https://tr.rbxcdn.com/6c6bceaa5528b94b86c57ab3d9c1941e/500/280/Image/Jpeg","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c53d","ed