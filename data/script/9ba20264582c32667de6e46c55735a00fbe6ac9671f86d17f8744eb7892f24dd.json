{"slug":"Universal-Script-Slow-jump-47048","_id":"688b9246db08884f75ed2cf5","title":"Slow jump","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1753977414114.png","placeId":0},"features":"Basically when you jump it slows your fall\nAnd yes it's ai and you can basically play steal games","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal RunService = game:GetService(\"RunService\")\n\nlocal isFloating = false\nlocal floatTime = 3 -- seconds to float\nlocal delayBeforeFloat = 0.2 -- 0.2 second delay before floating\n\nhumanoid.Jumping:Connect(function()\n    if isFloating then return end -- prevent stacking\n\n    -- Wait until the character is actually falling (in the air)\n    repeat\n        wait()\n    until humanoid:GetState() == Enum.HumanoidStateType.Freefall\n\n    -- Wait 0.2 seconds before starting to float\n    wait(delayBeforeFloat)\n\n    isFloating = true\n    local elapsed = 0\n\n    local connection\n    connection = RunService.Heartbeat:Connect(function(delta)\n        elapsed = elapsed + delta\n\n        if elapsed < floatTime then\n            -- Freeze vertical velocity to hover\n            local velocity = rootPart.Velocity\n            rootPart.Velocity = Vector3.new(velocity.X, 0, velocity.Z)\n        else\n            -- Stop hovering and disconnect\n            connection:Disconnect()\n            isFloating = false\n        end\n    end)\nend)","owner":{"_id":"685a0e4fac15ee5efbca0b68","username":"kongy9087","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"685a0e4fac15ee5efbca0b68","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2390,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1753977414114.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-07-31T15:56:54.233Z","executes":80,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"688b9246db08884f75ed2cf7","editBy":{"_id":"685a0e4fac15ee5efbca0b68","username":"kongy9087","status":"offline","id":"685a0e4fac15ee5efbca0b68"},"message":"Ai made","createdAt":"2025-07-31T15:56:54.241Z"}],"comments":[{"_id":"688b926e5c54342b54fb265e","commentBy":{"_id":"685a0e4fac15ee5efbca0b68","username":"kongy9087","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-06-24T02:32:47.579Z","lastActive":"2026-02-04T01:20:33.992Z","status":"offline","id":"685a0e4fac15ee5efbca0b68","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Hi you need to execute it again if you die (tip)","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-31T15:57:34.899Z","liked":false,"disliked":false},{"_id":"688b928c5e99f8a2ca5c1a0c","commentBy":{"_id":"685a0e4fac15ee5efbca0b68","username":"kongy9087","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-06-24T02:32:47.579Z","lastActive":"2026-02-04T01:20:33.992Z","status":"offline","id":"685a0e4fac15ee5efbca0b68","topMilestone":{"key":"creator.first_script","tier":1}},"text":"And also maybe not ban able","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-31T15:58:04.923Z","liked":false,"disliked":false},{"_id":"688b92b860d69af847b6a986","commentBy":{"_id":"685a0e4fac15ee5efbca0b68","username":"kongy9087","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-06-24T02:32:47.579Z","lastActive":"2026-02-04T01:20:33.992Z","status":"offline","id":"685a0e4fac15ee5efbca0b68","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Because it looks like lag","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-31T15:58:48.232Z","liked":false,"d