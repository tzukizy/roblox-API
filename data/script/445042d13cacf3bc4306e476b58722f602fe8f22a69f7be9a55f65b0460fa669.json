{"_id":"66a153a4da59bb330bbcab91","title":"Shows Ur coordinate","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/c2afa47b7b22080fa798fecf7fadbdac406052f3e8fae51deff5541dd555d285.webp","original":"https://scriptblox.com/images/sb/4850290-1721848740246.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/c2afa47b7b22080fa798fecf7fadbdac406052f3e8fae51deff5541dd555d285.webp","original":"https://scriptblox.com/images/sb/4850290-1721848740246.png"},"placeId":0},"slug":"Universal-Script-Shows-Ur-coordinate-16038","verified":false,"key":false,"keyless":false,"views":24629,"executes":4,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/508f1d8cbe3d340d532f594e87b48b687f41bf07776cb94900e2082f466db24a.webp","original":"https://scriptblox.com/images/sb/4850290-1721848740246.png","scriptblox":"https://scriptblox.com/images/script/4850290-1721848740246.png"},"thumbnail":{"url":"https://media.kocakz.me/508f1d8cbe3d340d532f594e87b48b687f41bf07776cb94900e2082f466db24a.webp","original":"https://scriptblox.com/images/sb/4850290-1721848740246.png","scriptblox":"https://scriptblox.com/images/script/4850290-1721848740246.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2024-07-24T19:19:00.277Z","updatedAt":"2024-07-24T19:19:00.277Z","lastBump":"2024-07-24T19:19:00.277Z","script":"-- Parent this script to StarterPlayer -> StarterPlayerScripts\n\nlocal player = game.Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\n-- Create a ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = playerGui\n\n-- Create a TextLabel to display the coordinates\nlocal coordLabel = Instance.new(\"TextLabel\")\ncoordLabel.Size = UDim2.new(0, 200, 0, 50)\ncoordLabel.Position = UDim2.new(0, 10, 0, 10)\ncoordLabel.BackgroundTransparency = 0.5\ncoordLabel.TextScaled = true\ncoordLabel.Parent = screenGui\n\n-- Update the TextLabel with the player's coordinates\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n    local character = player.Character\n    if character and character:FindFirstChild(\"HumanoidRootPart\") then\n        local position = character.HumanoidRootPart.Position\n        coordLabel.Text = string.format(\"X: %.2f, Y: %.2f, Z: %.2f\", position.X, position.Y, position.Z)\n    end\nend)\n","features":"lol","tags":[],"discord":"","keyLink":"","owner":{"_id":"65d105e32e7e709b61c6b8a6","username":"battybat","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4d508c1a64b45f4be96acf2851a23c5be0431a9173388faa17babe992f1320d6.webp","original":"https://scriptblox.com/images/photo/65d105e32e7e709b61c6b8a6-1721067852630.jpeg"},"status":"offline","id":"65d105e32e7e709b61c6b8a6","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/4d508c1a64b45f4be96acf2851a23c5be0431a9173388faa17babe992f1320d6.webp","original":"https://scriptblox.com/images/photo/65d105e32e7e709b61c6b8a6-1721067852630.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:20:19.070Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c51783","editBy":{"_id":"65d105e32e7e709b61c6b8a6","username":"battybat","status":"offline","id":"65d105e32e7e709b61c6b8a6"},"message":"Create script","createdAt":"2025-03-24T01:05:17.449Z"}],"comments":[]}