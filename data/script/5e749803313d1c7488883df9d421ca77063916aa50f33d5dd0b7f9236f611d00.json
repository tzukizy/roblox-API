nlocal Section = Tab:NewSection(\"Main\")\n\nlocal players = game:GetService(\"Players\")\nlocal annoying = false\n\nSection:NewButton(\"Remove ac\", \"Removes ac\", function()\n\tlocal ac = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Cheat\", 1)\n\tif ac then\n\t\tac:Destroy()\n\telse\n\t\tprint(\"Cant find ac\")\n\tend\nend)\nSection:NewButton(\"Give shovel\", \"Gives shovel\", function()\n\tlocal thing = game:GetService(\"StarterGui\").Treasure.giver.Shovel:Clone()\n\tthing.Parent = players.LocalPlayer.Backpack\nend)\nSection:NewToggle(\"Annoy all near | SS\", \"Plays sounds to people near you\", function(state)\n\tannoying = state\n\tif annoying then\n\t\ttask.spawn(function()\n\t\t\tlocal eventsFolder = game:GetService(\"ReplicatedStorage\").RemoteEvents.CharacterFunctions.Jumpscares\n\t\t\twhile annoying do\n\t\t\t\tfor _, event in pairs(eventsFolder:GetChildren()) do\n\t\t\t\t\tif event:IsA(\"RemoteEvent\") then\n\t\t\t\t\t\tevent:FireServer()\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\tend\nend)\n","features":"Remove ac - removes the horrible ac\nGive shovel - gives a shovel\nAnnoy all near - annoys people near you","tags":["ss","troll","annoy","op","annoying"],"discord":"","keyLink":"","owner":{"_id":"683aa0380f380c18ee525781","username":"scripter132","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"683aa0380f380c18ee525781","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:54:49.270Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"690ea7dc526dad7219adb00e","editBy":{"_id":"683aa0380f380c18ee525781","username":"scripter132","status