d427a492917b11dfe.webp","original":"https://scriptblox.com/images/photo/6961bd03da5d2acf4861aca0-1768013314314.png"}},"text":"@BeboMods \nwhen I use workspace:GetDescendants() it basically searches the whole entire game for the models, when I used this it lagged the game for a quarter second whenever it refreshed to look for new or dead npcs. CollectionService is just a better and more optimized version to remove the small lag spikes that I had.","parent":{"_id":"696b7f9af3dbd103e3b818f9","commentBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","profilePicture":"/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg","status":"offline","id":"6227c42f7944271798ea1b15"},"text":"what is local CollectionService = game:GetService(\"CollectionService\") for?"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-17T12:36:19.796Z","liked":false,"disliked":false},{"_id":"696b82d7f76c99c44509f3ec","commentBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"role":"user","profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"createdAt":"2022-03-08T21:01:35.262Z","lastActive":"2026-10-15T21:00:12.655Z","lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"text":"u just defined the local and never used it again tho?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-17T12:38:47.394Z","liked":false,"disliked":false},{"_id":"696b8335107151476e8c217f","commentBy":{"_id":"6961bd03da5d2acf4861aca0","username":"sarcophile","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/873979c963600e86b45db76baa558885ddc220c393eb098d427a492917b11dfe.webp","original":"https://scriptblox.com/images/photo/6961bd03da5d2acf4861aca0-1768013314314.png"},"lastActive":"2026-06-11T22:15:34.110Z","createdAt":"2026-01-10T02:44:19.458Z","status":"offline","id":"6961bd03da5d2acf4861aca0","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/873979c963600e86b45db76baa558885ddc220c393eb098d427a492917b11dfe.webp","original":"https://scriptblox.com/images/photo/6961bd03da5d2acf4861aca0-1768013314314.png"}},"text":"@BeboMods \nThe local variable is used to call GetTagged (to find existing NPCs) and GetInstanceAddedSignal (to find new NPCs the moment they spawn). It completely removes the need for a while wait() loop, which is why the lag disappears.","parent":{"_id":"696b82d7f76c99c44509f3ec","commentBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","profilePicture":"/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg","status":"offline","id":"6227c42f7944271798ea1b15"},"text":"u just defined the local and never used it again tho?"},"edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-17T12:40:21.110Z","liked":false,"disliked":false},{"_id":"696bbbf60c9246429a015cea","commentBy":{"_id":"6920e8b6a4904159a644ead4","username":"00Fazee","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/22c66c99deb030de50f5e2ca529e48d07225bddd49b3b6bfd1e8efb817e11beb.webp","original":"https://scriptblox.com/images/photo/6920e8b6a4904159a644ead4-1763772655588.png"},"lastActive":"2026-10-17T00:04:55.153Z","createdAt":"2025-11-21T22:33:26.535Z","lvl":6,"status":"offline","id":"6920e8b6a4904159a644ead4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/22c66c99deb030de50f5e2ca529e48d07225bddd49b3b6bfd1e8efb817e11beb.webp","original":"https://scriptblox.com/images/photo/6920e8b6a4904159a644ead4-1763772655588.pn