{"slug":"HELLMET-OPEN-ALPHA-ESP-for-hostiles-and-enemies-no-key-86743","_id":"696b729853b2145f89ac2bbb","title":"ESP for hostiles and enemies no key","game":{"_id":"67e5e1ffb360710ec3c785cc","gameId":13815196156,"name":"HELLMET [OPEN ALPHA]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":13815196156},"features":"Simple esp script.\nEnemies are red, civilians are green bla bla bla.\nEnemies load in this game only when you get close enough, this is a game feature, not an issue with the script.","tags":[],"script":"local CollectionService = game:GetService(\"CollectionService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal REFRESH_RATE = 0.5\nlocal lastUpdate = 0\n\nlocal TARGET_NAMES = {[\"civilian\"] = true, [\"hostile\"] = true, [\"pmc\"] = true}\nlocal COLORS = {\n    [\"civilian\"] = Color3.fromRGB(0, 255, 0),\n    [\"hostile\"] = Color3.fromRGB(255, 0, 0),\n    [\"pmc\"] = Color3.fromRGB(255, 0, 0)\n}\n\nlocal function applyHighlight(model)\n    if model:FindFirstChild(\"ESPHighlight\") then return end\n    \n    local highlight = Instance.new(\"Highlight\")\n    highlight.Name = \"ESPHighlight\"\n    highlight.Adornee = model\n    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n    highlight.FillTransparency = 0.6\n    \n    local color = COLORS[model.Name:lower()] or Color3.fromRGB(255, 255, 255)\n    highlight.FillColor = color\n    highlight.OutlineColor = color\n    highlight.Parent = model\nend\n\nlocal connection\nconnection = RunService.Heartbeat:Connect(function()\n    if os.clock() - lastUpdate >= REFRESH_RATE then\n        lastUpdate = os.clock()\n        \n        for _, obj in ipairs(workspace:GetChildren()) do\n            if obj:IsA(\"Model\") and TARGET_NAMES[obj.Name:lower()] then\n                applyHighlight(obj)\n            end\n        end\n    end\nend)\n\nscript.Destroying:Connect(function()\n    connection:Disconnect()\n    for _, obj in ipairs(workspace:GetDescendants()) do\n        if obj.Name == \"ESPHighlight\" then\n            obj:Destroy()\n        end\n    end\nend)","owner":{"_id":"6961bd03da5d2acf4861aca0","username":"sarcophile","verified":false,"profilePicture":{"url":"https://media.kocakz.me/873979c963600e86b45db76baa558885ddc220c393eb098d427a492917b11dfe.webp","original":"https://scriptblox.com/images/photo/6961bd03da5d2acf4861aca0-1768013314314.png"},"status":"offline","id":"6961bd03da5d2acf4861aca0","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/873979c963600e86b45db76baa558885ddc220c393eb098d427a492917b11dfe.webp","original":"https://scriptblox.com/images/photo/6961bd03da5d2acf4861aca0-1768013314314.png"}},"verified":false,"views":1323,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/5c2eebaa5d91c49d85b7f56daac2bd8bc7dce36425eb05518330f5e2934fe02c.webp","original":"https://scriptblox.com/images/sb/13815196156-1768649368799.jpg","scriptblox":"https://scriptblox.com/images/script/13815196156-1768649368799.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-01-17T11:29:28.812Z","editBy":{"_id":"6961bd03da5d2acf4861aca0","username":"sarcophile","status":"offline","id":"6961bd03da5d2acf4861aca0"},"keyLink":"","executes":634,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:07:27.337Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/5c2eebaa5d91c49d85b7f56daac2bd8bc7dce36425eb05518330f5e2934fe02c.webp","original":"https://scriptblox.com/images/sb/13815196156-1768649368799.jpg","scriptblox":"https://scriptblox.com/images/script/13815196156-1768649368799.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"696b729853b2145f89ac2bbe","editBy":{"_id":"6