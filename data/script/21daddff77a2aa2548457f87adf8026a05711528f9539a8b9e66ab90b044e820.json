\"You must have the Peck tool equipped or in your backpack.\")\n    end\n\n    -- Equip the tool if it’s in the backpack\n    if tool.Parent == speaker.Backpack then\n        tool.Parent = character\n        task.wait(0.2)\n    end\n\n    -- Grab the handle\n    local handle = tool:FindFirstChild(\"Handle\")\n    if not handle then\n        return notify(\"Peck Tool\", \"Peck tool is missing a Handle.\")\n    end\n\n    -- Find target player\n    local targetPlayer = Players:FindFirstChild(targetName)\n    if not targetPlayer then\n        return notify(\"Player Not Found\", \"No player named '\" .. targetName .. \"'\")\n    end\n\n    local targetChar = targetPlayer.Character\n    if not targetChar then\n        return notify(\"Target Error\", \"Target has no character loaded.\")\n    end\n\n    local hum = targetChar:FindFirstChildWhichIsA(\"Humanoid\")\n    local root = targetChar:FindFirstChild(\"HumanoidRootPart\")\n\n    -- Activate Peck tool\n    tool:Activate()\n\n    -- Touch damage\n    firetouchinterest(handle, root, 1)\n    firetouchinterest(handle, root, 0)\nend\nfor i,v in next,game.Players:GetPlayers() do\nif v == game.Players.LocalPlayer then continue end\nrepeat task.wait() \nprint(v.Name)\nPeckPlayer(v.Name)\nuntil v.Character.Humanoid.Health == 0\nend\n","features":"execute once with peck equipped to kill all","tags":[],"discord":"","keyLink":"","owner":{"_id":"67e47e6748d80c8ce3fdf46e","username":"roninpilot1","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d63800e67c05f6bdad44b70875aebcd4bdf0a82379d8d884381ebd57fd645049.webp","original":"https://scriptblox.com/images/photo/67e47e6748d80c8ce3fdf46e-1764449423225.png"},"status":"offline","id":"67e47e6748d80c8ce3fdf46e","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/d63800e67c05f6bdad44b70875aebcd4bdf0a82379d8d884381ebd57fd645049.webp","original":"https://scriptblox.com/images/photo/67e47e6748d80c8ce3fdf46e-1764449423225.png"}},"revi