ash[\"Trash Can\"].Primary.CFrame \ntask.wait(0.2)\nfireproximityprompt(game.workspace.Items.Trash[\"Trash Can\"].ProximityPrompt)\nelse\nif plr.Backpack:FindFirstChild(\"Trash Bag\") then\nplr.Backpack[\"Trash Bag\"].Parent = plr.Character\nelse\nplr.Character.HumanoidRootPart.CFrame = game.workspace.Items[\"Trash Bag\"].Part.CFrame\ntask.wait(0.2)\nfireproximityprompt(game.workspace.Items[\"Trash Bag\"].ProximityPrompt) \nend\nend\ntask.wait(1) \nprint(\"Trash remaining: \"..trashnum)\nuntil autofarm == false","features":"--Made By: Shag420#6729\n\n[+] Trash autofarm - Auto-Pickup, Auto-Sell","tags":["autofarm","trash autofarm","dysfunctional","diner","dysfunctional diner"],"discord":"","keyLink":"","owner":{"_id":"61f3119e4351a4a73afa7497","username":"Shag420","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0adac1b8030c9ae6b2de87f79b164588085bcda13cb8f6a146efd5bcf6643f9e.webp","original":"https://scriptblox.com/images/photo/61f3119e4351a4a73afa7497-1691206414857.jpg"},"lvl":12,"status":"offline","id":"61f3119e4351a4a73afa7497","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/0adac1b8030c9ae6b2de87f79b164588085bcda13cb8f6a146efd5bcf6643f9e.webp","original":"https://scriptblox.com/images/photo/61f3119e4351a4a73afa7497-1691206414857.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:31:35.976Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f756","editBy":{"_id":"61f3119e4351a4a73afa7497","username":"Shag420","status":"offline","id":"61f3119e4351a4a73afa7497"},"message":"Create script","createdAt":"2025-03-27T22:32:45.629Z"}],"comments":[{"_id":"64deda16e1b7361cfe514aad","commentBy":{"_id":"629133ef070ac156bcc544da","username":"wiII","verified":false,"role":"user","profilePicture":{"url":"https: