{"_id":"69eb29aa450918ba8680d6b7","title":"Doors script cart ride auto","game":{"_id":"6959526c0597a5542a8de666","gameId":0,"name":"Script hub","imageUrl":{"url":"https://media.kocakz.me/53d34d4d55a3f69c77a1c0379e8794330e73949048c49e201c762456c85b26fe.webp","original":"https://scriptblox.com/images/sb/0-1777019306986.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/53d34d4d55a3f69c77a1c0379e8794330e73949048c49e201c762456c85b26fe.webp","original":"https://scriptblox.com/images/sb/0-1777019306986.jpg"},"placeId":0},"slug":"Universal-Script-Doors-script-cart-ride-auto-205615","verified":false,"key":false,"keyless":false,"views":1445,"executes":810,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/003320bbbd4e7f9f7bb1d20eb1d549342fb8f50db00287a4b1d9dd846c627dd7.webp","original":"https://scriptblox.com/images/sb/0-1777019306986.jpg","scriptblox":"https://scriptblox.com/images/script/0-1777019306986.jpg"},"thumbnail":{"url":"https://media.kocakz.me/003320bbbd4e7f9f7bb1d20eb1d549342fb8f50db00287a4b1d9dd846c627dd7.webp","original":"https://scriptblox.com/images/sb/0-1777019306986.jpg","scriptblox":"https://scriptblox.com/images/script/0-1777019306986.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2026-04-24T08:28:27.006Z","updatedAt":"2026-04-24T08:28:27.006Z","lastBump":"2026-04-24T08:28:27.006Z","script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal RunService = game:GetService(\"RunService\")\n\nlocal autoDrive = true\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"CartToggleGui\"\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\nscreenGui.ResetOnSpawn = false\n\nlocal toggleButton = Instance.new(\"TextButton\")\ntoggleButton.Size = UDim2.new(0, 100, 0, 50)\ntoggleButton.Position = UDim2.new(0.5, -50, 0.1, 0)\ntoggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\ntoggleButton.Text = \"Auto-Drive: ON\"\ntoggleButton.TextColor3 = Color3.new(1, 1, 1)\ntoggleButton.Parent = screenGui\n\ntoggleButton.MouseButton1Click:Connect(function()\n    autoDrive = not autoDrive\n    if autoDrive then\n        toggleButton.Text = \"Auto-Drive: ON\"\n        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\n    else\n        toggleButton.Text = \"Auto-Drive: OFF\"\n        toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\n    end\nend)\n\nRunService.Heartbeat:Connect(function()\n    if not autoDrive then return end\n    \n    local humanoid = character:FindFirstChild(\"Humanoid\")\n    if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA(\"VehicleSeat\") then\n        humanoid.SeatPart.ThrottleFloat = 1\n    end\nend)","features":"This script let's you stay relaxed while it does the seek chase cart automatically (only for mobile btw)\nAnd BTW it's mine\n(Ignore the thumbnail I did not had any photos)","tags":[],"discord":"","keyLink":"","owner":{"_id":"69cf5acf13f5ed9f1d74060a","username":"Levi112","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69cf5acf13f5ed9f1d74060a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:31:52.054Z","last":"","win":14,"math":4},"isHub":true,"supportedGames":[{"_id":"67e5e1ffb360710ec3c77d4f","gameId":6516141723,"placeId":6516141723,"name":"DOORS 🚨","imageUrl":{"url":"https://media.kocakz.me/fe044b312ec2132462b7814c03d4e799888a8af65ebd9b0e46f17a61b2bedf81.webp","original":"https://tr.rbxcdn.com/180DAY-5f677a28e42be59cd65c7b71ac8e9ede/150/150/Image/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.m