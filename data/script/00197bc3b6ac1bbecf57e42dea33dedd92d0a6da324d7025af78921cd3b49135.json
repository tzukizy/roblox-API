{"_id":"6969111ca601210e73975d9c","title":"Instant Interaction","game":{"_id":"693f07d79be37dfffd87b71c","gameId":104841616983113,"name":"San Aurie","imageUrl":{"url":"https://media.kocakz.me/6a6a6cf88db9690c7567d028c0ef15ea275008f3fc3202e78d2be7640addbb47.webp","original":"https://tr.rbxcdn.com/180DAY-6ecbd6080269181acff632109af92840/150/150/Image/Png/noFilter"},"slug":"104841616983113-san-aurie","path":"/game/104841616983113-san-aurie","thumbnail":{"url":"https://media.kocakz.me/6a6a6cf88db9690c7567d028c0ef15ea275008f3fc3202e78d2be7640addbb47.webp","original":"https://tr.rbxcdn.com/180DAY-6ecbd6080269181acff632109af92840/150/150/Image/Png/noFilter"},"placeId":104841616983113},"slug":"San-Aurie-Instant-Interaction-86137","verified":false,"key":false,"keyless":false,"views":4284,"executes":6014,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6fd9625844e01212bc2e5cd5627c4fd8134dfac2ea3a1f294e587fb7a36f2e34.webp","original":"https://scriptblox.com/images/sb/104841616983113-1768493340567.webp","scriptblox":"https://scriptblox.com/images/script/104841616983113-1768493340567.webp"},"thumbnail":{"url":"https://media.kocakz.me/6fd9625844e01212bc2e5cd5627c4fd8134dfac2ea3a1f294e587fb7a36f2e34.webp","original":"https://scriptblox.com/images/sb/104841616983113-1768493340567.webp","scriptblox":"https://scriptblox.com/images/script/104841616983113-1768493340567.webp"},"likeCount":0,"dislikeCount":2,"createdAt":"2026-01-15T16:09:00.592Z","updatedAt":"2026-01-15T16:09:00.592Z","lastBump":"2026-01-15T16:09:00.592Z","script":"-- ServerScript to be placed in ServerScriptService\n-- This script finds ALL existing ProximityPrompts and sets their HoldDuration to 0 (instant activation)\n-- It ALSO listens for ANY NEW ProximityPrompts added to the game (anywhere, dynamically) and instantly sets them too.\n\nlocal function makePromptInstant(prompt)\n    if prompt:IsA(\"ProximityPrompt\") then\n        prompt.HoldDuration = 0.1\n    end\nend\n\n-- Handle ALL existing ProximityPrompts right now\nfor _, obj in ipairs(game:GetDescendants()) do\n    makePromptInstant(obj)\nend\n\n-- **THIS PART** automatically handles ANY NEW ProximityPrompts added during gameplay\n-- (e.g., scripts spawning parts/tools with prompts, replicated from server, etc.)\ngame.DescendantAdded:Connect(makePromptInstant)","features":"**⚡ Instant Proximity Prompts**\n\nRemoves hold time from **all ProximityPrompts** so interactions trigger almost instantly. Automatically applies to **existing and newly spawned prompts**, ensuring everything stays fast with no manual holding.\n\n**Purpose:** faster interactions, less risk, no delays.","tags":["sanaurie"],"discord":"","keyLink":"","owner":{"_id":"68fcdc3938f78fe601c8f01a","username":"AnynomousScripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8befd038d9a677f0a7a2bd87f7dfcd2710ed46e019d1f174b0e03abe07009c96.webp","original":"https://scriptblox.com/images/photo/68fcdc3938f78fe601c8f01a-1761402088532.png"},"status":"offline","id":"68fcdc3938f78fe601c8f01a","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/8befd038d9a677f0a7a2bd87f7dfcd2710ed46e019d1f174b0e03abe07009c96.webp","original":"https://scriptblox.com/images/photo/68fcdc3938f78fe601c8f01a-1761402088532.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:39:26.784Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6969111ca601210e73975d9f","editBy":{"_id":"68fcdc3938f78fe601c8f01a","username":"AnynomousScripter","status":"offline","id":"68fcdc3938f78fe601c8f01a"},"message":"Create script","createdAt":"2026-01-15T16:09:00.594Z"}],"comments":[{"_id":"696abf1f242dea933cbc4cda","commentBy":{"_id":"696abe3489eac87a144bc9bd","username