{"slug":"Universal-Script-Adonis-Admin-Anti-Crash-18757","_id":"66ef4167c3850768c21f9c0d","title":"Adonis Admin Anti Crash","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/9652051-1726955879182.png","placeId":0},"features":"Prevents admins from using :crash, :lag and other similar commands on you in games with Adonis Admin enabled","tags":["adonis","antilag","anticrash","adonis admin","adonis bypass"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Pixeluted/adoniscries/main/Source.lua\"))() -- Adonis bypass\n\nlocal badFunctions = {\"Crash\", \"HardCrash\", \"GPUCrash\", \"RAMCrash\", \"KillClient\", \"SetFPS\"} -- Functions to hook\n\nfor i,v in pairs(getgc()) do \n    if type(v) == \"function\" then\n        local info = debug.getinfo(v)\n        local functionName = info.name\n        \n        -- Hook crash/lag functions\n        if info.source:find('=.Core.Functions') and table.find(badFunctions, functionName) then\n            print(\"Hooked \\\"\" .. functionName .. \"\\\"\")\n            hookfunction(v, function()\n                print(\"Stopped \\\"\" .. functionName .. \"\\\" from running\")\n            end)\n        end\n    end\nend","owner":{"_id":"66ac0f24fe9897618101237a","username":"xMurderer","verified":true,"profilePicture":"/images/photo/66ac0f24fe9897618101237a-1723471234370.png","status":"offline","id":"66ac0f24fe9897618101237a","topMilestone":{"key":"creator.views","tier":1000000}},"verified":true,"keyLink":"","views":374443,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-09-21T21:57:59.434Z","dislikeCount":5,"likeCount":10,"image":"/images/sb/9652051-1726955879182.png","executes":1423,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c522aa","editBy":{"_id":"66ac0f24fe9897618101237a","username":"xMurderer","status":"offline","id":"66ac0f24fe9897618