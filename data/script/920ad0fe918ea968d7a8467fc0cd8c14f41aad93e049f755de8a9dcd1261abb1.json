{"_id":"686b7324fff90ed8076707b2","title":"AntiVoid","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/0a0dbb76d6949a29ff6b73f5e7e8ab668e24df926f6d750922f6c5035f543266.webp","original":"https://scriptblox.com/images/sb/0-1751872292508.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/0a0dbb76d6949a29ff6b73f5e7e8ab668e24df926f6d750922f6c5035f543266.webp","original":"https://scriptblox.com/images/sb/0-1751872292508.jpg"},"placeId":0},"slug":"Universal-Script-AntiVoid-44167","verified":false,"key":false,"keyless":false,"views":2464,"executes":186,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/77477e48e4a5501b681e2d30365d7b100a570ea0fe8176acd9a7e6e4eef734bd.webp","original":"https://scriptblox.com/images/sb/0-1751872292508.jpg","scriptblox":"https://scriptblox.com/images/script/0-1751872292508.jpg"},"thumbnail":{"url":"https://media.kocakz.me/77477e48e4a5501b681e2d30365d7b100a570ea0fe8176acd9a7e6e4eef734bd.webp","original":"https://scriptblox.com/images/sb/0-1751872292508.jpg","scriptblox":"https://scriptblox.com/images/script/0-1751872292508.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-07-07T07:11:32.554Z","updatedAt":"2025-07-07T07:11:32.554Z","lastBump":"2025-07-07T07:11:32.554Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n-- Create ScreenGui and Button\nlocal screenGui = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\nscreenGui.Name = \"AntiVoidGui\"\n\nlocal button = Instance.new(\"TextButton\", screenGui)\nbutton.Size = UDim2.new(0, 150, 0, 50)\nbutton.Position = UDim2.new(0.5, -75, 0, 50)\nbutton.Text = \"Enable Anti-VoidKill\"\nbutton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\nbutton.TextColor3 = Color3.new(1, 1, 1)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextScaled = true\n\nlocal antiVoidEnabled = false\nlocal voidYLevel = -50 -- Y position considered as void\n\nlocal safePosition = Vector3.new(0, 50, 0) -- Position to teleport player to if they fall\n\nbutton.MouseButton1Click:Connect(function()\n    antiVoidEnabled = not antiVoidEnabled\n    if antiVoidEnabled then\n        button.Text = \"Disable Anti-VoidKill\"\n        button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\n    else\n        button.Text = \"Enable Anti-VoidKill\"\n        button.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\n    end\nend)\n\n-- Monitor player's position\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    if antiVoidEnabled and humanoidRootPart and humanoidRootPart.Position.Y < voidYLevel then\n        humanoidRootPart.CFrame = CFrame.new(safePosition)\n    end\nend)\n\n-- Update humanoidRootPart reference if character respawns\nplayer.CharacterAdded:Connect(function(char)\n    character = char\n    humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\nend)","features":"You can't (basically) die","tags":[],"discord":"","keyLink":"","owner":{"_id":"685f528f4d7758ab4d9ee074","username":"xurhub1999","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2a42b4444bea02a94970f9a5610190c26b0c3a99c8ae93bf668f84935ac9c4d3.webp","original":"https://scriptblox.com/images/photo/685f528f4d7758ab4d9ee074-1751872327353.png"},"status":"offline","id":"685f528f4d7758ab4d9ee074","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/2a42b4444bea02a94970f9a5610190c26b0c3a99c8ae93bf668f84935ac9c4d3.webp","original":"https://scriptblox.com/images/photo/685f528f4d7758ab4d9ee074-1751872327353.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:46:32.117Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"686b7324fff90ed8076707b4","editBy":{"_id":"685f528f4d7758ab4d9ee074","username":"xurhub1999","status":"offline","id":"685f528f4d7758ab4d9ee074"},"message":"Skibidi script🤫","createdAt":"2025-07-07T07:11:32.559Z"},{"_id":"68a25e278decc0a677ba796a","editBy":{"_id":"685f528f4d7758ab4d9ee074","username":"xurhub1999","status":"offline","id":"685f528f4d7758ab4d9ee074"},"message":"Update script","createdAt":"2025-08-17T22:56:39.745Z"}],"comments":[{"_id":"686b739f0fc69c3ddf684885","commentBy":{"_id":"685f528f4d7758ab4d9ee074","username":"xurhub1999","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/2a42b4444bea02a94970f9a5610190c26b0c3a99c8ae93bf668f84935ac9c4d3.webp","original":"https://scriptblox.com/images/photo/685f528f4d7758ab4d9ee074-1751872327353.png"},"createdAt":"2025-06-28T02:25:19.785Z","lastActive":"2025-08-23T03:12:07.568Z","status":"offline","id":"685f528f4d7758ab4d9ee074","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/2a42b4444bea02a94970f9a5610190c26b0c3a99c8ae93bf668f84935ac9c4d3.webp","original":"https://scriptblox.com/images/photo/685f528f4d7758ab4d9ee074-1751872327353.png"}},"text":"Alr, it's simple but pretty good","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-07T07:13:35.480Z","liked":false,"disliked":false},{"_id":"696c73f6867226372c13cc1f","commentBy":{"_id":"69654a10245637b68e78abaa","username":"Proman127fhhfjd","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-02-09T10:50:18.745Z","createdAt":"2026-01-12T19:22:56.106Z","status":"offline","id":"69654a10245637b68e78abaa","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"So this is basically like god mode scirpt right?","edited":false,"likeCount":