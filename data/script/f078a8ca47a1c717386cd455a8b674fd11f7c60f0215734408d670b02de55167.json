tbox(mob)\n    if not mob:IsA(\"Model\") then return end\n    local root = mob:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return end\n    if root:FindFirstChild(\"ExpandedHitbox\") then return end\n    root.Size = HITBOX_SIZE\n    root.Transparency = Hitbox_oclortrnas\n    root.Color = hitboxcolor1\n    root.Material = hitbox_mat\n    root.CanCollide = false\n    local tag = Instance.new(\"BoolValue\")\n    tag.Name = \"ExpandedHitbox\"\n    tag.Parent = root\nend\nfor _, mob in pairs(Bot_hitboxthingi:GetChildren()) do\n    expandHitbox(mob)\nend\nBot_hitboxthingi.ChildAdded:Connect(function(mob)\n    task.wait(0.1)\n    expandHitbox(mob)\nend)","features":"Hitbox,Expander Bot only, works on not planning to do Player","tags":["keyless","hitboxexapnder","free","HyperShot"],"discord":"","keyLink":"","owner":{"_id":"6687fa7cd9796ff22332ea27","username":"Insertcheats","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f3559c099439605631812050ba9466f0e3d78cd85cfcd90d4791392d4df9a902.webp","original":"https://scriptblox.com/images/photo/6687fa7cd9796ff22332ea27-1766830252885.png"},"status":"offline","id":"6687fa7cd9796ff22332ea27","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/f3559c099439605631812050ba9466f0e3d78cd85cfcd90d4791392d4df9a902.webp","original":"https://scriptblox.com/images/photo/6687fa7cd9796ff22332ea27-1766830252885.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:21:44.867Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6960c67e245637b68e24a6d6","editBy":{"_id":"6687fa7cd9796ff22332ea27","username":"Insertcheats","status":"offline","id":"6687fa7cd9796ff22332ea27"},"message":"Create script","createdAt":"2026-01-09T09:12:30.395Z"}],"comments":[{"_id":"696160f73593559f36cdc9bc","commentBy"