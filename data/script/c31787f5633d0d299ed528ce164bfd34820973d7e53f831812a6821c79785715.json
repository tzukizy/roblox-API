{"slug":"Rainbow-spray-effect_830","_id":"621254f9d43574e5bfe4d4b7","title":"Rainbow spray effect","game":{"_id":"67e5e1ffb360710ec3c77db9","gameId":5991163185,"name":"Spray Paint!","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":5991163185},"features":"Rainbow spray effect, nothing special but its a cool thing i made, and i thought i would share it !","tags":[],"script":"if not game:IsLoaded() then game.Loaded:wait() end \nlocal IsDescendantOf = game.IsDescendantOf\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:wait()\n\nlocal OldNamecall\n\nOldNamecall = hookmetamethod(game, \"__namecall\",function(...)\n        local Args = {...}\n        if getnamecallmethod() == \"FireServer\" then\n            if tostring(Args[1]) == \"SprayEffect\" and IsDescendantOf(Args[1], Character) then\n                for _ = 1, 25 do\n                    Args[3] = Color3.fromRGB(math.random(1, 255), math.random(1, 255), math.random(1, 255))\n                    OldNamecall(unpack(Args))\n                end\n            else\n                return OldNamecall(unpack(Args))\n            end\n        end\n        return OldNamecall(unpack(Args))\n end)\n","owner":{"_id":"61d10ef13f8a836aa0deddb6","username":"froggysfriend","verified":true,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61d10ef13f8a836aa0deddb6-1644446597332.gif"},"status":"offline","id":"61d10ef13f8a836aa0deddb6","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61d10ef13f8a836aa0deddb6-1644446597332.gif"}},"verified":true,"views":68570,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-02-20T14:49:29.9