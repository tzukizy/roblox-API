{"slug":"Universal-Script-Anti-curve-for-silient-aim-41935","_id":"6844521f6d2cd244aa6f92e2","title":"Anti curve for silient aim","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1749307935466.png","placeId":0},"features":"makes silient aim look more legit\n(Not mine)","tags":["silient aim","curve","anticurve","anti"],"script":"``` AntiCurve = function()\n    if utility[\"Miscellaneous\"][\"Anti Curve\"] and utility[\"Silent Aim\"][\"Active\"] then\n        local character = LocalPlayer.Character\n        if character and character.PrimaryPart then\n            local characterCf = character.PrimaryPart.CFrame\n            local target, _ = GetClosestPlayer()\n            if target then\n                local targetPos = target.Position\n                local charPos = character.PrimaryPart.Position\n                character:SetPrimaryPartCFrame(CFrame.lookAt(charPos, Vector3.new(targetPos.X, charPos.Y, targetPos.Z)))\n                wait()\n                character:SetPrimaryPartCFrame(characterCf)\n            end\n        end\n    end\nend ```","owner":{"_id":"68239133394ad364e6422e5e","username":"jailcase","verified":false,"profilePicture":"/images/photo/68239133394ad364e6422e5e-1748033869068.jpg","status":"offline","id":"68239133394ad364e6422e5e","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord.gg/tQKnAxqjTX","views":2415,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1749307935466.png","likeCount":1,"dislikeCount":1,"createdAt":"2025-06-07T14:52:15.522Z","executes":191,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6844521f6d2cd244aa6f92e4","editBy":{"_id":"68239133394ad364e6422e5e","username":"jailcase","status":"offline","id":"68239133394ad364e6422e5e"},"message":"Create script","createdAt":"2025-06-07T14:52:15.523Z"}],"comments":[{"_id":"68446