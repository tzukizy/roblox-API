e\"))\n\nlocal size = 28\n\nif getgenv().Hitbox_Expander then getgenv().Hitbox_Expander() end\n\nlocal old = getgenv().DidHit or base.DidHit\ngetgenv().DidHit = old\n\nlocal ball = Instance.new(\"Part\")\nball.Name = \"hitbox\"\nball.Shape = Enum.PartType.Ball\nball.Size = Vector3.new(1, 1, 1) * (size * 2)\nball.Transparency = 0.8\nball.Material = Enum.Material.ForceField\nball.Color = Color3.fromRGB(0, 255, 0)\nball.Anchored = true\nball.CanCollide = false\nball.CanQuery = false\nball.CanTouch = false\nball.CastShadow = false\nball.Parent = workspace\n\nlocal con\ncon = RS.RenderStepped:Connect(function()\n\tlocal char = Players.LocalPlayer.Character\n\tif char then\n\t\tlocal hrp = char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tball.CFrame = hrp.CFrame\n\t\t\treturn\n\t\tend\n\tend\n\tball.CFrame = CFrame.new(0, -10000, 0)\nend)\n\nbase.DidHit = function(self, pos, radius)\n\treturn old(self, pos, size)\nend\n\ngetgenv().Hitbox_Expander = function()\n\tif con then\n\t\tcon:Disconnect()\n\t\tcon = nil\n\tend\n\tif ball then\n\t\tball:Destroy()\n\tend\n\tbase.DidHit = old\n\tgetgenv().Hitbox_Expander = nil\nend","features":"🎾 Racket Rivals Script 🎾\n\nATENTION!\nThis script is open source. I will not update it.","tags":["racket rivals racketrivals racket","hitbox expander range expander hitbox increase","open source open src opensource opensrc opensrc","free keyless","roblox"],"discord":"","keyLink":"","owner":{"_id":"66ef6fb6ddb8023370650768","username":"Arquive","verified":false,"profilePicture":{"url":"https://media.kocakz.me/18b7cbe9b2505a5b4c063e0e87d6016ace68fd6438ee057594067c85d2c79b31.webp","original":"https://scriptblox.com/images/photo/66ef6fb6ddb8023370650768-1792009542252.png"},"lvl":10,"status":"offline","id":"66ef6fb6ddb8023370650768","leaderboard":{"tag":null},"topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/18b7cbe9b2505a5b4c063e0e87d6016ace68fd6438ee057594067c85d2c79b31.webp","original":"