{"slug":"Universal-Script-Infinite-Jump-111379","_id":"6990b3e3473764a076966eae","title":"Infinite Jump","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"-- // you can jump alot of times\n-- verifys if player is ready to try the infjump\n-- has cooldown (remove if you want)","tags":[],"script":"-- // Infinite Jump\n-- made by: user_45374756745438 // Client-Sided (does not affect all Players)\n-- this is current\n\nlocal Configuration = JumpConfiguration()\nprint(\"setting configuration..\")\nlocal gameVerify = \"gameVerified\"\nprint(gameVerify)\ntask.wait(2)\nlocal UIS = game:GetService(\"UserInputService\")\nlocal player = game.Players.LocalPlayer \nlocal function onJumpRequest()\n    local character = player.Character\n    if not character then return end\n\n    local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    if not humanoid then return end\n\nhumanoid:ChangeState(Enum.HumanoidStateType.Jumping) -- checks if player is Jumping\nend\n\nUIS.JumpRequest:Connect(onJumpRequest)\n\n\n-- // made in Xeno\n-- //Edited By LuaScripter\n-- // 2/11/26","owner":{"_id":"69850c744bfacc34692cb6ac","username":"SigmaPenguin","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e0e6f7cc85ae1fe8067f1ad85ff591c200193fd9a2eff69f0d1339ea59073f47.webp","original":"https://scriptblox.com/images/photo/69850c744bfacc34692cb6ac-1773874536298.png"},"status":"offline","id":"69850c744bfacc34692cb6ac","profile":{"url":"https://media.kocakz.me/e0e6f7cc85ae1fe8067f1ad85ff591c200193fd9a2eff69f0d1339ea59073f47.webp","original":"https://scriptblox.com/images/photo/69850c744bfacc34692cb6ac-1773874536298.png"}},"verified":false,"views":581,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/b68829a428d25