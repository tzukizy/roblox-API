{"slug":"Universal-Script-Touch-Fling-126615","_id":"69a48d8d99c366843291203a","title":"Touch Fling","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1772391821798.png","placeId":0},"features":"- Working in most games \n- Not as detected but still will be in some games","tags":[],"script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\tlocal RunService = game:GetService(\"RunService\")\n\tlocal Players = game:GetService(\"Players\")\n\t\n\tlocal function fling()\n\t\tlocal Player1 = Players.LocalPlayer\n\t\tlocal character, hrp, velo, movel = nil, nil, nil, 0.1\n\t\n\t\twhile true do\n\t\t\tRunService.Heartbeat:Wait()\n\t\t\tcharacter = Player1.Character\n\t\t\thrp = character and character:FindFirstChild(\"HumanoidRootPart\")\n\t\n\t\t\tif hrp then\n\t\t\t\tvelo = hrp.Velocity -- saves current \n\t\t\t\thrp.Velocity = velo * 10000 + Vector3.new(0, 10000, 0) -- ur orginal velocity times 10000 and adds 10000 to the y axis\n\t\t\t\tRunService.RenderStepped:Wait() \n\t\t\t\thrp.Velocity = velo -- sets it back cus you fly with them\n\t\t\t\tRunService.Stepped:Wait()\n\t\t\tend\n\t\tend\n\tend\n\t\n\tfling()","owner":{"_id":"6958169312e556facd862a0d","username":"rhetoric","verified":false,"profilePicture":"/images/photo/6958169312e556facd862a0d-1776945879537.png","status":"offline","id":"6958169312e556facd862a0d","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":3989,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1772391821798.png","likeCount":2,"dislikeCount":1,"createdAt":"2026-03-01T19:03:41.823Z","executes":12771,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":12030,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a48d8d99c366843291203d","editBy":{"_id":"6958169312e556facd862a0d","username":"rhetoric","st