{"slug":"Universal-Script-Touch-Fling-126615","_id":"69a48d8d99c366843291203a","title":"Touch Fling","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"- Working in most games \n- Not as detected but still will be in some games","tags":[],"script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\tlocal RunService = game:GetService(\"RunService\")\n\tlocal Players = game:GetService(\"Players\")\n\t\n\tlocal function fling()\n\t\tlocal Player1 = Players.LocalPlayer\n\t\tlocal character, hrp, velo, movel = nil, nil, nil, 0.1\n\t\n\t\twhile true do\n\t\t\tRunService.Heartbeat:Wait()\n\t\t\tcharacter = Player1.Character\n\t\t\thrp = character and character:FindFirstChild(\"HumanoidRootPart\")\n\t\n\t\t\tif hrp then\n\t\t\t\tvelo = hrp.Velocity -- saves current \n\t\t\t\thrp.Velocity = velo * 10000 + Vector3.new(0, 10000, 0) -- ur orginal velocity times 10000 and adds 10000 to the y axis\n\t\t\t\tRunService.RenderStepped:Wait() \n\t\t\t\thrp.Velocity = velo -- sets it back cus you fly with them\n\t\t\t\tRunService.Stepped:Wait()\n\t\t\tend\n\t\tend\n\tend\n\t\n\tfling()","owner":{"_id":"6958169312e556facd862a0d","username":"rhetoric","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1536bc0bee436e06e545fe6db8859614ecb3f782c3cc92323a0076f2f14969d7.webp","original":"https://scriptblox.com/images/photo/6958169312e556facd862a0d-1776945879537.png"},"status":"offline","id":"6958169312e556facd862a0d","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/1536bc0bee436e06e545fe6db8859614ecb3f782c3cc92323a0076f2f14969d7.webp","original":"https://scriptblox.com/images/photo/6958169312e556facd862a0d-1776945879537.png"}},"verified":false,"views":4047,"scriptType":"free","isUniversal":true,"isPatched":false,