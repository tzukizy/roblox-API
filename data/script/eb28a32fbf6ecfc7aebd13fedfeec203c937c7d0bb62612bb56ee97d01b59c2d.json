{"_id":"6a8550f5891795e6c8b9ac42","title":"Headless (R6/R15)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Headless-(R6R15)-224493","verified":false,"key":false,"keyless":false,"views":2015,"executes":99363,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c069bc2a3b714dd58d6a09b1824a5536703581b5c9deaf678c2c209745072d38.webp","original":"https://scriptblox.com/images/sb/0-1787121909329.png","scriptblox":"https://scriptblox.com/images/script/0-1787121909329.png"},"thumbnail":{"url":"https://media.kocakz.me/c069bc2a3b714dd58d6a09b1824a5536703581b5c9deaf678c2c209745072d38.webp","original":"https://scriptblox.com/images/sb/0-1787121909329.png","scriptblox":"https://scriptblox.com/images/script/0-1787121909329.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-08-19T06:45:09.345Z","updatedAt":"2026-08-19T06:45:09.345Z","lastBump":"2026-08-19T06:45:09.345Z","script":"-- Headless (R6/R15) — By SHIRANEZ\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Player = Players.LocalPlayer\nlocal Connection\n\nlocal function ApplyHeadless(Character)\n    if Connection then\n        Connection:Disconnect()\n        Connection = nil\n    end\n\n    local Head = Character:WaitForChild(\"Head\", 10)\n    if not Head then\n        return\n    end\n\n    Head.LocalTransparencyModifier = 1\n\n    Connection = RunService.RenderStepped:Connect(function()\n        if not Character.Parent or not Head.Parent then\n            Connection:Disconnect()\n            Connection = nil\n            return\n        end\n\n        Head.LocalTransparencyModifier = 1\n    end)\nend\n\nPlayer.CharacterAdded:Connect(function(Character)\n    task.wait(0.1)\n    ApplyHeadless(Character)\nend)\n\nif Player.Character then\n    task.spawn(function()\n        ApplyHeadless(Player.Character)\n    end)\nend","features":"Simple Headless script for R6/R15.","tags":["Headless","Head"],"discord":"","keyLink":"","owner":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a5ba47d9007166696a6d588","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:16:40.330Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a8550f5891795e6c8b9ac44","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"message":"Create script","createdAt":"2026-08-19T06:45:09.348Z"},{"_id":"6a8803198251aa67453b9fda","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"message":"Update script","createdAt":"2026-08-21T07:49:45.073Z"},{"_id":"6a8fef31813480dd8db8fb28","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"message":"Update script","createdAt":"2026-08-27T08:02:57.297Z"}],"comments":[{"_id":"6a8676df72b4a6d81ca061ca","commentBy":{"_id":"6a743107341f4c88ed4f95d9","username":"QASDFN114514","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-09-10T11:44:02.048Z","createdAt":"2026-08-06T07:00:23.482Z","status":"offline","id":"6a743107341f4c88ed4f95d9","profile":{"url":"https://media.kocak