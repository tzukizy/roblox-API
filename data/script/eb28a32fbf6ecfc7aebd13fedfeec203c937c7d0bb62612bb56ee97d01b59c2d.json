{"slug":"Universal-Script-Headless-(R6R15)-224493","_id":"6a8550f5891795e6c8b9ac42","title":"Headless (R6/R15)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1787121909329.png","placeId":0},"features":"Simple Headless script for R6/R15.","tags":["Headless","Head"],"script":"-- Headless (R6/R15) — By SHIRANEZ\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Player = Players.LocalPlayer\nlocal Connection\n\nlocal function ApplyHeadless(Character)\n    if Connection then\n        Connection:Disconnect()\n        Connection = nil\n    end\n\n    local Head = Character:WaitForChild(\"Head\", 10)\n    if not Head then\n        return\n    end\n\n    Head.LocalTransparencyModifier = 1\n\n    Connection = RunService.RenderStepped:Connect(function()\n        if not Character.Parent or not Head.Parent then\n            Connection:Disconnect()\n            Connection = nil\n            return\n        end\n\n        Head.LocalTransparencyModifier = 1\n    end)\nend\n\nPlayer.CharacterAdded:Connect(function(Character)\n    task.wait(0.1)\n    ApplyHeadless(Character)\nend)\n\nif Player.Character then\n    task.spawn(function()\n        ApplyHeadless(Player.Character)\n    end)\nend","owner":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6a5ba47d9007166696a6d588","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":1777,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1787121909329.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-08-19T06:45:09.345Z","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"keyLink":"","executes":90102,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":72055,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a8550f5891795e6c8b9ac44","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"message":"Create script","createdAt":"2026-08-19T06:45:09.348Z"},{"_id":"6a8803198251aa67453b9fda","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"message":"Update script","createdAt":"2026-08-21T07:49:45.073Z"},{"_id":"6a8fef31813480dd8db8fb28","editBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","status":"offline","id":"6a5ba47d9007166696a6d588"},"message":"Update script","createdAt":"2026-08-27T08:02:57.297Z"}],"comments":[{"_id":"6a8676df72b4a6d81ca061ca","commentBy":{"_id":"6a743107341f4c88ed4f95d9","username":"QASDFN114514","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-09-10T11:44:02.048Z","createdAt":"2026-08-06T07:00:23.482Z","status":"offline","id":"6a743107341f4c88ed4f95d9"},"text":"fe?","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-08-20T03:39:11.641Z","liked":false,"disliked":false},{"_id":"6a86a61fd8a90440610f7985","commentBy":{"_id":"6a5ba47d9007166696a6d588","username":"ShiraneZ","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-08-27T09:47:20.469Z","createdAt":"2026-07-18T16:06:21.263Z","status":"offline","id":"6a5ba47d9007166696a6d588","topMilestone":{"key":"creator.executions","tier":10000}},"text":"@QASDFN114514 No","parent":{"_id":"6a8676df72b4a6d81ca061ca","commentBy":{"_id":"6a743107341f4c88ed4f95d9","username":"QASDFN114514","profilePicture":"/images/user-default.webp","status":"offline","id":"6a743107341f4c88ed4f95d9"},"text":"fe?"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-08-20T07:00:47.075Z","liked":false,"disliked":false},{"_id":"6a86c6308051e0ba41843d34","commentBy":{"_id