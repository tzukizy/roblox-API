{"_id":"6903cc7c9abd44ae7b2201cb","title":"triger bot open source","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/51b63c2e437393f3e2fb574a98e98f02a9e274afdab97a6073cbaa7a773020ab.webp","original":"https://scriptblox.com/images/sb/0-1761856636523.webp"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/51b63c2e437393f3e2fb574a98e98f02a9e274afdab97a6073cbaa7a773020ab.webp","original":"https://scriptblox.com/images/sb/0-1761856636523.webp"},"placeId":0},"slug":"Universal-Script-triger-bot-open-source-61915","verified":false,"key":false,"keyless":false,"views":1394,"executes":243,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/fb7ae69718613ea07c69961ab3e61eee62d73c0b24244ceb14e9dbe4742f2bdc.webp","original":"https://scriptblox.com/images/sb/0-1761856636523.webp","scriptblox":"https://scriptblox.com/images/script/0-1761856636523.webp"},"thumbnail":{"url":"https://media.kocakz.me/fb7ae69718613ea07c69961ab3e61eee62d73c0b24244ceb14e9dbe4742f2bdc.webp","original":"https://scriptblox.com/images/sb/0-1761856636523.webp","scriptblox":"https://scriptblox.com/images/script/0-1761856636523.webp"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-10-30T20:37:16.547Z","updatedAt":"2025-10-30T20:37:16.547Z","lastBump":"2025-10-30T20:37:16.547Z","script":"--open source made by Rayan if you want to skid this atleast give me credits\n--to toggle this press P or edit the script to choose a key\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Camera = workspace.CurrentCamera\nlocal Mouse = LocalPlayer:GetMouse()\n\nlocal enabled = true\nlocal shootDelay = 0.0007\nlocal lastShot = 0\n\nlocal function findGun()\n    local character = LocalPlayer.Character\n    if not character then return nil end\n    \n    for _, obj in pairs(character:GetDescendants()) do\n        if obj:IsA(\"Tool\") or obj.Name:lower():find(\"gun\") or obj.Name:lower():find(\"rifle\") then\n            return obj\n        end\n    end\n    \n    local backpack = LocalPlayer:FindFirstChild(\"Backpack\")\n    if backpack then\n        for _, tool in pairs(backpack:GetChildren()) do\n            if tool:IsA(\"Tool\") then\n                return tool\n            end\n        end\n    end\n    \n    return nil\nend\n\nlocal function isPlayerOnCursor()\n    local mousePos = UserInputService:GetMouseLocation()\n    \n    for _, player in pairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Character then\n            local character = player.Character\n            local humanoid = character:FindFirstChild(\"Humanoid\")\n            local rootPart = character:FindFirstChild(\"HumanoidRootPart\") or character:FindFirstChild(\"Torso\")\n            \n            if humanoid and rootPart and humanoid.Health > 0 then\n                local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)\n                \n                if onScreen then\n                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude\n                    \n                    if distance < 80 then\n                        return true, player\n                    end\n                end\n            end\n        end\n    end\n    \n    return false, nil\nend\n\nlocal function autoShoot()\n    mouse1press = mouse1press or function()\n        local vim = game:GetService(\"VirtualInputManager\")\n        vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)\n        wait(0.01)\n        vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)\n    end\n    \n    mouse1press()\nend\n\nRunService.Heartbeat:Connect(function()\n    if not enabled then return end\n    \n    local currentTime = tick()\n    if currentTime - lastShot < shootDelay then return end\n    \n    local targeting, targetPlayer = isPlayerOnCursor()\n    \n    if targeting then\n        autoShoot()\n        lastShot = currentTime\n        \n        local tool = findGun()\n        if tool and tool:IsA(\"Tool\") then\n            tool:Activate()\n        end\n    end\nend)\n\nUserInputService.InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.P then\n        enabled = not enabled\n        print(\"Triggerbot:\", enabled and \"ON\" or \"OFF\")\n    end\nend)","features":"i made it open source","tags":["morocco"],"discord":"https://discord.gg/cTtSbvBW96","keyLink":"","owner":{"_id":"67c090c41999b9ae39226cd8","username":"rayanito86x","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fd17b02f93cec1aeee5e57db56de453040c6f979195b847ccfbace19415a853e.webp","original":"https://scriptblox.com/images/photo/67c090c41999b9ae39226cd8-1741377758091.jpg"},"status":"offline","id":"67c090c41999b9ae39226cd8","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/fd17b02f93cec1aeee5e57db56de453040c6f979195b847ccfbace19415a853e.webp","original":"https://scriptblox.com/images/photo/67c090c41999b9ae39226cd8-1741377758091.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:39:20.757Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6903cc7c9abd44ae7b2201cd","editBy":{"_id":"67c090c41999b9ae39226cd8","username":"rayanito86x","status":"offline","id":"67c090c41999b9ae39226cd8"},"message":"Create script","createdAt":"2025-10-30T20:37:16.550Z"},{"_id":"6903cd5de341daaafae371ff","editBy":{"_id":"67c090c41999b9ae39226cd8","username":"rayanito86x","status":"offline","id":"67c090c41999b9ae39226cd8"},"message":"Update script","createdAt":"2025-10-30T20:41:01.942Z"}],"co