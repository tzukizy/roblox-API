{"_id":"682986f847c4ba573406c660","title":"Auto Type open source","game":{"_id":"67e5e1ffb360710ec3c781e7","gameId":105055747082176,"name":"Scary Spelling","imageUrl":{"url":"https://media.kocakz.me/f7c89ba99cfe05cde94ca7bc9e8cb6a8a2d1fa396dc824f0edac1168b9d1c46d.webp","original":"https://tr.rbxcdn.com/180DAY-2dc3ab809545981329f93fb25ac68bc9/150/150/Image/Png/noFilter"},"slug":"105055747082176-scary-spelling","path":"/game/105055747082176-scary-spelling","thumbnail":{"url":"https://media.kocakz.me/f7c89ba99cfe05cde94ca7bc9e8cb6a8a2d1fa396dc824f0edac1168b9d1c46d.webp","original":"https://tr.rbxcdn.com/180DAY-2dc3ab809545981329f93fb25ac68bc9/150/150/Image/Png/noFilter"},"placeId":105055747082176},"slug":"Scary-Spelling-Auto-Type-open-source-40177","verified":false,"key":false,"keyless":false,"views":11391,"executes":1654,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/7eccfa4ef41972dbac5367bb1094e6c974a1bfbcef99f33281aafac203e69784.webp","original":"https://scriptblox.com/images/sb/105055747082176-1747551992520.webp","scriptblox":"https://scriptblox.com/images/script/105055747082176-1747551992520.webp"},"thumbnail":{"url":"https://media.kocakz.me/7eccfa4ef41972dbac5367bb1094e6c974a1bfbcef99f33281aafac203e69784.webp","original":"https://scriptblox.com/images/sb/105055747082176-1747551992520.webp","scriptblox":"https://scriptblox.com/images/script/105055747082176-1747551992520.webp"},"likeCount":1,"dislikeCount":5,"createdAt":"2025-05-18T07:06:32.567Z","updatedAt":"2025-05-18T07:06:32.567Z","lastBump":"2025-05-18T07:06:32.567Z","script":"getgenv().settings = {\n    auto_type = true;\n    smart_delay = {\n        enabled = true;\n        delay = {0.2, 0.8};\n    }\n};\n\nif (getgenv().execute) then\n    return;\nend;\n\ngetgenv().execute = true;\n\n-- variables\nlocal marketplace_service = game:GetService(\"MarketplaceService\");\nlocal replicated_storage = game:GetService(\"ReplicatedStorage\");\nlocal run_service = game:GetService(\"RunService\");\nlocal players = game:GetService(\"Players\");\nlocal local_player = players.LocalPlayer;\n\n-- script variables\nlocal vk_codes = {a = 0x41, b = 0x42, c = 0x43, d = 0x44, e = 0x45, f = 0x46, g = 0x47, h = 0x48, i = 0x49, j = 0x4A, k = 0x4B, l = 0x4C, m = 0x4D, n = 0x4E, o = 0x4F, p = 0x50, q = 0x51, r = 0x52, s = 0x53, t = 0x54, u = 0x55, v = 0x56, w = 0x57, x = 0x58, y = 0x59, z = 0x5A};\nlocal main_remote = replicated_storage.Events.GameEvent;\nlocal current_word;\n\n-- functions\nlocal remove_number = function(word)\n    return word:gsub(\"%s?%(%d+%)\", \"\"); -- remove the number shit (yes I stole this)\nend;\n\nlocal random_delay = function(min, max)\n    return min + math.random() * (max - min);\nend;\n\nlocal get_smart_delay = function()\n    return random_delay(getgenv().settings[\"smart_delay\"][\"delay\"][1], getgenv().settings[\"smart_delay\"][\"delay\"][2]) * 0.2;\nend;\n\nlocal input_word = function(word)\n    task.wait(random_delay(1.4, 2));\n    print(\"word inputted\", word);\n    for i = 1, #word do\n        local char = word:sub(i, i);\n        local key_code = vk_codes[char:lower()];\n        keypress(key_code);\n        keyrelease(key_code);\n        if (getgenv().settings[\"smart_delay\"][\"enabled\"]) then\n            task.wait(get_smart_delay());\n        end;\n    end;\n    keypress(0x0D);\n    keyrelease(0x0D);\nend;\n\n-- connection (get word)\ngame.DescendantAdded:Connect(function(v)\n    if (v:IsA(\"Sound\")) then\n        local id = string.match(v.SoundId, \"%d+\");\n        if (id and not v.Parent) then\n            -- variables\n            local sound_info = marketplace_service:GetProductInfo(id);\n            local correct_one,_ = pcall(function()\n                v.Parent = workspace;\n            end);\n\n            -- check\n            if (correct_one) then\n                v.Volume = 0;\n                v:Destroy();\n                current_word = remove_number(sound_info.Name);\n                task.wait(v.TimeLength);\n                input_word(current_word);\n            end;\n        end;\n    end;\nend);","features":"auto type with legit delay settings","tags":["open source","script"],"discord":"","keyLink":"","owner":{"_id":"6340eade631041248b2afc4b","username":"Efial","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6340eade631041248b2afc4b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:01:17.366Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"682986f847c4ba573406c662","editBy":{"_id":"6340eade631041248b2afc4b","username":"Efial","status":"offline","id":"6340eade631041248b2afc4b"},"message":"Create script","createdAt":"2025-05-18T07:06:32.569Z"}],"comments":[{"_id":"6829ad187373588c0fa5891f","commentBy":{"_id":"6811bfbb8a886f65e3e0eed0","username":"GoofyAhScript","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/4ccc720a0d07ec5f28a84d71c95a8286d225c1b65d0d65f6e96583500d8c5bce.webp","original":"https://scriptblox.com/images/photo/6811bfbb8a886f65e3e0eed0-1775185334458.jpg"},"createdAt":"2025-04-30T06:14:19.092Z","lastActive":"2026-05-18T15:17:35.745Z","status":"offline","id":"6811bfbb8a886f65e3e0eed0","profile":{"url":"https://media.kocakz.me/4ccc720a0d07ec5f28a84d71c95a8286d225c1b65d0d65f6e96583500d8c5bce.webp","original":"https://scriptblox.com/images/photo/6811bfbb8a886f65e3e0eed0-1775185334458.jpg"}},"text":"Not working on mobile","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-05-18T09:49:12.346Z","liked":false,"disliked":false},{"_id":"6829c4a391a0eb0db319a46d","c