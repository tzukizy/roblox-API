Scripts\")\nlocal sec2 = tab:Section(\"LocalScripts\")\nfor i, v in game:GetDescendants() do\n local name;\n if v.Parent ~= nil then\n  name = v.Parent.Name .. \"/\" .. v.Name\n else\n  name = \"getnilinstances()['\" .. v.Name .. \"']\"\n end\n if v:IsA(\"ModuleScript\") then\n  sec1:Button(name, function()\n   print(decompile(v))\n  end)\n elseif v:IsA(\"LocalScript\") then\n  sec2:Button(name, function()\n   print(decompile(v))\n  end)\n end\nend","features":"vUtility (vxsty's utility) is a UI for SimpleDecompile since people have been asking for it\nFeatures:\nModuleScript decompiler, LocalScript decompiler, Shows parent's name if parent exists, otherwise getnilinstances()['name']\nPRINTS DECOMPILED RESULT TO CONSOLE.","tags":["simpledecompile","decompiler","keyless","free","op"],"discord":"","keyLink":"","owner":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"profilePicture":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"},"status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13469934}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:12:14.390Z","last":"w","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c154","editBy":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","status":"offline","id":"64cb81f82512701e9a163c00"},"message":"Create script","createdAt":"202