{"_id":"678aab98b05b0036d07f1e5e","title":"Blinded  chaser Ruiner","game":{"_id":"67e5e1ffb360710ec3c78989","gameId":10873387885,"name":"[LOBBY] DOORS but kinda cheap and shorter","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"10873387885-doors-but-kinda-cheap-and-shorter","path":"/game/10873387885-doors-but-kinda-cheap-and-shorter","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":10873387885},"slug":"BOSS-FIGHT-DOORS-but-kinda-cheap-and-shorter-Blinded-chaser-Ruiner-27045","verified":false,"key":false,"keyless":false,"views":5323,"executes":185,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-e893258a4d604e9896a6d1e97d37b030/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-e893258a4d604e9896a6d1e97d37b030/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-e893258a4d604e9896a6d1e97d37b030/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-e893258a4d604e9896a6d1e97d37b030/500/280/Image/Jpeg/noFilter"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-01-17T19:12:24.249Z","updatedAt":"2025-01-17T19:12:24.249Z","lastBump":"2025-01-17T19:12:24.249Z","script":"local Noob = game.Workspace:FindFirstChild(\"Noob\") -- Check for Noob in workspace\nlocal Blinded = game.Workspace:FindFirstChild(\"Blinded\") -- Check for Blinded\nlocal camera = game.Workspace.CurrentCamera\n\n-- Function to create warning GUI\nlocal function createWarningGui()\n    local player = game.Players.LocalPlayer\n    local screenGui = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\n    screenGui.Name = \"WarningGui\"\n\n    local warningLabel = Instance.new(\"TextLabel\", screenGui)\n    warningLabel.Size = UDim2.new(0.5, 0, 0.1, 0)\n    warningLabel.Position = UDim2.new(0.25, 0, 0.45, 0)\n    warningLabel.BackgroundColor3 = Color3.new(1, 0, 0)\n    warningLabel.TextColor3 = Color3.new(1, 1, 1)\n    warningLabel.Font = Enum.Font.SourceSansBold\n    warningLabel.TextSize = 24\n    warningLabel.Text = \"Warning: Noob is not in the workspace!\"\n    \n    -- Destroy the GUI after 5 seconds\n    task.delay(1, function()\n        screenGui:Destroy()\n    end)\nend\n\nwhile true do\n    Noob = game.Workspace:FindFirstChild(\"Noob\")\n    if Noob then\n        camera.FieldOfView = 120\n        Blinded.Humanoid.WalkSpeed = 200\n        Noob.Humanoid.WalkSpeed = 200\n    else\n        createWarningGui()\nwait(2)\n    end\n    wait(0.9)\nend","features":"sets blinded speed and chaser speed to 200.","tags":[],"discord":"","keyLink":"","owner":{"_id":"676c3b68b0b1a414d2f212b3","username":"tomidbkcas","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"676c3b68b0b1a414d2f212b3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:01:43.327Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d69d","editBy":{"_id":"676c3b68b0b1a414d2f212b3","username":"tomidbkcas","status":"offline","id":"676c3b68b0b1a414d2f212b3"},"message":"Create script","createdAt":"2025-01-18T18:40:47.957Z"},{"_id":"67e5e1e3b360710ec3c4d69e","editBy":{"_id":"676c3b68b0b1a414d2f212b3","username":"tomidbkcas","status":"offline","id":"676c3b68b0b1a414d2f212b3"},"message":"Update script","createdAt":"2025-01-19T07:12:29.626Z"},{"_id":"67e5e1e7b360710ec3c542fe","editBy":{"_id":"676c3b68b0b1a414d2f212b3","username":"tomidbkcas","status":"offline","id":"676c3b