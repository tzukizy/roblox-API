{"slug":"Universal-Script-basic-FPS-counter-15550","_id":"669554813185c133be88ab84","title":"basic FPS counter","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/4125557-1721062529238.png","placeId":0},"features":"This script gives you the number of fps that it gives you within the game. This script is programmed to have no counter limit. If it goes to 1000 fps, the counter will show it.","tags":[],"script":"local screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = game.CoreGui\n\nlocal fpsLabel = Instance.new(\"TextLabel\")\nfpsLabel.Size = UDim2.new(0, 200, 0, 50)\nfpsLabel.Position = UDim2.new(1, -200, 0, 0) -- Upper right corner\nfpsLabel.BackgroundTransparency = 1\nfpsLabel.TextColor3 = Color3.new(1, 1, 1)\nfpsLabel.Font = Enum.Font.SourceSansBold\nfpsLabel.TextScaled = true\nfpsLabel.Parent = screenGui\n\nlocal lastTime = tick()\nlocal frames = 0\n\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n    frames = frames + 1\n    local currentTime = tick()\n    if currentTime - lastTime >= 1 then\n        fpsLabel.Text = \"FPS: \" .. tostring(frames)\n        frames = 0\n        lastTime = currentTime\n    end\nend)","owner":{"_id":"667aeafae1255dc2e5c98509","username":"Noxy_ZT1","verified":false,"profilePicture":"/images/photo/667aeafae1255dc2e5c98509-1719332161806.jpg","status":"offline","id":"667aeafae1255dc2e5c98509","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":50445,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-07-15T16:55:29.341Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/4125557-1721062529238.png","executes":392,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c515f5","editBy":{"_id":"667aeafae1255dc2e5c98509","username":"Noxy_ZT1","status":"offline","id":"667aeafae1255dc2e5c98509"},"message":"Create script","createdAt":"2025-03-27T22:27:21.956Z"}],"comments":[{"_id":"669580eda01171299b4f860c","commentBy":{"_id":"662e9bbcc5d4b029990f43e2","username":"tencil","verified":false,"role":"user","profilePicture":"/images/photo/662e9bbcc5d4b029990f43e2-1714330647722.jpeg","createdAt":"2024-04-28T18:55:56.155Z","lastActive":"2026-07-24T10:58:29.070Z","status":"offline","id":"662e9bbcc5d4b029990f43e2","topMilestone":{"key":"creator.first_script","tier":1}},"text":"add ping","createdAt":"2024-07-15T20:05:01.157Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"66961cb99509bfc77894bec0","commentBy":{"_id":"663bdfd54d8171671b024bab","username":"Xiamoi","verified":false,"role":"user","profilePicture":"/images/photo/663bdfd54d8171671b024bab-1715200391441.png","createdAt":"2024-05-08T20:25:57.455Z","lastActive":"2024-10-21T09:50:46.753Z","status":"offline","id":"663bdfd54d8171671b024bab","topMilestone":{"key":"creator.scripts","tier":10}},"text":"mines better lowkey (it has ping): https://scriptblox.com/script/Universal-Script-Simple-FPS-Viewer-15556","createdAt":"2024-07-16T07:09:45.454Z","edited":true,"dislikeCount":0,"likeCount":1,"liked":false,"disliked":false}]}