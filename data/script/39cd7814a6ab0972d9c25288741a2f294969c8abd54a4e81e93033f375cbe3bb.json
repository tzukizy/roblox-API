{"slug":"12H-Brainrot-Jumping-Unlimited-Jump-Boost-59435","_id":"68f491b9c7a3bc90bfb71b87","title":"Unlimited Jump Boost","game":{"_id":"68c762a0b4f75ef997a4a1f7","gameId":88829149289682,"name":"Brainrot Jumping","imageUrl":"/images/sb/rbx-ea89bea724f1f88b32c07ab3048c81b0-90bbc1d8f381.png","placeId":88829149289682},"features":"Gives a crazy high jump boost","tags":[],"script":"local plr = game.Players.LocalPlayer\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal hum = char:WaitForChild(\"Humanoid\")\n\nhum.StateChanged:Connect(function(_, new)\n\tif new == Enum.HumanoidStateType.Jumping then\n\t\tspawn(function()\n\t\t\tlocal velocity = 50000\n\t\t\twhile hrp and hrp.Parent do\n\t\t\t\thrp.AssemblyLinearVelocity = Vector3.new(0, velocity, 0)\n\t\t\t\tvelocity = velocity * 2\n\t\t\t\ttask.wait(0.005)\n\t\t\tend\n\t\tend)\n\tend\nend)","owner":{"_id":"68e165b125350ed29c0366e8","username":"meowtology","verified":false,"profilePicture":"/images/photo/68e165b125350ed29c0366e8-1760696662142.jpg","status":"offline","id":"68e165b125350ed29c0366e8","leaderboard":{"tag":null},"topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":2127,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/88829149289682-1760858553151.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2025-10-19T07:22:33.169Z","editBy":{"_id":"68e165b125350ed29c0366e8","username":"meowtology","status":"offline","id":"68e165b125350ed29c0366e8"},"executes":397,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f491b9c7a3bc90bfb71b89","editBy":{"_id":"68e165b125350ed29c0366e8","username":"meowtology","status":"offline","id":"68e165b125350ed29c0366e8"},"message":"Create script","createdAt":"2025-10-19T07:22:33.175Z"},{"_id":"68f49292811805ab09e2d977","editBy":{"_id":"68e165b125350ed29c0366e8","username":"meowtology","status":"offline