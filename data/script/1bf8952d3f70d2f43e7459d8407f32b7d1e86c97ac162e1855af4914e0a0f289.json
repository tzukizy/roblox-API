{"_id":"68527b24bb2d617bd66912f9","title":"Humanoid Position Finder","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/c4dfe57c3bb943fa3560d5bee83fb05e2bd18e54a813af54e03924bcff956d9c.webp","original":"https://scriptblox.com/images/sb/0-1750238179832.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/c4dfe57c3bb943fa3560d5bee83fb05e2bd18e54a813af54e03924bcff956d9c.webp","original":"https://scriptblox.com/images/sb/0-1750238179832.png"},"placeId":0},"slug":"Universal-Script-Humanoid-Position-Finder-42623","verified":false,"key":false,"keyless":false,"views":19662,"executes":25,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/312453a39b7bf92884d02588d59bca27fb2522a1da27e0ac54ad75ae5d05eeb0.webp","original":"https://scriptblox.com/images/sb/0-1750238179832.png","scriptblox":"https://scriptblox.com/images/script/0-1750238179832.png"},"thumbnail":{"url":"https://media.kocakz.me/312453a39b7bf92884d02588d59bca27fb2522a1da27e0ac54ad75ae5d05eeb0.webp","original":"https://scriptblox.com/images/sb/0-1750238179832.png","scriptblox":"https://scriptblox.com/images/script/0-1750238179832.png"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-06-18T08:39:00.488Z","updatedAt":"2025-06-18T08:39:00.488Z","lastBump":"2025-06-18T08:39:00.488Z","script":"--[[\n    📍 Position Copy GUI\n    Made by synt.t\n--]]\n\nlocal plr = game:GetService(\"Players\").LocalPlayer\nlocal savedPositions = {}\n\n-- GUI\nlocal gui = Instance.new(\"ScreenGui\", game.CoreGui)\ngui.Name = \"PositionCopier\"\n\nlocal frame = Instance.new(\"Frame\", gui)\nframe.Size = UDim2.new(0, 400, 0, 250)\nframe.Position = UDim2.new(0.5, -200, 0.5, -125)\nframe.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Draggable = true\n\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1, 0, 0, 50)\ntitle.BackgroundTransparency = 1\ntitle.Text = \"📍 Position Copier | by synt.t\"\ntitle.TextScaled = true\ntitle.Font = Enum.Font.GothamBold\ntitle.TextColor3 = Color3.fromRGB(255, 255, 255)\n\n-- Rainbow title animation\ntask.spawn(function()\n\twhile true do\n\t\tfor i = 0, 1, 0.01 do\n\t\t\ttitle.TextColor3 = Color3.fromHSV(i, 1, 1)\n\t\t\ttask.wait(0.02)\n\t\tend\n\tend\nend)\n\n-- Button creator\nlocal function createBtn(text, posY, callback)\n\tlocal btn = Instance.new(\"TextButton\", frame)\n\tbtn.Size = UDim2.new(0, 360, 0, 40)\n\tbtn.Position = UDim2.new(0, 20, 0, posY)\n\tbtn.Text = text\n\tbtn.TextScaled = true\n\tbtn.Font = Enum.Font.Gotham\n\tbtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\n\tbtn.TextColor3 = Color3.new(1, 1, 1)\n\tbtn.MouseButton1Click:Connect(callback)\nend\n\n-- Button actions\ncreateBtn(\"📌 Copy Current Position\", 60, function()\n\tlocal char = plr.Character or plr.CharacterAdded:Wait()\n\tlocal hrp = char:FindFirstChild(\"HumanoidRootPart\")\n\tif hrp then\n\t\ttable.insert(savedPositions, tostring(hrp.CFrame))\n\tend\nend)\n\ncreateBtn(\"📋 Copy All Positions\", 110, function()\n\tif #savedPositions > 0 then\n\t\tsetclipboard(table.concat(savedPositions, \"\\n\"))\n\tend\nend)\n\ncreateBtn(\"🧹 Clear Saved Positions\", 160, function()\n\tsavedPositions = {}\nend)\n\ncreateBtn(\"❌ Destroy GUI\", 210, function()\n\tgui:Destroy()\nend)\n","features":"Simple Humanoid Position Finder","tags":["grow","garden","grow a garden","humanoid","position finder"],"discord":"","keyLink":"","owner":{"_id":"684733d5c49eba9c898574b9","username":"synt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"684733d5c49eba9c898574b9","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:55:48.174Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68527b24bb2d617bd66912fc","editBy":{"_id":"684733d5c49eba9c898574b9","username":"synt","status":"offline","id":"684733d5c49eba9c898574b9"},"message":"Create script","createdAt":"2025-06-18T08:39:00.492Z"},{"_id":"685283e3ac15ee5efb9bc6c5","editBy":{"_id":"684733d5c49eba9c898574b9","username":"synt","status":"offline","id":"684733d5c49eba9c898574b9"},"message":"Update script","createdAt":"2025-06-18T09:16:19.831Z"}],"comments":[{"_id":"68527ea9bb2d617bd6698b73","commentBy":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"},"createdAt":"2023-08-28T09:12:26.920Z","lastActive":"2026-10-19T08:59:04.804Z","lvl":11,"status":"offline","id":"64ec64fa4f538af76763524a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"}},"createdAt":"2025-06-18T08:54:01.633Z","dislikeCount":0,"edited":false,"likeCount":1,"text":"least obvious AI script:","liked":false,"disliked":false},{"_id":"68527ec09d2d67dc0080bcf4","commentBy":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"},"createdAt":"2023-08-28T09:12:26.920Z","lastActive":"2026-10-19T08:59:04.804Z","lvl":11,"status":"offline","id":"