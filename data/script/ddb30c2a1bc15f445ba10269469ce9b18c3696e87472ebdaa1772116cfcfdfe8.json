{"slug":"Just-a-baseplate.-Fe-chromtic-V2-30535","_id":"67c0c4057bcf96235ed3232f","title":"Fe chromtic V2","game":{"_id":"67e5e1ffb360710ec3c77dfa","gameId":17574618959,"name":"Just a baseplate.","imageUrl":"/images/sb/rbx-6818219d013522fff83b9340258d50b1-ccd30e97ce75.png","placeId":17574618959},"features":"no one can see yout text btw","tags":["fe","achromatic"],"script":"-- Runs the base script safely\nloadstring(game:HttpGet(\"https://pastebin.com\"))()\n\n-- Automatically executes your -gh sword command \ntask.spawn(function()\n    task.wait(0.6) -- Wait for the script interface to finish setting up\n    local command = \"-gh 4458601937 4506945409 4794315940 4820152700 4315489767 4524991457\"\n    \n    -- Triggers chat for modern games\n    local tcs = game:GetService(\"TextChatService\")\n    if tcs and tcs.ChatVersion == Enum.ChatVersion.TextChatService then\n        pcall(function() tcs.TextChannels.RBXGeneral:SendAsync(command) end)\n    end\n    \n    -- Triggers chat for legacy games\n    local rep = game:GetService(\"ReplicatedStorage\")\n    local legacy = rep:FindFirstChild(\"DefaultChatSystemChatEvents\") and rep.DefaultChatSystemChatEvents:FindFirstChild(\"SayMessageRequest\")\n    if legacy then\n        pcall(function() legacy:FireServer(command, \"All\") end)\n    end\nend)\n","owner":{"_id":"671fc3ca48f1176258137eda","username":"nik_itaa1","verified":false,"profilePicture":"/images/photo/671fc3ca48f1176258137eda-1787863619033.png","status":"offline","id":"671fc3ca48f1176258137eda","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":23083,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-27T19:59:01.685Z","dislikeCount":0,"likeCount":3,"image":"/images/sb/17574618959-1740686341417.png","editBy":{"_id":"671fc3ca48f1176258137eda","username":"nik_itaa1","status":"offline","id":"671fc3ca48f1176258137eda"},"executes":456,"keyless":false,"liked":false,"disliked":fal