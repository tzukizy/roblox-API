ded:Connect(setupCustomAnimations)\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(setupCustomAnimations)\nend)\n","features":"o script animaçao c00lkidd Forsaken ( Apenas Uma Base)","tags":["animaao clkidd Forsaken  A* uma base"],"discord":"","keyLink":"","owner":{"_id":"684d70ce984739b1e24befb0","username":"TestGamerForYTroblox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2a9146d3fa6fff4d7ca0c0bae764c579274819b83af46901d4d607316efdcd1c.webp","original":"https://scriptblox.com/images/photo/684d70ce984739b1e24befb0-1763757187631.png"},"status":"offline","id":"684d70ce984739b1e24befb0","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/2a9146d3fa6fff4d7ca0c0bae764c579274819b83af46901d4d607316efdcd1c.webp","original":"https://scriptblox.com/images/photo/684d70ce984739b1e24befb0-1763757187631.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:48:25.081Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68966c2c1db541b05096cd59","editBy":{"_id":"684d70ce984739b1e24befb0","username":"TestGamerForYTroblox","status":"offline","id":"684d70ce984739b1e24befb0"},"message":"o script animaçao c00lkidd Forsaken ( A* Uma Base)","createdAt":"2025-08-08T21:29:16.898Z"},{"_id":"68b1e8189d3c07cb169d39b6","editBy":{"_id":"684d70ce984739b1e24befb0","username":"TestGamerForYTroblox","status":"offline","id":"684d70ce984739b1e24befb0"},"message":"Update script","createdAt":"2025-08-29T17:49:12.067Z"},{"_id":"68b1e81a9d3c07cb169d39ef","editBy":{"_id":"684d70ce984739b1e24befb0","username":"TestGamerForYTroblox","status":"offline","id":"684d70ce984739b1e24befb0"},"message":"Update script","createdAt":"2025-08-29T17:49:14.099Z"},{"_id":"68b1e8a4d1f45cb114895f96","editBy":{"_id":"684d70ce984739b1e24befb0","