{"_id":"62df8fe0ea0cb7cbab87f268","title":"Anti-Cheat Bypass | Kill Aura | No Cooldown","game":{"_id":"67e5e1ffb360710ec3c77dd2","gameId":6403373529,"name":"[UPDATE👁️] Slap Battles👏","imageUrl":{"url":"https://media.kocakz.me/dc8c1e3bf18a83cd29d95e006e62b4e7c184904c2ba767254cc22d94a3ae5ea7.webp","original":"https://tr.rbxcdn.com/180DAY-8b6b8e78d4e680c9c4ce5d6f23e92db1/150/150/Image/Png/noFilter"},"slug":"6403373529-slap-battles","path":"/game/6403373529-slap-battles","thumbnail":{"url":"https://media.kocakz.me/dc8c1e3bf18a83cd29d95e006e62b4e7c184904c2ba767254cc22d94a3ae5ea7.webp","original":"https://tr.rbxcdn.com/180DAY-8b6b8e78d4e680c9c4ce5d6f23e92db1/150/150/Image/Png/noFilter"},"placeId":6403373529},"slug":"Slap-Battles-AntiCheat-Bypass-4423","verified":false,"key":false,"keyless":false,"views":25870,"executes":51,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/b07624990ad14e39864ece837ef8773f/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/b07624990ad14e39864ece837ef8773f/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/b07624990ad14e39864ece837ef8773f/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/b07624990ad14e39864ece837ef8773f/500/280/Image/Jpeg"},"likeCount":1,"dislikeCount":2,"createdAt":"2022-07-26T06:55:28.014Z","updatedAt":"2022-07-26T06:55:28.014Z","lastBump":"2022-07-26T06:55:28.014Z","script":"-- Anti-Cheat Bypass\nlocal Namecall\nNamecall = hookmetamethod(game, '__namecall', function(self, ...)\n   if getnamecallmethod() == 'FireServer' and tostring(self) == 'Ban' then\n       return\n   elseif getnamecallmethod() == 'FireServer' and tostring(self) == 'WalkSpeedChanged' then\n       return\n   elseif getnamecallmethod() == 'FireServer' and tostring(self) == 'AdminGUI' then\n       return\n   end\n   return Namecall(self, ...)\nend)\n\n-- Main\nlocal LocalPlayer = game.Players.LocalPlayer\nlocal ReplicatedStorage = game:GetService('ReplicatedStorage')\n\ngame.RunService.RenderStepped:Connect(function()\n   for Index, Player in next, game.Players:GetPlayers() do\n       if Player ~= LocalPlayer then\n           local Character = Player.Character\n           \n           if Character:FindFirstChild('HumanoidRootPart') ~= nil and Character:FindFirstChild('Humanoid') ~= nil and Character.Humanoid.Health > 0 then\n               local Magnitude = (Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude\n               if Magnitude < 35 then\n                   ReplicatedStorage.b:FireServer(Character.Head)\n               end\n           end\n       end\n   end\nend)","features":"use default glove otherwise it will not work\n\nCredits to https://v3rmillion.net/showthread.php?tid=1179866","tags":["slap battles","anticheat"],"discord":"","keyLink":"","owner":{"_id":"62231ec16508e91d8b17db5b","username":"Gumball","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62231ec16508e91d8b17db5b","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:20:03.161Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f3a6","editBy":{"_id":"62231ec16508e91d8b17db5b","username":"Gumball","status":"offline","id":"62231ec16508e91d8b17db5b"},"message":"Create script","createdAt":"2025-03-27T20:24:15.967Z"}],"comments":[{"_id":"62e08bd1a190000aea4584e8","commentBy":{"_id":"6277a075fc1eb9b80e448f6f","username":"Amir","verified":false,"role":"user","profilePicture":{"url":"https://med