{"slug":"Easter-buff-Strongman-Simulator-Lightening-items-11877","_id":"6609639f4b5d53c143aba102","title":"Steroids","game":{"_id":"67e5e1ffb360710ec3c77f83","gameId":6766156863,"name":"Strongman Simulator","imageUrl":"/images/sb/rbx-64f5952ea6b5069da6d93a0a35167884-2ce13bc3acce.png","placeId":6766156863},"features":"Use this when you pick up items","tags":[],"script":"local plr = game.Players.LocalPlayer\nlocal char = plr.Character\n  \n  for _, child in pairs(char:GetChildren()) do\n    if child:IsA(\"BasePart\") then\n      child.Massless = false\n      child.CustomPhysicalProperties = PhysicalProperties.new(math.huge, math.huge, math.huge) \n    end\n  end\n\nlocal Players = game:GetService(\"Players\")\nlocal function isPartOfPlayerCharacter(part)\n    for _, player in ipairs(Players:GetPlayers()) do\n        local character = player.Character\n        if character and part:IsDescendantOf(character) then\n            return true\n        end\n    end\n    return false\nend\n\nfor _, part in ipairs(workspace:GetDescendants()) do\n    if part:IsA(\"BasePart\") and not isPartOfPlayerCharacter(part) then\n        part.CustomPhysicalProperties = PhysicalProperties.new(-9e9999, 9e9999, 0, 0, 0)\n    end\nend","owner":{"_id":"657de6ff3fc064145583e6bb","username":"ADSKer","verified":false,"profilePicture":"/images/photo/657de6ff3fc064145583e6bb-1711768867821.jpg","status":"offline","id":"657de6ff3fc064145583e6bb","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"likes","value":3}},"topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"keyLink":"","views":36460,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-03-31T13:22:39.901Z","dislikeCount":1,"likeCount":3,"image":"/images/sb/6766156863-1711891359776.webp","executes":86,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50821","editBy":{"_id":"657de6ff3fc06414558