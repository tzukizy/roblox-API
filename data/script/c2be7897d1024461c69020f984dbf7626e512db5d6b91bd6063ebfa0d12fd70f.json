era.CFrame + (camera.CFrame.UpVector * moveVector.Y * moveSpeed)\nend\n\nUserInputService.InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.P and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then\n        toggleFreecam()\n    end\nend)\n\nRunService.RenderStepped:Connect(updateFreecam)","owner":{"_id":"68bcc66f1f8ec111f9ae08c0","username":"SmoreBUTTS","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/5612e1fbb88550c285e76813c24a3481aaff24135f716197ddba9fec1b3b2eb3.webp","original":"https://scriptblox.com/images/photo/68bcc66f1f8ec111f9ae08c0-1784928368830.jpg"},"status":"offline","id":"68bcc66f1f8ec111f9ae08c0","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/5612e1fbb88550c285e76813c24a3481aaff24135f716197ddba9fec1b3b2eb3.webp","original":"https://scriptblox.com/images/photo/68bcc66f1f8ec111f9ae08c0-1784928368830.jpg"}},"verified":false,"views":6710,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/ff77b68000b3387ab92a4821f0f2b2a474073e69cfe346667087b67ccc7dd1fb.webp","original":"https://scriptblox.com/images/sb/2971329387-1759186614290.png","scriptblox":"https://scriptblox.com/images/script/2971329387-1759186614290.png"},"likeCount":2,"dislikeCount":2,"createdAt":"2025-09-29T22:56:54.325Z","executes":1559,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:00:01.605Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/ff77b68000b3387ab92a4821f0f2b2a474073e69cfe346667087b67ccc7dd1fb.webp","original":"https://scriptblox.com/images/sb/2971329387-1759186614290.png","scriptblox":"https://scriptblox.com/images/script/2971329387-1759186614290.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68db0eb67fbf116741a4d60d","editBy":{"_id":"68bcc66f1f8