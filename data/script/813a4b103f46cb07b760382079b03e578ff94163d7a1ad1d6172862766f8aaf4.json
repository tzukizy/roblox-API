{"slug":"Find-The-Floppa-Morphs-(855)-Farm-54313","_id":"68d0071dedc2fa3378b4c3ab","title":"Farm","game":{"_id":"67e5e1ffb360710ec3c782e5","gameId":9579974235,"name":"Find The Floppa Morphs (855)","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":9579974235},"features":"Farm Floppa","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\n\nlocal floppas = workspace:WaitForChild(\"Floppas\")\n\nfor _, obj in ipairs(floppas:GetChildren()) do\n    if obj:IsA(\"BasePart\") and obj.Name:match(\"Floppa$\") then\n        hrp.CFrame = obj.CFrame\n        wait(0.05) \n    elseif obj:IsA(\"Model\") and obj.Name:match(\"Floppa$\") then\n        local primary = obj.PrimaryPart or obj:FindFirstChild(\"HumanoidRootPart\") or obj:FindFirstChildWhichIsA(\"BasePart\")\n        if primary then\n            hrp.CFrame = primary.CFrame\n            wait(0.05)\n        end\n    end\nend","owner":{"_id":"68b5647afdfab5b527098faa","username":"qvp*","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e139dcd18b86cc994fc76b796f6af09b245af1cecd4b0e27e6d27fa9b76f678e.webp","original":"https://scriptblox.com/images/photo/68b5647afdfab5b527098faa-1759664431703.jpg"},"status":"offline","id":"68b5647afdfab5b527098faa","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/e139dcd18b86cc994fc76b796f6af09b245af1cecd4b0e27e6d27fa9b76f678e.webp","original":"https://scriptblox.com/images/photo/68b5647afdfab5b527098faa-1759664431703.jpg"}},"verified":false,"views":1253,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/63205644a50e2124aac118131065956c92fc3e664359d5e6eafabb0b715d1e01.webp","original":"https://scriptblox.com/images/sb/9579974235-1758463773388.