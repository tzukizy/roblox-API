{"slug":"Find-The-Floppa-Morphs-(855)-Farm-54313","_id":"68d0071dedc2fa3378b4c3ab","title":"Farm","game":{"_id":"67e5e1ffb360710ec3c782e5","gameId":9579974235,"name":"Find The Floppa Morphs (855)","imageUrl":"/images/sb/rbx-3d5fae9fb212cafb736f25da0b4c48f3-454ea068345e.png","placeId":9579974235},"features":"Farm Floppa","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\n\nlocal floppas = workspace:WaitForChild(\"Floppas\")\n\nfor _, obj in ipairs(floppas:GetChildren()) do\n    if obj:IsA(\"BasePart\") and obj.Name:match(\"Floppa$\") then\n        hrp.CFrame = obj.CFrame\n        wait(0.05) \n    elseif obj:IsA(\"Model\") and obj.Name:match(\"Floppa$\") then\n        local primary = obj.PrimaryPart or obj:FindFirstChild(\"HumanoidRootPart\") or obj:FindFirstChildWhichIsA(\"BasePart\")\n        if primary then\n            hrp.CFrame = primary.CFrame\n            wait(0.05)\n        end\n    end\nend","owner":{"_id":"68b5647afdfab5b527098faa","username":"qvp*","verified":false,"profilePicture":"/images/photo/68b5647afdfab5b527098faa-1759664431703.jpg","status":"offline","id":"68b5647afdfab5b527098faa","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":1236,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/9579974235-1758463773388.jpg","likeCount":1,"dislikeCount":1,"createdAt":"2025-09-21T14:09:33.419Z","executes":374,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d0071dedc2fa3378b4c3ad","editBy":{"_id":"68b5647afdfab5b527098faa","username":"qvp*","status":"offline","id":"68b5647afdfab5b527098faa"},"message":"Create script","createdAt":"2025-09-21T14:09:33.424Z"}],"comments":[{"_id":"68e285bbb7000de26cd73178","commentBy":{"_id":"663647799f6b1fc4e47adf51","username":"ZERETET","verified":false,"role":"user","profile