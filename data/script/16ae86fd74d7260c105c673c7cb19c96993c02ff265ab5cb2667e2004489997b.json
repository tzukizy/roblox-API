{"slug":"Universal-Script-print-rayfield-key-149113","_id":"69c55acf6959da722ee63909","title":"print rayfield key","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1774541519382.jpg","placeId":0},"features":"requires getgc function doesnt work on xeno or solara use velocity or ronix or others","tags":[],"script":"local includeNumbers = false -- use true if the key system has numbers\n\nfor _, tables in ipairs(getgc(true)) do\n\tif typeof(tables) == \"table\" then\n\t\tfor k, v in pairs(tables) do\n\t\t\tif tostring(k):lower() == \"key\" then\n\t\t\t\tif typeof(v) == \"table\" then\n\t\t\t\t\tfor i, value in pairs(v) do\n                        if typeof(value) == \"table\" then continue end\n                        if not includeNumbers and typeof(value) == \"number\" then continue end\n\t\t\t\t\t\tprint(\"Key =\", value)\n\t\t\t\t\tend\n\t\t\t\telse\n                    if typeof(v) == \"table\" then continue end\n                    if not includeNumbers and typeof(v) == \"number\" then continue end\n\t\t\t\t\tprint(\"Key =\", v)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend","owner":{"_id":"67aa1ab92ad58e3ff64bc537","username":"zosyn","verified":false,"profilePicture":"/images/photo/67aa1ab92ad58e3ff64bc537-1791192361398.png","status":"offline","id":"67aa1ab92ad58e3ff64bc537","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":858,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1774541519382.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-26T16:11:59.397Z","keyLink":"","executes":30,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c55acf6959da722ee6390c","editBy":{"_id":"67aa1ab92ad58e3ff64bc537","username":"zosyn","status":"offline","id":"67aa1ab92ad58e3ff64bc537"},"message":"Create script","createdAt":"2026-03-26T16:11:59.402Z"}],"comments":[{"_id":"69c55c388edc