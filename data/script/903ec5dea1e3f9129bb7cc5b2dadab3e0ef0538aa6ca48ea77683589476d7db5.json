{"slug":"Outcome-Memories-v0.2-Fleetway-and-Silver-inf-flight-209158","_id":"69f2105ef15f172aeb5e0aed","title":"Fleetway and Silver inf flight","game":{"_id":"688659520c85a3749fe1ba9d","gameId":14608970270,"name":"(ANNIVERSARY) Outcome Memories v0.2","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14608970270},"features":"Execute when playing as Fleetway or Silver","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function apply(character)\n    pcall(function()\n        local frame = character:WaitForChild(\"HumanoidRootPart\")\n            :WaitForChild(\"BillboardGui\")\n            :WaitForChild(\"Frame\")\n        local function lockText(label)\n            label.Text = \"inf\"\n            label:GetPropertyChangedSignal(\"Text\"):Connect(function()\n                if label.Text ~= \"inf\" then\n                    label.Text = \"inf\"\n                end\n            end)\n        end\n        lockText(frame:WaitForChild(\"Amount\"))\n        lockText(frame:WaitForChild(\"Maximum\"))\n    end)\nend\n\nif player.Character then apply(player.Character) end\nplayer.CharacterAdded:Connect(apply)\n\nwhile task.wait() do\n    pcall(function()\n        player.Character:AddTag(\"Kill\")\n        task.wait()\n        player.Character:RemoveTag(\"Kill\")\n    end)\nend","owner":{"_id":"698f8faf35987d06cf53a558","username":"eggmanthemasterplan","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/5588491f2281306d1aaafe1dc3586e6dfffde9e1b62902866f9dd4d540bd833d.webp","original":"https://scriptblox.com/images/photo/698f8faf35987d06cf53a558-1771016449600.jpeg"},"status":"offline","id":"698f8faf35987d06cf53a558","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/5588491f2281306d1aaafe1dc3586e6dfffde9e1b62902866f9dd4d540bd833d.w