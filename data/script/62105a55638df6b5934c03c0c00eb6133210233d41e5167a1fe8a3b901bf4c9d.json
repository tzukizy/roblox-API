(module.getTrueSpread) == \"function\" then\n        Bullet = module\n        break\n    end\nend\n\nif not Bullet then\n    return warn(\"ummmmm\")\nend\n\nlocal originalRaycast = Bullet._performRaycast\nBullet._performRaycast = function(self, _, ...) return originalRaycast(self, 0, ...) end\n\nlocal spreadGetters = { \"getTrueSpread\", \"getBaseSpread\", \"getSpreadForConfig\",\n                        \"getBaseSpreadForConfig\", \"getMovementSpreadForConfig\" }\nfor index = 1, #spreadGetters do\n    local getterName = spreadGetters[index]\n    if type(Bullet[getterName]) == \"function\" then\n        Bullet[getterName] = function() return 0 end\n    end\nend\n\nBullet._updateShotSpread = function(self)\n    local spreadConfig = self.ActiveSpreadConfig or (self.Properties and self.Properties.Spread)\n    local minSpread = spreadConfig and spreadConfig.Range and spreadConfig.Range.Min\n    if minSpread and self.Spread then\n        self.Spread:setPosition(minSpread)\n        self.Spread:setGoal(minSpread)\n    end\nend","features":"No spread idk what else","tags":[],"discord":"","keyLink":"","owner":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"mixed","pct":40,"conf":0.5,"n":{"w":2,"b":3,"p":0,"d":0,"k":0},"total":5,"detected":false,"key":false,"recent":2,"at":"2026-10-20T21:04:00.051Z","last":"bwbbw","win":14,"math":4