{"_id":"687c7f36ad0b309f128a771b","title":"ESP","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/1092b2898d0a21311ee7c77d4147fca928d5b419da43f84c31e3e61fa463d57b.webp","original":"https://scriptblox.com/images/sb/0-1752989494447.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/1092b2898d0a21311ee7c77d4147fca928d5b419da43f84c31e3e61fa463d57b.webp","original":"https://scriptblox.com/images/sb/0-1752989494447.jpg"},"placeId":0},"slug":"Universal-Script-ESP-45575","verified":false,"key":false,"keyless":false,"views":1594,"executes":102,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/b2b2e3bf45ab2d486ff3d3a551a99a26ef84af4620c7765ce06a9bfb657be577.webp","original":"https://scriptblox.com/images/sb/0-1752989494447.jpg","scriptblox":"https://scriptblox.com/images/script/0-1752989494447.jpg"},"thumbnail":{"url":"https://media.kocakz.me/b2b2e3bf45ab2d486ff3d3a551a99a26ef84af4620c7765ce06a9bfb657be577.webp","original":"https://scriptblox.com/images/sb/0-1752989494447.jpg","scriptblox":"https://scriptblox.com/images/script/0-1752989494447.jpg"},"likeCount":4,"dislikeCount":1,"createdAt":"2025-07-20T05:31:34.516Z","updatedAt":"2025-07-20T05:31:34.516Z","lastBump":"2025-07-20T05:31:34.516Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal plr = Players.LocalPlayer\nlocal camera = Workspace.CurrentCamera\n\nlocal boxes = {}\n\nlocal function createBox(player)\n    local box = Drawing.new(\"Square\")\n    box.Visible = false\n    box.Thickness = 2\n    box.Color = Color3.new(1, 1, 1)\n    box.Filled = false\n    boxes[player] = box\nend\n\nlocal function removeBox(player)\n    if boxes[player] then\n        boxes[player]:Remove()\n        boxes[player] = nil\n    end\nend\n\nlocal function updateBoxes()\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player == plr then continue end\n        if not boxes[player] then createBox(player) end\n        local box = boxes[player]\n        local char = player.Character\n        if char and char:FindFirstChild(\"HumanoidRootPart\") then\n            local hrp = char.HumanoidRootPart\n            local _, onScreen = camera:WorldToViewportPoint(hrp.Position)\n            if onScreen then\n                local tl = camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(-2, 3, 0)).Position)\n                local br = camera:WorldToViewportPoint((hrp.CFrame * CFrame.new(2, -3, 0)).Position)\n                box.Position = Vector2.new(tl.X, tl.Y)\n                box.Size = Vector2.new(br.X - tl.X, br.Y - tl.Y)\n                box.Visible = true\n            else\n                box.Visible = false\n            end\n        else\n            box.Visible = false\n        end\n    end\nend\n\nPlayers.PlayerAdded:Connect(createBox)\nPlayers.PlayerRemoving:Connect(removeBox)\nRunService.RenderStepped:Connect(updateBoxes)","features":"esp esp esp esp esp esp esp esp esp","tags":["boxes","esp"],"discord":"","keyLink":"","owner":{"_id":"6832672134b8aa44421efab8","username":"exploitingrobloxian","verified":false,"profilePicture":{"url":"https://media.kocakz.me/774685d2de89b370985c345e765981e4cb9b93d3853b98e6fd8387ce66b5ed49.webp","original":"https://scriptblox.com/images/photo/6832672134b8aa44421efab8-1751506484755.png"},"status":"offline","id":"6832672134b8aa44421efab8","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/774685d2de89b370985c345e765981e4cb9b93d3853b98e6fd8387ce66b5ed49.webp","original":"https://scriptblox.com/images/photo/6832672134b8aa44421efab8-1751506484755.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected"