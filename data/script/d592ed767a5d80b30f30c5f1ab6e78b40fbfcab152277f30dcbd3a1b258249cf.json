{"_id":"69c44e840dcfc86f3f8b9e56","title":"door god mode script (READ DESC)","game":{"_id":"67e5e1ffb360710ec3c77d4f","gameId":6516141723,"name":"DOORS 🚨","imageUrl":{"url":"https://media.kocakz.me/fe044b312ec2132462b7814c03d4e799888a8af65ebd9b0e46f17a61b2bedf81.webp","original":"https://tr.rbxcdn.com/180DAY-5f677a28e42be59cd65c7b71ac8e9ede/150/150/Image/Png/noFilter"},"slug":"6516141723-doors","path":"/game/6516141723-doors","thumbnail":{"url":"https://media.kocakz.me/fe044b312ec2132462b7814c03d4e799888a8af65ebd9b0e46f17a61b2bedf81.webp","original":"https://tr.rbxcdn.com/180DAY-5f677a28e42be59cd65c7b71ac8e9ede/150/150/Image/Png/noFilter"},"placeId":6516141723},"slug":"DOORS-NEW-BUNDLE-door-god-mode-script-148570","verified":false,"key":false,"keyless":false,"views":4057,"executes":846,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/af0b33d77d84aac7a78e3a9a7b28ae73997d114c1b7921947f54a73c1b6b2e0d.webp","original":"https://scriptblox.com/images/sb/rbx-09f0d9b97f35839568ec129016b18485-896d9c239e8d.png","scriptblox":"https://scriptblox.com/images/script/rbx-09f0d9b97f35839568ec129016b18485-896d9c239e8d.png"},"thumbnail":{"url":"https://media.kocakz.me/af0b33d77d84aac7a78e3a9a7b28ae73997d114c1b7921947f54a73c1b6b2e0d.webp","original":"https://scriptblox.com/images/sb/rbx-09f0d9b97f35839568ec129016b18485-896d9c239e8d.png","scriptblox":"https://scriptblox.com/images/script/rbx-09f0d9b97f35839568ec129016b18485-896d9c239e8d.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-25T21:07:16.529Z","updatedAt":"2026-03-25T21:07:16.529Z","lastBump":"2026-03-25T21:07:16.529Z","script":"local RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal root = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal isTeleporting = false\n\nplayer.CharacterAdded:Connect(function(char)\n    character = char\n    root = char:WaitForChild(\"HumanoidRootPart\")\n    isTeleporting = false\nend)\n\nUserInputService.InputBegan:Connect(function(input, gpe)\n    if gpe then return end\n    if input.KeyCode == Enum.KeyCode.Q then\n        isTeleporting = not isTeleporting\n    end\nend)\nRunService.Heartbeat:Connect(function()\n    if isTeleporting and root then\n        root.CFrame = root.CFrame + Vector3.new(0, 30, 0)\n      root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)\n    end\nend)\n","features":"all you have to do is press q to teleport outside of where you are in-game. it will constantly teleport you., useful for avoiding rush, ambush, etc.\n\ncan also be used to farm glitch fragments.\n\npress q to toggle the teleporting","tags":[],"discord":"","keyLink":"","owner":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c7000cb82479c2207836aa24ee52bd19535adb3085cd593675f0b7510d481ee4.webp","original":"https://scriptblox.com/images/photo/69a233ddfd5c65fb0a360e7b-1788900342011.png"},"status":"offline","id":"69a233ddfd5c65fb0a360e7b","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/c7000cb82479c2207836aa24ee52bd19535adb3085cd593675f0b7510d481ee4.webp","original":"https://scriptblox.com/images/photo/69a233ddfd5c65fb0a360e7b-1788900342011.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:40:45.756Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c44e840dcfc86f3f8b9e59","editBy":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","status":"offline","id":"69a233ddfd5c65fb0a360e7b"},"message":"Create script","createdA