{"slug":"DOORS-NEW-BUNDLE-door-god-mode-script-148570","_id":"69c44e840dcfc86f3f8b9e56","title":"door god mode script (READ DESC)","game":{"_id":"67e5e1ffb360710ec3c77d4f","gameId":6516141723,"name":"DOORS 🚨","imageUrl":"/images/sb/rbx-e822a794752ce011565eca23a280f4dc-130554367619.png","placeId":6516141723},"features":"all you have to do is press q to teleport outside of where you are in-game. it will constantly teleport you., useful for avoiding rush, ambush, etc.\n\ncan also be used to farm glitch fragments.\n\npress q to toggle the teleporting","tags":[],"script":"local RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal root = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal isTeleporting = false\n\nplayer.CharacterAdded:Connect(function(char)\n    character = char\n    root = char:WaitForChild(\"HumanoidRootPart\")\n    isTeleporting = false\nend)\n\nUserInputService.InputBegan:Connect(function(input, gpe)\n    if gpe then return end\n    if input.KeyCode == Enum.KeyCode.Q then\n        isTeleporting = not isTeleporting\n    end\nend)\nRunService.Heartbeat:Connect(function()\n    if isTeleporting and root then\n        root.CFrame = root.CFrame + Vector3.new(0, 30, 0)\n      root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)\n    end\nend)\n","owner":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","verified":false,"profilePicture":"/images/photo/69a233ddfd5c65fb0a360e7b-1788900342011.png","status":"offline","id":"69a233ddfd5c65fb0a360e7b","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":3880,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-09f0d9b97f35839568ec129016b18485-896d9c239e8d.png","likeCount":2,"dislikeCount":0,"createdAt":"2026-03-25T21:07:16.529Z","keyLink":"","editBy":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","status":"offline","id":"69a233ddfd5c65fb0a360e7b"},"executes":740,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c44e840dcfc86f3f8b9e59","editBy":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","status":"offline","id":"69a233ddfd5c65fb0a360e7b"},"message":"Create script","createdAt":"2026-03-25T21:07:16.533Z"},{"_id":"69c45253ddfb5ed8e68204be","editBy":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","status":"offline","id":"69a233ddfd5c65fb0a360e7b"},"message":"Update script","createdAt":"2026-03-25T21:23:31.980Z"},{"_id":"69c459f1006ec7f766c40ec0","editBy":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","status":"offline","id":"69a233ddfd5c65fb0a360e7b"},"message":"Update script","createdAt":"2026-03-25T21:56:01.739Z"}],"comments":[{"_id":"69c45038ac7bc510b6e3d2f3","commentBy":{"_id":"69a233ddfd5c65fb0a360e7b","username":"alsotwentycharacters","verified":false,"role":"user","profilePicture":"/images/photo/69a233ddfd5c65fb0a360e7b-1788900342011.png","lastActive":"2026-09-30T14:50:50.712Z","createdAt":"2026-02-28T00:16:29.143Z","status":"offline","id":"69a233ddfd5c65fb0a360e7b","topMilestone":{"key":"creator.executions","tier":10000}},"text":"make sure you time your god mode correctly...","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-25T21:14:32.085Z","liked":false,"disliked":false},{"_id":"69c505b6ac7bc510b6ee3ba2","commentBy":{"_id":"69854eee1a5b231013adfab0","username":"zaynghozi","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-08-19T12:30:11.638Z","createdAt":"2026-02-06T02:16:14.777Z","status":"offline","id":"69854eee1a5b231013adfab0","topMilestone":{"key":"creator.first_script","tier":1}},"text":"mobile support?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt