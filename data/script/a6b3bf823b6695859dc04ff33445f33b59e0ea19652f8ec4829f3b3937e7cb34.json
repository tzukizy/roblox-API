igin\"] = \"https://discord.com\",\n                        [\"Content-Type\"] = \"application/json\"\n                    }\n                })\n            end\n            spawn(DiscordInviteRequest)\n        end","owner":{"_id":"61b91b8698ee0fd9d5778e8a","username":"Kaor","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/1edf4b4c39b8b42977119e81e3a67f22c61fdf895552c99c7ab2b87e68fecc3d.webp","original":"https://scriptblox.com/images/photo/61b91b8698ee0fd9d5778e8a-1693028866881.png"},"status":"offline","id":"61b91b8698ee0fd9d5778e8a","profile":{"url":"https://cdn.kocakz.me/images/1edf4b4c39b8b42977119e81e3a67f22c61fdf895552c99c7ab2b87e68fecc3d.webp","original":"https://scriptblox.com/images/photo/61b91b8698ee0fd9d5778e8a-1693028866881.png"}},"verified":true,"views":14094,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-03-27T17:47:20.564Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/9541801-1648403240549.jpg","scriptblox":"https://scriptblox.com/images/script/9541801-1648403240549.jpg"},"executes":9,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:31:10.959Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/9541801-1648403240549.jpg","scriptblox":"https://scriptblox.com/images/script/9541801-1648403240549.jpg"},"changelog":[{"_id":"67e5e1e2b360710ec3c4b167","editBy":{"_id":"61b91b8698ee0fd9d5778e8a","username":"Kaor","status":"offline","id":"61b91b8698ee0fd9d5778e8a"},"message":"Create script","createdAt":"2022-03-27T18:07:14.566Z"},{"_id":"67e5e1e3b360710ec3c4ea48","editBy":{"_id":"61b91b8698ee0fd9d5778e8a","username":"Kaor","status":"offline","id":"61b91b8698ee