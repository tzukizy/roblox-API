Name = \"ImOkayBillboard\"\n        billboard.Size = UDim2.new(5, 0, 2, 0)\n        billboard.AlwaysOnTop = true\n\n        local text = Instance.new(\"TextLabel\", billboard)\n        text.Size = UDim2.new(1, 0, 1, 0)\n        text.BackgroundTransparency = 1\n        text.Text = \"I'm okay\"\n        text.TextColor3 = Color3.new(1, 1, 1)\n        text.TextStrokeTransparency = 0\n        text.TextScaled = true\n\n        billboard.Adornee = obj\n    end\nend\n\nlocal function spamAllParts()\n    for _, obj in pairs(workspace:GetDescendants()) do\n        spamText(obj)\n    end\nend\n\ntask.spawn(function()\n    while true do\n        game.ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(\"I'm okay\", \"All\")\n        wait(1)\n    end\nend)\n\nRunService.Stepped:Connect(spamAllParts)\n","features":"Art by ME","tags":[],"discord":"","keyLink":"","owner":{"_id":"67f818cb1c98cf04c22f57da","username":"skibidimariodisney","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e9fe55f86be09d6316ef9da185bec3481101a9bbdd137effa98f7a071dd6d1ed.webp","original":"https://scriptblox.com/images/photo/67f818cb1c98cf04c22f57da-1746770204465.jpg"},"status":"offline","id":"67f818cb1c98cf04c22f57da","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/e9fe55f86be09d6316ef9da185bec3481101a9bbdd137effa98f7a071dd6d1ed.webp","original":"https://scriptblox.com/images/photo/67f818cb1c98cf04c22f57da-1746770204465.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:54:10.735Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"682ffb97c236ccc4acdf8d3f","editBy":{"_id":"67f818cb1c98cf04c22f57da","username":"skibidimariodisney","status":"offline","id":"67f818cb1c98cf04c22f57da"},"message":":)","createdAt":"2025-05-23T04:37:43.048Z"}