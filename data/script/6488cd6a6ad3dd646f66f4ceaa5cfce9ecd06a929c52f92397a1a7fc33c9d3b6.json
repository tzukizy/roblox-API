{"slug":"Universal-Script-Disgo-lol-32410","_id":"67d978744f3217284c03ad3a","title":"Disgo lol","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/1042408-1742305396329.png","placeId":0},"features":"Lol","tags":[],"script":"local Lighting = game:GetService(\"Lighting\")\n\t\tlocal ColorCorrection = Instance.new(\"ColorCorrectionEffect\", Lighting)\n\t\n\t\tfunction zigzag(X) \n\t\t\treturn math.acos(math.cos(X*math.pi))/math.pi\n\t\tend\n\t\n\t\tCounter = 0\n\t\n\t\tLighting.TimeOfDay = \"12:00\"\n\t\n\t\twhile wait(0.1) do \n\t\t\tColorCorrection.TintColor = Color3.fromHSV(zigzag(Counter),1,1)\n\t\t\tLighting.Ambient = Color3.fromHSV(zigzag(Counter),1,1)\n\t\t\tCounter += 0.01\n\t\tend","owner":{"_id":"6741d1abd65cce691b5c71c8","username":"GoodRc7","verified":false,"profilePicture":"/images/photo/6741d1abd65cce691b5c71c8-1777398836350.jpg","status":"offline","id":"6741d1abd65cce691b5c71c8","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"keyLink":"","views":1989,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-18T13:43:16.395Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/1042408-1742305396329.png","executes":2,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c55ba9","editBy":{"_id":"6741d1abd65cce691b5c71c8","username":"GoodRc7","status":"offline","id":"6741d1abd65cce691b5c71c8"},"message":"Create script","createdAt":"2025-03-27T19:20:37.660Z"}],"comments":[]}