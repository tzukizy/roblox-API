 CODE\n\nscreenGui.Parent = PlayerGui\n\nframe.Size = UDim2.new(0, 300, 0, 200)\nframe.Position = UDim2.new(0.5, -150, 0.5, -100)\nframe.Parent = screenGui\n\ngetKeyButton.Size = UDim2.new(0, 100, 0, 50)\ngetKeyButton.Position = UDim2.new(0.1, 0, 0.7, 0)\ngetKeyButton.Text = \"Get Key\"\ngetKeyButton.Parent = frame\n\nsubmitButton.Size = UDim2.new(0, 100, 0, 50)\nsubmitButton.Position = UDim2.new(0.6, 0, 0.7, 0)\nsubmitButton.Text = \"Submit\"\nsubmitButton.Parent = frame\n\ntextBox.Size = UDim2.new(0, 200, 0, 50)\ntextBox.Position = UDim2.new(0.5, -100, 0.3, 0)\ntextBox.PlaceholderText = \"Enter Code\"\ntextBox.Parent = frame\n\ngetKeyButton.MouseButton1Click:Connect(function()\n    setclipboard(correctCode)\nend)\n\nsubmitButton.MouseButton1Click:Connect(function()\n    if textBox.Text == correctCode then\n        screenGui:Destroy()\n    end\nend)","features":"You can Change the KeySystem however you want i would be happy if u use Credits","tags":[],"discord":"","keyLink":"","owner":{"_id":"62aaa40254b1e572538ed510","username":"Fabloscripts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62aaa40254b1e572538ed510","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:20:39.886Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cae4","editBy":{"_id":"62aaa40254b1e572538ed510","username":"Fabloscripts","status":"offline","id":"62aaa40254b1e572538ed510"},"message":"Create script","createdAt":"2024-08-28T21:40:33.121Z"},{"_id":"67e5e1e6b360710ec3c51e7f","editBy":{"_id":"62aaa40254b1e572538ed510","username":"Fabloscripts","status":"offline","id":"62aaa40254b1e57253