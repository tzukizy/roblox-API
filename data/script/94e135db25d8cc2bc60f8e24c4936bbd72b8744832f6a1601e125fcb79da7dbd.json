ng sine wave (no rotation)\nlocal xOffset = math.sin(t * speed) * amplitude\nneck.C0 = baseC0 * CFrame.new(xOffset, 0, 0)\nend)","features":"Yy","tags":[],"discord":"","keyLink":"","owner":{"_id":"6950a2a3f90a62a2da534f74","username":"Mario_gore","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3dcca6d5e717f333996c45087b30b099c38b04353874528dff6eb94d807d5b26.webp","original":"https://scriptblox.com/images/photo/6950a2a3f90a62a2da534f74-1766892266257.png"},"status":"offline","id":"6950a2a3f90a62a2da534f74","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/3dcca6d5e717f333996c45087b30b099c38b04353874528dff6eb94d807d5b26.webp","original":"https://scriptblox.com/images/photo/6950a2a3f90a62a2da534f74-1766892266257.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:20:37.544Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69670024ce7e338b9d903842","editBy":{"_id":"6950a2a3f90a62a2da534f74","username":"Mario_gore","status":"offline","id":"6950a2a3f90a62a2da534f74"},"message":"Create scriptj","createdAt":"2026-01-14T02:32:04.334Z"}],"comments":[]}