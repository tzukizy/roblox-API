{"slug":"Universal-Script-Youtube-in-Roblox-57836","_id":"68eaeac8b8f078064e300980","title":"Youtube in Roblox","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1760225991977.png","placeId":0},"features":"Source Credit\nhttps://scriptblox.com/u/CatBoyy\n------------------------------------------\nOpen Youtube or any other Site you want within roblox!!","tags":[],"script":"-- Full Source Credit: Catboyy (https://scriptblox.com/u/CatBoyy)\n\nfunction open_browser(url, asJson)\n    local info = { presentationStyle = 2, url = tostring(url or \"\"), title = \"youtube.com\", visible = true }\n    local msg = asJson and game:GetService(\"HttpService\"):JSONEncode(info) or (info.title .. \"\\n\" .. info.url)\n    game:GetService(\"GuiService\"):BroadcastNotification(msg, 20)\nend\nopen_browser(\"https://www.youtube.com\", true)","owner":{"_id":"667dc2b94634d565bf20865f","username":"wtfchronic","verified":false,"profilePicture":"/images/photo/667dc2b94634d565bf20865f-1756837665128.jpg","status":"offline","id":"667dc2b94634d565bf20865f","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1687,"scriptType":"free","isUniversal":true,"isPatched":true,"visibility":"public","image":"/images/sb/0-1760225991977.png","likeCount":0,"dislikeCount":1,"createdAt":"2025-10-11T23:39:52.002Z","editBy":{"_id":"667dc2b94634d565bf20865f","username":"wtfchronic","status":"offline","id":"667dc2b94634d565bf20865f"},"executes":12,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68eaeac8b8f078064e300982","editBy":{"_id":"667dc2b94634d565bf20865f","username":"wtfchronic","status":"offline","id":"667dc2b94634d565bf20865f"},"message":"Create script","createdAt":"2025-10-11T23:39:52.008Z"},{"_id":"68eaec25dd508f5ec812668c","editBy":{"_id":"667dc2b94634d565bf20865f","username":"wtfchronic","status":"offline","id":"667dc2b94634d565bf20865f"},"message":"Update script","