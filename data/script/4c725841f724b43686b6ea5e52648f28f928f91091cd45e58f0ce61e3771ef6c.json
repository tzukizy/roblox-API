{"slug":"Sigma-Boy-Obby-stage-teleportorter-or-unlocker-28938","_id":"67a7f34a54c8fb5bc4ecaf93","title":"stage teleportorter or unlocker","game":{"_id":"67e5e1ffb360710ec3c7839b","gameId":131039380217655,"name":"Sigma Boy Obby","imageUrl":"https://tr.rbxcdn.com/180DAY-4b9fc5fdc1e704abd3e9ecae27625479/500/280/Image/Jpeg/noFilter","placeId":131039380217655},"features":"- go trough all stages quicly\n(tested on Sigma Boy Obby but probably works on other obby's also)","tags":["parkour","teleport","universal"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\n\nlocal function teleportToStages()\n    for _, stage in ipairs(workspace.Stages:GetChildren()) do\n        if stage:IsA(\"Part\") or stage:IsA(\"Model\") then\n            character:SetPrimaryPartCFrame(stage.CFrame + Vector3.new(0, 2, 0)) -- Offset to prevent clipping\n            task.wait(0.2)\n        end\n    end\nend\n\nteleportToStages()","owner":{"_id":"6791c29b2ca83ec84820840d","username":"Kamerzystanast","verified":false,"profilePicture":"/images/photo/6791c29b2ca83ec84820840d-1737605922036.png","status":"offline","id":"6791c29b2ca83ec84820840d"},"verified":false,"keyLink":"","views":4698,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-09T00:14:02.652Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/180DAY-4b9fc5fdc1e704abd3e9ecae27625479/500/280/Image/Jpeg/noFilter","executes":30,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54b6e","editBy":{"_id":"6791c29b2ca83ec84820840d","username":"Kamerzystanast","status":"offline","id":"6791c29b2ca83ec84820840d"},"message":"Create script","createdAt":"2025-03-27T22:45:49.053Z"}],"comments":[{"_id":"67a8021da8c10ea3ec783f33","commentBy":{"_id":"6791c29b2ca83ec84820840d","username":"Kamerzystanast","verified":false,"role":"user","profilePicture":"/images/phot