{"slug":"a-literal-baseplate.-Open-Source-ESP-35216","_id":"67fa107820cdf8a5f7b18784","title":"Open Source ESP","game":{"_id":"67e5e1ffb360710ec3c77dac","gameId":4483381587,"name":"[TITLE UNAVAILABLE]","imageUrl":"https://tr.rbxcdn.com/180DAY-87249609dae614261c1058785f217b72/480/270/UnapprovedImage/Png/noFilter","placeId":4483381587},"features":"Highlight ESP Full Customizable:\n_________________________________________________\n\nyou can change the color to however you like, by default its red.\n\nyou can change color by going to line 17, then simply adjust these settings: \nhighlight.FillColor = Color3.fromRGB(255, 0, 0)","tags":["open source","esp","free","custom"],"script":"\nlocal function highlightCharacter(player)\n   \n    if player == game.Players.LocalPlayer then\n        return \n    end\n\n    local character = player.Character or player.CharacterAdded:Wait()\n\n    \n    local primaryPart = character:FindFirstChild(\"HumanoidRootPart\") or character:FindFirstChild(\"UpperTorso\")\n    if primaryPart then\n   \n        local highlight = Instance.new(\"Highlight\")\n        highlight.Parent = character\n        highlight.Adornee = character \n        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Red fill color\n        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) \n        highlight.FillTransparency = 0.5 \n        highlight.OutlineTransparency = 0.2 \n        highlight.Enabled = true\n    end\nend\n\n\nfor _, player in pairs(game.Players:GetPlayers()) do\n    player.CharacterAdded:Connect(function()\n        highlightCharacter(player)\n    end)\n    \n    if player.Character and player ~= game.Players.LocalPlayer then\n        highlightCharacter(player)\n    end\nend\n\n\ngame.Players.PlayerRemoving:Connect(function(player)\n    if player.Character then\n        local highlight = player.Character:FindFirstChildOfClass(\"Highlight\")\n        if highlight then\n            highlight:Destroy()\n        end\n    end\nend)\n","owner":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","verified":false,"profilePicture":"/images/photo/6782f95b16e192b80ca2428d-1784532565883.png","status":"offline","id":"6782f95b16e192b80ca2428d","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"views":4089,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/4483381587-1744441464018.png","likeCount":2,"dislikeCount":2,"createdAt":"2025-04-12T07:04:24.056Z","editBy":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","status":"offline","id":"6782f95b16e192b80ca2428d"},"executes":20,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67fa107820cdf8a5f7b18786","editBy":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","status":"offline","id":"6782f95b16e192b80ca2428d"},"message":"Create script","createdAt":"2025-04-12T07:04:24.057Z"},{"_id":"67fb0ca6f17c5b79b986a058","editBy":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","status":"offline","id":"6782f95b16e192b80ca2428d"},"message":"Update script","createdAt":"2025-04-13T01:00:22.184Z"},{"_id":"67fb0cd940293a88fc1c1b84","editBy":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","status":"offline","id":"6782f95b16e192b80ca2428d"},"message":"Update script","createdAt":"2025-04-13T01:01:13.423Z"},{"_id":"67fb0cf2809eca3edd25de21","editBy":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","status":"offline","id":"6782f95b16e192b80ca2428d"},"message":"Update script","createdAt":"2025-04-13T01:01:38.668Z"},{"_id":"67fb0d06d554aa5c3172a95e","editBy":{"_id":"6782f95b16e192b80ca2428d","username":"Arayz181","status":"offline","id":"6782f95b16e192b80ca2428d"},"message":"Update script","createdAt":"2025-04-13T01:01:58.405Z"}],"comments":[{"_id":"67fa3aba75944641f7959055","commentBy":{"_id":"666540315e8c51052fe3747a","username":"MrWalkEmDownBubbles","verified":false,"role":"user","profilePicture":"/images/photo/666540315e8c51052fe3747a-