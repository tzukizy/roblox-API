{"_id":"67fa107820cdf8a5f7b18784","title":"Open Source ESP","game":{"_id":"67e5e1ffb360710ec3c77dac","gameId":4483381587,"name":"[TITLE UNAVAILABLE]","imageUrl":{"url":"https://media.kocakz.me/d6ab265526e55195cc409f9a1a5a379dfe45dec124b4243419127dca36858958.webp","original":"https://tr.rbxcdn.com/180DAY-87249609dae614261c1058785f217b72/150/150/UnapprovedImage/Png/noFilter"},"slug":"4483381587-title-unavailable","path":"/game/4483381587-title-unavailable","thumbnail":{"url":"https://media.kocakz.me/d6ab265526e55195cc409f9a1a5a379dfe45dec124b4243419127dca36858958.webp","original":"https://tr.rbxcdn.com/180DAY-87249609dae614261c1058785f217b72/150/150/UnapprovedImage/Png/noFilter"},"placeId":4483381587},"slug":"a-literal-baseplate.-Open-Source-ESP-35216","verified":false,"key":false,"keyless":false,"views":4101,"executes":20,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/baf21ff742f01dcf31a3c786ad78cd8ef697c41f8db198f24b97b14852b39fe7.webp","original":"https://scriptblox.com/images/sb/4483381587-1744441464018.png","scriptblox":"https://scriptblox.com/images/script/4483381587-1744441464018.png"},"thumbnail":{"url":"https://media.kocakz.me/baf21ff742f01dcf31a3c786ad78cd8ef697c41f8db198f24b97b14852b39fe7.webp","original":"https://scriptblox.com/images/sb/4483381587-1744441464018.png","scriptblox":"https://scriptblox.com/images/script/4483381587-1744441464018.png"},"likeCount":2,"dislikeCount":2,"createdAt":"2025-04-12T07:04:24.056Z","updatedAt":"2025-04-12T07:04:24.056Z","lastBump":"2025-04-12T07:04:24.056Z","script":"\nlocal function highlightCharacter(player)\n   \n    if player == game.Players.LocalPlayer then\n        return \n    end\n\n    local character = player.Character or player.CharacterAdded:Wait()\n\n    \n    local primaryPart = character:FindFirstChild(\"HumanoidRootPart\") or character:FindFirstChild(\"UpperTorso\")\n    if primaryPart then\n   \n        local highlight = Instance.new(\"Highlight\")\n        highlight.Parent = character\n        highlight.Adornee = character \n        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Red fill color\n        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) \n        highlight.FillTransparency = 0.5 \n        highlight.OutlineTransparency = 0.2 \n        highlight.Enabled = true\n    end\nend\n\n\nfor _, player in pairs(game.Players:GetPlayers()) do\n    player.CharacterAdded:Connect(function()\n        highlightCharacter(player)\n    end)\n    \n    if player.Character and player ~= game.Players.LocalPlayer then\n        highlightCharacter(player)\n    end\nend\n\n\ngame.Players.PlayerRemoving:Connect(function(player)\n    if player.Character then\n        local highlight = player.Character:FindFirstChildOfClass(\"Highlight\")\n        if highlight then\n            highlight:Destroy()\n        end\n    end\nend)\n","features":"Highlight ESP Full Customizable:\n_________________________________________________\n\nyou can change the color to however you like, by default its red.\n\nyou can change color by going to line 17, then simply adjust these settings: \nhighlight.FillColor = Color3.fromRGB(255, 0, 0)","tags":["open source","esp","free","custom"],"discord":"","keyLink":"","owner":{"_id":"6782f95b16e192b80ca2428d","username":"Netmos","verified":false,"profilePicture":{"url":"https://media.kocakz.me/48babe7a78268e8792af37940c57707a43eef6c513e608e005d01754facc92ea.webp","original":"https://scriptblox.com/images/photo/6782f95b16e192b80ca2428d-1792124791823.jpg"},"lvl":10,"status":"offline","id":"6782f95b16e192b80ca2428d","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/48babe7a78268e8792af37940c57707a43eef6c513e608e005d01754facc92ea.webp","original":"https://scriptblox.com/images/photo/6782f95b16e192b80ca2428d-1792124791823.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf"