{"slug":"NEWMuseum-RNG-change-npc-speeds-95606","_id":"697c387092a4802284080106","title":"change npc speeds","game":{"_id":"697c387092a4802284080103","gameId":88615997771503,"name":"🏦Museum RNG","imageUrl":"/images/sb/rbx-0b4058de6a2ac27e6967d553b12c8ff8-eae8c4b7876c.png","placeId":88615997771503},"features":"if it doesnt work instantly, wait 30 seconds to a minute and it should work fine then","tags":[],"script":"local npcs = workspace:WaitForChild(\"NPCs\")\n\nlocal function setSpeed(humanoid)\n    humanoid.WalkSpeed = 50\nend\n\nfor _, descendant in ipairs(npcs:GetDescendants()) do\n    if descendant:IsA(\"Humanoid\") then\n        setSpeed(descendant)\n    end\nend\n\nnpcs.DescendantAdded:Connect(\n    function(descendant)\n        if descendant:IsA(\"Humanoid\") then\n            setSpeed(descendant)\n        end\n    end\n)\n","owner":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","verified":false,"profilePicture":"/images/photo/67bc97cb97d44a5622870c63-1779784138529.png","status":"offline","id":"67bc97cb97d44a5622870c63","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":2697,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-0b4058de6a2ac27e6967d553b12c8ff8-eae8c4b7876c.png","likeCount":3,"dislikeCount":3,"createdAt":"2026-01-30T04:49:52.554Z","editBy":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","status":"offline","id":"67bc97cb97d44a5622870c63"},"keyLink":"","executes":45,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"697c387092a4802284080109","editBy":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","status":"offline","id":"67bc97cb97d44a5622870c63"},"message":"Create script","createdAt":"2026-01-30T04:49:52.556Z"},{"_id":"697c388fc79db56a303b7766","editBy":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","status":"offline","id":"67bc97cb97d44a5622870c63"},"message":"Update script","createdAt":"202