{"slug":"NEWMuseum-RNG-change-npc-speeds-95606","_id":"697c387092a4802284080106","title":"change npc speeds","game":{"_id":"697c387092a4802284080103","gameId":88615997771503,"name":"🏦Museum RNG","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":88615997771503},"features":"if it doesnt work instantly, wait 30 seconds to a minute and it should work fine then","tags":[],"script":"local npcs = workspace:WaitForChild(\"NPCs\")\n\nlocal function setSpeed(humanoid)\n    humanoid.WalkSpeed = 50\nend\n\nfor _, descendant in ipairs(npcs:GetDescendants()) do\n    if descendant:IsA(\"Humanoid\") then\n        setSpeed(descendant)\n    end\nend\n\nnpcs.DescendantAdded:Connect(\n    function(descendant)\n        if descendant:IsA(\"Humanoid\") then\n            setSpeed(descendant)\n        end\n    end\n)\n","owner":{"_id":"67bc97cb97d44a5622870c63","username":"oatssi","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1484268a0ad67e2b36aae926e758be00a4b3350756596ca549814fd03a6696fa.webp","original":"https://scriptblox.com/images/photo/67bc97cb97d44a5622870c63-1779784138529.png"},"status":"offline","id":"67bc97cb97d44a5622870c63","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/1484268a0ad67e2b36aae926e758be00a4b3350756596ca549814fd03a6696fa.webp","original":"https://scriptblox.com/images/photo/67bc97cb97d44a5622870c63-1779784138529.png"}},"verified":false,"views":2706,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/5ad50a2c7fcb2bd0123fd500099851b1ef160da5c4b48969742e5bb88a4e5169.webp","original":"https://scriptblox.com/images/sb/rbx-0b4058de6a2ac27e6967d553b12c8ff8-eae8c4b7876c.png","scriptblox":"https://scriptblox.com/images/script/rbx-0b4058de6a2ac27e6967d553b12c8ff8-eae8c4b7876c.png"},"likeCount":3,"dislikeCount":3,"createdAt":"2026-01-30T