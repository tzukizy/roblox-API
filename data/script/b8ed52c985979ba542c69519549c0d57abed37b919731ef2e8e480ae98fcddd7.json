yers\").LocalPlayer\n\nlocal mt = getrawmetatable(game)\nlocal old = mt.__index\nsetreadonly(mt, false)\nmt.__index = newcclosure(function(self, k)\n    if self:IsA(\"Humanoid\") and (k == \"FloorMaterial\" or k == \"MoveDirection\") then\n        return (k == \"FloorMaterial\" and Enum.Material.Plastic or Vector3.new(0,0,0))\n    end\n    return old(self, k)\nend)\nsetreadonly(mt, true)\n\ntask.spawn(function()\n    while task.wait(0.1) do\n        local Char = Player.Character\n        local Root = Char and Char:FindFirstChild(\"HumanoidRootPart\")\n        local Hum = Char and Char:FindFirstChildOfClass(\"Humanoid\")\n        \n        if Root and Hum then\n            Root.Velocity = Vector3.new(Root.Velocity.X, 0, Root.Velocity.Z)\n            Hum:ChangeState(11) \n            pcall(function()\n                sethiddenproperty(Root, \"NetworkIsSleeping\", true)\n            end)\n        end\n    end\nend)\n\n","features":"OP AND MADE BY IAMDOWNONTOP \n-- 1 DONT FLY RANDOMLY!!!!⚠️⚠️\n\n-- 2 DONT FLY SO FAST⚠️⚠️","tags":["Made by iamdownontop"],"discord":"","keyLink":"","owner":{"_id":"6950340a9fd82b3b345410fd","username":"LuaScripter355","verified":false,"profilePicture":{"url":"https://media.kocakz.me/32609730f38b181e7c945635371e217711e335c3ca6f8065bddc64e69003638d.webp","original":"https://scriptblox.com/images/photo/6950340a9fd82b3b345410fd-1771588101285.png"},"lvl":9,"status":"offline","id":"6950340a9fd82b3b345410fd","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/32609730f38b181e7c945635371e217711e335c3ca6f8065bddc64e69003638d.webp","original":"https://scriptblox.com/images/photo/6950340a9fd82b3b345410fd-1771588101285.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:31:40.147Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changel