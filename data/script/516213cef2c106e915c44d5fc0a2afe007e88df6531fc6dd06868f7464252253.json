{"slug":"Universal-Script-Night-And-Motion-Blur-30733","_id":"67c4e576fcc125c620757e7f","title":"Night And Motion Blur","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/1600699-1740957046497.png","placeId":0},"features":"Makes your game into Night\nAdds a Blur in your screen\nOptimizes game performance (a little)","tags":["Night"],"script":"local lighting = game:GetService(\"Lighting\")\n\n\nlighting.TimeOfDay = \"00:00:00\"  \nlighting.ClockTime = 0           \nlighting.Brightness = 0.1        \nlighting.FogEnd = 100            \nlighting.FogStart = 0\nlighting.Ambient = Color3.fromRGB(20, 20, 40) \n\n-- Enable Motion Blur\nlocal motionBlur = Instance.new(\"BlurEffect\")\nmotionBlur.Size = 8\nmotionBlur.Parent = lighting","owner":{"_id":"67ac7350bd7a0a9ead5746f4","username":"Meekz","verified":false,"profilePicture":"/images/photo/67ac7350bd7a0a9ead5746f4-1741512937213.jpg","status":"offline","id":"67ac7350bd7a0a9ead5746f4","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":4426,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-02T23:10:46.903Z","dislikeCount":2,"likeCount":2,"image":"/images/sb/1600699-1740957046497.png","executes":128,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c55487","editBy":{"_id":"67ac7350bd7a0a9ead5746f4","username":"Meekz","status":"offline","id":"67ac7350bd7a0a9ead5746f4"},"message":"Create script","createdAt":"2025-03-27T20:57:07.684Z"}],"comments":[{"_id":"68136304219af807bf9a7c5c","commentBy":{"_id":"68044fd5cd40f6a1ade42daf","username":"dpavlicek2","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-04-20T01:37:25.917Z","lastActive":"2025-05-01T19:02:43.132Z","status":"offline","id":"68044fd5cd40f6a1ade42daf"},"text":"The night is too dark and can't see nothing","edited":fals