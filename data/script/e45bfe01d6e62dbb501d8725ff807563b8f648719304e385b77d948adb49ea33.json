{"slug":"Swordflare!-RPG-Adventure-Auto-Farm-Keyless-136730","_id":"69b1d3b367b3dcfd36391d4e","title":"Auto Farm Keyless","game":{"_id":"69b1d3b367b3dcfd36391d4b","gameId":135729775388521,"name":"[NEW BOSS] Swordflare! ⚔️ RPG Adventure","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":135729775388521},"features":"Auto Farm ;\n- Teleport to ALL mobs and hit them twice\n\nModify your input in the script (I use E & T for healing & damages personally)\n\nVarient with menu to pick mobs to farm : \nhttps://pastebin.com/raw/CZ10N38z","tags":["autofarm","keyless"],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal LocalPlayer = Players.LocalPlayer\nlocal enemies = workspace:WaitForChild(\"Enemies\")\n\nlocal skillRemote = ReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"SkillInput\")\n\nlocal function getClickRemote()\n    local character = LocalPlayer.Character\n    if not character then return nil end\n\n    for _, tool in pairs(character:GetChildren()) do\n        if tool:IsA(\"Tool\") then\n            local remotes = tool:FindFirstChild(\"Remotes\")\n            if remotes then\n                local click = remotes:FindFirstChild(\"Click\")\n                if click then\n                    return click\n                end\n            end\n        end\n    end\nend\n\nwhile true do\n    local character = LocalPlayer.Character\n    local root = character and character:FindFirstChild(\"HumanoidRootPart\")\n    local click = getClickRemote()\n\n    if root and click then\n        for _, enemy in pairs(enemies:GetChildren()) do\n            local hitbox = enemy:FindFirstChild(\"Hitbox\")\n            local humanoid = enemy:FindFirstChildOfClass(\"Humanoid\")\n\n            if hitbox and humanoid and humanoid.Health > 0 then\n                \n                root.CFrame = hitbox.CFrame\n\n                skillRemote:FireServer(\"E\")\n                skillRemote:FireServer(\"T\")\n\n                click:FireServer()\n                click:FireServer()\n\n                task.wait(0.1)\n            end\n        end\n    end\n\n    task.wait()\nend","owner":{"_id":"698e81e93384bf4618026322","username":"Rob666","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b5b9de4edf25e302732a4b1f34ad93c9345fb87c99dfc009abe59f4e15e145af.webp","original":"https://scriptblox.com/images/photo/698e81e93384bf4618026322-1776646233535.png"},"status":"offline","id":"698e81e93384bf4618026322","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/b5b9de4edf25e302732a4b1f34ad93c9345fb87c99dfc009abe59f4e15e145af.webp","original":"https://scriptblox.com/images/photo/698e81e93384bf4618026322-1776646233535.png"}},"verified":false,"views":1143,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/71a3c6594823f1d7c2d225947d3e9fbd34d502d3ee4d585b2bdc3c9174e65004.webp","original":"https://scriptblox.com/images/sb/rbx-3b7dec7d05f6c4689c08dfc989be51bd-f8acab0f9d78.png","scriptblox":"https://scriptblox.com/images/script/rbx-3b7dec7d05f6c4689c08dfc989be51bd-f8acab0f9d78.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-11T20:42:27.880Z","keyLink":"","executes":4,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:21:59.199Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/71a3c6594823f1d7c2d225947d3e9fbd34d502d3ee4d585b2bdc3c9174e65004.webp","original":"https://scriptblox.com/images/sb/rbx-3b7dec7d05f6c4689c08dfc989be51bd-f8acab0f9d78.png","scriptblox":"https://scriptblox.com/images/script/rbx-3b7dec7d05f6c4689c08dfc989be51bd-f8acab0f9d78.png"}