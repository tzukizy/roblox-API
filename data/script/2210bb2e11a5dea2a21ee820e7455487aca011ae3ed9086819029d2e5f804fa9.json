nTab:AddDropdown({\n    Name = \"Select Weapon\",\n    Default = \"\",\n    Options = weaponnames,\n    Callback = function(selectedweapon)\n        local weapon = workspace.Weapons:FindFirstChild(selectedweapon)\n        if weapon then\n            local targetCFrame = weapon:IsA(\"Model\") and weapon.PrimaryPart and weapon.PrimaryPart.CFrame or weapon:FindFirstChildWhichIsA(\"BasePart\") and weapon:FindFirstChildWhichIsA(\"BasePart\").CFrame\n            if targetCFrame then\n                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame\n            end\n        end\n    end    \n})\n\nlocal function autodeletedoors()\n    for _, obj in pairs(game.Workspace:GetDescendants()) do\n        if obj:IsA(\"BasePart\") and string.find(string.lower(obj.name), \"door\") then\n            obj:Destroy()\n        end\n    end\nend\n\nMainTab:AddButton({\n    Name = \"Auto Delete All Doors\",\n    Callback = function()\n        autodeletedoors()\n        game.Workspace.DescendantAdded:Connect(function(obj)\n            if obj:IsA(\"BasePart\") and string.find(string.lower(obj.name), \"door\") then\n                obj:Destroy()\n            end\n        end)\n    end\n})\n\nOrionLib:Init()","features":"Have auto teleport to guns\nAnd delete all doors","tags":[],"discord":"","keyLink":"","owner":{"_id":"66cdd57cd38dc78bf695669a","username":"Goodguy29","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66cdd57cd38dc78bf695669a","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:05:26.995Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cf5d","editBy":{