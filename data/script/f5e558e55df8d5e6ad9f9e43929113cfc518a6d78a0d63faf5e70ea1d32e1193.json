{"slug":"Universal-Script-Fix-lag-all-game-24449","_id":"675d6452e75a268de041b1f5","title":"Fix lag all game","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Fix lag","tags":[],"script":"local ToDisable = {\n\tTextures = true,\n\tVisualEffects = true,\n\tParts = true,\n\tParticles = true,\n\tSky = true\n}\n\nlocal ToEnable = {\n\tFullBright = false\n}\n\nlocal Stuff = {}\n\nfor _, v in next, game:GetDescendants() do\n\tif ToDisable.Parts then\n\t\tif v:IsA(\"Part\") or v:IsA(\"Union\") or v:IsA(\"BasePart\") then\n\t\t\tv.Material = Enum.Material.SmoothPlastic\n\t\t\ttable.insert(Stuff, 1, v)\n\t\tend\n\tend\n\t\n\tif ToDisable.Particles then\n\t\tif v:IsA(\"ParticleEmitter\") or v:IsA(\"Smoke\") or v:IsA(\"Explosion\") or v:IsA(\"Sparkles\") or v:IsA(\"Fire\") then\n\t\t\tv.Enabled = false\n\t\t\ttable.insert(Stuff, 1, v)\n\t\tend\n\tend\n\t\n\tif ToDisable.VisualEffects then\n\t\tif v:IsA(\"BloomEffect\") or v:IsA(\"BlurEffect\") or v:IsA(\"DepthOfFieldEffect\") or v:IsA(\"SunRaysEffect\") then\n\t\t\tv.Enabled = false\n\t\t\ttable.insert(Stuff, 1, v)\n\t\tend\n\tend\n\t\n\tif ToDisable.Textures then\n\t\tif v:IsA(\"Decal\") or v:IsA(\"Texture\") then\n\t\t\tv.Texture = \"\"\n\t\t\ttable.insert(Stuff, 1, v)\n\t\tend\n\tend\n\t\n\tif ToDisable.Sky then\n\t\tif v:IsA(\"Sky\") then\n\t\t\tv.Parent = nil\n\t\t\ttable.insert(Stuff, 1, v)\n\t\tend\n\tend\nend\n\ngame:GetService(\"TestService\"):Message(\"Effects Disabler Script : Successfully disabled \"..#Stuff..\" assets / effects. Settings :\")\n\nfor i, v in next, ToDisable do\n\tprint(tostring(i)..\": \"..tostring(v))\nend\n\nif ToEnable.FullBright then\n    local Lighting = game:GetService(\"Lighting\")\n    \n    Lighting.FogColor = Color3.fromRGB(255, 255, 255)\n    Lighting.FogEnd = math.huge\n    Lighting.FogStart = math.huge\n    Lighting.Ambient = Color3.fromRGB(255, 255, 255)\n    Lighting.Brightness = 5\n    Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)\n    Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)\n    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)\n    Lighting.Outlines = true\nend","owner":{"_id":"6751bdf3729ea9e56d7afed3","username":"Oooooooieiiiie","verified":false,"profilePicture":{"url":"https://media.kocakz.me/bffccace787c4bd724301a6a8a0a283bd6ba8e222b263ec8fb14f1fcaa5c2b81.webp","original":"https://scriptblox.com/images/photo/6751bdf3729ea9e56d7afed3-1769528809290.jpeg"},"status":"offline","id":"6751bdf3729ea9e56d7afed3","profile":{"url":"https://media.kocakz.me/bffccace787c4bd724301a6a8a0a283bd6ba8e222b263ec8fb14f1fcaa5c2b81.webp","original":"https://scriptblox.com/images/photo/6751bdf3729ea9e56d7afed3-1769528809290.jpeg"}},"verified":false,"keyLink":"","views":90966,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-12-14T10:56:18.650Z","dislikeCount":1,"likeCount":1,"image":{"url":"https://media.kocakz.me/71b9896884b90912e2c19b86f33bfaa9682bb2eef4863572dd40bd8be7b84b7b.webp","original":"https://scriptblox.com/images/sb/2526811-1734173778603.png","scriptblox":"https://scriptblox.com/images/script/2526811-1734173778603.png"},"executes":884080,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":656873,"at":"2026-09-29T05:45:00.006Z"},{"key":"script.executions","tier":100000,"value":656873,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:16:45.545Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/71b9896884b90912e2c19b86f33bfaa9682bb2eef4863572dd40bd8be7b84b7b.webp","original":"https://scriptblox.com/images/sb/2526811-1734173