{"_id":"66b937c6a3775bb71932ae31","title":"clickDetectors and touchInterest","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/55eb32d6b2867e6cc582f938d4d31067dbb4142486115753408ecbaf4c4318f9.webp","original":"https://scriptblox.com/images/sb/5817284-1723414470789.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/55eb32d6b2867e6cc582f938d4d31067dbb4142486115753408ecbaf4c4318f9.webp","original":"https://scriptblox.com/images/sb/5817284-1723414470789.png"},"placeId":0},"slug":"Universal-Script-clickDetectors-and-touchInterest-17074","verified":false,"key":false,"keyless":false,"views":123976,"executes":294,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5707a3489504774286e18cc7a1502e745041ec36f2b8395b4b05d27f5b0cf2c8.webp","original":"https://scriptblox.com/images/sb/5817284-1723414470789.png","scriptblox":"https://scriptblox.com/images/script/5817284-1723414470789.png"},"thumbnail":{"url":"https://media.kocakz.me/5707a3489504774286e18cc7a1502e745041ec36f2b8395b4b05d27f5b0cf2c8.webp","original":"https://scriptblox.com/images/sb/5817284-1723414470789.png","scriptblox":"https://scriptblox.com/images/script/5817284-1723414470789.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2024-08-11T22:14:30.831Z","updatedAt":"2024-08-11T22:14:30.831Z","lastBump":"2024-08-11T22:14:30.831Z","script":"local player = game.Players.LocalPlayer\nlocal character = player.Character\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\nlocal function simulateTouch(part)\n    if part and part:IsA(\"BasePart\") then\n        firetouchinterest(humanoidRootPart, part, 0)\n        wait(0.1)\n        firetouchinterest(humanoidRootPart, part, 1)\n    end\nend\nlocal function simulateClick(clickDetector)\n    if clickDetector and clickDetector:IsA(\"ClickDetector\") then\n        clickDetector:FireServer()\n    end\nend\nfor _, instance in pairs(game:GetDescendants()) do\n    if instance:IsA(\"BasePart\") then\n        if instance:FindFirstChildOfClass(\"TouchTransmitter\") then\n            simulateTouch(instance)\n        end\n        local clickDetector = instance:FindFirstChildOfClass(\"ClickDetector\")\n        if clickDetector then\n            simulateClick(clickDetector)\n        end\n    end\nend","features":"Fires all the touchinterest and clickdetectors in a game\n\nMade by ChatGPT 4.0","tags":["*ty","Script"],"discord":"","keyLink":"","owner":{"_id":"6678169b794e634f0700eaa2","username":"UnnesscaryInventions","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b4f7417ef8e37d71c75b66ea5026724eba78d2adbdf20015022a9e1673e7dfd2.webp","original":"https://scriptblox.com/images/photo/6678169b794e634f0700eaa2-1719146257838.jpg"},"status":"offline","id":"6678169b794e634f0700eaa2","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/b4f7417ef8e37d71c75b66ea5026724eba78d2adbdf20015022a9e1673e7dfd2.webp","original":"https://scriptblox.com/images/photo/6678169b794e634f0700eaa2-1719146257838.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:19:51.558Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51b5f","editBy":{"_id":"6678169b794e634f0700eaa2","username":"UnnesscaryInventions","status":"offline","id":"6678169b794e634f0700eaa2"},"message":"Create script","createdAt":"2025-03-27T22:11:40.719Z"}],"comments":[]}