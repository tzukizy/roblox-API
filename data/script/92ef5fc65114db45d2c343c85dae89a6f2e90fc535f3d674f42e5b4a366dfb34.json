{"_id":"6240a4a1ffc9315ae79cda88","title":"*Blatant* Hitbox Expander","game":{"_id":"67e5e1ffb360710ec3c77fb2","gameId":2377868063,"name":"Strucid","imageUrl":{"url":"https://media.kocakz.me/2b606480280fdbab29f7f01dbfb20bb130f6226fbc3eb88927bc8c763c241a4b.webp","original":"https://tr.rbxcdn.com/180DAY-6beecefea758d87d35ae557ee7263e91/150/150/Image/Png/noFilter"},"slug":"2377868063-strucid","path":"/game/2377868063-strucid","thumbnail":{"url":"https://media.kocakz.me/2b606480280fdbab29f7f01dbfb20bb130f6226fbc3eb88927bc8c763c241a4b.webp","original":"https://tr.rbxcdn.com/180DAY-6beecefea758d87d35ae557ee7263e91/150/150/Image/Png/noFilter"},"placeId":2377868063},"slug":"ZONE-WAR!!-Strucid-*OP*-Hitbox-Expander-1501","verified":false,"key":false,"keyless":false,"views":11605,"executes":21,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/32e5a8fb66b5c91372b8b15fb085784a/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/32e5a8fb66b5c91372b8b15fb085784a/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/32e5a8fb66b5c91372b8b15fb085784a/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/32e5a8fb66b5c91372b8b15fb085784a/500/280/Image/Jpeg"},"likeCount":3,"dislikeCount":0,"createdAt":"2022-03-27T17:53:37.168Z","updatedAt":"2022-03-27T17:53:37.168Z","lastBump":"2022-03-27T17:53:37.168Z","script":"-- loop\ngame:GetService(\"RunService\").Stepped:Connect(function()\n    -- gets all players in the server\n    for _, player in next, game:GetService(\"Players\"):GetPlayers() do\n        -- checks if the player found was not the local player, so the local player doesnt get his hitbox extended\n        if player ~= game:GetService(\"Players\").LocalPlayer then\n            -- finds humanoid root part, then changes transparecy and can collide so you can walk through the hitbox and it wont be wonky\n            if player.Character:FindFirstChild(\"HumanoidRootPart\") then\n                player.Character[\"HumanoidRootPart\"].CanCollide = false\n                player.Character[\"HumanoidRootPart\"].Transparency = 0.5\n            end\n            \n            -- changes the humanoidrootpart size (basically the main code)\n            if player.Character[\"HumanoidRootPart\"].Size ~= Vector3.new(20, 20, 20) then\n                player.Character[\"HumanoidRootPart\"].Size = Vector3.new(20, 20, 20)\n            end\n        end\n    end\nend)","features":"Features:\n\n- Hitbox Expander\n- Blatant","tags":["op","strucid","hitbox","hitbox expander"],"discord":"","keyLink":"","owner":{"_id":"61f824363eea70181390669c","username":"Impulse","verified":true,"profilePicture":{"url":"https://media.kocakz.me/c3c30704c4baa6bc92c3a29d2a51dcddf5f336b53a23274adc725c460f1277a4.webp","original":"https://scriptblox.com/images/photo/61f824363eea70181390669c-1751898446029.jpg"},"status":"offline","id":"61f824363eea70181390669c","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/c3c30704c4baa6bc92c3a29d2a51dcddf5f336b53a23274adc725c460f1277a4.webp","original":"https://scriptblox.com/images/photo/61f824363eea70181390669c-1751898446029.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:13:40.460Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f096","editBy":{"_id":"61f824363eea70181390669c","username":"Impulse","status":"offline","id":"61f824363eea70181390669c"},"message":"Create script","createdAt":"2025-03-27T23:04:59.795Z"}],"comments":[]}