{"slug":"Universal-Script-rotation-copier-41616","_id":"683eb472887257f4608645dc","title":"rotation copier","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1748939890654.png","placeId":0},"features":"this script makes you look the same direction the player is looking (hopefully) :)","tags":[],"script":"getgenv().rotationcopier = false -- false to disable\nlocal target = \"twinki\" -- can be shortened\n\n-- actual code\nlocal function getFullTargetUser()\n\tfor i,v in pairs(game:GetService(\"Players\"):GetPlayers()) do\n\t\tif string.find(v.Name, target) then\n\t\t\treturn v.Name\n\t\tend\n\tend\nend\nlocal fulluser = getFullTargetUser()\nlocal targethrp = workspace[fulluser].HumanoidRootPart\nlocal cam = workspace.CurrentCamera\nwhile getgenv().rotationcopier == true do\n\tcam.CFrame = CFrame.new(targethrp.CFrame.Position, targethrp.CFrame.LookVector * 100)\n\ttask.wait()\nend","owner":{"_id":"676dd5feae40db1f99d83bbe","username":"hellohell666","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"676dd5feae40db1f99d83bbe","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":1652,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1748939890654.png","likeCount":0,"dislikeCount":1,"createdAt":"2025-06-03T08:38:10.735Z","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"683eb472887257f4608645df","editBy":{"_id":"676dd5feae40db1f99d83bbe","username":"hellohell666","status":"offline","id":"676dd5feae40db1f99d83bbe"},"message":"Create script","createdAt":"2025-06-03T08:38:10.739Z"}],"comments":[{"_id":"683ee4bfac49f0aca73850a9","commentBy":{"_id":"67ffb01dd2a9a4a3e2b9249c","username":"GuyWhoScripts","verified":false,"role":"user","profilePicture":"/images/photo/67ffb01dd2a9a4a3e2b9249c-1776063634628.jpg","createdAt":"2025-04-16T13:26:53.691Z","lastA