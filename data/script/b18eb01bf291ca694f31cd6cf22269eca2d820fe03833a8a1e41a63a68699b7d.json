nction(selectedBoat)\n        print(\"Attempting to select boat:\", selectedBoat)  -- Debugging line\n        local success, err = pcall(function()\n            game:GetService(\"ReplicatedStorage\").EventsFolder.BoatSelection.UpdateHostBoat:FireServer(selectedBoat)\n        end)\n        if not success then\n            warn(\"Error while selecting boat:\", err)  -- Debugging line\n        else\n            print(\"Boat selection successful!\")  -- Debugging line\n        end\n    end    \n})","owner":{"_id":"66d7fd917fe64a4656ea2c2a","username":"Iknowhowtoscript","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66d7fd917fe64a4656ea2c2a","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":26521,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-09-16T12:26:49.103Z","dislikeCount":1,"likeCount":3,"image":"https://tr.rbxcdn.com/65f5cd242d3b813bf43dac9160adce81/500/280/Image/Jpeg","executes":77,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cc59","editBy":{"_id":"66d7fd917fe64a4656ea2c2a","username":"Iknowhowtoscript","status":"offline","id":"66d7fd917fe64a4656ea2c2a"},"message":"Create script","createdAt":"2024-09-17T01:14:01.711Z"},{"_id":"67e5e1e3b360710ec3c4cc5a","editBy":{"_id":"66d7fd917fe64a4656ea2c2a","username":"Iknowhowtoscript","status":"offline","id":"66d7fd917fe64a4656ea2c2a"},"message":"Update script","createdAt":"2024-09-17T01:32:30.556Z"},{"_id":"67e5e1e3b360710ec3c4cc5b","editBy":{"_id":"66d7fd917fe64a4656ea2c2a","username":"Iknowhowtoscript","status":"offline","id":"66d7fd917fe64a4656ea2c2a"},"message":"Update script","createdAt":"2024-09-17T02:46:49.141Z"},{"_id":"67e5e1e6b360710ec3c52192","editBy":{"_id":"66d7fd917fe64a4656ea2c2a","username":"Iknowhowtoscript","status":"offline","id":"66d7fd917fe64a4656ea2c2a"},"message":"Update script","createdAt":"2025-