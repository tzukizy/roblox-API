{"slug":"UP-Just-a-baseplate.-Star-Glitcher-By-Theo-102526","_id":"698463b964879f8f6fc79c66","title":"Star Glitcher By Theo","game":{"_id":"692cce798e77b801d62ad020","gameId":123974602339071,"name":"[UP] Just a baseplate.","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":123974602339071},"features":"has 14 modes","tags":[],"script":"\nfunction notify(text,dur)\nlocal Notify=game:GetService(\"StarterGui\")\nNotify:SetCore(\"SendNotification\",{\nTitle=\"From Theo\";\nDuration=5 or dur,\nText=text})\nend\n\nlocal angles=CFrame.fromEulerAngles \nlocal Global=(getgenv and getgenv()) or shared\nGlobal.Config={\n[\"Permadeath\"]=true,\n-- Self explanatory(Replicatesignal)\n[\"SmoothCamera\"]=false, \n-- Self explanatory\n[\"PreloadAnimation\"]=false,\n-- Set this to true if your executor supports Replicatesignal(most support)\n[\"Refit\"]=true, \n-- Refit if Hats Fall Off(uses Replicatesignal)\n[\"Breakjoints\"]=3,\n--1 - Breakjoint+Health(most support)\n--2 - Health Or Breakjoint\n--3 - Breakjoints\n--4 - ServerBreakJoints\n[\"RespawnTp\"]=1, \n--0 stay at spawn\n--1 - random tp close\n--2 - behind char\n--3 - hidebody(no need to set to 3, script automatically hides it)\n[\"Placeholder\"]=false, \n-- If you wanna display the missing parts\n\n\n--// Custom Rigs\n[\"UseCustomRigs\"]=false,\n-- Basically, you add your own rigs so the glitcher can support it, pretty cool right?\n[\"CRigs\"]={\n  [\"LArm\"]={\n    --//Follow this pattern \n   -- {AccName=\"ACTUALCCESSORYNAME\" ,Angles=angles(X,Y,Z)} \n   {\n     AccName=\"Accessory (LArmNoob)\",Angles=angles(0,0,80.05)\n   },\n  },\n  [\"RArm\"]={\n    --//Follow this pattern \n   -- {AccName=\"ACTUALCCESSORYNAME\" ,Angles=angles(X,Y,Z)} \n    {\n     AccName=\"Accessory (RArmNoob)\",Angles=angles(0,0,80.05)\n   },\n  },\n  [\"LLeg\"]={\n    --//Follow this pattern \n   -- {AccName=\"ACTUALCCESSORYNAME\" ,Angles=angles(X,Y,Z)} \n    {\n     AccName=\"Accessory (LLegNoob)\",Angles=angles(0,0,80.09)\n   },\n  },\n  [\"RLeg\"]={\n    --//Follow this pattern \n   -- {AccName=\"ACTUALCCESSORYNAME\" ,Angles=angles(X,Y,Z)} \n   {\n     AccName=\"Accessory (RLegNoob)\",Angles=angles(0,0,80.09)\n   },\n  },\n  [\"Torso\"]={\n    --//Follow this pattern \n   -- {AccName=\"ACTUALCCESSORYNAME\" ,Angles=angles(X,Y,Z)} \n  {\n     AccName=\"Accessory (TorsoNoob)\",Angles=angles(0,0,0)\n   },\n  },\n\n},\n}\n\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/Solary-3/Scripts/refs/heads/main/74f5d16c193b05bb.lua\"))()\nprint([[\n-- Current Rigs\n-- Noob Rig 15592798091,5316479641,5316539421,5268602207,5316549755,95290698984301,108186273151388,72292903231768,84451219120140,139904067056008,119927239686827\n\n-- White Rig 91118300743511,88245158514202,77645930521012,129918670841083,5316479641,5316539421,5268602207,5316549755,12723002425,82942681251131,140395948277978,102599402682100,90960046381276,128948172708607\n\n-- Black Rig 110134185593043,5316479641,5316539421,5268602207,5316549755,131385506535381,85392395166623,129462518582032,138364679836274,12850150835,106249329428811\n--// Current Modes and Keybinds(Numbers And Letter)\nAuxno - 1\nMalice - 1 + M(Defaut upon load)\nNiscisnya - 2 \nVibrance - 2 + M \nMayhem - 3 \nScourge - 3 + M\nGaia - 4 \nChromatic - 5 \nCensored - 5 + M \nArchangel - 6\nVanguard - 6 + M\nAegleseeker - 7\nEulogy - 8 \nAnarchus - 9\n\nG - Toggle UI Visibility \nF - Toggle Overhead Text\n]])\nsetclipboard(\"110134185593043,5316479641,5316539421,5268602207,5316549755,131385506535381,85392395166623,129462518582032,138364679836274,12850150835,106249329428811\")\ntask.wait(.5)\nsetclipboard(\"91118300743511,88245158514202,77645930521012,129918670841083,5316479641,5316539421,5268602207,5316549755,12723002425,82942681251131,140395948277978,102599402682100,90960046381276,128948172708607\")\ntask.wait(.5)\nsetclipboard(\"15592798091,5316479641,5316539421,5268602207,5316549755,95290698984301,108186273151388,72292903231768,84451219120140,139904067056008,119927239686827\")\ntask.wait(.5)\n\nnotify(\"rigs copied to clipboard and check console too\")","owner":{"_id":"68429fce28f4e97b9eed6d12","username":"Solar_Eccentrix","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4beef016d83721112b7685be515c42b592a5a8fe75e6e43a92cb23cc775a000d.webp","original":"https://scriptblox.com/images/photo/68429fce28f4e97b9eed6d12-1757920494741.jpg"},"lvl":8,"status":"offline","id":"68429fce28f4e97b9eed6d12","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/4beef016d83721112b7685be515c42b592a5a8fe75e6e43a92cb23cc775a000d.webp","original":"https://scriptblox.com/images/photo/68429fce28f4e97b9eed6d12-1757920494741.jpg"}},"verified":false,"views":2641,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/ad94c74edb53d590ed9594130f13d3994da76f7ee79b31a0d2c7a803c202021d.webp","original":"https://scriptblox.com/images/sb/123974602339071-1770283961773.jpg","scriptblox":"https://scriptblox.com/images/script/123974602339071-1770283961773.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-05T09:32:41.786Z","editBy":{"_id":"68429fce28f4e97b9eed6d12","username":"Solar_Eccentrix","status":"offline","id":"68429fce28f4e97b9eed6d12"},"keyLink":"","executes":1302,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:07:19.502Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/ad94c74edb53d590ed9594130f13d3994da76f7ee79b31a0d2c7a803c202021d.webp","original":"https://scriptblox.com/images/sb/123974602339071-1770283961773.jpg","scriptblox":"https://scriptblox.com/images/script/123974602339071-1770283961773.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"698463b96