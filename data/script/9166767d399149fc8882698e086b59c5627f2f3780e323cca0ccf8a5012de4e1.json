{"slug":"Universal-Script-Sirhurt-RayField-Compatibility-Fix-47400","_id":"688fc88ac31080f8e7234111","title":"Sirhurt RayField Compatibility Fix","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1754253450797.png","placeId":0},"features":"Allows Rayfield UI Library to work on SirHurt Executor.\n\nHow to Use:\nExecute this before running the script your having issues with and it will automatically redirect the scripts Rayfield loader to a fixed version of Rayfield.\n\nSorry for ugly ahh chatgpt thumbnail.","tags":["sirhurt","fix","universal","rayfield","free"],"script":"-- fixed loadstring\n-- loadstring(game:HttpGet(\"https://raw.githubusercontent.com/tomatotxt/code/refs/heads/main/rayfield\"))()\nlocal oldhttpget\noldhttpget = hookfunction(game.HttpGet, function(self, url, ...)\n    if url == \"https://sirius.menu/rayfield\" or url == \"https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua\" then\n        return oldhttpget(self, \"https://raw.githubusercontent.com/tomatotxt/code/refs/heads/main/rayfield\", ...)\n    end    \n    return oldhttpget(self, url, ...)\nend)\n\nlocal ishooked\nishooked = hookfunction(isfunctionhooked, function(func, ...)\n    if func == game.HttpGet then\n        return false\n    end\n    return ishooked(func, ...)\nend)\nprint(\"Sirhurt RayField Fix Ready.\")","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":"/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png","status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11013574}},"topMilestone":{"key":"creator.views","tier":10000000}},"verified":true,"views":32529,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1754253450797.png","likeCount":5,"dislikeCount":1,"createdAt":"2025-08-03T20:37:30.955Z","executes":220,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"688fc88ac31080f8e7234113","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-08-03T20:37:30.958Z"}],"comments":[{"_id":"688fc9183b11d3ebd1852e06","commentBy":{"_id":"67abe6a04114c8c3c604a5aa","username":"ReactorCoreDev","verified":false,"role":"user","profilePicture":"/images/photo/67abe6a04114c8c3c604a5aa-1743629312282.png","createdAt":"2025-02-12T00:09:04.751Z","lastActive":"2025-10-12T16:25:25.444Z","status":"offline","id":"67abe6a04114c8c3c604a5aa"},"text":"how does it work","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-03T20:39:52.707Z","liked":false,"disliked":false},{"_id":"688fc9aee91336202bf5b65b","commentBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"role":"user","profilePicture":"/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png","createdAt":"2022-01-23T04:56:31.387Z","lastActive":"2026-10-06T01:21:16.307Z","keylessCreator":true,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11013574}},"topMilestone":{"key":"creator.views","tier":10000000}},"text":"@ReactorCoreDev When a script tries to load rayfield ui this script will intercept and redirect it to a version of rayfield I made that is compatible with SirHurt Executor.","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-03T20:42:22.571Z","liked":false,"disliked":false},{"_id":"68903398f591134c309a3121","commentBy":{"_id":"67abe6a04114c8c3c604a5aa","username":"ReactorCoreDev","verified":false,"role":"user","profilePicture":"/images/photo/67abe6a04114c8c3c604a5aa-1743629312282.png","createdAt":"2025-02-12T00:09:04.751Z","lastActive":"2025-10-12T16:25:25.444Z","status":"offline","id":"67abe6a04114c8c3c604a5aa"},"text":"ohhhh ok i see but yeah ik it will intercept it","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-04T04:14:16.680Z","liked":false,"disliked":false},{"_id":"689033afaf1183926901d53d","commentBy":{"_id":"67abe6a04114c8c3c604a5aa","username":"ReactorCoreDev","verified":false,"role":"user","profilePicture":"/images/photo/67abe6a04114c8c3c604a5aa-1743629312282.png","createdAt":"2025-02-12T00:09:04.751Z","lastActive":"2025-10-12T16:25:25.444Z","status":"offline","id":"67abe6a04114c8c3c604a5aa"},"text":"do the same for onion library","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-04T04:14:39.887Z","liked":false,"disliked":false}]}