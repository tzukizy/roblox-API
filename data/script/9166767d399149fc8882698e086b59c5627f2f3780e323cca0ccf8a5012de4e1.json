{"_id":"688fc88ac31080f8e7234111","title":"Sirhurt RayField Compatibility Fix","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Sirhurt-RayField-Compatibility-Fix-47400","verified":true,"key":false,"keyless":false,"views":32544,"executes":236,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/62c8cd45d13c790c32cb1686e808c5892d8223d75175ba7044bac2c10bdd6454.webp","original":"https://scriptblox.com/images/sb/0-1754253450797.png","scriptblox":"https://scriptblox.com/images/script/0-1754253450797.png"},"thumbnail":{"url":"https://media.kocakz.me/62c8cd45d13c790c32cb1686e808c5892d8223d75175ba7044bac2c10bdd6454.webp","original":"https://scriptblox.com/images/sb/0-1754253450797.png","scriptblox":"https://scriptblox.com/images/script/0-1754253450797.png"},"likeCount":5,"dislikeCount":1,"createdAt":"2025-08-03T20:37:30.955Z","updatedAt":"2025-08-03T20:37:30.955Z","lastBump":"2025-08-03T20:37:30.955Z","script":"-- fixed loadstring\n-- loadstring(game:HttpGet(\"https://raw.githubusercontent.com/tomatotxt/code/refs/heads/main/rayfield\"))()\nlocal oldhttpget\noldhttpget = hookfunction(game.HttpGet, function(self, url, ...)\n    if url == \"https://sirius.menu/rayfield\" or url == \"https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua\" then\n        return oldhttpget(self, \"https://raw.githubusercontent.com/tomatotxt/code/refs/heads/main/rayfield\", ...)\n    end    \n    return oldhttpget(self, url, ...)\nend)\n\nlocal ishooked\nishooked = hookfunction(isfunctionhooked, function(func, ...)\n    if func == game.HttpGet then\n        return false\n    end\n    return ishooked(func, ...)\nend)\nprint(\"Sirhurt RayField Fix Ready.\")","features":"Allows Rayfield UI Library to work on SirHurt Executor.\n\nHow to Use:\nExecute this before running the script your having issues with and it will automatically redirect the scripts Rayfield loader to a fixed version of Rayfield.\n\nSorry for ugly ahh chatgpt thumbnail.","tags":["sirhurt","fix","universal","rayfield","free"],"discord":"","keyLink":"","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11038528}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:49:01.237Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"688fc88ac31080f8e7234113","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-08-03T20:37:30.958Z"}],"comments":[{"_id":"688fc9183b11d3ebd1852e06","commentBy":{"_id":"67abe6a04114c8c3c604a5aa","username":"ReactorCoreDev","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/5ead21a4692f22698d9d161bfd60398192699098daf968a19d373334e28fc7de.webp","original":"https://scriptblox.com/images/photo/67abe6a04114c8c3c604a5aa-1743629312282.png"},"createdAt":"2025-02-12T00:09:04