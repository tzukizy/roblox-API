tForChild(\"Events\"):WaitForChild(\"Quest\"):WaitForChild(\"UpdateQuest\")\n\nlocal TPS = {\n    CFrame.new(1221, -155, 225),\n    CFrame.new(1207, -159, 281),\n    CFrame.new(1771, -242, 1205),\n    CFrame.new(1783, -242, 1211)\n}\n\nlocal Cur = 1\n\nlocal function QuestFarmFree()\n    local GrabQuestRequestShi = Module:CanMakeRequest(player.UserId, GiveMeMyQuest, \"GrantQuest\", 0, 0)\n    local QuestUpdateShi = Module:CanMakeRequest(player.UserId, UpdateMyQuestMF, \"UpdateQuest\", 0, 0)\n\n    if QuestUpdateShi and GrabQuestRequestShi then\n        for i=1, 5 do\n            GiveMeMyQuest:FireServer(\"StonesOfBurden\")\n            UpdateMyQuestMF:FireServer(\"StonesOfBurden\")\n        end\n\n        if player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            player.Character.HumanoidRootPart.CFrame = TPS[Cur]\n            task.wait(0.5)\n            Cur = Cur % #TPS + 1\n        end\n    end\nend\n\nRunService.Heartbeat:Connect(QuestFarmFree)\n","features":"Quest Farm\n\nJoin: https://discord.gg/carded for more\n\nFyi: the game has rate limits so it might not grab quest sometimes","tags":[],"discord":"","keyLink":"","owner":{"_id":"667cfd43fbf55074f1169304","username":"vaxtogood","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"667cfd43fbf55074f1169304","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:10:04.823Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4cc4d","editBy":{"_id":"667cfd43fbf55074f1169304","username":"vaxtogood","status":"offline","id":"667cfd43fbf55074f1169304"},"message":"Create script","createdAt":"