{"slug":"simply-walk-around-it-ENABLE-JUMP-KEYLESS-239281","_id":"6a3cbbee459f57624e145e77","title":"ENABLE JUMP KEYLESS","game":{"_id":"6a1f1b8c10773cea7ba96b8f","gameId":91684267829554,"name":"simply walk around it [UPD]","imageUrl":"/images/sb/rbx-a00cfa8e70eff8f1389a541c4a470f43-29e8cc3bd0e9.png","placeId":91684267829554},"features":"so... you can jump, right?","tags":["KEYLESS","FREE"],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function jump(character)\n    if not character then return end\n    \n    local humanoid = character:WaitForChild(\"Humanoid\")\n    if humanoid then\n        humanoid.UseJumpPower = true\n        \n        humanoid.JumpPower = 50\n    end\nend\n\nif LocalPlayer.Character then\n    jump(LocalPlayer.Character)\nend\n\nLocalPlayer.CharacterAdded:Connect(jump)","owner":{"_id":"66eaf0a398d8193df188aed9","username":"FinalBossVisual","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66eaf0a398d8193df188aed9","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":222,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/91684267829554-1782365166414.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2026-06-25T05:26:06.432Z","executes":1040,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a3cbbee459f57624e145e79","editBy":{"_id":"66eaf0a398d8193df188aed9","username":"FinalBossVisual","status":"offline","id":"66eaf0a398d8193df188aed9"},"message":"Create script","createdAt":"2026-06-25T05:26:06.434Z"}],"comments":[]}