{"slug":"Universal-Script-Position-Lock-Loop-Teleport-13623","_id":"6659ac89d2eb807842337224","title":"Position Lock Loop Teleport","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Features:\n\n-Teleports player to a designated position. (position of char when executing)\n-Executes every 2 seconds. (can be changed)","tags":[],"script":"getgenv().teleport = true\n\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal currentPosition = humanoidRootPart.CFrame\nlocal targetPosition = Vector3.new(currentPosition.X, humanoidRootPart.Position.Y, currentPosition.Z) \n\nwhile getgenv().teleport do\n    wait(2) -- Teleport Delay (freeze char. under 1 second)\n    local TweenService = game:GetService('TweenService')\n    local currentCFrame = humanoidRootPart.CFrame\n    local rotation = currentCFrame - currentCFrame.p\n\n    local targetCFrame = CFrame.new(targetPosition) * rotation\n\n    local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Linear)\n    local tweenProperties = {\n        CFrame = targetCFrame\n    }\n\n    local tween = TweenService:Create(humanoidRootPart, tweenInfo, tweenProperties)\n    tween:Play()\nend\n","owner":{"_id":"660fde6734528ed61cdd2ec0","username":"venox","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/6de1799efc35d1096907297c0e3afe3e60ac6a198f9f6c5d12b230fcf61ad241.webp","original":"https://scriptblox.com/images/photo/660fde6734528ed61cdd2ec0-1718656185784.png"},"status":"offline","id":"660fde6734528ed61cdd2ec0","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/6de1799efc35d1096907297c0e3afe3e60ac6a198f9f6c5d12b230fcf61ad241.webp","original":"https://scriptblox.com/images/photo/660fde6734528ed61cdd2ec0-1718656185784.png"}},"verified":false,"keyLink":"","views":11233,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-05-31T10:55:05.525Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/32100b63f34e6173c5f355ce926358a79f7867b2632462f32eb4a6bb205a6e94.webp","original":"https://scriptblox.com/images/sb/3680351-1717152905369.webp","scriptblox":"https://scriptblox.com/images/script/3680351-1717152905369.webp"},"executes":213,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:21:20.865Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/32100b63f34e6173c5f355ce926358a79f7867b2632462f32eb4a6bb205a6e94.webp","original":"https://scriptblox.com/images/sb/3680351-1717152905369.webp","scriptblox":"https://scriptblox.com/images/script/3680351-1717152905369.webp"},"changelog":[{"_id":"67e5e1e5b360710ec3c50eca","editBy":{"_id":"660fde6734528ed61cdd2ec0","username":"venox","status":"offline","id":"660fde6734528ed61cdd2ec0"},"message":"Create script","createdAt":"2025-03-27T22:20:47.969Z"}],"comments":[{"_id":"66b15b538a2370184e3fb37f","commentBy":{"_id":"6692f3a09b1cb583d419f497","username":"StarProjectz","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/317bd5f27ff7b39679262efdea7c9365d77cd4fba9015824d771eea031337fe2.webp","original":"https://scriptblox.com/images/photo/6692f3a09b1cb583d419f497-1720906768514.png"},"createdAt":"2024-07-13T21:37:36.360Z","lastActive":"2025-07-11T23:28:55.930Z","status":"offline","id":"6692f3a09b1cb583d419f497","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/317bd5f27ff7b39679262efdea7c9365d77cd4fba9015824d771eea031337fe2.webp","original":"https://scriptblox.com/images/p