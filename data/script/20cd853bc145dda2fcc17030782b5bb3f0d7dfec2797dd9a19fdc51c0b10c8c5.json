l currentCFrame = humanoidRootPart.CFrame\n    local rotation = currentCFrame - currentCFrame.p\n\n    local targetCFrame = CFrame.new(targetPosition) * rotation\n\n    local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Linear)\n    local tweenProperties = {\n        CFrame = targetCFrame\n    }\n\n    local tween = TweenService:Create(humanoidRootPart, tweenInfo, tweenProperties)\n    tween:Play()\nend\n","features":"Features:\n\n-Teleports player to a designated position. (position of char when executing)\n-Executes every 2 seconds. (can be changed)","tags":[],"discord":"","keyLink":"","owner":{"_id":"660fde6734528ed61cdd2ec0","username":"venox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6de1799efc35d1096907297c0e3afe3e60ac6a198f9f6c5d12b230fcf61ad241.webp","original":"https://scriptblox.com/images/photo/660fde6734528ed61cdd2ec0-1718656185784.png"},"status":"offline","id":"660fde6734528ed61cdd2ec0","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/6de1799efc35d1096907297c0e3afe3e60ac6a198f9f6c5d12b230fcf61ad241.webp","original":"https://scriptblox.com/images/photo/660fde6734528ed61cdd2ec0-1718656185784.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:11:43.668Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50eca","editBy":{"_id":"660fde6734528ed61cdd2ec0","username":"venox","status":"offline","id":"660fde6734528ed61cdd2ec0"},"message":"Create script","createdAt":"2025-03-27T22:20:47.969Z"}],"comments":[{"_id":"66b15b538a2370184e3fb37f","commentBy":{"_id":"6692f3a09b1cb583d419f497","username":"StarProjectz","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/317bd5f27ff7b39679262efdea7c9365d77cd4fba9015824d771eea031337fe2.webp","original":"https://scriptblo