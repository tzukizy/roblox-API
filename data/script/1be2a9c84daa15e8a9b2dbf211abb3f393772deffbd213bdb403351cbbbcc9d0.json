r\"):Connect(function()\n           if descendant.Parent.BrickColor ~= BrickColor.new(\"Dark green\") then\n               fireclickdetector(descendant)\n           end\n       end)\n   end\nend)","owner":{"_id":"61e112b2f53971df8539224a","username":"Red_Velvet_Cookie","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61e112b2f53971df8539224a-1646011272549.png"},"status":"offline","id":"61e112b2f53971df8539224a","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61e112b2f53971df8539224a-1646011272549.png"}},"verified":false,"views":7627,"scriptType":"free","isUniversal":true,"isPatched":false,"createdAt":"2022-02-12T13:00:38.602Z","visibility":"public","dislikeCount":0,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/8504512-1644670838595.jpg","scriptblox":"https://scriptblox.com/images/script/8504512-1644670838595.jpg"},"executes":36,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T05:17:11.128Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/8504512-1644670838595.jpg","scriptblox":"https://scriptblox.com/images/script/8504512-1644670838595.jpg"},"changelog":[{"_id":"67e5e1e3b360710ec3c4e66c","editBy":{"_id":"61e112b2f53971df8539224a","username":"Red_Velvet_Cookie","status":"offline","id":"61e112b2f53971df8539224a"},"message":"Create script","createdAt":"2025-03-27T21:52:10.309Z"}],"comments":[{"_id":"6207aff207cecfe50e3b068c","commentBy":{"_id":"61e112b2f53971df8539224a","username":"Red_Velvet_Cookie","verified":false,"role":"user","profilePicture":{"url":"ht