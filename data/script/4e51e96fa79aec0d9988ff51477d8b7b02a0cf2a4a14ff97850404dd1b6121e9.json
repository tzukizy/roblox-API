FirstChild(\"HumanoidRootPart\") then\n        local playerPosition = player.Character.HumanoidRootPart.Position\n        gem.Position = playerPosition\n    end\nend\n\nwhile true do\n    for _, gem in ipairs(game.Workspace:GetChildren()) do\n        if isGem(gem) then\n            for _, player in ipairs(game.Players:GetPlayers()) do\n                if player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n                    local playerPosition = player.Character.HumanoidRootPart.Position\n                    local distance = (gem.Position - playerPosition).Magnitude\n                    moveGemToPlayer(gem, player)\n                end\n            end\n        end\n    end\n    wait(1) -- change there if lag\nend","features":"so em made by chatgpt 4o and improve by me,if you want put it in your hub or other... emm let me think,alr nvm just put\n\nso this script can just bring all gem when you buy flappa king but dont upgrade the auto collect, u can use this to collect and it have a little lag if u r laptop,if too lag set the wait() to 2+\n\nwork for solara","tags":[],"discord":"","keyLink":"","owner":{"_id":"669251dec0bffd5ea98e9011","username":"meistuxo","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"669251dec0bffd5ea98e9011","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:16:04.640Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c516cb","editBy":{"_id":"669251dec0bffd5ea98e9011","username":"meistuxo","status":"offline","id":"669251dec0bffd5ea98e9011"},"message":"Create script","createdAt":"2025-03-27T20:14:33.105Z"}],"com