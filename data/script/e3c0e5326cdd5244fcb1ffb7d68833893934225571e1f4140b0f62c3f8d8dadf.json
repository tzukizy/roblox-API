{"_id":"625701a49f250c13b0b3e42b","title":"Silent Aim","game":{"_id":"67e5e1ffb360710ec3c7835f","gameId":2182391396,"name":"CB:RO Archived","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"2182391396-cb-ro-archived","path":"/game/2182391396-cb-ro-archived","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":2182391396},"slug":"CB:RO-Archived-Silent-Aim-1921","verified":false,"key":false,"keyless":false,"views":8359,"executes":62,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/1f8d1759ceb20362d44ee6085678da73/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/1f8d1759ceb20362d44ee6085678da73/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/1f8d1759ceb20362d44ee6085678da73/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/1f8d1759ceb20362d44ee6085678da73/500/280/Image/Jpeg"},"likeCount":3,"dislikeCount":0,"createdAt":"2022-04-13T17:00:20.297Z","updatedAt":"2022-04-13T17:00:20.297Z","lastBump":"2022-04-13T17:00:20.297Z","script":"local function ClosestPlayer()\n    local Target\n    local MaxDistance = math.huge\n    for i,v in pairs(game.Players.GetPlayers(game.Players)) do\n        if v.Character then \n            if v.Character.FindFirstChild(v.Character, 'Humanoid') and v.Character.Humanoid.Health >= 1 and v.Team ~= game.Players.LocalPlayer.Team then\n                local Magnitude = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - v.Character.HumanoidRootPart.Position).Magnitude\n                if Magnitude < MaxDistance then\n                    MaxDistance = Magnitude\n                    Target = v\n                end\n            end\n        end\n    end\n    return Target\nend\n\nlocal mt = getrawmetatable(game)\nlocal old = mt.__namecall\nsetreadonly(mt, false)\nmt.__namecall = newcclosure(function(remote, ...)\n    local args = {...}\n    local method = getnamecallmethod()\n    if remote.Name == 'Fire' and tostring(method) == 'FireServer' then\n        args[1] = ClosestPlayer().Character.Head.Position\n        args[9] = ClosestPlayer().Character.Head\n        return remote.FireServer(remote, unpack(args))\n    end\n    return old(remote, ...)\nend)\nsetreadonly(mt, true)","features":"This script for Counter Blox Archived will kill anyone who is closest to your crosshair, this script can be used for rage and could be paired with ESP.","tags":["counter blox","exploits","scripts","aimbot","slient aim"],"discord":"","keyLink":"","owner":{"_id":"6228d57e50b2dabe8930fcab","username":"Mlaofmd","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6228d57e50b2dabe8930fcab","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:28:39.166Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4dff8","editBy":{"_id":"6228d57e50b2dabe8930fcab","username":"Mlaofmd","status":"offline","id":"6228d57e50b2dabe8930fcab"},"message":"Create script","createdAt":"2025-03-27T22:48:14.564Z"}],"comments":[{"_id":"6258775b2ee01cb8a8c9d00f","commentBy":{"_id":"621ef5ed266624224dc02ee3","username":"TimTom777","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/83ce7c1d7ed573cfdcdbd4246a3b5667b021824d5c8c69ac09be8526763d1510.webp","original":"https://scriptblox.com/images/photo/621ef5ed266624224dc02ee3-1733346933328.jpeg"},"createdAt":"2022-03-02T04:43:25.228Z","lastActive":"2026-06-06T22:41:18.284Z","status":"offline","id":"6