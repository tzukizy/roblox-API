{"slug":"Universal-Script-Inf-Jump-script-11981","_id":"660fab8834528ed61cdc19fc","title":"Inf Jump script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2080940-1712302983983.webp","placeId":0},"features":"hey inf jump script. that truly works!!!!!","tags":[],"script":"-- Infinite Auto-Jump Script\n-- Author: [Your Name]\n\nlocal Players = game:GetService(\"Players\")\nlocal Player = Players.LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\n\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\n-- Function to jump continuously\nlocal function autoJump()\n    if Humanoid.Jump then\n        Humanoid:ChangeState(\"Jumping\")\n    end\nend\n\n-- Connect the auto-jump function to the Heartbeat event\ngame:GetService(\"RunService\").Heartbeat:Connect(autoJump)\n\n-- Print a message to indicate the script is running\nprint(\"Infinite Auto-Jump Script loaded!\")","owner":{"_id":"6602ca9c9e0c84be4d94415f","username":"pnumboy","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6602ca9c9e0c84be4d94415f","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"keyLink":"","views":27918,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-04-05T07:43:04.016Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/2080940-1712302983983.webp","executes":11946,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":10578,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c508a0","editBy":{"_id":"6602ca9c9e0c84be4d94415f","username":"pnumboy","status":"offline","id":"6602ca9c9e0c84be4d94415f"},"message":"Create script","createdAt":"2025-03-27T22:16:11.599Z"}],"comments":[{"_id":"680620c65812a9e2a1de130d","commentBy":{"_id":"66d660d3694de7fc81b25530","username":"Vanta_Hub","verified":false,"r