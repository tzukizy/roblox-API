{"slug":"Universal-Script-Fe-script-made-by-jinxx-25037","_id":"67690e540cf0cc0090b0a7b5","title":"Fe script made by jinxx","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"It is like that utg script animation.","tags":[],"script":"-- made by jinxx\n\nlocal animationId = \"rbxassetid://97172005\"\n\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\n\nlocal animation = Instance.new(\"Animation\")\nanimation.AnimationId = animationId\n\nlocal animationTrack = humanoid:LoadAnimation(animation)\n\nlocal defaultWalkSpeed = humanoid.WalkSpeed\n\nlocal function onWalking(speed)\n    if speed > 0 then\n        humanoid.WalkSpeed = 50\n\n        animationTrack:Play()\n    else\n        humanoid.WalkSpeed = defaultWalkSpeed\n        animationTrack:Stop()\n    end\nend\n\nhumanoid.Running:Connect(onWalking)","owner":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"},"status":"offline","id":"6675627a3249494a4c405096","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"}},"verified":false,"keyLink":"","views":8896,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-12-23T07:16:36.532Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/8e6fd820a105d