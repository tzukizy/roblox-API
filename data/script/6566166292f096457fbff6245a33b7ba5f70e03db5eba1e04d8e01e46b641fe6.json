ait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n    local pos = hrp.Position\n    TextLabel.Text = \"X: \" .. math.floor(pos.X) .. \" | Y: \" .. math.floor(pos.Y) .. \" | Z: \" .. math.floor(pos.Z)\nend)","features":"Show where you are, this can be use to develop other scripts like tping to the coordinate you want","tags":[],"discord":"","keyLink":"","owner":{"_id":"68065f363ddfe7f175f7dc7c","username":"ThaiExploiter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68065f363ddfe7f175f7dc7c","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:46:21.489Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68bc3f5ff6e6affedd5b092c","editBy":{"_id":"68065f363ddfe7f175f7dc7c","username":"ThaiExploiter","status":"offline","id":"68065f363ddfe7f175f7dc7c"},"message":"Create script","createdAt":"2025-09-06T14:04:15.230Z"}],"comments":[{"_id":"68bc3fa6ddd9e899b0547d0a","commentBy":{"_id":"67a5b58f03e9aa476e839291","username":"zxcv","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/19c2de0dbe0b9f098012ef59c77f167fed6c35cad98e270198769e6406e348b7.webp","original":"https://scriptblox.com/images/photo/67a5b58f03e9aa476e839291-1762664789155.png"},"createdAt":"2025-02-07T07:26:07.704Z","lastActive":"2026-04-27T08:43:23.779Z","status":"offline","id":"67a5b58f03e9aa476e839291","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/19c2de0dbe0b9f098012ef59c77f167fed6c35cad98e270198769e6406e348b7.webp","original":"https://scriptblox.com/images/photo/67a5b58f03e9aa476e839291-1762664789155.png"}},"text":"i dont type.  i set