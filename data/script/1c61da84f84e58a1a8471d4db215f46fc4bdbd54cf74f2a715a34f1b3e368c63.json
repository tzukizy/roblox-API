{"slug":"The-Battle-Bricks-THE-AUTOMATIC-MORTIS-PROJECTILE-CLICKER-BUGGY-240931","_id":"6a476e71ea7cd7da7a9db3ec","title":"THE AUTOMATIC MORTIS PROJECTILE CLICKER BUGGY","game":{"_id":"67e5e1ffb360710ec3c7846e","gameId":10834586502,"name":"The Battle Bricks","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":10834586502},"features":"[VERY BUGGY, RELEASE!]\nTHIS IS A SCRIPT THAT AUTOCLICKS MORTIS'S PROJECTILES.\nSome bugs: The Clicker, clicking the orbs slowly, Sometimes not working on sorcusblades\n\nREMINDER: This can trigger the repent of depriver's minigame. idk how to make a bypass.. sorry...\nFUNK1D COMING SOON!!","tags":["The Battle Bricks","Mortis","Autoclicker"],"script":"local Workspace = game:GetService(\"Workspace\")\nlocal VIM = game:GetService(\"VirtualInputManager\")\nlocal UIS = game:GetService(\"UserInputService\")\nlocal camera = Workspace.CurrentCamera\nlocal projectileFolder = Workspace:WaitForChild(\"Projectile\")\n\nlocal targetAttacks = {\n    [\"SorcusBlade\"] = true,\n    [\"BigStar\"] = true,\n    [\"SuperStar\"] = true\n}\n\nlocal isMobile = UIS.TouchEnabled\nlocal touchCounter = 1\n\nlocal function autoTapTarget(targetObj)\n    if targetAttacks[targetObj.Name] then\n        \n        local targetPart = targetObj:IsA(\"BasePart\") and targetObj or targetObj:FindFirstChildWhichIsA(\"BasePart\", true)\n        \n        if targetPart then\n            while targetObj and targetObj.Parent and targetPart.Transparency < 1 do\n                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)\n                \n                if onScreen then\n                    if isMobile then\n                        local currentTouchId = touchCounter\n                        touchCounter = touchCounter + 1\n                        \n                        VIM:SendTouchEvent(currentTouchId, 0, screenPos.X, screenPos.Y)\n                        task.wait(0.02)\n                        VIM:SendTouchEvent(currentTouchId, 2, screenPos.X, screenPos.Y)\n                    else\n                        VIM:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)\n                        task.wait(0.02)\n                        VIM:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)\n                    end\n                end\n                \n                task.wait(0.05) \n            end\n        end\n    end\nend\n\nfor _, child in ipairs(projectileFolder:GetChildren()) do\n    task.spawn(autoTapTarget, child)\nend\n\nprojectileFolder.ChildAdded:Connect(function(child)\n    task.wait(0.05) \n    task.spawn(autoTapTarget, child)\nend)","owner":{"_id":"6a3c8bd705b2603faf5adc20","username":"AUTOMORTIS","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a3c8bd705b2603faf5adc20","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":2857,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/1080a506ccdb0a256d2c5c30a50f5b48a83d2ecc6795b82f7039a10e51c234ee.webp","original":"https://scriptblox.com/images/sb/10834586502-1783066225860.webp","scriptblox":"https://scriptblox.com/images/script/10834586502-1783066225860.webp"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-07-03T08:10:25.902Z","executes":1067,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:03:17.950Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/1080a506ccdb0a256d2c5c30a50f5b48a83d2ecc6795b82f7039a10e51c234ee.webp","original":"https://scriptblox.com/images/sb/10834586502-1783066225860.webp",