{"slug":"Be-A-Parkour-Ninja-Kill-All-40726","_id":"6830e49b6c7633323546115d","title":"Kill All","game":{"_id":"67e5e1ffb360710ec3c780fa","gameId":147848991,"name":"Be A Parkour Ninja","imageUrl":"/images/sb/rbx-d105a8fa12d7aa130f43bfef6c29eccb-13c70adb23d9.png","placeId":147848991},"features":"Made by @kylosilly\nTutorial:\n1. Equip Tool\nEnjoy","tags":["farm","ninja","sigma idk","yes","ok"],"script":"local replicated_storage = game:GetService(\"ReplicatedStorage\")\nlocal players = game:GetService(\"Players\")\nlocal local_player = players.LocalPlayer\n\ngetgenv().killall = true\n\nif killall then\n    repeat\n        for _, v in next, players:GetPlayers() do\n            if v ~= local_player and local_player.Character and local_player.Character:FindFirstChildOfClass(\"Tool\") and v.Character and v.Character:FindFirstChild(\"Humanoid\") and v.Character.Humanoid.Health > 0 and not v.Character:FindFirstChildOfClass(\"ForceField\") then\n                replicated_storage:WaitForChild(\"RemoteTriggers\"):WaitForChild(\"Bolster\"):FireServer(v.Character.Humanoid, v.Character:FindFirstChildOfClass(\"Tool\"))\n                task.wait()\n            end\n        end\n        task.wait()\n    until not killall\nend","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":"/images/photo/677be435ea4516cd66668ea7-1749212341564.png","status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":15995,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-d105a8fa12d7aa130f43bfef6c29eccb-13c70adb23d9.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-05-23T21:11:55.969Z","executes":2051,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6830e49b6c7633323546115f","editBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","status":"offline","i