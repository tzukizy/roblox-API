ina < 50 then\n\t\twait(.5)\n\t\tcontinue\n\tend\n\n\tlocal base = LP.Character.PrimaryPart.Position\n\n\tlocal candidates = {}\n\tlocal lowDistance = math.huge\n\tlocal lowDistanceTarget = nil\n\t\n\tfor _, plr in next, game.Players:GetChildren() do\n\t\tif plr == LP then\n\t\t\tcontinue\n\t\tend\n\t\t\n\t\tlocal character = plr.Character\n\t\tif not character or not character.PrimaryPart then\n\t\t\tcontinue\n\t\tend\n\t\t\n\t\tlocal distance = (base - character.PrimaryPart.Position).magnitude\n\t\tif distance > shared.kill_aura_range then\n\t\t\tcontinue\n\t\tend\n\t\t\n\t\tlocal health = tonumber(character:GetAttribute(\"Health\"))\n\t\tif not health or health == 0 then\n\t\t\tcontinue\n\t\tend\n\t\t\n\t\tif distance < lowDistance then\n\t\t\tlowDistance = distance\n\t\t\tlowDistanceTarget = character\n\t\tend\n\tend\n\n\tif lowDistanceTarget then\n\t\tCombatAction1Event:FireServer(lowDistanceTarget, nil, \"head\", true, \"Right\", nil, 1)\n\tend\n\t\n\twait(.05)\nend","features":"Hold space and hug them","tags":["miketyson"],"discord":"","keyLink":"","owner":{"_id":"6844e077059a9781e00e1ba7","username":"miketyson","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9bd5c1a1c4b6042dc2aaff67a01998da74a5a2ae621b8cbbad4f6e3708d96154.webp","original":"https://scriptblox.com/images/photo/6844e077059a9781e00e1ba7-1757183112902.jpg"},"status":"offline","id":"6844e077059a9781e00e1ba7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/9bd5c1a1c4b6042dc2aaff67a01998da74a5a2ae621b8cbbad4f6e3708d96154.webp","original":"https://scriptblox.com/images/photo/6844e077059a9781e00e1ba7-1757183112902.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:36:23.631Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dc0992b72c45f0fbb1a9c