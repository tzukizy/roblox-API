reatedAt":"2025-04-25T23:37:18.602Z","lastActive":"2026-10-03T21:44:49.086Z","status":"offline","id":"680c1cae6d078cab6b49a711","profile":{"url":"https://media.kocakz.me/7d46df172d0b9424c3a708473bbc984a48214283b8fdc44eccfc50cb7cf21472.webp","original":"https://scriptblox.com/images/photo/680c1cae6d078cab6b49a711-1780723399664.jpg"}},"text":"Actually peak","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-02T00:57:09.599Z","liked":false,"disliked":false},{"_id":"697ffc913b83f723073715f5","commentBy":{"_id":"6670086da7710158a456db0d","username":"iminsane1337","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/6efee8d6b90cf21c1c702cde84e2ffd3e5b9e275b898b092aaff4f3096602c6f.webp","original":"https://scriptblox.com/images/photo/6670086da7710158a456db0d-1749042509785.jpg"},"createdAt":"2024-06-17T09:57:01.244Z","lastActive":"2026-10-06T06:03:10.707Z","status":"offline","id":"6670086da7710158a456db0d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/6efee8d6b90cf21c1c702cde84e2ffd3e5b9e275b898b092aaff4f3096602c6f.webp","original":"https://scriptblox.com/images/photo/6670086da7710158a456db0d-1749042509785.jpg"}},"text":"Library updated btw.\n\nFrom new its: Custom Logs.\n(If you dont want to use default notifications you can use logs, check on github)\n\nUpdate w/some fixes soon. Just wait","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-02T01:23:29.192Z","liked":false,"disliked":false},{"_id":"69a6b41e11afc6c1a54f7aaf","commentBy":{"_id":"6924e40736a9c4c97ecd7a00","username":"dbg100","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/bd327155c4978cb77b8f796fc64ca8fae653d86d1c9dc48be24929e915a5905c.webp","original":"https://scriptblox.com/images/photo/6924e40736a9c4c97ecd7a00-1784553805427.png"},"lastActive":"2026-07-20T15:51:26.229Z","createdAt":"2025-11-24T23:02:31.711Z","status":"offline","id":"6924e40736a9c4c97ecd7a00","profile":{"url":"https://media.kocakz.me/bd327155c4978cb77b8f796fc64ca8fae653d86d1c9dc48be24929e915a5905c.webp","original":"https://scriptblox.com/images/photo/6924e40736a9c4c97ecd7a00-1784553805427.png"}},"text":"Interesting, it supports mobile fine but there's a huge flaw: the drag is terrible on mobile, you drag it every single time even if you don't want to, basically every part of the lib is draggable and it sucks for mobile, it's insufferable having the gui moving like a freaking snake while trying to use anything on mobile version, on PC though it works fine. Instead ONLY make the upper part draggable, so you dont drag it else where you touch/press on mobile","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-03T10:12:46.909Z","liked":false,"disliked":false}]}