844515276.png"},"createdAt":"2024-04-27T16:52:42.678Z","lastActive":"2026-09-09T15:00:20.431Z","status":"offline","id":"662d2d5a73c8c0c4db34b80a","profile":{"url":"https://cdn.kocakz.me/images/7d4ce059b7cfdfa789095ca009cf16b862b131ab1b2ed66dea8ba370e56be8ca.webp","original":"https://scriptblox.com/images/photo/662d2d5a73c8c0c4db34b80a-1773844515276.png"}},"text":"ANYTHING but sigma spy :broken_heart:","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-04T22:33:18.714Z","liked":false,"disliked":false},{"_id":"6a9d2ff7fbd013e170328ecd","commentBy":{"_id":"6a8f2e84b2f47389cb7b5a94","username":"Baseline","verified":true,"role":"admin","profilePicture":{"url":"https://cdn.kocakz.me/images/504bd01904d74cdfe301823c9371d73cd3d91ffd97d49a7e336e023a0623acb0.webp","original":"https://scriptblox.com/images/photo/6a8f2e84b2f47389cb7b5a94-1788349018516.gif"},"lastActive":"2026-10-03T04:37:53.310Z","createdAt":"2026-08-26T18:20:52.181Z","status":"offline","id":"6a8f2e84b2f47389cb7b5a94","profile":{"url":"https://cdn.kocakz.me/images/504bd01904d74cdfe301823c9371d73cd3d91ffd97d49a7e336e023a0623acb0.webp","original":"https://scriptblox.com/images/photo/6a8f2e84b2f47389cb7b5a94-1788349018516.gif"}},"text":"this got re-reviewed. using tostring on arguments can lead to environment escapes (and does in this case). you should also check the type of self since that also leads to an environment escape.\n\nlook into oth.hook since thats a thing now. it's on the volt docs and in multiple execs and avoids many common detection vectors","edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-06T09:18:47.783Z","liked":false,"disliked":false},{"_id":"6a9d30e31545ff3d05125ff3","commentBy":{"_id":"66891015a104c7ad0c16c49c","username":"goodcurry","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/908aa6b0519682633e15e18943751e67ea7fd836a5bf5b9b5feb48a85f0ea6c2.webp","original":"https://scriptblox.com/images/photo/66891015a104c7ad0c16c49c-1788683357034.png"},"createdAt":"2024-07-06T09:36:21.449Z","lastActive":"2026-09-10T06:53:15.604Z","status":"offline","id":"66891015a104c7ad0c16c49c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/908aa6b0519682633e15e18943751e67ea7fd836a5bf5b9b5feb48a85f0ea6c2.webp","original":"https://scriptblox.com/images/photo/66891015a104c7ad0c16c49c-1788683357034.png"}},"text":"@Sprocket haven't updated in a while, but will do what u told me to do thanks","parent":{"_id":"6a9d2ff7fbd013e170328ecd","commentBy":{"_id":"6a8f2e84b2f47389cb7b5a94","username":"Baseline","profilePicture":"/images/photo/6a8f2e84b2f47389cb7b5a94-1788349018516.gif","status":"offline","id":"6a8f2e84b2f47389cb7b5a94"},"text":"this got re-reviewed. using tostring on arguments can lead to environment escapes (and does in this case). you should also check the type of self since that also leads to an environment escape.\n\nlook into oth.hook since thats a thing now. it's on the volt docs and in multiple execs and avoids many common detection vectors"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-06T09:22:43.394Z","liked":false,"disliked":false},{"_id":"6a9d3983559fe65d8f1ae4e0","commentBy":{"_id":"6a8f2e84b2f47389cb7b5a94","username":"Baseline","verified":true,"role":"admin","profilePicture":{"url":"https://cdn.kocakz.me/images/504bd01904d74cdfe301823c9371d73cd3d91ffd97d49a7e336e023a0623acb0.webp","original":"https://scriptblox.com/images/photo/6a8f2e84b2f47389cb7b5a94-1788349018516.gif"},"lastActive":"2026-10-03T04:37:53.310Z","createdAt":"2026-08-26T18:20:52.181Z","status":"offline","id":"6a8f2e84b2f47389cb7b5a94","profile":{"url":"https://cdn.kocakz.me/images/504bd01904d74cdfe301823c9371d73cd3d91ffd97d49a7e336e023a0623acb0.webp","original":"https://scriptblox.com/images/photo/6a8f2e84b2f47389cb7b5a94-1788349018516.gif"}},"text":"@goodcurry I believe the right syntax for it would be like oth.hook(getrawmetatable(game).__namecall, function(...)\ndo stuff\nend)\n\nalso tables can have arbitrary keys, so doing tostring(k) leads to detections and env escapes if the game does something like this\n\nlocal a = setmetatable({}, {__concat = function()print(\"detected\")end, __tostring = function() print(\"detected\") return \"meow\" end})\nlocal tab = {[a] = \"hello\"}","parent":{"_id":"6a9d30e31545ff3d05125ff3","commentBy":{"_id":"66891015a104c7ad0c16c49c","username":"goodcurry","profilePicture":"/images/photo/66891015a104c7ad0c16c49c-1788683357034.png","status":"offline","id":"66891015a104c7ad0c16c49c"},"text":"@Sprocket haven't updated in a while, but will do what u told me to do thanks"},"edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-06T09:59:31.436Z","liked":false,"disliked":false}]}