{"slug":"Universal-Script-SignalSpy-45279","_id":"6879b21fe74ab52faaa9509d","title":"SignalSpy","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"signalspy is a cool clientside logger by me ofc that hooks into metamethods to log remote calls and whatever blah blah\n\nchangelogs -\ndid what the admin guy told me to do\n09/06/2026\n\nthis thing is unstable, so wouldnt be surprised if bugs.","tags":["simplespy","remotespy","signalspy"],"script":"--please give credits if you use in projects -> discord: cool.guy.69\nlocal settings = {\n\tcopytoclipboard = true,\n\tcopyasscript = true,\n\tlogfireserver = true,\n\tloginvokeserver = true,\n\tlogonclientevent = false, --half working\n\tlogonclientinvoke = true,\n\tlogindexing = true,\n}\n\nprint(\"[signalspy] loaded\")\n\nlocal safetostring = function(v)\n\tlocal t = typeof(v)\n\tif t == \"string\" then\n\t\treturn '\"' .. v:gsub('\"', '\\\\\"') .. '\"'\n\telseif t == \"number\" or t == \"boolean\" or t == \"nil\" then\n\t\treturn tostring(v)\n\telseif t == \"Instance\" then\n\t\treturn v:GetFullName()\n\telseif t == \"EnumItem\" then\n\t\treturn tostring(v)\n\telseif t == \"table\" then\n\t\tlocal parts = {}\n\t\tfor k, val in pairs(v) do\n\t\t\tlocal kt = type(k) == \"string\" and '\"' .. k:gsub('\"', '\\\\\"') .. '\"' or tostring(k)\n\t\t\tlocal vt = safetostring(val)\n\t\t\ttable.insert(parts, \"[\" .. kt .. \"]=\" .. vt)\n\t\tend\n\t\treturn \"{\" .. table.concat(parts, \",\") .. \"}\"\n\telseif t == \"vector\" then\n\t\treturn string.format(\"Vector3.new(%g, %g, %g)\", v.X, v.Y, v.Z)\n\telse\n\t\treturn \"[\" .. t .. \"]\"\n\tend\nend\n\nlocal function makescript(remote, method, args)\n\tlocal goodcurry = remote:GetFullName() .. \":\" .. method\n\tif #args == 0 then\n\t\treturn goodcurry .. \"()\"\n\tend\n\tlocal arguwu = {}\n\tfor _, v in ipairs(args) do\n\t\ttable.insert(arguwu, safetostring(v))\n\tend\n\treturn goodcurry .. \"(\" .. table.concat(arguwu, \", \") .. \")\"\nend\n\nlocal function tts(tbl)\n\tlocal str = \"\"\n\tfor i, v in ipairs(tbl) do\n\t\tstr = str .. \"arg[\" .. i .. \"] = \" .. safetostring(v) .. \"\\n\"\n\tend\n\treturn str\nend\n\nlocal function isvalidremote(self)\n\treturn typeof(self) == \"Instance\" and (self:IsA(\"RemoteEvent\") or self:IsA(\"RemoteFunction\"))\nend\n\nlocal function log(where, remote, method, ...)\n\tlocal args = {...}\n\tlocal out = \"[\" .. where .. \"] \" .. remote:GetFullName() .. \":\" .. method .. \"\\n\" .. tts(args)\n\tprint(out)\n\tif settings.copytoclipboard and setclipboard then setclipboard(out) end\n\tif settings.copyasscript and setclipboard then\n\t\tlocal script = makescript(remote, method, args)\n\t\tsetclipboard(script)\n\tend\nend\n\nlocal namecallorg\nnamecallorg = hookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)\n\tif oth and oth.is_hook_thread and oth.is_hook_thread() then\n\t\treturn namecallorg(self, ...)\n\tend\n\tif not isvalidremote(self) then\n\t\treturn namecallorg(self, ...)\n\tend\n\tlocal method = getnamecallmethod()\n\tif method == \"FireServer\" and settings.logfireserver then\n\t\tlog(\"client -> server\", self, method, ...)\n\telseif method == \"InvokeServer\" and settings.loginvokeserver then\n\t\tlog(\"client -> server\", self, method, ...)\n\tend\n\treturn namecallorg(self, ...)\nend))\n\nlocal indexorg\nindexorg = hookmetamethod(game, \"__index\", newcclosure(function(self, key)\n\tif oth and oth.is_hook_thread and oth.is_hook_thread() then\n\t\treturn indexorg(self, key)\n\tend\n\tif not isvalidremote(self) then\n\t\treturn indexorg(self, key)\n\tend\n\tif settings.logindexing and (key == \"FireServer\" or key == \"InvokeServer\") then\n\t\tprint(\"[signalspy] accessed -> \" .. self:GetFullName() .. \".\" .. key)\n\tend\n\tif key == \"OnClientInvoke\" and settings.logonclientinvoke and self:IsA(\"RemoteFunction\") then\n\t\treturn function(...)\n\t\t\tlog(\"server -> client\", self, \"OnClientInvoke\", ...)\n\t\tend\n\tend\n\treturn indexorg(self, key)\nend))\n\nif settings.logonclientevent then\n\tfor _, r in ipairs(game:GetDescendants()) do\n\t\tif r:IsA(\"RemoteEvent\") then\n\t\t\tpcall(function()\n\t\t\t\tr.OnClientEvent:Connect(function(...)\n\t\t\t\t\tlog(\"server -> client\", r, \"OnClientEvent\", ...)\n\t\t\t\tend)\n\t\t\tend)\n\t\tend\n\tend\n\tgame.DescendantAdded:Connect(function(obj)\n\t\tif obj:IsA(\"RemoteEvent\") then\n\t\t\ttask.wait(0.1)\n\t\t\tpcall(function()\n\t\t\t\tobj.OnClientEvent:Connect(function(...)\n\t\t\t\t\tlog(\"server -> client\", obj, \"OnClientEvent\", ...)\n\t\t\t\tend)\n\t\t\tend)\n\t\tend\n\tend)\nend\n--faded was here","owner":{"_id":"66891015a104c7ad0c16c49c","username":"goodcurry","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/908aa6b0519682633e15e18943751e67ea7fd836a5bf5b9b5feb48a85f0ea6c2.webp","original":"https://scriptblox.com/images/photo/66891015a104c7ad0c16c49c-1788683357034.png"},"status":"offline","id":"66891015a104c7ad0c16c49c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/908aa6b0519682633e15e18943751e67ea7fd836a5bf5b9b5feb48a85f0ea6c2.webp","original":"https://scriptblox.com/images/photo/66891015a104c7ad0c16c49c-1788683357034.png"}},"verified":false,"discord":"https://discord.gg/getparadise","views":7229,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/eaffdfca273b5b12db72a176fb69d6d7c3eb5ec13afd4d99f7cc7866f86c81ff.webp","original":"https://scriptblox.com/images/sb/0-1752805919499.png","scriptblox":"https://scriptblox.com/images/script/0-1752805919499.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2025-07-18T02:31:59.668Z","editBy":{"_id":"66891015a104c7ad0c16c49c","username":"goodcurry","status":"offline","id":"6689