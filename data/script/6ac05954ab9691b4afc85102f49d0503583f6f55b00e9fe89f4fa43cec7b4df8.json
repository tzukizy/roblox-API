{"slug":"Universal-Script-Click-to-teleport-38145","_id":"68112b253ddfe7f175aa50fb","title":"Click to teleport","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1745955621215.jpg","placeId":0},"features":"equip the teleport and point at surface to teleport\nworks for most games as i used it alot\nmight not work for other games","tags":["Teleport","speed"],"script":"-[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\nmouse = game.Players.LocalPlayer:GetMouse()\ntool = Instance.new(\"Tool\")\ntool.RequiresHandle = false\ntool.Name = \"Tp tool(Equip to Click TP)\"\ntool.Activated:connect(function()\nlocal pos = mouse.Hit+Vector3.new(0,2.5,0)\npos = CFrame.new(pos.X,pos.Y,pos.Z)\ngame.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = pos\nend)\ntool.Parent = game.Players.LocalPlayer.Backpack","owner":{"_id":"66f052aad98d4ba1f5e690a1","username":"1_hearts4you_1","verified":false,"profilePicture":"/images/photo/66f052aad98d4ba1f5e690a1-1775521966679.jpg","status":"offline","id":"66f052aad98d4ba1f5e690a1","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":2777,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1745955621215.jpg","likeCount":2,"dislikeCount":1,"createdAt":"2025-04-29T19:40:21.252Z","executes":24,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68112b253ddfe7f175aa50fd","editBy":{"_id":"66f052aad98d4ba1f5e690a1","username":"1_hearts4you_1","status":"offline","id":"66f052aad98d4ba1f5e690a1"},"message":"Create script","createdAt":"2025-04-29T19:40:21.253Z"}],"comments":[{"_id":"68115f97219af807bf3dc14b","commentBy":{"_id":"6811572b72b1759084b0c368","username":"talhanas498","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-04-29T22:48:11.459Z","lastActive":"2026-01-20T04:48:08.014Z