{"slug":"Universal-Script-Universal-Hitbox-Expander-9711","_id":"658dea093a91ae7503ec56bb","title":"Universal Hitbox Expander","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/3133770-1703820615479.webp","placeId":0},"features":"Extends every players hitbox by the desired value.\n\n-Not Mine","tags":["Hitbox","Universal"],"script":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\n\n--Player Info\n_G.HeadSize = 50\n_G.Disabled = true\n \n\n--Don't Touch\ngame:GetService('RunService').RenderStepped:connect(function()\nif _G.Disabled then\nfor i,v in next, game:GetService('Players'):GetPlayers() do\nif v.Name ~= game:GetService('Players').LocalPlayer.Name then\npcall(function()\nv.Character.HumanoidRootPart.Size = Vector3.new(_G.HeadSize,_G.HeadSize,_G.HeadSize)\n--TRANSPARENCY of the HITBOX\nv.Character.HumanoidRootPart.Transparency = 0.7\nv.Character.HumanoidRootPart.BrickColor = BrickColor.new(\"Really blue\")\nv.Character.HumanoidRootPart.Material = \"Neon\"\nv.Character.HumanoidRootPart.CanCollide = false\nend)\nend\nend\nend\nend)","owner":{"_id":"6512131a814d5b8adc4acc0c","username":"nefy111","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6512131a814d5b8adc4acc0c","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":67605,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-12-28T21:35:05.111Z","dislikeCount":0,"likeCount":3,"image":"/images/sb/3133770-1703820615479.webp","executes":200,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bf28","editBy":{"_id":"6512131a814d5b8adc4acc0c","username":"nefy111","status":"offline","id":"6512131a814d5b8adc4acc0c"},"message":"Create script","createdAt":"2024-03-11T06:17:12.302Z"},{"_id":"67e5e1e4b360710ec3c50055","editBy":