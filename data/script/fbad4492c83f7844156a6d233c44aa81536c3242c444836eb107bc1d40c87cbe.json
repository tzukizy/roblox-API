{"slug":"Universal-Script-flip-character-script-14488","_id":"6676bc49bebcd025455a899f","title":"flip character script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/1812443-1719057479788.webp","placeId":0},"features":"script flips character","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character\n\nlocal function flipCharacter()\n    if character and character:FindFirstChild(\"HumanoidRootPart\") then\n        local rootPart = character.HumanoidRootPart\n        local currentOrientation = rootPart.Orientation\n        local newOrientation = Vector3.new(currentOrientation.X + 180, currentOrientation.Y, currentOrientation.Z)\n        rootPart.Orientation = newOrientation\n    end\nend\n\nflipCharacter()","owner":{"_id":"6305c918297097657ce6f6c9","username":"trellurr","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"6305c918297097657ce6f6c9","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":7266,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-06-22T11:58:01.071Z","dislikeCount":4,"likeCount":0,"image":"/images/sb/1812443-1719057479788.webp","executes":450,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c511b2","editBy":{"_id":"6305c918297097657ce6f6c9","username":"trellurr","status":"offline","id":"6305c918297097657ce6f6c9"},"message":"Create script","createdAt":"2025-03-27T20:24:39.490Z"}],"comments":[{"_id":"6676c4e318e764795bd200a5","commentBy":{"_id":"66725175fb121925ad233f6b","username":"LanIsMe","verified":false,"role":"user","profilePicture":"/images/photo/66725175fb121925ad233f6b-1720950334161.jpg","createdAt":"2024-06-19T03:33:09.096Z","lastActive":"2024-07-14T15:07:52.072Z","status":"offline","id":"66725175fb121925ad233f6b"},"text":"fe or not?","createdAt":"2024-06-22T