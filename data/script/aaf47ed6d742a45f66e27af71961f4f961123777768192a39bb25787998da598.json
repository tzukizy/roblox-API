{"_id":"68bc6fcfd4a4c6629ba6c6a2","title":"Face Remover","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/ca3c5595672327d49dfe70cf8ad4e5476fa81e892a148bb6b6a2dc4b0cac4771.webp","original":"https://scriptblox.com/images/sb/0-1757179855199.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/ca3c5595672327d49dfe70cf8ad4e5476fa81e892a148bb6b6a2dc4b0cac4771.webp","original":"https://scriptblox.com/images/sb/0-1757179855199.jpg"},"placeId":0},"slug":"Universal-Script-Face-Remover-51765","verified":false,"key":false,"keyless":false,"views":1794,"executes":2582,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4b8981bd7d56842a2fc62b2382041952b1c4f1361d948e040270c7c7a182a589.webp","original":"https://scriptblox.com/images/sb/0-1757179855199.jpg","scriptblox":"https://scriptblox.com/images/script/0-1757179855199.jpg"},"thumbnail":{"url":"https://media.kocakz.me/4b8981bd7d56842a2fc62b2382041952b1c4f1361d948e040270c7c7a182a589.webp","original":"https://scriptblox.com/images/sb/0-1757179855199.jpg","scriptblox":"https://scriptblox.com/images/script/0-1757179855199.jpg"},"likeCount":0,"dislikeCount":2,"createdAt":"2025-09-06T17:30:55.227Z","updatedAt":"2025-09-06T17:30:55.227Z","lastBump":"2025-09-06T17:30:55.227Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function removeFace(character)\n \n    local head = character:FindFirstChild(\"Head\")\n    if head then\n        local face = head:FindFirstChild(\"face\")\n        if face then\n            face:Destroy()\n        end\n    end\nend\n\nlocal function onCharacterAdded(character)\n  \n    removeFace(character)\n\n    character.ChildAdded:Connect(function(child)\n        if child.Name == \"face\" then\n            child:Destroy()\n        end\n    end)\nend\n\nplayer.CharacterAdded:Connect(onCharacterAdded)\n\nif player.Character then\n    removeFace(player.Character)\nend\n\n-- Ignore useless extra info that doesn't have any to do with the script","features":"Please stop commenting on my scripts if it's not compliments about the script.\nHere is me answering some of YOUR questions..\n\n\"is this ai?\" -- In the early days of me scripting I had to use ai since was new but now I don't even need it.\n\n\"What is the point of this?\" -- It is to remove your face... duh.\n\n\"why the * would I need to remove my face?\" -- No one told you to use it and it's just free FE faceless..","tags":[],"discord":"","keyLink":"","owner":{"_id":"68b239398decc0a6778f51ca","username":"TheRealAmethyestYT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/bbb2e9b63989a3646de0d437dca020f5223bfa2a6cb0294cc3405802c7394624.webp","original":"https://scriptblox.com/images/photo/68b239398decc0a6778f51ca-1759102896978.jpg"},"status":"offline","id":"68b239398decc0a6778f51ca","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/bbb2e9b63989a3646de0d437dca020f5223bfa2a6cb0294cc3405802c7394624.webp","original":"https://scriptblox.com/images/photo/68b239398decc0a6778f51ca-1759102896978.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:50:37.491Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68bc6fcfd4a4c6629ba6c6a4","editBy":{"_id":"68b239398decc0a6778f51ca","username":"TheRealAmethyestYT","status":"offline","id":"68b239398decc0a6778f51ca"},"message":"Create script","createdAt":"2025-09-06T17:30:55.231Z"},{"_id":"68bc763e65a90e4c0c3be6cd","editBy":{"_id":"68b239398decc0a6778f51ca","username":"TheRealAmethyestYT","status":"offline","id":"68b239398decc0a6778f51ca"},"message":"Update script","createdAt":"2025-09-06T17:5