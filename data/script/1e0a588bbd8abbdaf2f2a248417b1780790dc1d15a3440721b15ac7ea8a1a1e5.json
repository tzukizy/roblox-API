{"slug":"Universal-Script-Script-Performance-Evaluator-or-SPE-16182","_id":"66a4e6461cef60cbd2d4dff7","title":"Script Performance Evaluator or SPE","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/9163064-1722082886469.png","placeId":0},"features":"Evaluate script performance by tracking how long it takes to execute!\n\nNOTE = {\n  This is a rushed script!\n}","tags":[],"script":"local function measureExecutionTime(codeBlock)\n    local startTime = os.clock()\n    codeBlock()\n    local endTime = os.clock()\n    local elapsedTime = endTime - startTime\n    return elapsedTime\nend\n\nlocal function classifyPerformance(time)\n    if time < 0.1 then\n        return \"Perfect\"\n    elseif time < 0.25 then\n      return \"Excellent\"\n    elseif time < 0.5 then\n        return \"Great\"\n    elseif time < 0.75 then\n        return \"Considerable\"\n    elseif time < 1 then\n        return \"Average\"\n    elseif time < 2 then\n        return \"Poor\"\n    else\n        return \"Bad\"\n    end\nend\n\nlocal time = measureExecutionTime(function()\n    -- // Example code. Replace with your own code\n    local sum = 0\n    for i = 1, 1000000 do\n        sum = sum + i\n    end\n    print(sum)\nend)\nprint(string.format(\"Execution time: %.6f seconds - Performance: %s\", time, classifyPerformance(time)))\n","owner":{"_id":"6678169b794e634f0700eaa2","username":"UnnesscaryInventions","verified":false,"profilePicture":"/images/photo/6678169b794e634f0700eaa2-1719146257838.jpg","status":"offline","id":"6678169b794e634f0700eaa2","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"keyLink":"","views":68830,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-07-27T12:21:26.543Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/9163064-1722082886469.png","executes":694,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_