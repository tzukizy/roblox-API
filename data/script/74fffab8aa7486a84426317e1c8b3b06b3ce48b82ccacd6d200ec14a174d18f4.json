{"slug":"Drive-Cars-Down-A-Hill!-Simple-utofrm-5392","_id":"630e9ca46b518281de0d964f","title":"Simple autofarm","game":{"_id":"67e5e1ffb360710ec3c785a8","gameId":9414511685,"name":"Drive Cars Down A Hill!","imageUrl":"https://tr.rbxcdn.com/248e1d9dacf1da66415769fde1ac4e9d/500/280/Image/Jpeg","placeId":9414511685},"features":"Simple money autofarm script i made in like 2 minutes.\n\n\nit tweens your character to the end and then it teleports you back, ez.","tags":[],"script":"_G.enabled = true --Change to false to stop\nlocal waittime = 1 --Set wait seconds\nlocal Time = 1 --Teleport time\nwhile _G.enabled == true do\n    local CFrameEnd = CFrame.new(-50, -2698, 26633)\n    local tween =  game:GetService(\"TweenService\"):Create(game.Players.LocalPlayer.Character.HumanoidRootPart, TweenInfo.new(Time), {CFrame = CFrameEnd})\n    tween:Play()\n    tween.Completed:Wait()\n\n    local CFrameEnd = CFrame.new(20.3001, 510.167, 184.016)\n    local tween =  game:GetService(\"TweenService\"):Create(game.Players.LocalPlayer.Character.HumanoidRootPart, TweenInfo.new(0), {CFrame = CFrameEnd})\n    tween:Play()\n    tween.Completed:Wait()\n    task.wait(waittime)\nend","owner":{"_id":"62f8230874e75bac068729cc","username":"crazyfuy","verified":false,"profilePicture":"/images/photo/62f8230874e75bac068729cc-1662501934359.png","status":"offline","id":"62f8230874e75bac068729cc","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":19029,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-08-30T23:26:28.375Z","dislikeCount":0,"likeCount":4,"image":"https://tr.rbxcdn.com/248e1d9dacf1da66415769fde1ac4e9d/500/280/Image/Jpeg","executes":1802,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4ed55","editBy":{"_id":"62f8230874e75bac068729cc","username":"crazyfuy","status":"offline","id":"62f8230874e75bac068729cc"},"message":"Create script","createdAt