   if entitiesFolder then\n        for _,e in pairs(entitiesFolder:GetChildren()) do\n            if valid(e) then\n                local d = (e.HumanoidRootPart.Position - pos).Magnitude\n                if d < dist then\n                    best = e\n                    dist = d\n                end\n            end\n        end\n    end\n\n    return best\nend\n\nlocal function hit(t)\n    pcall(function()Remote:InvokeServer(t,attackIndex)end)\n    attackIndex=attackIndex==1 and 2 or 1\nend\n\n\nlocal sg=Instance.new(\"ScreenGui\",game.CoreGui)\nsg.Name=\"killaura\"\nlocal f=Instance.new(\"Frame\")\nf.Size=UDim2.new(0,80,0,80)\nf.Position=UDim2.new(0.85,0,0.7,0)\nf.BackgroundColor3=Color3.fromRGB(40,40,40)\nf.BorderSizePixel=0\nf.Active=true\nf.Draggable=true\nf.Parent=sg\n\nInstance.new(\"UICorner\",f).CornerRadius=UDim.new(0,12)\n\nlocal b=Instance.new(\"TextButton\",f)\nb.Size=UDim2.new(0.8,0,0.8,0)\nb.Position=UDim2.new(0.1,0,0.1,0)\nb.BackgroundColor3=Color3.fromRGB(60,60,60)\nb.BorderSizePixel=0\nb.Font=Enum.Font.GothamBold\nb.Text=\"K\"\nb.TextColor3=Color3.fromRGB(255,255,255)\nb.TextSize=28\n\nInstance.new(\"UICorner\",b).CornerRadius=UDim.new(0,8)\nb.Activated:Connect(function()\n    enabled=not enabled\n    if enabled then\n        conn=RunService.Heartbeat:Connect(function()\n            local t=nearest()if t then hit(t)task.wait(math.random(90,170)/1000)end\n        end)\n    else\n        if conn then conn:Disconnect()conn=nil end\n    end\n    b.BackgroundColor3=enabled and Color3.fromRGB(100,200,100) or Color3.fromRGB(200,60,60)\nend)\n\nlocal conn\nUserInputService.InputBegan:Connect(function(i)\n    if i.KeyCode==Enum.KeyCode.K then\n        enabled=not enabled\n        if enabled then\n            conn=RunService.Heartbeat:Connect(function()\n                local t=nearest()if t then hit(t)task.wait(math.random(90,170)/1000)end\n            end)\n        else\n            if conn then conn:Disconnect()conn=nil end\n        end\n        if b then\n            b.BackgroundColor3=enabled and Color3.fromRGB(100,200,100) or Color3.fromRGB(200,60,60)\n        end\n    end\nend)\n\n\nb.BackgroundColor3=Color3.fromRGB(200,60,60)","owner":{"_id":"6539143249c3c6cf4c381178","username":"7hu4n","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0d53e460fde9eaf38b5bb7db202374328e500507519fdc9edac0e7ab2b3c3c0c.webp","original":"https://scriptblox.com/images/photo/6539143249c3c6cf4c381178-1770377146629.png"},"status":"offline","id":"6539143249c3c6cf4c381178","profile":{"url":"https://cdn.kocakz.me/images/0d53e460fde9eaf38b5bb7db202374328e500507519fdc9edac0e7ab2b3c3c0c.webp","original":"https://scriptblox.com/images/photo/6539143249c3c6cf4c381178-1770377146629.png"}},"verified":false,"views":13522,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/fc4f0b3ace6a096ccf0237a7d1bd58a5575a6918b18694ff65359db519daa0f9.webp","original":"https://scriptblox.com/images/sb/102019850130872-1774661927848.webp","scriptblox":"https://scriptblox.com/images/script/102019850130872-1774661927848.webp"},"likeCount":8,"dislikeCount":1,"createdAt":"2026-02-03T13:54:24.685Z","editBy":{"_id":"6539143249c3c6cf4c381178","username":"7hu4n","status":"offline","id":"6539143249c3c6cf4c381178"},"keyLink":"","executes":14936,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":10818,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:34:20.857Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/fc4f0b3ace6a096ccf0237a7d1bd58a5575a6918b18694ff65359db519daa0f9.webp","original":"https://scriptblox.com/images/sb/102019850130872-1774661927848.webp","scriptblox":"https://scriptblox.com/images/script/102019850130872-1774661927848.webp"},"isHub":false,"supportedGames":[],"changelo