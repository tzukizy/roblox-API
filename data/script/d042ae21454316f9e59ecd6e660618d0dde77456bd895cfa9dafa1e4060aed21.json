{"slug":"Universal-Script-Kamal-Gui-76910","_id":"694829193d48e4c2a844d861","title":"Kamal Gui","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Speed","tags":["Speed"],"script":"-- Oyuncunun karakterinin hızını (WalkSpeed) değiştiren yerel script\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\n-- Ayarlanacak yeni hız değeri\nlocal NEW_SPEED = 70 \n\n-- Oyuncunun karakteri yüklendiğinde hızı ayarlamak için fonksiyon\nlocal function SetSpeed()\n    local Character = LocalPlayer.Character\n    if Character then\n        local Humanoid = Character:FindFirstChildOfClass(\"Humanoid\")\n        if Humanoid then\n            Humanoid.WalkSpeed = NEW_SPEED\n            print(\"Oyuncu hızı başarıyla \" .. NEW_SPEED .. \" olarak ayarlandı.\")\n        else\n            warn(\"Karakterde Humanoid bulunamadı.\")\n        end\n    else\n        warn(\"Karakter yüklenmedi.\")\n    end\nend\n\n-- Karakterin zaten yüklü olup olmadığını kontrol et\nif LocalPlayer.Character then\n    SetSpeed()\nend\n\n-- Oyuncu her öldüğünde ve yeni bir karakter yüklendiğinde hızı tekrar ayarla\nLocalPlayer.CharacterAdded:Connect(SetSpeed)\n","owner":{"_id":"6935fe76d9a0d1f6b39fcba7","username":"SaneSane","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6935fe76d9a0d1f6b39fcba7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":350,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/1e1987539600f445b29e40bae9712168ac8f0f803712d35c7f59d19bc83bcb4b.webp","original":"https://scriptblox.com/