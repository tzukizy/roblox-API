{"slug":"Universal-Script-Player-Grabber-48118","_id":"689780f3b86e875c4cfbe8ae","title":"Player Grabber","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"You Need To Hold A Tool For It To Work\nScript Owner Acount: https://www.roblox.com/users/9043322233\nMy Acount: https://www.roblox.com/users/3796816055/profile","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal Y = 30\n\nlocal function getEquippedTool()\n    local character = player.Character\n    if not character then return nil end\n    for _, item in ipairs(character:GetChildren()) do\n        if item:IsA(\"Tool\") then\n            return item\n        end\n    end\n    return nil\nend\n\nlocal function recreateHumanoid(character, tool)\n    local oldHumanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    if oldHumanoid then\n        wait(0.3)\n        if tool then\n            oldHumanoid:UnequipTools()\n        end\n        wait(0.3)\n        oldHumanoid:Destroy()\n        wait(0.3)\n    end\n\n    local newHumanoid = Instance.new(\"Humanoid\")\n    newHumanoid.Parent = character\n    wait(0.3)\n\n    if tool then\n        newHumanoid:EquipTool(tool)\n        wait(0.3)\n    end\n\n    return newHumanoid\nend\n\nlocal humanoidLoopRunning = false\n\nlocal function onTouched(otherPart)\n    local character = player.Character\n    if not character then return end\n\n    local tool = getEquippedTool()\n    if not tool then return end\n\n    local otherCharacter = otherPart.Parent\n    if otherCharacter and otherCharacter ~= character then\n        local otherHumanoid = otherCharacter:FindFirstChild(\"Humanoid\")\n        if otherHumanoid then\n            wait(0.3)\n            local rootPart = character:FindFirstChild(\"HumanoidRootPart\")\n            local otherRoot = otherCharacter:FindFirstChild(\"HumanoidRootPart\")\n            if rootPart and otherRoot then\n                rootPart.CFrame = otherRoot.CFrame + Vector3.new(0, 3, 0)\n                wait(0.3)\n                rootPart.CFrame = CFrame.new(otherRoot.Position.X, Y, otherRoot.Position.Z)\n                wait(0.3)\n            end\n\n            if not humanoidLoopRunning then\n                humanoidLoopRunning = true\n                spawn(function()\n                    while player.Character == character do\n                        recreateHumanoid(character, tool)\n                        wait(0.3)\n                    end\n                    humanoidLoopRunning = false\n                end)\n            end\n        end\n    end\nend\n\nlocal function setupCharacter(character)\n    for _, part in ipairs(character:GetChildren()) do\n        if part:IsA(\"BasePart\") then\n            part.Touched:Connect(onTouched)\n        end\n    end\nend\n\nif player.Character then\n    setupCharacter(player.Character)\nend\n\nplayer.CharacterAdded:Connect(setupCharacter)","owner":{"_id":"6738ed40312af65aa4a5dfdf","username":"NoobKing","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/8ae4c44d9cfd8040f73b224e83a55d5260ed70140ae6476c378f7bc5c3b0ecc5.webp","original":"https://scriptblox.com/images/photo/6738ed40312af65aa4a5dfdf-1754857997732.png"},"status":"offline","id":"6738ed40312af65aa4a5dfdf","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/8ae4c44d9cfd8040f73b224e83a55d5260ed70140ae6476c378f7bc5c3b0ecc5.webp","original":"https://scriptblox.com/images/photo/6738ed40312af65aa4a5dfdf-1754857997732.png"}},"verified":false,"views":3933,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/2e8b279eb760c4feb31e2e5edbab9306443bb1e3a1bbe2bfc3251ad057f7906a.webp","original":"https://scriptblox.com/images/sb/0-1754759411152.png","scriptblox":"https://scriptblox.com/images/script/0-1754759411152.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-09T17:10:11.183Z","executes":286,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:16:16.554Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/2e8b279eb760c4feb31e2e5edbab9306443bb1e3a1bbe2bfc3251ad057f7906a.webp","original":"https://scriptblox.com/images/sb/0-1754759411152.png","scriptblox":"https://scriptblox.com/images/script/0-1754759411152.png"},"changelog":[{"_id":"689780f3b86e875c4cfbe8b0","editBy":{"_id":"6738ed40312af65aa4a5dfdf","username":"NoobKing","status":"offline","id":"6738ed40312af65aa4a5dfdf"},"message":"Create script","createdAt":"2025-08-09T17:10:11.189Z"}],"comments":[{"_id":"68978220211cb638c7800324","commentBy":{"_id":"681b43930783673cc810ddf2","username":"AriOTR1868","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"createdAt":"2025-05-07T11:27:15.484Z","lastActive":"2026-09-12T22:29:41.482Z","status":"offline","id":"681b43930783673cc810ddf2","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"text":"what the * does ts doe","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-08-09T17:15:12.529Z","liked":false,"disliked":false},{"_id":"6897ad6d03f76f2755b5d549","commentBy":{"_id":"681391060c691f15c0fb0a13","username":"XxGoodChildrenxX","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/86d7ea426ead36287ee933bd46a609ce6fff0e0b1cd0b443aad65462a3486d40.webp","original":"https://scriptblox.com/images/photo/681391060c691f15c0fb0a13-1749396857185.jpg"},"createdAt":"2025-05-01T15:19:34.767Z","lastActive":"2026-05-01T14:45