{"_id":"68c5c189a0dc945b6f514b66","title":"RX UNITY Script Hub","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/0415bc4129e0122caf26d0d8f3d2a97a2be19a756dd6801ea0f2bc7780e56180.webp","original":"https://scriptblox.com/images/sb/0-1757790601025.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/0415bc4129e0122caf26d0d8f3d2a97a2be19a756dd6801ea0f2bc7780e56180.webp","original":"https://scriptblox.com/images/sb/0-1757790601025.jpg"},"placeId":0},"slug":"Universal-Script-RX-UNITY-Script-Hub-53030","verified":false,"key":false,"keyless":false,"views":9194,"executes":411,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/14ba5b3666e351880fa6ed41cae33f28f35a2b51d588e5693d51676e8f53b6ee.webp","original":"https://scriptblox.com/images/sb/0-1757790601025.jpg","scriptblox":"https://scriptblox.com/images/script/0-1757790601025.jpg"},"thumbnail":{"url":"https://media.kocakz.me/14ba5b3666e351880fa6ed41cae33f28f35a2b51d588e5693d51676e8f53b6ee.webp","original":"https://scriptblox.com/images/sb/0-1757790601025.jpg","scriptblox":"https://scriptblox.com/images/script/0-1757790601025.jpg"},"likeCount":0,"dislikeCount":2,"createdAt":"2025-09-13T19:10:01.047Z","updatedAt":"2025-09-13T19:10:01.047Z","lastBump":"2025-09-13T19:10:01.047Z","script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Lortizfrfr/LortizScripts/refs/heads/main/rxUnity.lua\"))()","features":"# What is RX-UNITY?\n————————————\n• RX-UNITY is a script hub designed to display scripts from various sources for in-game use, offering powerful features to enhance your Roblox experience. These features include:\n\nExecutor Page\n• An in-game script executor with a user-friendly UI. Note: This is not a downloadable executor; it runs directly within the game.\n\nGame Info Page\n• Displays detailed server information, including script uptime, user playtime, ping, FPS, server JobID, and server player count.\n\nGame Settings Page\n• Allows customization of your character such as speed, jump power, field of view (FOV), and gravity. Includes features like noclip and ESP (Extra Sensory Perception).\n\nMusic Page\n• A playlist of working audio IDs, featuring a stop button, play button, next button, and a music visualizer for an immersive experience.\n\nUI Settings Page\n• Offers customization options to choose different styles and themes for the RX-UNITY user interface.\n\nChat Logger Page\n• Logs all in-game chat messages, useful for games that restrict or block public chat visibility.\n\nIn-Game Chat Commands\n• Detailed information about available commands is provided in the Info Page.\n\nYou can get the key from our discord server!","tags":["Script Hub","FE","Trolling","Exploits"],"discord":"","keyLink":"https://discord.gg/XZtajDzWXC","owner":{"_id":"68b3e15e1047f74e8fc5284f","username":"LortizFRFR","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3dcf70ff53e645b2c04f19b5225d24e87c7ce5580c373418f945546963578b70.webp","original":"https://scriptblox.com/images/photo/68b3e15e1047f74e8fc5284f-1757789927847.png"},"status":"offline","id":"68b3e15e1047f74e8fc5284f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/3dcf70ff53e645b2c04f19b5225d24e87c7ce5580c373418f945546963578b70.webp","original":"https://scriptblox.com/images/photo/68b3e15e1047f74e8fc5284f-1757789927847.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:42:56.603Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c5c189a0dc945b6f514b68","editBy":{"_id":"68b3e15e1047f74e8fc5284f","username":"LortizFRFR","status":"offline","id":"68b3e15e1047f74e8fc5284f"},"message":"