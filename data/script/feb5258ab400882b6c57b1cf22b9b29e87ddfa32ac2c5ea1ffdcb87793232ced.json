end\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\tTargetsFound = count\n\t\t\telse\n\t\t\t\tTargetsFound = 0\n\t\t\tend\n\t\tend\n\tend\nend)","features":"Instant Revive players. \nmainly use on world boss for easy contribution","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a7e3770a7300d18f8d2bac4","username":"SubVint","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":5,"status":"offline","id":"6a7e3770a7300d18f8d2bac4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-20T06:49:05.706Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:33:16.156Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6aaeb71f83e4d88944d085ac","editBy":{"_id":"6a7e3770a7300d18f8d2bac4","username":"SubVint","status":"offline","id":"6a7e3770a7300d18f8d2bac4"},"message":"Create script","createdAt":"2026-09-19T16:23:59.453Z"}],"comments":[{"_id":"6aafc75e8fea974466ac72a8","commentBy":{"_id":"6aafc70bd3ea1e248c3a157b","username":"Monke865","verified":false,"keylessCreator":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-10-09T15:00:35.428Z","createdAt":"2026-09-20T11:44:11.412Z","status":"offline","id":"6aafc70bd3ea1e248c3a157b","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"What happened to the Automining/Fishing Script you posted? Won't work anymore, any updates?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-20T11:45:34.335Z","liked":false,"disliked":false},{"_id":"6aafc92fc4c6e84325396746","commen