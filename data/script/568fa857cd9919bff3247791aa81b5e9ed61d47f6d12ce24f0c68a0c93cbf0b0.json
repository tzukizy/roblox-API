aw.githubusercontent.com/bloodball/-back-ups-for-libs/main/wall%20v3'))()\n\n-- Create a table to store the item names\nlocal t = {}\n\n-- Collect item names from the LocalPlayer's Data\nfor i, v in pairs(game:GetService(\"Players\").LocalPlayer:WaitForChild(\"Data\"):GetChildren()) do\n    if v:IsA(\"IntValue\") then\n        table.insert(t, v.Name)\n    end\nend\n\n-- Create a GUI window and folder for item spawner\nlocal b = library:CreateWindow(\"Wacky Item Spawner\"):CreateFolder(\"Item Spawner\")\n\n-- Dropdown for selecting items\nb:Dropdown(\"Select Item\", t, true, function(selected)\n    item = selected\nend)\n\n-- Input box for specifying the amount of items\nb:Box(\"Amount Of Items\", \"number\", function(value)\n    items = value\nend)\n\n-- Button to give selected items\nb:Button(\"Give Selected Items\", function()\n    give(item, items)\nend)\n\n-- Destroy the GUI when done\nb:DestroyGui()","features":"if u figure it out let others know be a W mans fr!!","tags":[],"discord":"","keyLink":"","owner":{"_id":"64ce339e33f6466749fac0e3","username":"zopity10","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"64ce339e33f6466749fac0e3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:19:02.218Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4fac2","editBy":{"_id":"64ce339e33f6466749fac0e3","username":"zopity10","status":"offline","id":"64ce339e33f6466749fac0e3"},"message":"Create script","createdAt":"2025-03-27T22:11:35.805Z"}],"comments":[{"_id":"65124978814d5b8adc4d897b","commentBy":{"_id":"61e32b714889e8d9823dd5c5","username":"janrielgonzalez21","ve