{"_id":"62ef91fcebde93fd5ee7553e","title":"UTMM script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-UTMM-script-4704","verified":false,"key":false,"keyless":false,"views":51682,"executes":332,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/4520248-1659867644446.jpg","scriptblox":"https://scriptblox.com/images/script/4520248-1659867644446.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/4520248-1659867644446.jpg","scriptblox":"https://scriptblox.com/images/script/4520248-1659867644446.jpg"},"likeCount":3,"dislikeCount":0,"createdAt":"2022-08-07T10:20:44.469Z","updatedAt":"2022-08-07T10:20:44.469Z","lastBump":"2022-08-07T10:20:44.469Z","script":"-- first script(GodMode)\nlocal gameMetaTable = getrawmetatable(game)\n\nsetreadonly(gameMetaTable, false)\n\nlocal oldMetaTable = gameMetaTable.__namecall\nlocal CallingScript = game:GetService(\"Players\").LocalPlayer.PlayerGui.Handler\n\ngame.Players.LocalPlayer.PlayerGui.ChildAdded:Connect(function(item)\n   if item.ClassName == \"LocalScript\" and item.Name == \"Handler\" then\n       CallingScript = item\n   end\nend)\n\ngameMetaTable.__namecall = newcclosure(function(self, ...)\n   local method = getnamecallmethod()\n   local script = getcallingscript()\n   local args = {...}\n\n   if method == \"FireServer\" and script == CallingScript  then\n       return false\n   end\n   return oldMetaTable(self,...)\nend)\n-- Second script (gives you any weapon that is ingame)\nlocal args = {\n    [1] = game:GetService(\"Lighting\").Weapons:FindFirstChild(\" Weapon name \")\n}\n\ngame:GetService(\"Lighting\").EquipSkin:FireServer(unpack(args))\n\n\n","features":"- Works in any UTMM games\nInstructions: you have to put the weapon name correctly like (\"OwnerBlade\") only works if \nweapons are ingame\n\nHow to see weapon \nlist: set your id into the owner's id. then press console\nthen press manage players. Select anyone. Then press the weapon. then there you go. the weapon list.","tags":[],"discord":"","keyLink":"","owner":{"_id":"62da25030ed8f1594a8ac216","username":"CoolBoyVIP","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62da25030ed8f1594a8ac216","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:24:06.978Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f4f8","editBy":{"_id":"62da25030ed8f1594a8ac216","username":"CoolBoyVIP","status":"offline","id":"62da25030ed8f1594a8ac216"},"message":"Create script","createdAt":"2025-03-27T22:05:31.381Z"}],"comments":[{"_id":"62efa571774d59be4f0ce3cd","commentBy":{"_id":"62bbaaebb668d19462592fcd","username":"BrazyBrxth8695","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-06-29T01:29:15.173Z","lastActive":"2022-09-14T11:06:40.295Z","status":"offline","id":"62bbaaebb668d19462592fcd","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"i dont get this script","createdAt":"2022-08-07T11:43:45.432Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"62efa685797de5f180e57cda","commentBy":{"_id":"62c7c63f5a3943b2e22781e5","username":"thesussieta