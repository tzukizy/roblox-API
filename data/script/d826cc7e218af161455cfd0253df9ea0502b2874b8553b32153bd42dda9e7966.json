dexBehavior.Global\nIcon.Enabled = true\nIcon.IgnoreGuiInset = true\nIcon.DisplayOrder = 999999\n\nIMAGE.Name = \"IMAGE\"\nIMAGE.Parent = Icon\nIMAGE.BackgroundColor3 = Color3.new(1, 1, 1)\nIMAGE.BackgroundTransparency = 1\nIMAGE.BorderColor3 = Color3.new(0, 0, 0)\nIMAGE.BorderSizePixel = 0\nIMAGE.Position = UDim2.new(0.876447856, 0, 0.809069216, 0)\nIMAGE.Size = UDim2.new(0, 130, 0, 130)\nIMAGE.Image = \"rbxassetid://\" .. icon_image\nIMAGE.Visible = true\nIMAGE.ZIndex = 999999\nIMAGE.ImageColor3 = Color3.new(1, 1, 1)\nIMAGE.ImageTransparency = 0\n\n-- rotate it\nwhile true do\n\tIMAGE.Rotation = IMAGE.Rotation + 1\n\tif rotation_speed == 0 then\n\t\ttask.wait()\n\telse\n\t\ttask.wait(rotation_speed)\n\tend\nend","features":"rotating icon.","tags":["script","best","sab","icon","gif"],"discord":"","keyLink":"","owner":{"_id":"698f241ca1ba7bddba8a8c7c","username":"while","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d08766a31b2abf1240cef1003e4b37059a0c9963addd8bcf7dc30afb065f7dcb.webp","original":"https://scriptblox.com/images/photo/698f241ca1ba7bddba8a8c7c-1770989496728.png"},"status":"offline","id":"698f241ca1ba7bddba8a8c7c","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/d08766a31b2abf1240cef1003e4b37059a0c9963addd8bcf7dc30afb065f7dcb.webp","original":"https://scriptblox.com/images/photo/698f241ca1ba7bddba8a8c7c-1770989496728.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:11:56.479Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69987520294333bf10f87aad","editBy":{"_id":"698f241ca1ba7bddba8a8c7c","username":"while","status":"offline","id":"698f241ca1ba7bddba8a8c7c"},"message":"Create script","createdAt":"2026-02-20T14:52:16.164Z"}],"comments":[{"_id":"69ada681ed9548b28377101b","commentBy":{"_id":"699cf30d