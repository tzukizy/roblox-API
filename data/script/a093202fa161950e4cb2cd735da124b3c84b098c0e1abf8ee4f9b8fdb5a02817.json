{"slug":"Dig-Simulator-X-BETA-AUTO-FARM-80238","_id":"6954676465945dfa0030fd1c","title":"AUTO FARM","game":{"_id":"6954676465945dfa0030fd19","gameId":4821469122,"name":"[🌋] Dig Simulator X [BETA]","imageUrl":"https://t7.rbxcdn.com/180DAY-dde6e11e92c0fe4e2179eb39843d0ec4","placeId":4821469122},"features":"AUTO DIG\nAUTO SELL\n*I KNOW this game is a shit, but it's my first script (and is a shit too) but please use ts\"\n(used gemini to create GUI)","tags":["dig","auto","farm","sell","money"],"script":"local ScreenGui = Instance.new(\"ScreenGui\")\nlocal MainFrame = Instance.new(\"Frame\")\nlocal Title = Instance.new(\"TextLabel\")\nlocal AutoDigBtn = Instance.new(\"TextButton\")\nlocal AutoSellBtn = Instance.new(\"TextButton\")\n\nScreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n\nMainFrame.Name = \"MainFrame\"\nMainFrame.Parent = ScreenGui\nMainFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)\nMainFrame.Position = UDim2.new(0.5, -100, 0.5, -75)\nMainFrame.Size = UDim2.new(0, 200, 0, 150)\nMainFrame.Active = true\nMainFrame.Draggable = true -- Permite mover a janela\n\nTitle.Parent = MainFrame\nTitle.Size = UDim2.new(1, 0, 0, 30)\nTitle.Text = \"Painel de Controle\"\nTitle.TextColor3 = Color3.fromRGB(255, 255, 255)\nTitle.BackgroundTransparency = 1\n\nlocal function styleButton(btn, text, pos)\n    btn.Parent = MainFrame\n    btn.Size = UDim2.new(0.8, 0, 0, 40)\n    btn.Position = pos\n    btn.Text = text .. \": OFF\"\n    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\n    btn.TextColor3 = Color3.fromRGB(255, 255, 255)\n    btn.Font = Enum.Font.SourceSansBold\n    btn.TextSize = 18\nend\n\nstyleButton(AutoDigBtn, \"AUTO DIG\", UDim2.new(0.1, 0, 0.3, 0))\nstyleButton(AutoSellBtn, \"AUTO SELL\", UDim2.new(0.1, 0, 0.65, 0))\n\nlocal digActive = false\nlocal sellActive = false\n\nAutoDigBtn.MouseButton1Click:Connect(function()\n    digActive = not digActive\n    if digActive then\n        AutoDigBtn.Text = \"AUTO DIG: ON\"\n        AutoDigBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)\n        \n        task.spawn(function()\n            while digActive do\n                game:GetService(\"ReplicatedStorage\"):WaitForChild(\"DigControl\"):FireServer(\"finish\")\n                task.wait(1)\n            end\n        end)\n    else\n        AutoDigBtn.Text = \"AUTO DIG: OFF\"\n        AutoDigBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\n    end\nend)\n\nAutoSellBtn.MouseButton1Click:Connect(function()\n    sellActive = not sellActive\n    if sellActive then\n        AutoSellBtn.Text = \"AUTO SELL: ON\"\n        AutoSellBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)\n        \n        task.spawn(function()\n            while sellActive do\n                game:GetService(\"ReplicatedStorage\"):WaitForChild(\"SellItem\"):FireServer(\"ALL\")\n                task.wait(1)\n            end\n        end)\n    else\n        AutoSellBtn.Text = \"AUTO SELL: OFF\"\n        AutoSellBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\n    end\nend)\n","owner":{"_id":"6680b0c7eecaeb3e5ddd79d2","username":"alxddr","verified":false,"profilePicture":"/images/photo/6680b0c7eecaeb3e5ddd79d2-1766360383839.jpg","status":"offline","id":"6680b0c7eecaeb3e5ddd79d2","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":844,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"https://t7.rbxcdn.com/180DAY-dde6e11e92c0fe4e2179eb39843d0ec4","likeCount":1,"dislikeCount":4,"createdAt":"2025-12-30T23:59:32.716Z","keyLink":"","executes":5,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6954676465945dfa0030fd1f","editBy":{"_id":"6680b0c7eecaeb3e5ddd79d2","username":"alxddr","status":"offline","id":"6680b0c7eecaeb3e5ddd79d2"},"message":"Create script","createdAt":"2025-12-30T23:59:32.717Z"}],"comments":[{"_id":"69546775bee61148678cf9b0","commentBy":{"_id":"6680b0c7eecaeb3e5ddd79d2","username":"alxddr","verifi