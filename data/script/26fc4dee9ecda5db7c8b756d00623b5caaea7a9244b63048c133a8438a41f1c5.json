{"_id":"6751143a92729e3d21bae6ae","title":"Copy peoples creations SOLARA SUPPORTED","game":{"_id":"67e5e1ffb360710ec3c7888b","gameId":16482659669,"name":"Build & Donate 💸","imageUrl":{"url":"https://media.kocakz.me/36f2923ed9e078f6ed19d53508143dfe718dd94a52c979f3b67bbd91fcecf56d.webp","original":"https://tr.rbxcdn.com/180DAY-12e8a64f00691538ad5adc8a9100db20/150/150/Image/Png/noFilter"},"slug":"16482659669-build-donate","path":"/game/16482659669-build-donate","thumbnail":{"url":"https://media.kocakz.me/36f2923ed9e078f6ed19d53508143dfe718dd94a52c979f3b67bbd91fcecf56d.webp","original":"https://tr.rbxcdn.com/180DAY-12e8a64f00691538ad5adc8a9100db20/150/150/Image/Png/noFilter"},"placeId":16482659669},"slug":"Build-andamp-Donate-CLONE-PEOPLES-S-FREE-ROBUX-23792","verified":false,"key":false,"keyless":false,"views":10148,"executes":14,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter"},"likeCount":4,"dislikeCount":0,"createdAt":"2024-12-05T02:47:22.728Z","updatedAt":"2024-12-05T02:47:22.728Z","lastBump":"2024-12-05T02:47:22.728Z","script":"--Made By: Shag420\n\nlocal PERSONTOCLONE = game.Players[\"PutUsernameHere\"] --Replace with the persons exact username you want to copy [Cap Sensitive]\n\nlocal LocalPlayer = game.Players.LocalPlayer\nlocal MyPlotBoundary\nlocal OriginalPlotBoundary\n\nfor i, v in next, workspace.Plots:GetDescendants() do\n    if v.Name == \"Owner\" and v.Value == LocalPlayer then\n        MyPlotBoundary = v.Parent.PlotBoundary\n        break\n    end\nend\n\nfor i, v in next, workspace.Plots:GetDescendants() do\n    if v.Name == \"Owner\" and v.Value == PERSONTOCLONE then\n        OriginalPlotBoundary = v.Parent.PlotBoundary\n        local blocks = v.Parent.Assets:GetChildren()\n        local blockIndex = 1\n        \n        game:GetService(\"RunService\").Heartbeat:Connect(function()\n            if blockIndex <= #blocks then\n                local c = blocks[blockIndex]\n                blockIndex = blockIndex + 1\n                \n                local SHAG = OriginalPlotBoundary.CFrame:Inverse() * c.CFrame\n                \n                local NEWCLONEDPLACE = MyPlotBoundary.CFrame * SHAG\n                \n                local args = {\n                    [1] = {\n                        [\"CF\"] = NEWCLONEDPLACE,\n                        [\"Material\"] = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"BuildStorage\"):WaitForChild(\"Textures\"):WaitForChild(\"\"..c.Name),\n                        [\"Color\"] = c.Color\n                    }\n                }\n                \n                game:GetService(\"ReplicatedStorage\"):WaitForChild(\"BuildStorage\"):WaitForChild(\"RequestBlockPlace\"):InvokeServer(unpack(args))\n            end\n        end)\n    end\nend","features":"Made By: Shag420\n\nThis script allows you to clone other players builds onto yours just replace with the persons exact username you want to copy in the script","tags":["Build","Donate","Build  Donate","Donation","Clone"],"discord":"","keyLink":"","owner":{"_id":"61f3119e4351a4a73afa7497","username":"Shag420","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0adac1b8030c9ae6b2de87f79b164588085bcda13cb8f6a146efd5bcf6643f9e.webp","original":"https://scriptblox.com/images/photo/61f3119e4351a4a73afa7497-1691206414857.jpg"},"lvl":12,"status":"offline","id":"61f3119e4351a4a73afa7497","topMilestone":{"key":"creator.scripts","tier":10},"pr