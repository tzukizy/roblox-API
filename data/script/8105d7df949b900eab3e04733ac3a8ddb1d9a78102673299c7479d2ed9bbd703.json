{"slug":"tai's-RNG-Aura-giver-14607","_id":"6679c4d4e1255dc2e5b8fe33","title":"Aura giver","game":{"_id":"67e5e1ffb360710ec3c78702","gameId":16714905773,"name":"tai's RNG","imageUrl":"https://tr.rbxcdn.com/be99fd99d0c1e9f304f5f029c11750dc/500/280/Image/Jpeg","placeId":16714905773},"features":"aura giver (you can change the aura line 1)","tags":[],"script":"local auraName = \"Centrifuge\"\n\nlocal aurasFolder = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"Auras\")\nif not aurasFolder then\n    error(\"Auras folder not found in ReplicatedStorage\")\nend\n\nlocal function activateAura(auraName)\n    local aura = aurasFolder:FindFirstChild(auraName)\n    if not aura then\n        error(\"Aura not found: \" .. auraName)\n    end\n\n    local args = {aura}\n    local remoteEvent = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"Remotes\"):FindFirstChild(\"AuraEquip\")\n    if not remoteEvent then\n        error(\"Remote event 'GiveAura' not found\")\n    end\n\n remoteEvent:FireServer(unpack(args))\nend\n\nactivateAura(auraName)\n\nfor _, item in ipairs(aurasFolder:GetChildren()) do\n    if item:IsA(\"Folder\") then\n        print(item.Name)\n    end\nend","owner":{"_id":"625189ca9bd5dd1d4a5e8efc","username":"NeXo","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"625189ca9bd5dd1d4a5e8efc","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":11751,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-24T19:11:16.029Z","dislikeCount":1,"likeCount":2,"image":"https://images.rbxcdn.com/325472601571f31e1bf00674c368d335.gif","executes":7,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c5121b","editBy":{"_id":"625189ca9bd5dd1d4a5e8efc","username":"NeXo","status":"offline","id":"625189ca9bd5dd1d4a5e8efc"},"message":"Create script","createdAt":"2025-03-27T06:14:10.013Z"}],