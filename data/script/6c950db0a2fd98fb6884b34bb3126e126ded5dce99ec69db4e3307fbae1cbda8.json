 pairs(root:GetChildren()) do\n\t\t\tif v.Name == \"Spinning\" then\n\t\t\t\tv:Destroy()\n\t\t\tend\n\t\tend\n\t\tlocal Spin = Instance.new(\"BodyAngularVelocity\")\n\t\tSpin.Name = \"Spinning\"\n\t\tSpin.Parent = root\n\t\tSpin.MaxTorque = Vector3.new(0, math.huge, 0)\n\t\tSpin.AngularVelocity = Vector3.new(0, spinSpeed, 0)\n\telse\n\t\tfor i, v in pairs(root:GetChildren()) do\n\t\t\tif v.Name == \"Spinning\" then\n\t\t\t\tv:Destroy()\n\t\t\tend\n\t\tend\n\tend\nend\n","features":"makes your player spin\n\nhow to use\n\nread script","tags":["script","pro","proohio","spin","best"],"discord":"","keyLink":"","owner":{"_id":"655a2348063f67522da3be29","username":"proohio","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5a3f49edbbe88ed1be66f2b24c0047feaecf9e7959953e38079aa4966e2ea74d.webp","original":"https://scriptblox.com/images/photo/655a2348063f67522da3be29-1741462797884.png"},"status":"offline","id":"655a2348063f67522da3be29","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/5a3f49edbbe88ed1be66f2b24c0047feaecf9e7959953e38079aa4966e2ea74d.webp","original":"https://scriptblox.com/images/photo/655a2348063f67522da3be29-1741462797884.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:11:38.023Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c556db","editBy":{"_id":"655a2348063f67522da3be29","username":"proohio","status":"offline","id":"655a2348063f67522da3be29"},"message":"Create script","createdAt":"2025-03-27T22:20:30.085Z"}],"comments":[]}