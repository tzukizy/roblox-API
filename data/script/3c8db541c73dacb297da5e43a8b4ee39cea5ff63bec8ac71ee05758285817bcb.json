ed = true,\n      FolderName = \"MapsLoverConfigs\",\n      FileName = \"MainGui\"\n   }\n})\n\nlocal MainTab = Window:CreateTab(\"Auto Farm\", 4483362458) -- Icon ID\n\nlocal farming = false\nlocal rep = game:GetService(\"ReplicatedStorage\")\nlocal l = 0\n\nlocal function giveLevel()\n    rep.GiveLevel:FireServer()\nend\n\nMainTab:CreateToggle({\n   Name = \"Auto Level & Money\",\n   CurrentValue = false,\n   Flag = \"FarmToggle\",\n   Callback = function(Value)\n      farming = Value\n      \n      if farming then\n          task.spawn(function()\n              while farming do\n                  -- Your original logic inside the loop\n                  for i = 1, 20 do\n                      if not farming then break end\n                      l = l + 1\n                      task.delay(l, giveLevel)\n                      rep.GiveMoney:FireServer(i * math.random(2, 3))\n                  end\n                  task.wait(1) -- Added a small delay to prevent frame drops\n              end\n          end)\n      end\n   end,\n})\n\nRayfield:LoadConfiguration()\n","features":"Inf Money","tags":["Inf","Money"],"discord":"","keyLink":"","owner":{"_id":"68dc736f7a6a75088192b0c7","username":"MAPSLOVER","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c3ddcd4ce6ad5230de7977637680f2f264fc09b55df3b415f395b40e88252013.webp","original":"https://scriptblox.com/images/photo/68dc736f7a6a75088192b0c7-1780095947307.jpg"},"lvl":10,"status":"offline","id":"68dc736f7a6a75088192b0c7","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/c3ddcd4ce6ad5230de7977637680f2f264fc09b55df3b415f395b40e88252013.webp","original":"https://scriptblox.com/images/photo/68dc736f7a6a75088192b0c7-1780095947307.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:00:29.110Z","last":"","win":14,"