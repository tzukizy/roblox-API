r = game:GetService(\"Workspace\").Coins\n\n-- Loop through each item in the \"Coins\" folder\nfor _, item in pairs(coinsFolder:GetChildren()) do\n    -- Check if the item is a MeshPart and named \"Coins\"\n    if item:IsA(\"MeshPart\") and item.Name == \"Coins\" then\n        -- Teleport the coin to the player's current position\n        item.Position = characterRootPart.Position\n    end\nend\n","features":"autocollects the coin tp the coins to you join my discord server or else\nhttps://discord.gg/MpY7h3WqNh","tags":[],"discord":"","keyLink":"","owner":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","verified":false,"profilePicture":{"url":"https://media.kocakz.me/aa4daef6f4804a6fe8345abbeb3e121228200fe1535229158ec1e64d0f5b4ff8.webp","original":"https://scriptblox.com/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png"},"status":"offline","id":"64caa76229c6e48e1e6517b2","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/aa4daef6f4804a6fe8345abbeb3e121228200fe1535229158ec1e64d0f5b4ff8.webp","original":"https://scriptblox.com/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:35:57.937Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4baa9","editBy":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","status":"offline","id":"64caa76229c6e48e1e6517b2"},"message":"Create script","createdAt":"2023-08-02T19:45:08.120Z"},{"_id":"67e5e1e3b360710ec3c4e8b4","editBy":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","status":"offline","id":"64caa76229c6e48e1e6517b2"},"message":"Update script","createdAt":"2025-03-27T17:16:11.692Z"}],"comments":[]}