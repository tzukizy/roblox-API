es/photo/68e355eed1753ad6fa3bccac-1787752343317.jpg"}},"text":"detects almost nothing ig , only default things like \"anticheat\" or \"detection\"","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-30T05:08:27.460Z","liked":false,"disliked":false},{"_id":"69f45592c11035b04961df2f","commentBy":{"_id":"69d536165b445b98d877cba0","username":"EasyScripter","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-06-18T17:43:01.243Z","createdAt":"2026-04-07T16:51:34.059Z","status":"offline","id":"69d536165b445b98d877cba0","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"@Mysop You're absolutely right. A client-side detector cannot find a server-side anti-cheat. It also won't find an anti-cheat named 'Script4' or one hidden inside another script. This is just a tool for quick *essment — if it finds something, it's definitely there. But if it doesn't find anything, that doesn't mean there's no anti-cheat.","parent":{"_id":"69f2e3cb64b157406ee8d1b6","commentBy":{"_id":"68e355eed1753ad6fa3bccac","username":"mysopw2ww","profilePicture":"/images/photo/68e355eed1753ad6fa3bccac-1787752343317.jpg","status":"offline","id":"68e355eed1753ad6fa3bccac"},"text":"detects almost nothing ig , only default things like \"anticheat\" or \"detection\""},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-01T07:26:10.413Z","liked":false,"disliked":false},{"_id":"69f463ddc011cfa5f2801db2","commentBy":{"_id":"68e355eed1753ad6fa3bccac","username":"mysopw2ww","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/d31c0e7346930c8e6dd546a42fc97c557e68e323ff759636838ee408f761a2c2.webp","original":"https://scriptblox.com/images/photo/68e355eed1753ad6fa3bccac-1787752343317.jpg"},"createdAt":"2025-10-06T05:38:54.212Z","lastActive":"2026-09-19T20:32:11.472Z","status":"offline","id":"68e355eed1753ad6fa3bccac","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/d31c0e7346930c8e6dd546a42fc97c557e68e323ff759636838ee408f761a2c2.webp","original":"https://scriptblox.com/images/photo/68e355eed1753ad6fa3bccac-1787752343317.jpg"}},"text":"@EasyScripter i mean it js looking for some words in the name instead of checking any local scripts/remotes","parent":{"_id":"69f45592c11035b04961df2f","commentBy":{"_id":"69d536165b445b98d877cba0","username":"EasyScripter","profilePicture":"/images/user-default.webp","status":"offline","id":"69d536165b445b98d877cba0"},"text":"@Mysop You're absolutely right. A client-side detector cannot find a server-side anti-cheat. It also won't find an anti-cheat named 'Script4' or one hidden inside another script. This is just a tool for quick *essment — if it finds something, it's definitely there. But if it doesn't find anything, that doesn't mean there's no anti-cheat."},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-01T08:27:09.337Z","liked":false,"disliked":false}]}