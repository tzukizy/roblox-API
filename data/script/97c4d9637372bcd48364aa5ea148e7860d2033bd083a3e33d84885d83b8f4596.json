{"slug":"Universal-Script-any-click-detectors-click-detector-script-21536","_id":"6726379a34a1c9ded8cee31d","title":"any click detectors click detector script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"use this script to log the paths of the click detectors you click so that you can make more scripts with the click detector 👍👍👍👍👍👍👍👍👍👍👍👍👍👍👍👍","tags":["north korea","logger","click detector logger","south korea","fsfsfsfsdfAFsgvSB"],"script":"for i, v in next, game:GetDescendants(), nil do if not v:IsA(\"ClickDetector\") then continue end v:AddTag(\"Clickable\") end\n\nlocal cs = game:GetService(\"CollectionService\")\n\nfor _, detector in next, cs:GetTagged(\"Clickable\"), nil do\n    detector.MouseClick:Connect(function()\n    setclipboard(\"game.\"..detector:GetFullName())\n    print(\"Copied to clipboard!\")\n    end) --should output which player clicked the detector\nend\n\n","owner":{"_id":"63031daa797de5f180372aee","username":"ThatOneNoob","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f3a9b07b2f6772e23a0568d31bbb9f359a7edbaf2e4ffb5a0f4cfc70d9af4619.webp","original":"https://scriptblox.com/images/photo/63031daa797de5f180372aee-1788645202940.jpg"},"status":"offline","id":"63031daa797de5f180372aee","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/f3a9b07b2f6772e23a0568d31bbb9f359a7edbaf2e4ffb5a0f4cfc70d9af4619.webp","original":"https://scriptblox.com/images/photo/63031daa797de5f180372aee-1788645202940.jpg"}},"verified":false,"keyLink":"","views":10050,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-11-02T14:30:50.297Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/fcb890cc8253b2a7e4c6438264d3f00857