{"slug":"Universal-Script-Self-Fling-91180","_id":"6974d519c79db56a30b756cc","title":"Self Fling","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"- Fling yourself (very useful if someone chase you or something...)","tags":["fling","Self Fling"],"script":"-- LocalScript in StarterGui\n\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\n-- Create GUI\nlocal screenGui = Instance.new(\"ScreenGui\", player.PlayerGui)\nlocal button = Instance.new(\"TextButton\", screenGui)\nbutton.Size = UDim2.new(0, 200, 0, 50)\nbutton.Position = UDim2.new(0.5, -100, 0.8, 0)\nbutton.Text = \"Self Fling!\"\n\nbutton.MouseButton1Click:Connect(function()\n    local bv = Instance.new(\"BodyVelocity\")\n    bv.Velocity = Vector3.new(math.random(-200,200), 500, math.random(-200,200))\n    bv.MaxForce = Vector3.new(1e5,1e5,1e5)\n    bv.Parent = hrp\n    game:GetService(\"Debris\"):AddItem(bv, 0.5) -- remove after 0.5s\nend)\n","owner":{"_id":"68c13a2ca756eaef5f446126","username":"My_Own_Script","verified":false,"profilePicture":{"url":"https://media.kocakz.me/801827a665a15959f2f2f2a4eb95cd1c8fd21127741768b6a012bc618fa933cf.webp","original":"https://scriptblox.com/images/photo/68c13a2ca756eaef5f446126-1769298651536.png"},"status":"offline","id":"68c13a2ca756eaef5f446126","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/801827a665a15959f2f2f2a4eb95cd1c8fd21127741768b6a012bc618fa933cf.webp","original":"https://scriptblox.com/images/photo/68c13a2ca756eaef5f446126-1769298651536.png"}},"verified":false,"views":919,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/0