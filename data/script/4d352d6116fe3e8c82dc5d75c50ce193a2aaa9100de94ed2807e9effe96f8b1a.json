ns.BackgroundTransparency = 1\nInstructions.Parent = Frame\n\nlocal TextBox = Instance.new(\"TextBox\")\nTextBox.Size = UDim2.new(0.8, 0, 0.2, 0)\nTextBox.Position = UDim2.new(0.1, 0, 0.4, 0)\nTextBox.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nTextBox.PlaceholderText = \"Enter Key...\"\nTextBox.Text = \"\"\nTextBox.TextSize = 18\nTextBox.TextColor3 = Color3.fromRGB(255, 255, 255)\nTextBox.Parent = Frame\n\nlocal TextBoxCorner = Instance.new(\"UICorner\")\nTextBoxCorner.CornerRadius = UDim.new(0, 5)\nTextBoxCorner.Parent = TextBox\n\nlocal GetKey = Instance.new(\"TextButton\")\nGetKey.Size = UDim2.new(0.35, 0, 0.15, 0)\nGetKey.Position = UDim2.new(0.1, 0, 0.7, 0)\nGetKey.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nGetKey.Text = \"Get Script\"\nGetKey.TextSize = 18\nGetKey.TextColor3 = Color3.fromRGB(150, 150, 150)\nGetKey.Parent = Frame\n\nlocal GetKeyCorner = Instance.new(\"UICorner\")\nGetKeyCorner.CornerRadius = UDim.new(0, 5)\nGetKeyCorner.Parent = GetKey\n\nlocal CheckKey = Instance.new(\"TextButton\")\nCheckKey.Size = UDim2.new(0.35, 0, 0.15, 0)\nCheckKey.Position = UDim2.new(0.55, 0, 0.7, 0)\nCheckKey.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nCheckKey.Text = \"Check Key\"\nCheckKey.TextSize = 18\nCheckKey.TextColor3 = Color3.fromRGB(150, 150, 150)\nCheckKey.Parent = Frame\n\nlocal CheckKeyCorner = Instance.new(\"UICorner\")\nCheckKeyCorner.CornerRadius = UDim.new(0, 5)\nCheckKeyCorner.Parent = CheckKey\n\nGetKey.MouseButton1Click:Connect(function()\n   setclipboard(\"https://gateway.platoboost.com/l/43666/5h9if4eh\")\nend)\n\nlocal function validateKey(key)\n    return key == \"Key\" -- Replace this with your key\nend\n\nCheckKey.MouseButton1Click:Connect(function()\n    local enteredKey = TextBox.Text\n    if validateKey(enteredKey) then\n        TextBox.PlaceholderText = \"Correct Key!\"\n        TextBox.Text = \"\"\n        wait(1)\n        ScreenGui:Destroy()\n\n-- Put Your Script Here\nloadstring(game:HttpGet('https://pastebin.com/raw/YSL3xKYU'))()\n\n    else\n        TextBox.PlaceholderText = \"Invalid key. Try again.\"\n        TextBox.Text = \"\"\n        wait(1)\n        TextBox.PlaceholderText = \"Get Script to be god mode\"\n        TextBox.Text = \"\"\n    end\nend)","owner":{"_id":"66d00ee8443330bde0afc793","username":"Dora","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3386fd156cca45f8949f851bd6db828c99273025b61d9440044472cad83ef6f9.webp","original":"https://scriptblox.com/images/photo/66d00ee8443330bde0afc793-1729382379135.jpg"},"status":"offline","id":"66d00ee8443330bde0afc793","profile":{"url":"https://cdn.kocakz.me/images/3386fd156cca45f8949f851bd6db828c99273025b61d9440044472cad83ef6f9.webp","original":"https://scriptblox.com/images/photo/66d00ee8443330bde0afc793-1729382379135.jpg"}},"verified":false,"keyLink":"https://gateway.platoboost.com/l/43666/5h9if4eh","views":17614,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-09-27T07:20:51.607Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/fa16b4c67ec68c19a9d4e89f4b8b5125c8c771b7f3654c3520a5756ccb6b39e7.webp","original":"https://scriptblox.com/images/sb/3151672-1727421651574.png","scriptblox":"https://scriptblox.com/images/script/3151672-1727421651574.png"},"executes":309,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:15:38.910Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/fa16b4c67ec68c19a9d4e89f4b8b5125c8c771b7f3654c3520a5756ccb6b39e7.webp","original":"https://scriptblox.com/images/sb/3151672-1727421651574.png","scriptblox":"https://scriptblox.com/images/script/3151672-1727421651574.png"},"changelog":[{"_id":"67e5e1e6b360710ec3c523bd","editBy":{"_id":"66d00ee8443330bde0afc793","username":"Dora","status":"offline","id":"66d