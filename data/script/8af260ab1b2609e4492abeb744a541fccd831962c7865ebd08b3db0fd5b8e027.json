Child(\"TextChannels\")\n        local general = channels:WaitForChild(\"RBXGeneral\")\n\n        general:SendAsync(text)\n    end)\n\n    if not ok then\n        warn(\"Failed to send chat message:\", err)\n    end\nend\n\nlocal function isClone(obj)\n    local name = obj.Name:lower()\n\n    return name == \"clone\"\n        or name == \"clonecharacter\"\n        or name:find(\"clone\", 1, true) ~= nil\nend\n\nlocal function removeClone(obj)\n    if not obj or not obj.Parent then\n        return\n    end\n\n    if isClone(obj) then\n        pcall(function()\n            obj:Destroy()\n        end)\n    end\nend\n\nfor _, obj in ipairs(Workspace:GetDescendants()) do\n    removeClone(obj)\nend\n\nWorkspace.DescendantAdded:Connect(function(obj)\n    removeClone(obj)\nend)\n\nsendChatMessage(\"Anti crash loaded credits to me_meymeyme\")","features":"It removes humanoids that arent a player rapidly while also removing Blocks that are collided inside eachother rapidly Client sided","tags":["Tco","tco","The chosen one","the chosen one"],"discord":"","keyLink":"","owner":{"_id":"6aa4113872999b591f6ede5f","username":"Me_mey","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6aa4113872999b591f6ede5f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-24T14:23:56.886Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-24T02:25:44.123Z","last":"w","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ab18b4e48bdc568ffca46cb","editBy":{"_id":"6aa4113872999b591f6ede5f","username":"Me_mey","status":"offline","id":"6aa4113872999b591f6ede5f"},"message":"