en()) do\n   table.insert(players,v.Name)\nend\n\nSection:NewDropdown(\"Select Player\", \" \", players, function(abc)\n    Select = abc\nend)\n\n\nSection:NewButton(\"Refresh\", \" \", function()\n    table.clear(players)\nfor i,v in pairs(game:GetService(\"Players\"):GetChildren()) do\n   table.insert(players,v.Name)\nend\nend)\n\nSection:NewButton(\"Teleport\", \" \", function()\n    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = game.Players[Select].Character.HumanoidRootPart.CFrame\nend)","features":"tp (cannot Teleport to players that are farther than 1.2 million studs away)","tags":[],"discord":"","keyLink":"","owner":{"_id":"671e8d1e15909d3457f57001","username":"oogish","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6c088a94e60ef5b1cb8c73dd70b315b806ad39d9423770263f2765d456079320.webp","original":"https://scriptblox.com/images/photo/671e8d1e15909d3457f57001-1730055590668.png"},"status":"offline","id":"671e8d1e15909d3457f57001","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/6c088a94e60ef5b1cb8c73dd70b315b806ad39d9423770263f2765d456079320.webp","original":"https://scriptblox.com/images/photo/671e8d1e15909d3457f57001-1730055590668.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:05:00.838Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c534ff","editBy":{"_id":"671e8d1e15909d3457f57001","username":"oogish","status":"offline","id":"671e8d1e15909d3457f57001"},"message":"Create script","createdAt":"2025-03-27T22:25:56.561Z"}],"comments":[{"_id":"674f4b7985944215e6df2dc7","commentBy":{"_id":"671e8d1e15909d3457f57001","username":"oogish","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/6c088a94e60ef5b1cb8c73dd70b315b806ad39d9423770263f2765d456079320