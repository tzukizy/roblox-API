{"_id":"682719a6bac1d001f0a32ae0","title":"first ever script for the game","game":{"_id":"67e5e1ffb360710ec3c78e1c","gameId":15987558101,"name":"💎 Rarity Miner [Tycoon] ⛏️ ","imageUrl":{"url":"https://media.kocakz.me/7393d9dc4fd0eed1ef9eb0f66d9abc0a3dabffc70541becab4929d92c56db80b.webp","original":"https://tr.rbxcdn.com/180DAY-de442b0cadf7d8e66743fe4d88a08952/150/150/Image/Png/noFilter"},"slug":"15987558101-rarity-miner","path":"/game/15987558101-rarity-miner","thumbnail":{"url":"https://media.kocakz.me/7393d9dc4fd0eed1ef9eb0f66d9abc0a3dabffc70541becab4929d92c56db80b.webp","original":"https://tr.rbxcdn.com/180DAY-de442b0cadf7d8e66743fe4d88a08952/150/150/Image/Png/noFilter"},"placeId":15987558101},"slug":"Rarity-Miner-NEW-CHEST-first-script-for-the-game-39914","verified":false,"key":false,"keyless":false,"views":4237,"executes":7,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/7ba45ca16f816d4fb27fff32fd25e3b9aabed44f78547a37d86a9ef17c112a05.webp","original":"https://scriptblox.com/images/sb/rbx-afda7d0c211ebb7fe4671c81b47a6caf-6b7f1ea40e06.png","scriptblox":"https://scriptblox.com/images/script/rbx-afda7d0c211ebb7fe4671c81b47a6caf-6b7f1ea40e06.png"},"thumbnail":{"url":"https://media.kocakz.me/7ba45ca16f816d4fb27fff32fd25e3b9aabed44f78547a37d86a9ef17c112a05.webp","original":"https://scriptblox.com/images/sb/rbx-afda7d0c211ebb7fe4671c81b47a6caf-6b7f1ea40e06.png","scriptblox":"https://scriptblox.com/images/script/rbx-afda7d0c211ebb7fe4671c81b47a6caf-6b7f1ea40e06.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-05-16T10:55:34.444Z","updatedAt":"2025-05-16T10:55:34.444Z","lastBump":"2025-05-16T10:55:34.444Z","script":"local localPlayer = game:GetService(\"Players\").LocalPlayer\nlocal cd = 0\nlocal minerate = 0.05\nlocal range = 20\nlocal mineaura = false\nlocal nocd = false\n\nlocal library = loadstring(game:HttpGet(('https://raw.githubusercontent.com/dementiaenjoyer/UI-LIBRARIES/refs/heads/main/wally-modified/source.lua')))()\nlocal window = library:CreateWindow('Credit: Neutral')\nwindow:Section('Blatant')\nwindow:Toggle(\"Mining Aura\",{},function(value)\nmineaura = value\nend)\nwindow:Slider(\"Mining Rate\",{default=0.05,min=0,max=1,precise=true},function(value)\nminerate = value\nend)\nwindow:Slider(\"Aura Range\",{default=20,min=0,max=100,precise=false},function(value)\nrange = value\nend)\nwindow:Section('Legit')\nwindow:Toggle(\"No Cooldown\",{},function(value)\nnocd = value\nend)\n\ngame:GetService(\"RunService\").RenderStepped:Connect(function(delta)\n    cd += delta\n    local character = localPlayer.Character\n    local tool = character:FindFirstChildWhichIsA(\"Tool\")\n    local pickaxe \n    local remote\n\n    if tool and string.find(string.lower(tool.Name),\"pickaxe\") then\n        pickaxe = tool\n        if nocd then\n            pickaxe:SetAttribute(\"DelayTime\",0)\n        end\n        local script = getsenv(pickaxe.Handler)\n        for key,rem in script._G.Client.CachedRemotes do\n            if key == \"0\t\b\u000f\b\u0011-\u0010\u0017\u0011\" then\n                remote = rem\n            end\n        end\n    end\n\n    local blocks = {}\n    for _,v in workspace.Places.World.Cubes:GetDescendants() do\n        if v.ClassName == \"Part\" then\n            if v:GetAttribute(\"CubeName\") then\n                blocks[v.Name] = v.CFrame\n            elseif v.Name == \"Main\" then\n                blocks[v.Parent.Name] = v.CFrame\n            end\n        end\n    end\n    \n    if mineaura and pickaxe and remote and cd > minerate then\n        cd = 0\n        for i,v in blocks do\n            if (character.HumanoidRootPart.CFrame.Position - v.Position).Magnitude < range then\n                game:GetService(\"ReplicatedStorage\").REM[remote]:FireServer({Position = i})\n            end\n        end\n    end\nend)\n\n","features":"executor must support getsenv\nblatant:\nmining aura\nmining aura mine rate\nmining aura range\nlegit:\nno cooldown for mining","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:02:55.307Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"682719a6bac1d001f0a32ae2","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2025-05-16T10:55:34.448Z"}],"comments":[{"_id":"68271ea1e6df31353ea70b48","commentBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"createdAt":"2025-01-06T14:09:57.872Z","lastActive":"2026-03-05T13:24:16.514Z","status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"}},"