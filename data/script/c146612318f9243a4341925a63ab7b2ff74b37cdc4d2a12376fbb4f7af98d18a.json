{"slug":"Universal-Script-Instant-Proximity-Prompt-Forever-109713","_id":"698a9e4b35987d06cf0a45c9","title":"Instant Proximity Prompt Forever","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"A quick and easy script that forces all proximity prompts—both existing ones and any created later—to activate instantly with zero hold time. Once executed, it automatically applies to every new prompt added to the Workspace, so you never need to execute it again or wait through hold durations again. Works across all games; report any issues you run into.","tags":["proximityprompt","proximity","prompt","Universal","pp"],"script":"local workspace = game:GetService(\"Workspace\")\n\nfor _, v in ipairs(workspace:GetDescendants()) do\n    if v:IsA(\"ProximityPrompt\") then\n        v.HoldDuration = 0\n    end\nend\n\nworkspace.DescendantAdded:Connect(function(desc)\n    if desc:IsA(\"ProximityPrompt\") then\n        desc.HoldDuration = 0\n    end\nend)","owner":{"_id":"67a4bdca4f3536cd6921ae12","username":"doomkitty","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/35a9cd27470d06ba41d0b963f16542afe907798a04eb13d7728044cc791e7132.webp","original":"https://scriptblox.com/images/photo/67a4bdca4f3536cd6921ae12-1769651791763.jpeg"},"lvl":7,"status":"offline","id":"67a4bdca4f3536cd6921ae12","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/35a9cd27470d06ba41d0b963f16542afe907798a04eb13d7728044cc791e7132.webp","original":"https://scriptblox.com/images/photo/67a4bdca4f3536cd6921ae12-1769651791763.jpeg"}},"verified":false,"views":1445,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/71e208704f6f17659e776e46a16b19191a852001ed76be859ae