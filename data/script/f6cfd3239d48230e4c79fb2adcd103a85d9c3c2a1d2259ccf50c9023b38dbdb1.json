{"slug":"Universal-Script-anti-Streaming-64195","_id":"690f683541990cc63b4675ba","title":"anti Streaming","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1762617397445.png","placeId":0},"features":"The main purpose of this script is to prevent your client from deleting objects when you move away.\n\nIMPORTANT:\nThis script disables your client's streaming mode, but this doesn't mean the entire map will load when you run it (though it might in rare cases).","tags":[],"script":"if sethiddenproperty then\n\tsethiddenproperty(workspace,\"StreamingMinRadius\", 2090000) -- this is op\nend\nfor i,descendant in ipairs(workspace:GetDescendants()) do\n    if descendant:IsA(\"Model\") then\n        pcall(function()\n            descendant.ModelStreamingMode = Enum.ModelStreamingMode.Persistent\n        end)\n    end\nend\n\nworkspace.DescendantAdded:Connect(function(descendant)\n    if descendant:IsA(\"Model\") then\n        pcall(function()\n            descendant.ModelStreamingMode = Enum.ModelStreamingMode.Persistent\n        end)\n    end\nend)\nprint(\"antiStreaming enabled\")","owner":{"_id":"6342f05f631041248b3d5d28","username":"UnsightedMan","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"6342f05f631041248b3d5d28","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1761,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1762617397445.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-11-08T15:56:37.459Z","executes":262,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"690f683541990cc63b4675bc","editBy":{"_id":"6342f05f631041248b3d5d28","username":"UnsightedMan","status":"offline","id":"6342f05f631041248b3d5d28"},"message":"Create script","createdAt":"2025-11-08T15:56:37.464Z"}],"comments":[{"_id":"69e512c62c648bb0810e95d3","commentBy":{"_id":"6