{"slug":"Steal-a-Baddie-base-grabbing-api-49743","_id":"68a926ab70b7a147d066bc4d","title":"base grabbing api via displayname","game":{"_id":"684731792ebe6c6ee9881093","gameId":70671905624144,"name":"Steal a Baddie","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":70671905624144},"features":"This Script is intended for Developers.\nBase Grab API based on Username\n\nUse Player.DisplayName not Player.Name.\nNameToBase(TargetName) -> Target's Base Model Object","tags":[],"script":"local function NameToBase(TargetName)\n\tlocal Bases = workspace.Map.Bases:GetChildren()\n\tfor i, Base in pairs(Bases) do\n\t\tlocal Interactables = Base.Interactables\n\t\tlocal Sign = Interactables.Sign\n\t\tlocal SignText = Sign:FindFirstChild(\"TextLabel\", true).Text\n\t\tlocal OwnerName = string.match(SignText, \"(.*)'s\")\n\t\tif OwnerName == TargetName then\n\t\t\treturn Base\n\t\tend\n\tend\nend\n-- Example Usage\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal MyBase = NameToBase(LocalPlayer.DisplayName)\nif MyBase then\n\tLocalPlayer.Character.PrimaryPart.CFrame = MyBase.SpawnPart.CFrame\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11023720}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"verified":true,"views":103121,"scriptType":"