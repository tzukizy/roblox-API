e).Text\n\t\tlocal OwnerName = string.match(SignText, \"(.*)'s\")\n\t\tif OwnerName == TargetName then\n\t\t\treturn Base\n\t\tend\n\tend\nend\n-- Example Usage\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal MyBase = NameToBase(LocalPlayer.DisplayName)\nif MyBase then\n\tLocalPlayer.Character.PrimaryPart.CFrame = MyBase.SpawnPart.CFrame\nend","features":"This Script is intended for Developers.\nBase Grab API based on Username\n\nUse Player.DisplayName not Player.Name.\nNameToBase(TargetName) -> Target's Base Model Object","tags":[],"discord":"","keyLink":"","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11048742}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:55:54.214Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68a926ab70b7a147d066bc4f","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-08-23T02:25:47.046Z"},{"_id":"68a9272e10f454d7eec5028f","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Update script","createdAt":"2025-08-23T02