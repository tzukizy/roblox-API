00,000,000,000,000,000\")\n            end\n        end\n    end\nend)\n\n-- Bee Swarm Honey specific\npcall(function()\n    rs.Events.HoneyEvent:FireServer(9e18)\n    rs.Events.TokenEvent:FireServer(9e18)\nend)\n\n-- Mining Simulator coins\npcall(function()\n    rs.Events[\"MiningEvent\"]:FireServer(\"coins\", 9e18)\nend)\n\n-- Auto-loop\nspawn(function()\n    while wait(1) do\n        pcall(ExploitAll)\n    end\nend)\n\nfunction ExploitAll()\n    -- All game descendants\n    for _, v in pairs(game:GetDescendants()) do\n        if v:IsA(\"IntValue\") or v:IsA(\"NumberValue\") then\n            local n = v.Name:lower()\n            if n:find(\"money\") or n:find(\"coin\") or n:find(\"honey\") or n:find(\"gem\") then\n                v.Value = 9e18\n            end\n        end\n    end\nend\n\nprint(\"🤑 Infinite Money Active - Bee Swarm/Mining Sim\")","features":"keyless bee swarm sim","tags":[],"discord":"","keyLink":"","owner":{"_id":"6982fe21fe1749e0183b6a1e","username":"brrrtpatapin","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6982fe21fe1749e0183b6a1e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:29:53.960Z","last":"","win":14,"math":4},"isHub":true,"supportedGames":[{"_id":"67e5e1ffb360710ec3c77d7b","gameId":1537690962,"placeId":1537690962,"name":"Bee Swarm Simulator","imageUrl":{"url":"https://media.kocakz.me/9e0d7cb391bd85ab5a0bb37b440dc5985ec4aa27ed407d7b5d69350db87b302d.webp","original":"https://tr.rbxcdn.com/180DAY-47a5cb3cce196ed1f9ddbc097c415ad1/150/150/Image/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/9e0d7cb391bd85ab5a0bb37b440dc5985ec4aa27ed407d7b5d69350db87b302d.webp","orig