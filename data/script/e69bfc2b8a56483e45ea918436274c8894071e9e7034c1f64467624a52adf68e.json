{"slug":"(LNY)Loomian-Legacy-OpenSource-AUTO-ENCOUNTER-28588","_id":"67a36814cf76a0003ab6835f","title":"OpenSource AUTO ENCOUNTER","game":{"_id":"67e5e1ffb360710ec3c77fe5","gameId":306964494,"name":"Loomian Legacy","imageUrl":"/images/sb/rbx-fa47e7b34ab5bb719fb9fd9a7fd797bb-936c73214a30.png","placeId":306964494},"features":"AUTO ENCOUNTER","tags":["AUTO ENCOUNTER","Loomian Legacy"],"script":"local Main\nfor _,v in pairs(getgc(true)) do\n    if typeof(v) == \"table\" and rawget(v, \"DataManager\") then\n        Main = v\n        break\n    end\nend\n\nif Main.DataManager.currentChunk.regionData.Grass then\n    --[[ You can spam the doWildBattle function by doing this\n        Main.Battle.currentBattle = nil\n    --]]\n\n    Main.Battle.doWildBattle(Main.Battle, Main.DataManager.currentChunk.regionData.Grass, {})\n \n    --[[ You can get information of the loomians in currentBattle\n        for _,v in pairs(Main.Battle.currentBattle) do\n            print(_,v)\n        end\n    ]]\n\n    --[[ End battle\n        Main.Battle.currentBattle.BattleEnded:Fire()\n    ]]\nend","owner":{"_id":"65c4482d6ff06855a51b5613","username":"Devzinh","verified":false,"profilePicture":"/images/photo/65c4482d6ff06855a51b5613-1731885777554.png","status":"offline","id":"65c4482d6ff06855a51b5613","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":4019,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-05T13:31:00.936Z","dislikeCount":1,"likeCount":2,"image":"https://tr.rbxcdn.com/180DAY-f83e05ac474941de11d2c6c544886c25/500/280/Image/Jpeg/noFilter","executes":115,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54a10","editBy":{"_id":"65c4482d6ff06855a51b5613","username":"Devzinh","status":"offline","id":"65c4482d6ff06855a51b5613"},"message":"Create script","createdAt":"2025-03-25T19:22:23.903Z"}],"comments":[{"_id":"6a21370b6895ea6b9