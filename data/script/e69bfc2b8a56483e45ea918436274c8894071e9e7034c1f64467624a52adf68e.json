{"slug":"(LNY)Loomian-Legacy-OpenSource-AUTO-ENCOUNTER-28588","_id":"67a36814cf76a0003ab6835f","title":"OpenSource AUTO ENCOUNTER","game":{"_id":"67e5e1ffb360710ec3c77fe5","gameId":306964494,"name":"Loomian Legacy","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":306964494},"features":"AUTO ENCOUNTER","tags":["AUTO ENCOUNTER","Loomian Legacy"],"script":"local Main\nfor _,v in pairs(getgc(true)) do\n    if typeof(v) == \"table\" and rawget(v, \"DataManager\") then\n        Main = v\n        break\n    end\nend\n\nif Main.DataManager.currentChunk.regionData.Grass then\n    --[[ You can spam the doWildBattle function by doing this\n        Main.Battle.currentBattle = nil\n    --]]\n\n    Main.Battle.doWildBattle(Main.Battle, Main.DataManager.currentChunk.regionData.Grass, {})\n \n    --[[ You can get information of the loomians in currentBattle\n        for _,v in pairs(Main.Battle.currentBattle) do\n            print(_,v)\n        end\n    ]]\n\n    --[[ End battle\n        Main.Battle.currentBattle.BattleEnded:Fire()\n    ]]\nend","owner":{"_id":"65c4482d6ff06855a51b5613","username":"Devzinh","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/5d82a809601b5a53556db23e8c001d9ffc88e181e4ddcfbea0aeef76f2334710.webp","original":"https://scriptblox.com/images/photo/65c4482d6ff06855a51b5613-1731885777554.png"},"status":"offline","id":"65c4482d6ff06855a51b5613","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/5d82a809601b5a53556db23e8c001d9ffc88e181e4ddcfbea0aeef76f2334710.webp","original":"https://scriptblox.com/images/photo/65c4482d6ff06855a51b5613-1731885777554.png"}},"verified":false,"keyLink":"","views":4026,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-05T13:31:00.936Z","dislikeCount":1,"likeCount":2,"image":{"url":"https://cdn.k