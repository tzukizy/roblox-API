    player.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition)\n    end\nend\n\nmouse.KeyDown:Connect(function(key)\n    if key:lower() == \"f\" then\n        teleportToMouse()\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input, gameProcessedEvent)\n    if input.KeyCode == Enum.KeyCode.Insert then\n        toggleTeleport()\n    end\nend)","features":"press insert to enable the code and press it again to disable it and then press f to teleport anywhere to your mouse position (prints out if its enabled or disabled when you press insert)","tags":[],"discord":"","keyLink":"","owner":{"_id":"668fef2a2fcba1edcecde499","username":"heckerYAEAWTYAY","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"668fef2a2fcba1edcecde499","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:55:51.077Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c531c0","editBy":{"_id":"668fef2a2fcba1edcecde499","username":"heckerYAEAWTYAY","status":"offline","id":"668fef2a2fcba1edcecde499"},"message":"Create script","createdAt":"2025-03-27T22:25:57.396Z"}],"comments":[{"_id":"673f5d3fadb9067513629b30","commentBy":{"_id":"668fef2a2fcba1edcecde499","username":"heckerYAEAWTYAY","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-07-11T14:41:46.378Z","lastActive":"2026-07-13T09:58:07.134Z","status":"offline","id":"668fef2a2fcba1edcecde499","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":