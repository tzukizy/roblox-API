{"slug":"Universal-Script-simple-tp-script-22777","_id":"673f5d257fe67725124ce493","title":"simple tp script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"press insert to enable the code and press it again to disable it and then press f to teleport anywhere to your mouse position (prints out if its enabled or disabled when you press insert)","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal mouse = player:GetMouse()\nlocal teleportEnabled = false\n\nlocal function toggleTeleport()\n    teleportEnabled = not teleportEnabled\n    if teleportEnabled then\n        print(\"Teleportation enabled\")\n    else\n        print(\"Teleportation disabled\")\n    end\nend\n\nlocal function teleportToMouse()\n    if teleportEnabled and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n        local targetPosition = mouse.Hit.Position\n        player.Character.HumanoidRootPart.CFrame = CFrame.new(targetPosition)\n    end\nend\n\nmouse.KeyDown:Connect(function(key)\n    if key:lower() == \"f\" then\n        teleportToMouse()\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input, gameProcessedEvent)\n    if input.KeyCode == Enum.KeyCode.Insert then\n        toggleTeleport()\n    end\nend)","owner":{"_id":"668fef2a2fcba1edcecde499","username":"heckerYAEAWTYAY","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"668fef2a2fcba1edcecde499","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":8046,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-11