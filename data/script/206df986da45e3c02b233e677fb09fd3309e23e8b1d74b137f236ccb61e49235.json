{"slug":"Universal-Script-VC-Optimizer-76988","_id":"6948730b9f586c34151f5225","title":"VC Optimizer","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"This script removes all game sounds and eliminates lag, allowing you to use the VC without it freezing. You can use it if you're going to add music using the VC to avoid interruptions.","tags":["VC","Lag Killer","Mute","Voice Chat","Universal"],"script":"-- Script to mute sounds and improve audio performance \nlocal sounds = game:GetDescendants()\n\nfor _, object in pairs(sounds) do\n    if object:IsA(\"Sound\") then\n        object.Volume = 0\n        object:Stop()\n    end\nend\n\n-- Listen for new sounds that appear and silence them. \ngame.DescendantAdded:Connect(function(object)\n    if object:IsA(\"Sound\") then\n        object.Volume = 0\n        object:Stop()\n    end\nend)\n","owner":{"_id":"68d587c8a265b9e6aa2304ff","username":"Omar0x0x0","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0648c3177dd05e310d1ea89e37b2c45064b7a68fa55da2bbc7ea242eeb58bc20.webp","original":"https://scriptblox.com/images/photo/68d587c8a265b9e6aa2304ff-1762230072957.jpg"},"status":"offline","id":"68d587c8a265b9e6aa2304ff","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/0648c3177dd05e310d1ea89e37b2c45064b7a68fa55da2bbc7ea242eeb58bc20.webp","original":"https://scriptblox.com/images/photo/68d587c8a265b9e6aa2304ff-1762230072957.jpg"}},"verified":false,"views":2642,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/4f6ffa406ebb7997b7bf75d4aa5c8a1a77ee61176fba853c38b6f9d580c55869.webp","original":"https://scriptblox.com/images/sb/0-1766355723752.png","scriptblox":"https://scriptb