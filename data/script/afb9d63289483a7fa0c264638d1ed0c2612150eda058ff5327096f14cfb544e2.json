id.DisplayName = \"Bye world\" -- Changes display name to \"Bye world\"\n        local head = character:FindFirstChild(\"Head\")\n        if head then\n            local billboardGui = Instance.new(\"BillboardGui\")\n            local textLabel = Instance.new(\"TextLabel\")\n\n            billboardGui.Size = UDim2.new(5, 0, 2, 0)\n            billboardGui.StudsOffset = Vector3.new(0, 3, 0)\n            billboardGui.Adornee = head\n            billboardGui.Parent = head\n\n            textLabel.Size = UDim2.new(1, 0, 1, 0)\n            textLabel.Text = \"Bye world\"\n            textLabel.BackgroundTransparency = 1\n            textLabel.TextScaled = true\n            textLabel.Parent = billboardGui\n        end\n    end\nend\n\n-- Connect the respawn event\nplayer.CharacterAdded:Connect(onCharacterAdded)\n\n-- Kill the character after 2 seconds\ntask.wait(2)\nkillCharacter()\n","features":"If it does not work then womp womp","tags":[],"discord":"","keyLink":"","owner":{"_id":"66e2bb85c213bb7678b0c39d","username":"Jakkychan00","verified":false,"profilePicture":{"url":"https://media.kocakz.me/413e50f111eb1e22cc1f24267c294379953a03166c64a51ec9d128541ba63d49.webp","original":"https://scriptblox.com/images/photo/66e2bb85c213bb7678b0c39d-1738368817468.jpg"},"status":"offline","id":"66e2bb85c213bb7678b0c39d","profile":{"url":"https://media.kocakz.me/413e50f111eb1e22cc1f24267c294379953a03166c64a51ec9d128541ba63d49.webp","original":"https://scriptblox.com/images/photo/66e2bb85c213bb7678b0c39d-1738368817468.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:53:43.821Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54857","editBy":{"_id":"66e2bb85c213bb7678b0c39d","username":"Jakkychan00","status":"offline","id":"66e2bb85c213bb7678b0c39d"},"message":"Create script","