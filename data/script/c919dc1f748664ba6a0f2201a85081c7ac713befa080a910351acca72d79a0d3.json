{"_id":"6a4a7da8c7cb7ac4bae6d39f","title":"Oii","game":{"_id":"6959526c0597a5542a8de666","gameId":0,"name":"Script hub","imageUrl":{"url":"https://media.kocakz.me/f25d1ef5caf135c266b3bd46b27419babfb45d41a984557af83eb26015a00368.webp","original":"https://scriptblox.com/images/sb/0-1783266728345.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/f25d1ef5caf135c266b3bd46b27419babfb45d41a984557af83eb26015a00368.webp","original":"https://scriptblox.com/images/sb/0-1783266728345.jpg"},"placeId":0},"slug":"Universal-Script-Oii-241387","verified":false,"key":false,"keyless":false,"views":142,"executes":148,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/0a1dbcc95a1852ca0e5890ce7c1930e1c7f033a767935705fcbeaa4c1f475f60.webp","original":"https://scriptblox.com/images/sb/0-1783266728345.jpg","scriptblox":"https://scriptblox.com/images/script/0-1783266728345.jpg"},"thumbnail":{"url":"https://media.kocakz.me/0a1dbcc95a1852ca0e5890ce7c1930e1c7f033a767935705fcbeaa4c1f475f60.webp","original":"https://scriptblox.com/images/sb/0-1783266728345.jpg","scriptblox":"https://scriptblox.com/images/script/0-1783266728345.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-07-05T15:52:08.372Z","updatedAt":"2026-07-05T15:52:08.372Z","lastBump":"2026-07-05T15:52:08.372Z","script":"-- 1. Desbloquear 240 FPS\nif setfpscap then\n    setfpscap(240)\nend\n\n-- 2. Remover efeitos e texturas inúteis (Melhora o desempenho)\nlocal terrain = workspace:FindFirstChildOfClass(\"Terrain\")\nif terrain then\n    terrain.WaterWaveSize = 0\n    terrain.WaterWaveSpeed = 0\n    terrain.WaterReflectance = 0\n    terrain.WaterDetail = Enum.WaterDetail.Low\nend\n\ngame:GetService(\"Lighting\").GlobalShadows = false\n\n-- Remove o desfoque de movimento da tela\nlocal blur = game:GetService(\"Lighting\"):FindFirstChildOfClass(\"BlurEffect\")\nif blur then blur:Destroy() end\n\n-- Remove texturas pesadas do cenário para dar mais velocidade\nfor _, v in pairs(game:GetDescendants()) do\n    if v:IsA(\"Part\") or v:IsA(\"CornerWedgePart\") or v:IsA(\"TrussPart\") then\n        v.Material = Enum.Material.SmoothPlastic\n        v.Reflectance = 0\n    elseif v:IsA(\"Decal\") or v:IsA(\"Texture\") then\n        v:Destroy()\n    elseif v:IsA(\"ParticleEmitter\") or v:IsA(\"Trail\") then\n        v.Enabled = false\n    end\nend\n","features":"Sla","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a3aae6b01df8f199767030c","username":"Heitorlucas487yyy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a3aae6b01df8f199767030c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:36:35.345Z","last":"","win":14,"math":3},"isHub":true,"supportedGames":[{"_id":"692cce798e77b801d62ad020","gameId":123974602339071,"placeId":123974602339071,"name":"[UP] Just a baseplate.","imageUrl":{"url":"https://media.kocakz.me/a5956579a57eb73394583fda4a4d217b8cd99b9685a144bf5afbd6d71dc2e1bd.webp","original":"https://tr.rbxcdn.com/180DAY-d1ca2507a475745843b3384d0770e5a1/150/150/Image/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/a5956579a57eb73394583fda4a4d217b8cd99b9685a144bf5afbd6d71dc2e1bd.webp","original":"https://tr.rbxcdn.com/180DAY-d1ca2507a475745843b3384d0770e5a1/150/150/Image/Png/noFilter"}}],"changelog":[{"_id":"6a4a7da8c7cb7ac4bae6d3a2","editBy":{"_id":"6a3aae6b01df8f199767030c","username":"Heitorlucas487yyy","status":"offline","id":"6a3aae6b01df8f199767030c"},"message":"Create script","createdAt":"2026-07-05T15:52:08.376Z"}],"comments":[]}