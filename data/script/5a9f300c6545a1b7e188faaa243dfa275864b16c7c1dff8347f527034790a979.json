{"slug":"Energy-Assault-FPS-energy-*ault-silent-aim-Open-Source-204694","_id":"69e8a5532e3701ce8c5d270e","title":"energy asault silent aim Open Source","game":{"_id":"67e5e1ffb360710ec3c782ba","gameId":6172932937,"name":"Energy Assault FPS","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":6172932937},"features":"silent aim for energy assault open source","tags":[],"script":"local function GetClosest()\n    local closestdist = math.huge\n    local closesttarget = nil\n    local player = game.Players.LocalPlayer\n    local character = player.Character\n    local rootPart = character and character:FindFirstChild(\"HumanoidRootPart\")\n    \n    if not rootPart then return nil end\n    \n    for _, otherPlayer in pairs(game.Players:GetPlayers()) do\n        if otherPlayer ~= player then\n            local otherChar = otherPlayer.Character\n            if otherChar and otherChar:FindFirstChild(\"HumanoidRootPart\") then\n                local otherRoot = otherChar.HumanoidRootPart\n                local distance = (otherRoot.Position - rootPart.Position).Magnitude\n                \n                if distance < closestdist then\n                    closestdist = distance\n                    closesttarget = otherChar\n                end\n            end\n        end\n    end\n    \n    return closesttarget\nend\n\nlocal function hook()\n    local Hooked = false;\n    repeat\n        (function()\n            local Reference;\n            for _, Function in getgc() do\n                if typeof(Function) == \"function\" and debug.info(Function, \"n\") == \"randomunitvector\" then\n                    Reference = Function\n                end\n            end;\n            if Reference then\n                local RandomUnitVector;\n                RandomUnitVector = hookfunction(Reference, function(Spread, Direction)\n                    local Target = GetClosest()\n                    if Target then\n                        local Head = Target:FindFirstChild(\"Head\")\n                        if Head then\n                            local Camera = workspace.CurrentCamera;\n                            return (Head.Position - Camera.CFrame.Position).Unit * 10000\n                        end\n                    end;\n                    return RandomUnitVector(Spread, Direction)\n                end)\n                Hooked = true\n            end\n        end)()\n        if not Hooked then\n            task.wait(1)\n        end\n    until Hooked\nend\n\ngame.Players.LocalPlayer.CharacterAdded:Connect(function(character) -- this check is necessary because the \"gunS\" script only appears when youre alive but i dont think it works\n    task.wait(0.5)\n    hook()\nend)\n\nif game.Players.LocalPlayer.Character then\n    hook()\nend","owner":{"_id":"6807e4f2219af807bfb80fbf","username":"makerpasta","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b7242b62d7fc68832641740275a06ba44358bf4c6a7ecfd51e30bb2d6206c7d4.webp","original":"https://scriptblox.com/images/photo/6807e4f2219af807bfb80fbf-1770222588167.jpg"},"status":"offline","id":"6807e4f2219af807bfb80fbf","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/b7242b62d7fc68832641740275a06ba44358bf4c6a7ecfd51e30bb2d6206c7d4.webp","original":"https://scriptblox.com/images/photo/6807e4f2219af807bfb80fbf-1770222588167.jpg"}},"verified":false,"views":1629,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/f7fe19bbc7348b6877c0c35a33397275f3bed275e4f9fc4a94b24e460cff8a83.webp","original":"https://scriptblox.com/images/sb/rbx-fd2f549195f7784862f1905dc53af2fe-e0d0af1e2885.png","scriptblox":"https://scriptblox.com/images/script/rbx-fd2f549195f7784862f1905dc53af2fe-e0d0af1e2885.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-04-22