xel = 0\nframe.Active = true\nframe.Draggable = true\nframe.Parent = gui\n\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = UDim.new(0, 14)\ncorner.Parent = frame\n\nlocal stroke = Instance.new(\"UIStroke\")\nstroke.Color = Color3.fromRGB(255, 40, 160)\nstroke.Thickness = 2\nstroke.Parent = frame\n\nlocal title = Instance.new(\"TextLabel\")\ntitle.Size = UDim2.new(1, 0, 0, 48)\ntitle.BackgroundColor3 = Color3.fromRGB(255, 30, 145)\ntitle.Text = \"🐷 PEPPA PIG gui\"\ntitle.TextColor3 = Color3.new(1, 1, 1)\ntitle.TextSize = 21\ntitle.Font = Enum.Font.GothamBold\ntitle.Parent = frame\n\nlocal function makeButton(text, y)\n    local button = Instance.new(\"TextButton\")\n    button.Size = UDim2.new(1, -30, 0, 42)\n    button.Position = UDim2.new(0, 15, 0, y)\n    button.BackgroundColor3 = Color3.fromRGB(35, 25, 38)\n    button.TextColor3 = Color3.fromRGB(255, 90, 190)\n    button.Text = text\n    button.TextSize = 16\n    button.Font = Enum.Font.GothamBold\n    button.Parent = frame\n\n    local c = Instance.new(\"UICorner\")\n    c.CornerRadius = UDim.new(0, 9)\n    c.Parent = button\n\n    return button\nend\n\nlocal speedButton = makeButton(\"SPEED: OFF\", 62)\nlocal jumpButton = makeButton(\"JUMP: OFF\", 112)\nlocal hideButton = makeButton(\"HIDE GUI [F1]\", 162)\n\nlocal speedOn = false\nlocal jumpOn = false\n\nlocal function getHumanoid()\n    local character = player.Character\n    return character and character:FindFirstChildOfClass(\"Humanoid\")\nend\n\nlocal function updateCharacter()\n    local humanoid = getHumanoid()\n    if not humanoid then return end\n\n    humanoid.WalkSpeed = speedOn and 32 or 16\n    humanoid.UseJumpPower = true\n    humanoid.JumpPower = jumpOn and 100 or 50\nend\n\nspeedButton.MouseButton1Click:Connect(function()\n    speedOn = not speedOn\n    speedButton.Text = speedOn and \"SPEED: ON\" or \"SPEED: OFF\"\n    updateCharacter()\nend)\n\njumpButton.MouseButton1Click:Connect(function()\n    jumpOn = not jumpOn\n    jumpButton.Text = jumpOn and \"JUMP: ON\" or \"JUMP: OFF\"\n    updateCharacter()\nend)\n\nhideButton.MouseButton1Click:Connect(function()\n    frame.Visible = false\nend)\n\nUIS.InputBegan:Connect(function(input, processed)\n    if processed then return end\n\n    if input.KeyCode == Enum.KeyCode.F1 then\n        frame.Visible = not frame.Visible\n    end\nend)\n\nplayer.CharacterAdded:Connect(function()\n    task.wait(1)\n    updateCharacter()\nend)\n\nprint(\"PEPPA PIG RC7 GUI DEMO XD loaded!\")\n```","features":"l am pig","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a9c179bcd41befa69f821cf","username":"ratasoitoSUPERALL","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1632302fa50c448c529999c3f60d8fdb8d828ac9a64725b26757de3c416b49e3.webp","original":"https://scriptblox.com/images/photo/6a9c179bcd41befa69f821cf-1791737418114.jpg"},"lvl":6,"status":"offline","id":"6a9c179bcd41befa69f821cf","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/1632302fa50c448c529999c3f60d8fdb8d828ac9a64725b26757de3c416b49e3.webp","original":"https://scriptblox.com/images/photo/6a9c179bcd41befa69f821cf-1791737418114.jpg"}},"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-18T11:52:02.706Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"cstatus":{"verdict":"mixed","pct":67,"conf":0.3,"n":{"w":2,"b":1,"p":1,"d":0,"k":0},"total":3,"detected":false,"key":false,"recent":3,"at":"2026-10-19T15:01:55.957Z","last":"bww","win":14,"math":3,"why":{"pa":1}},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ad481ebab979ac3282724d2","editBy":{"_id":"6a9c179bcd41befa69f821cf","username":"ratasoitoSUPERALL","status":"offline","id":"6a9c179bcd41befa69f821cf"},"message":"Create script","createdAt":"2026-10-18T08:23:07.034Z"}],"comments":[{"_id":"6ad5450c96793f4100c538b1","commentBy":{"_id":"69c94f3efe4924b7c07b4b47","username":"CYGRUS","verified":false,"role":"user","p