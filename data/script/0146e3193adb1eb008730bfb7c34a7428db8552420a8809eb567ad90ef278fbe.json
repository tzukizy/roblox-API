{"_id":"68fa1fef2dcfdc5e7fddbb34","title":"silent aim","game":{"_id":"67e5e1ffb360710ec3c77f9d","gameId":14202073004,"name":"Unnamed Shooter","imageUrl":{"url":"https://media.kocakz.me/31247a73468557428b8e51f0e13fe7c29dd3910afcccf1cfdb9e38fe65e23d4d.webp","original":"https://tr.rbxcdn.com/180DAY-6a108089805c742b21839dc091523729/150/150/Image/Png/noFilter"},"slug":"14202073004-unnamed-shooter","path":"/game/14202073004-unnamed-shooter","thumbnail":{"url":"https://media.kocakz.me/31247a73468557428b8e51f0e13fe7c29dd3910afcccf1cfdb9e38fe65e23d4d.webp","original":"https://tr.rbxcdn.com/180DAY-6a108089805c742b21839dc091523729/150/150/Image/Png/noFilter"},"placeId":14202073004},"slug":"Unnamed-Shooter-silent-aim-60263","verified":false,"key":false,"keyless":false,"views":124849,"executes":958,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/de4a2f75cedf09c9d0de0b2afa276bbbe42af98574cbb417dbd15d99e044981a.webp","original":"https://scriptblox.com/images/sb/14202073004-1761222639649.jpg","scriptblox":"https://scriptblox.com/images/script/14202073004-1761222639649.jpg"},"thumbnail":{"url":"https://media.kocakz.me/de4a2f75cedf09c9d0de0b2afa276bbbe42af98574cbb417dbd15d99e044981a.webp","original":"https://scriptblox.com/images/sb/14202073004-1761222639649.jpg","scriptblox":"https://scriptblox.com/images/script/14202073004-1761222639649.jpg"},"likeCount":9,"dislikeCount":1,"createdAt":"2025-10-23T12:30:39.669Z","updatedAt":"2025-10-23T12:30:39.669Z","lastBump":"2025-10-23T12:30:39.669Z","script":"getgenv().Enabled = true\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Camera = workspace.CurrentCamera\nlocal LocalPlayer = Players.LocalPlayer\nlocal RaycastModule = require(ReplicatedStorage:WaitForChild(\"Events\"):WaitForChild(\"Modules\"):WaitForChild(\"RaycastModule\"))\n\nlocal AIM_CONE = 85\nlocal PREDICTION = 0.045\n\nlocal function GetClosestTarget()\n    local Closest, Shortest = nil, math.huge\n    local CamPos, CamLook = Camera.CFrame.Position, Camera.CFrame.LookVector\n    local Center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)\n    for _, Player in ipairs(Players:GetPlayers()) do\n        if Player == LocalPlayer or (Player.Team and Player.Team == LocalPlayer.Team) then continue end\n        local Char = Player.Character\n        if not Char then continue end\n        local Head, Hum = Char:FindFirstChild(\"Head\"), Char:FindFirstChildOfClass(\"Humanoid\")\n        if not (Head and Hum and Hum.Health > 0) then continue end\n        local Dir = (Head.Position - CamPos).Unit\n        local Angle = math.deg(math.acos(CamLook:Dot(Dir)))\n        if Angle < AIM_CONE then\n            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Head.Position)\n            if OnScreen then\n                local Dist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - Center).Magnitude\n                if Dist < Shortest then\n                    Shortest = Dist\n                    Closest = Head\n                end\n            end\n        end\n    end\n    return Closest\nend\n\nfor i, f in pairs(RaycastModule) do\n    if typeof(f) == \"function\" then\n        RaycastModule[i] = function(...)\n            if not getgenv().Enabled then return f(...) end\n            local Target = GetClosestTarget()\n            if not Target then return f(...) end\n            local Pred = Target.Position + (Target.Velocity * PREDICTION)\n            return Target, Pred, Vector3.zero\n        end\n    end\nend","features":"Silent aim\n(ADJUSTABLE)","tags":[],"discord":"","keyLink":"","owner":{"_id":"68e165b125350ed29c0366e8","username":"meowtology","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4a09c263e0b9d036752bc37de7a94de13ddbce73f20e59711a318e603fb0c1cb.webp","original":"https://scriptblox.com/images/photo/68e165b125350ed29c0366e8-1760696662142.jpg"},"lvl"