rInputType == Enum.UserInputType.Touch then\n\t\t\tdragging = true\n\t\t\tdragStart = input.Position\n\t\t\tstartPos = frame.Position\n                               input.Changed:Connect(function()\n\t\t\t\tif input.UserInputState == Enum.UserInputState.End then\n\t\t\t\t\tdragging = false\n\t\t\t\tend\n\t\t\tend)\n\t\tend\nend)\nframe.InputChanged:Connect(function(input)\n        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then\n\t\t\tdragInput = input\n\t\tend\n\tend)\nUserInputService.InputChanged:Connect(function(input)\n\t\tif input == dragInput and dragging then\n\t\t\tupdate(input)\n\t\tend\nend)\n","features":"Draggable gui thingy (made by PawsThePaw)","tags":["Universal","Gui"],"discord":"","keyLink":"","owner":{"_id":"64d3f4e9992ff6b802bb4ab3","username":"CMDS","verified":false,"profilePicture":{"url":"https://media.kocakz.me/041e4783b9541907b3d7678e8ed7fc0ef1fa703376a3975627e54538c2effae8.webp","original":"https://scriptblox.com/images/photo/64d3f4e9992ff6b802bb4ab3-1712427214412.png"},"status":"offline","id":"64d3f4e9992ff6b802bb4ab3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/041e4783b9541907b3d7678e8ed7fc0ef1fa703376a3975627e54538c2effae8.webp","original":"https://scriptblox.com/images/photo/64d3f4e9992ff6b802bb4ab3-1712427214412.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:10:15.202Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c502c4","editBy":{"_id":"64d3f4e9992ff6b802bb4ab3","username":"CMDS","status":"offline","id":"64d3f4e9992ff6b802bb4ab3"},"message":"Create script","createdAt":"2025-03-27T10:12:18.309Z"}],"comments":[]}