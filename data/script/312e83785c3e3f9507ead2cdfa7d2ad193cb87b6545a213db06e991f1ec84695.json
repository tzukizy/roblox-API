{"_id":"6aac09ef69cd68b0dca06464","title":"No fog","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/6f914eecc9c0a2e5cbef23b809eb5c0967d477052502195927bd7b9264a36d72.webp","original":"https://scriptblox.com/images/sb/0-1789659631598.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/6f914eecc9c0a2e5cbef23b809eb5c0967d477052502195927bd7b9264a36d72.webp","original":"https://scriptblox.com/images/sb/0-1789659631598.jpg"},"placeId":0},"slug":"Universal-Script-No-fog-228588","verified":false,"key":false,"keyless":false,"views":436,"executes":4050,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/1b05af11398c301d603ca4a918945f84b6074fddc1c920212907ecb96cd4cb82.webp","original":"https://scriptblox.com/images/sb/0-1789659631598.jpg","scriptblox":"https://scriptblox.com/images/script/0-1789659631598.jpg"},"thumbnail":{"url":"https://media.kocakz.me/1b05af11398c301d603ca4a918945f84b6074fddc1c920212907ecb96cd4cb82.webp","original":"https://scriptblox.com/images/sb/0-1789659631598.jpg","scriptblox":"https://scriptblox.com/images/script/0-1789659631598.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-09-17T15:40:31.661Z","updatedAt":"2026-09-17T15:40:31.661Z","lastBump":"2026-09-17T15:40:31.661Z","script":"-- Script para remover Fog, Atmosfera e melhorar FPS no Blox Fruits\nlocal Lighting = game:GetService(\"Lighting\")\n\n-- Limpa os efeitos de neblina e atmosfera padrão do Roblox\nLighting.FogEnd = 999999\nLighting.FogStart = 999999\nif Lighting:FindFirstChildOfClass(\"Atmosphere\") then\n    Lighting:FindFirstChildOfClass(\"Atmosphere\"):Destroy()\nend\n\n-- Mantém o Fog zerado caso o jogo tente atualizar sozinho\nLighting.Changed:Connect(function()\n    Lighting.FogEnd = 999999\n    Lighting.FogStart = 999999\nend)\n\n-- Desativa sombras pesadas locais para dar mais FPS\nLighting.GlobalShadows = false","features":"Esse script tira a neblina e texturas pesadas","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a9d8e424bd016b605d74888","username":"jamersonmendonca3","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a9d8e424bd016b605d74888","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-17T17:12:58.560Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:29:37.157Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6aac09ef69cd68b0dca06466","editBy":{"_id":"6a9d8e424bd016b605d74888","username":"jamersonmendonca3","status":"offline","id":"6a9d8e424bd016b605d74888"},"message":"Create script","createdAt":"2026-09-17T15:40:31.668Z"}],"comments":[]}