oot.CFrame\nlocal tweenInfo = TweenInfo.new(\n    5,\n    Enum.EasingStyle.Quad,\n    Enum.EasingDirection.Out\n)\n\ntask.spawn(function()\n    while true do\n        local Event = game:GetService(\"ReplicatedStorage\").AFK\n        Event:FireServer(true)\n        task.wait(1)\n    end\nend)\n\nfor _, obj in ipairs(workspace:GetDescendants()) do\n    if obj:IsA(\"Seat\") or obj:IsA(\"VehicleSeat\") then\n        obj:Destroy()\n    end\nend\n\nfor _, obj in ipairs(fld:GetDescendants()) do\n    if obj:IsA(\"BasePart\") then\n        local tween = TweenService:Create(root, tweenInfo, {\n            CFrame = CFrame.new(obj.Position)\n        })\n        tween:Play()\n        tween.Completed:Wait()\n        task.wait(1)\n    end\nend\n\nlocal returnTween = TweenService:Create(root, tweenInfo, {\n    CFrame = old\n})\nreturnTween:Play()\nreturnTween.Completed:Wait()","features":"AFK Invis and AutoFarm Open Source\n\nJoin The Discord\ndiscord.gg/FzSef8SXHs","tags":["Auto Farm","Open Source","AutoFarm"],"discord":"https://discord.gg/FzSef8SXHs","keyLink":"","owner":{"_id":"685292463b5549c3938e2092","username":"noritery","verified":false,"profilePicture":{"url":"https://media.kocakz.me/83032c5ff98c7fb60a99bfc4520e57acb039064a5461f4a1db34551ad5ec408c.webp","original":"https://scriptblox.com/images/photo/685292463b5549c3938e2092-1751012357063.png"},"status":"offline","id":"685292463b5549c3938e2092","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/83032c5ff98c7fb60a99bfc4520e57acb039064a5461f4a1db34551ad5ec408c.webp","original":"https://scriptblox.com/images/photo/685292463b5549c3938e2092-1751012357063.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:28:12.169Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a3037a0762d1454d08c3974","editBy"