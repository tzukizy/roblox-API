 Send Mode\nAutomatically sends Morse when you press Enter.\n\n🧭 Left / Right Step Direction Toggle\n\n🛑 Stop Button\nInstantly cancels the current Morse sequence.\n\n🐞 Optional Debug Mode\nPrints humanoid and movement state info to the F9 console.\n\n🖥️ Rayfield UI\n\nClean, modern interface\n\nConfig saving enabled\n\nEasy sliders & toggles\n\n🔒 Client-Only\nNo server scripts, no remotes fired for movement.","tags":["morsecode","key","bypass"],"discord":"","keyLink":"","owner":{"_id":"674b6724b319ed7a65a73e12","username":"CacheOG","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"674b6724b319ed7a65a73e12","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:32:30.454Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"696cebd8c50098f37f2743a0","editBy":{"_id":"674b6724b319ed7a65a73e12","username":"CacheOG","status":"offline","id":"674b6724b319ed7a65a73e12"},"message":"Create script","createdAt":"2026-01-18T14:19:04.393Z"}],"comments":[{"_id":"696f0917ce7e338b9d29dde1","commentBy":{"_id":"68209a304b9cc02af70f1f6b","username":"testingaccount1136","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/6a2c79f8f4a991c15ad81d54592719b450069ed0d275c31c9b1a67889da4ad17.webp","original":"https://scriptblox.com/images/photo/68209a304b9cc02af70f1f6b-1766288377873.png"},"createdAt":"2025-05-11T12:38:08.979Z","lastActive":"2026-10-19T13:29:18.297Z","lvl":7,"status":"offline","id":"68209a304b9cc02af70f1f6b","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/6a2c79f8f4a991c15ad81d54592719b450069ed0d275c31c9b1a67889da4ad17.we