{"slug":"The-Wild-West-4.0-animal-esp-open-source-42957","_id":"68567e74719793e8f009daf5","title":"animal esp open source","game":{"_id":"67e5e1ffb360710ec3c784a1","gameId":2317712696,"name":"The Wild West","imageUrl":"/images/sb/rbx-08691ba7970c92646522ee2b1809537c-91f8a234d6c8.png","placeId":2317712696},"features":"you can modify it (If something is wrong, I will fix it in a year)","tags":[],"script":"local ws = game.Workspace\n\nlocal function addHL(model)\n    if model:FindFirstChildOfClass(\"Highlight\") then return end\n    local hl = Instance.new(\"Highlight\")\n    hl.Name = \"ESP_Highlight\"\n    hl.Adornee = model\n    hl.FillColor = Color3.new(1, 0, 0)\n    hl.FillTransparency = 0.3\n    hl.OutlineColor = Color3.new(1, 0, 0)\n    hl.OutlineTransparency = 0\n    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n    hl.Parent = model\nend\n\nlocal function remHL(model)\n    local hl = model:FindFirstChild(\"ESP_Highlight\")\n    if hl then hl:Destroy() end\nend\n\nwhile true do\n    local ent = ws:FindFirstChild(\"WORKSPACE_Entities\")\n    if ent then\n        local animals = ent:FindFirstChild(\"Animals\")\n        if animals then\n            for _, a in pairs(animals:GetChildren()) do\n                remHL(a)\n            end\n            for _, a in pairs(animals:GetChildren()) do\n                addHL(a)\n            end\n        end\n    end\n    wait(5)\nend\n","owner":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","verified":false,"profilePicture":"/images/photo/67bd8d2e1ec2c16a13a94ae0-1750370853982.jpg","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0","topMilestone":{"key":"creator.executions","tier":100000}},"verified":false,"views":4832,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-c99f0fcdf6a7114f5c4d72e2faf79bb6-ed55a249c2f5.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-06-21T09:42:12.930Z","executes":79,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68567e74719793e8f009daf7","editBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0"},"message":"Create script","createdAt":"2025-06-21T09:42:12.933Z"}],"comments":[{"_id":"6911146ee480512d842e81a7","commentBy":{"_id":"6911134aa124667012d0ceb5","username":"SayaK6","verified":false,"role":"user","profilePicture":"/images/photo/6911134aa124667012d0ceb5-1766895302956.jpg","lastActive":"2026-01-13T04:19:22.297Z","createdAt":"2025-11-09T22:18:50.308Z","status":"offline","id":"6911134aa124667012d0ceb5"},"text":".","edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-09T22:23:42.727Z","liked":false,"disliked":false},{"_id":"69111c9e69e0234f4712f299","commentBy":{"_id":"6911134aa124667012d0ceb5","username":"SayaK6","verified":false,"role":"user","profilePicture":"/images/photo/6911134aa124667012d0ceb5-1766895302956.jpg","lastActive":"2026-01-13T04:19:22.297Z","createdAt":"2025-11-09T22:18:50.308Z","status":"offline","id":"6911134aa124667012d0ceb5"},"text":"mods can detect this?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-09T22:58:38.448Z","liked":false,"disliked":false},{"_id":"69117a689e8cc910596700d3","commentBy":{"_id":"67bd8d2e1ec2c16a13a94ae0","username":"zetnikss","verified":false,"role":"user","profilePicture":"/images/photo/67bd8d2e1ec2c16a13a94ae0-1750370853982.jpg","createdAt":"2025-02-25T09:28:14.090Z","lastActive":"2026-06-11T05:11:02.518Z","status":"offline","id":"67bd8d2e1ec2c16a13a94ae0","topMilestone":{"key":"creator.executions","tier":100000}},"text":"maybe but when i play they didnt","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-10T05:38:48.452Z","liked":false,"disliked":false},{"_id":"69128056e7695b78b4631a00","commentBy":{"_id":"6911134aa124667012d0ceb5","username":"SayaK6","verified":false,"role":"user","profilePicture":"/images/photo/6911134aa124667012d0ceb5-1766895302956.jpg","lastActive":"2026-0