{"slug":"Universal-Script-Burn-self-script-suggested-by-amongus-47842","_id":"68950186c23f749e7073da8e","title":"Burn self script suggested by amongus","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1754595718697.jpg","placeId":0},"features":"Burns player client sided tho","tags":[],"script":"-- LocalScript (put in StarterPlayerScripts or StarterCharacterScripts)\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function burnUntilDeath(character)\n\tlocal humanoid = character:WaitForChild(\"Humanoid\")\n\tlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n\t-- Add fire effect\n\tlocal fire = Instance.new(\"Fire\")\n\tfire.Heat = 10\n\tfire.Size = 8\n\tfire.Color = Color3.new(1, 0.4, 0)\n\tfire.SecondaryColor = Color3.new(1, 0, 0)\n\tfire.Parent = rootPart\n\n\t-- Constant fake damage until dead\n\twhile humanoid.Health > 0 do\n\t\thumanoid.Health = humanoid.Health - 2 -- again, only local\n\t\twait(0.2)\n\tend\n\n\t-- Clean up fire after death\n\tfire:Destroy()\nend\n\n-- Run when player character spawns\nplayer.CharacterAdded:Connect(function(character)\n\twait(1) -- Let the character fully load\n\tburnUntilDeath(character)\nend)\n\n-- If already spawned\nif player.Character then\n\tburnUntilDeath(player.Character)\nend","owner":{"_id":"68823aa1af5045d72a7e7591","username":"rogelanthony54","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68823aa1af5045d72a7e7591"},"verified":false,"views":1175,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1754595718697.jpg","likeCount":0,"dislikeCount":5,"createdAt":"2025-08-07T19:41:58.830Z","editBy":{"_id":"68823aa1af5045d72a7e7591","username":"rogelanthony54","status":"offline","id":"68823aa1af5045d72a7e7591"},"executes":105,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":