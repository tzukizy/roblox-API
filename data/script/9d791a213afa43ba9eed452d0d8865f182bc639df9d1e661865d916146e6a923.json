{"_id":"68950186c23f749e7073da8e","title":"Burn self script suggested by amongus","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d5b31b830597a8881a31453a4d745f850cbdd9855acba1621ef8f91477456f48.webp","original":"https://scriptblox.com/images/sb/0-1754595718697.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d5b31b830597a8881a31453a4d745f850cbdd9855acba1621ef8f91477456f48.webp","original":"https://scriptblox.com/images/sb/0-1754595718697.jpg"},"placeId":0},"slug":"Universal-Script-Burn-self-script-suggested-by-amongus-47842","verified":false,"key":false,"keyless":false,"views":1196,"executes":126,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/9c07096a2cc005d1769bb29d2e8d7432418c5152b3cc655f2e46cd5c67955366.webp","original":"https://scriptblox.com/images/sb/0-1754595718697.jpg","scriptblox":"https://scriptblox.com/images/script/0-1754595718697.jpg"},"thumbnail":{"url":"https://media.kocakz.me/9c07096a2cc005d1769bb29d2e8d7432418c5152b3cc655f2e46cd5c67955366.webp","original":"https://scriptblox.com/images/sb/0-1754595718697.jpg","scriptblox":"https://scriptblox.com/images/script/0-1754595718697.jpg"},"likeCount":0,"dislikeCount":5,"createdAt":"2025-08-07T19:41:58.830Z","updatedAt":"2025-08-07T19:41:58.830Z","lastBump":"2025-08-07T19:41:58.830Z","script":"-- LocalScript (put in StarterPlayerScripts or StarterCharacterScripts)\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function burnUntilDeath(character)\n\tlocal humanoid = character:WaitForChild(\"Humanoid\")\n\tlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n\t-- Add fire effect\n\tlocal fire = Instance.new(\"Fire\")\n\tfire.Heat = 10\n\tfire.Size = 8\n\tfire.Color = Color3.new(1, 0.4, 0)\n\tfire.SecondaryColor = Color3.new(1, 0, 0)\n\tfire.Parent = rootPart\n\n\t-- Constant fake damage until dead\n\twhile humanoid.Health > 0 do\n\t\thumanoid.Health = humanoid.Health - 2 -- again, only local\n\t\twait(0.2)\n\tend\n\n\t-- Clean up fire after death\n\tfire:Destroy()\nend\n\n-- Run when player character spawns\nplayer.CharacterAdded:Connect(function(character)\n\twait(1) -- Let the character fully load\n\tburnUntilDeath(character)\nend)\n\n-- If already spawned\nif player.Character then\n\tburnUntilDeath(player.Character)\nend","features":"Burns player client sided tho","tags":[],"discord":"","keyLink":"","owner":{"_id":"68823aa1af5045d72a7e7591","username":"rogelanthony54","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68823aa1af5045d72a7e7591","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:52:35.521Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68950186c23f749e7073da90","editBy":{"_id":"68823aa1af5045d72a7e7591","username":"rogelanthony54","status":"offline","id":"68823aa1af5045d72a7e7591"},"message":"Create script","createdAt":"2025-08-07T19:41:58.835Z"},{"_id":"68950254c27fbc3949c4955a","editBy":{"_id":"68823aa1af5045d72a7e7591","username":"rogelanthony54","status":"offline","id":"68823aa1af5045d72a7e7591"},"message":"Update script","createdAt":"2025-08-07T19:45:24.701Z"}],"comments":[{"_id":"689501b24801cb97c115ba59","commentBy":{"_id":"68823aa1af5045d72a7e7591","username":"rogelanthony54","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-07-24T13:52:33.180Z","lastActive":"2025-08-07T19:59:08.805Z","status":"offline","id":"68823aa1af5045d72a7e7591","profile":{"url":"https://media