{"slug":"Universal-Script-Better-fps-5783","_id":"63231971eaa865646f5155bb","title":"Better fps","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Nothing much, Self-explanatory (makes the game look potato but increase your FPS)\n\nResults can give upto 30 fps","tags":[],"script":"local decalsyeeted = true -- Leaving this on makes games look shitty but the fps goes up by at least 30.\nlocal g = game\nlocal w = g.Workspace\nlocal l = g.Lighting\nlocal t = w.Terrain\nt.WaterWaveSize = 0\nt.WaterWaveSpeed = 0\nt.WaterReflectance = 0\nt.WaterTransparency = 0\nl.GlobalShadows = false\nl.FogEnd = 9e9\nl.Brightness = 0\nsettings().Rendering.QualityLevel = \"Level01\"\nfor i, v in pairs(g:GetDescendants()) do\n    if v:IsA(\"Part\") or v:IsA(\"Union\") or v:IsA(\"CornerWedgePart\") or v:IsA(\"TrussPart\") then\n        v.Material = \"Plastic\"\n        v.Reflectance = 0\n    elseif v:IsA(\"Decal\") or v:IsA(\"Texture\") and decalsyeeted then\n        v.Transparency = 1\n    elseif v:IsA(\"ParticleEmitter\") or v:IsA(\"Trail\") then\n        v.Lifetime = NumberRange.new(0)\n    elseif v:IsA(\"Explosion\") then\n        v.BlastPressure = 1\n        v.BlastRadius = 1\n    elseif v:IsA(\"Fire\") or v:IsA(\"SpotLight\") or v:IsA(\"Smoke\") then\n        v.Enabled = false\n    elseif v:IsA(\"MeshPart\") then\n        v.Material = \"Plastic\"\n        v.Reflectance = 0\n        v.TextureID = 10385902758728957\n    end\nend\nfor i, e in pairs(l:GetChildren()) do\n    if e:IsA(\"BlurEffect\") or e:IsA(\"SunRaysEffect\") or e:IsA(\"ColorCorrectionEffect\") or e:IsA(\"BloomEffect\") or e:IsA(\"DepthOfFieldEffect\") then\n        e.Enabled = false\n    end\nend","owner":{"_id":"62d808e445d45c9b6ebaa00d","username":"Twix","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/62d808e445d45c9b6ebaa00d-1658325264827.png"},"status":"offline","id":"62d808e445d45c9b6ebaa00d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/62d808e445d45c9b6ebaa00d-1658325264827.png"}},"verified":false,"views":12934,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-09-15T12:24:17.678Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/3502745-1663244657638.jpg","scriptblox":"https://scriptblox.com/images/script/3502745-1663244657638.jpg"},"executes":3470,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T05:15:00.661Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/3502745-1663244657638.jpg","scriptblox":"https://scriptblox.com/images/script/3502745-1663244657638.jpg"},"changelog":[{"_id":"67e5e1e3b360710ec3c4e9a3","editBy":{"_id":"62d808e445d45c9b6ebaa00d","username":"Twix","status":"offline","id":"62d808e445d45c9b6ebaa00d"},"message":"Create script","createdAt":"2025-03-27T19:32:58.877Z"}],"comments":[{"_id":"63234207ef24d8729eb7f2f1","commentBy":{"_id":"62f6706974e75bac067fb784","username":"Foreverekk","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/ad1071c7e736f89da1c6fd0388a01074e1a8e6d156eb8af8b892048cadbd3a87.webp","original":"https://scriptblox.com/images/photo/62f6706974e75bac067fb784-1733435380506.jpg"},"createdAt":"2022-08-12T15:23:21.552Z","lastActive":"2025-09-24T11:58:37.478Z","status":"offline","id":"62f6706974e75bac067fb784","topMilestone":{"key"