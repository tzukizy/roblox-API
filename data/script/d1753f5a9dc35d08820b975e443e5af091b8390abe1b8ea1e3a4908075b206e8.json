{"slug":"Universal-Script-another-global-function-tes-70038","_id":"6926007fba5ff2ff5d9f490b","title":"another global function tes","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"some random sh⁠itty cunt advertised here\nanyways works without using _G. or getgenv","tags":[],"script":"-- lazy way to make this function actually global lmao (works on every executor i think)\n-- synapse, krnl, delta, fluxus, even the weird mobile ones\n\nlocal env = getgenv() or getrenv() or _G   -- whatever works\n\nenv.globalfunctiontest = function(msg)\n    print(msg)\nend\n\n-- just in case some scripts have their own env\nif getfenv and setfenv then\n    local current = getfenv()\n    if current ~= env and current.globalfunctiontest == nil then\n        current.globalfunctiontest = env.globalfunctiontest\n    end\nend\n\n-- force it into real _G too so nothing can hide it\nrawset(_G, \"globalfunctiontest\", env.globalfunctiontest)\n","owner":{"_id":"690ffd7f16269cc7bb747e89","username":"ladynoire","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/677a9f5c18f7d46df785f87140d9d26f5161921e30dbfb0b5d87d403cd039eff.webp","original":"https://scriptblox.com/images/photo/690ffd7f16269cc7bb747e89-1762670526469.png"},"status":"offline","id":"690ffd7f16269cc7bb747e89","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/677a9f5c18f7d46df785f87140d9d26f5161921e30dbfb0b5d87d403cd039eff.webp","original":"https://scriptblox.com/images/photo/690ffd7f16269cc7bb747e89-1762670526469.png"}},"verified":false,"views":323,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/506e4667e0aa0a93a476091e56f711e0f6cc845faf48ce82ed016afb6a4a2e09.webp","origin