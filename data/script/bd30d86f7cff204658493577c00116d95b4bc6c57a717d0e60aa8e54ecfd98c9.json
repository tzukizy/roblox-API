{"slug":"Right-2-Fight-V0.4.0-legendary-dragon-slap-over-guru-ultimate-essence-38380","_id":"681372f63ddfe7f175112780","title":"legendary dragon slap over guru ultimate essence","game":{"_id":"67e5e1ffb360710ec3c77d63","gameId":8170900938,"name":"Right 2 Fight (Inactive)","imageUrl":"/images/sb/rbx-f7a21c12099226c0712bd8e195b40df5-5fa59564b0e2.png","placeId":8170900938},"features":"simple script that replaces H_GUltimateEssence with H_UltimateEssence animation, victim anim, and serverside/clientside sounds not included.\n\ni uploaded this for a friend.","tags":[],"script":"local Player = game.Players.LocalPlayer\nlocal Rep = game.ReplicatedStorage\nlocal Char = Player.Character\nlocal Main = Player.PlayerGui.Interface.Battle.Main\n\nMain.HeatMove.TextLabel:GetPropertyChangedSignal(\"Text\"):Connect(function()\n    if Main.HeatMove.TextLabel.Text == \"Ultimate Essence\" then\n        Main.HeatMove.TextLabel.Text = Rep.Moves.H_UltimateEssence.MoveName.Value\n        local Anim = Char.Humanoid:LoadAnimation(Rep.Moves.H_UltimateEssence.Anim)\n        Anim.Priority = Enum.AnimationPriority.Action4\n        Anim:Play()\n        Anim:Destroy()\n    end\nend)","owner":{"_id":"6738bf6d38523256d4446c75","username":"imdisplay","verified":false,"profilePicture":"/images/photo/6738bf6d38523256d4446c75-1761644320909.jpeg","status":"offline","id":"6738bf6d38523256d4446c75","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":11776,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-82ec260813fae36d6df9df3e2b32137e-80a5aa47f367.png","likeCount":0,"dislikeCount":1,"createdAt":"2025-05-01T13:11:18.956Z","executes":70,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"681372f63ddfe7f175112783","editBy":{"_id":"6738bf6d38523256d4446c75","username":"imdisplay","status":"offline","id":"6738bf6d38523256d4446c75"},"message":"Create script","createdAt":"2025-05-01T1