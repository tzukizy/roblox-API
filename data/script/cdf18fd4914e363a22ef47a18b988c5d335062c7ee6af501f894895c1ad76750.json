{"_id":"69111d75f18434eef309a2c6","title":"Tdx combat drone script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/c58eb459d8c73631590d0c8416301567d3dff168e3ee4d2232a6a7844134c022.webp","original":"https://scriptblox.com/images/sb/0-1762729333932.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/c58eb459d8c73631590d0c8416301567d3dff168e3ee4d2232a6a7844134c022.webp","original":"https://scriptblox.com/images/sb/0-1762729333932.png"},"placeId":0},"slug":"Universal-Script-Tdx-combat-drone-script-64652","verified":false,"key":false,"keyless":false,"views":4113,"executes":499,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/92de7360bc00eafa5adb332494bb6621dc9789bea7294c27e396d143de70d352.webp","original":"https://scriptblox.com/images/sb/0-1762729333932.png","scriptblox":"https://scriptblox.com/images/script/0-1762729333932.png"},"thumbnail":{"url":"https://media.kocakz.me/92de7360bc00eafa5adb332494bb6621dc9789bea7294c27e396d143de70d352.webp","original":"https://scriptblox.com/images/sb/0-1762729333932.png","scriptblox":"https://scriptblox.com/images/script/0-1762729333932.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-11-09T23:02:13.943Z","updatedAt":"2025-11-09T23:02:13.943Z","lastBump":"2025-11-09T23:02:13.943Z","script":"while task.wait(0.37) do\n    local weapon = filtergc(\"table\", {\n        Keys = { \"ReloadTime\", \"ShotsRemaining\", \"AttackConfig\" },\n    }, false)\n\n    if weapon then\n        for i,v in next, weapon do\n            rawset(v, \"ReloadTime\", 0)\n            rawset(v, \"DefaultShotInterval\", 0)\n            rawset(v, \"SplashRadius\", 50)\n            rawset(v, \"DefaultSpreadDegrees\", 0)\n            rawset(v.AttackConfig.RecoilConfig, \"CamKickMin\", Vector3.zero)\n            rawset(v.AttackConfig.RecoilConfig, \"CamKickMax\", Vector3.zero)\n            if v.ProjectileConfig and (v.ProjectileConfig ~= nil or v.ProjectileConfig ~= false)  then\n                rawset(v.ProjectileConfig, \"Velocity\", 0xFFFFFFFFFF)\n                rawset(v.ProjectileConfig, \"FlyForwardsOverrideVelocity\", 0xFFFFFFFFFF)\n                rawset(v.ProjectileConfig, \"MinimumTimeToHit\", 0)\n            end\n        end\n    end\nend\n\n-- john roblox eats dick!","features":"Since the other one was taken down I'll, reboot a new one \n\nShoot really fast you should only use 2'5 \nDestroys nightmare mode \nNeeds help on ultra tho \nVery op script","tags":[],"discord":"","keyLink":"","owner":{"_id":"669d7d06fab9a0ab3ea0da12","username":"cyairesmith","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"669d7d06fab9a0ab3ea0da12","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:32:49.538Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69111d75f18434eef309a2c8","editBy":{"_id":"669d7d06fab9a0ab3ea0da12","username":"cyairesmith","status":"offline","id":"669d7d06fab9a0ab3ea0da12"},"message":"Script t","createdAt":"2025-11-09T23:02:13.947Z"}],"comments":[{"_id":"69111d91bb9f6a82b6a36122","commentBy":{"_id":"669d7d06fab9a0ab3ea0da12","username":"cyairesmith","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-07-21T21:26:30.235Z","lastActive":"2026-02-25T01:26:41.217Z","status":"offline","id":"669d7d06fab9a0ab3ea0da12","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}}