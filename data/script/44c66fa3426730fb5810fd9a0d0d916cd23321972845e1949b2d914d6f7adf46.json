{"slug":"Universal-Script-Universal-Head-Lock-On-Script-70495","_id":"6927e560657fab4e191a0a7c","title":"Universal Head Lock On Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Locks On To Players Head Works In Any Game On Roblox","tags":[],"script":"-- Head Lock-On System (Client-Side)\n-- Keybind: X to toggle\n\nlocal UIS = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Mouse = LocalPlayer:GetMouse()\n\nlocal targetLock = false\nlocal lockedPlayer = nil\n\nlocal function getClosestPlayer()\n    local closest = nil\n    local shortestDist = math.huge\n\n    for _, player in pairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Character then\n            local head = player.Character:FindFirstChild(\"Head\")\n            if head then\n                local screenPos = workspace.CurrentCamera:WorldToScreenPoint(head.Position)\n                local mousePos = Vector2.new(Mouse.X, Mouse.Y)\n                local distance = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude\n\n                if distance < shortestDist then\n                    shortestDist = distance\n                    closest = player\n                end\n            end\n        end\n    end\n\n    return closest\nend\n\nlocal function lockOn()\n    local target = getClosestPlayer()\n    if target and target.Character then\n        local head = target.Character:FindFirstChild(\"Head\")\n        if head then\n            lockedPlayer = target\n            targetLock = true\n        end\n    end\nend\n\nlocal function updateLock()\n    if lockedPlayer and lockedPlayer.Character then\n        local head = lockedPlayer.Character:FindFirstChild(\"Head\")\n        if head then\n            local cam = workspace.CurrentCamera\n            cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position)\n        end\n    end\nend\n\nUIS.InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.X then\n        if not targetLock then\n            lockOn()\n        else\n            lockedPlayer = nil\n            targetLock = false\n        end\n    end\nend)\n\nRunService.RenderStepped:Connect(function()\n    if targetLock then\n        updateLock()\n    end\nend)\n","owner":{"_id":"691681d219e0cbc8233bbed1","username":"YoriScripts","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/704227de190e29cfe1ac4a2f6d7589790e4ab69a6fce35b2096488f0d5f87b32.webp","original":"https://scriptblox.com/images/photo/691681d219e0cbc8233bbed1-1783720824109.jpg"},"status":"offline","id":"691681d219e0cbc8233bbed1","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/704227de190e29cfe1ac4a2f6d7589790e4ab69a6fce35b2096488f0d5f87b32.webp","original":"https://scriptblox.com/images/photo/691681d219e0cbc8233bbed1-1783720824109.jpg"}},"verified":false,"views":3134,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/c0bc20420d6e15265b816f7c4e77abc5d736089206ae2e19fad2a9a4d6ad94ee.webp","original":"https://scriptblox.com/images/sb/0-1764222304730.jpg","scriptblox":"https://scriptblox.com/images/script/0-1764222304730.jpg"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-11-27T05:45:04.740Z","executes":507,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:38:09.527Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/c0bc20420d6e15265b816f7c4e77abc5d7360