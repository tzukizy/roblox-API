{"slug":"Free-Client-Script-Executor-*BACK*-hat-position-change-to-mouse-position-55344","_id":"68d880494e71893cfaf6b9fc","title":"hat position change to mouse position","game":{"_id":"68966c2c1db541b05096cd52","gameId":14113053169,"name":"Free Client Script Executor *BACK*","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14113053169},"features":"this is using network ownership\nif hat is positioned too close or too far from the player the hat will fall off\nif hat will fall then character reset please","tags":[],"script":"task.wait(4)\nlocal d = game.Players.LocalPlayer.Name\nfor _, a in pairs(workspace[d]:GetDescendants()) do\n\tif a:IsA(\"Accessory\") then\n\t\tif a:FindFirstChild(\"Handle\") then\n\t\t\tlocal handle = a.Handle\n\t\t\tif handle:FindFirstChild(\"AccessoryWeld\") then\n\t\t\t\thandle.AccessoryWeld:Destroy()\n\t\t\t\tend\n\t\t\t\thandle.CanCollide = false\n\t\t\t\tlocal bodyPosition = Instance.new(\"BodyPosition\")\n\t\t\t\tbodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)\n\t\t\t\tbodyPosition.D = 100\n\t\t\t\tbodyPosition.P = 10000\n\t\t\t\tbodyPosition.Parent = handle\ngame:GetService(\"RunService\").Stepped:Connect(function()\nlocal mouse = game.Players.LocalPlayer:GetMouse()\nlocal pos = mouse.Hit.p\nbodyPosition.Position = pos\nend)\nend\n\t\t\tend\n\t\tend","owner":{"_id":"686237f4d0113c7678e5cb55","username":"sasinick","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"686237f4d0113c7678e5cb55","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":3775,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d984