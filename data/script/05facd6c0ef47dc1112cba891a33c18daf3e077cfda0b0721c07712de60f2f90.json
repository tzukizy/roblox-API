{"_id":"6a7accb4a8436347e1a0ee6b","title":"Infinite Jump x Speed","game":{"_id":"6959526c0597a5542a8de666","gameId":0,"name":"Script hub","imageUrl":{"url":"https://media.kocakz.me/b1e1cc4011ea1e8ecb9e639c67b847d959bc6029d5088162a6af79479d0c7d60.webp","original":"https://scriptblox.com/images/sb/0-1786432692499.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/b1e1cc4011ea1e8ecb9e639c67b847d959bc6029d5088162a6af79479d0c7d60.webp","original":"https://scriptblox.com/images/sb/0-1786432692499.png"},"placeId":0},"slug":"Universal-Script-Infinite-Jump-x-Speed-223371","verified":false,"key":false,"keyless":false,"views":197,"executes":242,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5ecede19bbed77cce6eeede98b29981643223207d9e184208187725a5c8b8e57.webp","original":"https://scriptblox.com/images/sb/0-1786432692499.png","scriptblox":"https://scriptblox.com/images/script/0-1786432692499.png"},"thumbnail":{"url":"https://media.kocakz.me/5ecede19bbed77cce6eeede98b29981643223207d9e184208187725a5c8b8e57.webp","original":"https://scriptblox.com/images/sb/0-1786432692499.png","scriptblox":"https://scriptblox.com/images/script/0-1786432692499.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-08-11T07:18:12.537Z","updatedAt":"2026-08-11T07:18:12.537Z","lastBump":"2026-08-11T07:18:12.537Z","script":"-- Infinite Jump\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal localPlayer = Players.LocalPlayer\n\nUserInputService.JumpRequest:Connect(function()\n    local character = localPlayer.Character\n    if character then\n        local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n        if humanoid then\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end\nend)\n-- Speed\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal localPlayer = Players.LocalPlayer\n\n-- Set initial speed\nlocalPlayer.CharacterAdded:Connect(function(char)\n    char:WaitForChild(\"Humanoid\").WalkSpeed = 500\nend)\n\nUserInputService.JumpRequest:Connect(function()\n    local character = localPlayer.Character\n    if character then\n        local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n        if humanoid then\n            humanoid.WalkSpeed = 500 -- Ensures speed stays at 500\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end\nend)\n","features":"Just a normal script!!","tags":[],"discord":"","keyLink":"","owner":{"_id":"69fc788289b1e47bb5e1b3ad","username":"Arclight","verified":false,"profilePicture":{"url":"https://media.kocakz.me/61a00e69f4c8674cd45a182e4eb4a7b5c7d68d044bd511683ca1957fb8d71586.webp","original":"https://scriptblox.com/images/photo/69fc788289b1e47bb5e1b3ad-1786340067580.png"},"status":"offline","id":"69fc788289b1e47bb5e1b3ad","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/61a00e69f4c8674cd45a182e4eb4a7b5c7d68d044bd511683ca1957fb8d71586.webp","original":"https://scriptblox.com/images/photo/69fc788289b1e47bb5e1b3ad-1786340067580.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:45:56.301Z","last":"","win":14,"math":3},"isHub":true,"supportedGames":[{"_id":"67e5e1ffb360710ec3c77d10","gameId":4924922222,"placeId":4924922222,"name":"Brookhaven 🏡RP","imageUrl":{"url":"https://media.kocakz.me/45dde9979cee2fc6112cbb06aa9516e539c642e21755593a5150739a12fd0e4b.webp","original":"https://tr.rbxcdn.com/180DAY-245d78e6940e8cce07af3874cb58f021/150/150/Image/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/45dde9979cee2fc6112cbb06aa9516e539c642e21755593a5150739a12fd0e4b.webp","original":"ht