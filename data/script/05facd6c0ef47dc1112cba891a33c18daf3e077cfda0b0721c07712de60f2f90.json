{"slug":"Universal-Script-Infinite-Jump-x-Speed-223371","_id":"6a7accb4a8436347e1a0ee6b","title":"Infinite Jump x Speed","game":{"_id":"6959526c0597a5542a8de666","gameId":0,"name":"Script hub","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Just a normal script!!","tags":[],"script":"-- Infinite Jump\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal localPlayer = Players.LocalPlayer\n\nUserInputService.JumpRequest:Connect(function()\n    local character = localPlayer.Character\n    if character then\n        local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n        if humanoid then\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end\nend)\n-- Speed\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal localPlayer = Players.LocalPlayer\n\n-- Set initial speed\nlocalPlayer.CharacterAdded:Connect(function(char)\n    char:WaitForChild(\"Humanoid\").WalkSpeed = 500\nend)\n\nUserInputService.JumpRequest:Connect(function()\n    local character = localPlayer.Character\n    if character then\n        local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n        if humanoid then\n            humanoid.WalkSpeed = 500 -- Ensures speed stays at 500\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end\nend)\n","owner":{"_id":"69fc788289b1e47bb5e1b3ad","username":"Arclight","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/61a00e69f4c8674cd45a182e4eb4a7b5c7d68d044bd511683ca1957fb8d71586.webp","original":"https://scriptblox.com/images/photo/69fc788289b1e47bb5e1b3ad-1786340067580.png"},"status":"offline","id":"69fc788289b1e47bb5e1b3ad","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"