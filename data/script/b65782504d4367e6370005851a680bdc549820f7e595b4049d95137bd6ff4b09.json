{"_id":"68cbd4d9b3b0d44947e331ac","title":"script to launch urself upwards","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d441b78c62ea3c9774d6261de0aa71b95b4e06540c40a495d37997f60861c89e.webp","original":"https://scriptblox.com/images/sb/0-1758188761673.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d441b78c62ea3c9774d6261de0aa71b95b4e06540c40a495d37997f60861c89e.webp","original":"https://scriptblox.com/images/sb/0-1758188761673.png"},"placeId":0},"slug":"Universal-Script-script-to-launch-urself-upwards-53791","verified":false,"key":false,"keyless":false,"views":7963,"executes":21,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c59bee48de492b0abb498aa873a95ed704b2985044257bf35dae40f13fe0b2aa.webp","original":"https://scriptblox.com/images/sb/0-1758188761673.png","scriptblox":"https://scriptblox.com/images/script/0-1758188761673.png"},"thumbnail":{"url":"https://media.kocakz.me/c59bee48de492b0abb498aa873a95ed704b2985044257bf35dae40f13fe0b2aa.webp","original":"https://scriptblox.com/images/sb/0-1758188761673.png","scriptblox":"https://scriptblox.com/images/script/0-1758188761673.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-09-18T09:46:01.692Z","updatedAt":"2025-09-18T09:46:01.692Z","lastBump":"2025-09-18T09:46:01.692Z","script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\n-- Function to fling the character\nlocal function flingCharacter()\n    -- Create a BodyVelocity to apply force\n    local bodyVelocity = Instance.new(\"BodyVelocity\")\n    bodyVelocity.Velocity = Vector3.new(0, 200, 0) -- change this to fling in other directions\n    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)\n    bodyVelocity.P = 1e4\n    bodyVelocity.Parent = hrp\n\n    -- Optional: Remove the BodyVelocity after a short delay\n    game.Debris:AddItem(bodyVelocity, 0.5)\nend\n\n-- Fling on key press (for testing)\nlocal UIS = game:GetService(\"UserInputService\")\n\nUIS.InputBegan:Connect(function(input, processed)\n    if processed then return end\n    if input.KeyCode == Enum.KeyCode.F then -- Press F to fling\n        flingCharacter()\n    end\nend)\n","features":"fling urself upwards (press F after execution)","tags":["roblox"],"discord":"","keyLink":"","owner":{"_id":"67deb8b3a30623be5b8040c9","username":"112nik22345","verified":false,"profilePicture":{"url":"https://media.kocakz.me/568a40ced3f3db1444157833eba2cbe69d3d2276c8047f9cb0e7cc254ca9d681.webp","original":"https://scriptblox.com/images/photo/67deb8b3a30623be5b8040c9-1758205454330.png"},"status":"offline","id":"67deb8b3a30623be5b8040c9","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/568a40ced3f3db1444157833eba2cbe69d3d2276c8047f9cb0e7cc254ca9d681.webp","original":"https://scriptblox.com/images/photo/67deb8b3a30623be5b8040c9-1758205454330.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:50:09.856Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cbd4d9b3b0d44947e331ae","editBy":{"_id":"67deb8b3a30623be5b8040c9","username":"112nik22345","status":"offline","id":"67deb8b3a30623be5b8040c9"},"message":"Create script","createdAt":"2025-09-18T09:46:01.696Z"}],"comments":[]}