{"_id":"698d11ba9a31e539421d8507","title":"Stand on players head with out collision","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/f154c9fe23aa8118823ea3c201b2db5dc6ef8e6c9c11917ff86f461798c822c5.webp","original":"https://scriptblox.com/images/sb/0-1770852794899.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/f154c9fe23aa8118823ea3c201b2db5dc6ef8e6c9c11917ff86f461798c822c5.webp","original":"https://scriptblox.com/images/sb/0-1770852794899.jpg"},"placeId":0},"slug":"Universal-Script-Stand-on-players-head-with-out-collision-110433","verified":false,"key":false,"keyless":false,"views":648,"executes":172,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/99ebea52ecb2f7911bc7ed2ae24542f0d2893389fd224171a9a47f7c7927222e.webp","original":"https://scriptblox.com/images/sb/0-1770852794899.jpg","scriptblox":"https://scriptblox.com/images/script/0-1770852794899.jpg"},"thumbnail":{"url":"https://media.kocakz.me/99ebea52ecb2f7911bc7ed2ae24542f0d2893389fd224171a9a47f7c7927222e.webp","original":"https://scriptblox.com/images/sb/0-1770852794899.jpg","scriptblox":"https://scriptblox.com/images/script/0-1770852794899.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-11T23:33:14.907Z","updatedAt":"2026-02-11T23:33:14.907Z","lastBump":"2026-02-11T23:33:14.907Z","script":"local RunService = game:GetService(\"RunService\")\nlocal Player = game.Players.LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\nlocal Root = Character:WaitForChild(\"HumanoidRootPart\")\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\n-- Settings\nlocal RAY_LENGTH = 3.5 -- How far down to look for a player\nlocal BOUNCE_FORCE = 5  -- Small upward force to stay on top\n\nRunService.Heartbeat:Connect(function()\n\t-- Only run if we are actually in the air/falling\n\tif Humanoid:GetState() == Enum.HumanoidStateType.Freefall or Humanoid:GetState() == Enum.HumanoidStateType.Jumping then\n\t\t\n\t\t-- Setup Raycast\n\t\tlocal raycastParams = RaycastParams.new()\n\t\traycastParams.FilterDescendantsInstances = {Character}\n\t\traycastParams.FilterType = Enum.RaycastFilterType.Exclude\n\n\t\t-- Cast downwards\n\t\tlocal raycastResult = workspace:Raycast(Root.Position, Vector3.new(0, -RAY_LENGTH, 0), raycastParams)\n\n\t\tif raycastResult and raycastResult.Instance then\n\t\t\tlocal hitModel = raycastResult.Instance:FindFirstAncestorOfClass(\"Model\")\n\t\t\t\n\t\t\t-- Check if the hit object is a player\n\t\t\tif hitModel and hitModel:FindFirstChild(\"Humanoid\") then\n\t\t\t\t-- Stop falling through them by resetting Y velocity\n\t\t\t\tRoot.AssemblyLinearVelocity = Vector3.new(Root.AssemblyLinearVelocity.X, BOUNCE_FORCE, Root.AssemblyLinearVelocity.Z)\n\t\t\t\t\n\t\t\t\t-- Optional: Change state to Landed to allow another jump immediately\n\t\t\t\tHumanoid:ChangeState(Enum.HumanoidStateType.Landed)\n\t\t\tend\n\t\tend\n\tend\nend)","features":"Allows you to float on players head without collision.","tags":[],"discord":"","keyLink":"","owner":{"_id":"67cd17953af78db7c8206b54","username":"ScriptDAILY","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67cd17953af78db7c8206b54","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:44:24.495Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"698d11ba9a31e539421d850a","editBy":{"_id":"67cd17953af78db7c8206b54","username":"ScriptDAILY","status":"offline","id":"67cd17953af78db7c8206b54"},"message":"Create script","createdAt":"2026-02-11T23:33:14.911Z"}],"comments":[{"_id":"698d12871a5b2310132b491c","commentBy":{"_id":"68532877745af8377cfdc9cd","username":"rocketscript","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/f20ac847bc4fdfd0d6c802416d567200ded6a690c18341766968d546d51d8ebe.webp","original":"https://scriptblox.com/images/photo/68532877745af8377cfdc9cd-1756986805745.png"},"createdAt":"2025-06-18T20:58:31.588Z","lastActive":"2026-06-06T18:06:55.490Z","status":"offline","id":"68532877745af8377cfdc9cd","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/f20ac847bc4fdfd0d6c802416d567200ded6a690c18341766968d546d51d8ebe.webp","original":"https://scriptblox.com/images/photo/68532877745af8377cfdc9cd-1756986805745.png"}},"text":"Holy ChatGPT is getting better at coding dang","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-11T23:36:39.410Z","liked":false,"disliked":false},{"_id":"698d4c3f839c20a317c41825","commentBy":{"_id":"67cd17953af78db7c8206b54","username":"ScriptDAILY","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-03-09T04:22:45.739Z","lastActive":"2026-05-02T03:47:05.682Z","status":"offline","id":"67cd17953af78db7c8206b54","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"@rocketscript No it was Gemini","parent":{"_id":"698d12871a5b2310132b491c","commentBy":{"_id":"68532877745af8377cfdc9cd","username":"rocketscript","profilePicture":"/images/photo/68532877745af8377cfdc9cd-1756986805745.png","status":"offline","id":"68532877745af8377cfdc9cd"},"text":"Holy ChatGPT is getting better at coding dang"},"edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-02-12T03:42:55.331Z","liked":false,"disliked":false}]}