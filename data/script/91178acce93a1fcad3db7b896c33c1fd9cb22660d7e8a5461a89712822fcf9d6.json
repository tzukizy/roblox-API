wer:FireServer(\"OpScriptsOnTop\")\n                task.wait()\n            end\n        end)\n    end\nend)","owner":{"_id":"683aa0380f380c18ee525781","username":"scripter132","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"683aa0380f380c18ee525781","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":2641,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/0681185aff55b3a46ec270d4cbc7b7f588d84cfc02439984f08cf0d98dd107cc.webp","original":"https://scriptblox.com/images/sb/rbx-bd74ca403179467a5571efbf65742865-af46ccfe36a3.png","scriptblox":"https://scriptblox.com/images/script/rbx-bd74ca403179467a5571efbf65742865-af46ccfe36a3.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-16T07:21:47.665Z","editBy":{"_id":"683aa0380f380c18ee525781","username":"scripter132","status":"offline","id":"683aa0380f380c18ee525781"},"keyLink":"","executes":83,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:48:26.350Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/0681185aff55b3a46ec270d4cbc7b7f588d84cfc02439984f08cf0d98dd107cc.webp","original":"https://scriptblox.com/images/sb/rbx-bd74ca403179467a5571efbf65742865-af46ccfe36a3.png","scriptblox":"https://scriptblox.com/images/script/rbx-bd74ca403179467a5571efbf65742865-af46ccfe36a3.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f09d0b74b9fc7514ac7f8d","editBy":{"_id":"683aa0380f380c18ee525781","username":"scripter132","status":"offline","id":"683aa0380f380c18ee525781"},"message":"Create script","createdAt":"2025-10-16T07:21:47.670Z"},{"_id":"68f09efb74b9fc7514acc8f2","editBy":{"_id":"683aa0380f380c18ee525781