{"slug":"The-Zombie's-Revenge-v5.66-Gun-Modifications-238893","_id":"6a3a56c631fbd3adf3e88c37","title":"Gun Modifications","game":{"_id":"6a36ca2b6d8d34f61825b593","gameId":7410285033,"name":"The Zombie's Revenge v26.4.1","imageUrl":"/images/sb/rbx-09b738e231199e8efdb64b19d8355aa3-9c9c5e3a056b.png","placeId":7410285033},"features":"Gun Modifications","tags":[],"script":"local PlayersService = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal LocalPlayer = PlayersService.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nLocalPlayer.CharacterAdded:Connect(function(NewCharacter)\n\tCharacter = NewCharacter\nend)\n\nRunService.RenderStepped:Connect(function()\n\tif not Character then\n\t\treturn\n\tend\n\tlocal Tool = Character:FindFirstChildWhichIsA(\"Tool\")\n\tif not Tool then\n\t\treturn\n\tend\n\tif not Tool:FindFirstChild(\"GunScript_Local\") or not Tool:FindFirstChild(\"Setting\") then\n\t\treturn\n\tend\n\n\tlocal Stats = require(Tool.Setting)\n\n\t-- Ammo\n\tStats.MaxAmmo = 10000\n\tStats.Ammo = 10000\n\tStats.AmmoPerMag = 10000\n\tStats.MaxCount = 10000\n\t-- Bullet\n\tStats.Recoil = 0\n\tStats.Spread = 0\n\tStats.DropVelocity = 0\n\tStats.Velocity = 100000\n\tStats.BulletSpeed = 100000\n\tStats.BulletShellVelocity = 100000\n\tStats.ZeroDamageDistance = 100000\n\tStats.FullDamageDistance = 100000\n\tStats.Range = 100000\n\t-- Gun\n\tStats.Auto = true\n\tStats.FireRate = 0.05\n\tStats.ReloadTime = 0.1\n\tStats.ReloadAnimationSpeed = 0.1\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":2745,"scriptType":"free","isUniversal":false,"isPatched":false,"vi