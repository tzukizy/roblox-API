{"slug":"Universal-Script-2020-Vibrant-Colors-Lighting-65406","_id":"691485236cfefaccfa0ddcf7","title":"2020 Vibrant Colors Lighting","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"change the lighting to vibrant  2020 colors","tags":[],"script":"local Lighting = game:GetService(\"Lighting\")\n\n-- 1. Color Correction Settings\nLighting.ColorCorrection.TintColor = Color3.new(255/255, 192/255, 183/255) \n\nLighting.ColorCorrection.Saturation = 0.5\nLighting.ColorCorrection.Contrast = 0.1\n\nLighting.ColorCorrection.Brightness = 0.1 \n\n-- 2. Sky Color and Outdoor Lighting\nLighting.OutdoorAmbient = Color3.new(255/255, 240/255, 180/255) \nLighting.Ambient = Color3.new(150/255, 140/255, 130/255)\n\n-- 3. Adjusting the Sky's Horizon Color\nlocal Sky = Lighting:FindFirstChild(\"Sky\")\n\nif Sky then\n    Sky.HorizonColor3 = Color3.new(255/255, 255/255, 0/255)\n    \n    Sky.ZenithColor3 = Color3.new(255/255, 255/255, 200/255)\nend\n\nprint(\"Indie Aesthetic Lighting Filter Applied!\")\n\n","owner":{"_id":"68357f88ac1935f24d6bb8ca","username":"castledot123","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/574b06c737bfacaf22b7627a040bcd53f54e2b5065a6bdb2e4e25d963edab076.webp","original":"https://scriptblox.com/images/photo/68357f88ac1935f24d6bb8ca-1790164363423.jpeg"},"status":"offline","id":"68357f88ac1935f24d6bb8ca","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/574b06c737bfacaf22b7627a040bcd53f54e2b5065a6bdb2e4e25d963edab076.webp","original":"https://scriptblox.com/images/photo/68357f88ac1935f24d6bb8ca-1790164363423.jpeg"}},"verified":false,"views":774,"scriptType":"free","isUniversal":true,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/591c8e1