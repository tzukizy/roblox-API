{"slug":"Grace-godmode-23655","_id":"674e99dbb1a92aa1e95fb9f7","title":"godmode and levers","game":{"_id":"67e5e1ffb360710ec3c77fc0","gameId":138837502355157,"name":"Grace [GRACE BUT EVIL]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":138837502355157},"features":"lowkey dont use this","tags":[],"script":"workspace.DescendantAdded:Connect(function(descendant)\n    if descendant:IsA(\"ParticleEmitter\") then\n        descendant.Rate = descendant.Rate * 10 -- line of code i added for low-graphics players to see the red(blood) rain\n    end\nend)\n\nworkspace.DescendantAdded:Connect(function(descendant)\n    if descendant.Name == \"base\" and descendant:IsA(\"BasePart\") then\n        local player = game.Players.LocalPlayer\n        if player and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            descendant.Position = player.Character.HumanoidRootPart.Position\n\n            game.StarterGui:SetCore(\"SendNotification\", { -- cosmetic\n                Title = \"levers moved\",\n                Text = \"door has been opened\",\n                Duration = 3\n            })\n        end\n    end\nend)\n\nworkspace.DescendantAdded:Connect(function(descendant)\n    if descendant.Name == \"eye\" or descendant.Name == \"elkman\" or descendant.Name == \"Rush\" or descendant.Name == \"Worm\" or descendant.Name == \"eyePrime\" then\n        descendant:Destroy() -- makes u invincible to these entities since they're all clientsided\n    end\nend)\n\nlocal players = game:GetService(\"Players\")\nlocal localPlayer = players.LocalPlayer\n\nwhile true do\n    local eyeGui = localPlayer:FindFirstChild(\"PlayerGui\"):FindFirstChild(\"eyegui\")\n    if eyeGui then\n        eyeGui:Destroy() -- deletes the eyeparasites (literally makes you invincible even if u get hit + removes distractions)\n    end\n    task.wait(0.1)\nend\n\nwhile true do\n    local smileGui = localPlayer:FindFirstChild(\"PlayerGui\"):FindFirstChild(\"smilegui\")\n    if smileGui then\n        smileGui:Destroy() --if it wasnt for the fact that carnation gets deleted this would give you a big boost because it still slows him down\n    end\n    task.wait(0.1)\nend\n\nwhile true do\n    local FUNNYGOATMAN = localPlayer:FindFirstChild(\"PlayerGui\"):FindFirstChild(\"GOATPORT\")\n    if FUNNYGOATMAN then\n        FUNNYGOATMAN:Destroy() --doesnt work yet\n    end\n    task.wait(0.1)\nend\n","owner":{"_id":"6567d428d1d4fcc09144432a","username":"hellomrworld","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6567d428d1d4fcc09144432a","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":35470,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-12-03T05:40:43.817Z","dislikeCount":0,"likeCount":4,"image":{"url":"https://cdn.kocakz.me/images/8befdf9b288b528dd3433da19430e84322c8d49c6c379c4c395e95be896aa785.webp","original":"https://scriptblox.com/images/sb/138837502355157-1733204443750.png","scriptblox":"https://scriptblox.com/images/script/138837502355157-1733204443750.png"},"executes":66,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:12:31.869Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/8befdf9b288b528dd3433da19430e84322c8d49c6c379c4c395e95be896aa785.webp","original":"https://scriptblox.com/images/sb/138837502355157-1733204443750.png","scriptblox":"https://scriptblox.com/images/script/138837502355157-1733204443750.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d25c","editBy