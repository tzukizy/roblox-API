,{\"Home\",\"hud\",\"GunFrame\"},{\"Magazine\"});\n\n            if Data.Magazine and Data.Magazine.Text:match(\"^0/%d+$\") then\n                keypress(0x52); task.wait(0.15); keyrelease(0x52); -- // Executor built in (Undetected).\n\n                -- KeyP(0x52); task.wait(0.15); KeyR(0x52); -- // Fallback. Uses VirtualInputManager (⚠️ Can be detected in some games).\n                shared.SetLabel(true); -- // Updates the Reload label (Dont Touch).\n            else\n                shared.SetLabel(false); -- // (Dont Touch).\n            end\n        end,\n    --]]\n\n    -- // Universal Example:\n        [\"AimbotNpcs\"] = {Supported = {workspace}, -- // Npc Path/s.\n            Whitelist = {\"1\",\"2\",\"3\"}, -- // Names can be shortened aswell.\n            DeepCheck = (true), -- // Deepcheck smarter scans for Npcs (Slightly Fps Drops).\n        },\n    }\n};\n\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/FlamesW/Kaori6/home/Aimbot.exe\"))();","owner":{"_id":"6862e096079468cfffa0592a","username":"FlamZ","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/2b1f85bbd59d715295ea941d69171a0d0245d40c2cdeafd12d4ca5c4c4b73eb0.webp","original":"https://scriptblox.com/images/photo/6862e096079468cfffa0592a-1751310713750.png"},"status":"offline","id":"6862e096079468cfffa0592a","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/2b1f85bbd59d715295ea941d69171a0d0245d40c2cdeafd12d4ca5c4c4b73eb0.webp","original":"https://scriptblox.com/images/photo/6862e096079468cfffa0592a-1751310713750.png"}},"verified":false,"views":16475,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/51b859e44ddd6e1e74f55495cb4314aff7850c2ec712f28562ea66524c4b4389.webp","original":"https://scriptblox.com/images/sb/0-1760200565348.png","scriptblox":"https://scriptblox.com/images/script/0-1760200565348.png"},"likeCount":10,"dislikeCount":3,"crea