.Character)\n                    hl.Name = 'esp'\n                    hl.OutlineColor = Color3.new(1,0,0)\n                    hl.FillTransparency = 1\n                else\n                    hl = Instance.new(\"Highlight\", v.Character)\n                    hl.Name = 'esp'\n                    hl.OutlineColor = Color3.new(0,1,0)\n                    hl.FillTransparency = 1\n                end\n            end\n        end)\n    end\n    wait()\nend\nwait()\nfor _, v in pairs(players:GetChildren()) do\n    if v.Character:FindFirstChild('esp') then\n        v.Character:FindFirstChild('esp'):Destroy()\n    end\nend","features":"Esps players.\nGreen - normal players\nRed - IT","tags":["esp","hide","seek","hide and seek","open source"],"discord":"","keyLink":"","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"},"status":"offline","id":"64cde94eedb1b218a6931bfe","profile":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:59:47.666Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c506e3","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Create script","createdAt":"2025-03-27T16:11:33.669Z"}],"comments":[]}