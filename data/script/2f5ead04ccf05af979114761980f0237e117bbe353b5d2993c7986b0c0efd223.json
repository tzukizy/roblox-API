highlight = Instance.new(\"Highlight\")\n\t\t\thighlight.Name = \"AutoHighlight\"\n\t\t\thighlight.FillColor = Color3.fromRGB(255, 255, 0) -- yellow (change if you want)\n\t\t\thighlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n\t\t\thighlight.Parent = model\n\t\tend\n\tend\nend\n\nfor _, obj in ipairs(workspace:GetDescendants()) do\n\tensureHighlight(obj)\nend\n\nworkspace.DescendantAdded:Connect(function(obj)\n\tensureHighlight(obj)\nend)\n\nworkspace.DescendantRemoving:Connect(function(obj)\n\tif obj:IsA(\"Highlight\") and obj.Parent and obj.Parent.Name == \"Male\" then\n\t\ttask.wait() -- wait a frame so removal completes\n\t\tif obj.Parent then\n\t\t\tensureHighlight(obj.Parent)\n\t\tend\n\tend\nend)","features":"ESP \n\nFeedback is Appreciated","tags":[],"discord":"","keyLink":"","owner":{"_id":"6811c99f3ddfe7f175c23232","username":"poophead05016","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6811c99f3ddfe7f175c23232","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:40:09.461Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69cf8fae36c577dfd789e99c","editBy":{"_id":"6811c99f3ddfe7f175c23232","username":"poophead05016","status":"offline","id":"6811c99f3ddfe7f175c23232"},"message":"Create script","createdAt":"2026-04-03T10:00:14.338Z"}],"comments":[{"_id":"69d9fe0e3d19a93ddb0a17e4","commentBy":{"_id":"69d9fdb2683cd34b92693dec","username":"cuteaww4","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-05-09T04:48:09.996Z","createdAt":"2026-04-11T07:52:18.560Z","status":"offline","id":"69