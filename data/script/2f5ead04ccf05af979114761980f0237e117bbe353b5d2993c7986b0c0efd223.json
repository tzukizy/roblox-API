{"slug":"Blackhawk-Rescue-Mission-5-Player-ESP-Works-for-NPCs-177985","_id":"69cf8fae36c577dfd789e999","title":"Player ESP Works for NPCs","game":{"_id":"67e5e1ffb360710ec3c7864c","gameId":2916899287,"name":"Blackhawk Rescue Mission 5","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":2916899287},"features":"ESP \n\nFeedback is Appreciated","tags":[],"script":"local function ensureHighlight(model)\n\tif model:IsA(\"Model\") and model.Name == \"Male\" then\n\t\tlocal highlight = model:FindFirstChildOfClass(\"Highlight\")\n\t\t\n\t\tif not highlight then\n\t\t\t-- Create new Highlight\n\t\t\thighlight = Instance.new(\"Highlight\")\n\t\t\thighlight.Name = \"AutoHighlight\"\n\t\t\thighlight.FillColor = Color3.fromRGB(255, 255, 0) -- yellow (change if you want)\n\t\t\thighlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n\t\t\thighlight.Parent = model\n\t\tend\n\tend\nend\n\nfor _, obj in ipairs(workspace:GetDescendants()) do\n\tensureHighlight(obj)\nend\n\nworkspace.DescendantAdded:Connect(function(obj)\n\tensureHighlight(obj)\nend)\n\nworkspace.DescendantRemoving:Connect(function(obj)\n\tif obj:IsA(\"Highlight\") and obj.Parent and obj.Parent.Name == \"Male\" then\n\t\ttask.wait() -- wait a frame so removal completes\n\t\tif obj.Parent then\n\t\t\tensureHighlight(obj.Parent)\n\t\tend\n\tend\nend)","owner":{"_id":"6811c99f3ddfe7f175c23232","username":"poophead05016","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6811c99f3ddfe7f175c23232","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":2933,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/3eef60d5d8dad82ac3ac914add12580790ddd7218d8c2d