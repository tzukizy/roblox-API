{"slug":"Knockout!-Knockout-script-140636","_id":"69b607ac14086e93ef5324a7","title":"Knockout script","game":{"_id":"6975a3066fe269b3ef31bc8e","gameId":136764190843219,"name":"[🎪] Knockout! 🐧","imageUrl":"/images/sb/rbx-152a83c0bc4a22f667e0a4d5f7e51c98-f10d5705733a.png","placeId":136764190843219},"features":"Knockout script","tags":["knockout","keyless"],"script":"-- Reference to ReplicatedStorage and Arrow model\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal arrowTemplate = ReplicatedStorage:WaitForChild(\"Arrow\")\n\n-- Function to create and shoot an arrow\nlocal function shootArrow(origin, direction)\n  local arrow = arrowTemplate:Clone()\n  arrow.CFrame = CFrame.new(origin, origin + direction)\n  arrow.Parent = workspace\n\n  -- Make the arrow move forward\n  local speed = 100\n  local velocity = direction.Unit * speed\n  local bodyVelocity = Instance.new(\"BodyVelocity\")\n  bodyVelocity.Velocity = velocity\n  bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)\n  bodyVelocity.Parent = arrow\n\n  -- Clean up after 5 seconds\n  game.Debris:AddItem(arrow, 5)\nend\n\n-- Connect to input or shooting event (example with Mouse Button 1)\nlocal mouse = player:GetMouse()\nmouse.Button1Down:Connect(function()\n  local character = player.Character\n  if character then\n    local head = character:FindFirstChild(\"Head\") or character:FindFirstChild(\"HumanoidRootPart\")\n    if head then\n      local origin = head.Position\n      local direction = (mouse.Hit.p - origin).Unit\n      shootArrow(origin, direction)\n    end\n  end\nend)","owner":{"_id":"69764b2192a4802284a2a891","username":"Cj_scripter","verified":false,"profilePicture":"/images/photo/69764b2192a4802284a2a891-1773540058627.png","status":"offline","id":"69764b2192a4802284a2a891","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1866,"scriptType":"free","isUniversal":false,"