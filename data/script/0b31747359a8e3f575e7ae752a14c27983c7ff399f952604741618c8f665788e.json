n-- Create 100 random UI elements\nfor i = 1, 100 do\n\tlocal uiType = uiTypes[math.random(1, #uiTypes)]\n\tlocal element = Instance.new(uiType)\n\t\n\telement.Size = UDim2.new(0, math.random(40, 100), 0, math.random(20, 60))\n\telement.Position = UDim2.new(0, math.random(0, 800), 0, math.random(0, 500))\n\telement.BackgroundColor3 = randomColor()\n\telement.TextColor3 = randomColor()\n\telement.Text = randomText()\n\telement.Font = Enum.Font.SourceSans\n\telement.TextSize = 14\n\telement.Parent = gui\n\n\tif uiType == \"TextBox\" then\n\t\telement.ClearTextOnFocus = false\n\tend\n\n\t-- Optional: Make some buttons do random actions\n\tif uiType == \"TextButton\" then\n\t\telement.MouseButton1Click:Connect(function()\n\t\t\telement.Text = randomText()\n\t\t\telement.BackgroundColor3 = randomColor()\n\t\tend)\n\tend\nend","features":"Wtf is this werid ass shit","tags":[],"discord":"","keyLink":"","owner":{"_id":"67e9e4d33141ef8b74523ae3","username":"gp79","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67e9e4d33141ef8b74523ae3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:51:31.393Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"686886a4079468cfff7205ae","editBy":{"_id":"67e9e4d33141ef8b74523ae3","username":"gp79","status":"offline","id":"67e9e4d33141ef8b74523ae3"},"message":"Create script","createdAt":"2025-07-05T01:57:56.543Z"}],"comments":[{"_id":"6868964cee47165092afa0e7","commentBy":{"_id":"67a5b58f03e9aa476e839291","username":"zxcv","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/19c2de0dbe0b9f098012ef59c77f167fed6c35cad98e270198769e6