{"slug":"Universal-Script-Universal-Sword-reach-7331","_id":"64e42c36745e83246e2d9489","title":"Universal Sword reach","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"it makes a swords hitbox bigger.. idk who made it so credits to whoever made it, it also auto clicks when near players so u dont gotta click, it activates when ur like in a 15 stud radius of the player","tags":["Sword reach","Reach","reach","sword reach","Sword ai"],"script":"-- == [[ setting ]] == --\nlocal range = 15\n\n-- == [[ vars ]] == --\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\n\n-- == [[ logic ]] == --\nRunService.RenderStepped:Connect(function()\n    local myChar = player.Character\n    local myHRP = myChar and myChar:FindFirstChild(\"HumanoidRootPart\")\n    if not myHRP then return end\n\n    local tool = myChar:FindFirstChildOfClass(\"Tool\")\n    local handle = tool and tool:FindFirstChild(\"Handle\")\n    if not handle then return end\n\n    for _, plr in ipairs(Players:GetPlayers()) do\n        if plr ~= player then\n            local char = plr.Character\n            local hum = char and char:FindFirstChild(\"Humanoid\")\n            local hrp = char and char:FindFirstChild(\"HumanoidRootPart\")\n\n            if hum and hum.Health > 0 and hrp then\n                local dist = (myHRP.Position - hrp.Position).Magnitude\n                if dist <= range then\n                    tool:Activate()\n                    for _, part in ipairs(char:GetChildren()) do\n                        if part:IsA(\"BasePart\") then\n                            firetouchinterest(handle, part, 0)\n                            firetouchinterest(handle, part, 1)\n                        end\n                    end\n\n                end\n            end\n        end\n    end\nend)\n","owner":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/dff992f3b597b4c5a71ec2a7da6f4ebcce82c9821430857ce7612e65e998ec53.webp","original":"https://scriptblox.com/images/photo/64e42935e38cad1498824223-1779702017984.jpg"},"lvl":12,"status":"offline","id":"64e42935e38cad1498824223","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/dff992f3b597b4c5a71ec2a7da6f4ebcce82c9821430857ce7612e65e998ec53.webp","original":"https://scriptblox.com/images/photo/64e42935e38cad1498824223-1779702017984.jpg"}},"verified":false,"keyLink":"","views":78887,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-08-22T03:32:06.395Z","dislikeCount":4,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/651e6ee954902795b628964f0489bfad2e374f2916bd76a71961d63c1e1d95c4.webp","original":"https://scriptblox.com/images/sb/0-1762994711416.jpg","scriptblox":"https://scriptblox.com/images/script/0-1762994711416.jpg"},"editBy":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","status":"offline","id":"64e42935e38cad1498824223"},"executes":561,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:24:18.056Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/651e6ee954902795b628964f0489bfad2e374f2916bd76a71961d63c1e1d95c4.webp","original":"https://scriptblox.com/images/sb/0-1762994711416.jpg","scriptblox":"https://scriptblox.com/images/script/0-1762994711416.jpg"},"changelog":[{"_id":"67e5e1e4b360710ec3c4f7c9","editBy":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","status":"offline","id":"64e42935e38cad1498824223"},"message":"Create script","createdAt":