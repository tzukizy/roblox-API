{"slug":"Universal-Script-teleport-to-random-player-and-instantly-go-back-14579","_id":"6679300f90a7a540ecfc9323","title":"teleport to random player and instantly go back","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"useful for bypassing bad anti-teleport scripts","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal TeleportService = game:GetService(\"TeleportService\")\n\nlocal function teleportToRandomPlayer()\n    local players = Players:GetPlayers()\n    if #players < 2 then\n        warn(\"Not enough players to teleport\")\n        return\n    end\n\n    local randomPlayer\n    repeat\n        randomPlayer = players[math.random(1, #players)]\n    until randomPlayer ~= LocalPlayer\n\n    local originalPosition = LocalPlayer.Character.HumanoidRootPart.CFrame\n    LocalPlayer.Character.HumanoidRootPart.CFrame = randomPlayer.Character.HumanoidRootPart.CFrame\n\n    wait(0.1)  -- The time after which we returned to our starting position.\n\n    LocalPlayer.Character.HumanoidRootPart.CFrame = originalPosition\nend\n\nteleportToRandomPlayer()\n","owner":{"_id":"6305c918297097657ce6f6c9","username":"trellurr","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6305c918297097657ce6f6c9","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":6798,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-06-24T08:36:31.964Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/7c4979b4712298bf4e2666c2aca81e04be099837b4cbc3d4d2df916698c92901.webp","