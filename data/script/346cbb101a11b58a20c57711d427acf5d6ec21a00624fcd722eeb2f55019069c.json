{"_id":"67237cc6645d8a4735934a88","title":"Hitbox Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/ba7d76cc1e3a2f6fd7e9694f384de48a0cc661df13983847c7b0ebd159ae2293.webp","original":"https://scriptblox.com/images/sb/9987654-1730378950021.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/ba7d76cc1e3a2f6fd7e9694f384de48a0cc661df13983847c7b0ebd159ae2293.webp","original":"https://scriptblox.com/images/sb/9987654-1730378950021.png"},"placeId":0},"slug":"Universal-Script-Hitbox-Scripy-21380","verified":false,"key":false,"keyless":false,"views":10326,"executes":54,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/907b5a9587ac91ecd2444d3e430e821e4d28fc27d02038503e234798cdaedbfa.webp","original":"https://scriptblox.com/images/sb/9987654-1730378950021.png","scriptblox":"https://scriptblox.com/images/script/9987654-1730378950021.png"},"thumbnail":{"url":"https://media.kocakz.me/907b5a9587ac91ecd2444d3e430e821e4d28fc27d02038503e234798cdaedbfa.webp","original":"https://scriptblox.com/images/sb/9987654-1730378950021.png","scriptblox":"https://scriptblox.com/images/script/9987654-1730378950021.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-10-31T12:49:10.073Z","updatedAt":"2024-10-31T12:49:10.073Z","lastBump":"2024-10-31T12:49:10.073Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal newSize = 10 -- Hitbox Size!\n\nlocal function ChangeHitboxSize(size)\n    for _, player in pairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local HumanoidRootPart = player.Character.HumanoidRootPart\n            local newHitboxSize = Vector3.new(size, size, size)\n            HumanoidRootPart.Size = newHitboxSize\n            HumanoidRootPart.Transparency = 0.5\n            HumanoidRootPart.CanCollide = false\n\n            local hue = 0\n            RunService.RenderStepped:Connect(function()\n                hue = (hue + 0.01) % 1\n                HumanoidRootPart.Color = Color3.fromHSV(hue, 1, 1)\n            end)\n        end\n    end\nend\n\nwhile true do\n    ChangeHitboxSize(newSize)\n    wait(5)\nend","features":"Made by Ai\nChanges the hitbox of a player","tags":[],"discord":"","keyLink":"","owner":{"_id":"667dae3802cf206b2342a005","username":"User_Creation","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"667dae3802cf206b2342a005","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:13:01.270Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52c4e","editBy":{"_id":"667dae3802cf206b2342a005","username":"User_Creation","status":"offline","id":"667dae3802cf206b2342a005"},"message":"Create script","createdAt":"2025-03-27T19:22:06.040Z"}],"comments":[{"_id":"67237d4a11dc05d6126fec14","commentBy":{"_id":"667dae3802cf206b2342a005","username":"User_Creation","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-06-27T18:23:52.145Z","lastActive":"2024-11-03T13:24:27.120Z","status":"offline","id":"667dae3802cf206b2342a005","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Edit -- Missed spelled Script to Scripy💀","createdAt":"2024-10-31T12:51:22.474Z","edit