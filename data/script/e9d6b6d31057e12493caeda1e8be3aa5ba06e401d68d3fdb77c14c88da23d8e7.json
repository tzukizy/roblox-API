{"slug":"Forsaken-noli-void-rush-controller-229647","_id":"6ab5b3ff459b35fdd7e0c3af","title":"noli void rush controller","game":{"_id":"67e5e1ffb360710ec3c77d16","gameId":18687417158,"name":"Forsaken","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":18687417158},"features":"how to use:\n# be the killer in a round\n# have noli equipped\n# use void rush ability\n- you will notice its way easier to turn\n\nhow to disable:\n# execute the script again","tags":["forsaken script","noli","void rush control","void rush"],"script":"_G.VoidRushController = not _G.VoidRushController\nlocal NoliConfig = require(game:GetService(\"ReplicatedStorage\").Assets.Killers.Noli.Config)\nif not _G.VoidRushVarsSetup then\n    _G.VoidRushInitialTurnDur = NoliConfig.VoidRushInitialTurnDuration\n    _G.VoidRushInitialTurnMult = NoliConfig.VoidRushInitialTurnMult\n    _G.VoidRushVarsSetup = true\nend\n\nfor _, v in getgc(true) do\n    if type(v) == \"table\" and rawget(v, \"VoidRushInitialTurnDuration\") then\n        if _G.VoidRushController then\n            rawset(v, \"VoidRushInitialTurnDuration\", 9999)\n            rawset(v, \"VoidRushInitialTurnMult\", 9999)\n        else\n            rawset(v, \"VoidRushInitialTurnDuration\", _G.VoidRushInitialTurnDur)\n            rawset(v, \"VoidRushInitialTurnMult\", _G.VoidRushInitialTurnMult)\n        end\n    end\nend\n\npcall(function()\n    game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\n        Title = \"Void Rush Controller\",\n        Text = _G.VoidRushController and \"Enabled\\nRun the script again to disable\" or \"Disabled\",\n        Duration = 3\n    })\nend)","owner":{"_id":"6a3cd78468095982f770201e","username":"forsakenUPLOADER","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6ccb0385a712c7ffe493f3a98efea546636a9485782896ad9c067f0c77322e20.webp","original":"https://scriptblox.com/images/photo