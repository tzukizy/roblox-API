o\n    if type(v) == \"table\" and rawget(v, \"VoidRushInitialTurnDuration\") then\n        if _G.VoidRushController then\n            rawset(v, \"VoidRushInitialTurnDuration\", 9999)\n            rawset(v, \"VoidRushInitialTurnMult\", 9999)\n        else\n            rawset(v, \"VoidRushInitialTurnDuration\", _G.VoidRushInitialTurnDur)\n            rawset(v, \"VoidRushInitialTurnMult\", _G.VoidRushInitialTurnMult)\n        end\n    end\nend\n\npcall(function()\n    game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\n        Title = \"Void Rush Controller\",\n        Text = _G.VoidRushController and \"Enabled\\nRun the script again to disable\" or \"Disabled\",\n        Duration = 3\n    })\nend)","features":"how to use:\n# be the killer in a round\n# have noli equipped\n# use void rush ability\n- you will notice its way easier to turn\n\nhow to disable:\n# execute the script again","tags":["forsaken script","noli","void rush control","void rush"],"discord":"https://discord.gg/rmneruazd","keyLink":"","owner":{"_id":"6a3cd78468095982f770201e","username":"forsakenUPLOADER","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6ccb0385a712c7ffe493f3a98efea546636a9485782896ad9c067f0c77322e20.webp","original":"https://scriptblox.com/images/photo/6a3cd78468095982f770201e-1788914156701.png"},"lvl":9,"status":"offline","id":"6a3cd78468095982f770201e","leaderboard":{"tag":null},"topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/6ccb0385a712c7ffe493f3a98efea546636a9485782896ad9c067f0c77322e20.webp","original":"https://scriptblox.com/images/photo/6a3cd78468095982f770201e-1788914156701.png"}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-25T23:15:43.851Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026