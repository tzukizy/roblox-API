unction to replace\" .. debug.getinfo(old).name .. \"with\" .. debug.getinfo(new).name .. \"!\")\n  end\n  return hf1(print, print)\nend))\n\nhf2 = hookfunc(clonefunction, newcclosure(function(func)\n  if debug.getinfo(func).name == \"hookfunction\" then\n    print(\"DENIED, Attempt to bypass restrictions on hookfunction by using clonefunction!\")\n    return hf2(print)\n  end\n  return hf2(func)\nend), \"1\")\n\nhookfunction(print, warn)\n","features":"usage : hookfunction(print, warn, \"1\")\n\nmade it so clonefunction cant bypass restrictions","tags":["hookfunction","clonefunction"],"discord":"","keyLink":"","owner":{"_id":"6678169b794e634f0700eaa2","username":"UnnesscaryInventions","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b4f7417ef8e37d71c75b66ea5026724eba78d2adbdf20015022a9e1673e7dfd2.webp","original":"https://scriptblox.com/images/photo/6678169b794e634f0700eaa2-1719146257838.jpg"},"status":"offline","id":"6678169b794e634f0700eaa2","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/b4f7417ef8e37d71c75b66ea5026724eba78d2adbdf20015022a9e1673e7dfd2.webp","original":"https://scriptblox.com/images/photo/6678169b794e634f0700eaa2-1719146257838.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:17:28.683Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52a65","editBy":{"_id":"6678169b794e634f0700eaa2","username":"UnnesscaryInventions","status":"offline","id":"6678169b794e634f0700eaa2"},"message":"Create script","createdAt":"2025-03-27T14:41:17.894Z"}],"comments":[{"_id":"6719a548ace85d7a368f8cb5","commentBy":{"_id":"6678169b794e634f0700eaa2","username":"UnnesscaryInventions","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b4f7417ef8e37d71c75b66ea5026724eba78d2