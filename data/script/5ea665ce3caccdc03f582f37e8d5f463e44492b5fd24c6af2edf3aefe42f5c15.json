{"slug":"CHAOS-EVENT-VOID-KICK-Script-25937","_id":"6777b97ab19eb392c8d2d026","title":"VOID KICK Script","game":{"_id":"67e5e1ffb360710ec3c77e6c","gameId":6441847031,"name":"CHAOS [EVENT]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":6441847031},"features":"Run this script while carrying a player and itll void/kick them","tags":["chaos","void","kick","kick players"],"script":"\n-- HIT THE SELECTED KEYBIND WHILE CARRYING SMN TO VOID/KICK THEM\n\nlocal bool = true\nif bool then\n    game.Workspace.FallenPartsDestroyHeight = 0 / 0\nelse\n    game.Workspace.FallenPartsDestroyHeight = -500\nend\n\nlocal keybind = Enum.KeyCode.F -- feel free to change, I recommend F as it's the default carry keybind\n\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if input.KeyCode == keybind and not gameProcessed and not UserInputService:GetFocusedTextBox() then\n        wait(0.3)\n        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-989889989898989, -989879898998988, -98999898989899898)\n        wait(0.3)\n        game.Players.LocalPlayer.Character.Humanoid.Health = 0\n    end\nend)\n","owner":{"_id":"67284f6ddbc4a4fe8769d9ae","username":"ii_dino122","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67284f6ddbc4a4fe8769d9ae","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":12841,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-03T10:18:34.103Z","dislikeCount":2,"likeCount":1,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-c5e48a25f6ca58c725a5bc150101aa26/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-c5e48a25f6ca58c725a5bc150101aa26/500/280/Image/Jpeg/noFilter"},"executes":407,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:14:24.267Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-c5e48a25f6ca58c725a5bc150101aa26/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-c5e48a25f6ca58c725a5bc150101aa26/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d54a","editBy":{"_id":"67284f6ddbc4a4fe8769d9ae","username":"ii_dino122","status":"offline","id":"67284f6ddbc4a4fe8769d9ae"},"message":"Create script","createdAt":"2025-02-17T20:18:40.451Z"},{"_id":"67e5e1e6b360710ec3c53e91","editBy":{"_id":"67284f6ddbc4a4fe8769d9ae","username":"ii_dino122","status":"offline","id":"67284f6ddbc4a4fe8769d9ae"},"message":"Update script","createdAt":"2025-03-27T22:39:09.382Z"}],"comments":[{"_id":"680674a18a886f65e31cde68","commentBy":{"_id":"680329906b416f0679da4c24","username":"Vinceat419","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-04-19T04:41:52.123Z","lastActive":"2025-04-30T05:23:31.202Z","status":"offline","id":"680329906b416f0679da4c24","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Did this and got called the n word. 10/10","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-04-21T16:38:57.680Z","liked":false,"disliked":false}]}