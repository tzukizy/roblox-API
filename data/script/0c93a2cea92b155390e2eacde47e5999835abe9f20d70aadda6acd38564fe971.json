เล่นทันที\nif game.PlaceId ~= TARGET_PLACE_ID then\n    Players.LocalPlayer:Kick(\"Incorrect Place ID!\")\n    return\nend\n\n-- ส่งการแจ้งเตือนแสดงชื่อผู้สร้าง\nStarterGui:SetCore(\"SendNotification\", {\n    Title = \"Maker98574\";\n    Text = \"Inf health applied...\";\n    Duration = 5;\n})\n\n-- รัน Loop ส่ง Event ใน Background\ntask.spawn(function()\n    local damageEvent = ReplicatedStorage:WaitForChild(\"Events\"):WaitForChild(\"Damage\")\n    \n    while task.wait(0.5) do\n        local args = {\n            -math.huge\n        }\n        damageEvent:FireServer(unpack(args))\n    end\nend)\n\nprint(\"Script executed successfully. Created by Maker98574\")\n","features":"Make yourself immortal; there are no keys","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a0c65c0011dead17f27219c","username":"onarchawee","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4444dd555b7ef2fb051934c999beb13b030ba69b6d36b99259e26ff3223f4e28.webp","original":"https://scriptblox.com/images/photo/6a0c65c0011dead17f27219c-1792524704807.jpg"},"lvl":8,"status":"offline","id":"6a0c65c0011dead17f27219c","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/4444dd555b7ef2fb051934c999beb13b030ba69b6d36b99259e26ff3223f4e28.webp","original":"https://scriptblox.com/images/photo/6a0c65c0011dead17f27219c-1792524704807.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:29:21.520Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a79cde6238b82285d243ada","editBy":{"_id":"6a0c65c0011dead17f27219c","username":"onarchawee","status":"offline","id":"6a0c65c0011dead17f27219c"},"message":"Create script","createdAt":"2026-08-10T13:11:02.960Z"}],"comments":[]}