{"_id":"6ad5fdbd05234e758c9de061","title":"noclip works for any game","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/87dbb95f24a01ff3ad2a16406ecc33c644af3384c9f51b9914c383a9b46b5697.webp","original":"https://scriptblox.com/images/sb/0-1792409021946.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/87dbb95f24a01ff3ad2a16406ecc33c644af3384c9f51b9914c383a9b46b5697.webp","original":"https://scriptblox.com/images/sb/0-1792409021946.jpg"},"placeId":0},"slug":"Universal-Script-noclip-works-for-any-game-232539","verified":false,"key":false,"keyless":false,"views":795,"executes":625,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/be72f14522ff7aaf834f7a96d3c2641340c87d9bb80a871ae95e47bd67ebd402.webp","original":"https://scriptblox.com/images/sb/0-1792409021946.jpg","scriptblox":"https://scriptblox.com/images/script/0-1792409021946.jpg"},"thumbnail":{"url":"https://media.kocakz.me/be72f14522ff7aaf834f7a96d3c2641340c87d9bb80a871ae95e47bd67ebd402.webp","original":"https://scriptblox.com/images/sb/0-1792409021946.jpg","scriptblox":"https://scriptblox.com/images/script/0-1792409021946.jpg"},"likeCount":4,"dislikeCount":0,"createdAt":"2026-10-19T11:23:42.048Z","updatedAt":"2026-10-19T11:23:42.048Z","lastBump":"2026-10-19T11:23:42.048Z","script":"-- N Toggle Noclip\n-- Place in StarterPlayer > StarterPlayerScripts\n\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal noclipEnabled = false\n\nlocal function setNoclip(enabled)\n    noclipEnabled = enabled\n    print(\"Noclip: \" .. (enabled and \"ON\" or \"OFF\"))\nend\n\nUserInputService.InputBegan:Connect(function(input, processed)\n    if processed then return end\n\n    if input.KeyCode == Enum.KeyCode.N then\n        setNoclip(not noclipEnabled)\n    end\nend)\n\nRunService.Stepped:Connect(function()\n    if not noclipEnabled then return end\n\n    local character = player.Character\n    if not character then return end\n\n    for _, part in ipairs(character:GetDescendants()) do\n        if part:IsA(\"BasePart\") then\n            part.CanCollide = false\n        end\n    end\nend)\n\nplayer.CharacterAdded:Connect(function()\n    task.wait(0.5)\n    if noclipEnabled then\n        setNoclip(true)\n    end\nend)","features":"Noclip","tags":["works noclip"],"discord":"","keyLink":"","owner":{"_id":"6876639121d16f2acd1cd057","username":"DoorsScripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":8,"status":"offline","id":"6876639121d16f2acd1cd057","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-20T08:03:31.689Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T23:08:43.751Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ad5fdbe05234e758c9de063","editBy":{"_id":"6876639121d16f2acd1cd057","username":"DoorsScripter","status":"offline","id":"6876639121d16f2acd1cd057"},"message":"Create script","createdAt":"2026-10-19T11:23:42.050Z"}],"comments":[]}