{"slug":"DESCENT-Highlight-ESP-for-the-Monsters-12405","_id":"661ef4e2c9c3ae475f6689ca","title":"Highlight ESP for the Monsters","game":{"_id":"67e5e1ffb360710ec3c781c7","gameId":15428225119,"name":"DESCENT","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":15428225119},"features":"This highlights the monsters whenever a new one appears\nYou can execute it how many times you want. When you see nothing highlighted, that's because the monsters hasn't spawned yet\nYou also need to execute them every time you descent. Maybe?","tags":[],"script":"local function Fuckery()\n    local folder = game.Workspace:FindFirstChild(\"Mobs\")\n    if folder then\n        for _, object in ipairs(folder:GetChildren()) do\n            if object:IsA(\"Model\") then\n                if not object:FindFirstChild(\"Highlight\") then\n                    local highlight = Instance.new(\"Highlight\")\n                    highlight.FillColor = Color3.fromRGB(255, 255, 255)\n                    highlight.Parent = object\n                end\n            end\n        end\n    else\n        print(\"Folder not found!\")\n    end\nend\n\nFuckery()\n\nwhile true do\n    wait(2)\n    Fuckery()\nend\n","owner":{"_id":"654988435596c75b0c438d0a","username":"AladinSverkel","verified":false,"profilePicture":{"url":"https://media.kocakz.me/63a5e6059bd15d1b6529208e03666e7eb27161dc153f56e4bd219cd2d9a0b77e.webp","original":"https://scriptblox.com/images/photo/654988435596c75b0c438d0a-1713295462843.jpg"},"status":"offline","id":"654988435596c75b0c438d0a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/63a5e6059bd15d1b6529208e03666e7eb27161dc153f56e4bd219cd2d9a0b77e.webp","original":"https://scriptblox.com/images/photo/654988435596c75b0c438d0a-1713295462843.jpg"}},"verified":false,"keyLink":"","views":20403,"scriptType":"free","isUniversal":false,"isPatche