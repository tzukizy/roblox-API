{"_id":"6980ba7f9a31e53942603b3a","title":"Simpel Inf Mag Ammo","game":{"_id":"67e5e1ffb360710ec3c788cf","gameId":6788434697,"name":"AniPhobia","imageUrl":{"url":"https://media.kocakz.me/7088453cdab9ea9eacf731ab9e6feef5a5cac6b0469801f983de9d17c94aeb3f.webp","original":"https://tr.rbxcdn.com/180DAY-3f2d298cf383a99d3bbc7e745dabea75/150/150/Image/Png/noFilter"},"slug":"6788434697-aniphobia","path":"/game/6788434697-aniphobia","thumbnail":{"url":"https://media.kocakz.me/7088453cdab9ea9eacf731ab9e6feef5a5cac6b0469801f983de9d17c94aeb3f.webp","original":"https://tr.rbxcdn.com/180DAY-3f2d298cf383a99d3bbc7e745dabea75/150/150/Image/Png/noFilter"},"placeId":6788434697},"slug":"AniPhobia-Simpel-Inf-Mag-Ammo-100034","verified":false,"key":false,"keyless":false,"views":1682,"executes":406,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f5555c64c9e575001d1c4d76911d93e62d50d1ebe345276d2a10274a0f283d15.webp","original":"https://scriptblox.com/images/sb/6788434697-1770044031959.webp","scriptblox":"https://scriptblox.com/images/script/6788434697-1770044031959.webp"},"thumbnail":{"url":"https://media.kocakz.me/f5555c64c9e575001d1c4d76911d93e62d50d1ebe345276d2a10274a0f283d15.webp","original":"https://scriptblox.com/images/sb/6788434697-1770044031959.webp","scriptblox":"https://scriptblox.com/images/script/6788434697-1770044031959.webp"},"likeCount":4,"dislikeCount":0,"createdAt":"2026-02-02T14:53:51.980Z","updatedAt":"2026-02-02T14:53:51.980Z","lastBump":"2026-02-02T14:53:51.980Z","script":"-- infinite mag pls dont skid\r\n-- set getgenv().InfiniteMag = false before exec if u want it off\r\n\r\ngetgenv().InfiniteMag = true\r\n\r\nlocal magSize = 100      -- can be 10, 50, 999 or whatever, loop will keep forcing it anyway\r\nlocal plsWait = 0.1      -- dont touch this, controls how fast mag refreshes\r\n\r\nlocal plrs = game:GetService(\"Players\")\r\nlocal lp = plrs.LocalPlayer\r\n\r\nlocal function forceMag(gunClient)\r\n    if not gunClient then return end\r\n\r\n    local magTbl\r\n\r\n    for _,v in pairs(getgc(true)) do\r\n        if typeof(v) == \"function\" then\r\n            local fenv = getfenv(v)\r\n            if fenv and fenv.script == gunClient then\r\n                local info = debug.getinfo(v)\r\n                if info and info.name == \"OnSwitching\" then\r\n                    local up = debug.getupvalue(v, 6) -- yes its 6, dont ask\r\n                    if type(up) == \"table\" and up.Mag ~= nil then\r\n                        magTbl = up\r\n                        break\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end\r\n    if magTbl then\r\n        task.spawn(function()\r\n            while true do\r\n                task.wait(plsWait)\r\n                if getgenv().InfiniteMag then\r\n                    magTbl.Mag = magSize\r\n                end\r\n            end\r\n        end)\r\n    end\r\nend\r\n\r\nlocal function onChar(char)\r\n    for _,c in ipairs(char:GetChildren()) do\r\n        local gc = c:FindFirstChild(\"GunClient\")\r\n        if gc then\r\n            forceMag(gc)\r\n        end\r\n    end\r\n\r\n    char.ChildAdded:Connect(function(c)\r\n        task.wait(0.1) -- roblox moment\r\n        local gc = c:FindFirstChild(\"GunClient\")\r\n        if gc then\r\n            forceMag(gc)\r\n        end\r\n    end)\r\nend\r\n\r\nif lp.Character then\r\n    onChar(lp.Character)\r\nend\r\n\r\nlp.CharacterAdded:Connect(onChar)\r","features":"Gotcha!\n\"Infinite mag\" means you've got unlimited ammo, but it won't exceed the magazine's capacity. Play on, no worries about running out!\n\nScript By - pearman","tags":[],"discord":"","keyLink":"","owner":{"_id":"695764974a7b79540ab9a12b","username":"MoonDaity","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b2d419556d25550e40a6f47cb7b1cc2f660f2eb96c385f7e2666f73218bb1331.webp","original":"https://scriptblox.com/images/photo/695764974a7b79540ab9a12b-1770174346539.jpg"},"status":"offline","id":"695764974a7b79540ab9a12b","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/b2d419556d25550e40a6f47cb7b1cc2f660f2eb96c385f7e2666f73218bb1331.webp","original":"https://scriptblox.com/images/photo/695764974a7b79540ab9a12b-1770174346539.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:32:48.619Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6980ba7f9a31e53942603b3d","editBy":{"_id":"695764974a7b79540ab9a12b","username":"MoonDaity","status":"offline","id":"695764974a7b79540ab9a12b"},"message":"Create script","createdAt":"2026-02-02T14:53:51.984Z"}],"comments":[{"_id":"69815ffce96ccd29566a69c5","commentBy":{"_id":"69356282f002b181ca9167ba","username":"KILOman","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/d17091bd857318db35c63a2e7e90beb94effef5ef58f9c28f8a1b68fd7338799.webp","original":"https://scriptblox.com/images/photo/69356282f002b181ca9167ba-1765106356507.jpg"},"lastActive":"2026-03-04T01:37:54.429Z","createdAt":"2025-12-07T11:18:26.898Z","status":"offline","id":"69356282f002b181ca9167ba","profile":{"url":"https://media.kocakz.me/d17091bd857318db35c63a2e7e90beb94effef5ef58f9c28f8a1b68fd7338799.webp","original":"https://scriptblox.com/images/photo/69356282f002b181ca9167ba-1765106356507.jpg"}},"text":"It's working well il used it when the bunni stopped crashing","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-02-03T02:39:56.517Z","liked":false,"disliked":false},{"_id":"699e3f9296d3ccea103a4cfd","commentBy":{"_id":"699e3ec211afc6c1a5bf3b69","username":"rayguddd","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/db9c170a73fd07ece13ce818d52d028706ba6d8a49ca9188ba9f134200cea3c3.