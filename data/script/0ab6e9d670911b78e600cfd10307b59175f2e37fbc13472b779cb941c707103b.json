vice(\"TextChatService\"):WaitForChild(\"TextChannels\"):WaitForChild(\"RBXGeneral\") --u can't change this\n\nmsgsTable = {\n   \"master oogway thanks u\",-- u can change this\n   \"fr fr omg ty\",--u can change this\n   \"me when the impostor donated, thanks\",--u can change this\n   \"lets goo dude thanks\"--u can change this\n   \n   --Here you can add as many sentences as you want, just follow the template\n   --Здесь вы можете добавлять сколько хотите предложений, главное следуйте по шаблону\n}\ngame.Players.LocalPlayer.leaderstats.Raised.Changed:Connect(function()--don't change\n\tif getgenv().autoThank then --u can't change this\n\t\tchat:SendAsync(msgsTable[math.random(0, #msgsTable)]) --u can't change this\n\tend --u can't change this\nend)--u can't change this\nlocal VirtualUser = game:GetService(\"VirtualUser\") --u can't change this\ngame.Players.LocalPlayer.Idled:Connect(function() --u can't change this\n\tVirtualUser:CaptureController() --u can't change this\n\tVirtualUser:ClickButton2(Vector2.new()) --u can't change this\nend)--u can't change this","features":"You can put the words under yourself, you can also turn off autothanks altogether\n\nOpen Source\n\nFeel free to improve the Code❗️\n\nFeatures:\n\nAutothank\nAntiAFK","tags":["please donate","Autothank","Danechka"],"discord":"","keyLink":"","owner":{"_id":"67a49cf5b25fdf3d873de55e","username":"Danechka","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a44463367bcff095ace21bdc74a3d3dc3e64c8b935c28dc23e7cf90a6d751626.webp","original":"https://scriptblox.com/images/photo/67a49cf5b25fdf3d873de55e-1741341109855.jpg"},"lvl":10,"status":"offline","id":"67a49cf5b25fdf3d873de55e","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/a44463367bcff095ace21bdc74a3d3dc3e64c8b935c28dc23e7cf90a6d751626.webp","original":"https://scriptblox.com/images/photo/67a49cf5b25fdf3d873de55e-1741341109855.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstat