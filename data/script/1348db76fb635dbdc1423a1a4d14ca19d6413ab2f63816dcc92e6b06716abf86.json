{"_id":"6715f662344afd8b17d2130a","title":"Save Spot Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/526ea2fcb445b177a74910948cda75162ba5455bbf5a3944a2889ab4bcdd831d.webp","original":"https://scriptblox.com/images/sb/3670135-1729492578182.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/526ea2fcb445b177a74910948cda75162ba5455bbf5a3944a2889ab4bcdd831d.webp","original":"https://scriptblox.com/images/sb/3670135-1729492578182.png"},"placeId":0},"slug":"Universal-Script-Save-Spot-Script-20758","verified":false,"key":false,"keyless":false,"views":23904,"executes":2220,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/987e1e35d6ca1a139e0218afb356f3c366e71c177a5153dbc902cc68b4d1b48b.webp","original":"https://scriptblox.com/images/sb/3670135-1729492578182.png","scriptblox":"https://scriptblox.com/images/script/3670135-1729492578182.png"},"thumbnail":{"url":"https://media.kocakz.me/987e1e35d6ca1a139e0218afb356f3c366e71c177a5153dbc902cc68b4d1b48b.webp","original":"https://scriptblox.com/images/sb/3670135-1729492578182.png","scriptblox":"https://scriptblox.com/images/script/3670135-1729492578182.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-10-21T06:36:18.227Z","updatedAt":"2024-10-21T06:36:18.227Z","lastBump":"2024-10-21T06:36:18.227Z","script":"local player = game.Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = playerGui\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 200, 0, 50)\nbutton.Position = UDim2.new(0.5, -100, 0.5, -25)\nbutton.Text = \"Save Spot\"\nbutton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Parent = screenGui\n\nlocal savedPosition = nil\n\nlocal function savePosition()\n    local character = player.Character or player.CharacterAdded:Wait()\n    local humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n    savedPosition = humanoidRootPart.Position\n\n    button.Text = \"Teleport to saved spot\"\nend\n\nlocal function teleportToSavedSpot()\n    if savedPosition then\n        local character = player.Character or player.CharacterAdded:Wait()\n        local humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n        humanoidRootPart.CFrame = CFrame.new(savedPosition)\n\n        button.Text = \"Save Spot\"\n        savedPosition = nil\n    end\nend\n\nbutton.MouseButton1Click:Connect(function()\n    if savedPosition then\n        teleportToSavedSpot()\n    else\n        savePosition()\n    end\nend)\n\nbutton.Draggable = true","features":"This script allows you to save a position and lets you teleport back to that saved position.\n\nThe button is draggable.","tags":["Roblox","Script","Teleportation"],"discord":"","keyLink":"","owner":{"_id":"66f7a05cdc60f2cb40d98e21","username":"Your_Local_Exploiter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b1cb96a18e6b888192cda0d576a771459d6d48d7825d3575931a5dd07353687e.webp","original":"https://scriptblox.com/images/photo/66f7a05cdc60f2cb40d98e21-1735769403493.png"},"status":"offline","id":"66f7a05cdc60f2cb40d98e21","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/b1cb96a18e6b888192cda0d576a771459d6d48d7825d3575931a5dd07353687e.webp","original":"https://scriptblox.com/images/photo/66f7a05cdc60f2cb40d98e21-1735769403493.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:17:39.259Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c529c5","editBy":{"_id":"66f7a05cdc60f2cb40d98e21","user