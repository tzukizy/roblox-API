space)\n\nfor i = 100, 1, -1 do\n\thint.Text = \"Countdown: \" .. i\n\twait(1)\nend\n\nhint:Destroy()\n\nfor _, player in pairs(Players:GetPlayers()) do\n\tplayer:Kick(\"Server Shutdown\")\nend","owner":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"},"status":"offline","id":"6675627a3249494a4c405096","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"}},"verified":false,"views":36220,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6196dfdff660c785ccb894788a8fa00e612433a12b85e44d5e1771cf4d22e5bd.webp","original":"https://scriptblox.com/images/sb/0-1751348059418.png","scriptblox":"https://scriptblox.com/images/script/0-1751348059418.png"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-07-01T05:34:19.474Z","editBy":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","status":"offline","id":"6675627a3249494a4c405096"},"executes":4574,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:28:12.779Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/6196dfdff660c785ccb894788a8fa00e612433a12b85e44d5e1771cf4d22e5bd.webp","original":"https://scriptblox.com/images/sb/0-1751348059418.png","scriptblox":"https://scriptblox.com/images/script/0-1751348059418.png"},"changelog":[{"_id":"6863735bee47165092ee72b6","editBy":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","status"