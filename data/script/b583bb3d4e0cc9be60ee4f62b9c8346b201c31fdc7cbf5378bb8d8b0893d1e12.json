stat.Value = stat.Value + puntosAAgregar\n            print(\"Stat modificada:\", stat.Name, \"-> Nuevo valor:\", stat.Value)\n        end\n    end\nelse\n    warn(\"No se encontraron las estadísticas del jugador. Asegúrate de estar en el juego 'Age of Heroes'.\")\nend","features":"Añade 100000 puntos dd abilidad cada bes que lo ejecutas","tags":[],"discord":"","keyLink":"","owner":{"_id":"6920701f1aee322554ffb8e7","username":"Fjfjdidziw","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6920701f1aee322554ffb8e7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:38:57.004Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6935ffefc9a8b50085bb4284","editBy":{"_id":"6920701f1aee322554ffb8e7","username":"Fjfjdidziw","status":"offline","id":"6920701f1aee322554ffb8e7"},"message":"Create script","createdAt":"2025-12-07T22:30:07.985Z"}],"comments":[{"_id":"697956b508066ed9643f4a83","commentBy":{"_id":"68e080ae924ad4d2eed8c031","username":"tankkk","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-10-04T02:04:30.337Z","lastActive":"2026-02-04T07:50:08.943Z","status":"offline","id":"68e080ae924ad4d2eed8c031","topMilestone":{"key":"account.years","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"fake?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-28T00:22:13.998Z","liked":false,"disliked":false},{"_id":"699473f9e15cc5a47f17e821","commentBy":{"_id":"66180410043bbefaf7b31f28","username":"BobSta","verified":false,"role":"user","profilePicture":{"ur