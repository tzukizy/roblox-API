,\n    [79728562462837] = \"Naples\",\n    [114696879488068] = \"Central Finland\",\n    [105100340914771] = \"Oulu\",\n    [129666340482663] = \"New England\",\n    [100896593182656] = \"Little Havana\",\n    [101055430614447] = \"Concarneau\",\n    [91392366553634] = \"Worcestershire\",\n}\n\nlocal Players = game:GetService(\"Players\")\nlocal lastId = nil\n\nlocal function sendChat(msg)\n    pcall(function()\n        game:GetService(\"TextChatService\").TextChannels.RBXGeneral:SendAsync(msg)\n    end)\nend\n\nwhile true do\n    local success, result = pcall(function()\n        local label = workspace.Trivia.Trivia.Sign.SurfaceGui.Country\n        local imageId\n\n        if label:IsA(\"ImageLabel\") or label:IsA(\"ImageButton\") then\n            imageId = tonumber(label.Image:match(\"%d+\"))\n        elseif label:IsA(\"TextLabel\") then\n            imageId = tonumber(label.Text:match(\"%d+\"))\n        end\n\n        if imageId and imageId ~= lastId then\n            lastId = imageId\n            local country = idToCountry[imageId] or (\"Unknown ID: \" .. tostring(imageId))\n            print(\"[Trivia] Country: \" .. country)\n            sendChat(country)\n        end\n    end)\n\n    if not success then\n        warn(\"[Trivia Error] \" .. tostring(result))\n    end\n\n    task.wait(delay)\nend","features":"title\n\nopen source cause its made by claude","tags":[],"discord":"https://discord.gg/NJub84fsb","keyLink":"","owner":{"_id":"685292463b5549c3938e2092","username":"noritery","verified":false,"profilePicture":{"url":"https://media.kocakz.me/83032c5ff98c7fb60a99bfc4520e57acb039064a5461f4a1db34551ad5ec408c.webp","original":"https://scriptblox.com/images/photo/685292463b5549c3938e2092-1751012357063.png"},"status":"offline","id":"685292463b5549c3938e2092","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/83032c5ff98c7fb60a99bfc4520e57acb039064a5461f4a1db34551ad5ec408c.webp","original":"https://scriptblox.com/images/