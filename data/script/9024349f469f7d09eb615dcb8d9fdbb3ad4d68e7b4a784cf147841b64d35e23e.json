{"slug":"The-Battle-Bricks-Make-Enemy-Newell-Useless-240513","_id":"6a44b2d90b809a9a7e631f3f","title":"Make Enemy Newell Useless","game":{"_id":"67e5e1ffb360710ec3c7846e","gameId":10834586502,"name":"The Battle Bricks","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":10834586502},"features":"Makes Enemy Newell's projectile Go to the strongest ENEMY, so like if theres a windforce and a norman it will shoot the teapots on norman instead of your units, Script made me AbsolutelyNoIdea Btw. You can also use it for friendly Newell, But i wouldn't reccomend.","tags":["the battle bricks","TBB","OP"],"script":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\nlocal Workspace = game:GetService(\"Workspace\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal npcFolder = Workspace:WaitForChild(\"NPCFolders\")\nlocal enemyFolder = npcFolder:WaitForChild(\"EnemyFolder\")\n\nlocal projectileFolder = Workspace:WaitForChild(\"Projectile\")\n\nlocal teapotList = {}\nlocal bodyAngularList = {}\n\nlocal function removeTouchInterest(descendant)\n\tif descendant and descendant:IsA(\"TouchInterest\") then\n\t\tdescendant:Destroy()\n\tend\nend\n\nlocal function getHighestHPNPC()\n\tlocal highestNPC\n\tlocal maxHealth = -math.huge\n\tfor _, npc in ipairs(enemyFolder:GetChildren()) do\n\t\tlocal humanoid = npc:FindFirstChild(\"Humanoid\")\n\t\tif humanoid and humanoid.Health > 0 and humanoid.Health > maxHealth then\n\t\t\tmaxHealth = humanoid.Health\n\t\t\thighestNPC = npc\n\t\tend\n\tend\n\treturn highestNPC\nend\n\nlocal function HandleTeapot(teapotPart)\n\tif not teapotPart:IsA(\"BasePart\") then return end\n\t\n\tfor _, desc in ipairs(teapotPart:GetDescendants()) do\n\t\tremoveTouchInterest(desc)\n\tend\n\t\n\tlocal bav = teapotPart:FindFirstChildOfClass(\"BodyAngularVelocity\")\n\tif not bav then\n\t\tbav = Instance.new(\"BodyAngularVelocity\")\n\t\tbav.MaxTorque = Vector3.new(1e6, 1e6, 1e6)\n\t\tbav.AngularVelocity = Vector3.new(-40, 0, 0)\n\t\tbav.Parent = teapotPart\n\tend\n\tbodyAngularList[bav] = true\n\t\n\tteapotList[teapotPart] = true\nend\n\nfor _, obj in ipairs(projectileFolder:GetChildren()) do\n\tif obj.Name:lower():find(\"teapot\") then\n\t\tHandleTeapot(obj)\n\tend\nend\n\nprojectileFolder.ChildAdded:Connect(function(child)\n\tif child.Name:lower():find(\"teapot\") then\n\t\tHandleTeapot(child)\n\tend\nend)\n\nRunService.Heartbeat:Connect(function()\n\tfor bav, _ in pairs(bodyAngularList) do\n\t\tif bav.Parent then\n\t\t\tbav.AngularVelocity = Vector3.new(-40, 0, 0)\n\t\telse\n\t\t\tbodyAngularList[bav] = nil\n\t\tend\n\tend\n\t\n\tfor teapot, _ in pairs(teapotList) do\n\t\tif teapot.Parent then\n\t\t\tlocal targetNPC = getHighestHPNPC()\n\t\t\tif targetNPC then\n\t\t\t\tlocal root = targetNPC:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif root then\n\t\t\t\t\tteapot.CFrame = CFrame.new(root.Position + Vector3.new(0, 5, 0))\n\t\t\t\tend\n\t\t\tend\n\t\telse\n\t\t\tteapotList[teapot] = nil\n\t\tend\n\tend\nend)","owner":{"_id":"6a03657059313cff435e0b4f","username":"Foxxy_","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/2933e854d1f190c7c90e10686011290f429b1db104e4f4c001a9ab2d21f95432.webp","original":"https://scriptblox.com/images/photo/6a03657059313cff435e0b4f-1780059898852.jpg"},"status":"offline","id":"6a03657059313cff435e0b4f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/2933e854d1f190c7c90e10686011290f429b1db104e4f4c001a9ab2d21f95432.webp","original":"https://scriptblox.com/images/photo/6a03657059313cff435e0b4f-1780059898852.jpg"}},"verified":false,"views":2366,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/3565042f523c6227bd6b3bc20fab47e33d0ca688c70808d03431b9092099b6e0.webp","original":"htt