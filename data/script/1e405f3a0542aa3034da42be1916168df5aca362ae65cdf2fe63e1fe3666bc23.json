{"slug":"LGBTQ+-Hangout-Anti-Boombox-Fling-47476","_id":"689158d43b11d3ebd1b3a605","title":"Anti Boombox Fling","game":{"_id":"67e5e1ffb360710ec3c7871d","gameId":5373028495,"name":"LGBTQ+ Hangout🌈","imageUrl":"/images/sb/rbx-ee51d341874ab1ca4df38807c4a17ed2-734097e9eacc.png","placeId":5373028495},"features":"Disables collision for any boombox detected so no one can fling or push you anymore.","tags":["lgbt","lgbtq hangout","antifling","nofling","boombox"],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function disableRadioMeshCollision(part)\n    -- Disable initially\n    part.CanCollide = false\n    -- Redisable if CanCollide changes back to true\n    part.Changed:Connect(function(property)\n        if property == \"CanCollide\" and part.CanCollide == true then\n            part.CanCollide = false\n        end\n    end)\nend\n\nlocal function scanAndDisable(parent)\n    for _, obj in pairs(parent:GetDescendants()) do\n        if obj.Name == \"RadioMesh\" and obj:IsA(\"BasePart\") then\n            disableRadioMeshCollision(obj)\n        end\n    end\nend\n\n-- Initial scan on workspace\nscanAndDisable(workspace)\n\n-- Listen for new additions to workspace\nworkspace.DescendantAdded:Connect(function(obj)\n    if obj.Name == \"RadioMesh\" and obj:IsA(\"BasePart\") then\n        disableRadioMeshCollision(obj)\n    end\nend)","owner":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","verified":false,"profilePicture":"/images/photo/66e3becd388f07d7f50f3c50-1754958047296.png","status":"offline","id":"66e3becd388f07d7f50f3c50","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":11039,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-a9147668f33d319bd7b864a3f32286eb-243831361cb9.png","likeCount":3,"dislikeCount":3,"createdAt":"2025-08-05T01:05:24.905Z","editBy":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","stat