   end)\nend\n\nlocal function scanAndDisable(parent)\n    for _, obj in pairs(parent:GetDescendants()) do\n        if obj.Name == \"RadioMesh\" and obj:IsA(\"BasePart\") then\n            disableRadioMeshCollision(obj)\n        end\n    end\nend\n\n-- Initial scan on workspace\nscanAndDisable(workspace)\n\n-- Listen for new additions to workspace\nworkspace.DescendantAdded:Connect(function(obj)\n    if obj.Name == \"RadioMesh\" and obj:IsA(\"BasePart\") then\n        disableRadioMeshCollision(obj)\n    end\nend)","features":"Disables collision for any boombox detected so no one can fling or push you anymore.","tags":["lgbt","lgbtq hangout","antifling","nofling","boombox"],"discord":"","keyLink":"","owner":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6974c8fd209ec3e9c0503faa9395d4446ea3fa8eedba1d771c3b642b76c25696.webp","original":"https://scriptblox.com/images/photo/66e3becd388f07d7f50f3c50-1754958047296.png"},"status":"offline","id":"66e3becd388f07d7f50f3c50","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/6974c8fd209ec3e9c0503faa9395d4446ea3fa8eedba1d771c3b642b76c25696.webp","original":"https://scriptblox.com/images/photo/66e3becd388f07d7f50f3c50-1754958047296.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:01:51.712Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"689158d43b11d3ebd1b3a607","editBy":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","status":"offline","id":"66e3becd388f07d7f50f3c50"},"message":"Create script","createdAt":"2025-08-05T01:05:24.907Z"},{"_id":"689159454ca0926b1773c057","editBy":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","status":"offline","id":"66e3becd388f07d7f50f3c50"},"message":