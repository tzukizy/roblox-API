{"slug":"Counter-Blox-No-Spread-Open-Source-65029","_id":"69130db67900f3f7f59fff71","title":"(Works after update) No Spread Open Source","game":{"_id":"67e5e1ffb360710ec3c77e4c","gameId":301549746,"name":"Counter Blox","imageUrl":"/images/sb/rbx-12f3df45e3e4906ed68bf705fa0a48b7-67d7f8190d95.png","placeId":301549746},"features":"No spread all weapons. Runs on each executor.","tags":[],"script":"local NoSpreadEnabled = true\nlocal WeaponsFolder = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"Weapons\")\n\nlocal function noSpread(weapon)\n\tif NoSpreadEnabled then\n\t\tlocal spread = weapon:FindFirstChild(\"Spread\")\n\t\tif spread then\n\t\t\tfor _, v in ipairs(spread:GetDescendants()) do\n\t\t\t\tif v:IsA(\"NumberValue\") then\n\t\t\t\t\tv.Value = 0\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nif WeaponsFolder then\n\tfor _, weapon in ipairs(WeaponsFolder:GetChildren()) do\n\t\tnoSpread(weapon)\n\tend\nend\n","owner":{"_id":"68fd0f373eb11c885f5d29c0","username":"frvgmxnt","verified":false,"profilePicture":"/images/photo/68fd0f373eb11c885f5d29c0-1771325388043.jpg","status":"offline","id":"68fd0f373eb11c885f5d29c0","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":8744,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-07dc783f0f3441f1f493fed755e15575-7488b0c5e7ae.png","likeCount":7,"dislikeCount":3,"createdAt":"2025-11-11T10:19:34.768Z","editBy":{"_id":"68fd0f373eb11c885f5d29c0","username":"frvgmxnt","status":"offline","id":"68fd0f373eb11c885f5d29c0"},"keyLink":"","executes":74,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69130db67900f3f7f59fff73","editBy":{"_id":"68fd0f373eb11c885f5d29c0","username":"frvgmxnt","status":"offline","id":"68fd0f373eb11c885f5d29c0"},"message":"Create script","createdAt":"2025-11-11T10:19:34.772Z"},{"_id":"69138c3930bab22943626e5a","editBy":{"_id":"68fd0f373eb11c885f5d29c0","username":"fr