{"slug":"DIMENSIONAL-COALESCENCE-V1.0-PROTOTYPE-Hitbox-expander-for-DC-71525","_id":"692cb246a600f4df26e31e67","title":"Hitbox expander for DC","game":{"_id":"68231725ae1cf9f2e0d29753","gameId":15387707375,"name":"[TITLE UNAVAILABLE]","imageUrl":"/images/sb/rbx-9f58eee5e266feccddeab3b1ad3ebef1-eccee921c087.png","placeId":15387707375},"features":"Extends your hitbox for easier hits, you need execute everytime the round starts","tags":["dimensional coalescence","dc","roblox","exploit","script"],"script":"local Players = game:GetService(\"Players\")\nlocal LP = Players.LocalPlayer\n\nfor _, v in ipairs(Players:GetPlayers()) do\n    if v ~= LP then\n        local char = v.Character\n        if char then\n            local torso = char:FindFirstChild(\"HitFolder\")\n            if torso then\n                local collision = torso:FindFirstChild(\"collision\")\n                if collision then\n                    collision.Size = Vector3.new(30, 30, 30)\n                    collision.Transparency = 0.9\n                end\n            end\n        end\n    end\nend","owner":{"_id":"673359e0bdaef29285037406","username":"StewBradar","verified":false,"profilePicture":"/images/photo/673359e0bdaef29285037406-1790446588742.png","status":"offline","id":"673359e0bdaef29285037406","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":2899,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/15387707375-1764536902339.png","likeCount":3,"dislikeCount":0,"createdAt":"2025-11-30T21:08:22.358Z","executes":14212,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":12816,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"692cb246a600f4df26e31e69","editBy":{"_id":"673359e0bdaef29285037406","username":"StewBradar","status":"offline","id":"673359e0bdaef29285037406"},"message":"Create script","createdAt":"2025-11-30T21: