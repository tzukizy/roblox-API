{"_id":"6905bb4beb8cd5c0dd8632b1","title":"open source","game":{"_id":"68e65536cc090563b0c6e482","gameId":99827026339186,"name":"[🎃]Slasher Blade Loot[W6]","imageUrl":{"url":"https://media.kocakz.me/d6ab265526e55195cc409f9a1a5a379dfe45dec124b4243419127dca36858958.webp","original":"https://tr.rbxcdn.com/180DAY-87249609dae614261c1058785f217b72/150/150/UnapprovedImage/Png/noFilter"},"slug":"99827026339186-slasher-blade-loot","path":"/game/99827026339186-slasher-blade-loot","thumbnail":{"url":"https://media.kocakz.me/d6ab265526e55195cc409f9a1a5a379dfe45dec124b4243419127dca36858958.webp","original":"https://tr.rbxcdn.com/180DAY-87249609dae614261c1058785f217b72/150/150/UnapprovedImage/Png/noFilter"},"placeId":99827026339186},"slug":"Slasher-Blade-LootDUNGEON-open-source-62170","verified":false,"key":false,"keyless":false,"views":13750,"executes":48,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/89702a5a10a5db198f7aec83d69dacf7e6702e1d5599e1fe975f484b860961c4.webp","original":"https://scriptblox.com/images/sb/rbx-e9523c39b7f0045eee893e0d4c3837f0-9efe50653ea5.png","scriptblox":"https://scriptblox.com/images/script/rbx-e9523c39b7f0045eee893e0d4c3837f0-9efe50653ea5.png"},"thumbnail":{"url":"https://media.kocakz.me/89702a5a10a5db198f7aec83d69dacf7e6702e1d5599e1fe975f484b860961c4.webp","original":"https://scriptblox.com/images/sb/rbx-e9523c39b7f0045eee893e0d4c3837f0-9efe50653ea5.png","scriptblox":"https://scriptblox.com/images/script/rbx-e9523c39b7f0045eee893e0d4c3837f0-9efe50653ea5.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-11-01T07:48:27.344Z","updatedAt":"2025-11-01T07:48:27.344Z","lastBump":"2025-11-01T07:48:27.344Z","script":"getgenv().AutoHit = true\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal Remote = ReplicatedStorage:WaitForChild(\"Remote\"):WaitForChild(\"Event\"):WaitForChild(\"Combat\"):WaitForChild(\"M1\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal HumanoidRootPart\n\nlocal function updateCharacter()\n\tlocal char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n\tHumanoidRootPart = char:WaitForChild(\"HumanoidRootPart\")\nend\n\nupdateCharacter()\nLocalPlayer.CharacterAdded:Connect(updateCharacter)\n\nlocal function getClosestMob()\n\tlocal closest, dist = nil, math.huge\n\tfor _, mob in ipairs(Workspace.Live.MobModel:GetChildren()) do\n\t\tif mob:FindFirstChild(\"HumanoidRootPart\") and mob:FindFirstChild(\"Humanoid\") and mob.Humanoid.Health > 0 then\n\t\t\tlocal mag = (mob.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude\n\t\t\tif mag < dist then\n\t\t\t\tdist = mag\n\t\t\t\tclosest = mob\n\t\t\tend\n\t\tend\n\tend\n\treturn closest\nend\n\ntask.spawn(function()\n\twhile getgenv().AutoHit do\n\t\ttask.wait()\n\t\tif HumanoidRootPart then\n\t\t\tlocal target = getClosestMob()\n\t\t\tif target then\n\t\t\t\tRemote:FireServer({ target:GetAttribute(\"UUID\") or target.Name })\n\t\t\tend\n\t\tend\n\tend\nend)\n","features":"hi this is a project make by me (If you are coming here to give a skid, Im fine with it. I used a bit of chatlgbt to make the logic so that when it dies, the script still works.)\n\nif you find smth like errors say to my dm in discord : jalanbipallv22_75999","tags":[],"discord":"","keyLink":"","owner":{"_id":"676c65d7021ed1a13f16255f","username":"elysiumisevil","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fc079faf618f7c07d7b368cbf6041e56ab00f26c309675485ec585d3b4159c75.webp","original":"https://scriptblox.com/images/photo/676c65d7021ed1a13f16255f-1753382532143.png"},"status":"offline","id":"676c65d7021ed1a13f16255f","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/fc079faf618f7c07d7b368cbf6041e56ab00f26c309675485ec585d3b4159c75.webp","original":"https://scriptblox.com/images/photo/676c65d7021ed1a13f16255f-1753382532143.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:48:38.434Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6905bb4beb8cd5c0dd8632b4","editBy":{"_id":"676c65d7021ed1a13f16255f","username":"elysiumisevil","status":"offline","id":"676c65d7021ed1a13f16255f"},"message":"Create script","createdAt":"2025-11-01T07:48:27.352Z"}],"comments":[{"_id":"6905dada227f42cf7a27cee7","commentBy":{"_id":"68ed20d8866cca5c349dcacf","username":"luoxue1145","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/ab0e5498caad166d23b4d5bb83e071bd399a7b687e88de92142caaeb51b8e689.webp","original":"https://scriptblox.com/images/photo/68ed20d8866cca5c349dcacf-1760371281578.png"},"createdAt":"2025-10-13T15:55:04.873Z","lastActive":"2026-10-07T05:04:56.896Z","status":"offline","id":"68ed20d8866cca5c349dcacf","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/ab0e5498caad166d23b4d5bb83e071bd399a7b687e88de92142caaeb51b8e689.webp","original":"https://scriptblox.com/images/photo/68ed20d8866cca5c349dcacf-1760371281578.png"}},"text":"can u make more fast, such as 1s 1m damage LOL","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-01T10:03:06.382Z","liked":false,"disliked":false},{"_id":"69062b856545af2e591fe3c7","commentBy":{"_id":"669d484854114efce59fbe0a","username":"tirematsu","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/45a95cd31b671c04f9043b0efc0278cc91569e948811563dd7e5e516d0c4e510.webp","original":"https://scriptblox.com/images/photo/669d484854114efce59fbe0a-1763232382576.png"},"createdAt":"2024-07-21T17:41:28.240Z","lastActive":"2026-05-13T17:42:37.099Z","status":"offline","id":"669d484854114efce59fbe0a","profile":{"url":"https://media.koca