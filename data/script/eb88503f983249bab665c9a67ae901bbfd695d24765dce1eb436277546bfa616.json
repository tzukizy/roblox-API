{"slug":"Universal-Script-Delete-body-mover-38587","_id":"68173246349b0fd14ed4d278","title":"Simple Delete body mover","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Deletes bodymovers that are currently in the workspace\n\nSimple script","tags":["bodymover","bodymove","delete bodymover","Simple"],"script":"local UserInputService = game:GetService(\"UserInputService\")\n\nlocal function removeBodyMovers(target)\n    for _, descendant in ipairs(target:GetDescendants()) do\n        if descendant:IsA(\"BodyMover\") then\n            descendant:Destroy()\n        end\n    end\nend\n\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\tif input.KeyCode == Enum.KeyCode.M  then\n\t    removeBodyMovers(workspace)\n\tend\nend)\n","owner":{"_id":"66f6abe365d68cf99a3ca5ae","username":"NutShellScriptForRea","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/13eaa8bf171a8e5f3151a99f4e3fc7689f9a6945a96676324462ed791b903cb5.webp","original":"https://scriptblox.com/images/photo/66f6abe365d68cf99a3ca5ae-1735620674230.png"},"status":"offline","id":"66f6abe365d68cf99a3ca5ae","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/13eaa8bf171a8e5f3151a99f4e3fc7689f9a6945a96676324462ed791b903cb5.webp","original":"https://scriptblox.com/images/photo/66f6abe365d68cf99a3ca5ae-1735620674230.png"}},"verified":false,"views":2655,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/d4ca827d9648fd2d312b60fdd618d8b208b9c64a008ec9abd6316379f61d755e.webp","original":"https://scriptblox.com/images/sb/0-1746350662071.png","scriptblox":"https://scriptblox.com/images/script/0-1746350662071.png"},"likeCo