{"_id":"68b96ddd15ccd3bc00983871","title":"TP tool","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/f149cd40994fade825d8451d33d7d4f2ae1f1d431665447c399bf54209604fd5.webp","original":"https://scriptblox.com/images/sb/0-1758474559442.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/f149cd40994fade825d8451d33d7d4f2ae1f1d431665447c399bf54209604fd5.webp","original":"https://scriptblox.com/images/sb/0-1758474559442.png"},"placeId":0},"slug":"Universal-Script-TP-tool-51626","verified":false,"key":false,"keyless":false,"views":4627,"executes":900,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6cb2087cb8921038236f1061c5e139f769bce222b94688a424cee774bd915e08.webp","original":"https://scriptblox.com/images/sb/0-1758474559442.png","scriptblox":"https://scriptblox.com/images/script/0-1758474559442.png"},"thumbnail":{"url":"https://media.kocakz.me/6cb2087cb8921038236f1061c5e139f769bce222b94688a424cee774bd915e08.webp","original":"https://scriptblox.com/images/sb/0-1758474559442.png","scriptblox":"https://scriptblox.com/images/script/0-1758474559442.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-09-04T10:45:49.728Z","updatedAt":"2025-09-04T10:45:49.728Z","lastBump":"2025-09-04T10:45:49.728Z","script":"local player = game.Players.LocalPlayer\nlocal backpack = player:WaitForChild(\"Backpack\")\n\nlocal tool = Instance.new(\"Tool\")\ntool.Name = \"TP Tool\"\ntool.RequiresHandle = true\ntool.CanBeDropped = false\n\nlocal handle = Instance.new(\"Part\")\nhandle.Name = \"Handle\"\nhandle.Size = Vector3.new(1,1,1)\nhandle.Color = Color3.fromRGB(128, 128, 128) \nhandle.Material = Enum.Material.Plastic \nhandle.CanCollide = false\nhandle.Anchored = false\nhandle.Parent = tool\n\ntool.Parent = backpack\n\nlocal mouse = player:GetMouse()\nlocal maxDistance = 1000\n\ntool.Activated:Connect(function()\n    local targetPos = mouse.Hit.p\n    local char = player.Character\n    if not char or not char:FindFirstChild(\"HumanoidRootPart\") then return end\n    local hrp = char.HumanoidRootPart\n    local distance = (targetPos - hrp.Position).Magnitude\n    if distance <= maxDistance then\n        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0,5,0))\n    else\n        print(\"Teleport too far!\")\n    end\nend)","features":"teleporting upon click(now originally made by me, no longer copied)","tags":[],"discord":"","keyLink":"","owner":{"_id":"6876a5edad26070596c2ab50","username":"utemporary471","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2153ed4a862f2c9dd2400ec74af7483ec1f35061cd08a097d193627259836a8c.webp","original":"https://scriptblox.com/images/photo/6876a5edad26070596c2ab50-1755685008182.png"},"status":"offline","id":"6876a5edad26070596c2ab50","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/2153ed4a862f2c9dd2400ec74af7483ec1f35061cd08a097d193627259836a8c.webp","original":"https://scriptblox.com/images/photo/6876a5edad26070596c2ab50-1755685008182.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:44:08.146Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b96ddd15ccd3bc00983873","editBy":{"_id":"6876a5edad26070596c2ab50","username":"utemporary471","status":"offline","id":"6876a5edad26070596c2ab50"},"message":"Create script","createdAt":"2025-09-04T10:45:49.731Z"},{"_id":"68c16fae1f39445cbf8f6248","editBy":{"_id":"6876a5edad26070596c2ab50","username":"utemporary471","status":"offline","id":"6876a5edad26070596c2ab50"},"message":"Update script","createdAt":"2025-09-10T12:31:42.211Z"},{"_id":"68d0313fedc2fa3378bfacc6","editBy":{"_id":"6876a5edad26070596c2ab50","username":"utemporary4