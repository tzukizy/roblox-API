{"slug":"Write-a-Letter-snowball-script-134889","_id":"69bc55d4ec95ce09d1673136","title":"snowball script","game":{"_id":"67e5e1ffb360710ec3c780d7","gameId":8425637426,"name":"Write a Letter ❄️","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":8425637426},"features":"Snowball! (you get snowball by pressing \"F\" key then u tp back to where you were)","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal TARGET_POSITION = Vector3.new(-655, 31, 1157)\n\nlocal function pressF()\n    local VIM = game:GetService(\"VirtualInputManager\")\n    VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)\n    task.wait(0.1)\n    VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)\nend\n\nlocal function run()\n    local originalCFrame = humanoidRootPart.CFrame\n\n    humanoidRootPart.CFrame = CFrame.new(TARGET_POSITION)\n\n    task.wait(0.2)\n    pressF()\n\n    task.wait(0.3)\n    humanoidRootPart.CFrame = originalCFrame\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.F then\n        run()\n    end\nend)\n","owner":{"_id":"69a9c6e5dfe464b9183a5919","username":"Tubiu","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/a33a609672673992f7aa39f433c4e66331fdb655b7498fabc27058844c4da7db.webp","original":"https://scriptblox.com/images/photo/69a9c6e5dfe464b9183a5919-1773951697213.jpg"},"status":"offline","id":"69a9c6e5dfe464b9183a5919","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/a33a609672673992f7aa39f433c4e66331fdb655b7498fabc27058844c4d