{"_id":"6661d6da3cdaf441a8bff633","title":"tells you people's words","game":{"_id":"67e5e1ffb360710ec3c78271","gameId":17218259625,"name":"Who's the Spy?","imageUrl":{"url":"https://media.kocakz.me/d5504bd10be59e64d4866bbf13bab1d0817330cbe68aec0cac7dace581c78853.webp","original":"https://tr.rbxcdn.com/180DAY-2ef3e5e676aba4210fa5f9433f5e8a26/150/150/Image/Png/noFilter"},"slug":"17218259625-who-s-the-spy","path":"/game/17218259625-who-s-the-spy","thumbnail":{"url":"https://media.kocakz.me/d5504bd10be59e64d4866bbf13bab1d0817330cbe68aec0cac7dace581c78853.webp","original":"https://tr.rbxcdn.com/180DAY-2ef3e5e676aba4210fa5f9433f5e8a26/150/150/Image/Png/noFilter"},"placeId":17218259625},"slug":"Who-is-the-Spy-spy-finder-and-tells-you-words-of-people-13786","verified":false,"key":false,"keyless":false,"views":17012,"executes":44,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/b6d5658ab87d994286cae506c67c50cd/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/b6d5658ab87d994286cae506c67c50cd/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/b6d5658ab87d994286cae506c67c50cd/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/b6d5658ab87d994286cae506c67c50cd/500/280/Image/Jpeg"},"likeCount":3,"dislikeCount":0,"createdAt":"2024-06-06T15:33:46.645Z","updatedAt":"2024-06-06T15:33:46.645Z","lastBump":"2024-06-06T15:33:46.645Z","script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal function createLabel(character, text, textColor)\n  local billboardGui = Instance.new(\"BillboardGui\")\n  billboardGui.Name = \"StatusLabel\"\n  billboardGui.Adornee = character:FindFirstChild(\"Head\")\n  billboardGui.Size = UDim2.new(0, 100, 0, 50)\n  billboardGui.StudsOffset = Vector3.new(0, 4, 0)\n  billboardGui.AlwaysOnTop = true\n\n  local textLabel = Instance.new(\"TextLabel\")\n  textLabel.Size = UDim2.new(1, 0, 1, 0)\n  textLabel.BackgroundTransparency = 1\n  textLabel.Text = text\n  textLabel.TextColor3 = textColor\n  textLabel.TextScaled = true\n  textLabel.Font = Enum.Font.SourceSansBold\n  textLabel.Parent = billboardGui\n\n  billboardGui.Parent = character\nend\n\nlocal function checkPlayerForStatus(player)\n  local boolFolder = player:FindFirstChild(\"boolFolder\")\n  if boolFolder then\n    local isSpy = boolFolder:FindFirstChild(\"isSpy\")\n    if isSpy and isSpy:IsA(\"BoolValue\") then\n      if player.Character and player.Character:FindFirstChild(\"Head\") then\n        local existingLabel = player.Character:FindFirstChild(\"StatusLabel\")\n        if existingLabel then\n          existingLabel:Destroy()\n        end\n\n        local chosenMode = ReplicatedStorage.String:FindFirstChild(\"ChosenMode\")\n        if chosenMode and chosenMode:IsA(\"StringValue\") then\n          if isSpy.Value then\n            if chosenMode.Value == \"Spy with Word\" then\n              local spyWord = ReplicatedStorage.String:FindFirstChild(\"SpyWord\")\n              if spyWord and spyWord:IsA(\"StringValue\") then\n                createLabel(player.Character, spyWord.Value, Color3.new(1, 0, 0))\n              else\n                warn(\"SpyWord not found in ReplicatedStorage.String\")\n              end\n            elseif chosenMode.Value == \"Wordless Spy\" then\n              createLabel(player.Character, \"No word\", Color3.new(1, 0, 0))\n            end\n          else\n            local innocentWord = ReplicatedStorage.String:FindFirstChild(\"ClueWord\")\n            if innocentWord and innocentWord:IsA(\"StringValue\") then\n              createLabel(player.Character, innocentWord.Value, Color3.new(0, 1, 0))\n            else\n              warn(\"ClueWord not found in ReplicatedStorage.String\")\n            end\n          end\n        else\n          warn(\"ChosenMode not found in ReplicatedStorage.String\")\n        end\n      end\n    end\n  end\nend\n\nlocal function checkAllPlayers()\n  for _, player in pairs(Players:GetPlayers()) do\n    checkPlayerForStatus(player)\n  end\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n  player.CharacterAdded:Connect(function(character)\n    checkPlayerForStatus(player)\n  end)\nend)\n\nwhile true do\n  checkAllPlayers()\n  wait(2)\nend\n","features":"it tells you the words and you can use it to your advantage\n\n-displays \"no word\" on wordless spy\n-displays word on innocent\n-spy's word is red\n\nCREDITS TO  'progamermst' for the original script","tags":["spy","who is the spy"],"discord":"","keyLink":"","owner":{"_id":"66562dd7487172f16cb7ed1c","username":"riices","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6e61a047294e890973fce4666fa5d57d5c98655d70d11058a2d567525d0f0c20.webp","original":"https://scriptblox.com/images/photo/66562dd7487172f16cb7ed1c-1763070565154.png"},"status":"offline","id":"66562dd7487172f16cb7ed1c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/6e61a047294e890973fce4666fa5d57d5c98655d70d11058a2d567525d0f0c20.webp","original":"https://scriptblox.com/images/photo/66562dd7487172f16cb7ed1c-1763070565154.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:09:19.655Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50f6b","editBy":{"_id":"66562dd7487172f16cb7ed1c","username":"riices","status":"offline","id":"66562dd7487172f16cb7ed1c"},"message":"Create script","createdAt":"2025-03-27T22:17:51.491Z"}],"comments":[{"_id":"6661e12a29a50abe2bb99903","commentBy":{"_id":"6541b02f6817a65ee628a47e","username":"Kuroyami","verified":false,"role":"user","profilePicture":{"url":"https://media.koc