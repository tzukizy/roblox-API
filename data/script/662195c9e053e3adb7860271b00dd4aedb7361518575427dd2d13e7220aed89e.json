{"_id":"68e207532340b1a032357232","title":"Fe btool by Jinxx","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/8e7f67249be379ce245347fa70a79f230fe9c394fe0ac45a9b83a00842875a80.webp","original":"https://scriptblox.com/images/sb/0-1759643475544.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/8e7f67249be379ce245347fa70a79f230fe9c394fe0ac45a9b83a00842875a80.webp","original":"https://scriptblox.com/images/sb/0-1759643475544.jpg"},"placeId":0},"slug":"Universal-Script-Fe-btool-by-Jinxx-56544","verified":false,"key":false,"keyless":false,"views":2728,"executes":1347,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/311eebf556d7cd0aff12b148d960b385ddaddcfd3d187066f43204a5777055eb.webp","original":"https://scriptblox.com/images/sb/0-1759643475544.jpg","scriptblox":"https://scriptblox.com/images/script/0-1759643475544.jpg"},"thumbnail":{"url":"https://media.kocakz.me/311eebf556d7cd0aff12b148d960b385ddaddcfd3d187066f43204a5777055eb.webp","original":"https://scriptblox.com/images/sb/0-1759643475544.jpg","scriptblox":"https://scriptblox.com/images/script/0-1759643475544.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-05T05:51:15.568Z","updatedAt":"2025-10-05T05:51:15.568Z","lastBump":"2025-10-05T05:51:15.568Z","script":"--// Made by Jinxx\n\ngame.StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)\n\nlocal player = game.Players.LocalPlayer\nlocal mouse = player:GetMouse()\nlocal backpack = player:WaitForChild(\"Backpack\")\n\nlocal tool1 = Instance.new(\"Tool\")\ntool1.Name = \"BTool\"\ntool1.RequiresHandle = false\ntool1.Parent = backpack\n\nlocal selectionBox = Instance.new(\"SelectionBox\")\nselectionBox.Color3 = Color3.fromRGB(0, 0, 255)\nselectionBox.LineThickness = 0.05\nselectionBox.Visible = false\nselectionBox.Parent = workspace\n\nlocal selected = nil\nlocal equipped1 = false\n\ntool1.Equipped:Connect(function()\n    equipped1 = true\n    selectionBox.Adornee = nil\n    selectionBox.Visible = false\nend)\n\ntool1.Unequipped:Connect(function()\n    equipped1 = false\n    selectionBox.Adornee = nil\n    selectionBox.Visible = false\n    selected = nil\nend)\n\nmouse.Button1Down:Connect(function()\n    if not equipped1 then return end\n    local target = mouse.Target\n    if not target or not target:IsA(\"BasePart\") then return end\n    if target.Anchored then return end\n\n    if selected == target then\n        local explosion = Instance.new(\"Explosion\")\n        local sideOffset = target.CFrame.RightVector * (target.Size.X / 2 + 2)\n        explosion.Position = target.Position + sideOffset\n        explosion.BlastRadius = 100\n        explosion.BlastPressure = 1e13\n        explosion.DestroyJointRadiusPercent = 0\n        explosion.ExplosionType = Enum.ExplosionType.NoCraters\n        explosion.Parent = workspace\n\n        explosion.Hit:Connect(function(part)\n            if part:IsDescendantOf(player.Character) then\n                part.Velocity = Vector3.zero\n                part.RotVelocity = Vector3.zero\n            end\n        end)\n\n        selectionBox.Adornee = nil\n        selectionBox.Visible = false\n        selected = nil\n    else\n        selected = target\n        selectionBox.Adornee = target\n        selectionBox.Visible = true\n    end\nend)","features":"Click to select the unachored part and double click to delete the part","tags":[],"discord":"","keyLink":"","owner":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","verified":false,"profilePicture":{"url":"https://media.kocakz.me/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"},"status":"offline","id":"6675627a3249494a4c405096","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:54:49.222Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e207532340b1a032357234","editBy":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","status":"offline","id":"6675627a3249494a4c405096"},"message":"Create script","createdAt":"2025-10-05T05:51:15.573Z"}],"comments":[{"_id":"68e20bcaa45243d60ec28251","commentBy":{"_id":"677e4eb65f8bda990f6d10d8","username":"Noah1337","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/4b75fa478bee6e9a20a5684aaafe8f6232dd584b96da973247056d69ba75544b.webp","original":"https://scriptblox.com/images/photo/677e4eb65f8bda990f6d10d8-1765535760430.jpeg"},"createdAt":"2025-01-08T10:08:54.807Z","lastActive":"2026-09-19T10:42:26.079Z","status":"offline","id":"677e4eb65f8bda990f6d10d8","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/4b75fa478bee6e9a20a5684aaafe8f6232dd584b96da973247056d69ba75544b.webp","original":"https://scriptblox.com/images/photo/677e4eb65f8bda990f6d10d8-1765535760430.jpeg"}},"text":"clientsided but still its cool","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-10-05T06:10:18.401Z","liked":false,"disliked":false},{"_id":"68e21ea40669b203fe759077","commentBy":{"_id":"6675627a3249494a4c405096","username":"Jinxx0g","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/598dd927695f290903805ef20c2ca00fc326edd9214a275cf66dd1f2db1c0268.webp","original":"https://scriptblox.com/images/photo/6675627a3249494a4c405096-1726993201606.jpg"},"createdAt":"2024-06-21T11:22:34.048Z","lastActive":"2025-10-14T