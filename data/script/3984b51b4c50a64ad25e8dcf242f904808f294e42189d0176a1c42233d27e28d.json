econds\nbtn.MouseButton1Click:Connect(function()\n\tlocal player = game.Players.LocalPlayer\n\tlocal char = player.Character or player.CharacterAdded:Wait()\n\tlocal humanoid = char:WaitForChild(\"Humanoid\")\n\n\tlocal anim = Instance.new(\"Animation\")\n\tanim.AnimationId = \"rbxassetid://35654637\"\n\n\tlocal track = humanoid:LoadAnimation(anim)\n\ttrack:Play()\n\n\t-- stop after 9 seconds\n\ttask.wait(9)\n\ttrack:Stop()\nend)\n","features":"use r6 for it to work","tags":[],"discord":"","keyLink":"","owner":{"_id":"68b075fc6aa51a06ce51cc4e","username":"somerandomguy_12348","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68b075fc6aa51a06ce51cc4e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:44:00.884Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"692c8c44ea79025cfea87da5","editBy":{"_id":"68b075fc6aa51a06ce51cc4e","username":"somerandomguy_12348","status":"offline","id":"68b075fc6aa51a06ce51cc4e"},"message":"Create script","createdAt":"2025-11-30T18:26:12.152Z"}],"comments":[{"_id":"692c8cdba600f4df26e086da","commentBy":{"_id":"68fe4b84febbd848e1f3ea53","username":"Untr","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/0338efddc0777855ff0f3ac8c2a6c27eff3b27e4c80b2fc83ab9ba218c9043dc.webp","original":"https://scriptblox.com/images/photo/68fe4b84febbd848e1f3ea53-1783154856829.png"},"createdAt":"2025-10-26T16:25:40.407Z","lastActive":"2026-07-22T09:56:08.048Z","status":"offline","id":"68fe4b84febbd848e1f3ea53","profile":{"url":"https://media.kocakz.me/0338efddc0777855ff0f3ac8c2a6c27eff3b27e4c80b2fc83ab9ba218c9043dc.webp","original":"https:/