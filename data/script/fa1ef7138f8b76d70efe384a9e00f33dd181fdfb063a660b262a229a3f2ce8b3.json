{"slug":"Beat-the-Robloxian!-Beta-open-source-kill-aura-66592","_id":"69187c15866f25063b444416","title":"open source kill aura","game":{"_id":"67e5e1ffb360710ec3c77f1d","gameId":14713532223,"name":"Beat The Robloxian!","imageUrl":"/images/sb/rbx-e507cbcf921fdd25cca2727969c566d5-66ffb49cec97.png","placeId":14713532223},"features":"source code","tags":["source code","Kill aura"],"script":"-- LoL\n\nlocal v1 = game:GetService(\"Players\").LocalPlayer\nlocal v2 = game:GetService(\"ReplicatedStorage\").Remotes\nlocal v3 = v1.Character or v1.CharacterAdded:Wait()\nlocal v4 = v3:WaitForChild(\"HumanoidRootPart\")\n\nlocal function v5()\n    local v6, v7 = math.huge, nil\n    for _, v8 in pairs(workspace:GetChildren()) do\n        local v9 = v8:FindFirstChild(\"Humanoid\")\n        if v9 and v9.Health > 0 and not game:GetService(\"Players\"):GetPlayerFromCharacter(v8) then\n            local v10 = v8:FindFirstChild(\"HumanoidRootPart\") or v8:FindFirstChild(\"Head\")\n            if v10 then\n                local v11 = (v4.Position - v10.Position).Magnitude\n                if v11 < v6 then\n                    v6, v7 = v11, v10\n                end\n            end\n        end\n    end\n    return v7\nend\n\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    local v12 = v3:FindFirstChildOfClass(\"Tool\") or v1.Backpack:FindFirstChild(\"Fists\")\n    if v12 then\n        local v13 = v5()\n        if v13 then\n            v2.MeleeAttacked:FireServer(v12, 1)\n            v2.MeleeHit:FireServer(v12, v13)\n        end\n    end\nend)","owner":{"_id":"680c3794a89fd911d90c8d30","username":"Cboh","verified":false,"profilePicture":"/images/photo/680c3794a89fd911d90c8d30-1764989424463.png","status":"offline","id":"680c3794a89fd911d90c8d30","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":3002,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-5148fa56c00ca03f1c512b73fb52c731-b429def8c366.