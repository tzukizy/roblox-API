{"slug":"Universal-Script-Chat-message-Script-for-ur-hub-or-script-24943","_id":"6767bb2afe652b5461842286","title":"Chat message Script for ur hub or script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/4094596-1734851370264.png","placeId":0},"features":"chat","tags":[],"script":"local TextChatService = game:GetService(\"TextChatService\")\n\nlocal function SendChatMessage(message)\n    -- Check if the new TextChatService is being used\n    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then\n        -- Send message using the new TextChatService\n        local textChannel = TextChatService.TextChannels.RBXGeneral\n        textChannel:SendAsync(message)\n    else\n        -- Send message using the default chat system\n        game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(message, \"All\")\n    end\nend\n\nSendChatMessage(\"Ur text here\")","owner":{"_id":"674aa52060c60244a8f2c412","username":"forsaken86878","verified":false,"profilePicture":"/images/photo/674aa52060c60244a8f2c412-1739942139853.jpg","status":"offline","id":"674aa52060c60244a8f2c412","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"keyLink":"","views":4485,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-12-22T07:09:30.331Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/4094596-1734851370264.png","executes":103,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53a9e","editBy":{"_id":"674aa52060c60244a8f2c412","username":"forsaken86878","status":"offline","id":"674aa52060c60244a8f2c412"},"message":"Create script","createdAt":"2025-03-27T15:35:24.086Z"}],"comments":[{"_id":"6767ec2b5aa22e33fa358a55","commentBy":{"_id":"6744919b4ea92cf773a10b68","username":"ilas19kiia","verified":false,"role":"user","profilePicture":"/images/user-defau