            remote = rem\n            end\n        end\n    end\n\n    if mineaura and pickaxe and remote and cd > minerate then\n        cd = 0\n        local blocks = {}\n        for _,v in workspace.Places.World.Cubes:GetDescendants() do\n            if v.ClassName == \"Part\" then\n                if v:GetAttribute(\"CubeName\") then\n                    blocks[v.Name] = v.CFrame\n                elseif v.Name == \"Main\" then\n                    blocks[v.Parent.Name] = v.CFrame\n                end\n            end\n        end\n        for i,v in blocks do\n            if (character.HumanoidRootPart.CFrame.Position - v.Position).Magnitude < range then\n                game:GetService(\"ReplicatedStorage\").REM[remote]:FireServer({Position = i})\n            end\n        end\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"views":3248,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/7ba45ca16f816d4fb27fff32fd25e3b9aabed44f78547a37d86a9ef17c112a05.webp","original":"https://scriptblox.com/images/sb/rbx-afda7d0c211ebb7fe4671c81b47a6caf-6b7f1ea40e06.png","scriptblox":"https://scriptblox.com/images/script/rbx-afda7d0c211ebb7fe4671c81b47a6caf-6b7f1ea40e06.png"},"likeCount":4,"dislikeCount":1,"createdAt":"2025-05-16T15:39:35.413Z","executes":19,"keyless":false,"liked":false,"disliked