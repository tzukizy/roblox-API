{"slug":"INTRUDERS-Highlight-the-Monster-231757","_id":"6ac6a1c8a858fed14403b61e","title":"Highlight the Monster","game":{"_id":"6ac6a1c8a858fed14403b61d","gameId":88241416576753,"name":"INTRUDERS 👁","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":88241416576753},"features":"Highlight the Monster","tags":[],"script":"local monster = workspace:FindFirstChild(\"Monster\")\n\nif not monster then\n\twarn(\"Monster not found!\")\n\treturn\nend\n\nlocal hl = Instance.new(\"Highlight\")\nhl.Name = \"Glow\"\nhl.FillColor = Color3.fromRGB(255, 0, 0)\nhl.FillTransparency = 0.5\nhl.OutlineColor = Color3.fromRGB(255, 0, 0)\nhl.OutlineTransparency = 0\nhl.Parent = monster\n\nlocal gui = Instance.new(\"BillboardGui\")\ngui.Name = \"NameTag\"\ngui.Size = UDim2.new(0, 150, 0, 40)\ngui.AlwaysOnTop = true\n\nlocal offset = Vector3.new(0, 2.5, 0)\nif monster:IsA(\"Model\") then\n\tgui.Adornee = monster.PrimaryPart or monster:FindFirstChildWhichIsA(\"BasePart\")\n\tif monster:FindFirstChild(\"Head\") then\n\t\tgui.Adornee = monster.Head\n\t\toffset = Vector3.new(0, 2, 0)\n\tend\nelse\n\tgui.Adornee = monster\nend\ngui.ExtentsOffset = offset\n\nlocal txt = Instance.new(\"TextLabel\")\ntxt.Size = UDim2.new(1, 0, 1, 0)\ntxt.BackgroundTransparency = 1\ntxt.Text = \"Monster\"\ntxt.TextColor3 = Color3.fromRGB(255, 0, 0)\ntxt.TextSize = 28\ntxt.Font = Enum.Font.SourceSansBold\ntxt.TextStrokeColor3 = Color3.new(0, 0, 0)\ntxt.TextStrokeTransparency = 0\ntxt.Parent = gui\n\ngui.Parent = monster","owner":{"_id":"68642d3572e8e01d0057b433","username":"e01188306","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"lvl":5,"status":"offline","id":"68642d3572e8e01d0057b433","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyl