{"_id":"669442016496c7c2f08b80cf","title":"fps viewer","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/4d50a3343889569f0696916c09d1b118a688081238557f49394a51e38e147d1c.webp","original":"https://scriptblox.com/images/sb/8827744-1720992257417.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/4d50a3343889569f0696916c09d1b118a688081238557f49394a51e38e147d1c.webp","original":"https://scriptblox.com/images/sb/8827744-1720992257417.png"},"placeId":0},"slug":"Universal-Script-fps-viewer-15542","verified":false,"key":false,"keyless":false,"views":33481,"executes":155,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/699c5947f68bb925998aeda600c60851b136c2053ba2e29d0bf31b89cc405409.webp","original":"https://scriptblox.com/images/sb/8827744-1720992257417.png","scriptblox":"https://scriptblox.com/images/script/8827744-1720992257417.png"},"thumbnail":{"url":"https://media.kocakz.me/699c5947f68bb925998aeda600c60851b136c2053ba2e29d0bf31b89cc405409.webp","original":"https://scriptblox.com/images/sb/8827744-1720992257417.png","scriptblox":"https://scriptblox.com/images/script/8827744-1720992257417.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2024-07-14T21:24:17.774Z","updatedAt":"2024-07-14T21:24:17.774Z","lastBump":"2024-07-14T21:24:17.774Z","script":"-- GUI elemanlarını oluşturmak için kullanacağımız servisleri çağırıyoruz\nlocal GuiService = game:GetService(\"GuiService\")\nlocal Players = game:GetService(\"Players\")\n\n-- GUI için ScreenGui objesi oluşturuyoruz\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"FPSCounter\" -- ScreenGui'nin adını ayarlıyoruz\nscreenGui.Parent = Players.LocalPlayer:WaitForChild(\"PlayerGui\") -- Oyuncunun ekran GUI'sine ekliyoruz\n\n-- FPS değerini gösterecek metin kutusunu oluşturuyoruz\nlocal fpsDisplay = Instance.new(\"TextLabel\")\nfpsDisplay.Name = \"FPSDisplay\" -- Metin kutusunun adını ayarlıyoruz\nfpsDisplay.Size = UDim2.new(0, 100, 0, 20) -- Boyutunu ayarlıyoruz\nfpsDisplay.Position = UDim2.new(0, 10, 0, 10) -- Konumunu ayarlıyoruz\nfpsDisplay.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Arka plan rengini ayarlıyoruz\nfpsDisplay.TextColor3 = Color3.fromRGB(255, 255, 255) -- Metin rengini ayarlıyoruz\nfpsDisplay.TextSize = 18 -- Metin boyutunu ayarlıyoruz\nfpsDisplay.Font = Enum.Font.SourceSans -- Kullanılacak fontu ayarlıyoruz\nfpsDisplay.Text = \"FPS: --\" -- Başlangıç metnini ayarlıyoruz\n\n-- Metin kutusunu ScreenGui içine ekliyoruz\nfpsDisplay.Parent = screenGui\n\n-- FPS değerini güncelleyecek olan işlevi tanımlıyoruz\nlocal function updateFPS()\n    local fps = 1 / game:GetService(\"RunService\").RenderStepped:Wait() -- Mevcut FPS değerini hesaplıyoruz\n    fpsDisplay.Text = string.format(\"FPS: %.2f\", fps) -- Metin kutusunu güncelliyoruz\nend\n\n-- Her kare yenilemesinde FPS değerini güncellemek için bir döngü oluşturuyoruz\nwhile true do\n    updateFPS() -- FPS değerini güncelliyoruz\n    wait(1) -- 1 saniye bekliyoruz (FPS değerini her saniye bir kez güncellemek için)\nend\n","features":"idk","tags":[],"discord":"","keyLink":"","owner":{"_id":"65d105e32e7e709b61c6b8a6","username":"battybat","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4d508c1a64b45f4be96acf2851a23c5be0431a9173388faa17babe992f1320d6.webp","original":"https://scriptblox.com/images/photo/65d105e32e7e709b61c6b8a6-1721067852630.jpeg"},"status":"offline","id":"65d105e32e7e709b61c6b8a6","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/4d508c1a64b45f4be96acf2851a23c5be0431a9173388faa17babe992f1320d6.webp","original":"https://scriptblox.com/images/photo/65d105e32e7e709b61c6b8a6-1721067852630.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":