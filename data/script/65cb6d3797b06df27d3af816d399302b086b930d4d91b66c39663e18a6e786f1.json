 \"velocity\"\n\tLV.Parent = character\n\tLV.ForceLimitsEnabled = false\n\tLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector\n\tLV.Attachment0 = character.HumanoidRootPart.Attachment\n\tLV.RelativeTo = Enum.ActuatorRelativeTo.Attachment0\n\tLV.VectorVelocity = velocity\n\ttask.wait(0.1)\n\tLV:Destroy()\nend\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input, gpe)\n\tif not gpe then\n\t\tif input.KeyCode == Enum.KeyCode.X then\n\t\t\tpuhs(Vector3.new(0, 0, -100))\n\t\telseif input.KeyCode == Enum.KeyCode.V and fly_enabled == true then\n\t\t\tpuhs(Vector3.new(0, 50, 0))\n\t\tend\n\tend\nend)","features":"you can press x and then spin really fast to fling yourself\npretty cool","tags":[],"discord":"","keyLink":"","owner":{"_id":"6949b81d02c26daa6da41c00","username":"somerandom6795","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6949b81d02c26daa6da41c00","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:41:29.159Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6aa736f6b225c47e8ebaa7a3","editBy":{"_id":"6949b81d02c26daa6da41c00","username":"somerandom6795","status":"offline","id":"6949b81d02c26daa6da41c00"},"message":"Create script","createdAt":"2026-09-13T23:51:18.788Z"}],"comments":[{"_id":"6aa75ac0375fccc367861e53","commentBy":{"_id":"6aa75aa24a74e6b7ac0d2c78","username":"xpert","verified":false,"keylessCreator":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-10-15T16:18:11.453Z","createdAt":"2026-09-14T02:23:30.295Z","lvl":3,"status":"offline","id":"6aa75aa24a74e6b7ac0