.DelayDodgeNormal)\n                    task.spawn(Dodge)\n                end\n            end)\n        end\n    end\n    return oldf(v326)\nend\nMain.DashHighlight = function(v312)\n    local Character = v312[2]\n    if LockedOn.Value and LockedOn.Value == Character then\n        if getDistance() then\n            keyrelease(0x46)\n            mouse1press()\n            task.wait()\n            mouse1release()\n            rconsoleprint(\"UserDodgingPremature\")\n        end\n    end\n    return oldf2(v312)\nend\n\nMORE: https://discord.gg/s3kPQQgMe9","features":"-","tags":[],"discord":"","keyLink":"","owner":{"_id":"672bf91254a18696ef902989","username":"scriptlol","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a7e111ecda98848a8f7ed3c066aba4de516b9e008bc05d436358a5137a0a39c1.webp","original":"https://scriptblox.com/images/photo/672bf91254a18696ef902989-1742113423738.jpg"},"status":"offline","id":"672bf91254a18696ef902989","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/a7e111ecda98848a8f7ed3c066aba4de516b9e008bc05d436358a5137a0a39c1.webp","original":"https://scriptblox.com/images/photo/672bf91254a18696ef902989-1742113423738.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:06:51.081Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c55af5","editBy":{"_id":"672bf91254a18696ef902989","username":"scriptlol","status":"offline","id":"672bf91254a18696ef902989"},"message":"Create script","createdAt":"2025-03-27T23:12:18.885Z"}],"comments":[{"_id":"67d76f8aecba20b6147248c7","commentBy":{"_id":"672eac3b84d50485a7cf130d","username":"UnequaledUnrivaled","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/de8babb36295935df862224cc9b920721bda9c921c54b06da6f6621337c402d8.webp","o