m.Material.Plastic\n        v.Reflectance = 0\n        v.CastShadow = false\n    elseif v:IsA(\"Decal\") or v:IsA(\"Texture\") then\n        v.Transparency = math.clamp(v.Transparency + 0.2, 0, 1)\n    elseif v:IsA(\"ParticleEmitter\") or v:IsA(\"Trail\") then\n        v.Enabled = false\n    end\nend\n\n-- Terrain optimization\nif Terrain then\n    Terrain.WaterWaveSize = 0\n    Terrain.WaterWaveSpeed = 0\n    Terrain.WaterReflectance = 0\n    Terrain.WaterTransparency = 1\nend\n\nprint(\"FPS Booster loaded 👍\")","features":"Fps booster 💪🏻 \n\nAlso subscribe to / @MidnightQhantom-rtb","tags":["fps booster","Ya"],"discord":"","keyLink":"","owner":{"_id":"67bf791485438d6878dd9127","username":"harley4445rob87","verified":false,"profilePicture":{"url":"https://media.kocakz.me/70285ebea1c7a105807738f79168bc368411c07715ad7bdfa615977b2bfb18c9.webp","original":"https://scriptblox.com/images/photo/67bf791485438d6878dd9127-1765759947119.jpg"},"status":"offline","id":"67bf791485438d6878dd9127","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/70285ebea1c7a105807738f79168bc368411c07715ad7bdfa615977b2bfb18c9.webp","original":"https://scriptblox.com/images/photo/67bf791485438d6878dd9127-1765759947119.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:51:03.230Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693f5b849be37dfffd8d43b6","editBy":{"_id":"67bf791485438d6878dd9127","username":"harley4445rob87","status":"offline","id":"67bf791485438d6878dd9127"},"message":"Create script","createdAt":"2025-12-15T00:51:16.363Z"}],"comments":[{"_id":"693f9e4f53e4ff1d246c6261","commentBy":{"_id":"693a6def06da572cb7fbc7fe","username":"obama_21","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"la