\n        \"Damaged\", \"Earth\", \"Painted Blue\", \"Painted Green\", \"Painted Red\", \n        \"Painted Pink\", \"Painted Purple\", \"Green Sentry\", \"Pink Sentry\", \n        \"Red Sentry\", \"Royal\", \"Fallen Agent\"\n    }\n    local guns = {\"SMG\", \"LMG\", \"Double Barrel Shotgun\", \"Revolver\", \"AK47\", \"Turret\", \"Shotgun\"}\n\n    for _, g in ipairs(guns) do\n        for _, s in ipairs(skins) do\n            local evArgs = {\n                [1] = \"SellSkin\",\n                [2] = g,\n                [3] = s\n            }\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteEvent\"):FireServer(unpack(evArgs))\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteEvent\"):FireServer(unpack(evArgs))\n        end\n    end\nend\n\nsell()\nroll()\n\nlocal rollConnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\n    roll()\nend)","features":"Only rolls premium crates\n\n\ncreds to arquivehacks","tags":[],"discord":"","keyLink":"","owner":{"_id":"669501a2444f3b3c25ab6a28","username":"HamborBear","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"669501a2444f3b3c25ab6a28","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:12:14.057Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4dad0","editBy":{"_id":"669501a2444f3b3c25ab6a28","username":"HamborBear","status":"offline","id":"669501a2444f3b3c25ab6a28"},"message":"Create script","createdAt":"2025-02-25T03:14:50.195Z"},{"_id":"67e5e1e7b360710ec3c551ef","editBy":{"_id":"669501a2444f3b3c25ab6a28","username":"HamborBear","status":"offline","