{"slug":"Universal-Script-Click-teleport-42603","_id":"68521e53ac15ee5efb8f0c75","title":"Click teleport","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Click and teleport","tags":[],"script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal mouse = player:GetMouse()\n\nlocal canTeleport = false\n\n-- When V is pressed down\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.V then\n        canTeleport = true\n    end\nend)\n\n-- When V is released\nUserInputService.InputEnded:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.V then\n        canTeleport = false\n    end\nend)\n\n-- Teleport on click if V is held\nmouse.Button1Down:Connect(function()\n    if canTeleport then\n        local character = player.Character\n        local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\n        if hrp then\n            local targetPos = mouse.Hit.p\n            hrp.CFrame = CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z)\n        end\n    end\nend)\n","owner":{"_id":"683756a8440874f0e1b6b537","username":"literallymymail1234","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"683756a8440874f0e1b6b537","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":2340,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/a78da2ba081d31b152ac5d2223de0ed26b0d455b