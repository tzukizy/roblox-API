{"slug":"Universal-Script-Wide-head-script-33974","_id":"67ee45a1bb5cfb3868ea30ad","title":"Wide head script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1743668641515.png","placeId":0},"features":"Makes your head WIIIDE and then rejoins you","tags":["Funny","Widehead"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal head = character:WaitForChild(\"Head\")\nlocal scaleFactor = 1.3 \n\n\nlocal function changeHeadWidth()\n    local newSize = Vector3.new(head.Size.X * scaleFactor, head.Size.Y, head.Size.Z)\n    head.Size = newSize\nend\n\n\nlocal screenGui = Instance.new(\"ScreenGui\", player.PlayerGui)\nlocal textLabel = Instance.new(\"TextLabel\", screenGui)\n\ntextLabel.Size = UDim2.new(0, 300, 0, 100)\ntextLabel.Position = UDim2.new(0.5, -150, 0.5, -50)\ntextLabel.Text = \"Enjoy your wide head hehhehehe\"\ntextLabel.TextColor3 = Color3.new(1, 0, 0)\ntextLabel.BackgroundTransparency = 1\ntextLabel.Font = Enum.Font.SourceSansBold\ntextLabel.TextSize = 24\n\n\nlocal function rejoinGame()\n    wait(6)\n    game:GetService(\"TeleportService\"):Teleport(game.PlaceId, player)\nend\n\n\nspawn(rejoinGame)\n\nwhile true do\n    changeHeadWidth()\n    wait(0.1)\nend","owner":{"_id":"67d969d573dfe8a58fa0bd40","username":"9qvyxvgbx","verified":false,"profilePicture":"/images/photo/67d969d573dfe8a58fa0bd40-1743668834364.png","status":"offline","id":"67d969d573dfe8a58fa0bd40"},"verified":false,"views":3031,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1743668641515.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-04-03T08:24:01.554Z","executes":25,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67ee45a1bb5cfb3868ea30af","editBy":{"_id":"67d969d573dfe8a58fa0bd40","username":"9qvyxvgbx","status":"offline","id":"67d969d573dfe8a58fa0bd4