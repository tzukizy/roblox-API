{"slug":"Universal-Script-Cant-Zoom-Out-29423","_id":"67b1cac89d76bbab74f95cbc","title":"Cant Zoom Out","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/8731017-1739705032024.png","placeId":0},"features":"Cant Zoom Out Anymore","tags":["no zoom","zoom","out","zoom out"],"script":"local player = game.Players.LocalPlayer\nlocal camera = player.CameraMaxZoomDistance\n\n-- Set zoom to the minimum (first-person)\nplayer.CameraMaxZoomDistance = 0.5\nplayer.CameraMinZoomDistance = 0.5\n\n-- Prevent zooming out\nplayer:GetPropertyChangedSignal(\"CameraMaxZoomDistance\"):Connect(function()\n    player.CameraMaxZoomDistance = 0.5\nend)\n\nplayer:GetPropertyChangedSignal(\"CameraMinZoomDistance\"):Connect(function()\n    player.CameraMinZoomDistance = 0.5\nend)","owner":{"_id":"669baa3fda184578a6da01c7","username":"4321","verified":false,"profilePicture":"/images/photo/669baa3fda184578a6da01c7-1725305264416.png","status":"offline","id":"669baa3fda184578a6da01c7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":2321,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-02-16T11:23:52.146Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/8731017-1739705032024.png","executes":164,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54df2","editBy":{"_id":"669baa3fda184578a6da01c7","username":"4321","status":"offline","id":"669baa3fda184578a6da01c7"},"message":"Create script","createdAt":"2025-03-27T07:06:03.505Z"}],"comments":[]}