{"slug":"Universal-Script-Speed-gui-15897","_id":"669e344cfab9a0ab3ebddbc5","title":"Speed gui (my script)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"I dunno","tags":[],"script":"--Create ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"SpeedChangerGui\"\nscreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n\n-- Make the ScreenGui moveable\nlocal mainFrame = Instance.new(\"Frame\")\nmainFrame.Size = UDim2.new(0, 300, 0, 200)\nmainFrame.Position = UDim2.new(0.5, -150, 0.5, -100)\nmainFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)\nmainFrame.Active = true\nmainFrame.Draggable = true\nmainFrame.Parent = screenGui\n\n-- Input Bar\nlocal inputBox = Instance.new(\"TextBox\")\ninputBox.Size = UDim2.new(0, 200, 0, 50)\ninputBox.Position = UDim2.new(0.5, -100, 0.3, -25)\ninputBox.PlaceholderText = \"Enter Speed\"\ninputBox.Parent = mainFrame\n\n-- Change Speed Button\nlocal changeSpeedButton = Instance.new(\"TextButton\")\nchangeSpeedButton.Size = UDim2.new(0, 100, 0, 50)\nchangeSpeedButton.Position = UDim2.new(0.5, -50, 0.7, -25)\nchangeSpeedButton.Text = \"Change Speed\"\nchangeSpeedButton.Parent = mainFrame\n\n-- Close (X) Button\nlocal closeButton = Instance.new(\"TextButton\")\ncloseButton.Size = UDim2.new(0, 25, 0, 25)\ncloseButton.Position = UDim2.new(1, -30, 0, 5)\ncloseButton.Text = \"X\"\ncloseButton.Parent = mainFrame\n\n-- + Button (Initially hidden)\nlocal openButton = Instance.new(\"TextButton\")\nopenButton.Size = UDim2.new(0, 25, 0, 25)\nopenButton.Position = UDim2.new(1, -30, 0, 5)\nopenButton.Text = \"+\"\nopenButton.Parent = screenGui\nopenButton.Visible = false\n\n-- Function to change player speed\nlocal function changeSpeed()\n    local speed = tonumber(inputBox.Text)\n    if speed then\n        game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = speed\n    else\n        warn(\"Please enter a valid number\")\n    end\nend\n\n-- Event listeners\nchangeSpeedButton.MouseButton1Click:Connect(changeSpeed)\n\ncloseButton.MouseButton1Click:Connect(function()\n    mainFrame.Visible = false\n    openButton.Visible = true\nend)\n\nopenButton.MouseButton1Click:Connect(function()\n    mainFrame.Visible = true\n    openButton.Visible = false\nend)","owner":{"_id":"668fc45229759ad2be9cfb6b","username":"Fanumtax7979","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"668fc45229759ad2be9cfb6b","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":45834,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-07-22T10:28:28.824Z","dislikeCount":1,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/7fb904778d5d8038bfe43eb78a5b20c793a25fd94d7655f28b02ff1be665d0a5.webp","original":"https://scriptblox.com/images/sb/4916098-1721644108757.png","scriptblox":"https://scriptblox.com/images/script/4916098-1721644108757.png"},"executes":66,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T04:43:48.612Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/7fb904778d5d8038bfe43eb78a5b20c793a25fd94d7655f28b02ff1be665d0a5.webp","original":"https://scriptblox.com/images/sb/4916098-1721644108757.png","scriptblox":"https://scriptblox.com/images/script/4916098-1721644108757.png"},"changelog":[{"_id":"67e5e1e5b360710ec3c51719","editBy":{"_id":"668fc45229759ad2be9cfb6b","username":"Fanumtax7979","status":"offline","id":"668fc45229759ad2be9cfb6b"},"message":"Cre