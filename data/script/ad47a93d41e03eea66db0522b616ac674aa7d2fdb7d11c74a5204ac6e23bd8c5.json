{"slug":"Universal-Script-Custom-Animations-57531","_id":"68e95916fc6913af8fe0c208","title":"Custom Animations","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1760123158414.png","placeId":0},"features":"literally just changes your animations for the ones you put","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\n\nlocal animations = {\n    idle = 80979207,  -- RAHPLACE\n    walk = 80979216,  -- replace \n    jump = 80979216,  -- replace \n    fall = 80979216   -- replace \n}\n\nlocal function playAnimation(animId)\n    local anim = Instance.new(\"Animation\")\n    anim.AnimationId = \"rbxassetid://\" .. animId\n    local track = humanoid:LoadAnimation(anim)\n    track.Priority = Enum.AnimationPriority.Action\n    track:Play()\n    return track\nend\n\nfor _, track in pairs(humanoid:GetPlayingAnimationTracks()) do\n    track:Stop()\nend\n\nlocal tracks = {}\n\ntracks.idle = playAnimation(animations.idle)\n\nhumanoid.Running:Connect(function(speed)\n\n    for _, t in pairs(tracks) do if t and t.IsPlaying then t:Stop() end end\n    if speed > 0 then\n        tracks.walk = playAnimation(animations.walk)\n    else\n        tracks.idle = playAnimation(animations.idle)\n    end\nend)\n\nhumanoid.StateChanged:Connect(function(_, state)\n\n    for _, t in pairs(tracks) do if t and t.IsPlaying then t:Stop() end end\n\n    if state == Enum.HumanoidStateType.Jumping then\n        tracks.jump = playAnimation(animations.jump)\n    elseif state == Enum.HumanoidStateType.Freefall then\n        tracks.fall = playAnimation(animations.fall)\n    elseif state == Enum.HumanoidStateType.Landed then\n        tracks.idle = playAnimation(animations.idle)\n    end\nend)\n","owner":{"_id":"68c08260a756eaef5f335325","username":"gaspXcripter","verified":false,"profilePicture":"/images/photo/68c08260a756eaef5f335325-1780989266034.jpg","status":"offline","id":"68c08260a756eaef5f335325","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":4046,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1760123158414.png","likeCount":4,"dislikeCount":0,"createdAt":"2025-10-10T19:05:58.425Z","executes":113,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e95916fc6913af8fe0c20e","editBy":{"_id":"68c08260a756eaef5f335325","username":"gaspXcripter","status":"offline","id":"68c08260a756eaef5f335325"},"message":"AAAUGUGGHHGHFGHGHGHGDFG","createdAt":"2025-10-10T19:05:58.428Z"}],"comments":[{"_id":"68e95941cc090563b04fe2ef","commentBy":{"_id":"6890cce5b01bf0dbf0aab066","username":"Unverifed","verified":false,"role":"user","profilePicture":"/images/photo/6890cce5b01bf0dbf0aab066-1773018394602.jpg","createdAt":"2025-08-04T15:08:21.317Z","lastActive":"2026-04-05T00:07:44.106Z","status":"offline","id":"6890cce5b01bf0dbf0aab066","topMilestone":{"key":"creator.followers","tier":10}},"text":"This is trash","edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-10T19:06:41.355Z","liked":false,"disliked":false},{"_id":"68e959a9a3a39cb545899081","commentBy":{"_id":"68c08260a756eaef5f335325","username":"gaspXcripter","verified":false,"role":"user","profilePicture":"/images/photo/68c08260a756eaef5f335325-1780989266034.jpg","createdAt":"2025-09-09T19:39:12.896Z","lastActive":"2026-07-06T10:51:26.311Z","status":"offline","id":"68c08260a756eaef5f335325","topMilestone":{"key":"creator.scripts","tier":5}},"text":"@xyclol I PUBLISHED IT A MINUTE AGO WHA- anyways thanks for this comment!","parent":{"_id":"68e95941cc090563b04fe2ef","commentBy":{"_id":"6890cce5b01bf0dbf0aab066","username":"Unverifed","profilePicture":"/images/photo/6890cce5b01bf0dbf0aab066-1773018394602.jpg","status":"offline","id":"6890cce5b01bf0dbf0aab066"},"text