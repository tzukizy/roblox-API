{"_id":"68e95916fc6913af8fe0c208","title":"Custom Animations","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/1df9eb6ec1124c55d644bc7990934bf7cd0444ebd6b417246cebb781eefa9225.webp","original":"https://scriptblox.com/images/sb/0-1760123158414.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/1df9eb6ec1124c55d644bc7990934bf7cd0444ebd6b417246cebb781eefa9225.webp","original":"https://scriptblox.com/images/sb/0-1760123158414.png"},"placeId":0},"slug":"Universal-Script-Custom-Animations-57531","verified":false,"key":false,"keyless":false,"views":4171,"executes":171,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/95c4aa80ff3b387da651e11231d4d1a2c8a3c999c54a868a92675f0dc99cf6e6.webp","original":"https://scriptblox.com/images/sb/0-1760123158414.png","scriptblox":"https://scriptblox.com/images/script/0-1760123158414.png"},"thumbnail":{"url":"https://media.kocakz.me/95c4aa80ff3b387da651e11231d4d1a2c8a3c999c54a868a92675f0dc99cf6e6.webp","original":"https://scriptblox.com/images/sb/0-1760123158414.png","scriptblox":"https://scriptblox.com/images/script/0-1760123158414.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2025-10-10T19:05:58.425Z","updatedAt":"2025-10-10T19:05:58.425Z","lastBump":"2025-10-10T19:05:58.425Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\n\nlocal animations = {\n    idle = 80979207,  -- RAHPLACE\n    walk = 80979216,  -- replace \n    jump = 80979216,  -- replace \n    fall = 80979216   -- replace \n}\n\nlocal function playAnimation(animId)\n    local anim = Instance.new(\"Animation\")\n    anim.AnimationId = \"rbxassetid://\" .. animId\n    local track = humanoid:LoadAnimation(anim)\n    track.Priority = Enum.AnimationPriority.Action\n    track:Play()\n    return track\nend\n\nfor _, track in pairs(humanoid:GetPlayingAnimationTracks()) do\n    track:Stop()\nend\n\nlocal tracks = {}\n\ntracks.idle = playAnimation(animations.idle)\n\nhumanoid.Running:Connect(function(speed)\n\n    for _, t in pairs(tracks) do if t and t.IsPlaying then t:Stop() end end\n    if speed > 0 then\n        tracks.walk = playAnimation(animations.walk)\n    else\n        tracks.idle = playAnimation(animations.idle)\n    end\nend)\n\nhumanoid.StateChanged:Connect(function(_, state)\n\n    for _, t in pairs(tracks) do if t and t.IsPlaying then t:Stop() end end\n\n    if state == Enum.HumanoidStateType.Jumping then\n        tracks.jump = playAnimation(animations.jump)\n    elseif state == Enum.HumanoidStateType.Freefall then\n        tracks.fall = playAnimation(animations.fall)\n    elseif state == Enum.HumanoidStateType.Landed then\n        tracks.idle = playAnimation(animations.idle)\n    end\nend)\n","features":"literally just changes your animations for the ones you put","tags":[],"discord":"","keyLink":"","owner":{"_id":"68c08260a756eaef5f335325","username":"gaspXcripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6cead3b74078b1b42e876521a1f0d0ac3f9a3fdaec8bb795ea7177bf1c6fcbcf.webp","original":"https://scriptblox.com/images/photo/68c08260a756eaef5f335325-1780989266034.jpg"},"status":"offline","id":"68c08260a756eaef5f335325","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/6cead3b74078b1b42e876521a1f0d0ac3f9a3fdaec8bb795ea7177bf1c6fcbcf.webp","original":"https://scriptblox.com/images/photo/68c08260a756eaef5f335325-1780989266034.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:41:02.093Z","last":"","win":14,"math":4},"isHub":false,"supportedGames