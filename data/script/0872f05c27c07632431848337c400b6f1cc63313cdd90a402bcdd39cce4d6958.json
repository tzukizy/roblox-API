{"_id":"67ffcada619fbe3fd48ac120","title":"Noli Animations","game":{"_id":"67e5e1ffb360710ec3c77d16","gameId":18687417158,"name":"[UPD 🤖] Forsaken","imageUrl":{"url":"https://media.kocakz.me/55c63f4536bf7d7bc64ae4790ce09991292df76f7f106aec1d34b24f3d67efa3.webp","original":"https://tr.rbxcdn.com/180DAY-9ac77b9e9552150c8e485ddf26dac48f/150/150/Image/Png/noFilter"},"slug":"18687417158-forsaken","path":"/game/18687417158-forsaken","thumbnail":{"url":"https://media.kocakz.me/55c63f4536bf7d7bc64ae4790ce09991292df76f7f106aec1d34b24f3d67efa3.webp","original":"https://tr.rbxcdn.com/180DAY-9ac77b9e9552150c8e485ddf26dac48f/150/150/Image/Png/noFilter"},"placeId":18687417158},"slug":"Forsaken-Noli-Animations-35836","verified":false,"key":false,"keyless":false,"views":26143,"executes":171,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-b644e084c0a8d210a6ecd7199ce66a9a-cfd22090482b.png","scriptblox":"https://scriptblox.com/images/script/rbx-b644e084c0a8d210a6ecd7199ce66a9a-cfd22090482b.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-b644e084c0a8d210a6ecd7199ce66a9a-cfd22090482b.png","scriptblox":"https://scriptblox.com/images/script/rbx-b644e084c0a8d210a6ecd7199ce66a9a-cfd22090482b.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-04-16T15:20:58.016Z","updatedAt":"2025-04-16T15:20:58.016Z","lastBump":"2025-04-16T15:20:58.016Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\n\nlocal function setupAnimations(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n\n    -- Disable Animate if present\n    local animate = character:FindFirstChild(\"Animate\")\n    if animate then\n        animate.Disabled = true\n    end\n\n    -- Load custom animations\n    local idleAnim = Instance.new(\"Animation\")\n    idleAnim.AnimationId = \"rbxassetid://83465205704188\"\n\n    local moveAnim = Instance.new(\"Animation\")\n    moveAnim.AnimationId = \"rbxassetid://103292185212679\"\n\n    local idleTrack = humanoid:LoadAnimation(idleAnim)\n    local moveTrack = humanoid:LoadAnimation(moveAnim)\n\n    idleTrack.Priority = Enum.AnimationPriority.Action  -- Higher than Core\n    moveTrack.Priority = Enum.AnimationPriority.Movement\n\n    idleTrack:Play()\n\n    RunService.Heartbeat:Connect(function()\n        local speed = humanoid.MoveDirection.Magnitude\n\n        -- Force-stop other idle animations\n        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do\n            if track.Animation.AnimationId ~= idleAnim.AnimationId\n                and track.Animation.AnimationId ~= moveAnim.AnimationId then\n                if track.Priority == Enum.AnimationPriority.Core\n                    or track.Name == \"idle\"\n                    or track.Animation.AnimationId:lower():find(\"idle\") then\n                    track:Stop()\n                end\n            end\n        end\n\n        if speed > 0.01 then\n            if not moveTrack.IsPlaying then\n                idleTrack:Stop()\n                moveTrack:Play()\n            end\n        else\n            if not idleTrack.IsPlaying then\n                moveTrack:Stop()\n                idleTrack:Play()\n            end\n        end\n    end)\nend\n\n-- Support for current and future character loads\nif player.Character then\n    setupAnimations(player.Character)\nend\n\nplayer.CharacterAdded:Connect(setupAnimations)\n\n\n","features":"once again the same script, but with noli's animations this time.","tags":[],"discord":"","keyLink":"","owner":{"_id":"66b1d5518a2370184e5506b4","username":"nachovazsua","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66b1d5518a2370184e5506b4","to