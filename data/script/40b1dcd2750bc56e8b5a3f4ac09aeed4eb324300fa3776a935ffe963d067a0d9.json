{"_id":"62fd4bcd74e75bac069d4ae8","title":"Auto Beg","game":{"_id":"67e5e1ffb360710ec3c77d2f","gameId":8737602449,"name":"PLS DONATE 💸","imageUrl":{"url":"https://media.kocakz.me/eb071371613b2f9c58dce9d521b70c1d6856730011350e7bdc7e0f42cdb580de.webp","original":"https://tr.rbxcdn.com/180DAY-a8c2faf226f0d89bed86a7d5e9683789/150/150/Image/Png/noFilter"},"slug":"8737602449-pls-donate","path":"/game/8737602449-pls-donate","thumbnail":{"url":"https://media.kocakz.me/eb071371613b2f9c58dce9d521b70c1d6856730011350e7bdc7e0f42cdb580de.webp","original":"https://tr.rbxcdn.com/180DAY-a8c2faf226f0d89bed86a7d5e9683789/150/150/Image/Png/noFilter"},"placeId":8737602449},"slug":"PLS-DONATE-NEW-Auto-Beg-4958","verified":false,"key":false,"keyless":false,"views":28295,"executes":314,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/1c02976792570f2345b24e8ae9adc7cd/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/1c02976792570f2345b24e8ae9adc7cd/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/1c02976792570f2345b24e8ae9adc7cd/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/1c02976792570f2345b24e8ae9adc7cd/500/280/Image/Jpeg"},"likeCount":5,"dislikeCount":0,"createdAt":"2022-08-17T20:13:01.219Z","updatedAt":"2022-08-17T20:13:01.219Z","lastBump":"2022-08-17T20:13:01.219Z","script":"local Players = game:GetService(\"Players\")\nlocal lp = Players.LocalPlayer\nlocal cooldown = 10\nlocal minimumDonated = 5000\nlocal mostDonated = false\n\n--//Messages\\\\\n\nlocal msgs = {\n    \"give me your robux\",\n    \"Can you donate to me?\",\n    \"placeholder\",\n    \"placeholder\",\n}\n--//Script\\\\\nif mostDonated == true then\n    for i, v in next, Players:GetPlayers() do\n        if v.Name ~= lp.Name and v.leaderstats:WaitForChild(\"Donated\").Value > minimumDonated then\n            lp.Character.Humanoid:MoveTo(v.Character.HumanoidRootPart.Position)\n            wait(4)\n            game.ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(\n                msgs[math.random(1, #msgs)],\n                \"All\"\n            )\n            wait(cooldown)\n        end\n    end\nelseif mostDonated == false then\n    for i, v in next, Players:GetPlayers() do\n        if v.Name ~= lp.Name then\n            lp.Character.Humanoid:MoveTo(v.Character.HumanoidRootPart.Position)\n            wait(4)\n            game.ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(\n                msgs[math.random(1, #msgs)],\n                \"All\"\n            )\n            wait(cooldown)\n        end\n    end\nend","features":"This is a simple script that goes to random people saying phrases that you choose. \n\n\nmostDonated = If set to true, the script will walk to people who are over the minimum donated amount that you set in minimumDonated. If set to false it will walk to random people. [true/false]\nminimumDonated = Only used if mostDonated is set to true. This is the minimum amount of donated Robux that your target has donated. For example if I set minimumDonated to 500 then it will walk to only others who have donated over 500+ Robux.\ncooldown = Cooldown until you walk to another person.\n\nThis doesn't loop btw, make sure you dont interact to avoid bugs\nMake sure you claim a stand or buy a Donation Sign so people can donate to you\nYou can edit and add how many messages you want\n\nMade by me \\ dank#6969 \\ ban#1337","tags":["kanto","robux","free"],"discord":"","keyLink":"","owner":{"_id":"62941372ee6d3da00e98d0ab","username":"donk","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7ac0809cf7a4858a06b15be03baf7549a701aa3a46bcd723f7d30c1c9dbe3268.webp","original":"https://scriptblox.com/images/photo/62941372ee6d3da00e98d0ab-1722364853720.jpg"},"status":"offline","id":"62941372ee6d3da0