{"_id":"690d32265c6a4a8360e6857b","title":"Simple And Open Source","game":{"_id":"6906d0c47b209fc53248af90","gameId":94101948530988,"name":"[OGURI CAP MASTERY] Uma Racing","imageUrl":{"url":"https://media.kocakz.me/3ed212ab8613c2fe2d5ce6fc2ad969695ff447708c667e2d5ab7d0368630cfdf.webp","original":"https://tr.rbxcdn.com/180DAY-a8bd217b7a7c192201ae8ec71fb6a7b0/150/150/Image/Png/noFilter"},"slug":"94101948530988-uma-racing","path":"/game/94101948530988-uma-racing","thumbnail":{"url":"https://media.kocakz.me/3ed212ab8613c2fe2d5ce6fc2ad969695ff447708c667e2d5ab7d0368630cfdf.webp","original":"https://tr.rbxcdn.com/180DAY-a8bd217b7a7c192201ae8ec71fb6a7b0/150/150/Image/Png/noFilter"},"placeId":94101948530988},"slug":"UPDATE-1.0-Uma-Racing-Simple-And-Open-Source-63947","verified":false,"key":false,"keyless":false,"views":358909,"executes":1414,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/10a65bbce29eeeafdf3eeb154ce169df5d653f7bf0b5efa5d59b6e9621e44ac2.webp","original":"https://scriptblox.com/images/sb/rbx-9d5faa9a97848a476c78b467a26d18e8-ca2c92a44925.png","scriptblox":"https://scriptblox.com/images/script/rbx-9d5faa9a97848a476c78b467a26d18e8-ca2c92a44925.png"},"thumbnail":{"url":"https://media.kocakz.me/10a65bbce29eeeafdf3eeb154ce169df5d653f7bf0b5efa5d59b6e9621e44ac2.webp","original":"https://scriptblox.com/images/sb/rbx-9d5faa9a97848a476c78b467a26d18e8-ca2c92a44925.png","scriptblox":"https://scriptblox.com/images/script/rbx-9d5faa9a97848a476c78b467a26d18e8-ca2c92a44925.png"},"likeCount":5,"dislikeCount":1,"createdAt":"2025-11-06T23:41:26.627Z","updatedAt":"2025-11-06T23:41:26.627Z","lastBump":"2025-11-06T23:41:26.627Z","script":"game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {\n    Title = \"More Open Source Script\",\n    Text = \"For Join: https://discord.gg/URmka8WnQ5\",\n    Duration = 5\n})\n\nlocal Lib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/turtle\"))()\nlocal Win = Lib:Window(\"DraWatX Open Source\")\n\nlocal FVelocity = Vector3.new(0, 0, 0)\nlocal ECSetting = false\nlocal ISSetting = false\nlocal VMSetting = 1\n\nWin:Toggle(\"Easy Control\", false, function(Bool)\n    ECSetting = Bool\nend)\n\nWin:Toggle(\"Infinity Stamina\", false, function(Bool)\n    ISSetting = Bool\nend)\n\nWin:Slider(\"Velocity Multiplier\", 1, 3, 1, function(Value)\n    VMSetting = Value\nend)\n\nWin:Button(\"Discord Link\", function()\n    setclipboard(\"https://discord.gg/URmka8WnQ5\")\nend)\n\nlocal function SmoothVelocity(Velocity)\n    if Velocity > 250 or math.random(1, 7) == 1 then\n        return 1\n    end\n    return Velocity * VMSetting\nend\n\nlocal oldindex;oldindex = hookmetamethod(game, \"__index\", function(v1, v2)\n    if ECSetting and v2 == \"Velocity\" and getnamecallmethod() == \"ToOrientation\" then\n        return FVelocity\n    end\n    return oldindex(v1, v2)\nend)\n\nlocal oldnewindex;oldnewindex = hookmetamethod(game, \"__newindex\", function(v1, v2, v3)\n    if v2 == \"AssemblyLinearVelocity\" then\n        return oldnewindex(v1, v2, v3.Unit * SmoothVelocity(math.abs((v3).Magnitude)))\n    end\n    return oldnewindex(v1, v2, v3)\nend)\n\nlocal oldnamecall;oldnamecall = hookmetamethod(game, \"__namecall\", function(v1, v2, ...)\n    if ISSetting and getnamecallmethod() == \"FireServer\" and v2 == \"SpeedTarget\" then\n        return oldnamecall(v1, v2, 0)\n    end\n    return oldnamecall(v1, v2, ...)\nend)","features":"Open Source\nEasy Control\nInfinity Stamina\nSpeed Multiplier","tags":["Open Source","Uma Racing"],"discord":"https://discord.gg/URmka8WnQ5","keyLink":"","owner":{"_id":"64e516660a3f25e1149567dc","username":"DraWatX","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"64e516660a3f25e1149567dc","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media