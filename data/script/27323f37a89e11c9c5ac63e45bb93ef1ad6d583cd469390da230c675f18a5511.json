{"slug":"Big-Paint-Ball-or-Unlock-All-or_13","_id":"61a8aa3e6cff2bcb9f275184","title":"Big Paint Ball | Unlock All |","game":{"_id":"67e5e1ffb360710ec3c77da4","gameId":3527629287,"name":"BIG Paintball! Classic 🔫","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":3527629287},"features":"This script only gives you the ability to unlock all guns camos in the game.","tags":["UnlockAll","hacks","cheats"],"script":"local library = require(game:GetService(\"ReplicatedStorage\").Framework.Library)\n\nlocal env = getsenv(game:GetService(\"Players\").LocalPlayer.PlayerScripts.Scripts.Game[\"First Person Controller\"])\n\nlocal unlock_all = true\n\n--// Gun Bypass\nlocal old_fire = library.Network.Fire\nlibrary.Network.Fire = newcclosure(function(self, ...)\n   local args = {...}\n\n   if unlock_all and tostring(self) == \"Request Respawn\" then\n       args[1] = \"1\"\n   end\n\n   return old_fire(self, unpack(args))\nend)\n\nlocal old_own = env.DoesOwnGun\nenv.DoesOwnGun = function(...)\n   return (unlock_all and true) or old_own(...)\nend\n--\n\n--// Unlock All\nlocal old_own_gun = library.GunCmds.DoesOwnGun\nlibrary.GunCmds.DoesOwnGun = newcclosure(function(self, ...)\n   return (unlock_all and true) or old_own_gun(self, ...)\nend)\n--\n\n--// Unlock Offsale\nfor _, gun in next, library.Directory.Guns do\n   gun[\"offsale\"] = false\nend\n--","owner":{"_id":"61a65cb223107ec73d3f21b1","username":"CapperMods","verified":true,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61a65cb223107ec73d3f21b1-1638292960039.png"},"status":"offline","id":"61a65cb223107ec73d3f21b1","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61a65cb223107ec73d3f21b1-1638292960039.png"}},"verified":true,"views":99087,"scr