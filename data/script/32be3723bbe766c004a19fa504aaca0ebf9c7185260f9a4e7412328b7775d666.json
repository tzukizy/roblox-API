{"_id":"67ce19f62aa4bd7f8a778286","title":"Auto Farm Script OPEN SOURCE","game":{"_id":"67e5e1ffb360710ec3c780bc","gameId":8447279898,"name":"The Pointless Printer Game","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"8447279898-the-pointless-printer-game","path":"/game/8447279898-the-pointless-printer-game","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":8447279898},"slug":"The-Pointless-Printer-Game-Auto-Farm-Script-OPEN-SOURCE-31511","verified":false,"key":false,"keyless":false,"views":47908,"executes":52,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-08b1641b61b666ea2c15cf3cb4047fb8/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-08b1641b61b666ea2c15cf3cb4047fb8/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-08b1641b61b666ea2c15cf3cb4047fb8/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-08b1641b61b666ea2c15cf3cb4047fb8/500/280/Image/Jpeg/noFilter"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-03-09T22:45:10.826Z","updatedAt":"2025-03-09T22:45:10.826Z","lastBump":"2025-03-09T22:45:10.826Z","script":"local plr = game.Players.LocalPlayer\nlocal character = plr.Character or plr.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\nlocal TweenService = game:GetService(\"TweenService\")\n\n-- Tween to move from Position 1 (start) to Position 2 (end)\nlocal startPosition = CFrame.new(-26, 4, 165) -- Start position\nlocal endPosition = CFrame.new(18, 4, 178)   -- End position\n\n-- Function to create and play tween\nlocal function teleportLoop()\n    humanoidRootPart.CFrame = startPosition -- Teleport back to start position\n    wait(5) -- Wait for 5 seconds before starting the tween\n\n    local tweenInfo = TweenInfo.new(\n        5, -- Time to complete the tween\n        Enum.EasingStyle.Linear, \n        Enum.EasingDirection.In\n    )\n    \n    local tween = TweenService:Create(humanoidRootPart, tweenInfo, {CFrame = endPosition})\n    tween:Play()\n    \n    -- When the tween completes, teleport back and start again\n    tween.Completed:Connect(function()\n        teleportLoop() -- Recursively call the function to loop\n    end)\nend\n\nteleportLoop() -- Start the teleport and tween loop","features":"Auto moves your character until you leave the game\n\nuse shift lock or first person facing towards the paper dump so you can move paper\n\nif you don't use shift lock the player will be sideways","tags":["open source","free","keyless","Printer","Simple"],"discord":"","keyLink":"","owner":{"_id":"679a811f8f6b5958fba70b56","username":"fattycheeseyt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5c23b09fcb973ad643668756b9b3373d0b7c4e33f0708e976e8e16d7d11f564b.webp","original":"https://scriptblox.com/images/photo/679a811f8f6b5958fba70b56-1742421298531.png"},"status":"offline","id":"679a811f8f6b5958fba70b56","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/5c23b09fcb973ad643668756b9b3373d0b7c4e33f0708e976e8e16d7d11f564b.webp","original":"https://scriptblox.com/images/photo/679a811f8f6b5958fba70b56-1742421298531.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:58:48.145Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c557c1","editBy":{"_id":"679a811f8f6b5958fba70b56","username":"fattycheeseyt","status":"offline","id":"679a811f8f6b5958fba70b56"},"message":"Create script","createdAt":"2025-03-27T23:05:55.152Z"}],"comments":[{"_id":"67ce1b661bfd28d76b06c12a","commentBy