oney then\n        game:GetService(\"ReplicatedStorage\").Remotes.DigEvent:FireServer(\"hello\")\n    end\n    if finalpet then\n        game:GetService(\"ReplicatedStorage\").Remotes.PetCageEvent:FireServer(\"Glimmerfly\")\n        game:GetService(\"ReplicatedStorage\").PetRemotes.GoldPetCraftEvent:FireServer(\"Glimmerfly\",100)\n        game:GetService(\"ReplicatedStorage\").PetRemotes.DiamondPetCraftEvent:FireServer(\"Gold Glimmerfly\",100)\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"views":17443,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-821e17b5d7295bf6a3a3a9a931b98819-71562d7f1af3.png","scriptblox":"https://scriptblox.com/images/script/rbx-821e17b5d7295bf6a3a3a9a931b98819-71562d7f1af3.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2025-05-18T05:21:24.358Z","executes":232,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:01:47.290Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-821e17b5d7295bf6a3a3a9a931b98819-71562d7f1af3.png","scriptblox":"https://scriptblox.com/image