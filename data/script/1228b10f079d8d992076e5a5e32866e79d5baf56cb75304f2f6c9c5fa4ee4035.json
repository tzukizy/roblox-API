{"_id":"69835f3cf168b5c5b09cd0be","title":"Script for a ftap yuki hub block message","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d344d7029183d8f652ed6c879486169a1ce85acea55c2a0786b3d1457bbedb1a.webp","original":"https://scriptblox.com/images/sb/0-1770217276272.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d344d7029183d8f652ed6c879486169a1ce85acea55c2a0786b3d1457bbedb1a.webp","original":"https://scriptblox.com/images/sb/0-1770217276272.jpg"},"placeId":0},"slug":"Universal-Script-Script-for-a-ftap-yuki-hub-block-message-102075","verified":false,"key":false,"keyless":false,"views":2034,"executes":373,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5d318a91af22329bd72da1b7be4654a458fd4c024748d58d8a86ccb8f10b5052.webp","original":"https://scriptblox.com/images/sb/0-1770217276272.jpg","scriptblox":"https://scriptblox.com/images/script/0-1770217276272.jpg"},"thumbnail":{"url":"https://media.kocakz.me/5d318a91af22329bd72da1b7be4654a458fd4c024748d58d8a86ccb8f10b5052.webp","original":"https://scriptblox.com/images/sb/0-1770217276272.jpg","scriptblox":"https://scriptblox.com/images/script/0-1770217276272.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-04T15:01:16.287Z","updatedAt":"2026-02-04T15:01:16.287Z","lastBump":"2026-02-04T15:01:16.287Z","script":"-- ===== ANTI REKLAM (всё скрыть) =====\n\n-- Новый чат (TextChatService)\nlocal TextChatService = game:FindService(\"TextChatService\")\nif TextChatService then\n    TextChatService.OnIncomingMessage = function(message)\n        -- скрываем любые сообщения от хабов/рекламы\n        if message.Text then\n            local t = message.Text:lower()\n            if t:find(\"hub\") or t:find(\"discord\") or t:find(\"http\")\n                or t:find(\"gg/\") or t:find(\"script\")\n                or t:find(\"yuki\") or t:find(\"❤\") then\n                return nil\n            end\n        end\n        return message\n    end\nend\n\n-- Старый чат\nlocal Chat = game:GetService(\"Chat\")\nlocal old = Chat.OnMessageDoneFiltering\nChat.OnMessageDoneFiltering = function(self, msg)\n    if msg and msg.Message then\n        local t = msg.Message:lower()\n        if t:find(\"hub\") or t:find(\"discord\") or t:find(\"http\")\n            or t:find(\"gg/\") or t:find(\"script\")\n            or t:find(\"yuki\") or t:find(\"❤\") then\n            msg.Message = \"\" -- полностью скрыть\n        end\n    end\n    return old(self, msg)\nend","features":"Script for a ftap yuki hub that's blocks message \"ftap yuki hub❤️❤️❤️","tags":[],"discord":"","keyLink":"","owner":{"_id":"6973362f83690c59c1208856","username":"ScriptsByMuhammadaz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/58b3d865ec95761f5538fe6a6e47c424e618e9aa37f0349c3b0b1c1cf7a0bf44.webp","original":"https://scriptblox.com/images/photo/6973362f83690c59c1208856-1770217418433.jpg"},"status":"offline","id":"6973362f83690c59c1208856","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/58b3d865ec95761f5538fe6a6e47c424e618e9aa37f0349c3b0b1c1cf7a0bf44.webp","original":"https://scriptblox.com/images/photo/6973362f83690c59c1208856-1770217418433.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:37:12.916Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69835f3cf168b5c5b09cd0c1","editBy":{"_id":"6973362f83690c59c1208856","username":"ScriptsByMuhammadaz","status":"offline","id":"6973362f83690c59c1208856"},"message":"Create script","createdAt":"2026-02-04T15:01:16.290Z"}],"comments":[{"_id":"69835f9fe96ccd295684ad47","commentBy":{"_id":"6973362f83690c59c1208856","username":"S