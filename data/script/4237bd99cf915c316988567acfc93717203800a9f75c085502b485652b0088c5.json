{"_id":"69d482ffe52e8dc73f5ec070","title":"FE2 Truss Hopping Physics","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/ace259860227e0e714d0c09305129ed1b0adfaf0df11f2934e6ad98bc9ff7605.webp","original":"https://scriptblox.com/images/sb/0-1775534847002.webp"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/ace259860227e0e714d0c09305129ed1b0adfaf0df11f2934e6ad98bc9ff7605.webp","original":"https://scriptblox.com/images/sb/0-1775534847002.webp"},"placeId":0},"slug":"Universal-Script-FE2-Truss-Hopping-Physics-193278","verified":false,"key":false,"keyless":false,"views":887,"executes":908,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/9178b697dcbb4c38d80d0a1f8c7f6ea0577ed2923d8e885b5528e0010ef2ef3e.webp","original":"https://scriptblox.com/images/sb/0-1775534847002.webp","scriptblox":"https://scriptblox.com/images/script/0-1775534847002.webp"},"thumbnail":{"url":"https://media.kocakz.me/9178b697dcbb4c38d80d0a1f8c7f6ea0577ed2923d8e885b5528e0010ef2ef3e.webp","original":"https://scriptblox.com/images/sb/0-1775534847002.webp","scriptblox":"https://scriptblox.com/images/script/0-1775534847002.webp"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-07T04:07:27.024Z","updatedAt":"2026-04-07T04:07:27.024Z","lastBump":"2026-04-07T04:07:27.024Z","script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal Player = Players.LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\nlocal Root = Character:WaitForChild(\"HumanoidRootPart\")\n\nPlayer.CharacterAdded:Connect(function(Char)\n\tCharacter = Char\n\tHumanoid = Char:WaitForChild(\"Humanoid\")\n\tRoot = Char:WaitForChild(\"HumanoidRootPart\")\nend)\n\nlocal UpwardBoost = 50\nlocal BackwardPush = 10\n\nUserInputService.JumpRequest:Connect(function()\n\tif Humanoid:GetState() == Enum.HumanoidStateType.Climbing then\n\t\tlocal Look = Root.CFrame.LookVector\n\t\tlocal Backward = -Look.Unit * BackwardPush\n\n\t\tlocal Velocity = Vector3.new(\n\t\t\tBackward.X,\n\t\t\tmath.max(Root.Velocity.Y, 0) + UpwardBoost,\n\t\t\tBackward.Z\n\t\t)\n\n\t\tRoot.Velocity = Velocity\n\tend\nend)","features":"This is the ladder hopping technique of Flood Escape 2 / FE2 but replicated. Since it is time consuming and slow when climbing a ladder, I just decided to remake it so everybody can use it on every game (mostly if they had ladders ofc). Recommended for obby and parkour games.","tags":[],"discord":"","keyLink":"","owner":{"_id":"69c52f1dd7d7317553556505","username":"theobscured102","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b6bdc4d1933cdb3fe4d9e5f60d76506de65eaaf0de0b9aa41c1eed519e20a307.webp","original":"https://scriptblox.com/images/photo/69c52f1dd7d7317553556505-1775534108734.jpg"},"status":"offline","id":"69c52f1dd7d7317553556505","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/b6bdc4d1933cdb3fe4d9e5f60d76506de65eaaf0de0b9aa41c1eed519e20a307.webp","original":"https://scriptblox.com/images/photo/69c52f1dd7d7317553556505-1775534108734.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:01:17.885Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d482ffe52e8dc73f5ec073","editBy":{"_id":"69c52f1dd7d7317553556505","username":"theobscured102","status":"offline","id":"69c52f1dd7d7317553556505"},"message":"Create script","createdAt":"2026-04-07T04:07:27.034Z"}],"comments":[{"_id":"6a1d333c57cf6be31657586c","commentBy":{"_id":"6a096698dd21014992fefc61","username":"StupidestNoobOAT","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/941c01ac2c945ca4b4bcba53079f0e1d5a2506ee5371bb35113b109086ec3f5f.webp","original":"https://scriptblox.com/images/photo/6a096698dd21014992fefc61-1779069947302.png"},"lastActive":"2026-09-04T15:37:48.732Z","createdAt":"2026-05-17T06:56:24.633Z","status":"offline","id":"6a096698dd21014992fefc61","profile":{"url":"https://media.kocakz.me/941c01ac2c945ca4b4bcba53079f0e1d5a2506ee5371bb35113b109086ec3f5f.webp","original":"https://scriptblox.com/images/photo/6a096698dd21014992fefc61-1779069947302.png"}},"text":"very cool script tho, 10/10 (ye i love the how it is working tho)","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-01T07:22:36.384Z","liked":false,"disliked":false},{"_id":"6a23ba223ceebed6ce4c9217","commentBy":{"_id":"69c52f1dd7d7317553556505","username":"theobscured102","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b6bdc4d1933cdb3fe4d9e5f60d76506de65eaaf0de0b9aa41c1eed519e20a307.webp","original":"https://scriptblox.com/images/photo/69c52f1dd7d7317553556505-1775534108734.jpg"},"lastActive":"2026-09-01T00:48:14.564Z","createdAt":"2026-03-26T13:05:33.970Z","status":"offline","id":"69c52f1dd7d7317553556505","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/b6bdc4d1933cdb3fe4d9e5f60d76506de65eaaf0de0b9aa41c1eed519e20a307.webp","original":"https://scriptblox.com/images/photo/69c52f1dd7d7317553556505-1775534108734.jpg"}},"text":"@StupidestNoobOAT thanks for the feedback 😎 👍","parent":{"_id":"6a1d333c57cf6be31657586c","commentBy":{"_id":"6a096698dd21014992fefc61","username":"StupidestNoobOAT","profilePicture":"/images/photo/6a096698dd21014992fefc61-1779069947302.png","status":"offline","id":"6a096698dd21014992fefc61"},"text":"very cool script tho, 10/10 (ye i love the how it is working tho)"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-06T06:11:46.692Z","liked":false,"disliked":false},{"_id":"6a61406f8d9