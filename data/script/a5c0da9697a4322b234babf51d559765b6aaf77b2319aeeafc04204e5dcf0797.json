era.FieldOfView = NORMAL_FOV\n\tend\nend)\n\nUserInputService.InputBegan:Connect(function(input, gpe)\n\tif gpe then return end\n\tif input.UserInputType == Enum.UserInputType.MouseButton2 then\n\t\tzoomEnabled = not zoomEnabled\n\tend\nend)\n\nUserInputService.InputChanged:Connect(function(input, gpe)\n\tif gpe then return end\n\tif not zoomEnabled then return end\n\tif input.UserInputType == Enum.UserInputType.MouseWheel then\n\t\tif input.Position.Z > 0 then\n\t\t\tcurrentZoomFOV = math.clamp(currentZoomFOV - SCROLL_STEP, MIN_ZOOM_FOV, MAX_ZOOM_FOV)\n\t\telse\n\t\t\tcurrentZoomFOV = math.clamp(currentZoomFOV + SCROLL_STEP, MIN_ZOOM_FOV, MAX_ZOOM_FOV)\n\t\tend\n\tend\nend)\n\nplayer.CharacterAdded:Connect(function()\n\tzoomEnabled = false\n\tcurrentZoomFOV = 25\n\tcamera.FieldOfView = NORMAL_FOV\n\tcamera.CameraType = Enum.CameraType.Custom\nend)","features":"Zoom in with RMB scroll to zoom in and out.","tags":["aimbot"],"discord":"","keyLink":"","owner":{"_id":"68756b71369bb2c73b176db3","username":"TheScriptUploader","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68756b71369bb2c73b176db3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:40:44.322Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6957e815d2a92a3bd75b352a","editBy":{"_id":"68756b71369bb2c73b176db3","username":"TheScriptUploader","status":"offline","id":"68756b71369bb2c73b176db3"},"message":"Create script","createdAt":"2026-01-02T15:45:25.059Z"}],"comments":[{"_id":"6957e8305b7bce9c8cdc7e32","commentBy":{"_id":"68756b71369bb2c73b176db3","username":"TheScriptUploader","verified":false,"role":"user","profilePic