{"_id":"671bafef0d4152a639e9817b","title":"Reset button","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/a489c8a8a1c3a92a306a137c12ecf3f3af3f198c36fa9296916f37b65dc038d9.webp","original":"https://scriptblox.com/images/sb/3827421-1729867759242.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/a489c8a8a1c3a92a306a137c12ecf3f3af3f198c36fa9296916f37b65dc038d9.webp","original":"https://scriptblox.com/images/sb/3827421-1729867759242.png"},"placeId":0},"slug":"Universal-Script-Reset-button-21019","verified":false,"key":false,"keyless":false,"views":14872,"executes":3359,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/14aa23e0bb62b9c0687f22fd27559b72d651e44d94f9fa127de7929886149f43.webp","original":"https://scriptblox.com/images/sb/3827421-1729867759242.png","scriptblox":"https://scriptblox.com/images/script/3827421-1729867759242.png"},"thumbnail":{"url":"https://media.kocakz.me/14aa23e0bb62b9c0687f22fd27559b72d651e44d94f9fa127de7929886149f43.webp","original":"https://scriptblox.com/images/sb/3827421-1729867759242.png","scriptblox":"https://scriptblox.com/images/script/3827421-1729867759242.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-10-25T14:49:19.301Z","updatedAt":"2024-10-25T14:49:19.301Z","lastBump":"2024-10-25T14:49:19.301Z","script":"local player = game.Players.LocalPlayer\nlocal screenGui = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\nscreenGui.ResetOnSpawn = false\n\n-- Crear el botón \"Reset\"\nlocal resetButton = Instance.new(\"TextButton\")\nresetButton.Size = UDim2.new(0, 40, 0, 40)  -- Tamaño más pequeño\nresetButton.Position = UDim2.new(0.5, -20, 0.1, 0)\nresetButton.Text = \"Reset\"\nresetButton.BackgroundColor3 = Color3.new(1, 0, 0)\nresetButton.TextColor3 = Color3.new(1, 1, 1)\nresetButton.BackgroundTransparency = 0.5\nresetButton.Parent = screenGui\nresetButton.TextScaled = true\nresetButton.AutoButtonColor = false\nresetButton.BorderSizePixel = 0\n\n-- Hacer el botón redondo\nlocal corner = Instance.new(\"UICorner\", resetButton)\ncorner.CornerRadius = UDim.new(0, 20)  -- Radio ajustado para un botón más pequeño\n\n-- Función para reiniciar el personaje\nlocal function resetCharacter()\n    local humanoid = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\")\n    if humanoid then humanoid.Health = 0 end\nend\n\n-- Crear el botón \"X\" para quitar el botón de reset\nlocal closeButton = Instance.new(\"TextButton\", resetButton)\ncloseButton.Size = UDim2.new(0, 12, 0, 12)  -- Tamaño más pequeño\ncloseButton.Position = UDim2.new(1, -15, 0, 0)  -- Ajustar posición\ncloseButton.Text = \"X\"\ncloseButton.BackgroundColor3 = Color3.new(0.8, 0, 0)\ncloseButton.TextColor3 = Color3.new(1, 1, 1)\ncloseButton.BackgroundTransparency = 0.5\ncloseButton.BorderSizePixel = 0\n\n-- Conectar el evento del botón \"X\"\ncloseButton.MouseButton1Click:Connect(function()\n    resetButton:Destroy()\nend)\n\n-- Funcionalidad para arrastrar el botón\nlocal UIS = game:GetService(\"UserInputService\")\nlocal dragging, dragStart, startPos = false, nil, nil\n\nresetButton.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n        dragging = true\n        dragStart, startPos = input.Position, resetButton.Position\n\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\nUIS.InputChanged:Connect(function(input)\n    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then\n        local delta = input.Position - dragStart\n        resetButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\n    end\nend)\n\n-- Conectar el evento del botón \"Reset\"\nresetButton.MouseButton1Up:Connect(function()\n    if not dragging then resetCharacter() end\nend)","features":"Just a Button reset easy!!!!","tags":[],"discord":"","keyLink":"","owner":{"_id":"67109f93f1a77b537dfa8a07","username":"Cadhoun","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7826d9e0169b1751d546fa2575c9bf1cd637fe3df4d2f47b6c75b5aeef0a6aff.webp","original":"https://scriptblox.com/images/photo/67109f93f1a77b537dfa8a07-1733030699265.png"},"status":"offline","id":"67109f93f1a77b537dfa8a07","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/7826d9e0169b1751d546fa2575c9bf1cd637fe3df4d2f47b6c75b5aeef0a6aff.webp","original":"https://scriptblox.com/images/photo/67109f93f1a77b537dfa8a07-1733030699265.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:09:05.469Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52ac5","editBy":{"_id":"67109f93f1a77b537dfa8a07","username":"Cadhoun","status":"offline","id":"67109f93f1a77b537dfa8a07"},"message":"Create script","createdAt":"2025-03-27T19:02:36.973Z"}],"comments":[{"_id":"69a58671dbe6a652d1335c4e","commentBy":{"_id":"685011fa2ebe6c6ee9a45122","username":"Dlldldmdmmdmdn","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-06-16T12:45:46.072Z","lastActive":"2026-04-20T00:09:17.585Z","status":"offline","id":"685011fa2ebe6c6ee9a45122","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Super simple and open source👍👌","edited":false,"likeCount":2,"dislik