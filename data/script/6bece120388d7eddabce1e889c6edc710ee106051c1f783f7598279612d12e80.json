{"slug":"Universal-Script-NOCLIP-Script-and-NO-KEY-73452","_id":"6936fd8c53e4ff1d24f55f2e","title":"NOCLIP Script and NO KEY","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"No Key/NOCLIP SCRIPT!!!!","tags":["script","NOCLIP"],"script":"local player = game.Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\n-- Criar a ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"NoClipGui\"\nscreenGui.Parent = playerGui\n\n-- Criar o botão\nlocal button = Instance.new(\"TextButton\")\nbutton.Name = \"NoClipButton\"\nbutton.Parent = screenGui\nbutton.Position = UDim2.new(0.034, 0, 0.532, 0) -- Posição modificada\nbutton.Size = UDim2.new(0, 200, 0, 57) -- Tamanho modificado\nbutton.Text = \"Ativar NoClip\"\nbutton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\nbutton.TextColor3 = Color3.fromRGB(255,255,255)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextSize = 28\n\n-- Função de NoClip\nlocal noclip = false\nlocal character = player.Character or player.CharacterAdded:Wait()\n\nlocal function setNoclip(state)\n noclip = state\n if noclip then\n  button.Text = \"Desativar NoClip\"\n  button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)\n else\n  button.Text = \"Ativar NoClip\"\n  button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\n end\nend\n\nlocal function updateNoclip()\n if character then\n  for _, part in ipairs(character:GetDescendants()) do\n   if part:IsA(\"BasePart\") then\n    part.CanCollide = not noclip\n   end\n  end\n end\nend\n\n-- Atualiza colisão constantemente\ngame:GetService(\"RunService\").Stepped:Connect(updateNoclip)\n\n-- Atualiza quando o personagem reaparecer\nplayer.CharacterAdded:Connect(function(char)\n character = char\nend)\n\n-- Clique no botão para alternar\nbutton.MouseButton1Click:Connect(function()\n setNoclip(not noclip)\nend)","owner":{"_id":"68fbfa7d0bed562e3df253fe","username":"Minikid9991","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/48499b7e7d35e0a62cc4e98830a7ff2fc11a78e47c64fb33f70bb7c72a04b64c.webp","original":"https://scriptblox.com/images/photo/68fbfa7d0bed562e3df253fe-1761344201242.jpg"},"status":"offline","id":"68fbfa7d0bed562e3df253fe","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/48499b7e7d35e0a62cc4e98830a7ff2fc11a78e47c64fb33f70bb7c72a04b64c.webp","original":"https://scriptblox.com/images/photo/68fbfa7d0bed562e3df253fe-1761344201242.jpg"}},"verified":false,"views":1840,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/00f1e9d2ec758d9d5fbc29435891e429d4b1faffe15f861217e8c60570b482b0.webp","original":"https://scriptblox.com/images/sb/0-1765211532105.jpg","scriptblox":"https://scriptblox.com/images/script/0-1765211532105.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-08T16:32:12.119Z","executes":1515,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:33:59.900Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/00f1e9d2ec758d9d5fbc29435891e429d4b1faffe15f861217e8c60570b482b0.webp","original":"https://scriptblox.com/images/sb/0-1765211532105.jpg","scriptblox":"https://scriptblox.com/images/script/0-1765211532105.jpg"},"changelog":[{"_id":"6936fd8c53e4ff1d24f55f30","editBy":{"_id":"68fbfa7d0bed562e3df253fe","username":"Minikid9991","status":"offline","id":"68fbfa7d0bed562e3df253fe"},"message":"Create script","createdAt":"2025-12-08T16:32:12.121Z"}],"comments":[{"_id":"6936fe77e4d748bf75b6c303","commentBy":{"_id":"67f2b5839695f884e683e43d","username":"Xeryt","verified":false,"role"