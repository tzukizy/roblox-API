{"slug":"Universal-Script-My-first-script-16922","_id":"66b697179cd7e29051d6472e","title":"My first script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/8128607-1723242262969.png","placeId":0},"features":"[Test]","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal bodyVelocity = Instance.new(\"BodyVelocity\")\nbodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)\nbodyVelocity.Parent = humanoidRootPart\n\nlocal speed = 30\n\nUserInputService.InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.Space then\n        bodyVelocity.Velocity = Vector3.new(0, speed, 0)\n    end\nend)\n","owner":{"_id":"66abb55d64d6d2ccf7147c47","username":"Obunga","verified":false,"profilePicture":"/images/photo/66abb55d64d6d2ccf7147c47-1724607031831.jpg","status":"offline","id":"66abb55d64d6d2ccf7147c47","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":100233,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-08-09T22:24:23.028Z","dislikeCount":0,"likeCount":3,"image":"/images/sb/8128607-1723242262969.png","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51adf","editBy":{"_id":"66abb55d64d6d2ccf7147c47","username":"Obunga","status":"offline","id":"66abb55d64d6d2ccf7147c47"},"message":"Create script","createdAt":"2025-03-27T12:05:51.819Z"}],"comments":[{"_id":"66b6a671b921d0c670f09b86","commentBy":{"_id":"66574609a928d3838db255e7","username":"Thestrongestman0080","verified":false,"role":"user","profilePicture":"/images/photo/66574609a928d3838db255e7-1759417320797.jpg","cre