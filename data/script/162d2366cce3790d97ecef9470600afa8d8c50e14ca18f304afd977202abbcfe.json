nd\n            end\n\n            if not model.PrimaryPart then\n                warn(\"Failed to set PrimaryPart for: \" .. model.Name .. \". Skipping.\")\n                return\n            end\n        end\n\n        \n        local highlight = Instance.new(\"Highlight\")\n        highlight.Adornee = model\n        highlight.Parent = game:GetService(\"CoreGui\") -- To render globally\n        highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Red glow\n        highlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- White border\n        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n    end\nend\n\n\nlocal function findAndApplyESP(folder)\n    if folder:IsA(\"Folder\") then\n        for _, child in pairs(folder:GetChildren()) do\n            if child:IsA(\"Model\") then\n      \n                createESP(child)\n                return\n            end\n        end\n    end\nend\n\n\nlocal animatronicsFolder = workspace:FindFirstChild(\"Animatronics\")\n\nif animatronicsFolder and animatronicsFolder:IsA(\"Folder\") then\n\n    for _, animatronicFolder in pairs(animatronicsFolder:GetChildren()) do\n        findAndApplyESP(animatronicFolder)\n    end\nelse\n    warn(\"Animatronics folder not found in workspace.\")\nend\n","features":"- ESP all animatronics all games","tags":[],"discord":"","keyLink":"","owner":{"_id":"66a880aa1ae03fe014f47dd8","username":"Z33N","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f0c08c12d2cd34f90d602900785049c811f5857529550f7a74ed22ee18010ab9.webp","original":"https://scriptblox.com/images/photo/66a880aa1ae03fe014f47dd8-1722319202939.png"},"status":"offline","id":"66a880aa1ae03fe014f47dd8","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/f0c08c12d2cd34f90d602900785049c811f5857529550f7a74ed22ee18010ab9.webp","original":"https://scriptblox.com/images/photo/66a880aa1ae03fe014f47dd8-1722319202939.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":