 plrname .. \"&ownername=\" .. _G.Owner .. \"&user=1\")\n   local Data = HttpService:JSONDecode(Response)\n   wait(1)\n   game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(Data.message, \"All\")\nend\n\nPlayers.PlayerChatted:Connect(function(type, plr, message)\n   if plr.Name ~= Players.LocalPlayer.Name then\n       getChat(message, plr.Name)\n   end\nend)","features":"Our brand new script!","tags":[],"discord":"","keyLink":"","owner":{"_id":"675d8c6f021803dea1f46162","username":"MANofnothing","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dc6d0c3ab4c31a8633b5c1c5ac797e8c33004f00ac03d1f43bd2cc0f2806b33d.webp","original":"https://scriptblox.com/images/photo/675d8c6f021803dea1f46162-1735391723716.jpg"},"status":"offline","id":"675d8c6f021803dea1f46162","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/dc6d0c3ab4c31a8633b5c1c5ac797e8c33004f00ac03d1f43bd2cc0f2806b33d.webp","original":"https://scriptblox.com/images/photo/675d8c6f021803dea1f46162-1735391723716.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:06:37.505Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c543dc","editBy":{"_id":"675d8c6f021803dea1f46162","username":"MANofnothing","status":"offline","id":"675d8c6f021803dea1f46162"},"message":"Create script","createdAt":"2025-03-27T12:55:49.663Z"}],"comments":[]}