{"slug":"Universal-Script-New-script-27235","_id":"678d0d047b2aaa3709e0a699","title":"New script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Our brand new script!","tags":[],"script":"local HttpService = game:GetService(\"HttpService\")\nlocal Players = game:GetService(\"Players\")\n\n_G.Owner = \"KAP1XO0\" -- replace it with ur user NO DISPLAY NAMES\n\nfunction getChat(message,plrname)\n\n   local Split = message:gsub(\" \", \"+\") -- This takes spaces within the person's message and turns it into for ex: Hi+How+Are+You... to ensure that there are no errors and to also make the URL work\n   \n   local Response = game:HttpGet(\"https://api.affiliateplus.xyz/api/chatbot?message=\" .. Split .. \"&botname=\" .. plrname .. \"&ownername=\" .. _G.Owner .. \"&user=1\")\n   local Data = HttpService:JSONDecode(Response)\n   wait(1)\n   game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(Data.message, \"All\")\nend\n\nPlayers.PlayerChatted:Connect(function(type, plr, message)\n   if plr.Name ~= Players.LocalPlayer.Name then\n       getChat(message, plr.Name)\n   end\nend)","owner":{"_id":"675d8c6f021803dea1f46162","username":"MANofnothing","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/dc6d0c3ab4c31a8633b5c1c5ac797e8c33004f00ac03d1f43bd2cc0f2806b33d.webp","original":"https://scriptblox.com/images/photo/675d8c6f021803dea1f46162-1735391723716.jpg"},"status":"offline","id":"675d8c6f021803dea1f46162","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/dc6d0c3ab4c31a8633b5c1c5ac797e8c33004f00ac03d1f43bd2cc0f2806b33d.webp","original":"https://scriptblox.com/images/photo/675d8c6f021803dea1f46162-1735391723716.jpg"}},"verified":false,"keyLink":"","views":1