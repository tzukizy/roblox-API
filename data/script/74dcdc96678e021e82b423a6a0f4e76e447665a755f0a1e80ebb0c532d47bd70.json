{"_id":"68bb9876e33332ae4840db40","title":"Stats Modifier","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/33d0d38c77db317026c73c00a8b55600c6e092107a61ba0d163646b2fb3272b5.webp","original":"https://scriptblox.com/images/sb/0-1757161766272.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/33d0d38c77db317026c73c00a8b55600c6e092107a61ba0d163646b2fb3272b5.webp","original":"https://scriptblox.com/images/sb/0-1757161766272.jpg"},"placeId":0},"slug":"Universal-Script-c00lguii-Rayfield-51633","verified":false,"key":false,"keyless":false,"views":2479,"executes":90,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/032344adab8d4ea3e1cab23d7684e1ab44b562639dbb05ddd7ab96b3ff8afbfb.webp","original":"https://scriptblox.com/images/sb/0-1757161766272.jpg","scriptblox":"https://scriptblox.com/images/script/0-1757161766272.jpg"},"thumbnail":{"url":"https://media.kocakz.me/032344adab8d4ea3e1cab23d7684e1ab44b562639dbb05ddd7ab96b3ff8afbfb.webp","original":"https://scriptblox.com/images/sb/0-1757161766272.jpg","scriptblox":"https://scriptblox.com/images/script/0-1757161766272.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-09-06T02:12:06.464Z","updatedAt":"2025-09-06T02:12:06.464Z","lastBump":"2025-09-06T02:12:06.464Z","script":"---------------------------\n-- TOOLS TAB\n---------------------------\nlocal ToolsTab = Window:CreateTab(\"Tools\", 4483362458)\nlocal ToolsSection = ToolsTab:CreateSection(\"Give Tools\")\n\nToolsTab:CreateButton({\n    Name = \"Give Sword\",\n    Callback = function()\n        local plr = game.Players.LocalPlayer\n        local sword = Instance.new(\"Tool\")\n        sword.Name = \"c00l Sword\"\n        sword.RequiresHandle = true\n        local handle = Instance.new(\"Part\")\n        handle.Size = Vector3.new(1,4,1)\n        handle.Name = \"Handle\"\n        handle.Parent = sword\n        sword.Parent = plr.Backpack\n    end,\n})\n\nToolsTab:CreateButton({\n    Name = \"Delete All Tools\",\n    Callback = function()\n        local plr = game.Players.LocalPlayer\n        for _,tool in ipairs(plr.Backpack:GetChildren()) do\n            tool:Destroy()\n        end\n    end,\n})\n\n-- New button: Give gear by asset ID\nToolsTab:CreateButton({\n    Name = \"Give Gear (ID: 18651377368)\",\n    Callback = function()\n        local plr = game.Players.LocalPlayer\n        local InsertService = game:GetService(\"InsertService\")\n        local success, gear = pcall(function()\n            return InsertService:LoadAsset(18651377368)\n        end)\n\n        if success and gear then\n            local tool = gear:GetChildren()[1]\n            if tool:IsA(\"Tool\") then\n                tool.Parent = plr.Backpack\n            end\n        else\n            warn(\"Failed to load gear with ID 18651377368\")\n        end\n    end,\n})\n","features":"This script has a speed, big head, WIP sword feature, and more! Enjoy ;)","tags":[],"discord":"","keyLink":"","owner":{"_id":"6817de650783673cc87de581","username":"ScripterBoy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/08d72f61c23905d360ed64b5d30b168197b4228cfdc4082f151d8b797a7e17f8.webp","original":"https://scriptblox.com/images/photo/6817de650783673cc87de581-1757126661108.jpeg"},"status":"offline","id":"6817de650783673cc87de581","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/08d72f61c23905d360ed64b5d30b168197b4228cfdc4082f151d8b797a7e17f8.webp","original":"https://scriptblox.com/images/photo/6817de650783673cc87de581-1757126661108.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:56:25.002Z","last":"","win":14,"math":4},"isHub":false,"supportedGame