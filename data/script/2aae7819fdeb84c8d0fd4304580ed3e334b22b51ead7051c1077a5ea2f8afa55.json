{"_id":"62d3184aee8ebd97230c640a","title":"oMega Obby Parkour  Auto Stages","game":{"_id":"67e5e1ffb360710ec3c786c5","gameId":8003084678,"name":"oMega Obby 🌟 725 Stages! ","imageUrl":{"url":"https://media.kocakz.me/684861bb841be823ab0bc810dfc7cb5f7cb74e7e098d23d1faf54c9bb761442e.webp","original":"https://tr.rbxcdn.com/180DAY-264682cea60d40c8bf7e3e792feb4f9b/150/150/Image/Png/noFilter"},"slug":"8003084678-omega-obby-725-stages","path":"/game/8003084678-omega-obby-725-stages","thumbnail":{"url":"https://media.kocakz.me/684861bb841be823ab0bc810dfc7cb5f7cb74e7e098d23d1faf54c9bb761442e.webp","original":"https://tr.rbxcdn.com/180DAY-264682cea60d40c8bf7e3e792feb4f9b/150/150/Image/Png/noFilter"},"placeId":8003084678},"slug":"oMega-Obby-Parkour-525-Stages!-oMega-Obby-Parkour-Auto-Stages-4237","verified":false,"key":false,"keyless":false,"views":8883,"executes":54,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/9f9dd4ea359d3cf6d8726f1c1751a4d4/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/9f9dd4ea359d3cf6d8726f1c1751a4d4/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/9f9dd4ea359d3cf6d8726f1c1751a4d4/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/9f9dd4ea359d3cf6d8726f1c1751a4d4/500/280/Image/Jpeg"},"likeCount":0,"dislikeCount":0,"createdAt":"2022-07-16T19:58:02.710Z","updatedAt":"2022-07-16T19:58:02.710Z","lastBump":"2022-07-16T19:58:02.710Z","script":"local start_stage = 1 --stage you want to start\nlocal end_stage = 550 --stage you want to end\nlocal wait_time = 0.1 --longer wait time will reduce missing chance\nlocal todo = game:GetService(\"Workspace\").Stages:GetChildren()\nlocal Plr = game:GetService(\"Players\").LocalPlayer\n\nfunction tp(plr, endpos)\n    plr.character.HumanoidRootPart.CFrame = CFrame.new(endpos)\nend\n\nfor j = start_stage, end_stage, 1 do\nfor i,v in pairs(todo) do\n        if todo[i].name == tostring(j) then\n            local todo_2 = todo[i]:GetChildren()\n            for t,v in pairs(todo_2) do\n                if todo_2[t].name == \"Spawn\" then\n                    local Pos = todo_2[t].Position\n                    tp(Plr, Pos)\n                    wait(wait_time)\n                    break\n                end\n            end\n        end\n    end\nend","features":"Auto complete stages and get badges\n\nMake sure to configure the script before using!\n\ni made some edits to the original script so it will support the updated map","tags":["oMega Obby Parkour","Obby","Parkour","Auto"],"discord":"","keyLink":"","owner":{"_id":"62250be2a476a5e7b34f7377","username":"Singularity","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a4877c894c4b1384a624ac56c98ce63e15637e0a01e80903cfe93f7a1c1ec333.webp","original":"https://scriptblox.com/images/photo/62250be2a476a5e7b34f7377-1691188283071.png"},"status":"offline","id":"62250be2a476a5e7b34f7377","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/a4877c894c4b1384a624ac56c98ce63e15637e0a01e80903cfe93f7a1c1ec333.webp","original":"https://scriptblox.com/images/photo/62250be2a476a5e7b34f7377-1691188283071.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:23:25.767Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e532","editBy":{"_id":"62250be2a476a5e7b34f7377","username":"Singularity","status":"offline","id":"62250be2a476a5e7b34f7377"},"message":"Create script","createdAt":"2025-03-27T14:33:53.881Z"}],"comments":[]}