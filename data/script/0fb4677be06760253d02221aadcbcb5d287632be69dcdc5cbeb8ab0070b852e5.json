{"_id":"6953982e31e76adf31051c69","title":"RBD Return By Death","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/becbc7da609000a7bcaa70d281903332055d20078b899e76ee50b7420cf68773.webp","original":"https://scriptblox.com/images/sb/0-1767086126740.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/becbc7da609000a7bcaa70d281903332055d20078b899e76ee50b7420cf68773.webp","original":"https://scriptblox.com/images/sb/0-1767086126740.png"},"placeId":0},"slug":"Universal-Script-RBD-Return-By-Death-79943","verified":false,"key":false,"keyless":false,"views":1513,"executes":1279,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5c655935310451c44c1370072e740e0b090fbd2f701622dd4a5a554bd02ae910.webp","original":"https://scriptblox.com/images/sb/0-1767086126740.png","scriptblox":"https://scriptblox.com/images/script/0-1767086126740.png"},"thumbnail":{"url":"https://media.kocakz.me/5c655935310451c44c1370072e740e0b090fbd2f701622dd4a5a554bd02ae910.webp","original":"https://scriptblox.com/images/sb/0-1767086126740.png","scriptblox":"https://scriptblox.com/images/script/0-1767086126740.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-30T09:15:26.758Z","updatedAt":"2025-12-30T09:15:26.758Z","lastBump":"2025-12-30T09:15:26.758Z","script":"--Made by Phaiznz, Edit the controls and sounds if you want.\nlocal Players = game:GetService(\"Players\")\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal savedCFrame = nil\n\nlocal deathSound = Instance.new(\"Sound\")\ndeathSound.SoundId = \"rbxassetid://134815520229822\"\ndeathSound.Parent = workspace\n\nlocal RandomSound = Instance.new(\"Sound\")\nRandomSound.SoundId = \"rbxassetid://114423456603152\"\nRandomSound.Parent = workspace\n\nlocal RARE_CHANCE = 0.2\n\nUIS.InputBegan:Connect(function(input, gpe)\n    if gpe then return end\n\n    if input.KeyCode == Enum.KeyCode.G then\n        local char = player.Character\n        if not char then return end\n\n        local root = char:FindFirstChild(\"HumanoidRootPart\")\n        if not root then return end\n\n        savedCFrame = root.CFrame\n    end\n\n    if input.KeyCode == Enum.KeyCode.H then\n        local char = player.Character\n        if not char then return end\n\n        local hum = char:FindFirstChildOfClass(\"Humanoid\")\n        if hum then\n            hum.Health = 0\n        end\n    end\n\n    if input.KeyCode == Enum.KeyCode.J then\n        savedCFrame = nil\n    end\nend)\n\nplayer.CharacterAdded:Connect(function(character)\n    task.wait(0.1)\n\n    local root = character:WaitForChild(\"HumanoidRootPart\", 5)\n    if not root then return end\n\n    if savedCFrame then\n        for i = 1, 6 do\n            pcall(function()\n                root.CFrame = savedCFrame\n            end)\n            task.wait(0.05)\n        end\n\n        if math.random() < RARE_CHANCE then\n            RandomSound:Play()\n        else\n            deathSound:Play()\n        end\n    end\nend)\n","features":"returns by death for my re zero fans","tags":["re zero subaru natsuki rezero"],"discord":"","keyLink":"","owner":{"_id":"6948e79940f162cbcf28e873","username":"phaiznz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8b1cc3ab5abdfee129d180643d4b7cfe9b827aa75f38d80fea1be42e756096f2.webp","original":"https://scriptblox.com/images/photo/6948e79940f162cbcf28e873-1766385818398.png"},"status":"offline","id":"6948e79940f162cbcf28e873","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/8b1cc3ab5abdfee129d180643d4b7cfe9b827aa75f38d80fea1be42e756096f2.webp","original":"https://scriptblox.com/images/photo/6948e79940f162cbcf28e873-1766385818398.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w