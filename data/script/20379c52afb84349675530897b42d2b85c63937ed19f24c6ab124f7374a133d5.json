{"_id":"676d7867e5e0c047755a4876","title":"Inf Money","game":{"_id":"67e5e1ffb360710ec3c77e3f","gameId":96462622512177,"name":"Supermarket Simulator","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"96462622512177-supermarket-simulator","path":"/game/96462622512177-supermarket-simulator","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":96462622512177},"slug":"Supermarket-Simulator-Inf-Money-25233","verified":false,"key":false,"keyless":false,"views":5911,"executes":416,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ed40b28a907d70e4a1100945c26df2c1901832c409831551d41448c00dac6018.webp","original":"https://scriptblox.com/images/sb/96462622512177-1735227538320.png","scriptblox":"https://scriptblox.com/images/script/96462622512177-1735227538320.png"},"thumbnail":{"url":"https://media.kocakz.me/ed40b28a907d70e4a1100945c26df2c1901832c409831551d41448c00dac6018.webp","original":"https://scriptblox.com/images/sb/96462622512177-1735227538320.png","scriptblox":"https://scriptblox.com/images/script/96462622512177-1735227538320.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2024-12-26T15:38:15.700Z","updatedAt":"2024-12-26T15:38:15.700Z","lastBump":"2024-12-26T15:38:15.700Z","script":"--[[ \n    Supermarket Simulator Script\n]]\n\n-- Define the gold amount to add and other arguments\nlocal goldAmount = 1 -- Set the amount of gold to change\nlocal isFree = false -- Whether the action is marked as \"free\"\n\n-- Function to invoke the gold change\nlocal function changeGold(amount, free)\n    -- Check if the required services and objects exist\n    local replicatedStorage = game:GetService(\"ReplicatedStorage\")\n    if not replicatedStorage then\n        warn(\"ReplicatedStorage not found. Exiting script.\")\n        return\n    end\n\n    local events = replicatedStorage:FindFirstChild(\"Events\")\n    if not events then\n        warn(\"Events folder not found in ReplicatedStorage. Exiting script.\")\n        return\n    end\n\n    local gold = events:FindFirstChild(\"Gold\")\n    if not gold then\n        warn(\"Gold folder not found in Events. Exiting script.\")\n        return\n    end\n\n    local changeGoldRF = gold:FindFirstChild(\"ChangeGoldRF\")\n    if not changeGoldRF then\n        warn(\"ChangeGoldRF RemoteFunction not found in Gold. Exiting script.\")\n        return\n    end\n\n    -- Create arguments for the remote function\n    local args = {\n        [1] = \"ChangeGold\",\n        [2] = amount,\n        [3] = free\n    }\n\n    -- Safely invoke the server function\n    local success, result = pcall(function()\n        return changeGoldRF:InvokeServer(unpack(args))\n    end)\n\n    if success then\n        print(\"Gold successfully changed! Result:\", result)\n    else\n        warn(\"Failed to change gold. Error:\", result)\n    end\nend\n\n-- Execute the gold change\nchangeGold(goldAmount, isFree)","features":"Irdk Buttt...\n\nInf Money ig\nMore Features Coming Soon!\nOpen Source\n\nInspired By:  *srojs","tags":[],"discord":"","keyLink":"","owner":{"_id":"6763f86fc4a8494c4193082c","username":"Irdk","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d1d9f12b20a5b33e783c11c4676ac3bc6abf0dc13b1a084b3b766fef989d96b7.webp","original":"https://scriptblox.com/images/photo/6763f86fc4a8494c4193082c-1734604974839.png"},"status":"offline","id":"6763f86fc4a8494c4193082c","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/d1d9f12b20a5b33e783c11c4676ac3bc6abf0dc13b1a084b3b766fef989d96b7.webp","original":"https://scriptblox.com/images/photo/6763f86fc4a8494c4193082c-1734604974839.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:02:46.914Z","last":"","win":14,"ma