{"_id":"68cfbecd6a9f7a4aaf12665e","title":"toggle wallhop v2 rus by me","game":{"_id":"6831e602c236ccc4ac1fed98","gameId":5044920251,"name":"Wall Hop Practice","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"5044920251-wall-hop-practice","path":"/game/5044920251-wall-hop-practice","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":5044920251},"slug":"Wall-Hop-Practice-toggle-wallhop-v2-rus-by-me-54251","verified":false,"key":false,"keyless":false,"views":32891,"executes":2469,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/69c870b89b1f7fcbf2c53ced4a121a0c5ad80d7b2d1cdaa06162c1f40fa6a2ac.webp","original":"https://scriptblox.com/images/sb/5044920251-1758445261882.png","scriptblox":"https://scriptblox.com/images/script/5044920251-1758445261882.png"},"thumbnail":{"url":"https://media.kocakz.me/69c870b89b1f7fcbf2c53ced4a121a0c5ad80d7b2d1cdaa06162c1f40fa6a2ac.webp","original":"https://scriptblox.com/images/sb/5044920251-1758445261882.png","scriptblox":"https://scriptblox.com/images/script/5044920251-1758445261882.png"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-09-21T09:01:01.901Z","updatedAt":"2025-09-21T09:01:01.901Z","lastBump":"2025-09-21T09:01:01.901Z","script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = game.Players.LocalPlayer\n\nlocal wallhopEnabled = false\n\nlocal raycastParams = RaycastParams.new()\nraycastParams.FilterDescendantsInstances = {}\nraycastParams.FilterType = Enum.RaycastFilterType.Blacklist\n\nlocal function getWallRaycastResult()\n    local character = player.Character\n    if not character then return nil end\n    local humanoidRootPart = character:FindFirstChild(\"HumanoidRootPart\")\n    if not humanoidRootPart then return nil end\n\n    raycastParams.FilterDescendantsInstances = {character}\n\n    local detectionDistance = 2\n    local closestHit = nil\n    local minDistance = detectionDistance + 1\n    local hrpCF = humanoidRootPart.CFrame\n\n    for i = 0, 7 do\n        local angle = math.rad(i * 45)\n        local direction = (hrpCF * CFrame.Angles(0, angle, 0)).LookVector\n        local ray = workspace:Raycast(humanoidRootPart.Position, direction * detectionDistance, raycastParams)\n        if ray and ray.Instance and ray.Distance < minDistance then\n            minDistance = ray.Distance\n            closestHit = ray\n        end\n    end\n\n    local blockCastSize = Vector3.new(1.5, 1, 0.5)\n    local blockCastOffset = CFrame.new(0, -1, -0.5)\n    local blockCastOriginCF = hrpCF * blockCastOffset\n    local blockCastDirection = hrpCF.LookVector\n    local blockCastDistance = 1.5\n    local blockResult = workspace:Blockcast(blockCastOriginCF, blockCastSize, blockCastDirection * blockCastDistance, raycastParams)\n\n    if blockResult and blockResult.Instance and blockResult.Distance < minDistance then\n         minDistance = blockResult.Distance\n         closestHit = blockResult\n    end\n\n    return closestHit\nend\n\nlocal function performWallHop()\n    local character = player.Character\n    if not character then return end\n    local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    local hrp = character:FindFirstChild(\"HumanoidRootPart\")\n    if not humanoid or not hrp then return end\n\n    local hitResult = getWallRaycastResult()\n    if hitResult then\n        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        local jumpDirection = (hrp.CFrame.LookVector + Vector3.new(0, 1, 0)).Unit\n        local jumpForce = 50\n        hrp.Velocity = jumpDirection * jumpForce\n    end\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n\n    if input.KeyCode == Enum.KeyCode.F then\n        wallhopEnabled = true\n        print(\"Wallhop включён\")\n    elseif input.KeyCode == Enum.KeyCode.E then\n        wallhopEnabled = false\n        print(\"Wallhop отключён\")\n    end\nend)\n\nRunService.Heartbeat:Connect(function()\n    if wallhopEnabled then\n        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then\n            performWallHop()\n        end\n    end\nend)","features":"weird wallhoping \nget updatez on discord server","tags":[],"discord":"https://discord.gg/Kq4jYyNxkj","keyLink":"","owner":{"_id":"68a80d3d9d3c07cb16799d7e","username":"x007n7","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e84d42a2179e2acbb71de898efc9f98e8c80121afa7f66b96643c4cb5a0e6576.webp","original":"https://scriptblox.com/images/photo/68a80d3d9d3c07cb16799d7e-1755932121790.jpeg"},"status":"offline","id":"68a80d3d9d3c07cb16799d7e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/e84d42a2179e2acbb71de898efc9f98e8c80121afa7f66b96643c4cb5a0e6576.webp","original":"https://scriptblox.com/images/photo/68a80d3d9d3c07cb16799d7e-1755932121790.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:45:15.940Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cfbecd6a9f7a4aaf126660","editBy":{"_id":"68a80d3d9d3c07cb16799d7e","username":"x007n7","status":"offline","id":"68a80d3d9d3c07cb16799d7e"},"message":"Create script","createdAt":"2025-09-21T09:01:01.906Z"}],"comments":[{"_id":"68cfd781e5f38118bf8b8956","commentBy":{"_id":"663647799f6b1fc4e47adf51","username":"ZERETET","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/8c00a5d88cfda1116c43d97eb78062b7947cd4f3f479d0a34a81258f79e053ac.webp","original":"https://scriptblox.com/images/photo/663647799f6b1fc4e47adf51-1748065294571.jpg"},"createdAt":"2024-05-04T14:34:33.204Z","lastActive":"2026-09-10T00:44:04.046Z","status":"offline",