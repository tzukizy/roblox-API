{"slug":"Universal-Script-Kill-Script-for-pc-only-111052","_id":"698f877035987d06cf530bdd","title":"Kill Script for pc only","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"touch any player and press :Z: to kill!","tags":[],"script":"-- LocalScript ضعيه في StarterPlayer > StarterPlayerScripts\n-- هذا السكريبت بيشتغل على الـ Client فقط، يعني بيقتل الشخص محلياً (مش هيروح للسيرفر إلا لو في exploit)\n-- لو عايز يشتغل على السيرفر، هتحتاج RemoteEvent بس ده للـ exploit أو لومك الخاص\n\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal lastTouchedHumanoid = nil\n\nlocal function setupCharacter(char)\n    local humanoid = char:WaitForChild(\"Humanoid\")\n    lastTouchedHumanoid = nil\n    \n    local connections = {}\n    \n    local function onTouched(hit)\n        local hitHumanoid = hit.Parent:FindFirstChildOfClass(\"Humanoid\")\n        if hitHumanoid and hitHumanoid.Parent ~= char and Players:GetPlayerFromCharacter(hitHumanoid.Parent) then\n            lastTouchedHumanoid = hitHumanoid\n        end\n    end\n    \n    -- ربط الـ Touched لكل جزء في الشخصية\n    for _, part in pairs(char:GetChildren()) do\n        if part:IsA(\"BasePart\") then\n            local conn = part.Touched:Connect(onTouched)\n            table.insert(connections, conn)\n        end\n    end\n    \n    -- لو إضاف جزء جديد (مثل accessories)\n    char.ChildAdded:Connect(function(child)\n        if child:IsA(\"BasePart\") then\n            local conn = child.Touched:Connect(onTouched)\n            table.insert(connections, conn)\n        end\n    end)\n    \n    -- تنظيف الاتصالات لما الشخصية تموت\n    humanoid.Died:Connect(function()\n        for _, conn in pairs(connections) do\n            conn:Disconnect()\n        end\n    end)\nend\n\n-- إعداد الشخصية الحالية\nif player.Character then\n    setupCharacter(player.Character)\nend\n\n-- إعداد للشخصيات الجديدة (respawn)\nplayer.CharacterAdded:Connect(setupCharacter)\n\n-- الضغط على Z\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.Z then\n        if lastTouchedHumanoid then\n            lastTouchedHumanoid.Health = 0  -- قتل\n            -- أو بديل: lastTouchedHumanoid.Parent:BreakJoints() لو مش شغال\n            print(\"قتلت: \" .. Players:GetNameFromUserIdAsync(lastTouchedHumanoid.Parent:FindFirstChild(\"HumanoidRootPart\").Parent.UserId))  -- طباعة اسم الضحية\n            lastTouchedHumanoid = nil  -- reset\n        else\n            print(\"مافيش حد ملموس!\")\n        end\n    end\nend)\n\nprint(\"السكريبت جاهز! اضغط Z وأنت لمس الشخص اللي عايز تقتله\")","owner":{"_id":"692ac6ac09bc4bcc6164413e","username":"Ayhamo","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"692ac6ac09bc4bcc6164413e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":799,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/c2fcbf3745433e349855843af3d0c5ba5c78514e6d915267d77a49115d6ff48d.webp","original":"https://scriptblox.com/images/sb/0-1771014000869.png","scriptblox":"https://scriptblox.com/images/script/0-1771014000869.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-13T20:20:00.890Z","executes":234,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:32:51.339Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/c2fcbf3745433e349855843af3d0c5ba5c78514e6d915267d77a49115d6ff48d.webp","original":"https://scriptblox.com/images/sb/0-1771014000869.png","scriptblox":"https://scriptblox.com/images/script/0-1771014000869.png"},"changelog":[{"_id":"698f877035987d06cf530be0","editBy":{"_id":"692ac6ac09bc4bcc6164413e","username":"Ayhamo","status":"offline","id":"692ac6ac09bc4bcc6164413e"},"message":"Create script","createdAt":"2026-02-13T20:20:00.892Z"}],"comments":[{"_id":"698f87c163f1c03b3e0cee3f","commentBy":{"_id":"692ac6ac09bc4bcc6164413e","username":"Ayhamo","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"lastActive":"2026-02-22T13:22:56.193Z","createdAt":"2025-11-29T10:10:52.621Z","status":"offline","id":"692ac6ac09bc4bcc6164413e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"text":"mobile version soon!","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-13T20:21:21.842Z","liked":false,"disliked":false},{"_id":"698f8a0f53651065a32bfc6e","commentBy":{"_id":"6927d7797c8e2ffae095b524","username":"MoondudeReal","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/89d808d79eaa91dd69638e50cc1c83271b1afbf8130778027a4f95d6120bc367.webp","original":"https://scriptblox.com/images/photo/6927d7797c8e2ffae095b524-1764218772113.png"},"lastActive":"2026-06-19T04:14:17.204Z","createdAt":"2025-11-27T04:45:45.227Z","status":"offline","id":"6927d7797c8e2ffae095b524","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/89d808d79eaa91dd69638e50cc1c83271b1afbf8130778027a4f95d6120bc367.webp","original":"https://scriptblox.com/images/photo/6927d7797c8e2ffae095b524-1764218772113.png"}},"text":"this is fake, does not actually kill, visual only","edited":false,"l