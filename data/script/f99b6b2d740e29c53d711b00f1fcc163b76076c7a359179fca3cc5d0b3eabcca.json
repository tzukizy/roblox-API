{"slug":"Universal-Script-ball-mover-test-for-later-148039","_id":"69c2f563ac7bc510b6cee2d3","title":"ball mover test for later","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1774384483599.png","placeId":0},"features":"sss","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal mouse = player:GetMouse()\nlocal RunService = game:GetService(\"RunService\")\n\nlocal object\nlocal basePos\nlocal time = 0\n\nlocal amplitude = 5\nlocal speed = 2\n\nmouse.Button1Down:Connect(function()\n    if mouse.Target and mouse.Target.Name == \"Soccerg33ign3t\" then\n        object = mouse.Target\n        basePos = object.Position\n        print(\"Ball selected:\", object:GetFullName())\n    end\nend)\n\nRunService.RenderStepped:Connect(function(dt)\n    if object then\n        time += dt * speed\n        local newY = basePos.Y + math.sin(time) * amplitude\n\n        object.CFrame = CFrame.new(\n            basePos.X,\n            newY,\n            basePos.Z\n        )\n    end\nend)","owner":{"_id":"6987cb04473764a076062791","username":"Kyelisz","verified":false,"profilePicture":"/images/photo/6987cb04473764a076062791-1779551062128.png","status":"offline","id":"6987cb04473764a076062791","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":314,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1774384483599.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-24T20:34:43.616Z","executes":364,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c2f563ac7bc510b6cee2d6","editBy":{"_id":"6987cb04473764a076062791","username":"Kyelisz","status":"offline","id":"6987cb04473764a076062791"},"message":"Create script","createdAt":"2026-03-24T20:34:43.620Z"}],"comments":[{"_id":"69c3dfcbb062c402a12c9bdc","commentBy":{"_id":"6987cb04473764a076062791","username":"Kyelisz","verified":false,"role":"user"