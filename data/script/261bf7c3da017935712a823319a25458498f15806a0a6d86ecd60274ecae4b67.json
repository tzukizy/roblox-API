new(1320.150390625, 439.3188781738281, -42.21080780029297),\n                        [3] = Vector3.new(-0.9938600063323975, -0.021987605839967728, -0.10843834280967712),\n                        [4] = \"Character\"\n                    }\n                    TOOLX.GunServer.HitTest:InvokeServer(unpack(args))\n                end\n            end\n        end\n    end\nend\nwait(0.1)\nend","features":"Roblox Script that when you equip gun and execute rapidly it will kill all of each player","tags":[],"discord":"","keyLink":"","owner":{"_id":"666c005ac859d5f27bbbe650","username":"weenachuangkud","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f0d9bff21357cda3f82a0895d2e7749594ec297e8a8c2e744141ec36196d93bb.webp","original":"https://scriptblox.com/images/photo/666c005ac859d5f27bbbe650-1718354176685.jpeg"},"status":"offline","id":"666c005ac859d5f27bbbe650","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/f0d9bff21357cda3f82a0895d2e7749594ec297e8a8c2e744141ec36196d93bb.webp","original":"https://scriptblox.com/images/photo/666c005ac859d5f27bbbe650-1718354176685.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:09:24.456Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c511d0","editBy":{"_id":"666c005ac859d5f27bbbe650","username":"weenachuangkud","status":"offline","id":"666c005ac859d5f27bbbe650"},"message":"Create script","createdAt":"2025-03-27T22:37:38.732Z"}],"comments":[{"_id":"66778ca150eba4e89b0c0c51","commentBy":{"_id":"665b18ba72ec7ce5cf8df9ce","username":"Jamjam0139","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-06-01T12:48:58.229Z","lastActive":"2025-01-04T11:46:43.246Z","status":"offline","id":"665b18ba