{"slug":"Combat-Initiation-initiate-62772","_id":"6907c30e7fc9b93008bd696c","title":"initiate (godmode)","game":{"_id":"67e5e1ffb360710ec3c78559","gameId":13559635034,"name":"Combat Initiation","imageUrl":"/images/sb/rbx-6c257588551cecd73f962d8165e6b9f1-78ce94db949c.png","placeId":13559635034},"features":"one feature. god mode\nweaknesses i have seen so far: anything that puts a laser on you (mark, captain etc..)\nbecause their damage is server-sided\ncool looking projectiles folder in workspace","tags":[],"script":"local mt = getrawmetatable(game)\nsetreadonly(mt, false)\nlocal old = mt.__namecall\n\nmt.__namecall = newcclosure(function(self, ...)\n    local method = getnamecallmethod()\n\n    if method == \"FireServer\" then\n        local remoteName = tostring(self)\n        if remoteName == \"PlayerDamage\" or remoteName == \"DamageEvent\" then\n            return nil\n        end\n    end\n\n    return old(self, ...)\nend)\n\nlocal oldFireServer\noldFireServer = hookfunction(Instance.new(\"RemoteEvent\").FireServer, function(self, ...)\n    local remoteName = tostring(self)\n    if remoteName == \"PlayerDamage\" or remoteName == \"DamageEvent\" then\n        return nil\n    end\n    return oldFireServer(self, ...)\nend)","owner":{"_id":"66e31fe38476a2b9b1d8d2d1","username":"TheGuyWhoUh","verified":false,"profilePicture":"/images/photo/66e31fe38476a2b9b1d8d2d1-1762525373960.jpg","status":"offline","id":"66e31fe38476a2b9b1d8d2d1","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":3581,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/13559635034-1762547275324.png","likeCount":4,"dislikeCount":0,"createdAt":"2025-11-02T20:46:06.752Z","keyLink":"","executes":93,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6907c30e7fc9b93008bd696e","editBy":{"_id":"66e31fe38476a2b9b1d8d2d1","username":"TheGuyWhoUh","status":"offline","id":"66e31f