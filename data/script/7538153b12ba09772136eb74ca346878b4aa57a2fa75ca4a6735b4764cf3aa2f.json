e something unique as other scripts using Rayfield may overwrite your key file\n      SaveKey = true, -- The user's key will be saved, but if you change the key, they will be unable to use your script\n      GrabKeyFromSite = false, -- If this is true, set Key below to the RAW site you would like Rayfield to get the key from\n      Key = {\"Hello\"} -- List of keys that will be accepted by the system, can be RAW file links (pastebin, github etc) or simple strings (\"hello\",\"key22\")\n   }\n})\n\nlocal Tab = Window:CreateTab(\"ADMIN DANCE\", 4483362458) -- Title, Image\n\nlocal Button = Tab:CreateButton({\n   Name = \"Admin Dance\",\n   Callback = function()\ngame:GetService(\"Players\").LocalPlayer.PlayerGui.DanceGui.Dance.Visible=true\n   end,\n})\n\nlocal Tab = Window:CreateTab(\"CUSTOM MUSIC\", 4483362458) -- Title, Image\n\nlocal Button = Tab:CreateButton({\n   Name = \"Custom Music\",\n   Callback = function()\ngame:GetService(\"Players\").LocalPlayer.PlayerGui.ScreenGui.CustomMusicFrame.Visible=true\n   end,\n})\n\nlocal Button = Tab:CreateButton({\n   Name = \"Close Custom Music\",\n   Callback = function()\ngame:GetService(\"Players\").LocalPlayer.PlayerGui.ScreenGui.CustomMusicFrame.Visible=false\n   end,\n})\n\nlocal Tab = Window:CreateTab(\"Settings\", 4483362458) -- Title, Image\n\nlocal Button = Tab:CreateButton({\n   Name = \"DESTROY\",\n   Callback = function()\nRayfield:Destroy()\n   end,\n})","owner":{"_id":"6894a451c23f749e70688ec8","username":"Coolgod","verified":false,"profilePicture":"/images/photo/6894a451c23f749e70688ec8-1762083541200.jpg","status":"offline","id":"6894a451c23f749e70688ec8","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"views":7210,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/78799866417581-1762086071508.webp","likeCount":4,"dislikeCount":1,"createdAt":"2025-11-02T12:21:11.528Z","editBy":{"_id":"6894a451c23f749e70688ec8","username":"Coolgod","sta