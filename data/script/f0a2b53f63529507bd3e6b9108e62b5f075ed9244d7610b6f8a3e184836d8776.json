ght\"\n            h.FillColor = Color3.fromRGB(255, 0, 0) -- change the fill colour\n            h.OutlineColor = Color3.fromRGB(255, 0, 0) -- change the outline of it here (which doesnt really matter tbh)\n            h.FillTransparency = 0.5 -- (change this if you want it more or less visible)\n            h.OutlineTransparency = 0\n            h.Parent = obj\n        end\n    elseif obj:IsA(\"MeshPart\") or obj:IsA(\"BasePart\") then\n        if not obj:FindFirstChild(\"ScavengerHighlight\") then\n            local h = Instance.new(\"Highlight\")\n            h.Name = \"ScavengerHighlight\"\n            h.FillColor = Color3.fromRGB(255, 0, 0) -- change the fill colour\n            h.OutlineColor = Color3.fromRGB(255, 0, 0) -- change the outline of it here (which doesnt really matter tbh)\n            h.FillTransparency = 0.5 -- (change this if you want it more or less visible)\n            h.OutlineTransparency = 0\n            h.Parent = obj\n        end\n    end\nend\n\nfor _, item in ipairs(ITEMS_FOLDER:GetChildren()) do\n    applyHighlight(item)\nend\n\nITEMS_FOLDER.ChildAdded:Connect(applyHighlight)\n","features":"Will higlight all the roses you need to find for  the scavenger hunt in red, if too hard  to see you can edit the script to change the colour.","tags":[],"discord":"","keyLink":"","owner":{"_id":"67a4bdca4f3536cd6921ae12","username":"doomkitty","verified":false,"profilePicture":{"url":"https://media.kocakz.me/35a9cd27470d06ba41d0b963f16542afe907798a04eb13d7728044cc791e7132.webp","original":"https://scriptblox.com/images/photo/67a4bdca4f3536cd6921ae12-1769651791763.jpeg"},"lvl":7,"status":"offline","id":"67a4bdca4f3536cd6921ae12","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/35a9cd27470d06ba41d0b963f16542afe907798a04eb13d7728044cc791e7132.webp","original":"https://scriptblox.com/images/photo/67a4bdca4f3536cd6921ae12-1769651791763.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"ve