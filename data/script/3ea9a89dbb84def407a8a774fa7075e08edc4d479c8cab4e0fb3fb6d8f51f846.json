{"_id":"66e8e9d5c77be28ab660f001","title":"Universal Teleport System","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/a04b65704c7af3bb2fbbe9a2738610cc87dac342957fca019c82dc3d4a3fa5ff.webp","original":"https://scriptblox.com/images/sb/4876346-1726540245459.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/a04b65704c7af3bb2fbbe9a2738610cc87dac342957fca019c82dc3d4a3fa5ff.webp","original":"https://scriptblox.com/images/sb/4876346-1726540245459.png"},"placeId":0},"slug":"Universal-Script-Universal-Teleport-System-18494","verified":false,"key":false,"keyless":false,"views":33113,"executes":361,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/0eef37b6f60529b9d2a57cf5d6b152ca48f4384db0b212c5c82888532a7d2fa5.webp","original":"https://scriptblox.com/images/sb/4876346-1726540245459.png","scriptblox":"https://scriptblox.com/images/script/4876346-1726540245459.png"},"thumbnail":{"url":"https://media.kocakz.me/0eef37b6f60529b9d2a57cf5d6b152ca48f4384db0b212c5c82888532a7d2fa5.webp","original":"https://scriptblox.com/images/sb/4876346-1726540245459.png","scriptblox":"https://scriptblox.com/images/script/4876346-1726540245459.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-09-17T02:30:45.524Z","updatedAt":"2024-09-17T02:30:45.524Z","lastBump":"2024-09-17T02:30:45.524Z","script":"local engine = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Singularity5490/rbimgui-2/main/rbimgui-2.lua\"))()\n\nlocal plrs = game.Players\nlocal lp = plrs.LocalPlayer\n\nlocal function updatePlayers(partition)\n\tfor _, plr in pairs(plrs:GetPlayers()) do\n        if plr ~= lp then\n            partition.new(plr.Name)\n        end\n\tend\nend\n\nlocal window1 = engine.new({\n    text = \"Teleport System (BETA)\",\n    size = UDim2.new(300, 200),\n})\n\nwindow1.open()\n\nlocal tab1 = window1.new({\n    text = \"Manager\",\n})\n\nlocal players = tab1.new(\"dropdown\", {\n    text = \"Players\",\n})\n\nupdatePlayers(players)\nplayers.event:Connect(function(name)\n    lp.Character.HumanoidRootPart.CFrame = plrs:FindFirstChild(name).Character.HumanoidRootPart.CFrame\nend)\n\nlocal refresh_trigger = tab1.new(\"button\", {\n    text = \"Refresh\",\n})\nrefresh_trigger.event:Connect(function()\n    players:close()\n    updatePlayers(players)\nend)","features":"Not my best work but i was bored, idk if the refresh button really works bcs this UI library is confusing and there isn't a clear function for dropdowns I think.\n\n- Open Source Only -","tags":[],"discord":"","keyLink":"","owner":{"_id":"630bf3a9797de5f1805b2f00","username":"Seasonal","verified":false,"profilePicture":{"url":"https://media.kocakz.me/486cc9c79a570ab3a307c4c0d595ac117c9a6f3acdf566f09d3fb540097bcfd5.webp","original":"https://scriptblox.com/images/photo/630bf3a9797de5f1805b2f00-1726540044287.png"},"status":"offline","id":"630bf3a9797de5f1805b2f00","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/486cc9c79a570ab3a307c4c0d595ac117c9a6f3acdf566f09d3fb540097bcfd5.webp","original":"https://scriptblox.com/images/photo/630bf3a9797de5f1805b2f00-1726540044287.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:07:17.716Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c521b2","editBy":{"_id":"630bf3a9797de5f1805b2f00","username":"Seasonal","status":"offline","id":"630bf3a9797de5f1805b2f00"},"message":"Create script","createdAt":"2025-03-27T20:47:22.421Z"}],"comments":[{"_id":"66e91a42837f670aeb2bc9bd","commentBy":{"_id":"66213c0dd7aacf5155e41c48","username":"Xenijo","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/5dff8f6f819d2f1890b0d18f6135a0fb48e04c8c83169222a4219f6ba4b58fc8.webp","original":"https://scriptblox.com/images/photo/66213c0dd7aacf5155e41c48-1713454287246.jpg"},"createdAt":"2024-04-18T15:28:13.564Z","lastActive":"2024-09-23T20:03:49.029Z","status":"offline","id":"66213c0dd7aacf5155e41c48","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/5dff8f6f819d2f1890b0d18f6135a0fb48e04c8c83169222a4219f6ba4b58fc8.webp","original":"https://scriptblox.com/images/photo/66213c0dd7aacf5155e41c48-1713454287246.jpg"}},"text":"Bro this is the most basic luau *, whyshould you make an opensource version that dosent even support different types of teleporting","createdAt":"2024-09-17T05:57:22.782Z","edited":true,"dislikeCount":1,"likeCount":1,"liked":false,"disliked":false},{"_id":"6833eee151e1bfc46b89e211","commentBy":{"_id":"6771626cdc82201ac6390a51","username":"sufferedsuccess","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/36e7cce7d21cf572da826c44f28248e898e20e04e0644f237adb468186decdfe.webp","original":"https://scriptblox.com/images/photo/6771626cdc82201ac6390a51-1745584457500.png"},"createdAt":"2024-12-29T14:53:32.690Z","lastActive":"2026-01-30T12:54:12.830Z","status":"offline","id":"6771626cdc82201ac6390a51","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/36e7cce7d21cf572da826c44f28248e898e20e04e0644f237adb468186decdfe.webp","original":"https://scriptblox.com/images/photo/6771626cdc82201ac6390a51-1745584457500.png"}},"text":"thanks for the library","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-05-26T04:32:33.524Z","liked":false,"disliked":false}]}