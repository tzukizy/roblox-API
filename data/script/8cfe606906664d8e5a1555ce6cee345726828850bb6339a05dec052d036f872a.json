l.BackgroundTransparency = 0.3\nlabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nlabel.TextColor3 = Color3.fromRGB(255, 255, 255)\nlabel.Font = Enum.Font.SourceSansBold\nlabel.TextSize = 22\nlabel.Text = \"Speed: 0 SPS\"\nlabel.Parent = spsGui\n\n\nlocal lastPos = hrp.Position\nlocal lastTime = tick()\n\nRunService.RenderStepped:Connect(function()\n\tif not hrp or not hrp.Parent then\n\t\tcharacter = player.Character or player.CharacterAdded:Wait()\n\t\thrp = character:WaitForChild(\"HumanoidRootPart\")\n\t\tlastPos = hrp.Position\n\t\tlastTime = tick()\n\t\treturn\n\tend\n\n\tlocal currentTime = tick()\n\tlocal dt = currentTime - lastTime\n\tlocal currentPos = hrp.Position\n\n\tlocal dist = (currentPos - lastPos).Magnitude\n\tlocal speed = dist / dt\n\n\tlabel.Text = string.format(\"Speed: %.1f SPS\", speed)\n\n\tlastPos = currentPos\n\tlastTime = currentTime\nend)","features":"Makes a gui that tells you how many studs per second you're going, it's small so it wont bug or annoy you","tags":[],"discord":"","keyLink":"","owner":{"_id":"66a9969e862a2069b63cb219","username":"ScriptTester","verified":false,"profilePicture":{"url":"https://media.kocakz.me/29aedb82ddeb32181a2dee2a18903aa31efcaad5041f0c349ca548776e0e4636.webp","original":"https://scriptblox.com/images/photo/66a9969e862a2069b63cb219-1722571577447.png"},"status":"offline","id":"66a9969e862a2069b63cb219","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/29aedb82ddeb32181a2dee2a18903aa31efcaad5041f0c349ca548776e0e4636.webp","original":"https://scriptblox.com/images/photo/66a9969e862a2069b63cb219-1722571577447.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:03:45.472Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"686de4aae1763d2301ae65b5","editBy":{"_id":"66a9969e862