{"slug":"Better-Country!-KILL-AURA-25034","_id":"676903cd13bf69140fc1989c","title":"KILL AURA","game":{"_id":"67e5e1ffb360710ec3c7876e","gameId":103727612616060,"name":"🇦🇺Better Country?!🇺🇸","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":103727612616060},"features":"kill aura","tags":["kill aura","FE","kill"],"script":"local cloneref = cloneref or function(obj) return obj end\nlocal Players = cloneref(game:GetService(\"Players\"))\nlocal lp = cloneref(Players.LocalPlayer)\n\nlocal function getchar(plr)\n    return (plr or lp).Character\nend\nlocal function gethumanoid(plr)\n    local char = plr and plr:IsA(\"Model\") and plr or getchar(plr)\n    return (char and char:FindFirstChildWhichIsA(\"Humanoid\")),char\nend\nlocal function GetHumanoids()\n    local Humanoids = {}\n    for i,v in Players:GetPlayers() do\n        local Humanoid,char = gethumanoid(v)\n        if char and Humanoid then\n            Humanoids[char] = Humanoid\n        end\n    end\n    return Humanoids\nend\n\nwhile task.wait() do\n    for _, v in GetHumanoids() do\n        repeat task.wait() until v\n        if v ~= lp then\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"SwordEvent\"):FireServer(\"Damage\",v)\n        end\n    end\nend","owner":{"_id":"64d74e5160ae83e54e4b1d4e","username":"barcon","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9d4a4a35ebf2ad503ff4bbd2baed1816bd2233f81da186d4ae795820d02923c8.webp","original":"https://scriptblox.com/images/photo/64d74e5160ae83e54e4b1d4e-1711538777552.jpg"},"status":"offline","id":"64d74e5160ae83e54e4b1d4e","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/9d4a4a35ebf2ad503ff4bbd2baed1816bd2233f81da186d4ae795820d02923c8.webp","original":"https://scriptblox.com/images/photo/64d74e5160ae83e54e4b1d4e-1711538777552.jpg"}},"verified":false,"keyL