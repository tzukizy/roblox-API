tate(parent, enabled)\n    if not parent then return end\n\n    for _, obj in pairs(parent:GetDescendants()) do\n        if obj:IsA(\"BasePart\") then\n            if enabled then\n                -- save original\n                if not stored[obj] then\n                    stored[obj] = {\n                        Transparency = obj.Transparency,\n                        CanCollide = obj.CanCollide\n                    }\n                end\n\n                obj.Transparency = 0.8\n                obj.CanCollide = false\n            else\n                -- restore original\n                if stored[obj] then\n                    obj.Transparency = stored[obj].Transparency\n                    obj.CanCollide = stored[obj].CanCollide\n                    stored[obj] = nil\n                end\n            end\n        end\n    end\nend\n\nSection:CreateToggle(\"Remove DoorsToilets\", function(value)\n    local doors = workspace:FindFirstChild(\"NewDoors\")\n    local breakables = workspace:FindFirstChild(\"Prison_ITEMS\") and workspace.Prison_ITEMS:FindFirstChild(\"breakables\")\n\n    setState(doors, value)\n    setState(breakables, value)\nend)\n\nSection:CreateButton(\"Instant Proximity\", function()\nloadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Instantly-interact-with-proximity-prompt-73901\"))()\nend)\n\nSection:CreateButton(\"Nameless admin\", function()\nloadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Nameless-admin-reworked-75477\"))()\nend)","features":"Op","tags":[],"discord":"","keyLink":"","owner":{"_id":"699669611a5b231013d0fff7","username":"enadla2","verified":false,"profilePicture":{"url":"https://media.kocakz.me/66765cc30aa7e8c5f0deb83ba0c55ed608f8a3057d9067f46ddaea84ccc1e1f0.webp","original":"https://scriptblox.com/images/photo/699669611a5b231013d0fff7-1771731297692.jpg"},"lvl":8,"status":"offline","id":"699669611a5b231013d0fff7","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"ur