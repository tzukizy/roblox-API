{"slug":"99-Nights-in-the-Forest-Inf-Candy-Open-Source-64279","_id":"690ef10c75317c7f9073b328","title":"Inf Candy Open Source","game":{"_id":"68437b38a7d0bed5d5235e5c","gameId":79546208627805,"name":"99 Nights in the Forest 🔦","imageUrl":"/images/sb/rbx-ee923b1e9ac5564624ee9c484006166c-f56e8db3f7d9.png","placeId":79546208627805},"features":"OPen source ig","tags":[],"script":"\n_G.Auto = true --true or false\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Event = ReplicatedStorage.RemoteEvents.CarnivalCompleteShootingGallery\n\nlocal function findTargets(parent, depth)\n    if depth > 3 then return {} end\n    \n    local targets = {}\n    \n    for _, child in ipairs(parent:GetChildren()) do\n        if child:IsA(\"BasePart\") then\n            table.insert(targets, child)\n        end\n        \n        for _, subTarget in ipairs(findTargets(child, depth + 1)) do\n            table.insert(targets, subTarget)\n        end\n    end\n    \n    return targets\nend\n\nspawn(function()\n    while task.wait(3) do\n    \n        local targets = {}\n        local areas = {\n            workspace.Map,\n            workspace.Items, \n            workspace.Characters\n        }\n        \n        for _, area in ipairs(areas) do\n            for _, target in ipairs(findTargets(area, 0)) do\n                table.insert(targets, target)\n            end\n        end\n        \n        for index, target in ipairs(targets) do\n            if not _G.Auto then break end\n            \n            local success = pcall(function()\n                Event:FireServer(target)\n            end)\n            task.wait(0.05)\n        end\n    end\nend)","owner":{"_id":"686413b4bfaa36c66e4d2a57","username":"Defyz","verified":false,"profilePicture":"/images/photo/686413b4bfaa36c66e4d2a57-1771605478346.jpg","status":"offline","id":"686413b4bfaa36c66e4d2a57","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":6187,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-643b9b9285f3bd9b63cf392db12a4d87-b73d96e49ffb.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-11-08T07:28:12.274Z","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"690ef10c75317c7f9073b32a","editBy":{"_id":"686413b4bfaa36c66e4d2a57","username":"Defyz","status":"offline","id":"686413b4bfaa36c66e4d2a57"},"message":"Create script","createdAt":"2025-11-08T07:28:12.277Z"}],"comments":[{"_id":"690ef17ac16415eb15e7501b","commentBy":{"_id":"66f6b99bf5ba2f22f3590918","username":"Neko_Hub","verified":false,"role":"user","profilePicture":"/images/photo/66f6b99bf5ba2f22f3590918-1760896263881.jpg","createdAt":"2024-09-27T13:56:43.635Z","lastActive":"2025-11-08T16:35:44.034Z","status":"offline","id":"66f6b99bf5ba2f22f3590918"},"text":"don't work","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-08T07:30:02.999Z","liked":false,"disliked":false},{"_id":"690ef5e25a90afd92239d3c4","commentBy":{"_id":"63304455bc30ce3275d92813","username":"AgunsMochi","verified":false,"role":"user","profilePicture":"/images/photo/63304455bc30ce3275d92813-1708322104142.jpg","createdAt":"2022-09-25T12:06:45.493Z","lastActive":"2026-07-22T16:42:17.045Z","status":"offline","id":"63304455bc30ce3275d92813","topMilestone":{"key":"creator.first_script","tier":1}},"text":"patched","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-08T07:48:50.605Z","liked":false,"disliked":false},{"_id":"690ef8277059aa77e0d905a6","commentBy":{"_id":"678dea6039bb7059436ebaf1","username":"suedincourt","verified":false,"role":"user","profilePicture":"/images/photo/678dea6039bb7059436ebaf1-1763963877714.jpg","createdAt":"2025-01-20T06:17:04.528Z","lastActive":"2026-04-11T19:02:57.049Z","status":"offline","id":"678dea6039bb7059436ebaf1"},"text":"if the guy said doesn't work 3 minutes after ts dropped, did it ever work in the first place","edited":false,"l