ield if index (argument 1) is one of bad ones\n    end\n    return bypass(index, ...) \nend))","owner":{"_id":"68fe4ffe4a2d9c9534a220ef","username":"some11","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/357aa128d1bfd993b073df86a2d437e4a82592449efd883de4aa7f2469042aeb.webp","original":"https://scriptblox.com/images/photo/68fe4ffe4a2d9c9534a220ef-1774729355775.jpg"},"status":"offline","id":"68fe4ffe4a2d9c9534a220ef","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/357aa128d1bfd993b073df86a2d437e4a82592449efd883de4aa7f2469042aeb.webp","original":"https://scriptblox.com/images/photo/68fe4ffe4a2d9c9534a220ef-1774729355775.jpg"}},"verified":false,"views":626,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/e984306281d5b71e3516f62db0c9ddaf37d87dfccf2aa4f3fb51b8e31770bdd0.webp","original":"https://scriptblox.com/images/sb/0-1773075664619.jpg","scriptblox":"https://scriptblox.com/images/script/0-1773075664619.jpg"},"likeCount":3,"dislikeCount":0,"createdAt":"2026-03-09T17:01:04.632Z","keyLink":"","editBy":{"_id":"68fe4ffe4a2d9c9534a220ef","username":"some11","status":"offline","id":"68fe4ffe4a2d9c9534a220ef"},"executes":54,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:22:13.370Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/e984306281d5b71e3516f62db0c9ddaf37d87dfccf2aa4f3fb51b8e31770bdd0.webp","original":"https://scriptblox.com/images/sb/0-1773075664619.jpg","scriptblox":"https://scriptblox.com/images/script/0-1773075664619.jpg"},"changelog":[{"_id":"69aefcd006c4bd6aa80a0c8c","editBy":{"_id":"68fe4ffe4a2d9c9534a220ef","username":"some11","status":"offline","id":"68fe4ffe4a2d9c9534a220ef"},"message":"Create sc