{"slug":"Infinite-Cash-(Open-source)_917","_id":"621ac80693faafdb16a80868","title":"Infinite Cash (Open source)","game":{"_id":"67e5e1ffb360710ec3c7890f","gameId":8730246074,"name":"[Mobile Support] Tower Galactica","imageUrl":"https://tr.rbxcdn.com/b6e79eb00cef3fce971f5ff0b45e0980/500/280/Image/Jpeg","placeId":8730246074},"features":"*not mine*\n\nmade by Ezpi#0474","tags":["Cash","Infinity"],"script":"--// Exploit Fix \\\\--\nif not pcall(function() return syn.protect_gui end) then\n    syn = {}\n    syn.protect_gui = function(A_1)\n        A_1.Parent = CoreGui\n    end\nend\n\n--// Services \\\\--\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\n--// Variable \\\\--\nlocal Player = Players.LocalPlayer\nlocal Remote = ReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"SellTower\")\n\n--// UI Library \\\\--\nlocal Library = loadstring(game:HttpGetAsync('https://raw.githubusercontent.com/Just-Egg-Salad/roblox-scripts/main/uwuware'))()\nlocal Window = Library:CreateWindow(\"EzMode by Ezpi#0474\")\nWindow:AddLabel({\n    text = \"discord.gg/nxHQEk2kEt\"\n})\nWindow:AddButton({\n    text = \"Inf. Cash\",\n    callback = function()\n        Remote:FireServer({\n            Config = {\n                Owner = {Value = Player},\n                SellValue = {Value = 999999999}\n            }\n        })\n    end\n})\nLibrary:Init()","owner":{"_id":"61d8211e7537e0112f48ecfa","username":"INMENR","verified":false,"profilePicture":"/images/photo/61d8211e7537e0112f48ecfa-1658044677419.jpg","status":"offline","id":"61d8211e7537e0112f48ecfa","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1926,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-02-27T00:38:30.455Z","dislikeCount":0,"likeCount":2,"image":"/images/sb/8730246074-1645922310445.jpg","executes":4,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGam