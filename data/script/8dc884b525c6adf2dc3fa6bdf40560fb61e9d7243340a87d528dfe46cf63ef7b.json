{"slug":"Race-Ranks-Speedsters-sandbox-SPS-Cap-Remover-47750","_id":"68941744b01bf0dbf0fd1deb","title":"SPS Cap Remover","game":{"_id":"68941744b01bf0dbf0fd1de7","gameId":101411193179895,"name":"[GOKU] Speedsters Sandbox","imageUrl":"/images/sb/rbx-75d205a99ce9782c25fa254cd74553e5-8c7f0b0d37fa.png","placeId":101411193179895},"features":"This unlocks the games SPS (studs per second or wtvr it stands for) cap in the game, works on all characters 👍\n\n\n(the security on this game is so fucking bad, i might make a script that unlocks all characters but if u have decent knowledge you can very easily unlock a character you would like)","tags":["speedster"],"script":"-- the script was meant for the black flash as a \"canonically accurate black flash\" script but it works for all skins\n-- if you start slowing down, stop pressing w, a, s, d, or holding ur thumbstick for one second then proceed running.\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function setupBlackFlash()\n    local character = player.Character or player.CharacterAdded:Wait()\n    local humanoid = character:FindFirstChild(\"Humanoid\")\n    local model = workspace:FindFirstChild(player.Name)\n    \n    if model then\n        local accelerate = model:FindFirstChild(\"accelerate\")\n        \n        if accelerate then\n            if accelerate:FindFirstChild(\"maxspeed\") then\n                accelerate.maxspeed.Value = 99999999999\n            end\n            \n            if accelerate:FindFirstChild(\"originalspeed\") then\n                accelerate.originalspeed.Value = 99999999999\n            end\n            \n            if accelerate:FindFirstChild(\"speeduptime\") then\n                accelerate.speeduptime.Value = 99999999999\n            end\n            \n            if accelerate:FindFirstChild(\"animation\") then\n                accelerate.animation.Value = 3\n            end\n        end\n    end\n    \n    if humanoid then\n        humanoid.WalkSpeed = 99999999999\n    end\nend\n\nwhile true do\n    setupBlackFlash()\n    task.wait(0.1)\nend","owner":{"_id":"68874ad6a6b63d6e7d844076","username":"4layy","verified":false,"profilePicture":"/images/photo/68874ad6a6b63d6e7d844076-1753697081435.png","status":"offline","id":"68874ad6a6b63d6e7d844076","topMilestone":{"key":"creator.executions","tier":100000}},"verified":false,"views":6741,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-75d205a99ce9782c25fa254cd74553e5-8c7f0b0d37fa.png","likeCount":3,"dislikeCount":0,"createdAt":"2025-08-07T03:02:28.330Z","editBy":{"_id":"68874ad6a6b63d6e7d844076","username":"4layy","status":"offline","id":"68874ad6a6b63d6e7d844076"},"executes":173,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68941744b01bf0dbf0fd1ded","editBy":{"_id":"68874ad6a6b63d6e7d844076","username":"4layy","status":"offline","id":"68874ad6a6b63d6e7d844076"},"message":"Create script","createdAt":"2025-08-07T03:02:28.332Z"},{"_id":"6894184ff591134c30fe4170","editBy":{"_id":"68874ad6a6b63d6e7d844076","username":"4layy","status":"offline","id":"68874ad6a6b63d6e7d844076"},"message":"Update script","createdAt":"2025-08-07T03:06:55.988Z"}],"comments":[{"_id":"689442ea1e374267919c7f6d","commentBy":{"_id":"67e47038dd0c603509a4fb3b","username":"aggot","verified":false,"role":"user","profilePicture":"/images/photo/67e47038dd0c603509a4fb3b-1743037581415.jpg","createdAt":"2025-03-26T21:23:04.961Z","lastActive":"2026-06-10T20:01:12.775Z","status":"offline","id":"67e47038dd0c603509a4fb3b","topMilestone":{"key":"creator.first_script","tier":1}},"text":"ts peak maybe","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-08-07T06:08:42.686Z","liked":false,"disliked":false},{"_id":"68944343b504d17ff349a801","commentBy":{"_id":"685c0f96b817f4649174045c","username":"veikeron","verified":false,"role":"user","profilePicture":"/images/photo/685c0f96b817