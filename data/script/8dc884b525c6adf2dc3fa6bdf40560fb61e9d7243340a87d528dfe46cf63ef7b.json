{"slug":"Race-Ranks-Speedsters-sandbox-SPS-Cap-Remover-47750","_id":"68941744b01bf0dbf0fd1deb","title":"SPS Cap Remover","game":{"_id":"68941744b01bf0dbf0fd1de7","gameId":101411193179895,"name":"[GOKU] Speedsters Sandbox","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":101411193179895},"features":"This unlocks the games SPS (studs per second or wtvr it stands for) cap in the game, works on all characters 👍\n\n\n(the security on this game is so fucking bad, i might make a script that unlocks all characters but if u have decent knowledge you can very easily unlock a character you would like)","tags":["speedster"],"script":"-- the script was meant for the black flash as a \"canonically accurate black flash\" script but it works for all skins\n-- if you start slowing down, stop pressing w, a, s, d, or holding ur thumbstick for one second then proceed running.\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function setupBlackFlash()\n    local character = player.Character or player.CharacterAdded:Wait()\n    local humanoid = character:FindFirstChild(\"Humanoid\")\n    local model = workspace:FindFirstChild(player.Name)\n    \n    if model then\n        local accelerate = model:FindFirstChild(\"accelerate\")\n        \n        if accelerate then\n            if accelerate:FindFirstChild(\"maxspeed\") then\n                accelerate.maxspeed.Value = 99999999999\n            end\n            \n            if accelerate:FindFirstChild(\"originalspeed\") then\n                accelerate.originalspeed.Value = 99999999999\n            end\n            \n            if accelerate:FindFirstChild(\"speeduptime\") then\n                accelerate.speeduptime.Value = 99999999999\n            end\n            \n            if accelerate:FindFirstChild(\"animation\") then\n                accelerate.animation.Value = 3\n            end\n        end\n    end\n    \n    if humanoid then\n        humanoid.WalkSpeed = 99999999999\n    end\nend\n\nwhile true do\n    setupBlackFlash()\n    task.wait(0.1)\nend","owner":{"_id":"68874ad6a6b63d6e7d844076","username":"4layy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/72ef69872baa5987be534cbbd3182835418b37cf918a18fbeb633d7be044b67a.webp","original":"https://scriptblox.com/images/photo/68874ad6a6b63d6e7d844076-1753697081435.png"},"status":"offline","id":"68874ad6a6b63d6e7d844076","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/72ef69872baa5987be534cbbd3182835418b37cf918a18fbeb633d7be044b67a.webp","original":"https://scriptblox.com/images/photo/68874ad6a6b63d6e7d844076-1753697081435.png"}},"verified":false,"views":6752,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-75d205a99ce9782c25fa254cd74553e5-8c7f0b0d37fa.png","scriptblox":"https://scriptblox.com/images/script/rbx-75d205a99ce9782c25fa254cd74553e5-8c7f0b0d37fa.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-08-07T03:02:28.330Z","editBy":{"_id":"68874ad6a6b63d6e7d844076","username":"4layy","status":"offline","id":"68874ad6a6b63d6e7d844076"},"executes":203,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:50:54.449Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-75d205a99ce9782c25fa254cd74553e5-8c7f0b0d37fa.png","scriptblox":"https://scriptblox.com/images/script/rbx-75d205a99ce9782c25fa254cd74553e5-8c7f0b0d37fa.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68941744b01bf0dbf0fd1ded","editBy":{"_id":"68874