nce.new(c3) if not pe.LightEmission then pe.LightEmission = 1 end elseif pe:IsA(\"Decal\") then pe.Color3 = Color3.new(c3.R + 0.33, c3.G + 0.33, c3.B + 0.33) elseif pe:IsA(\"Light\") then pe.Color = c3 end end local function rizz(char) local weapons = { \"#KATANAWEAPON\", \"#NinjaKATANA\", \"#BATWEAPON\" } for _, weaponName in ipairs(weapons) do local weapon = char:FindFirstChild(weaponName) if weapon then for _, pe in weapon:GetDescendants() do hawk_tuah(pe) end table.insert(connections, weapon.DescendantAdded:Connect(hawk_tuah)) end end for _, pe in char:GetDescendants() do hawk_tuah(pe) end table.insert(connections, char.DescendantAdded:Connect(hawk_tuah)) end local function onPlayerAdded(player) if player:IsA(\"Model\") then rizz(player) else rizz(player.Character or player.CharacterAdded:Wait()) table.insert(connections, player.CharacterAdded:Connect(rizz)) end end onPlayerAdded(player) -- color change script","features":"Atomic Samurai To Yuta","tags":[],"discord":"","keyLink":"","owner":{"_id":"66de60ad3cc1d714689c5b23","username":"allowed","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ec019b6d359bd80fe47153e212f2381c5e879bd27069eaffb599bd4037e819e5.webp","original":"https://scriptblox.com/images/photo/66de60ad3cc1d714689c5b23-1728712720146.jpg"},"status":"offline","id":"66de60ad3cc1d714689c5b23","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/ec019b6d359bd80fe47153e212f2381c5e879bd27069eaffb599bd4037e819e5.webp","original":"https://scriptblox.com/images/photo/66de60ad3cc1d714689c5b23-1728712720146.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:13:37.448Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c539b2","editBy":{"_id":"66de60ad3cc1d714689c5b23","username":"allowed","status":"