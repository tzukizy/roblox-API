{"slug":"Universal-Script-anti-fling-17655","_id":"66ce7730443330bde06365a3","title":"anti fling","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"anti fling","tags":[],"script":"-- anti fling\nlocal function antiFling(player)\n    player.CharacterAppearanceLoaded:Wait()\n            \n    for _, child in pairs(player.Character:GetChildren()) do\n        if child:IsA(\"BasePart\") then\n            child.CanCollide = false\n                    \n            if child.Name == \"Torso\" then\n                child.Massless = true\n            end\n                    \n            local vector = Vector3.new()\n                    \n            child.Velocity = vector\n            child.RotVelocity = vector\n        end\n    end\nend\n\nfor _, player in pairs(game:GetService(\"Players\"):GetPlayers()) do\n    if player ~= game:GetService(\"Players\").LocalPlayer then\n        antiFling(player)\n    end\nend\n\ngame.Players.PlayerAdded:Connect(function(Player)\n    Player.CharacterAdded:Connect(function()\n        antiFling(Player)\n    end)\nend)","owner":{"_id":"669c97e031fa702ed1a0c3c1","username":"0x88","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/565eeaa1c59783fdf24f87cc1c03cf8dd8e5672911af42afb31a4702a54bad32.webp","original":"https://scriptblox.com/images/photo/669c97e031fa702ed1a0c3c1-1723539622071.jpg"},"status":"offline","id":"669c97e031fa702ed1a0c3c1","profile":{"url":"https://cdn.kocakz.me/images/565eeaa1c59783fdf24f87cc1c03cf8dd8e5672911af42afb31a4702a54bad32.webp","original":"https://scriptblox.com/images/photo/669c97e031fa702ed1a0c3c1-1723539622071.jpg"}},"verified":false,"keyLink":"","views":107747,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-08-28T01:02:40.113Z","dis