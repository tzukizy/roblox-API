{"slug":"Universal-Script-anti-fling-17655","_id":"66ce7730443330bde06365a3","title":"anti fling","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/8412108-1724806960055.png","placeId":0},"features":"anti fling","tags":[],"script":"-- anti fling\nlocal function antiFling(player)\n    player.CharacterAppearanceLoaded:Wait()\n            \n    for _, child in pairs(player.Character:GetChildren()) do\n        if child:IsA(\"BasePart\") then\n            child.CanCollide = false\n                    \n            if child.Name == \"Torso\" then\n                child.Massless = true\n            end\n                    \n            local vector = Vector3.new()\n                    \n            child.Velocity = vector\n            child.RotVelocity = vector\n        end\n    end\nend\n\nfor _, player in pairs(game:GetService(\"Players\"):GetPlayers()) do\n    if player ~= game:GetService(\"Players\").LocalPlayer then\n        antiFling(player)\n    end\nend\n\ngame.Players.PlayerAdded:Connect(function(Player)\n    Player.CharacterAdded:Connect(function()\n        antiFling(Player)\n    end)\nend)","owner":{"_id":"669c97e031fa702ed1a0c3c1","username":"0x88","verified":false,"profilePicture":"/images/photo/669c97e031fa702ed1a0c3c1-1723539622071.jpg","status":"offline","id":"669c97e031fa702ed1a0c3c1"},"verified":false,"keyLink":"","views":107741,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-08-28T01:02:40.113Z","dislikeCount":0,"likeCount":2,"image":"/images/sb/8412108-1724806960055.png","executes":223,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51e60","editBy":{"_id":"669c97e031fa702ed1a0c3c1","username":"0x88","status":"offline","id":"669c97e031fa702ed1a0c3c1"},"message":"Create script","createdAt":"2025-03-27T21:55:53.995Z"}],"comments":[{"_id":"66cefe57627b1f24dbe410d2","commentBy":{"_id":