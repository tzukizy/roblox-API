{"_id":"690d4cfc12975ad103263719","title":"vl167134","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/38041e66284b79efcff1257a4de66f42210b71a9fc0eea64eebb633732282cd0.webp","original":"https://scriptblox.com/images/sb/0-1762479356737.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/38041e66284b79efcff1257a4de66f42210b71a9fc0eea64eebb633732282cd0.webp","original":"https://scriptblox.com/images/sb/0-1762479356737.png"},"placeId":0},"slug":"Universal-Script-vl167134-63954","verified":false,"key":false,"keyless":false,"views":10184,"executes":20,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/aa20a46a53dad7b17bc137cbc1259c93699c15caf1ee2750d7633244d7bdf985.webp","original":"https://scriptblox.com/images/sb/0-1762479356737.png","scriptblox":"https://scriptblox.com/images/script/0-1762479356737.png"},"thumbnail":{"url":"https://media.kocakz.me/aa20a46a53dad7b17bc137cbc1259c93699c15caf1ee2750d7633244d7bdf985.webp","original":"https://scriptblox.com/images/sb/0-1762479356737.png","scriptblox":"https://scriptblox.com/images/script/0-1762479356737.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-07T01:35:56.756Z","updatedAt":"2025-11-07T01:35:56.756Z","lastBump":"2025-11-07T01:35:56.756Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal TILT_SIZE = 250\n\nlocal Player = Players.LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\nlocal Root\nlocal RootJoint\n\nlocal Angle1 = 0\nlocal Angle2 = 0\nlocal Direction\nlocal Velocity\n\nlocal ORIGINAL_C0\nlocal CHARACTER_RIG_TYPE = Humanoid.RigType\n\nif CHARACTER_RIG_TYPE == Enum.HumanoidRigType.R6 then\n\tRoot = Character:WaitForChild(\"Root\")\n\tRootJoint = Root:WaitForChild(\"RootJoint\")\nelse\n\tRoot = Character:WaitForChild(\"LowerTorso\")\n\tRootJoint = Root:WaitForChild(\"Root\")\nend\n\nORIGINAL_C0 = RootJoint.C0\n\nlocal function Heartbeat()\n\tif Humanoid.Health > 0 then\n\t\tVelocity = Root.Velocity * Vector3.new(1, 0, 1)\n\t\t\n\t\tif Velocity.Magnitude > 2 then\n\t\t\tDirection = Velocity.Unit\n\t\t\t\n\t\t\tAngle1 = Root.CFrame.LookVector:Dot(Direction) / (1000 / TILT_SIZE)\n\t\t\tAngle2 = Root.CFrame.RightVector:Dot(Direction) / (1000 / TILT_SIZE)\n\t\telse\n\t\t\t-- Resets the angles because player is moving too slow\n\t\t\t\n\t\t\tAngle1 = 0\n\t\t\tAngle2 = 0\n\t\tend\n\t\t\n\t\tlocal TiltGoal = {C0 = ORIGINAL_C0 * CFrame.Angles(Angle1, -Angle2, 0)}\n\t\tlocal TiltTween = TweenService:Create(RootJoint, TweenInfo.new(0.2), TiltGoal)\n\t\t\n\t\tTiltTween:Play()\n\tend\nend\n\nRunService.Heartbeat:Connect(Heartbeat)","features":"This is a test of a LLM (AI) to see its scripting potential, use with caution.\n\nThis doesn't work with r6, I'll fix it later.\n(no the LLM is not public all I can say is its a fork of deepseek)","tags":[],"discord":"","keyLink":"","owner":{"_id":"68178200b9b00726ec08161e","username":"d0ntt0uchm7p1zz4","verified":false,"profilePicture":{"url":"https://media.kocakz.me/90a1f7bf88747cbf97e3ac0fe0f504afefbcfbaf06ec5d69dc3a705b5aee2ca7.webp","original":"https://scriptblox.com/images/photo/68178200b9b00726ec08161e-1746372145682.jpeg"},"status":"offline","id":"68178200b9b00726ec08161e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/90a1f7bf88747cbf97e3ac0fe0f504afefbcfbaf06ec5d69dc3a705b5aee2ca7.webp","original":"https://scriptblox.com/images/photo/68178200b9b00726ec08161e-1746372145682.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T0