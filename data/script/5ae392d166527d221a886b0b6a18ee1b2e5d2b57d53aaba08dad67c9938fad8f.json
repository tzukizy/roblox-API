k\n        print(\"Item \" .. itemID .. \" adicionado à sua mochila (apenas você vê).\")\n    else\n        warn(\"Não foi possível carregar o item. O ID pode estar errado ou o item é privado.\")\n    end\nend\n\ndarItemLocal()\n","features":"Top pode compra item","tags":[],"discord":"","keyLink":"","owner":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69cdcc582a07b523ef917dae","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:29:30.637Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d7a68a81f36cc4f3325040","editBy":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","status":"offline","id":"69cdcc582a07b523ef917dae"},"message":"Create script","createdAt":"2026-04-09T13:15:54.535Z"}],"comments":[]}