{"slug":"Universal-Script-Id-plys-195431","_id":"69d7a68a81f36cc4f332503b","title":"Id plys","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Top pode compra item","tags":[],"script":"-- SCRIPT PARA DELTA (VISUAL APENAS)\nlocal itemID = \"ID_DO_ITEM_AQUI\" -- Substitua pelo ID que você quer\n\nlocal player = game.Players.LocalPlayer\nlocal backpack = player:FindFirstChild(\"Backpack\")\nlocal character = player.Character or player.CharacterAdded:Wait()\n\nlocal function darItemLocal()\n    -- Tenta carregar o objeto pelo ID\n    local sucesso, objeto = pcall(function()\n        return game:GetObjects(\"rbxassetid://\" .. itemID)[1]\n    end)\n\n    if sucesso and objeto then\n        -- Coloca o item na sua mochila\n        objeto.Parent = backpack\n        print(\"Item \" .. itemID .. \" adicionado à sua mochila (apenas você vê).\")\n    else\n        warn(\"Não foi possível carregar o item. O ID pode estar errado ou o item é privado.\")\n    end\nend\n\ndarItemLocal()\n","owner":{"_id":"69cdcc582a07b523ef917dae","username":"Cleitinhodograu","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"69cdcc582a07b523ef917dae","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":244,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/69ba9c3416ac580bcdaa057001d8bd026599303045e8aed560d97cb6ce990fb2.webp","original":"https://scriptblox.com/images/sb/0-1775740554510.jpg","scriptblox":"https://scriptblox.com/images/script/0-1775740554510.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-04-09T13:15:54.529Z","exec