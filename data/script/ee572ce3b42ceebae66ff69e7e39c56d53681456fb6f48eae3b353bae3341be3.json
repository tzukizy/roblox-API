{"slug":"Closest-Build-Wins!-Script-14600","_id":"66799de84634d565bfe51968","title":"Script","game":{"_id":"67e5e1ffb360710ec3c78b6b","gameId":14202272781,"name":"Closest Build Wins!","imageUrl":"/images/sb/rbx-49f82d337f7af5b4fc31c25212348235-aa1d9bff3e61.png","placeId":14202272781},"features":"So you don't have to memorise the build.","tags":[],"script":"local fz = Instance.new(\"Folder\")\nfz.Name = \"Cloned\"\nfz.Parent = game.Workspace\n\ngame.Workspace.DescendantRemoving:Connect(function(v)\n    if v.Parent and v.Parent.Name == \"DemoBuild\" and v.Name:lower() == \"block\" then \n        local c = v:Clone() \n        c.Name = v.Name .. \"_Cloned\"\n        c.Parent = fz\n        c.Transparency = 0.6\n    end\nend)\n\ngame.Workspace.DescendantAdded:Connect(function(v)\n    if v.Parent and v.Parent.Name == \"DemoBuild\" and v.Name:lower() == \"block\" then \n        for _, m in pairs(fz:GetChildren()) do \n            if m.Name:match(\"_Cloned\") then \n                m:Destroy() \n            end\n        end\n    end\nend)","owner":{"_id":"657ac61c2160a262f41a04c7","username":"Averageguy","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"657ac61c2160a262f41a04c7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":9426,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-24T16:25:12.978Z","dislikeCount":1,"likeCount":4,"image":"https://tr.rbxcdn.com/5633e5c04588ae64ca464a6cff709084/500/280/Image/Jpeg","executes":241,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c51216","editBy":{"_id":"657ac61c2160a262f41a04c7","username":"Averageguy","status":"offline","id":"657ac61c2160a262f41a04c7"},"message":"Create script","createdAt":"2025-03-27T15:42:11.165Z"}],"comments":[{"_id":"6681a6a79a519d35e372e0a3","commentBy":{"_id":"6626f6200d15d5289b6b3a8d","username":"romane09so","