ocal lvl = player.Levels.Normal\n   local door = workspace.Doors.Normal:FindFirstChild(tonumber(lvl.Value))\n   \n   if door then\nlocal args = {\n    [1] = door.Answers.Answer.Value\n}\ngame:GetService(\"ReplicatedStorage\").Events.SubmitAnswer:FireServer(unpack(args))\n\nplayer.Character:MoveTo(door.PlayerSpawn.Position)\n       \n    end\n    \nend]]--","features":"I did not enter a GUI for this, so it is technically open source. I don't plan on making it a loadstring or anything, once executed it'll automatically answer everything (one tps you also) \n\nIt won't crash if you finish. If you rebirth it'll continue, putting wait timer too low will cause it to say \"wrong answer\" but it won't be the wrong answer","tags":["roblox","guess the emoji","auto"],"discord":"","keyLink":"","owner":{"_id":"62ac0f6ca8071c114b7f56bb","username":"ComplexSlayer","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62ac0f6ca8071c114b7f56bb","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:15:17.232Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b631","editBy":{"_id":"62ac0f6ca8071c114b7f56bb","username":"ComplexSlayer","status":"offline","id":"62ac0f6ca8071c114b7f56bb"},"message":"Create script","createdAt":"2022-06-17T05:29:49.110Z"},{"_id":"67e5e1e3b360710ec3c4e472","editBy":{"_id":"62ac0f6ca8071c114b7f56bb","username":"ComplexSlayer","status":"offline","id":"62ac0f6ca8071c114b7f56bb"},"message":"Update script","createdAt":"2025-03-27T11:15:43.129Z"}],"comments":[{"_id":"62ac46ea54b1e572539328e7","commentBy":{"_id":"61e96f2e6ae3ebbe673d44a0","username":"Haii","verified":