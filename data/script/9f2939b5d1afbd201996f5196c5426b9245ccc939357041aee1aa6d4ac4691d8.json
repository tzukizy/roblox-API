{"_id":"66812dd3ef498cfedcaf1c6f","title":"HITBOX ALL","game":{"_id":"67e5e1ffb360710ec3c77f1d","gameId":14713532223,"name":"Beat The Robloxian!","imageUrl":{"url":"https://media.kocakz.me/29633d9e2bfacaf199f08ad835e80719421d245daf620a4f1b0cda5e4f2fb0c7.webp","original":"https://tr.rbxcdn.com/180DAY-0230dde40f442c24cbe75cca537ed29b/150/150/Image/Png/noFilter"},"slug":"14713532223-beat-the-robloxian","path":"/game/14713532223-beat-the-robloxian","thumbnail":{"url":"https://media.kocakz.me/29633d9e2bfacaf199f08ad835e80719421d245daf620a4f1b0cda5e4f2fb0c7.webp","original":"https://tr.rbxcdn.com/180DAY-0230dde40f442c24cbe75cca537ed29b/150/150/Image/Png/noFilter"},"placeId":14713532223},"slug":"REBIRTHS-Beat-the-Robloxian!-Beta-HITBOX-ALL-15025","verified":false,"key":false,"keyless":false,"views":21735,"executes":465,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/62365770906f516167b114693fa45baa/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/62365770906f516167b114693fa45baa/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/62365770906f516167b114693fa45baa/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/62365770906f516167b114693fa45baa/500/280/Image/Jpeg"},"likeCount":4,"dislikeCount":2,"createdAt":"2024-06-30T10:05:07.223Z","updatedAt":"2024-06-30T10:05:07.223Z","lastBump":"2024-06-30T10:05:07.223Z","script":"-- PLEASE BEFORE USING THE SCRIPT\n-- IT MAKES THE ENEMIES FLOAT IN THE SKY, PLEASE LOOK UP!\n--TRY TO FARM FOR A GUN BEFORE EXECUTING THE SCRIPT SO YOU CAN SHOOT THEM UP\n\nlocal enemyNames = {\n    \"Robloxian\",\n    \"Angry Robloxian\",\n    \"Giant Robloxian\",\n    \"Tiny Robloxian\",\n    \"Orc\",\n    \"Goblin\"\n}\n\nlocal function resizeTorso(part, scale)\n    part.Size = part.Size * scale\n    part.CanCollide = false\n    part.CanQuery = false\n    part.CanTouch = false\n    part.Transparency = 0.5 -- put how transparent is the torso\nend\n\n-- if you want to stop the modification from running click L (on keyboard)\nlocal function resetTorso(part, originalSize, originalTransparency)\n    part.Size = originalSize\n    part.CanCollide = true\n    part.CanQuery = true\n    part.CanTouch = true\n    part.Transparency = originalTransparency\nend\n\nlocal originalProperties = {}\n\n-- loop to auto check for enemies\nlocal running = true\nwhile running do\n    for _, enemyName in ipairs(enemyNames) do\n        for _, instance in ipairs(workspace:GetChildren()) do\n            if instance:IsA(\"Model\") and instance.Name == enemyName then\n                local torso = instance:FindFirstChild(\"Torso\")\n                if torso and not originalProperties[torso] then\n                    -- restore original torso size\n                    originalProperties[torso] = { Size = torso.Size, Transparency = torso.Transparency }\n                    -- resize torso\n                    resizeTorso(torso, 15)\n                end\n            end\n        end\n    end\n    wait(0.1) -- it checks every 0.1 seconds ig\nend\n\n--key press detection\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.L then\n        running = false\n        -- revert torso to normal\n        for torso, properties in pairs(originalProperties) do\n            resetTorso(torso, properties.Size, properties.Transparency)\n        end\n    end\nend)\n","features":"PLEASE READ BELOW BEFORE USING SCRIPT:\n \nI AM A BEGINNER SCRIPTER SO IT WONT BE AS GOOD,\n\nTHE ENEMIES WILL FLOAT UP IN THE SKY PLEASE LOOK UP\n\nTRY TO FARM FOR A GUN BEFORE EXECUTING THE SCRIPT SO YOU CAN SHOOT THEM!","tags":[],"discord":"","keyLink":"","owner":{"_id":"666d1570c859d5f27bcabd74","username":"hallworld","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"666d1570c859d5f27bcabd74","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:08:48.532Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c675","editBy":{"_id":"666d1570c859d5f27bcabd74","username":"hallworld","status":"offline","id":"666d1570c859d5f27bcabd74"},"message":"Create script","createdAt":"2024-06-30T10:06:19.140Z"},{"_id":"67e5e1e5b360710ec3c5134e","editBy":{"_id":"666d1570c859d5f27bcabd74","username":"hallworld","status":"offline","id":"666d1570c859d5f27bcabd74"},"message":"Update script","createdAt":"2025-03-27T23:04:22.669Z"}],"comments":[{"_id":"66812ecd9a519d35e369fb11","commentBy":{"_id":"664482eeb051743d7d723057","username":"guma","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c8acc167c3a55412443b6d275adc760b01d37dbda71ebd83c187aacc8875ca1c.webp","original":"https://scriptblox.com/images/photo/664482eeb051743d7d723057-1716533751524.png"},"createdAt":"2024-05-15T09:39:58.815Z","lastActive":"2024-07-12T12:36:06.417Z","status":"offline","id":"664482eeb051743d7d723057","profile":{"url":"https://media.kocakz.me/c8acc167c3a55412443b6d275adc760b01d37dbda71ebd83c187aacc8875ca1c.webp","original":"https://scriptblox.com/images/photo/664482eeb051743d7d723057-1716533751524.png"}},"text":"nice for a beginner keep going","createdAt":"2024-06-30T10:09:17.303Z","edited":true,"dislikeCount":0,"likeCount":4,"liked":false,"disliked":false},{"_id":"66812faaeecaeb3e5de58183","commentBy":{"_id":"666d1570c859d5f27bcabd74","username":"hallworld","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-06-15T04:15:44.735Z","lastActive":"2024-07-15T10:48:08.253Z"