{"_id":"6985292112004551b6a146d0","title":"Backflip for","game":{"_id":"67e5e1ffb360710ec3c77d16","gameId":18687417158,"name":"[UPD 🤖] Forsaken","imageUrl":{"url":"https://media.kocakz.me/55c63f4536bf7d7bc64ae4790ce09991292df76f7f106aec1d34b24f3d67efa3.webp","original":"https://tr.rbxcdn.com/180DAY-9ac77b9e9552150c8e485ddf26dac48f/150/150/Image/Png/noFilter"},"slug":"18687417158-forsaken","path":"/game/18687417158-forsaken","thumbnail":{"url":"https://media.kocakz.me/55c63f4536bf7d7bc64ae4790ce09991292df76f7f106aec1d34b24f3d67efa3.webp","original":"https://tr.rbxcdn.com/180DAY-9ac77b9e9552150c8e485ddf26dac48f/150/150/Image/Png/noFilter"},"placeId":18687417158},"slug":"Forsaken-Backflip-for-103063","verified":false,"key":false,"keyless":false,"views":1316,"executes":98,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ddc224ee985fdda41ba3fe3ed15876d81abe19f4b850644c0eb2576a81242be4.webp","original":"https://scriptblox.com/images/sb/18687417158-1770334497564.jpg","scriptblox":"https://scriptblox.com/images/script/18687417158-1770334497564.jpg"},"thumbnail":{"url":"https://media.kocakz.me/ddc224ee985fdda41ba3fe3ed15876d81abe19f4b850644c0eb2576a81242be4.webp","original":"https://scriptblox.com/images/sb/18687417158-1770334497564.jpg","scriptblox":"https://scriptblox.com/images/script/18687417158-1770334497564.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-05T23:34:57.576Z","updatedAt":"2026-02-05T23:34:57.576Z","lastBump":"2026-02-05T23:34:57.576Z","script":"local player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal hum = char:WaitForChild(\"Humanoid\")\n\n-- Create the Button UI\nlocal sg = Instance.new(\"ScreenGui\", player.PlayerGui)\nsg.Name = \"BackflipGui\"\n\nlocal btn = Instance.new(\"TextButton\", sg)\nbtn.Size = UDim2.new(0, 70, 0, 70)\nbtn.Position = UDim2.new(0.8, 0, 0.5, 0) -- Right side of screen\nbtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)\nbtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nbtn.Text = \"FLIP\"\nbtn.Font = Enum.Font.SourceSansBold\nbtn.TextSize = 20\n\n-- Round the button corners\nlocal corner = Instance.new(\"UICorner\", btn)\ncorner.CornerRadius = UDim.new(0, 10)\n\nlocal flipping = false\n\nlocal function doBackflip()\n    if flipping or hum.FloorMaterial == Enum.Material.Air then return end\n    flipping = true\n    \n    -- Movement Force\n    local vel = Instance.new(\"BodyVelocity\")\n    vel.MaxForce = Vector3.new(100000, 100000, 100000)\n    vel.Velocity = (hrp.CFrame.LookVector * -20) + Vector3.new(0, 45, 0)\n    vel.Parent = hrp\n    \n    -- Rotation Force\n    local gyro = Instance.new(\"BodyGyro\")\n    gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)\n    gyro.D = 500\n    gyro.P = 3000\n    gyro.CFrame = hrp.CFrame\n    gyro.Parent = hrp\n\n    -- Animation loop (Spinning)\n    for i = 1, 10 do\n        gyro.CFrame = gyro.CFrame * CFrame.Angles(math.rad(-36), 0, 0)\n        task.wait(0.04)\n    end\n    \n    vel:Destroy()\n    gyro:Destroy()\n    flipping = false\nend\n\nbtn.MouseButton1Click:Connect(doBackflip)\nprint(\"SkibX: Backflip Button Loaded!\")\n","features":"Gives you backflip mod","tags":["forsaken","backflip"],"discord":"","keyLink":"","owner":{"_id":"69320cf35623b484ed716b0d","username":"C3BER","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69320cf35623b484ed716b0d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:15:32.843Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changel