{"slug":"Super-Soldiers-UPDATE-Head-Hitbox-Expander-122008","_id":"699f279596d3ccea10493d1c","title":"Head Hitbox Expander","game":{"_id":"693ef7e19be37dfffd869144","gameId":119441025136387,"name":"[NEW ISLAND] 💥Super Soldiers","imageUrl":"/images/sb/rbx-dfcf87b912c348778d184c970dc01c03-d1c28c101869.png","placeId":119441025136387},"features":"You can be free expand head size and it can increase damage. It has some bugs","tags":[],"script":"local NPCContainer = workspace[\"NPC Engine\"].NPCContainer\nlocal scale = 6\n\nlocal function enlargeHead(npc)\n    local head = npc:FindFirstChild(\"Head\")\n    if head and head:IsA(\"BasePart\") then\n        head.Size = head.Size * scale\n    end\nend\n\nfor _, npc in ipairs(NPCContainer:GetChildren()) do\n    enlargeHead(npc)\nend\n\nNPCContainer.ChildAdded:Connect(function(npc)\n    task.wait(0.1)\n    enlargeHead(npc)\nend)","owner":{"_id":"6970f8c4454cc32113d20962","username":"781391","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6970f8c4454cc32113d20962","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1019,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/119441025136387-1772038036991.webp","likeCount":1,"dislikeCount":2,"createdAt":"2026-02-25T16:47:17.020Z","executes":250,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"699f279596d3ccea10493d1f","editBy":{"_id":"6970f8c4454cc32113d20962","username":"781391","status":"offline","id":"6970f8c4454cc32113d20962"},"message":"Create script","createdAt":"2026-02-25T16:47:17.025Z"}],"comments":[{"_id":"699fed23465eb761d2bc2cc1","commentBy":{"_id":"6970f8c4454cc32113d20962","username":"781391","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-03-01T05:03:33.385Z","createdAt":"2026-01-21T16:03:16.066Z","status":"offline","id":"6970f8c4454cc32113d20962","topMilestone