{"_id":"69b634e167b3dcfd3691cb28","title":"Pokemon","game":{"_id":"69b634e167b3dcfd3691cb25","gameId":114934003339625,"name":"[MEGA NINJA] Steal a Pok [🌌]","imageUrl":{"url":"https://media.kocakz.me/7f523784b9a840a78c3f9f95b1980e91ed347116364db2456fbf73c446bb18f2.webp","original":"https://scriptblox.com/images/sb/rbx-410b64070b20426866d7f260738daa20-7eb02afe98a9.png"},"slug":"114934003339625-steal-a-pok","path":"/game/114934003339625-steal-a-pok","thumbnail":{"url":"https://media.kocakz.me/7f523784b9a840a78c3f9f95b1980e91ed347116364db2456fbf73c446bb18f2.webp","original":"https://scriptblox.com/images/sb/rbx-410b64070b20426866d7f260738daa20-7eb02afe98a9.png"},"placeId":114934003339625},"slug":"FUSIONS-Steal-a-Pok-emon-140885","verified":false,"key":false,"keyless":false,"views":837,"executes":148,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/eb4dea9e8ed94b2701cfa14279f440f9e62a86cecc7ae8ee3f0a33bae1439f8b.webp","original":"https://scriptblox.com/images/sb/rbx-46adfa09ad1786df34c5110c2b62ad1f-7c71080a4629.png","scriptblox":"https://scriptblox.com/images/script/rbx-46adfa09ad1786df34c5110c2b62ad1f-7c71080a4629.png"},"thumbnail":{"url":"https://media.kocakz.me/eb4dea9e8ed94b2701cfa14279f440f9e62a86cecc7ae8ee3f0a33bae1439f8b.webp","original":"https://scriptblox.com/images/sb/rbx-46adfa09ad1786df34c5110c2b62ad1f-7c71080a4629.png","scriptblox":"https://scriptblox.com/images/script/rbx-46adfa09ad1786df34c5110c2b62ad1f-7c71080a4629.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2026-03-15T04:26:09.505Z","updatedAt":"2026-03-15T04:26:09.505Z","lastBump":"2026-03-15T04:26:09.505Z","script":"local method = \"door\" -- \"door\", \"wall\", or \"both\"\n\nlocal lp = game:GetService(\"Players\").LocalPlayer\nlocal pbases = {}\n\ntask.spawn(function()\n    while task.wait(2.5) do\n        table.clear(pbases)\n\n        for _, base in ipairs(workspace.Bases:GetChildren()) do\n            local owner = base.Configuration.Player.Value\n            if owner == lp.Name then continue end\n\n            table.insert(pbases, {instance = base, owner = owner})\n\n            if method == \"door\" or method == \"both\" then\n                for _, floor in ipairs(base.Floors:GetDescendants()) do\n                    if floor:IsA(\"BasePart\") and not floor:IsA(\"TrussPart\") then\n                        floor.CanCollide = false\n                    end\n                end\n            end\n\n            if method == \"wall\" or method == \"both\" then\n                for _, wall in ipairs(base.Building:GetChildren()) do\n                    if wall:IsA(\"BasePart\") then\n                        wall.CanCollide = false\n                    end\n                end\n            end\n        end\n    end\nend)","features":"just noclip","tags":["noclip"],"discord":"","keyLink":"","owner":{"_id":"666dba6eb68e80a6c3ce56f9","username":"voltex","verified":false,"profilePicture":{"url":"https://media.kocakz.me/84b3163674195bd735cfd18f907d2b121e56af5b97c52a263ab23134e95dcf58.webp","original":"https://scriptblox.com/images/photo/666dba6eb68e80a6c3ce56f9-1748831327131.png"},"lvl":22,"status":"offline","id":"666dba6eb68e80a6c3ce56f9","leaderboard":{"tag":{"kind":"week","rank":11,"period":"week","metric":"likes","value":9}},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/84b3163674195bd735cfd18f907d2b121e56af5b97c52a263ab23134e95dcf58.webp","original":"https://scriptblox.com/images/photo/666dba6eb68e80a6c3ce56f9-1748831327131.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:38:23.662Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b634e167b3dcfd3691cb2b","editBy":{"_id":"666dba6eb68e80a6c3ce56f9","username":"voltex","status