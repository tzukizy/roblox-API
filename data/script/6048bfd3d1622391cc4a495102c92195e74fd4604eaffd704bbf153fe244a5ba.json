{"slug":"Life-in-Paradise-Disconnect-Everyone-69496","_id":"6923b71a4e30952fb6ef512f","title":"Disconnect Everyone (PATCHED, SORRY GUYS!)","game":{"_id":"67e5e1ffb360710ec3c77e51","gameId":1662219031,"name":"Life in Paradise","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":1662219031},"features":"Spawns an ungodly amount of turkeys so fast so it disconnects.\n(After the first run, reset then run the script again)","tags":[],"script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal WearItem = ReplicatedStorage:WaitForChild(\"WearItem\")\nlocal TurkeyMorph = game:GetService(\"Workspace\").Events.Morph.Player\n\nlocal TurkeysPerSec = 500 -- Amount of turkeys to spawn a second\nlocal Count = 1000 -- Total amount of turkeys to spawn\n\nlocal function wearFace()\n    local args = {\n        \"Wear\",\n        \"10907551\", \n        \"Faces\"\n    }\n\n    WearItem:FireServer(args)\nend\n\nlocal function resetChar()\n    local char = Players.LocalPlayer.Character\n    if char and char:FindFirstChild(\"Humanoid\") then\n        char.Humanoid.Health = 0\n    end\nend\n\nlocal function spawnTurkeys(Count)\n    Count = math.floor(Count)\n    if Count < 1 then Count = 1 end\n\n    local rate = TurkeysPerSec\n    if rate <= 0 then rate = 1 end\n\n    if rate >= 50 then\n        for i = 1, Count do\n            TurkeyMorph:FireServer(\"Turkey\")\n        end\n    else\n        local delay = 1 / rate\n        for i = 1, Count do\n            TurkeyMorph:FireServer(\"Turkey\")\n            if i < Count then task.wait(delay) end\n        end\n    end\n\n    resetChar()\nend\n\nlocal function lagServer()\n    wearFace()\n    task.wait(0.05)\n    spawnTurkeys(Count)\nend\n\nlagServer()","owner":{"_id":"667885683e72cafa968eda7a","username":"tungtunghookcc","verified":false,"profilePicture":{"url":"https:/