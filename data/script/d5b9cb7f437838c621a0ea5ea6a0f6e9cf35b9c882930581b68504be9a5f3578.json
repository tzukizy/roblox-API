{"_id":"687b46d7656479560166b6cc","title":"Auto wallhop","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/5cda12b1afc0c9868ef3397904d84dcbcd666525454acacb67d6c508dced9fea.webp","original":"https://scriptblox.com/images/sb/0-1752909527437.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/5cda12b1afc0c9868ef3397904d84dcbcd666525454acacb67d6c508dced9fea.webp","original":"https://scriptblox.com/images/sb/0-1752909527437.png"},"placeId":0},"slug":"Universal-Script-Auto-wallhop-45461","verified":false,"key":false,"keyless":false,"views":91473,"executes":1625,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/3ac89757015796fc46949ef1a4b19cd816aedf7033515c7ee5450e4df61f2f38.webp","original":"https://scriptblox.com/images/sb/0-1752909527437.png","scriptblox":"https://scriptblox.com/images/script/0-1752909527437.png"},"thumbnail":{"url":"https://media.kocakz.me/3ac89757015796fc46949ef1a4b19cd816aedf7033515c7ee5450e4df61f2f38.webp","original":"https://scriptblox.com/images/sb/0-1752909527437.png","scriptblox":"https://scriptblox.com/images/script/0-1752909527437.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-07-19T07:18:47.587Z","updatedAt":"2025-07-19T07:18:47.587Z","lastBump":"2025-07-19T07:18:47.587Z","script":"-- LocalScript in StarterPlayerScripts\n\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal player = Players.LocalPlayer\nlocal cam = Workspace.CurrentCamera\n\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\n-- SETTINGS\nlocal wallCheckDistance = 2\nlocal jumpCooldown = 0.3\nlocal flickAngle = 20 -- degrees left/right\nlocal flickTime = 0.15 -- duration per flick phase\n\n-- STATE\nlocal lastJumpTime = 0\nlocal flicking = false\nlocal autoWallHop = true\n\n-- Raycast config\nlocal rayParams = RaycastParams.new()\nrayParams.FilterType = Enum.RaycastFilterType.Blacklist\nrayParams.FilterDescendantsInstances = {character}\n\n-- 🔍 Wall Detection\nlocal function isTouchingWall()\n\tlocal origin = hrp.Position\n\tlocal directions = {\n\t\thrp.CFrame.LookVector,\n\t\t-hrp.CFrame.LookVector,\n\t\thrp.CFrame.RightVector,\n\t\t-hrp.CFrame.RightVector\n\t}\n\tfor _, dir in pairs(directions) do\n\t\tlocal result = Workspace:Raycast(origin, dir * wallCheckDistance, rayParams)\n\t\tif result and result.Instance and result.Instance.CanCollide then\n\t\t\treturn true\n\t\tend\n\tend\n\treturn false\nend\n\n-- 🔄 Character Flick (HRP Rotation)\nlocal function rotateCharacter(offsetYaw)\n\tlocal currentPos = hrp.Position\n\tlocal currentRot = hrp.Orientation\n\tlocal newYaw = currentRot.Y + offsetYaw\n\tlocal newCFrame = CFrame.new(currentPos) * CFrame.Angles(0, math.rad(newYaw), 0)\n\n\tlocal tween = TweenService:Create(hrp, TweenInfo.new(flickTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {\n\t\tCFrame = newCFrame\n\t})\n\ttween:Play()\n\ttween.Completed:Wait()\nend\n\n-- 🤸 Full Flick Sequence\nlocal function flickCharacter()\n\tif flicking then return end\n\tflicking = true\n\n\t-- Flick left\n\trotateCharacter(-flickAngle)\n\t-- Flick right\n\trotateCharacter(flickAngle * 2)\n\t-- Return to center\n\trotateCharacter(-flickAngle)\n\n\tflicking = false\nend\n\n-- 🎮 Main Loop\nRunService.RenderStepped:Connect(function()\n\tif not autoWallHop then return end\n\tif tick() - lastJumpTime < jumpCooldown then return end\n\n\tif humanoid:GetState() == Enum.HumanoidStateType.Freefall and isTouchingWall() then\n\t\tlastJumpTime = tick()\n\t\tflickCharacter()\n\t\thumanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n\tend\nend)\n","features":"Jump into a wall and it auto wallhops you (it looks better out of shitft lock) other people can see the flick can also be used to just climb walls","tags":[],"discord":"","keyLink":"","owner":{"_id":"684b5ae3343da7b997d3bbda","username":"2beFairIcantSCRIPT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"684b5ae3343da7b997d3bbda","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:58:14.134Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"687b46d7656479560166b6cf","editBy":{"_id":"684b5ae3343da7b997d3bbda","username":"2beFairIcantSCRIPT","status":"offline","id":"684b5ae3343da7b997d3bbda"},"message":"Wallhops","createdAt":"2025-07-19T07:18:47.598Z"}],"comments":[{"_id":"687b4d91a79406e12418414b","commentBy":{"_id":"683d703c6d2cd244aac6d4d8","username":"gabrielmcglothlin15","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-06-02T09:34:52.539Z","lastActive":"2025-07-23T13:56:15.884Z","status":"offline","id":"683d703c6d2cd244aac6d4d8","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Ts sucks *","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-19T07:47:29.827Z","liked":false,"disliked":false},{"_id":"687b50625020c89e81b337c0","commentBy":{"_id":"66d4406b896c7d09ace6e085","username":"pidoras1488","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-09-01T10:22:35.573Z","lastActive":"2026-02-05T21:07:19.408Z","status":"offline","id":"66d4406b896c7d09ace6e085","topMilestone":