rt to scrap, slightly above to avoid getting stuck\n            hrp.CFrame = material.CFrame + Vector3.new(0, 3, 0)\n\n            wait(0.2) -- allow time for physics\n            fireproximityprompt(prompt)\n            wait(0.2) \n        end\n    end\nend\n\n-- Return to original position\nhrp.CFrame = originalCFrame","features":"just execute script ingame not in lobby also you can move gives you 200 scraps you gonna wait some min or sec changeable\ncant put the game in game id free and keyless \ngame: https://www.roblox.com/games/17474746614/7-Days-To-Live","tags":["roblox released chatgpt","free","keyless"],"discord":"","keyLink":"","owner":{"_id":"67a3a097d45ade5ab4edecd3","username":"sonasony804","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67a3a097d45ade5ab4edecd3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:01:59.269Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6807310a3ddfe7f175141285","editBy":{"_id":"67a3a097d45ade5ab4edecd3","username":"sonasony804","status":"offline","id":"67a3a097d45ade5ab4edecd3"},"message":"Create script","createdAt":"2025-04-22T06:02:50.612Z"}],"comments":[{"_id":"681495786d078cab6bc60948","commentBy":{"_id":"6790ee419c7bd8961a51df9d","username":"jruwuscm","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-01-22T13:10:25.663Z","lastActive":"2025-11-10T11:34:01.380Z","status":"offline","id":"6790ee419c7bd8961a51df9d","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Can you make this in delta version?","edited":false,"li