{"slug":"UPD-Neo-Tennis-Auto-parry-ball-and-Auto-Serve-71722","_id":"692d863c05af925d41881660","title":"Auto parry ball and Auto Serve","game":{"_id":"68d64c8faee5ee63fc3da920","gameId":85056532479796,"name":"[UPD] Neo Tennis","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":85056532479796},"features":"• Automatically Parry the ball.\n• Auto Serve the ball\n• May Edit and do what whatever you want","tags":["neotennis"],"script":"if not game:IsLoaded() then\n\tgame.Loaded:Wait()\nend\n\nwhile true do\n    local hitBallArgs = {\n        {\n            CamPos = Vector3.new(0, 0, 0),\n            HitPos = Vector3.new(0, 0, 0),\n            HitBallType = 0,\n            ClientTick = 0,\n            CamDir = Vector3.new(0, 0, 0),\n            AttackMoveSpeed = Vector3.new(0, 0, 0)\n        }\n    }\n\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"HitBallRF\"):InvokeServer(unpack(hitBallArgs))\ntask.wait()\nend\n\nif not game:IsLoaded() then\n\tgame.Loaded:Wait()\nend\n\nwhile true do\n    local args = {\n\t{\n\t\tRotateType = 0, --0, 1, 2 ,3\n\t\tPower = 100 --Speed Of The Ball (Max 100)\n\t}\n}\n\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"ServeRF\"):InvokeServer(unpack(args))\ntask.wait()\nend","owner":{"_id":"6649aca304e17bb63806e0ea","username":"1kzuya","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3a029cab0f1e2222fa27e59c12940272bcc562923d625a63bb56def83a89e28d.webp","original":"https://scriptblox.com/images/photo/6649aca304e17bb63806e0ea-1771732170530.jpg"},"status":"offline","id":"6649aca304e17bb63806e0ea","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/3a029cab0f1e2222fa27e59c12940272bcc562923d625a63bb56def83a89e28d.webp","original":"https://scriptblox.com/images/photo/6649aca304e17bb63806e