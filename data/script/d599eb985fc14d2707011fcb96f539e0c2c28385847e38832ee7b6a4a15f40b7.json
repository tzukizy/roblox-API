{"_id":"6a2b5477ce3341947d805cdd","title":"mesh disco f3x","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/ad24c65bdd70dda2d49eee32c46b71e0bf3ac1fae131fbc15e23d5df782c5e17.webp","original":"https://scriptblox.com/images/sb/0-1781224567792.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/ad24c65bdd70dda2d49eee32c46b71e0bf3ac1fae131fbc15e23d5df782c5e17.webp","original":"https://scriptblox.com/images/sb/0-1781224567792.jpg"},"placeId":0},"slug":"Universal-Script-mesh-disco-f3x-235558","verified":false,"key":false,"keyless":false,"views":1822,"executes":4566,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/45e43afe255a3df4f5f373758403361f5255236f7cea07f6023209135564afc4.webp","original":"https://scriptblox.com/images/sb/0-1781224567792.jpg","scriptblox":"https://scriptblox.com/images/script/0-1781224567792.jpg"},"thumbnail":{"url":"https://media.kocakz.me/45e43afe255a3df4f5f373758403361f5255236f7cea07f6023209135564afc4.webp","original":"https://scriptblox.com/images/sb/0-1781224567792.jpg","scriptblox":"https://scriptblox.com/images/script/0-1781224567792.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-12T00:36:07.806Z","updatedAt":"2026-06-12T00:36:07.806Z","lastBump":"2026-06-12T00:36:07.806Z","script":"--[[\n\nmesh disco f3x\n\nmade by fro0kidd\n\nnot remove credits pls\n\n--]]\n\nlocal player = game.Players.LocalPlayer\nlocal char = player.Character\n\nlocal tool\nfor _, v in ipairs(player:GetDescendants()) do\n\tif v.Name == \"SyncAPI\" then\n\t\ttool = v.Parent\n\t\tbreak\n\tend\nend\nif not tool then\n\tfor _, v in ipairs(game.ReplicatedStorage:GetDescendants()) do\n\t\tif v.Name == \"SyncAPI\" then\n\t\t\ttool= v.Parent\n\t\t\tbreak\n\t\tend\n\tend\nend\nif not tool then\n\twarn(\"yo ur not have f3x\")\n\treturn\nend\n\nremote = tool.SyncAPI.ServerEndpoint\n\nfunction _(args)\n\tspawn(function()\n\t\tlocal success, result\n\t\tif remote:IsA(\"RemoteFunction\") then\n\t\t\tsuccess, result = pcall(function()\n\t\t\t\treturn remote:InvokeServer(unpack(args))\n\t\t\tend)\n\t\telse\n\t\t\tremote:FireServer(unpack(args))\n\t\t\tsuccess = true\n\t\tend\n\tend)\nend\n\nfunction DestroyPart(part)\n\tlocal args = {\n\t\t[1] = \"Remove\",\n\t\t[2] = {\n\t\t\t[1] = part\n\t\t}\n\t}\n\t_(args)\nend\n\nfunction AddMesh(part)\n\tlocal args = {\n\t\t[1] = \"CreateMeshes\",\n\t\t[2] = {\n\t\t\t[1] = {\n\t\t\t\t[\"Part\"] = part\n\t\t\t}\n\t\t}\n\t}\n\t_(args)\nend\n\nfunction SetMeshType(part, meshType)\n\tlocal args = {\n\t\t[1] = \"SyncMesh\",\n\t\t[2] = {\n\t\t\t[1] = {\n\t\t\t\t[\"Part\"] = part,\n\t\t\t\t[\"MeshType\"] = meshType\n\t\t\t}\n\t\t}\n\t}\n\t_(args)\nend\n\nfunction SetColor(part, color)\n\tlocal args = {\n\t\t[1] = \"SyncColor\",\n\t\t[2] = {\n\t\t\t[1] = {\n\t\t\t\t[\"Part\"] = part,\n\t\t\t\t[\"Color\"] = color,\n\t\t\t\t[\"UnionColoring\"] = false\n\t\t\t}\n\t\t}\n\t}\n\t_(args)\nend\n\ncharacterParts = {}\n\nfor _, v in ipairs(player.Character:GetDescendants()) do\n\tif v:IsA(\"BasePart\")\n\t\tand v.Name ~= \"HumanoidRootPart\"\n\t\tand not v:FindFirstAncestorOfClass(\"Accessory\") then\n\n\t\ttable.insert(characterParts, v)\n\n\t\tfor _, child in ipairs(v:GetDescendants()) do\n\t\t\tif child:IsA(\"SpecialMesh\") or child:IsA(\"BlockMesh\") or child:IsA(\"CylinderMesh\") then\n\t\t\t\tDestroyPart(child)\n\t\t\tend\n\t\tend\n\n\t\tAddMesh(v)\n\tend\nend\n_G.MeshLoopID = (_G.MeshLoopID or 0) + 1\nlocal myLoop = _G.MeshLoopID\nwhile myLoop == _G.MeshLoopID do\n\tfor _, part in ipairs(characterParts) do\n\t\tlocal n = math.random(1, 6)\n\t\tlocal randomMesh\n\n\t\tif n == 1 then\n\t\t\trandomMesh = Enum.MeshType.Brick\n\t\telseif n == 2 then\n\t\t\trandomMesh = Enum.MeshType.Cylinder\n\t\telseif n == 3 then\n\t\t\trandomMesh = Enum.MeshType.Head\n\t\telseif n == 4 then\n\t\t\trandomMesh = Enum.MeshType.Sphere\n\t\telseif n == 5 then\n\t\t\trandomMesh = Enum.MeshType.Wedge\n\t\telse\n\t\t\trandomMesh = Enum.MeshType.Torso\n\t\tend\n\n\t\tSetMeshType(part, randomMesh)\n\t\tSetColor(part, Color3.new(math.random(), math.random(), math.random()))\n\tend\n\n\twait(0.1)\nend","features":"credit to fro0kidd\n(the original was deleted ☹️)","tags":["fx"],"discord":"","keyLink":"","owner":{"_id":"69de067f407a1e557b1f35b2","username":"Fro0kiddAlt_brazil","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9f40c9c461ad08d191b3e7e46589471b1de981a3dd450cf5822b7d3bf79471de.webp","original":"https://scriptblox.com/images/photo/69de067f407a1e557b1f35b2-1776158524659.png"},"lvl":7,"status":"offline","id":"69de067f407a1e557b1f35b2","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/9f40c9c461ad08d191b3e7e46589471b1de981a3dd450cf5822b7d3bf79471de.webp","original":"https://scriptblox.com/images/photo/69de067f407a1e557b1f35b2-1776158524659.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:54:45.167Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a2b5477ce3341947d805cdf","editBy":{"_id":"69de067f407a1e557b1f35b2","username":"Fro0kiddAlt_brazil","status":"offline","id":"69de067f407a1e557b1f35b2"},"message":"Create script","createdAt":"2026-06-12T00:36:07.809Z"},{"_id":"6a31f7626a945ec228a128b6","editBy":{"_id":"69de067f407a1e557b1f35b2","username":"Fro0kiddAlt_brazil","status":"offline","id":"69de067f407a1e557b1f35b2"},"message":"Update script","createdAt":"2026-06-17T01:24:50.198Z"},{"_id":"6a367e241950b89f7036c3f6","editBy":{"_id":"69de067f407a1e557b1f35b2","username":"Fro0kiddAlt_brazil","status":"offline","id":"69de067f407a1e557b1f35b2"},"message":"Update script","createdAt":"2026-06-20T11:48:52.851Z"},{"_id":"6a4fdc02a2cddf12b9ba611b","