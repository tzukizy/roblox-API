{"slug":"cross-a-street-simulator-NEW-UPDATE!-Cross-the-road-V1-53022","_id":"68c5b010f8e23b190232d716","title":"Cross the street simulator V1","game":{"_id":"683d65e5343da7b9975714e5","gameId":126201113771941,"name":"cross a street simulator [NEW UPDATE!🛒🔥]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":126201113771941},"features":"-Autofarm death\n-Tp to 7eleven","tags":[],"script":"--// Variável de controle\ngetgenv().AutoSuicide = false\n\n--// Posições (mude para os valores corretos do teu jogo)\nlocal streetPosition = Vector3.new(0, 5, 0) -- meio da rua\nlocal storeInsidePosition = Vector3.new(25, 5, -10) -- dentro da loja\n\n--// Função de teleporte\nlocal function teleportTo(pos)\n    local player = game.Players.LocalPlayer\n    if player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n        player.Character:MoveTo(pos)\n    end\nend\n\n--// Loop automático para suicídio\ntask.spawn(function()\n    while task.wait(1) do\n        if getgenv().AutoSuicide then\n            teleportTo(streetPosition)\n        end\n    end\nend)\n\n--// UI\nlocal Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/TwiRwal/TwiWare/main/uilib.lua\"))()\nlocal Window = Library.CreateLib(\"Teleport Menu\", \"Midnight\")\n\nlocal Tab = Window:NewTab(\"Main\")\nlocal Section = Tab:NewSection(\"Control\")\n\n-- Toggle Auto Suicide\nSection:NewToggle(\"Auto Suicide\", \"Teleporta repetidamente para a rua\", function(state)\n    getgenv().AutoSuicide = state\nend)\n\n-- Botão Tp Store (dentro da loja)\nSection:NewButton(\"Tp Store\", \"Teleporta para dentro da loja\", function()\n    teleportTo(storeInsidePosition)\nend)","owner":{"_id":"68bc147133b770c811307b1f","username":"BENJ1","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/09ff4d7ad16d03d607a4119ac38ce2b0bca5575df64bbb09c07226f5ac7dbccb.webp",