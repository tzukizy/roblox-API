function teleportTo(pos)\n    local player = game.Players.LocalPlayer\n    if player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n        player.Character:MoveTo(pos)\n    end\nend\n\n--// Loop automático para suicídio\ntask.spawn(function()\n    while task.wait(1) do\n        if getgenv().AutoSuicide then\n            teleportTo(streetPosition)\n        end\n    end\nend)\n\n--// UI\nlocal Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/TwiRwal/TwiWare/main/uilib.lua\"))()\nlocal Window = Library.CreateLib(\"Teleport Menu\", \"Midnight\")\n\nlocal Tab = Window:NewTab(\"Main\")\nlocal Section = Tab:NewSection(\"Control\")\n\n-- Toggle Auto Suicide\nSection:NewToggle(\"Auto Suicide\", \"Teleporta repetidamente para a rua\", function(state)\n    getgenv().AutoSuicide = state\nend)\n\n-- Botão Tp Store (dentro da loja)\nSection:NewButton(\"Tp Store\", \"Teleporta para dentro da loja\", function()\n    teleportTo(storeInsidePosition)\nend)","features":"-Autofarm death\n-Tp to 7eleven","tags":[],"discord":"","keyLink":"","owner":{"_id":"68bc147133b770c811307b1f","username":"BENJ1","verified":false,"profilePicture":{"url":"https://media.kocakz.me/09ff4d7ad16d03d607a4119ac38ce2b0bca5575df64bbb09c07226f5ac7dbccb.webp","original":"https://scriptblox.com/images/photo/68bc147133b770c811307b1f-1757156561323.jpeg"},"status":"offline","id":"68bc147133b770c811307b1f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/09ff4d7ad16d03d607a4119ac38ce2b0bca5575df64bbb09c07226f5ac7dbccb.webp","original":"https://scriptblox.com/images/photo/68bc147133b770c811307b1f-1757156561323.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:59:07.691Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c5b010f8e23b