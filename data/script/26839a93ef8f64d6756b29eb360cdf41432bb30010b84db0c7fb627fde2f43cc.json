{"_id":"6a0e2b89e3319f81ef6b851b","title":"No Recoil","game":{"_id":"67e5e1ffb360710ec3c77e90","gameId":13559584718,"name":"[BETA] Lone Survival","imageUrl":{"url":"https://media.kocakz.me/c1647c3eb5a6d315e4cdc3d80054dfb2c0c3c1e64b982d66d6adf06104a5c0a1.webp","original":"https://tr.rbxcdn.com/180DAY-5f81844e804eca128407bcbfa7bad035/150/150/Image/Png/noFilter"},"slug":"13559584718-lone-survival","path":"/game/13559584718-lone-survival","thumbnail":{"url":"https://media.kocakz.me/c1647c3eb5a6d315e4cdc3d80054dfb2c0c3c1e64b982d66d6adf06104a5c0a1.webp","original":"https://tr.rbxcdn.com/180DAY-5f81844e804eca128407bcbfa7bad035/150/150/Image/Png/noFilter"},"placeId":13559584718},"slug":"BETA-Lone-Survival-No-Recoil-219503","verified":false,"key":false,"keyless":false,"views":2658,"executes":858,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/3591ced40d3f843e59b43766583bfa4d3287de871d3c00919303f5c2b9d79eef.webp","original":"https://scriptblox.com/images/sb/rbx-0d8eabfb49fad9cec277f9a190b40f54-85fd3e2675f8.png","scriptblox":"https://scriptblox.com/images/script/rbx-0d8eabfb49fad9cec277f9a190b40f54-85fd3e2675f8.png"},"thumbnail":{"url":"https://media.kocakz.me/3591ced40d3f843e59b43766583bfa4d3287de871d3c00919303f5c2b9d79eef.webp","original":"https://scriptblox.com/images/sb/rbx-0d8eabfb49fad9cec277f9a190b40f54-85fd3e2675f8.png","scriptblox":"https://scriptblox.com/images/script/rbx-0d8eabfb49fad9cec277f9a190b40f54-85fd3e2675f8.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-05-20T21:45:45.603Z","updatedAt":"2026-05-20T21:45:45.603Z","lastBump":"2026-05-20T21:45:45.603Z","script":"-- Locals for the scan\nlocal RecoilFunction = nil\n\n-- 1. Scan memory (GC) to find the internal Recoil \"Add\" function\nfor i, v in pairs(getgc(true)) do\n    if type(v) == \"function\" and debug.getinfo(v)[\"name\"] == \"Add\" then\n        local src = debug.getinfo(v)[\"short_src\"]\n        if src:find(\"Recoil\") then\n            RecoilFunction = v\n            break\n        end\n    end\nend\n\n-- 2. Apply the Hook\nif RecoilFunction then\n    local RecoilHook\n    RecoilHook = hookfunction(RecoilFunction, function(...)\n        local args = {...}\n        \n        -- args[1] is typically Vertical Recoil\n        -- args[4] is typically Horizontal/Side Recoil\n        args[1] = 0\n        args[4] = 0\n        \n        return RecoilHook(table.unpack(args))\n    end)\n    print(\"Successfully hooked RecoilFunction\")\nelse\n    warn(\"Failed to find RecoilFunction. The module might not be loaded yet—try holding a gun first.\")\nend","features":"no recoil","tags":[],"discord":"","keyLink":"","owner":{"_id":"6744bafd1ac8b6ad26e67d23","username":"0_kingcat_0","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a9dbb4fb97a085e44db15ed24bc0e56ede7fbeab3cf32f473aa9d769b819cf9b.webp","original":"https://scriptblox.com/images/photo/6744bafd1ac8b6ad26e67d23-1775149669038.png"},"status":"offline","id":"6744bafd1ac8b6ad26e67d23","profile":{"url":"https://media.kocakz.me/a9dbb4fb97a085e44db15ed24bc0e56ede7fbeab3cf32f473aa9d769b819cf9b.webp","original":"https://scriptblox.com/images/photo/6744bafd1ac8b6ad26e67d23-1775149669038.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:37:46.901Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a0e2b89e3319f81ef6b851d","editBy":{"_id":"6744bafd1ac8b6ad26e67d23","username":"0_kingcat_0","status":"offline","id":"6744bafd1ac8b6ad26e67d23"},"message":"Create script","createdAt":"2026-05-20T21:45:45.607Z"}],"comments":[{"_id":"6a2150722de242ef0678b6ba","commentBy":{"_id":"6a214fd310773cea7ba973f3","username":"LonebOY","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b7900605bbc45861a7d6611f4c3d1