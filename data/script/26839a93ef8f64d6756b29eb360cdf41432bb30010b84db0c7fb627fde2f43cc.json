{"slug":"BETA-Lone-Survival-No-Recoil-219503","_id":"6a0e2b89e3319f81ef6b851b","title":"No Recoil","game":{"_id":"67e5e1ffb360710ec3c77e90","gameId":13559584718,"name":"[BETA] Lone Survival","imageUrl":"/images/sb/rbx-62f1d4b6e79cee0c86cda02fc1150c80-9415f935510d.png","placeId":13559584718},"features":"no recoil","tags":[],"script":"-- Locals for the scan\nlocal RecoilFunction = nil\n\n-- 1. Scan memory (GC) to find the internal Recoil \"Add\" function\nfor i, v in pairs(getgc(true)) do\n    if type(v) == \"function\" and debug.getinfo(v)[\"name\"] == \"Add\" then\n        local src = debug.getinfo(v)[\"short_src\"]\n        if src:find(\"Recoil\") then\n            RecoilFunction = v\n            break\n        end\n    end\nend\n\n-- 2. Apply the Hook\nif RecoilFunction then\n    local RecoilHook\n    RecoilHook = hookfunction(RecoilFunction, function(...)\n        local args = {...}\n        \n        -- args[1] is typically Vertical Recoil\n        -- args[4] is typically Horizontal/Side Recoil\n        args[1] = 0\n        args[4] = 0\n        \n        return RecoilHook(table.unpack(args))\n    end)\n    print(\"Successfully hooked RecoilFunction\")\nelse\n    warn(\"Failed to find RecoilFunction. The module might not be loaded yet—try holding a gun first.\")\nend","owner":{"_id":"6744bafd1ac8b6ad26e67d23","username":"0_kingcat_0","verified":false,"profilePicture":"/images/photo/6744bafd1ac8b6ad26e67d23-1775149669038.png","status":"offline","id":"6744bafd1ac8b6ad26e67d23"},"verified":false,"views":2482,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-0d8eabfb49fad9cec277f9a190b40f54-85fd3e2675f8.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-05-20T21:45:45.603Z","executes":691,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a0e2b89e3319f81ef6b851d","editBy":{"_id":"6744bafd1ac8b6ad26e67d23","username":"0_kingcat_0","status":"offline","id":"6744bafd1ac8b6ad26e67d23"},"message":"Create script","createdAt":"2026-05-20T21:45:45.607Z"}],"comments":[{"_id":"6a2150722de242ef0678b6ba","commentBy":{"_id":"6a214fd310773cea7ba973f3","username":"LonebOY","verified":false,"role":"user","profilePicture":"/images/photo/6a214fd310773cea7ba973f3-1789892341854.png","lastActive":"2026-09-22T14:33:00.152Z","createdAt":"2026-06-04T10:13:39.473Z","status":"offline","id":"6a214fd310773cea7ba973f3"},"text":"@bfro1234 men try make no recoil with ai U cant lol","parent":null,"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-04T10:16:18.455Z","liked":false,"disliked":false},{"_id":"6a4c2b6c3cc2604ffd43096d","commentBy":{"_id":"69d65ff2a0688fcccc8fab57","username":"kawalok","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-07-16T08:57:19.083Z","createdAt":"2026-04-08T14:02:26.717Z","status":"offline","id":"69d65ff2a0688fcccc8fab57"},"text":"is it xeno supported or nah","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-06T22:25:48.370Z","liked":false,"disliked":false},{"_id":"6a4c2b8498de6870fc24dc83","commentBy":{"_id":"69d65ff2a0688fcccc8fab57","username":"kawalok","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-07-16T08:57:19.083Z","createdAt":"2026-04-08T14:02:26.717Z","status":"offline","id":"69d65ff2a0688fcccc8fab57"},"text":"prob not cuz u have to hook right?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-06T22:26:12.114Z","liked":false,"disliked":false}]}