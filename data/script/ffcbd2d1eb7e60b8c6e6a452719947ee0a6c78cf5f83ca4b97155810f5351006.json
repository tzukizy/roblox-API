{"slug":"Universal-Script-Disable-Purchase-Prompts-83979","_id":"6962dc76242dea933c34af06","title":"Disable Purchase Prompts","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1768086646124.jpg","placeId":0},"features":"A simple script for disabling gamepass purchase prompts for those games with prompt pads all over the map.\n\nI could have made the script simpler by using WaitForChild but I didn't find that to be a good option for this.","tags":[],"script":"game.CoreGui.PurchasePromptApp.Enabled = false\nlocal FoundationOverlay = game.CoreGui:FindFirstChild(\"FoundationOverlay\")\nif not FoundationOverlay then\n    local connection\n    connection = game.CoreGui.ChildAdded:Connect(function(ins)\n        if ins.Name == \"FoundationOverlay\" then\n            ins.Enabled = false\n            connection:Disconnect()\n        end\n    end)\nelse\n    game.CoreGui.FoundationOverlay.Enabled = false\nend","owner":{"_id":"6260c0a53013d331b3c49f11","username":"Danny_","verified":false,"profilePicture":"/images/photo/6260c0a53013d331b3c49f11-1695083301885.png","status":"offline","id":"6260c0a53013d331b3c49f11","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1431,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1768086646124.jpg","likeCount":5,"dislikeCount":0,"createdAt":"2026-01-10T23:10:46.141Z","keyLink":"","editBy":{"_id":"6260c0a53013d331b3c49f11","username":"Danny_","status":"offline","id":"6260c0a53013d331b3c49f11"},"executes":126,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6962dc76242dea933c34af09","editBy":{"_id":"6260c0a53013d331b3c49f11","username":"Danny_","status":"offline","id":"6260c0a53013d331b3c49f11"},"message":"shy does scriptblox have commit messages?","createdAt":"2026-01-10T23:10:46.145Z"},{"_id":"6962e0ccf1e3faff02cced1e","editBy":{"_id":"6260c0a53013d331b3c49f1