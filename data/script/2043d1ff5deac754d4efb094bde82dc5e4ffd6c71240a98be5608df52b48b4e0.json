{"slug":"Dummies-vs-Noobs-hitbox-but-better-16393","_id":"66a8fcedcd778e602b30da5a","title":"hitbox but better","game":{"_id":"67e5e1ffb360710ec3c78115","gameId":8657806289,"name":"Dummies vs Noobs","imageUrl":"/images/sb/rbx-6a17ee5959013e267311573792301e04-7d2287152256.png","placeId":8657806289},"features":"hitbox but better\nWorking on Celery","tags":[],"script":"if not game:IsLoaded() then\n   game.Loaded:Wait();\nend\n\nlocal enemyNames = game:GetService(\"ReplicatedStorage\").Units.Noobs:GetChildren()\nlocal mapFolder = game:GetService(\"Workspace\").Map\n\nlocal function PutOnExtend(instance)\n    for _, x in ipairs(enemyNames) do\n        if tostring(x) == instance.Name and instance ~= nil then\n            instance.Head.Transparency = 0.6\n            instance.Head.Size = Vector3.new(50.0, 50.0, 50.0) -- set size here!!!\n            instance.Head.Massless = true\n        end\n    end\nend\n\nfor _, v in ipairs(workspace:GetChildren()) do\n    task.wait()\n    PutOnExtend(v)\nend\n\nworkspace.ChildAdded:Connect(function(v)\n    task.wait()\n    PutOnExtend(v)\nend)","owner":{"_id":"64e806efe38cad149896fbe2","username":"cling","verified":false,"profilePicture":"/images/photo/64e806efe38cad149896fbe2-1787720510364.jpg","status":"offline","id":"64e806efe38cad149896fbe2","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":61326,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-07-30T14:47:09.298Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/136054c50bf28c39dcb432b29961be66/500/280/Image/Jpeg","executes":47,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c8da","editBy":{"_id":"64e806efe38cad149896fbe2","username":"cling","status":"offline","id":"64e806efe38cad149896fbe2"},"message":"Create script","createdAt":"2024-07-31T07:03:30.315Z"},{"_id":"67e5e1e3b360710ec3c4c8db","editBy":{"_id":"64