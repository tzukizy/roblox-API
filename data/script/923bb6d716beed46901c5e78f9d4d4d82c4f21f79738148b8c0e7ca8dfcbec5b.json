voidPart.Name = \"Void Part\"\nvoidPart.Size = Vector3.new(9e9, 1.5, 9e9)\nvoidPart.Anchored = true\nvoidPart.CanCollide = true\nvoidPart.Material = Enum.Material.Plastic\nvoidPart.Color = Color3.new(0, 0, 0)\nvoidPart.CFrame = CFrame.new(-363.407135, -501.227661, 643.748657)\nvoidPart.Parent = workspace\n\nlocal antiDeathEnabled = true\nlocal checking = false\n\nRunService.RenderStepped:Connect(function()\n    if antiDeathEnabled and not checking then\n        local deathCam = workspace:FindFirstChild(\"Cutscenes\")\n                        and workspace.Cutscenes:FindFirstChild(\"Death Cutscene\")\n                        and workspace.Cutscenes[\"Death Cutscene\"]:FindFirstChild(\"Camm\")\n\n        if deathCam and cam.CameraSubject == deathCam then\n            checking = true\n            if player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n                local hrp = player.Character.HumanoidRootPart\n                local originalCFrame = hrp.CFrame\n\n                task.wait(2)\n                if cam.CameraSubject == deathCam then\n                    hrp.CFrame = voidPart.CFrame + Vector3.new(0,5,0)\n                    cam.CameraSubject = player.Character:FindFirstChild(\"Humanoid\")\n                    task.wait(0.1)\n                    hrp.CFrame = originalCFrame\n                end\n            end\n            checking = false\n        end\n    end\nend)","features":"script:\n-auto check death counter\n-auto kill death counter","tags":[],"discord":"","keyLink":"","owner":{"_id":"6900d2e5d815a69893e1d8f6","username":"DevsVNG","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6900d2e5d815a69893e1d8f6","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":1,"d"