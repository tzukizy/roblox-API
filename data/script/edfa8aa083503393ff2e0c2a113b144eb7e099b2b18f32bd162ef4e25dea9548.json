{"slug":"Easy-Obby-OPEN-SOURCE-TP-to-every-stage-in-1-second-19057","_id":"66f5b769b8cda3cd46633266","title":"OPEN SOURCE TP to every stage in 1 second","game":{"_id":"67e5e1ffb360710ec3c7871e","gameId":5972698540,"name":"Easy Obby","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":5972698540},"features":"-Finish obby in 1 second\n-Open source","tags":["TP","teleport","complete","obby","easy"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nfor i = 1, 130 do\n    local stageName = string.format(\"Stage%02d\", i)\n    local stage = workspace.Stages:FindFirstChild(stageName)\n    \n    if stage then\n        local checkpoint = stage:FindFirstChild(\"Checkpoint\")\n        if checkpoint then\n            local checkpointPart = checkpoint:FindFirstChild(\"Checkpoint\")\n            if checkpointPart then\n                humanoidRootPart.CFrame = checkpointPart.CFrame\n                wait(0)\n            end\n        end\n    end\nend\n","owner":{"_id":"66e6be89ab8109ee911a81eb","username":"hi_grind","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/66a2e272cd553c21fde05be77143450e9b16b3117c9c6e22e51912f1f09d8316.webp","original":"https://scriptblox.com/images/photo/66e6be89ab8109ee911a81eb-1726398169931.png"},"status":"offline","id":"66e6be89ab8109ee911a81eb","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/66a2e272cd553c21fde05be77143450e9b16b3117c9c6e22e51912f1f09d8316.webp","original":"https://scriptblox.com/images/photo/66e6be89ab8109ee911a81eb-1726398169931.png"}},"verified":false,"keyLink":"","views":23777,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-09-26T19:35:05.801Z","dislikeCount