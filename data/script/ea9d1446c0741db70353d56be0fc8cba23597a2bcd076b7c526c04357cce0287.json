{"_id":"69b095411f96150741d14c82","title":"Ai made fov changer by 2i9y","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Ai-made-fov-changer-by-2i9y-136123","verified":false,"key":false,"keyless":false,"views":519,"executes":40,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/87ba6d103ab80f76f268b57e3621068c5ea155da60d4bc50b40902119b8ad1bb.webp","original":"https://scriptblox.com/images/sb/0-1773180225870.png","scriptblox":"https://scriptblox.com/images/script/0-1773180225870.png"},"thumbnail":{"url":"https://media.kocakz.me/87ba6d103ab80f76f268b57e3621068c5ea155da60d4bc50b40902119b8ad1bb.webp","original":"https://scriptblox.com/images/sb/0-1773180225870.png","scriptblox":"https://scriptblox.com/images/script/0-1773180225870.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-10T22:03:45.887Z","updatedAt":"2026-03-10T22:03:45.887Z","lastBump":"2026-03-10T22:03:45.887Z","script":"-- FOV Changer | by 2i9y\n\nlocal Fluent = loadstring(game:HttpGet(\"https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua\"))()\n\nlocal Players = game:GetService(\"Players\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal Camera = workspace.CurrentCamera\n\n-- Blur\nlocal Blur = Instance.new(\"BlurEffect\")\nBlur.Size = 0\nBlur.Parent = Lighting\n\n-- Window\nlocal Window = Fluent:CreateWindow({\n    Title = \"2i9y FOV Changer\",\n    SubTitle = \"Camera Settings\",\n    TabWidth = 160,\n    Size = UDim2.fromOffset(520, 350),\n    Acrylic = true,\n    Theme = \"Dark\",\n    MinimizeKey = Enum.KeyCode.RightShift\n})\n\nlocal Tabs = {\n    Main = Window:AddTab({ Title = \"FOV\", Icon = \"eye\" }),\n    Settings = Window:AddTab({ Title = \"Settings\", Icon = \"settings\" })\n}\n\nlocal Settings = {\n    FOV = 70,\n    Rainbow = false,\n    Blur = false\n}\n\n-- MAIN SECTION\nlocal MainSection = Tabs.Main:AddSection(\"Camera\")\n\nlocal FOVSlider = MainSection:AddSlider(\"FOV\", {\n    Title = \"Field of View\",\n    Description = \"Change camera FOV\",\n    Default = 70,\n    Min = 40,\n    Max = 120,\n    Rounding = 0\n})\n\nFOVSlider:OnChanged(function(Value)\n    Settings.FOV = Value\n    Camera.FieldOfView = Value\nend)\n\nlocal ResetButton = MainSection:AddButton({\n    Title = \"Reset FOV\",\n    Description = \"Return to default\",\n    Callback = function()\n        Camera.FieldOfView = 70\n        FOVSlider:SetValue(70)\n    end\n})\n\n-- SETTINGS SECTION\nlocal VisualSection = Tabs.Settings:AddSection(\"Visual\")\n\nlocal RainbowToggle = VisualSection:AddToggle(\"Rainbow\", {\n    Title = \"Rainbow UI\",\n    Default = false\n})\n\nRainbowToggle:OnChanged(function()\n    Settings.Rainbow = RainbowToggle.Value\nend)\n\nlocal BlurToggle = VisualSection:AddToggle(\"Blur\", {\n    Title = \"Blur Background\",\n    Default = false\n})\n\nBlurToggle:OnChanged(function()\n    Settings.Blur = BlurToggle.Value\nend)\n\n-- Rainbow effect\ntask.spawn(function()\n    while task.wait(0.05) do\n        if Settings.Rainbow then\n            local color = Color3.fromHSV(tick()%5/5,1,1)\n            Fluent:SetAccentColor(color)\n        end\n    end\nend)\n\n-- Blur update\ntask.spawn(function()\n    while task.wait(0.1) do\n        if Settings.Blur then\n            Blur.Size = 18\n        else\n            Blur.Size = 0\n        end\n    end\nend)\n\n-- Apply default\nCamera.FieldOfView = Settings.FOV\n\n-- Notification\nFluent:Notify({\n    Title = \"2i9y FOV Changer\",\n    Content = \"Loaded successfully!\",\n    Duration = 5\n})","features":"Fov changer no key GUi","tags":[],"discord":"","keyLink":"","owner":{"_id":"6998c2904bfacc34697b2ee6","username":"yematrix","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3410d7b441dc89b6b9ca74b3642641b1afae9276384a36300b510d4bc78b296a.webp","original":"https://scriptblox.com/images/photo/6998c2904bfacc34697b2ee6-1771884949116.png"},"status":"offline","id":"6998c2904bfacc34697b2ee6","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/3410d7b441dc89b6b9ca74b3642641b1afae9276384a36300b510d4bc78b296a.webp","original":"https://scriptblox.com/images/photo/6998c2904bfacc34697b2ee6-1771884949116.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:26:31.612Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b095411f96150741d14c85","editBy":{"_id":"6998c2904bfacc34697b2ee6","username":"yematrix","status":"offline","id":"6998c2904bfacc34697b2ee6"},"message":"Create script","createdAt":"2026-03-10T22:03:45.890Z"}],"comments":[{"_id":"69b096a8942b0cf7aa50aa00","commentBy":{"_id":"6998c2904bfacc34697b2ee6","username":"yematrix","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/3410d7b441dc89b6b9ca74b3642641b1afae9276384a36300b510d4bc78b296a.webp","original":"https://scriptblox.com/images/photo/6998c2904bfacc34697b2ee6-1771884949116.png"},"lastActive":"2026-06-23T22:19:11.349Z","createdAt":"2026-02-20T20:22:40.440Z","status":"offline","id":"6998c2904bfacc34697b2ee6","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/3410d7b441dc89b6b9ca74b3642641b1afae9276384a36300b510d4bc78b296a.webp","original":"https://scriptblox.com/images/photo/6998c2904bfacc34697b2ee6-1771884949116.png"}},"text":"should i make aimbot??","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2026-03-10T22:09:44.609Z","liked":false,"disliked":false},{"_id":"69b09727dfe464b918b71c75","commentBy":{"_id":"6998c29