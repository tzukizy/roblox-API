{"_id":"69704a5483690c59c1f097e3","title":"ESP","game":{"_id":"67e5e1ffb360710ec3c77d95","gameId":286090429,"name":"Arsenal","imageUrl":{"url":"https://media.kocakz.me/bcf4cc7e44823466746f5b32b5a089e078242075e63b4abdf1e59502b6a63b63.webp","original":"https://tr.rbxcdn.com/180DAY-29023c3f115f5eac513c836ef674fd42/150/150/Image/Png/noFilter"},"slug":"286090429-arsenal","path":"/game/286090429-arsenal","thumbnail":{"url":"https://media.kocakz.me/bcf4cc7e44823466746f5b32b5a089e078242075e63b4abdf1e59502b6a63b63.webp","original":"https://tr.rbxcdn.com/180DAY-29023c3f115f5eac513c836ef674fd42/150/150/Image/Png/noFilter"},"placeId":286090429},"slug":"Arsenal-ESP-88679","verified":false,"key":false,"keyless":false,"views":715,"executes":32,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/48fb78673df2080eb8e70d44f33c2d16605bf0dc9a04e1d23e0213b03d291cd1.webp","original":"https://scriptblox.com/images/sb/286090429-1768966740859.webp","scriptblox":"https://scriptblox.com/images/script/286090429-1768966740859.webp"},"thumbnail":{"url":"https://media.kocakz.me/48fb78673df2080eb8e70d44f33c2d16605bf0dc9a04e1d23e0213b03d291cd1.webp","original":"https://scriptblox.com/images/sb/286090429-1768966740859.webp","scriptblox":"https://scriptblox.com/images/script/286090429-1768966740859.webp"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-21T03:39:00.882Z","updatedAt":"2026-01-21T03:39:00.882Z","lastBump":"2026-01-21T03:39:00.882Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Highlights = {}\n\nlocal function AddHighlight(character, player)\n    local highlight = Instance.new(\"Highlight\")\n    highlight.Adornee = character\n    highlight.Parent = character\n    highlight.FillColor = Color3.fromRGB(255, 50, 50)\n    highlight.FillTransparency = 0.5\n    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n    highlight.OutlineTransparency = 0\n    \n    Highlights[player] = highlight\n    \n    character:WaitForChild(\"Humanoid\").Died:Connect(function()\n        if Highlights[player] then\n            Highlights[player]:Destroy()\n            Highlights[player] = nil\n        end\n    end)\nend\n\nfor _, player in ipairs(Players:GetPlayers()) do\n    if player ~= LocalPlayer and player.Character then\n        AddHighlight(player.Character, player)\n    end\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n    player.CharacterAdded:Connect(function(character)\n        if player ~= LocalPlayer then\n            AddHighlight(character, player)\n        end\n    end)\nend)\n\nfor _, player in ipairs(Players:GetPlayers()) do\n    player.CharacterAdded:Connect(function(character)\n        if player ~= LocalPlayer then\n            AddHighlight(character, player)\n        end\n    end)\nend","features":"The simplest script on ESP and that's it.\nYou can change the color if the red one gets boring.","tags":["Arsenal","ESp"],"discord":"","keyLink":"","owner":{"_id":"680530c12ba4bae0a329501a","username":"dimafrobot","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"680530c12ba4bae0a329501a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:34:29.374Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69704a5483690c59c1f097e6","editBy":{"_id":"680530c12ba4bae0a329501a","username":"dimafrobot","status":"offline","id":"680530c12ba4bae0a329501a"},"message":"Create script","createdAt":"2026-01-21T03:39:00.885Z"}],"comments":[{"_id":"69704ab1a601210e732afed1","commentBy":{"_id":"65ceac036df50962c13156e6","username":"vladi