n    elseif Msg == \"/e pie\" then\n       RepEvents.GiveTool:FireServer(\"Pie\")\n    elseif Msg == \"/e apple\" then\n        RepEvents.GiveTool:FireServer(\"Apple\")\n    elseif Msg == \"/e bloxycola\" then\n        RepEvents.GiveTool:FireServer(\"BloxyCola\")\n    elseif Msg == \"/e superheal\" then\n        RepEvents.GiveTool:FireServer(\"Cure\")\n    elseif Msg == \"/e medkit\" then\n        RepEvents.GiveTool:FireServer(\"MedKit\")\n    elseif Msg == \"/e bat\" then\n        RepEvents.GiveTool:FireServer(\"Bat\")\n    elseif Msg == \"/e linkedsword\" then\n        RepEvents.GiveTool:FireServer(\"LinkedSword\")\n    elseif Msg == \"/e lollipop\" then\n        RepEvents.GiveTool:FireServer(\"Lollipop\")\n    -- Kitchen-Controls\n    elseif Msg == \"/e foodevent\" then\n        RepEvents.BloxyPack:FireServer(1)\n    -- Basement-Controls\n    elseif Msg == \"/e unlockbasement\" then\n        RepEvents.UnlockDoor:FireServer()\n    elseif Msg == \"/e basementlights\" then\n        RepEvents.BasementMission:FireServer()\n        RepEvents.basementLights:FireServer()\n    elseif Msg == \"/e equipladder\" then\n        RepEvents.Ladder:FireServer(1)\n    elseif Msg == \"/e dropladder\" then\n        RepEvents.Ladder:FireServer(2)\n      end\n  end)","features":"-- Tool-Controls\n/e pizza\n/e epicpizza\n/e chips\n/e pie\n/e apple\n/e bloxycola\n/e superheal\n/e medkit\n/e bat\n/e linkedsword\n/e lollipop\n-- Kitchen-Controls\n/e foodevent\n-- Basement-Controls\n/e unlockbasement\n/e basementlights\n/e equipladder\n/e dropladder","tags":["Private Commands","Basement Controls","Tool Controls","Multiple Execution"],"discord":"","keyLink":"","owner":{"_id":"625c73d4c4c4f04e7b53c1db","username":"ryanjtparker","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"625c73d4c4c4f04e7b53c1db","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","ori