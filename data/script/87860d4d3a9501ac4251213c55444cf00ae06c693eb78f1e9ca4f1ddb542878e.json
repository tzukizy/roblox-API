{"slug":"CRASHOUT-OBBY-Complete-Obby-43297","_id":"685ff053b817f46491178b28","title":"Complete Obby","game":{"_id":"67e5e1ffb360710ec3c78754","gameId":120878830587405,"name":"CRASHOUT OBBY","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":120878830587405},"features":"this script will change your life","tags":["obby"],"script":"local stages = game.Workspace.Stages\nlocal plr = game.Players.LocalPlayer\nlocal leaderstats = plr.leaderstats\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal root = char.HumanoidRootPart\n\n-- getting the highest stage index\nlocal highest = 0\nfor _, v in next, stages:GetChildren() do\n    local i = tonumber(v.Name)\n    if v:IsA(\"SpawnLocation\") and i > highest then\n        highest = i\n    end\nend\n\n-- looping through numbers and simulating a touch on the stage\nfor i = leaderstats.Stage.Value, highest do\n    local stage = stages:FindFirstChild(tostring(i))\n    if stage and stage:IsA(\"SpawnLocation\") then\n        firetouchinterest(stage, root, 1)\n        task.wait(.1)\n        firetouchinterest(stage, root, 0)\n    end\nend","owner":{"_id":"67897cc42ca83ec8485a1373","username":"BSpook","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0f402ab23125891c2522aed86c79fda0527674e2b516b8959bc7e549adce77f9.webp","original":"https://scriptblox.com/images/photo/67897cc42ca83ec8485a1373-1751115715439.png"},"status":"offline","id":"67897cc42ca83ec8485a1373","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/0f402ab23125891c2522aed86c79fda0527674e2b516b8959bc7e549adce77f9.webp","original":"https://scriptblox.com/images/photo/67897cc42ca83ec8485a1373-1751115715439.png"}},"verified":false,"views":2401,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp