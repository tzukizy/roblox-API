j.Name == \"StateEvent\" then\n            local pName = obj.Parent.Parent.Name\n            if pName:match(\"Palm\") or pName:match(\"Tree\") or pName:match(\"Raft\") or pName == \"Crafting Table\" or table.find(players, pName) then\n                continue\n            end\n            print(\"Item found:\", pName)\n            obj:FireServer(\"held\")\n            wait(0.4)\n            obj:FireServer(\"dropped\", centerRaftBase.CFrame, {[\"Y\"] = 1, [\"X\"] = 0}, Vector3.new(-1.02044677734375, 1.7915000915527344, 5.3248291015625))\n        end\n    end\nend","features":"Using the script, you can collect things that are scattered across the islands without leaving the raft: Chests, stones, etc.","tags":["collect","items","fast","monkey","raft"],"discord":"","keyLink":"","owner":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","verified":true,"profilePicture":{"url":"https://media.kocakz.me/4c296a9201f9551996a357d62ae1913747bd75c28208290884e9e394f442f870.webp","original":"https://scriptblox.com/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png"},"lvl":24,"status":"offline","id":"61f96cc63ede52bf4f7e299d","leaderboard":{"tag":{"kind":"hall","rank":1,"period":"all","metric":"views","value":17487431}},"topMilestone":{"key":"creator.likes","tier":1000},"profile":{"url":"https://media.kocakz.me/4c296a9201f9551996a357d62ae1913747bd75c28208290884e9e394f442f870.webp","original":"https://scriptblox.com/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:11:06.956Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c701","editBy":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","status":"offline","id":"61f96cc63ede52bf4f7e299d"},"message":"Create script","createdAt":"2024-07-08T17:16:21.3