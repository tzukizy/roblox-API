{"slug":"TIGER-SHARK-monkey-raft-Collect-Items-15424","_id":"668c1ecd78e64787fd0f18aa","title":"Collect Items","game":{"_id":"67e5e1ffb360710ec3c780b6","gameId":17495769916,"name":"[TIGER SHARK]🌴 monkey raft 🌴","imageUrl":"https://tr.rbxcdn.com/92a878de21f8ef36cfe1232ca97f172c/500/280/Image/Jpeg","placeId":17495769916},"features":"Using the script, you can collect things that are scattered across the islands without leaving the raft: Chests, stones, etc.","tags":["collect","items","fast","monkey","raft"],"script":"-- t.me/arceusxscripts\nlocal players = {}\nfor _, plr in pairs(game.Players:GetPlayers()) do\n    table.insert(players, plr.Name)\nend\nlocal centerRaftBase = workspace:FindFirstChild(\"Center Raft\") and workspace[\"Center Raft\"]:FindFirstChild(\"Base\")\nif centerRaftBase then\n    for _, obj in ipairs(workspace:GetDescendants()) do\n        if obj:IsA(\"RemoteEvent\") and obj.Name == \"StateEvent\" then\n            local pName = obj.Parent.Parent.Name\n            if pName:match(\"Palm\") or pName:match(\"Tree\") or pName:match(\"Raft\") or pName == \"Crafting Table\" or table.find(players, pName) then\n                continue\n            end\n            print(\"Item found:\", pName)\n            obj:FireServer(\"held\")\n            wait(0.4)\n            obj:FireServer(\"dropped\", centerRaftBase.CFrame, {[\"Y\"] = 1, [\"X\"] = 0}, Vector3.new(-1.02044677734375, 1.7915000915527344, 5.3248291015625))\n        end\n    end\nend","owner":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","verified":true,"profilePicture":"/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png","status":"offline","id":"61f96cc63ede52bf4f7e299d","leaderboard":{"tag":{"kind":"hall","rank":1,"period":"all","metric":"views","value":17465198}},"topMilestone":{"key":"creator.likes","tier":1000}},"verified":true,"keyLink":"","views":144317,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-08T17:15:57.111Z","disli