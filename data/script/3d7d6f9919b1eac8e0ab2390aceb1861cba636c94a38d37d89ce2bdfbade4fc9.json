{"slug":"Update-Mining-Empire-sloppy-raycast-158466","_id":"69c8d59409e2fc99459ae4d9","title":"sloppy raycast fixed","game":{"_id":"69c8d59409e2fc99459ae4d6","gameId":109788262971946,"name":"[Update] Mining Empire","imageUrl":"/images/sb/rbx-9fe36821ff45e816775733bd00dc9cf5-6c51fffb1b26.png","placeId":109788262971946},"features":"auto mines arounds you\nadjustable radius + time","tags":[],"script":"local range = 8\nlocal detail = 16 \n\nlocal RunService = game:GetService(\"RunService\")\nlocal player = game.Players.LocalPlayer\nlocal charD = player.Character or player.CharacterAdded:Wait()\nlocal rooted = charD:WaitForChild(\"HumanoidRootPart\")\nRunService.Heartbeat:Connect(function()\n\tfor i = 1, detail do\n\t\tlocal angle = (i / detail) * math.pi * 2\n\t\tlocal where = Vector3.new(math.sin(angle), 0, math.cos(angle)) * range\n\t\t\n\t\tlocal stuff = RaycastParams.new()\n\t\tstuff.FilterDescendantsInstances = {char}\n\t\tstuff.FilterType = Enum.RaycastFilterType.Exclude\n\n\t\tlocal rayD = workspace:Raycast(rooted.Position, where, stuff)\n\n\t\tif rayD then\n\t\t\tlocal args = {\n\trayD.Instance\n}\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"MineRequestEvent\"):FireServer(unpack(args))\n\n\t\tend\n\tend\nend)\n","owner":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68309d74aef6b0af636efd8a","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1141,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-9fe36821ff45e816775733bd00dc9cf5-6c51fffb1b26.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-03-29T07:32:36.130Z","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"keyLink":"","executes":390,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c8d59409e2fc99459