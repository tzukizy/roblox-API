{"slug":"Update-Mining-Empire-sloppy-raycast-158466","_id":"69c8d59409e2fc99459ae4d9","title":"sloppy raycast fixed","game":{"_id":"69c8d59409e2fc99459ae4d6","gameId":109788262971946,"name":"[Update] Mining Empire","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":109788262971946},"features":"auto mines arounds you\nadjustable radius + time","tags":[],"script":"local range = 8\nlocal detail = 16 \n\nlocal RunService = game:GetService(\"RunService\")\nlocal player = game.Players.LocalPlayer\nlocal charD = player.Character or player.CharacterAdded:Wait()\nlocal rooted = charD:WaitForChild(\"HumanoidRootPart\")\nRunService.Heartbeat:Connect(function()\n\tfor i = 1, detail do\n\t\tlocal angle = (i / detail) * math.pi * 2\n\t\tlocal where = Vector3.new(math.sin(angle), 0, math.cos(angle)) * range\n\t\t\n\t\tlocal stuff = RaycastParams.new()\n\t\tstuff.FilterDescendantsInstances = {char}\n\t\tstuff.FilterType = Enum.RaycastFilterType.Exclude\n\n\t\tlocal rayD = workspace:Raycast(rooted.Position, where, stuff)\n\n\t\tif rayD then\n\t\t\tlocal args = {\n\trayD.Instance\n}\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"MineRequestEvent\"):FireServer(unpack(args))\n\n\t\tend\n\tend\nend)\n","owner":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"68309d74aef6b0af636efd8a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":1158,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/10890d5caff78d717d52522fce497c12c8e7f4d114eba41892321940c4613964.webp","original":"https://scriptblox.com/images/sb/rbx-9fe36821ff45e816775733bd00dc9cf5-6c51fffb1b