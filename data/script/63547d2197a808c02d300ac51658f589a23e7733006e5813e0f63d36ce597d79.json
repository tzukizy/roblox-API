{"slug":"Universal-Script-Durian-fruit-jump-button-52754","_id":"68c40f42ed6ec00d5e924856","title":"Broken","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Literally self-explanatory","tags":["Niche","Jump","Keyless","Helpful"],"script":"-- Make sure you have a ScreenGui in PlayerGui\nlocal player = game.Players.LocalPlayer\nlocal screenGui = player:WaitForChild(\"PlayerGui\"):FindFirstChild(\"ScreenGui\")\nif not screenGui then\n    screenGui = Instance.new(\"ScreenGui\")\n    screenGui.Name = \"ScreenGui\"\n    screenGui.Parent = player.PlayerGui\nend\n\n-- Create the durian button\nlocal durianButton = Instance.new(\"ImageButton\")\ndurianButton.Name = \"DurianJumpButton\"\ndurianButton.Size = UDim2.new(0, 100, 0, 100)  -- size of button\ndurianButton.Position = UDim2.new(0.5, -50, 0.8, 0)  -- bottom center of screen\ndurianButton.Image = \"rbxassetid://123173303668481\"  -- durian texture\ndurianButton.BackgroundTransparency = 1  -- remove background\ndurianButton.Parent = screenGui\n\n-- Make it act like a jump button\ndurianButton.MouseButton1Click:Connect(function()\n    local character = player.Character\n    if character and character:FindFirstChild(\"Humanoid\") then\n        character.Humanoid.Jump = true\n    end\nend)","owner":{"_id":"68ac457875ed45b5f6f85b20","username":"Kachoon","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/e89b987ee9a5dd85b1e7935312db16bb6d0ce0c4e88563b2535f352b52962f45.webp","original":"https://scriptblox.com/images/photo/68ac457875ed45b5f6f85b20-1756905018401.jpg"},"status":"offline","id":"68ac457875ed45b5f6f85b20","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/e89b987ee9a5dd85b1e7935312db16bb6d0ce0c4e88563b2535f352b52962f45.webp","original"