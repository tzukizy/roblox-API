{"slug":"Universal-Script-Thth-204653","_id":"69e88a416be743f879426882","title":"Thth","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Kkk","tags":["Ttt","CoiledTom"],"script":"local Lighting = game:GetService(\"Lighting\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\n\n-- CONFIG\nlocal BRIGHTNESS = 3\nlocal FOG_END = 100000\nlocal FOG_START = 0\n\n-- Função que aplica tudo\nlocal function applyVisual()\n    Lighting.Brightness = BRIGHTNESS\n    Lighting.ClockTime = 12\n    Lighting.GlobalShadows = false\n    Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)\n\n    Lighting.FogStart = FOG_START\n    Lighting.FogEnd = FOG_END\n\n    -- remover efeitos chatos\n    for _, v in pairs(Lighting:GetDescendants()) do\n        if v:IsA(\"Atmosphere\") or v:IsA(\"BloomEffect\") or v:IsA(\"BlurEffect\") then\n            v:Destroy()\n        end\n    end\nend\n\n-- Aplica uma vez quando rodar\napplyVisual()\n\n-- Reaplica quando o personagem spawnar\nplayer.CharacterAdded:Connect(function()\n    task.wait(1) -- espera carregar certinho\n    applyVisual()\nend)","owner":{"_id":"69cc7fdb3a3a2289aba76721","username":"Tomzinho","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f7d6b7c5b0b3a417ed174b2b891cbd88b128ef62b1dc65072288bb066c9771bb.webp","original":"https://scriptblox.com/images/photo/69cc7fdb3a3a2289aba76721-1775009871620.jpg"},"status":"offline","id":"69cc7fdb3a3a2289aba76721","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/f7d6b7c5b0b3a417ed174b2b891cbd88b128ef62b1dc65072288bb066c9771bb.webp","original":"https://scriptblox.com/images/photo/69cc7fdb3a3a2289aba76721-1775009871620.jpg"}},"verified":false,"views":291,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/96582fac4c8e9030aa039bb58b85e84fb7a1cc7e4e3e54cdd4278e2596314603.webp","original":"https://scriptblox.com/images/sb/0-1776847425211.jpg","scriptblox":"https://scriptblox.com/images/script/0-1776847425211.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-04-22T08:43:45.228Z","keyLink":"","editBy":{"_id":"69cc7fdb3a3a2289aba76721","username":"Tomzinho","status":"offline","id":"69cc7fdb3a3a2289aba76721"},"executes":1261,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:24:50.560Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/96582fac4c8e9030aa039bb58b85e84fb7a1cc7e4e3e54cdd4278e2596314603.webp","original":"https://scriptblox.com/images/sb/0-1776847425211.jpg","scriptblox":"https://scriptblox.com/images/script/0-1776847425211.jpg"},"changelog":[{"_id":"69e88a416be743f879426885","editBy":{"_id":"69cc7fdb3a3a2289aba76721","username":"Tomzinho","status":"offline","id":"69cc7fdb3a3a2289aba76721"},"message":"Create script","createdAt":"2026-04-22T08:43:45.236Z"},{"_id":"69e88b2089a6f65b416c7e0d","editBy":{"_id":"69cc7fdb3a3a2289aba76721","username":"Tomzinho","status":"offline","id":"69cc7fdb3a3a2289aba76721"},"message":"Update script","createdAt":"2026-04-22T08:47:28.804Z"}],"comments":[]}