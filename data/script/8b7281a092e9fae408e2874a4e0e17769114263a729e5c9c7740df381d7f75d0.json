{"slug":"The-Silent-Ascent-thesilentascend-script-243648","_id":"6a5989b0c7dc64e6d625dd00","title":"thesilentascend script","game":{"_id":"6a598962c7dc64e6d625dcff","gameId":132900233983987,"name":"The Silent Ascent","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":132900233983987},"features":"Teleports to essences. (you can change the teleport speed after the task.wait)","tags":["thesilentascent"],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal visited = {}\n\nwhile task.wait(0.4) do\n    local character = player.Character\n    if character then\n        for _, v in ipairs(workspace:GetDescendants()) do\n            if v.Name == \"Essence\"\n                and v:IsA(\"BasePart\")\n                and v.Parent\n                and not visited[v] then\n\n                visited[v] = true\n                character:PivotTo(v.CFrame + Vector3.new(0, 3, 0))\n                task.wait(0.4)\n            end\n        end\n    end\n\n    -- Clean up entries for removed objects\n    for part in pairs(visited) do\n        if not part.Parent then\n            visited[part] = nil\n        end\n    end\nend","owner":{"_id":"6a1d5f52b6a97334619cc495","username":"andajia","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6a1d5f52b6a97334619cc495","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":45,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/b1d3fe52b460536257bc5085be743fc70993a74100909caf3da16db78d74bd7a.webp","original":"https://scriptblox.com/images/sb/132900233983987-1784252848561.png","scriptblox":"https://scriptblox.com/images/script/13290