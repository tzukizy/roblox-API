response and response.data then\n        return response.data\n    end\n\n    return nil\nend\n\nlocal placeId = game.PlaceId\nlocal serverLimit = 100\nlocal servers = fetchServersData(placeId, serverLimit)\n\nif not servers then\n    return\nend\n\nlocal lowestPingServer = servers[1]\n\nfor _, server in pairs(servers) do\n    if server[\"ping\"] < lowestPingServer[\"ping\"] then\n        lowestPingServer = server\n    end\nend\n\nlocal commonLoadTime = 5\ntask.wait(commonLoadTime)\n\nlocal pingThreshold = 100\nlocal serverStats = StatsService.Network.ServerStatsItem\nlocal dataPing = serverStats[\"Data Ping\"]:GetValueString()\nlocal pingValue = tonumber(dataPing:match(\"(%d+)\"))\n\nif pingValue >= pingThreshold then\n    TeleportService:TeleportToPlaceInstance(placeId, lowestPingServer.id)\nelse\n    -- Good ping\nend\n","features":"Lets you join the server with the lowest ping for you","tags":["ping"],"discord":"","keyLink":"","owner":{"_id":"64de2ca93f2fead50fe1d0d5","username":"swag","verified":false,"profilePicture":{"url":"https://media.kocakz.me/10b85074a8dc4962f89cea777850e3b71ca71c9c735312c8d25ab0b9ae20d4ec.webp","original":"https://scriptblox.com/images/photo/64de2ca93f2fead50fe1d0d5-1692283279058.png"},"status":"offline","id":"64de2ca93f2fead50fe1d0d5","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/10b85074a8dc4962f89cea777850e3b71ca71c9c735312c8d25ab0b9ae20d4ec.webp","original":"https://scriptblox.com/images/photo/64de2ca93f2fead50fe1d0d5-1692283279058.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:18:40.009Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4fe7e","editBy":{"_id":"64de2ca93f2fead50fe1d0d5","username":"swag","status":"offline","id":"64de2ca93f2fead50fe1d0d5"},"message":"Creat