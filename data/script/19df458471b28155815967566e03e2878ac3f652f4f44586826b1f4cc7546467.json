=--\n\n--aimbot (toggle to enable/disable aim assist)\n--Fov slider (set aimbot FOV range)\n--smoothness X (horizontal aim smoothing)\n--smoothness Y (vertical aim smoothing)\n\n--enable prediction (toggle on/off)\n--base prediction (single value override for X and Y)\n--prediction X (horizontal prediction multiplier)\n--prediction Y (vertical prediction multiplier)\n\n--direction reaction delay (adds human-like reaction to movement changes)\n\n--force field check (ignores targets with force fields)\n--wallcheck (checks if the target is visible)\n--distance smoothing factor (adjusts aim speed based on distance)\n\n--== ESP Features Tab ==--\n\n--esp (toggle on/off to display enemy info)\n--esp max distance (maximum distance ESP can render players)\n\n--safe esp (highlights unopened safes nearby)\n--safe esp distance \n--toggle safe esp (keybind to toggle safe esp)\n\n--== Miscellaneous Tab ==--\n\n--full brightness (removes lighting effects for max visibility)\n\n--ambient color (adjusts indoor light tint)\n--outdoor ambient color (adjusts outdoor light tint)\n--reset ambient colors (reverts to default lighting)\n\n--enable time changer \n--time changer (sets in-game time of day)\n\n--lockpick (bigger pin bars to simplify lockpicking minigame)\n--infinite stamina","tags":["legit","Criminality","Crim"],"discord":"","keyLink":"https://lootdest.org/s?eIcyOlkJ","owner":{"_id":"6215d181c499e7904b2bef56","username":"Kuni","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2082b423dc8a1ddff4a4331ab186a7d11d44cfb0a740b034d889091610e00120.webp","original":"https://scriptblox.com/images/photo/6215d181c499e7904b2bef56-1746916168090.jpg"},"status":"offline","id":"6215d181c499e7904b2bef56","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/2082b423dc8a1ddff4a4331ab186a7d11d44cfb0a740b034d889091610e00120.webp","original":"https://scriptblox.com/images/photo/6215d181c499e7904b2bef56-1746916168090.jpg"}},"reviewed":null,"