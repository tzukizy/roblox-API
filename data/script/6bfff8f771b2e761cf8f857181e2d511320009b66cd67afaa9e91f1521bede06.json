{"slug":"Universal-Script-RGB-Chat-FIXED-BY-ME-53105","_id":"68c64fd41c825b31045a7337","title":"Universal RGB Bubble Chat","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1757827028231.png","placeId":0},"features":"original script by rouxhaver. roblox updated their bubble chat shit and it broke, this version works with the new chat. (best if used in autoexec)\n\n new and improved!","tags":["RGB","Rainbow","Bubble Chat","Chat","GUI"],"script":"const TextChatService = game:FindService(\"TextChatService\") :: TextChatService;\nconst RunService = game:FindService(\"RunService\") :: RunService;\nconst BCConfig = TextChatService:FindFirstChild(\"BubbleChatConfiguration\") :: BubbleChatConfiguration;\n-- const CWConfig = TextChatService:FindFirstChild(\"ChatWindowConfiguration\") :: ChatWindowConfiguration;\n\nconst fromRGB: (number?, number?, number?) -> Color3 = Color3.fromRGB;\nconst fromHSV:(number, number, number) -> Color3 = Color3.fromHSV\nconst Vec3New:(number?, number?, number?) -> Vector3 = Vector3.new;\n\nif getgenv().__Conn then\n    getgenv().__Conn:Disconnect();\nend\n\ngetgenv().__Conn = RunService.PreRender:Connect(function()\n    BCConfig.TextColor3 = fromHSV((tick() * 0.35) % 1.00000000000000000000000000000000000000000000000000000001, .79, .95);\n    BCConfig.BackgroundColor3 = fromRGB(22, 22, 28)\n    BCConfig.LocalPlayerStudsOffset = Vec3New(0, 0.2, 0);\n    BCConfig.MaxDistance = 300;\nend)","owner":{"_id":"64e42935e38cad1498824223","username":"koboldpaws","verified":false,"profilePicture":"/images/photo/64e42935e38cad1498824223-1779702017984.jpg","status":"offline","id":"64e42935e38cad1498824223","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":14043,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1757827028231.png","likeCount":5,"dislikeCount":1,"createdAt":"2025-09-14T05:17:08.253Z","editBy":{"_id":"64e42935e38c