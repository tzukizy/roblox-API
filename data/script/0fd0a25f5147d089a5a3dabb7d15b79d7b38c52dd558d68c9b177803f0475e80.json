{"_id":"6945893acfb703f6d2538cf0","title":"Audio logger boombox","game":{"_id":"68966c2c1db541b05096cd52","gameId":14113053169,"name":"Free Client Script Executor *BACK*","imageUrl":{"url":"https://media.kocakz.me/ee9cd5d22b0130fa183d984f3a68f029e9df5ef4596e46f028c9123c6bbc73a8.webp","original":"https://scriptblox.com/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png"},"slug":"14113053169-free-client-script-executor-back","path":"/game/14113053169-free-client-script-executor-back","thumbnail":{"url":"https://media.kocakz.me/ee9cd5d22b0130fa183d984f3a68f029e9df5ef4596e46f028c9123c6bbc73a8.webp","original":"https://scriptblox.com/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png"},"placeId":14113053169},"slug":"Free-Client-Script-Executor-*BACK*-Audio-logger-boombox-76187","verified":false,"key":false,"keyless":false,"views":1015,"executes":97,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d98437442572151102.webp","original":"https://scriptblox.com/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","scriptblox":"https://scriptblox.com/images/script/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png"},"thumbnail":{"url":"https://media.kocakz.me/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d98437442572151102.webp","original":"https://scriptblox.com/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","scriptblox":"https://scriptblox.com/images/script/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-19T17:19:54.209Z","updatedAt":"2025-12-19T17:19:54.209Z","lastBump":"2025-12-19T17:19:54.209Z","script":"local bindfunc = Instance.new(\"BindableFunction\", workspace)\nbindfunc.Name = \"LogAudio\"\nbindfunc.OnInvoke = function(player,shouldplayaudio)\n    for i, v in pairs(game.Players:GetPlayers()) do\n        if v.Name:lower():sub(1,#player) == player:lower() then\n            for _, c in pairs(v.Character:GetDescendants()) do\n                if c:IsA(\"Sound\") and c.Playing and c:FindFirstAncestorOfClass(\"Tool\") then\n                    print(v.Name..\"'s Audio: \"..c.SoundId:sub(33,#c.SoundId))\n                    if shouldplayaudio then\n                        local plr = game.Players.LocalPlayer\n                        local char = plr.Character\n                        local hum = char.Humanoid\n                        hum:UnequipTools()\n                        hum:EquipTool(plr.Backpack.BoomBox)\n                        char.BoomBox.Remote:FireServer(tonumber(c.SoundId:sub(33,#c.SoundId)))\n                    end\n                end\n            end\n        end\n    end\nend","features":"Logs audio on boombox games.\nHOW TO USE👇👇👇👇👇👇👇👇👇👇👇👇👇👇👇\nworkspace.LogAudio:Invoke(\"PlayerName\", ShouldPlayAudio? : boolean)\nExamples:\nworkspace.LogAudio:Invoke(\"bob\", true)\nworkspace.LogAudio:Invoke(\"bob\", false)","tags":["Audio","Boombox","Logger","Audio logger","FE"],"discord":"","keyLink":"","owner":{"_id":"69237472df5c9c28cb000392","username":"Automated_Account","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8a5ddbd218e23b4214ea5686aa7d6bd8b3710b5a051962059566810ddb5a1e0f.webp","original":"https://scriptblox.com/images/photo/69237472df5c9c28cb000392-1763931573809.jpeg"},"status":"offline","id":"69237472df5c9c28cb000392","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/8a5ddbd218e23b4214ea5686aa7d6bd8b3710b5a051962059566810ddb5a1e0f.webp","original":"https://scriptblox.com/images/photo/69237472df5c9c28cb000392-1763931573809.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:36:25.154Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],