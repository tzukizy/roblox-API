{"slug":"Brookhaven-RP-Invisble-car-45829","_id":"687ec5fd95da29c653f402a7","title":"Invisble car","game":{"_id":"67e5e1ffb360710ec3c77d10","gameId":4924922222,"name":"Brookhaven 🏡RP","imageUrl":"/images/sb/rbx-6a624ff9c64051a23e06dbcfff888b32-d503690b94ea.png","placeId":4924922222},"features":"Invisble car","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal head = character:WaitForChild(\"Head\")\n\n-- Check if there's already a Fire object, remove it to avoid duplicates\nlocal existingFire = head:FindFirstChildOfClass(\"Fire\")\nif existingFire then\n    existingFire:Destroy()\nend\n\n-- Create a Fire effect\nlocal fire = Instance.new(\"Fire\")\nfire.Size = 5\nfire.Heat = 10\nfire.Parent = head\n","owner":{"_id":"6770356ff0f8d6aa7634c205","username":"Dizzilovell","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6770356ff0f8d6aa7634c205"},"verified":false,"views":14267,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-ffc7c8a21538e7a61e9458432a435142-26c5ef58c2e0.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-07-21T22:58:05.298Z","editBy":{"_id":"6770356ff0f8d6aa7634c205","username":"Dizzilovell","status":"offline","id":"6770356ff0f8d6aa7634c205"},"executes":288,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"687ec5fd95da29c653f402a9","editBy":{"_id":"6770356ff0f8d6aa7634c205","username":"Dizzilovell","status":"offline","id":"6770356ff0f8d6aa7634c205"},"message":"Create script","createdAt":"2025-07-21T22:58:05.302Z"},{"_id":"687ec66219599ad33f3a9aea","editBy":{"_id":"6770356ff0f8d6aa7634c205","username":"Dizzilovell","status":"offline","id":"6770356ff0f8d6aa7634c205"},"message":"Update script","createdAt":"2025-07-21T22:59:46.320Z"}],"comments":[]}