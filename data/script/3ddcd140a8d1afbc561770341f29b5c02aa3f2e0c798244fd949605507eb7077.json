{"slug":"Muscle-Legends-Auto-Train-Any-Executor-Muscle-Legend-57782","_id":"68eaa6cc36fc0d7a37f82013","title":"Auto Train Any Executor Muscle Legend","game":{"_id":"67e5e1ffb360710ec3c77d99","gameId":3623096087,"name":"🎃 Muscle Legends ","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":3623096087},"features":"auto trains","tags":["auto","muscle","legends","xeno","unc"],"script":"-- don't mind the messy code it works enough\n\nlocal LocalPlayer = game.Players.LocalPlayer\nlocal Humanoid = LocalPlayer.Character:WaitForChild(\"Humanoid\")\nlocal weight = LocalPlayer.Backpack.Weight\nLocalPlayer.CharacterAdded:Connect(function(Character)\n\tHumanoid = Character:WaitForChild(\"Humanoid\")\nend)\nlocal muscleEvent = LocalPlayer.muscleEvent\n\ntask.spawn(function()\n\twhile task.wait() do\n\t\tfor i,v in pairs(LocalPlayer.Backpack:GetChildren()) do\n\t\t\tif not v.Name:match(\"Punch\") then\n\t\t\t\tv.Parent = LocalPlayer.Character\n\t\t\t\ttask.wait()\n\t\t\t\tv.Parent = LocalPlayer.Backpack\n\t\t\tend\n\t\tend\n\tend\nend)\n\nwhile task.wait() do\n\tmuscleEvent:FireServer(\"rep\")\n\t-- One Hit Invicibility\n\tHumanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)\n\tif Humanoid.Health <= Humanoid.MaxHealth and Humanoid.Health >= 1 then\n\t\tLocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, 10000, 0)\n\tend\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11023698}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https:/