{"_id":"6834b50faef6b0af63f4ca42","title":"Fast Shop Opening","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/31c135971cce2dfaed3dd5a2f0969cb0755ad9fd8131eb1c8e9eaa811ae0db7f.webp","original":"https://scriptblox.com/images/sb/0-1748284687102.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/31c135971cce2dfaed3dd5a2f0969cb0755ad9fd8131eb1c8e9eaa811ae0db7f.webp","original":"https://scriptblox.com/images/sb/0-1748284687102.jpg"},"placeId":0},"slug":"Universal-Script-Fast-Shop-Opening-41112","verified":false,"key":false,"keyless":false,"views":5022,"executes":19,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2f243b702c84532f08dd924bc6f12999f4ece0de3b05977a55843d14a90fb844.webp","original":"https://scriptblox.com/images/sb/0-1748284687102.jpg","scriptblox":"https://scriptblox.com/images/script/0-1748284687102.jpg"},"thumbnail":{"url":"https://media.kocakz.me/2f243b702c84532f08dd924bc6f12999f4ece0de3b05977a55843d14a90fb844.webp","original":"https://scriptblox.com/images/sb/0-1748284687102.jpg","scriptblox":"https://scriptblox.com/images/script/0-1748284687102.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-05-26T18:38:07.158Z","updatedAt":"2025-05-26T18:38:07.158Z","lastBump":"2025-05-26T18:38:07.158Z","script":"local player = game.Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\nlocal buttonGui = Instance.new(\"ScreenGui\")\nbuttonGui.Name = \"ShopButtons\"\nbuttonGui.ResetOnSpawn = false \nbuttonGui.Parent = playerGui\n\nlocal buttonStyle = {\n    Size = UDim2.new(0.15, 0, 0.07, 0),\n    BackgroundColor3 = Color3.fromRGB(50, 50, 50),\n    TextColor3 = Color3.fromRGB(255, 255, 255),\n    Font = Enum.Font.SourceSansBold,\n    TextSize = 18,\n    AnchorPoint = Vector2.new(1, 0), \n}\n\nlocal seedButton = Instance.new(\"TextButton\")\nseedButton.Name = \"SeedShopButton\"\nseedButton.Text = \"Seed Shop\"\nseedButton.Position = UDim2.new(1, -10, 0, 10) \nfor prop, value in pairs(buttonStyle) do\n    seedButton[prop] = value\nend\nseedButton.Parent = buttonGui\n\nlocal gearButton = Instance.new(\"TextButton\")\ngearButton.Name = \"GearShopButton\"\ngearButton.Text = \"Gear Shop\"\ngearButton.Position = UDim2.new(1, -10, 0, 80) \nfor prop, value in pairs(buttonStyle) do\n    gearButton[prop] = value\nend\ngearButton.Parent = buttonGui\n\nlocal seedShopGUI = playerGui:FindFirstChild(\"Seed_Shop\") or Instance.new(\"ScreenGui\")\nseedShopGUI.Name = \"Seed_Shop\"\nseedShopGUI.Enabled = false\nseedShopGUI.Parent = playerGui\n\nlocal gearShopGUI = playerGui:FindFirstChild(\"Gear_Shop\") or Instance.new(\"ScreenGui\")\ngearShopGUI.Name = \"Gear_Shop\"\ngearShopGUI.Enabled = false\ngearShopGUI.Parent = playerGui\n\nseedButton.MouseButton1Click:Connect(function()\n    seedShopGUI.Enabled = not seedShopGUI.Enabled\n    gearShopGUI.Enabled = false \nend)\n\ngearButton.MouseButton1Click:Connect(function()\n    gearShopGUI.Enabled = not gearShopGUI.Enabled\n    seedShopGUI.Enabled = false \nend)","features":"This script creates 2 buttons with 2 shops Seed Shop, Gear shop.","tags":[],"discord":"","keyLink":"","owner":{"_id":"6825d51c91ae140e8f4472ff","username":"floppa_scripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d739c426bee0e6d79b34bfe030865eeefe41cd51f4259ceebc51e7cfce00f75e.webp","original":"https://scriptblox.com/images/photo/6825d51c91ae140e8f4472ff-1747310177794.png"},"status":"offline","id":"6825d51c91ae140e8f4472ff","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/d739c426bee0e6d79b34bfe030865eeefe41cd51f4259ceebc51e7cfce00f75e.webp","original":"https://scriptblox.com/images/photo/6825d51c91ae140e8f4472ff-1747310177794.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w