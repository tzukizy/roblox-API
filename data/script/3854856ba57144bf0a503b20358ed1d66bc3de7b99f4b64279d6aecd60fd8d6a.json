{"slug":"Universal-Script-TSB-custom-movesets-23241","_id":"67476e0d8e86ab9c2f3709ec","title":"TSB custom movesets","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2089118-1732734477917.png","placeId":0},"features":"| this was tested on the delta executor, that’s the only executor I have, sorry if it doesn’t work on your executor! |\n| this was originally made for TSB, but it works universally so that’s why it’s universal |\nAllows custom movesets with 1 to 10 moves!","tags":["Template","TSB Moveset","Universal"],"script":"local weapon = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/softbf395/Utilities/refs/heads/main/TSB/Custom%20Weapon.lua\"))()\n-- remove all moves\nfor _, move in ipairs(game.Players.LocalPlayer.Backpack:GetChildren()) do\n  move:Destroy()\nend\n\n-- Create a move\nlocal Weapon1 = weapon:Create({\n    name = \"Example\";\n    cooldown = 3;\n    action = function()\n        local mouse=game.Players.LocalPlayer:GetMouse()\n        game.Players.LocalPlayer.Character.HumanoidRootPart.Position=mouse.Hit.Position+Vector3.new(0,2,0)\n    end\n})\n\n-- Modify the action later\n--Weapon1:SetCallback(function()\n--    print(\"new use example\")\n--end)","owner":{"_id":"66cf7adf9a3bc395eaefc1ac","username":"Aedan_","verified":false,"profilePicture":"/images/photo/66cf7adf9a3bc395eaefc1ac-1750038172110.jpeg","status":"offline","id":"66cf7adf9a3bc395eaefc1ac","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":22671,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-11-27T19:07:57.986Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/2089118-1732734477917.png","executes":475,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d1f4","editBy":{"_id":"66cf7adf9a3bc395eaefc1ac","username":"Aedan_","status":"offline","id":"66cf7adf9a3bc395eae