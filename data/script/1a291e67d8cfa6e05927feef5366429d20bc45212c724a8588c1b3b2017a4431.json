n\n    print(name .. \" loaded\")\n    func()\n    return true\nend\n\n\nif loadScript(P1_URL, \"P1\") then\n    task.wait(1) \n    loadScript(P2_URL, \"P2\")\nend","features":"This is an executor that uses AI, there might be lots of errors since this is in beta and nowhere near done, if you want to you can use your own API key. And if you can please make my script better","tags":[],"discord":"","keyLink":"","owner":{"_id":"684eb874901cfa8ce81f8313","username":"vaskeviciusg8","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"684eb874901cfa8ce81f8313","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:32:52.412Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a2d54db894dab3b0d2bb3e","editBy":{"_id":"684eb874901cfa8ce81f8313","username":"vaskeviciusg8","status":"offline","id":"684eb874901cfa8ce81f8313"},"message":"Create script","createdAt":"2026-02-28T11:45:17.118Z"}],"comments":[]}