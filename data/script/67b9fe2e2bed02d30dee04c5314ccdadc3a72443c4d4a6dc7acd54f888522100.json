ttonText.Text = \"Rejoin\"\n\nPlayers = game:GetService(\"Players\")\nTeleportService = game:GetService(\"TeleportService\")\n\nrejoin.MouseButton1Up:Connect(function()\n    if #Players:GetPlayers() <= 1 then\n        TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)\n    else\n        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Players.LocalPlayer)\n    end\nend)","features":"Auto execute highly recommended","tags":[],"discord":"","keyLink":"","owner":{"_id":"64d769734d78f894fb0c1951","username":"Icy_HD","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"64d769734d78f894fb0c1951","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:12:23.121Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50276","editBy":{"_id":"64d769734d78f894fb0c1951","username":"Icy_HD","status":"offline","id":"64d769734d78f894fb0c1951"},"message":"Create script","createdAt":"2025-03-27T23:07:49.392Z"}],"comments":[]}