{"slug":"Insane-Elevator-Testing-Destroy-All-Doors-Open-Source-39931","_id":"68273f5ba711bf2ffdb72b1e","title":"Destroy All Doors Open Source","game":{"_id":"67e5e1ffb360710ec3c77dc7","gameId":9120716669,"name":"Insane Elevator Testing","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":9120716669},"features":"Destroy all doors\n\nDoors:\nVIP Door\nPremium Door\nTimer Door2\nTimer Door1","tags":[],"script":"local workspace = game:GetService(\"Workspace\")\n\nlocal possibleDoorNames = {\"VIPDoor\", \"PremiumDoor\", \"Timer2\", \"Timer1\"}\n\nfor _, doorName in ipairs(possibleDoorNames) do\n    local door = workspace:FindFirstChild(doorName, true)\n    if door and door:IsA(\"BasePart\") then\n        door:Destroy()\n    elseif door and door:IsA(\"Model\") then\n        for _, part in ipairs(door:GetDescendants()) do\n            if part:IsA(\"BasePart\") then\n                part:Destroy()\n            end\n        end\n    end\nend","owner":{"_id":"675c8f54766597e0b3725c6e","username":"sjjsksjsnnnsns","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f8a0a43e7dddb929b573a1b08e62e1cdbd038b25b6c55c259454a9bc33e8be11.webp","original":"https://scriptblox.com/images/photo/675c8f54766597e0b3725c6e-1789336336451.png"},"lvl":25,"status":"offline","id":"675c8f54766597e0b3725c6e","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":100},"profile":{"url":"https://media.kocakz.me/f8a0a43e7dddb929b573a1b08e62e1cdbd038b25b6c55c259454a9bc33e8be11.webp","original":"https://scriptblox.com/images/photo/675c8f54766597e0b3725c6e-1789336336451.png"}},"verified":false,"views":8301,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-b81ffdc0117dafc436a18f59db220112-93714c1098fc.png","scriptblox":"https://scriptblox.