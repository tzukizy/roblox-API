{"slug":"Universal-Script-Fling-yourself-made-by-ai-53785","_id":"68cbbca05c976c755877854a","title":"Fling yourself made by ai","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1758182560137.jpg","placeId":0},"features":"Fling yourself","tags":[],"script":"-- StarterPlayerScripts/FlingMobileClean.client.lua\n-- Mobile-friendly fling GUI\n-- Safe: only affects your own character\n\nlocal Players = game:GetService(\"Players\")\nlocal Debris = game:GetService(\"Debris\")\nlocal player = Players.LocalPlayer\n\n-- Settings\nlocal flingForce = 2000 -- strength of the fling\n\n-- Create GUI\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"FlingGUI\"\nscreenGui.ResetOnSpawn = false\nscreenGui.IgnoreGuiInset = true\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 180, 0, 60)\nframe.Position = UDim2.new(0.5, -90, 0.1, 0)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.BackgroundTransparency = 0.15\nframe.BorderSizePixel = 0\nframe.Parent = screenGui\n\nlocal flingBtn = Instance.new(\"TextButton\")\nflingBtn.Size = UDim2.new(1, -12, 1, -12)\nflingBtn.Position = UDim2.new(0, 6, 0, 6)\nflingBtn.Text = \"FLING!\"\nflingBtn.Font = Enum.Font.GothamBold\nflingBtn.TextSize = 22\nflingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)\nflingBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)\nflingBtn.BorderSizePixel = 0\nflingBtn.Parent = frame\n\n-- Fling function\nlocal function flingSelf()\n    local char = player.Character\n    if not char then return end\n    local hrp = char:FindFirstChild(\"HumanoidRootPart\")\n    if not hrp then return end\n\n    -- Create BodyVelocity to fling\n    local bv = Instance.new(\"BodyVelocity\")\n    bv.Velocity = Vector3.new(\n        math.random(-flingForce, flingForce),\n        flingForce,\n        math.random(-flingForce, flingForce)\n    )\n    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)\n    bv.P = 1e5\n    bv.Parent = hrp\n\n    -- Auto-remove after 0.3 seconds\n    Debris:AddItem(bv, 0.3)\nend\n\n-- Button click\nflingBtn.MouseButton1Click:Connect(flingSelf)\n\n-- Optional: auto-hide GUI if needed (e.g., for mobile screen space)","owner":{"_id":"68b3db6c5165138168874340","username":"Asgore","verified":false,"profilePicture":"/images/photo/68b3db6c5165138168874340-1758107474627.jpg","status":"offline","id":"68b3db6c5165138168874340","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2801,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1758182560137.jpg","likeCount":2,"dislikeCount":2,"createdAt":"2025-09-18T08:02:40.150Z","executes":80,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cbbca05c976c755877854c","editBy":{"_id":"68b3db6c5165138168874340","username":"Asgore","status":"offline","id":"68b3db6c5165138168874340"},"message":"Create script","createdAt":"2025-09-18T08:02:40.154Z"}],"comments":[{"_id":"68cbbcacc083861fc33e64a3","commentBy":{"_id":"68b3db6c5165138168874340","username":"Asgore","verified":false,"role":"user","profilePicture":"/images/photo/68b3db6c5165138168874340-1758107474627.jpg","createdAt":"2025-08-31T05:19:40.047Z","lastActive":"2025-10-15T09:58:50.651Z","status":"offline","id":"68b3db6c5165138168874340","topMilestone":{"key":"creator.first_script","tier":1}},"text":"I'm lazy","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-18T08:02:52.541Z","liked":false,"disliked":false},{"_id":"68cbbf64c691f91593016272","commentBy":{"_id":"68c7ee9ac8e36cf888718652","username":"vaxtalastus","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-09-15T10:46:50.188Z","lastActive":"2025-09-30T02:07:50.439Z","status":"offline","id":"68c7ee9ac8e36cf888718652"},"text":"ts so ahh & so useless","edited":false,"likeCount":3,"dislikeCount":1,"createdAt":"2025-