{"slug":"Universal-Script-Lime-Liblary-51569","_id":"68b8759c29ed8f1edb1fc318","title":"Lime Liblary","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1756919196332.jpg","placeId":0},"features":"Credits [ https://v3rmillion.net/member.php?action=profile&uid=1642742 ]\n\n\nRemade by VantaXock \n\nElements \n[+] Button \n[+] Toggle \n[+] Textbox\n[+] Slider ( Mobile/Pc ) Support \n[+] Dropdown","tags":["Lime Liblary","ui lib","Ui lib","Ui liblary","Clean Liblary"],"script":"🍷 -- // Leave a like or Follow \\\\ -- 🍷\n\n\n\n-- load the Liblary \nlocal Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/GCxF-Pjk/For-Gui-Maker-Aux-Hub/refs/heads/main/Main%20Liblary/Lime.lua\"))()\n\n-- create a window\nlocal Main = Library:Window(\"Lime Liblary\")\n\n-- button\nMain:Button(\"Click Me\", function()\n    print(\"Button Clicked!\")\nend)\n\n-- toggle\nMain:Toggle(\"Rizz\", function(state)\n    print(\"Rizzing:\", state)\nend)\n\n-- textbox\nMain:Textbox(\"Enter Name\", \"Type here...\", function(text)\n    print(\"You typed:\", text)\nend)\n\n-- slider\nMain:Slider(\"WalkSpeed\", 10, 100, false, function(value)\n    print(\"WalkSpeed set to:\", value)\nend)\n\n-- dropdown\nMain:Dropdown(\"Choose Tool\", {\"CDK\", \"Soul Guitar\", \"Anchor\"}, function(selected)\n    print(\"You chose:\", selected)\nend)","owner":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","verified":false,"profilePicture":"/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg","status":"offline","id":"6870b2fb95671adabe1b7905","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":1236,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1756919196332.jpg","likeCount":3,"dislikeCount":2,"createdAt":"2025-09-03T17:06:36.349Z","executes":30,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b8759c29ed8f