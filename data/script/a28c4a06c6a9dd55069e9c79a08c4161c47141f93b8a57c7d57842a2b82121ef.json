{"slug":"Universal-Script-Tool-counter-22305","_id":"6736a2b1e8ab38005358a7f4","title":"Tool counter","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/6366312-1731633841415.png","placeId":0},"features":"Got this off a bot from a exploit server from discord and it only counts tools","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal LocalPlayer = Players.LocalPlayer\n\n-- Function to count tools and send a notification\nlocal function notifyToolCount()\n    local toolCount = 0\n\n    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do\n        if item:IsA(\"Tool\") then\n            toolCount = toolCount + 1\n        end\n    end\n\n    StarterGui:SetCore(\"SendNotification\", {\n        Title = \"Tool Count Update\",\n        Text = \"You have \" .. toolCount .. \" tools in your backpack.\",\n        Duration = 5\n    })\nend\n\n-- Notify the tool count when the script is executed\nnotifyToolCount()","owner":{"_id":"66f595e1b8cda3cd466055ab","username":"cheesedudecheese5","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66f595e1b8cda3cd466055ab","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":15081,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-11-15T01:24:01.464Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/6366312-1731633841415.png","executes":41,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52fe4","editBy":{"_id":"66f595e1b8cda3cd466055ab","username":"cheesedudecheese5","status":"offline","id":"66f595e1b8cda3cd466055ab"},"message":"Create script","createdAt":"2025-03-27T15:05:19.208Z"}],"comments":[{"_id":"6737485c72d3c7e3391451d6","commentBy":{"_id":"670e01095e092a4dd19b6ea3","username":"NDLgen","verified":false,"rol