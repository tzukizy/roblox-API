 have \" .. toolCount .. \" tools in your backpack.\",\n        Duration = 5\n    })\nend\n\n-- Notify the tool count when the script is executed\nnotifyToolCount()","features":"Got this off a bot from a exploit server from discord and it only counts tools","tags":[],"discord":"","keyLink":"","owner":{"_id":"66f595e1b8cda3cd466055ab","username":"cheesedudecheese5","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66f595e1b8cda3cd466055ab","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:08:38.017Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52fe4","editBy":{"_id":"66f595e1b8cda3cd466055ab","username":"cheesedudecheese5","status":"offline","id":"66f595e1b8cda3cd466055ab"},"message":"Create script","createdAt":"2025-03-27T15:05:19.208Z"}],"comments":[{"_id":"6737485c72d3c7e3391451d6","commentBy":{"_id":"670e01095e092a4dd19b6ea3","username":"NDLgen","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-10-15T05:43:37.042Z","lastActive":"2026-05-16T09:08:19.571Z","status":"offline","id":"670e01095e092a4dd19b6ea3","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"frieza","createdAt":"2024-11-15T13:10:52.836Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"673851ef4f3380b7feeda81e","commentBy":{"_id":"66f595e1b8cda3cd466055ab","username":"cheesedudecheese5","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt"