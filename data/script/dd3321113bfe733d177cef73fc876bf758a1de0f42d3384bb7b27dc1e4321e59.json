{"_id":"6945877a993d764372cfd7a3","title":"roll script (reupload)","game":{"_id":"68966c2c1db541b05096cd52","gameId":14113053169,"name":"Free Client Script Executor *BACK*","imageUrl":{"url":"https://media.kocakz.me/ee9cd5d22b0130fa183d984f3a68f029e9df5ef4596e46f028c9123c6bbc73a8.webp","original":"https://scriptblox.com/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png"},"slug":"14113053169-free-client-script-executor-back","path":"/game/14113053169-free-client-script-executor-back","thumbnail":{"url":"https://media.kocakz.me/ee9cd5d22b0130fa183d984f3a68f029e9df5ef4596e46f028c9123c6bbc73a8.webp","original":"https://scriptblox.com/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png"},"placeId":14113053169},"slug":"Free-Client-Script-Executor-*BACK*-roll-script-76184","verified":false,"key":false,"keyless":false,"views":380,"executes":112,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d98437442572151102.webp","original":"https://scriptblox.com/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","scriptblox":"https://scriptblox.com/images/script/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png"},"thumbnail":{"url":"https://media.kocakz.me/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d98437442572151102.webp","original":"https://scriptblox.com/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","scriptblox":"https://scriptblox.com/images/script/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-19T17:12:26.723Z","updatedAt":"2025-12-19T17:12:26.723Z","lastBump":"2025-12-19T17:12:26.723Z","script":"local rollspeed = 8 --Change this to control speed of rolling\nlocal rs = game:GetService(\"RunService\")\nlocal event\nlocal char = game.Players.LocalPlayer.Character\nlocal hum = char.Humanoid\nlocal hrp = char.HumanoidRootPart\nhum.PlatformStand = true\nlocal bav = Instance.new(\"BodyAngularVelocity\", hrp)\nbav.MaxTorque = Vector3.new(1/0,1/0,1/0)\nevent = rs.Heartbeat:Connect(function()\n    if hum.MoveDirection.Magnitude > 0 then\n        local rollaxis = hum.MoveDirection:Cross(Vector3.yAxis)\n        bav.AngularVelocity = rollaxis.Unit * -rollspeed\n    else\n        bav.AngularVelocity = Vector3.zero\n    end\nend)\nlocal chatevent\nchatevent = game.TextChatService.SendingMessage:Connect(function(msg)\n    if msg.Text == \";unroll\" then\n        hum.PlatformStand = false\n        chatevent:Disconnect()\n        chatevent = nil\n        event:Disconnect()\n        event = nil\n        bav:Destroy()\n    end\nend)","features":"funny script that makes you roll like an egg\nsay ;unroll to stop rolling","tags":["FE","Roll","Egg","Ball","Funny script"],"discord":"","keyLink":"","owner":{"_id":"69237472df5c9c28cb000392","username":"Automated_Account","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8a5ddbd218e23b4214ea5686aa7d6bd8b3710b5a051962059566810ddb5a1e0f.webp","original":"https://scriptblox.com/images/photo/69237472df5c9c28cb000392-1763931573809.jpeg"},"status":"offline","id":"69237472df5c9c28cb000392","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/8a5ddbd218e23b4214ea5686aa7d6bd8b3710b5a051962059566810ddb5a1e0f.webp","original":"https://scriptblox.com/images/photo/69237472df5c9c28cb000392-1763931573809.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:26:17.490Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6945877a993d764372cfd7a5","editBy":{"_id":"69237472df5c9c28cb000392","username":"Automated_Account","status":"offline","id":"69237472df5c9c28cb000392"},"message":"Create script","createdAt":"2025-12-19T17:12:26.727