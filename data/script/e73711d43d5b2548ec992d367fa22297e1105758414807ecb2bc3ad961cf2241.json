{"_id":"68569d216160c66656df7ceb","title":"erlc esp script tho","game":{"_id":"67e5e1ffb360710ec3c77d6d","gameId":2534724415,"name":"[🗺️] Emergency Response: Liberty County","imageUrl":{"url":"https://media.kocakz.me/dbeb903abaf3a48674eff6b2825e7a8104cf5da47f35a4da567f5470360eb15d.webp","original":"https://tr.rbxcdn.com/180DAY-9b8420e17d4aab446e2c1410a2054c1b/150/150/Image/Png/noFilter"},"slug":"2534724415-emergency-response-liberty-county","path":"/game/2534724415-emergency-response-liberty-county","thumbnail":{"url":"https://media.kocakz.me/dbeb903abaf3a48674eff6b2825e7a8104cf5da47f35a4da567f5470360eb15d.webp","original":"https://tr.rbxcdn.com/180DAY-9b8420e17d4aab446e2c1410a2054c1b/150/150/Image/Png/noFilter"},"placeId":2534724415},"slug":"Emergency-Response:-Liberty-County-erlc-esp-script-tho-42981","verified":false,"key":false,"keyless":false,"views":6185,"executes":162,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/a42c301d9f1b1d39dd224d924070e88a2ebd8979b8e41d4aebf9f9faab7c5bfd.webp","original":"https://scriptblox.com/images/sb/2534724415-1750506785567.jpg","scriptblox":"https://scriptblox.com/images/script/2534724415-1750506785567.jpg"},"thumbnail":{"url":"https://media.kocakz.me/a42c301d9f1b1d39dd224d924070e88a2ebd8979b8e41d4aebf9f9faab7c5bfd.webp","original":"https://scriptblox.com/images/sb/2534724415-1750506785567.jpg","scriptblox":"https://scriptblox.com/images/script/2534724415-1750506785567.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-06-21T11:53:05.605Z","updatedAt":"2025-06-21T11:53:05.605Z","lastBump":"2025-06-21T11:53:05.605Z","script":"-- ERLC Full-Map ESP with Wanted Level Display\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Camera = workspace.CurrentCamera\nlocal LocalPlayer = Players.LocalPlayer\n\n-- Clean old ESPs\nlocal function clearESP()\n\tif game.CoreGui:FindFirstChild(\"PlayerESP\") then\n\t\tgame.CoreGui.PlayerESP:Destroy()\n\tend\nend\n\n-- Create Billboard GUI for a player\nlocal function createESP(player)\n\tif not player.Character or not player.Character:FindFirstChild(\"Head\") then return end\n\n\tlocal head = player.Character:WaitForChild(\"Head\", 1)\n\tif not head then return end\n\n\tlocal espFolder = game.CoreGui:FindFirstChild(\"PlayerESP\") or Instance.new(\"Folder\", game.CoreGui)\n\tespFolder.Name = \"PlayerESP\"\n\n\tlocal billboard = Instance.new(\"BillboardGui\", espFolder)\n\tbillboard.Name = player.Name .. \"_ESP\"\n\tbillboard.Adornee = head\n\tbillboard.Size = UDim2.new(0, 120, 0, 30)\n\tbillboard.StudsOffset = Vector3.new(0, 2.5, 0)\n\tbillboard.AlwaysOnTop = true\n\n\tlocal label = Instance.new(\"TextLabel\", billboard)\n\tlabel.Size = UDim2.new(1, 0, 1, 0)\n\tlabel.BackgroundTransparency = 1\n\tlabel.TextStrokeTransparency = 0.4\n\tlabel.TextStrokeColor3 = Color3.new(0, 0, 0)\n\tlabel.Font = Enum.Font.SourceSansBold\n\tlabel.TextScaled = true\n\tlabel.TextColor3 = Color3.fromRGB(255, 255, 255)\n\n\t-- Attempt to find wanted level (you might need to adjust the path)\n\tlocal wantedLevel = \"?\"\n\tpcall(function()\n\t\tlocal stats = player:FindFirstChild(\"leaderstats\")\n\t\tif stats and stats:FindFirstChild(\"Wanted\") then\n\t\t\twantedLevel = tostring(stats.Wanted.Value)\n\t\telseif player:FindFirstChild(\"WantedLevel\") then\n\t\t\twantedLevel = tostring(player.WantedLevel.Value)\n\t\tend\n\tend)\n\n\tlabel.Text = string.format(\"%s (@%s)\\nWanted: %s\", player.DisplayName, player.Name, wantedLevel)\nend\n\n-- Main ESP updater\nlocal function updateESP()\n\tclearESP()\n\tfor _, player in pairs(Players:GetPlayers()) do\n\t\tif player ~= LocalPlayer then\n\t\t\tpcall(function()\n\t\t\t\tcreateESP(player)\n\t\t\tend)\n\t\tend\n\tend\nend\n\n-- Loop refresh\nwhile true do\n\tupdateESP()\n\twait(3)\nend\n","features":"a simple esp","tags":[],"discord":"","keyLink":"","owner":{"_id":"6768112ddafe1aa99d04ac11","