Child(\"BodyDepthScale\"):Destroy()\nwait(1)\n\nrm()\nwait(0.5)\nHumanoid:FindFirstChild(\"HeadScale\"):Destroy()\nwait(1)","owner":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0bf7bf98c2dcf1f56c46d6a749a59e3d53521ec40b5e69cb6141fd2028c7e78a.webp","original":"https://scriptblox.com/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png"},"status":"offline","id":"629dfc67ee6d3da00eafbd2e","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/0bf7bf98c2dcf1f56c46d6a749a59e3d53521ec40b5e69cb6141fd2028c7e78a.webp","original":"https://scriptblox.com/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png"}},"verified":false,"views":8723,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-10-08T13:50:12.429Z","dislikeCount":1,"likeCount":3,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/3412042-1665237012392.jpg","scriptblox":"https://scriptblox.com/images/script/3412042-1665237012392.jpg"},"executes":140,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T05:06:44.162Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/3412042-1665237012392.jpg","scriptblox":"https://scriptblox.com/images/script/3412042-1665237012392.jpg"},"changelog":[{"_id":"67e5e1e4b360710ec3c4f5af","editBy":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","status":"offline","id":"629dfc67ee6d3da00eafbd2e"},"message":"Create script","createdAt":"2025-03-27T11:37:16.917Z"}],"comments":[{"_id":"6341825d549755f6b9d5634b","commentBy":{"_id":"632748f90526459cec03a910","username":"band","verified":true,"role":"user","profilePicture":{"url":"https