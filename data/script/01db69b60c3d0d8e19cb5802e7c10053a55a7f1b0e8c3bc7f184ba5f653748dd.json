{"_id":"69a30a303b276d0eb7a43f62","title":"ZONE AND STYLE ESP KEYLESS","game":{"_id":"67e5e1ffb360710ec3c77d9f","gameId":130739873848552,"name":"[⚙️QOL✨] Basketball: Zero","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"130739873848552-basketball-zero","path":"/game/130739873848552-basketball-zero","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":130739873848552},"slug":"UPD-Basketball:-Zero-ZONE-AND-STYLE-ESP-KEYLESS-125807","verified":false,"key":false,"keyless":false,"views":2489,"executes":3631,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/3e2b52709e86a2f6760c2f966bb8a30892c1988c5b028bf0224b56d5a57893ca.webp","original":"https://scriptblox.com/images/sb/130739873848552-1772292656503.png","scriptblox":"https://scriptblox.com/images/script/130739873848552-1772292656503.png"},"thumbnail":{"url":"https://media.kocakz.me/3e2b52709e86a2f6760c2f966bb8a30892c1988c5b028bf0224b56d5a57893ca.webp","original":"https://scriptblox.com/images/sb/130739873848552-1772292656503.png","scriptblox":"https://scriptblox.com/images/script/130739873848552-1772292656503.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-28T15:30:56.527Z","updatedAt":"2026-02-28T15:30:56.527Z","lastBump":"2026-02-28T15:30:56.527Z","script":"-- made by me and gemini AI\n\nlocal Players = game:GetService(\"Players\")\n\nlocal function createEsp(player, character)\n\tlocal head = character:WaitForChild(\"Head\", 10)\n\tlocal styleTag = player:WaitForChild(\"Style\", 10)\n\tlocal zoneTag = player:WaitForChild(\"Zone\", 10)\n\t\n\tif not head or not styleTag or not zoneTag then return end\n\t\n\tlocal oldEsp = head:FindFirstChild(\"ESP\")\n\tif oldEsp then oldEsp:Destroy() end\n\n\tlocal billboard = Instance.new(\"BillboardGui\")\n\tbillboard.Name = \"ESP\"\n\n\tbillboard.Size = UDim2.new(4, 0, 1.5, 0) \n\tbillboard.StudsOffset = Vector3.new(0, 3.5, 0)\n\tbillboard.AlwaysOnTop = true\n\tbillboard.Parent = head\n\n\tlocal container = Instance.new(\"Frame\")\n\tcontainer.Size = UDim2.new(1, 0, 1, 0)\n\tcontainer.BackgroundTransparency = 1\n\tcontainer.Parent = billboard\n\n\tlocal layout = Instance.new(\"UIListLayout\")\n\tlayout.SortOrder = Enum.SortOrder.LayoutOrder\n\tlayout.HorizontalAlignment = Enum.HorizontalAlignment.Center\n\tlayout.VerticalAlignment = Enum.VerticalAlignment.Bottom\n\tlayout.Parent = container\n\n\tlocal function createLabel(val, prefix, order, color)\n\t\tlocal label = Instance.new(\"TextLabel\")\n\t\tlabel.Size = UDim2.new(1, 0, 0.45, 0)\n\t\tlabel.BackgroundTransparency = 1\n\t\tlabel.Text = prefix .. \": \" .. tostring(val.Value)\n\t\tlabel.TextColor3 = color\n\t\tlabel.TextStrokeTransparency = 0\n\t\tlabel.TextScaled = true\n\t\tlabel.LayoutOrder = order\n\t\tlabel.Parent = container\n\t\t\n\t\tval.Changed:Connect(function(newVal)\n\t\t\tif label and label.Parent then\n\t\t\t\tlabel.Text = prefix .. \": \" .. tostring(newVal)\n\t\t\tend\n\t\tend)\n\tend\n\n\tcreateLabel(zoneTag, \"Zone\", 1, Color3.new(0.4, 0.8, 1))\n\tcreateLabel(styleTag, \"Style\", 2, Color3.new(1, 1, 1))\nend\n\nlocal function setupPlayer(player)\n\tplayer.CharacterAdded:Connect(function(character)\n\t\tcreateEsp(player, character)\n\tend)\n\tif player.Character then\n\t\tcreateEsp(player, player.Character)\n\tend\nend\n\nPlayers.PlayerAdded:Connect(setupPlayer)\nfor _, player in ipairs(Players:GetPlayers()) do\n\tsetupPlayer(player)\nend\n","features":"Makes zone and style esp","tags":["basketball","zero","basketballzero","esp","cool"],"discord":"","keyLink":"","owner":{"_id":"68f39e45fbb684a06f3e9229","username":"EGORK*SS","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68f39e45fbb684a06f3e9229","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"