{"_id":"6ad63e8e69b2ac3d6a0658b7","title":"Ultimate Fling Stabilizer & Anti-Void & antifling","game":{"_id":"67e5e1ffb360710ec3c77dd3","gameId":189707,"name":"Natural Disaster Survival","imageUrl":{"url":"https://media.kocakz.me/ab0cea4ba1d32b19fe6f00cc0b6c155b74bcba1d139d63e62626cce3b4e6290b.webp","original":"https://tr.rbxcdn.com/180DAY-ac1c764a99cfae201fd4fe916170a218/150/150/Image/Png/noFilter"},"slug":"189707-natural-disaster-survival","path":"/game/189707-natural-disaster-survival","thumbnail":{"url":"https://media.kocakz.me/ab0cea4ba1d32b19fe6f00cc0b6c155b74bcba1d139d63e62626cce3b4e6290b.webp","original":"https://tr.rbxcdn.com/180DAY-ac1c764a99cfae201fd4fe916170a218/150/150/Image/Png/noFilter"},"placeId":189707},"slug":"Natural-Disaster-Survival-Ultimate-Fling-Stabilizer-and-Anti-Void-and-antifling-232585","verified":false,"key":false,"keyless":false,"views":1072,"executes":2465,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/32f3bf682d58eeb4dd85b6f002cdceadf8093a65dfdaa023a120e874cc2271e6.webp","original":"https://scriptblox.com/images/sb/189707-1792425614728.png","scriptblox":"https://scriptblox.com/images/script/189707-1792425614728.png"},"thumbnail":{"url":"https://media.kocakz.me/32f3bf682d58eeb4dd85b6f002cdceadf8093a65dfdaa023a120e874cc2271e6.webp","original":"https://scriptblox.com/images/sb/189707-1792425614728.png","scriptblox":"https://scriptblox.com/images/script/189707-1792425614728.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-10-19T16:00:14.946Z","updatedAt":"2026-10-19T16:00:14.946Z","lastBump":"2026-10-19T16:00:14.946Z","script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/timur725l/AntiFling/refs/heads/main/AntiFling.lua\"))()","features":"Description:\nThe ultimate background stabilizer for trolling! Perfectly matches with Infinite Yield's ;spin 999999..., ;fling, and ;antifling commands.\nWhen you use IY fling/spin commands and hit unanchored cars or walls, Roblox physics usually breaks and teleports you to billion coordinates. This script completely fixes that bug!\nFeatures:\n• Anti-Void & Anti-Teleport: Instantly catches you and teleports back to safety if physics breaks.\n• Perfect for Car Flinging: Kick unanchored vehicles across the map without glitching out.\n• Smart Noclip: Prevents you from exploding when hitting static walls.\n• Loop Respawn: Auto-reloads and works every single round after you die.\nJust execute this script, then turn on your favorite Infinity Yield fling commands and enjoy!","tags":["antifling","fling","troll"],"discord":"","keyLink":"","owner":{"_id":"68b0162d8843cab44aeec199","username":"Bulba_scr1pts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ace63e4f2b1b33aa54e15a45a5e14996fc0b263eb51a0d665c50e09dc11e4b5f.webp","original":"https://scriptblox.com/images/photo/68b0162d8843cab44aeec199-1791054038401.jpg"},"lvl":6,"status":"offline","id":"68b0162d8843cab44aeec199","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/ace63e4f2b1b33aa54e15a45a5e14996fc0b263eb51a0d665c50e09dc11e4b5f.webp","original":"https://scriptblox.com/images/photo/68b0162d8843cab44aeec199-1791054038401.jpg"}},"reviewed":{"name":"QueueHero","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-20T13:37:54.958Z","profile":"/u/QueueHero"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-22T21:40:44.017Z","last":"b","win":14,"math":4,"why":{"er":1}},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ad63e8e69b2ac3d6a0658b9","editBy":{"_id":"68b0162d8843cab44aeec199","username":"Bulba_scr1pts","status":"offline","id":"68b0162d8843cab44aeec199"},"message":"Create script","createdAt":"2026-10-19T16:00:14.951Z"}],"comments":[]}