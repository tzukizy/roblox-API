   if not value:IsDescendantOf(ReplicatedStorage) then\n            hookRemote(value)\n            local Old -- dont really need this hook but it does disable basic ac in this ac\n            Old = hookfunction(getrenv().coroutine.wrap, function(...)\n                if not checkcaller() then\n                    print(...,getfenv(2).script)\n                   return task.wait(9e9)\n                end\n                return Old(...)\n            end)\n        end\n        return\n    end\n    if typeof(value) == \"function\" then\n        local upvalues = getupvalues(value)\n        for i, v in pairs(upvalues) do\n            deepScan(v)\n        end\n    end\n    if typeof(value) == \"table\" then\n        for k, v in pairs(value) do\n            deepScan(v)\n        end\n    end\nend\n-- ac function has constant for remote and its not parent of replicatedstorage but rather all other\nfor _, obj in next, getgc(true) do\n    if typeof(obj) == \"function\" and islclosure(obj) and not isexecutorclosure(obj) then\n        deepScan(obj)\n    end\nend","owner":{"_id":"68013a50c1f5601b5f1f4a3f","username":"Vensix","verified":false,"profilePicture":"/images/photo/68013a50c1f5601b5f1f4a3f-1750470617272.png","status":"offline","id":"68013a50c1f5601b5f1f4a3f","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":65899,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/rbx-adec526a1c293827ff28ea63dc91dc83-4a71639689a0.png","likeCount":3,"dislikeCount":1,"createdAt":"2025-06-19T04:25:03.985Z","editBy":{"_id":"68013a50c1f5601b5f1f4a3f","username":"Vensix","status":"offline","id":"68013a50c1f5601b5f1f4a3f"},"executes":85,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6853911f719793e8f095bc63","editBy":{"_id":"68013a50c1f5601b5f1f4a3f","username":"Vensix","status":"offline","id":"68013a50c1f5601b5f1f4a3f"},"message":"Create script","createdAt":"2025-06-19