Prompt\")\n        if proximityPrompt then\n            return v, proximityPrompt\n        end\n    end\n    return nil, nil\nend\nwhile true do\n    local v, p = fuck()\n    if not p then\n        break  \n    end  \n    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame\n    task.wait(0.1)  \n    hk(Enum.KeyCode.E, p.HoldDuration)  \n    task.wait(5)\nend\n","features":"Teleports to every hidden treasure and collects\nworks on solara","tags":[],"discord":"","keyLink":"","owner":{"_id":"61ec61941a813c8d1efb8746","username":"Killa","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2d2f573b339d214ad150dc58604c101220067d6527828f2f661c49cd3f62e5d1.webp","original":"https://scriptblox.com/images/photo/61ec61941a813c8d1efb8746-1692567022287.jpg"},"lvl":12,"status":"offline","id":"61ec61941a813c8d1efb8746","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/2d2f573b339d214ad150dc58604c101220067d6527828f2f661c49cd3f62e5d1.webp","original":"https://scriptblox.com/images/photo/61ec61941a813c8d1efb8746-1692567022287.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:09:31.031Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50ddc","editBy":{"_id":"61ec61941a813c8d1efb8746","username":"Killa","status":"offline","id":"61ec61941a813c8d1efb8746"},"message":"Create script","createdAt":"2025-03-27T20:43:24.613Z"}],"comments":[{"_id":"664f8cc4b5cf3ffe35d1a300","commentBy":{"_id":"66460336062c67df42392f03","username":"1o4q","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/ff2f487f0859e7393ea2d076adaf8390556e9d65e84f99d96d367ed06f442353.webp","original":"https://scriptblox.com/images/photo/66460336062c67df42392f03-1792271655175.png"},"createdAt":"2024-05-16T12:59:34.89