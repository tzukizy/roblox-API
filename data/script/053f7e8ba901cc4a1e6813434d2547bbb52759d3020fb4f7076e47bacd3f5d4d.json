{"slug":"The-Classic-Complete-Hidden-treasure-quest-13299","_id":"664f8c63530995ca5fc3aa2c","title":"Complete Hidden treasure quest","game":{"_id":"67e5e1ffb360710ec3c77e20","gameId":17427651911,"name":"The Classic","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":17427651911},"features":"Teleports to every hidden treasure and collects\nworks on solara","tags":[],"script":"local vim = game:GetService('VirtualInputManager')\nlocal function hk(key, time)\n    vim:SendKeyEvent(true, key, false, nil)\n    task.wait(time)\n    vim:SendKeyEvent(false, key, false, nil)\nend\nlocal function fuck()\n    for _, v in pairs(game.Workspace.QuestRewards.BuriedTreasure:GetChildren()) do\n        local proximityPrompt = v:FindFirstChildOfClass(\"ProximityPrompt\")\n        if proximityPrompt then\n            return v, proximityPrompt\n        end\n    end\n    return nil, nil\nend\nwhile true do\n    local v, p = fuck()\n    if not p then\n        break  \n    end  \n    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame\n    task.wait(0.1)  \n    hk(Enum.KeyCode.E, p.HoldDuration)  \n    task.wait(5)\nend\n","owner":{"_id":"61ec61941a813c8d1efb8746","username":"Killa","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/2d2f573b339d214ad150dc58604c101220067d6527828f2f661c49cd3f62e5d1.webp","original":"https://scriptblox.com/images/photo/61ec61941a813c8d1efb8746-1692567022287.jpg"},"lvl":12,"status":"offline","id":"61ec61941a813c8d1efb8746","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/2d2f573b339d214ad150dc58604c101220067d6527828f2f661c49cd3f62e5d1.webp","original":"https://scriptblox.com/images/photo/61ec61941a813c8d1efb8746-1692567022287.jpg"}},"verified":false,"keyLink":"","views":17674,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","cre