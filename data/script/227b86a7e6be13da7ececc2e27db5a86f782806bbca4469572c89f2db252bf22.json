{"_id":"62694b1f187013b579f2a167","title":"Orbit Players Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Orbit-Players-Script-2279","verified":false,"key":false,"keyless":false,"views":34013,"executes":126,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/6104255-1651067679523.jpg","scriptblox":"https://scriptblox.com/images/script/6104255-1651067679523.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/6104255-1651067679523.jpg","scriptblox":"https://scriptblox.com/images/script/6104255-1651067679523.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2022-04-27T13:54:39.540Z","updatedAt":"2022-04-27T13:54:39.540Z","lastBump":"2022-04-27T13:54:39.540Z","script":"---by lopsidedAD    dwayne_johnson#8095\n\nlocal player = game.Players.ENTERPLAYERNAMEHERE.Character.HumanoidRootPart --- enter players name there (do it)\nlocal lpr = game.Players.LocalPlayer.Character.HumanoidRootPart\n\n\nlocal speed = 8 \nlocal radius = 8 --- orbit size\nlocal eclipse = 1 --- width of orbit\nlocal rotation = CFrame.Angles(0,0,0) --only works for unanchored parts (not localplayer)\n\n\nlocal sin, cos = math.sin, math.cos\nlocal rotspeed = math.pi*2/speed\neclipse = eclipse * radius\nlocal runservice = game:GetService('RunService')\n\n\nlocal rot = 0\ngame:GetService('RunService').Stepped:connect(function(t, dt)\nrot = rot + dt * rotspeed\nlpr.CFrame = rotation * CFrame.new(sin(rot)*eclipse, 0, cos(rot)*radius) + player.Position\nend)\n","features":"-Can set speed of orbit\n-Can set radius of orbit (orbit size)\n-Can set eclipse of orbit (orbit width)","tags":["FE","roblox","orbit","universal","cool"],"discord":"","keyLink":"","owner":{"_id":"61da5ed87bad299048d1139c","username":"lopsidedA","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61da5ed87bad299048d1139c-1641701772204.jpg"},"status":"offline","id":"61da5ed87bad299048d1139c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61da5ed87bad299048d1139c-1641701772204.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:13:49.543Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f147","editBy":{"_id":"61da5ed87bad299048d1139c","username":"lopsidedA","status":"offline","id":"61da5ed87bad299048d1139c"},"message":"Create script","createdAt":"2025-03-27T23:08:54.404Z"}],"comments":[]}