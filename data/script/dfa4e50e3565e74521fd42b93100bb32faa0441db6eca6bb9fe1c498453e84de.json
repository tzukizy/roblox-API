{"slug":"MotoRush!-Motorush-pumpkin-auto-collect-60558","_id":"68fc12de719d7c51fb8c477e","title":"Motorush pumpkin auto collect","game":{"_id":"67e5e1ffb360710ec3c781e2","gameId":14055498520,"name":"MotoRush! 🏍️","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14055498520},"features":"Auto collector\nHow to use:\nJust execute it, when a new pumpkin spawns it will auto collect it. This won't get you the max pumpkins in a minute, run it and go afk for a couple hours.","tags":["motorush"],"script":"local _USE_KEYPRESS = false\nlocal _USE_FIREPROXIMITYPROMPT = true\n\nlocal _GRAB_DELAY = 0.5 -- DO NOT SET TO 0, LEADS TO EXPLOIT PREVENTION KICK\n\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal pumpkins = workspace:WaitForChild(\"Pumpkins\")\nprint(\"Rejoin the game to play normally again.\")\n\nfor _, spawnpart in pairs(pumpkins:GetChildren()) do\n    spawnpart.ChildAdded:Connect(function(newChild)\n        local sp = spawnpart.Position\n        print(\"New pumpkin detected!\")\n\n        character = player.Character or player.CharacterAdded:Wait()\n        hrp = character:FindFirstChild(\"HumanoidRootPart\")\n        if not hrp then return end\n\n        hrp.Anchored = false\n        hrp.CFrame = CFrame.new(sp.X, sp.Y + 2, sp.Z)\n        task.wait(_GRAB_DELAY)\n\n        if _USE_FIREPROXIMITYPROMPT then\n            if not fireproximityprompt then\n                warn(\"Your executor doesn’t support fireproximityprompt!\")\n                return\n            end\n            for _, v in pairs(spawnpart:GetDescendants()) do\n                if v:IsA(\"ProximityPrompt\") then\n                    fireproximityprompt(v)\n                    break\n                end\n            end\n        end\n\n        if _USE_KEYPRESS then\n            keypress(0x45)\n            task.wait(0.1)\n            keyrelease(0x45)\n        end\n    end)\nend\n\nprint(\"Pumpkin auto collector ready!\")","owner":{"_id":"680c114dd4e07b87e24113d9","username":"jwarden966","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"680c114dd4e07b87e24113d9","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":1679,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-e816628dc17ff02fdaed28c5c3356f4d-efe411daaa4b.png","scriptblox":"https://scriptblox.com/images/script/rbx-e816628dc17ff02fdaed28c5c3356f4d-efe411daaa4b.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-10-24T23:59:26.171Z","executes":119,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:50:42.623Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-e816628dc17ff02fdaed28c5c3356f4d-efe411daaa4b.png","scriptblox":"https://scriptblox.com/images/script/rbx-e816628dc17ff02fdaed28c5c3356f4d-efe411daaa4b.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68fc12de719d7c51fb8c4780","editBy":{"_id":"680c114dd4e07b87e24113d9","username":"jwarden966","status":"offline","id":"680c114dd4e07b87e24113d9"},"message":"Create script","createdAt":"2025-10-24T23:59:26.174Z"}],"comments":[{"_id":"68fc483502f10976b219ae27","commentBy":{"_id":"667bdfcad55dbd036e19d6db","username":"Mi*ikuCream","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/fb9ed970b54b6c43175b800fd39f3f5a28e8d54f4c5436478f1a58e876ee2