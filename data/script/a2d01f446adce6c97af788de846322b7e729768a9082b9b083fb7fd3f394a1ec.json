{"slug":"RoVille-CHRISTMAS!-Taxi-Auto-Farm-1320","_id":"6232cceacb1c178dfe2122d3","title":"Taxi Auto Farm","game":{"_id":"67e5e1ffb360710ec3c78189","gameId":2546155523,"name":"[UPD!] RoVille 🏘️","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":2546155523},"features":"get into a taxi and execute this script\n\n[Originally not made by me  https://v3rmillion.net/showthread.php?tid=1161570 Original post]","tags":["Roville","Taxi","Auto Farm"],"script":"while wait(.75) do\n   local myTaxi = nil\n   \n   for i,v in pairs(game:GetService(\"Workspace\").Taxis:GetDescendants()) do\n    if v.Name == \"DriveSeat\" then\n    if v:FindFirstChild(\"SeatWeld\") then\n    if v.SeatWeld.Part1.Parent.Name == game.Players.LocalPlayer.Name then\n    myTaxi = v.Parent.Parent\n    print(\"Found Taxi\")\n    end\n    end\n    end\n   end\n   \n   if myTaxi.Taxi.TaxiTarget.Value ~= Vector3.new(0, 0, 0) then\n    myTaxi.Taxi:SetPrimaryPartCFrame(CFrame.new(myTaxi.Taxi.TaxiTarget.Value))\n   else\n    myTaxi.Taxi:SetPrimaryPartCFrame(CFrame.new(myTaxi.Taxi.TaxiRider.Pos.Value))\n   end\nend\n-- originally made by IsaaaKK o","owner":{"_id":"61a926c98b4e467adb2353df","username":"BadChuKun","verified":true,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61a926c98b4e467adb2353df-1658855424993.gif"},"status":"offline","id":"61a926c98b4e467adb2353df","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61a926c98b4e467adb2353df-1658855424993.gif"}},"verified":true,"views":21498,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-03-17T05:53:46.314Z","dislikeCount":0,"likeCount":4,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/371a8b609e