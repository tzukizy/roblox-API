:GetPlayers()) do\n            if p ~= player then table.insert(others, p) end\n        end\n        if #others > 0 then\n            local target = others[math.random(1, #others)]\n            if target.Character and target.Character:FindFirstChild(\"HumanoidRootPart\") then\n                local pos = target.Character.HumanoidRootPart.Position\n                Camera.CameraType = Enum.CameraType.Scriptable\n                Camera.CFrame = CFrame.new(pos + Vector3.new(0, 5, 10), pos)\n                print(\"Locked on \" .. target.Name)\n            end\n        end\n    end\nend)\n\nplayer.CharacterAdded:Connect(function() Camera.CameraType = Enum.CameraType.Custom end)\nPlayers.PlayerRemoving:Connect(function(p) if p == player then Camera.CameraType = Enum.CameraType.Custom end end)\n]])\n","features":"Locks on player","tags":[],"discord":"","keyLink":"","owner":{"_id":"66fa01bc9e34c1c672e4901a","username":"uvaldocoronell","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8bcb544c2708304d3a759c4b9cdea5839d9859096497775aedf4359b4c8d3407.webp","original":"https://scriptblox.com/images/photo/66fa01bc9e34c1c672e4901a-1728270525478.png"},"status":"offline","id":"66fa01bc9e34c1c672e4901a","profile":{"url":"https://media.kocakz.me/8bcb544c2708304d3a759c4b9cdea5839d9859096497775aedf4359b4c8d3407.webp","original":"https://scriptblox.com/images/photo/66fa01bc9e34c1c672e4901a-1728270525478.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:13:51.150Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c5265b","editBy":{"_id":"66fa01bc9e34c1c672e4901a","username":"uvaldocoronell","status":"offline","id":"66fa01bc9e34c1c672e4901a"},"message":"Create script","createdAt":"2025-03-27T18:03:02.037Z"}],"comments":[{"_id":"670492a221d3873c6923994a","commentBy":