{"slug":"Universal-Script-Simple-Noclip-Script-236162","_id":"6a2d869ea35cdbeeeafb9015","title":"Simple Noclip Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Simple Noclip","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function setNoclip(enabled)\n    local character = player.Character or player.CharacterAdded:Wait()\n\n    for _, part in ipairs(character:GetDescendants()) do\n        if part:IsA(\"BasePart\") then\n            part.CanCollide = not enabled\n        end\n    end\nend\n\n-- Enable noclip\nsetNoclip(true)\n\n-- Disable noclip later\n-- setNoclip(false)","owner":{"_id":"6a0e0c480550c3daa0ed1b51","username":"shellakranendonk51","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a0e0c480550c3daa0ed1b51","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":560,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/7622322d9d96ca64cfff97fb7d865cda43e8ef738159fd2f583594e922203e99.webp","original":"https://scriptblox.com/images/sb/0-1781368478775.webp","scriptblox":"https://scriptblox.com/images/script/0-1781368478775.webp"},"likeCount":0,"dislikeCount":1,"createdAt":"2026-06-13T16:34:38.823Z","executes":4051,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:03:06.883Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/7622322d9d96ca64cfff97f