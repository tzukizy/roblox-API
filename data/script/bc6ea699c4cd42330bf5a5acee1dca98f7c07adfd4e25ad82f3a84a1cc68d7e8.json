{"slug":"Universal-Script-Simple-Noclip-Script-236162","_id":"6a2d869ea35cdbeeeafb9015","title":"Simple Noclip Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1781368478775.webp","placeId":0},"features":"Simple Noclip","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal function setNoclip(enabled)\n    local character = player.Character or player.CharacterAdded:Wait()\n\n    for _, part in ipairs(character:GetDescendants()) do\n        if part:IsA(\"BasePart\") then\n            part.CanCollide = not enabled\n        end\n    end\nend\n\n-- Enable noclip\nsetNoclip(true)\n\n-- Disable noclip later\n-- setNoclip(false)","owner":{"_id":"6a0e0c480550c3daa0ed1b51","username":"shellakranendonk51","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6a0e0c480550c3daa0ed1b51","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":537,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1781368478775.webp","likeCount":0,"dislikeCount":1,"createdAt":"2026-06-13T16:34:38.823Z","executes":3588,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a2d869ea35cdbeeeafb9017","editBy":{"_id":"6a0e0c480550c3daa0ed1b51","username":"shellakranendonk51","status":"offline","id":"6a0e0c480550c3daa0ed1b51"},"message":"Create script","createdAt":"2026-06-13T16:34:38.829Z"}],"comments":[]}