{"slug":"Jujutsu-Randomizer-LOW-CD-ABILITIES-AUTO-CLICKER-Open-Source-158351","_id":"69c8a634ef7ed726e026191d","title":"LOW CD ABILITIES AUTO CLICKER Open Source","game":{"_id":"69bb2bb9942b0cf7aa2b564b","gameId":95467791496576,"name":"Jujutsu Randomizer","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":95467791496576},"features":"Low - INF CD\nSome abilities might kick you if you spam them too fast.\nIt also removes annoying visuals that may lag you\nPress Q for a built in autoclicker for the super low cd abilities","tags":[],"script":"-- Services\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal Teams = game:GetService(\"Teams\")\n\n-- Instances\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character\n\nlocal Script = game:GetService(\"Players\").LocalPlayer.PlayerScripts.EffectLocal\nScript:Destroy()\n-- Variables\nlocal Switch = false\nlocal Connection = nil\n\n-- Functions\nlocal function ToolCheck()\n    if Character then\n        for _, Tool in ipairs(Character:GetChildren()) do\n            if Tool:IsA(\"Tool\") then\n                local Script = Tool:FindFirstChildWhichIsA(\"LocalScript\")\n                if not Script then continue end\n\n                local RemoteEvent = Script:FindFirstChildWhichIsA(\"RemoteEvent\")\n                if not RemoteEvent then continue end\n\n                return RemoteEvent\n            end\n        end\n        return nil\n    else\n        return nil\n    end\nend\n\n-- Event\nUIS.InputBegan:Connect(function(Key)\n    if (Key.UserInputType == Enum.UserInputType.MouseButton1 or Key.UserInputType == Enum.UserInputType.Touch) then\n        local RemoteEvent = ToolCheck()\n        if RemoteEvent then\n            RemoteEvent:FireServer()\n        end\n    elseif Key.KeyCode == Enum.KeyCode.Q then\n        if Switch == true then\n            Switch = false\n            if Connection then\n                Connection:Disconnect()\n                Connection = nil\n            else\n                return\n            end\n        else\n            Switch = true\n\n            if Connection then\n                Connection:Disconnect()\n                Connection = nil\n            end\n\n            Connection = RunService.Heartbeat:Connect(function()\n                local RemoteEvent = ToolCheck()\n                if RemoteEvent then\n                    RemoteEvent:FireServer()\n                end\n            end)\n        end\n\n    else\n        return\n    end\nend)\n\nLocalPlayer.CharacterAdded:Connect(function(Char)\n    Character = Char\n\n    if game:GetService(\"Players\").LocalPlayer.PlayerScripts.EffectLocal then\n        game:GetService(\"Players\").LocalPlayer.PlayerScripts.EffectLocal:Destroy()\n    end\nend)","owner":{"_id":"686850495ff8bc43bd2ba968","username":"BigHeadScriptsSome","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3ac046969def259d9a813319a53b532cfab45f73244673a22123a3c645395214.webp","original":"https://scriptblox.com/images/photo/686850495ff8bc43bd2ba968-1774757094894.jpeg"},"status":"offline","id":"686850495ff8bc43bd2ba968","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/3ac046969def259d9a813319a53b532cfab45f73244673a22123a3c645395214.webp","original":"https://scriptblox.com/images/photo/686850495ff8bc43bd2ba968-1774757094894.jpeg"}},"verified":false,"views":2444,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6ba4bba69ff62a1e1d250c553e6b8715c831e9bbba70e5153e6e565151f8f3a6.webp","original":"https://scriptblox.com/images/sb/rbx-fd5fe0bbc94a47acf827f8d309532eba-239916615ebe.png","scriptblox":"https://scriptblox.com/images/script/rbx-fd5fe0bbc94a47a