r desired speed (90 clicks per second here)\n    while autoSellEnabled do\n        local startTime = tick()\n        sellEvent:InvokeServer()\n        local elapsedTime = tick() - startTime\n        if elapsedTime < interval then\n            wait(interval - elapsedTime)\n        end\n    end\nend\n\n-- Create the Main tab\nlocal MainTab = Window:MakeTab({\n    Name = \"Main\",\n    Icon = \"rbxassetid://4483345998\",\n    PremiumOnly = false\n})\n\n-- Create the Auto Sell toggle button\nMainTab:AddToggle({\n    Name = \"Auto Sell\",\n    Default = false,\n    Callback = function(value)\n        autoSellEnabled = value\n        if autoSellEnabled then\n            spawn(autoSell)\n        end\n    end\n})\n\n-- Create the Sell Once button\nMainTab:AddButton({\n    Name = \"Sell Once\",\n    Callback = function()\n        sellEvent:InvokeServer()\n    end\n})\n\n-- Initialize Orion Library\nOrionLib:Init()","features":"Auto sell fish","tags":[],"discord":"","keyLink":"","owner":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"},"status":"offline","id":"6570eb9b5d75332ca0540983","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:22:26.585Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c5179d","editBy":{"_id":"6570eb9b5d75332ca0540983","userna