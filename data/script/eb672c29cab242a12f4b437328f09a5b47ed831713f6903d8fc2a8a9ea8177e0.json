{"slug":"Combat-Warriors-AUTO-PARRY-16539","_id":"66ab0ac27c9c0fc6b1619b99","title":"AUTO PARRY","game":{"_id":"67e5e1ffb360710ec3c77d23","gameId":4282985734,"name":"Combat Warriors","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":4282985734},"features":"Autoparry","tags":[],"script":"local lp = game.Players.LocalPlayer\n \nlocal animationInfo = {}\n \nfunction getInfo(id)\n  local success, info = pcall(function()\n      return game:GetService(\"MarketplaceService\"):GetProductInfo(id)\n  end)\n  if success then\n      return info\n  end\n  return {Name=''}\nend\nfunction block(player)\n  keypress(0x46)\n  wait()\n  keyrelease(0x46)\nend\n \nlocal AnimNames = {\n  'Slash',\n  'Swing',\n  'Sword'\n}\n \nfunction playerAdded(v)\n    local function charadded(char)\n      local humanoid = char:WaitForChild(\"Humanoid\", 5)\n      if humanoid then\n          humanoid.AnimationPlayed:Connect(function(track)\n              local info = animationInfo[track.Animation.AnimationId]\n              if not info then\n                  info = getInfo(tonumber(track.Animation.AnimationId:match(\"%d+\")))\n                  animationInfo[track.Animation.AnimationId] = info\n              end\n \n              if (lp.Character and lp.Character:FindFirstChild(\"Head\") and v.Character:FindFirstChild(\"Head\")) then\n                  local mag = (v.Character.Head.Position - lp.Character.Head.Position).Magnitude\n                  if mag < 15  then\n \n                      for _, animName in pairs(AnimNames) do\n                          if info.Name:match(animName) then\n                              pcall(block, v)\n                          end\n                      end\n \n                  end\n              end\n          end)\n      end\n  end\n \n  if v.Character then\n      charadded(v.Character)\n  end\n  v.CharacterAdded:Connect(charadded)\nend\n \nfor i,v in pairs(game.Players:GetPlayers()) do\n   if v ~= lp then\n       playerAdded(v)\n   end\nend\n \ngame.Players.PlayerAdded:Connect(playerAdded)","owner":{"_id":"666ce71bf2de8bb3b7eff87f","username":"Engineermanvr","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/a73621ed2dd9aafa3b8a35cf99ff715d1d9e14b2f1e0af619314148f095dc0ca.webp","original":"https://scriptblox.com/images/photo/666ce71bf2de8bb3b7eff87f-1721981443130.png"},"status":"offline","id":"666ce71bf2de8bb3b7eff87f","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/a73621ed2dd9aafa3b8a35cf99ff715d1d9e14b2f1e0af619314148f095dc0ca.webp","original":"https://scriptblox.com/images/photo/666ce71bf2de8bb3b7eff87f-1721981443130.png"}},"verified":false,"keyLink":"","views":128016,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-08-01T04:10:42.646Z","dislikeCount":3,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/f3963507d4cdfd373ad5a067845f3ee5/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/f3963507d4cdfd373ad5a067845f3ee5/500/280/Image/Jpeg"},"executes":484,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:19:08.771Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/f3963507d4cdfd373ad5a067845f3ee5/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/f3963507d4cdfd373ad5a067845f3ee5/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51925","editBy":{"_id":"666ce71bf2de8bb3b7eff87f","username":"Engineermanvr","status":"offline","id":"666ce71bf2de8bb3b7eff87f"},"message":"Create script","createdAt":"2025-03-27T22:34:58.437Z"}],"comments":[{"_id":"66ab12cfd90c3b3f636e3e42","commentBy":{"