{"slug":"Combat-Warriors-AUTO-PARRY-16539","_id":"66ab0ac27c9c0fc6b1619b99","title":"AUTO PARRY","game":{"_id":"67e5e1ffb360710ec3c77d23","gameId":4282985734,"name":"Combat Warriors","imageUrl":"/images/sb/rbx-a631d6d73730a77f93b02eb3b0e8b06c-11edcb05786b.png","placeId":4282985734},"features":"Autoparry","tags":[],"script":"local lp = game.Players.LocalPlayer\n \nlocal animationInfo = {}\n \nfunction getInfo(id)\n  local success, info = pcall(function()\n      return game:GetService(\"MarketplaceService\"):GetProductInfo(id)\n  end)\n  if success then\n      return info\n  end\n  return {Name=''}\nend\nfunction block(player)\n  keypress(0x46)\n  wait()\n  keyrelease(0x46)\nend\n \nlocal AnimNames = {\n  'Slash',\n  'Swing',\n  'Sword'\n}\n \nfunction playerAdded(v)\n    local function charadded(char)\n      local humanoid = char:WaitForChild(\"Humanoid\", 5)\n      if humanoid then\n          humanoid.AnimationPlayed:Connect(function(track)\n              local info = animationInfo[track.Animation.AnimationId]\n              if not info then\n                  info = getInfo(tonumber(track.Animation.AnimationId:match(\"%d+\")))\n                  animationInfo[track.Animation.AnimationId] = info\n              end\n \n              if (lp.Character and lp.Character:FindFirstChild(\"Head\") and v.Character:FindFirstChild(\"Head\")) then\n                  local mag = (v.Character.Head.Position - lp.Character.Head.Position).Magnitude\n                  if mag < 15  then\n \n                      for _, animName in pairs(AnimNames) do\n                          if info.Name:match(animName) then\n                              pcall(block, v)\n                          end\n                      end\n \n                  end\n              end\n          end)\n      end\n  end\n \n  if v.Character then\n      charadded(v.Character)\n  end\n  v.CharacterAdded:Connect(charadded)\nend\n \nfor i,v in pairs(game.Players:GetPlayers()) do\n   if v ~= lp then\n       playerAdded(v)\n   end\nend\n \ngame.Players.PlayerAdded:Connect(playerAdded)","owner":{"_id":"666ce71bf2de8bb3b7eff87f","username":"Engineermanvr","verified":false,"profilePicture":"/images/photo/666ce71bf2de8bb3b7eff87f-1721981443130.png","status":"offline","id":"666ce71bf2de8bb3b7eff87f","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":127948,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-08-01T04:10:42.646Z","dislikeCount":3,"likeCount":0,"image":"https://tr.rbxcdn.com/f3963507d4cdfd373ad5a067845f3ee5/500/280/Image/Jpeg","executes":431,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51925","editBy":{"_id":"666ce71bf2de8bb3b7eff87f","username":"Engineermanvr","status":"offline","id":"666ce71bf2de8bb3b7eff87f"},"message":"Create script","createdAt":"2025-03-27T22:34:58.437Z"}],"comments":[{"_id":"66ab12cfd90c3b3f636e3e42","commentBy":{"_id":"64cca3d68e7069e1316ffbfd","username":"Malfume","verified":true,"role":"user","profilePicture":"/images/photo/64cca3d68e7069e1316ffbfd-1775463361200.png","createdAt":"2023-08-04T07:08:06.260Z","lastActive":"2026-10-09T05:52:59.593Z","status":"offline","id":"64cca3d68e7069e1316ffbfd","topMilestone":{"key":"creator.executions","tier":100000}},"text":"basic ap","createdAt":"2024-08-01T04:45:03.259Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"66ab12d472d75f58229f75c3","commentBy":{"_id":"64cca3d68e7069e1316ffbfd","username":"Malfume","verified":true,"role":"user","profilePicture":"/images/photo/64cca3d68e7069e1316ffbfd-1775463361200.png","createdAt":"2023-08-04T07:08:06.260Z","lastActive":"2026-10-09T05:52:59.593Z","status":"offline","id":"64cca3d68e7069e1316ffbfd","topMilestone":{"key":"creator.executions","tier":100000}},"text":"not that good","createdAt":"2024-08-01T04:45:08.026Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"66ab14