\"RPG\", \"Revolver\", \"SA58\",\n    \"SawnOff\", \"Shotgun\", \"Uzi\"\n}\n\nlocal AmmoValue = 1000 -- change the number to the ammo count that you wish ;)\n\nlocal SetAmmo = function(Gun)\n    if not Gun:IsA(\"Tool\") or not table.find(GunNames, Gun.Name) then return end\n\n    local Stats = Gun:FindFirstChild(\"Stats\")\n  \n    if not Stats then return end    \n\n    local Ammo = Stats.Ammo\n\n    if not Ammo then return end\n\n    Ammo.Value = AmmoValue\nend\n\nlocal OnChildAdded = function(Child)\n    SetAmmo(Child)\nend\n\nPlayer.Backpack.ChildAdded:Connect(OnChildAdded)\n\nfor _, Object in ipairs(Player.Backpack:GetChildren()) do\n    SetAmmo(Object)\nend","features":"Just gives you crap ton of ammo, when running maybe ur gonna need to reset\n\nwith \"Infinite ammo\" you cant really reload\nshould work with every exploits (simple variables obviously)\nworks every guns (guns from test place :))","tags":[],"discord":"","keyLink":"","owner":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c7e7f0518d9a6fa042e7459ceef6258d16aacc0baea47017f8db17047ac34be7.webp","original":"https://scriptblox.com/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png"},"status":"offline","id":"66c63d08f2b2900a0fcb7b0a","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/c7e7f0518d9a6fa042e7459ceef6258d16aacc0baea47017f8db17047ac34be7.webp","original":"https://scriptblox.com/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:53:41.460Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c548c8","editBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","status":"offline","id":"66c63d08f2b2900a0fcb7b0a"},"me