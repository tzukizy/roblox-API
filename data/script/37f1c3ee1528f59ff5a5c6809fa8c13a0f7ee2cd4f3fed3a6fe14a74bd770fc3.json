{"_id":"676dc486f84d0cef399a7119","title":"Gui de entrar em servidor pequen by Mr red black","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/fbd16119e10e0ba2edbdab9cae92f61d58b4962ebde5534fc35c8ddb86fb60e5.webp","original":"https://scriptblox.com/images/sb/9935493-1735246982365.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/fbd16119e10e0ba2edbdab9cae92f61d58b4962ebde5534fc35c8ddb86fb60e5.webp","original":"https://scriptblox.com/images/sb/9935493-1735246982365.png"},"placeId":0},"slug":"Universal-Script-Gui-de-entrar-em-servidor-pequen-by-Mr-red-black-25268","verified":false,"key":false,"keyless":false,"views":5426,"executes":131,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/54851d1d283eff94f0e169f62ab16a9559d4dc0318051bac0bbceb06dbac0c4c.webp","original":"https://scriptblox.com/images/sb/9935493-1735246982365.png","scriptblox":"https://scriptblox.com/images/script/9935493-1735246982365.png"},"thumbnail":{"url":"https://media.kocakz.me/54851d1d283eff94f0e169f62ab16a9559d4dc0318051bac0bbceb06dbac0c4c.webp","original":"https://scriptblox.com/images/sb/9935493-1735246982365.png","scriptblox":"https://scriptblox.com/images/script/9935493-1735246982365.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2024-12-26T21:03:02.429Z","updatedAt":"2024-12-26T21:03:02.429Z","lastBump":"2024-12-26T21:03:02.429Z","script":"local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()\n\nlocal Window = OrionLib:MakeWindow({Name = \"Meu Script\", HidePremium = false, SaveConfig = true, ConfigFolder = \"OrionTest\"})\n\nlocal Tab = Window:MakeTab({Name = \"Principal\", Icon = \"rbxassetid://4483345998\", PremiumOnly = false})\n\nlocal Section = Tab:AddSection({Name = \"Funções\"})\n\nSection:AddButton({\n    Name = \"SERVIDOR PEQUENO\",\n    Callback = function()\n        local HttpService = game:GetService(\"HttpService\")\n        local TeleportService = game:GetService(\"TeleportService\")\n        local PlaceId = game.PlaceId\n\n        local function GetSmallestServer()\n            local servers = HttpService:JSONDecode(game:HttpGet(\"https://games.roblox.com/v1/games/\"..PlaceId..\"/servers/Public?sortOrder=Asc&limit=100\"))\n            for _, server in pairs(servers.data) do\n                if server.playing < server.maxPlayers then\n                    return server.id\n                end\n            end\n            return nil\n        end\n\n        local serverId = GetSmallestServer()\n        if serverId then\n            TeleportService:TeleportToPlaceInstance(PlaceId, serverId, game.Players.LocalPlayer)\n        else\n            print(\"Nenhum servidor vazio encontrado.\")\n        end\n    end\n})\n","features":"Script foda","tags":[],"discord":"","keyLink":"","owner":{"_id":"675dc08a0476bb7e5f5c63d9","username":"THE_MR_RED_BLACK_ofc","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c5e67d513e8a7e8a8e5381d3c78a4412109407e3c569982316d5ad0a95b79504.webp","original":"https://scriptblox.com/images/photo/675dc08a0476bb7e5f5c63d9-1737138444642.jpg"},"status":"offline","id":"675dc08a0476bb7e5f5c63d9","profile":{"url":"https://media.kocakz.me/c5e67d513e8a7e8a8e5381d3c78a4412109407e3c569982316d5ad0a95b79504.webp","original":"https://scriptblox.com/images/photo/675dc08a0476bb7e5f5c63d9-1737138444642.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:07:28.036Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53c17","editBy":{"_id":"675dc08a0476bb7e5f5c63d9","username":"THE_MR_RED_BLACK_ofc","status":"offline","id":"675dc08a0476bb7e5f5c63d9"},"message