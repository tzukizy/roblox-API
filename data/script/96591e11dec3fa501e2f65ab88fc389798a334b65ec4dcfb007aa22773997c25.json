end\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\n\tif input.KeyCode == Enum.KeyCode.G then\n\t\tsetInvisible(not invisible)\n\tend\nend)\n\nplayer.CharacterAdded:Connect(function()\n\tinvisible = false\nend)\n","features":"YOU NEED TO PRESS G TO WORK","tags":[],"discord":"","keyLink":"","owner":{"_id":"6958ebf52b11b2370533bb08","username":"ramazan1337","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6958ebf52b11b2370533bb08","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:34:58.334Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a7b31f46613e5af409bc0df","editBy":{"_id":"6958ebf52b11b2370533bb08","username":"ramazan1337","status":"offline","id":"6958ebf52b11b2370533bb08"},"message":"Create script","createdAt":"2026-08-11T14:30:12.335Z"}],"comments":[]}