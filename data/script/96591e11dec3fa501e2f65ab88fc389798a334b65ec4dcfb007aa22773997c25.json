{"slug":"Universal-Script-invisibility-223418","_id":"6a7b31f46613e5af409bc0dd","title":"invisibility","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"YOU NEED TO PRESS G TO WORK","tags":[],"script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\nlocal invisible = false\n\nlocal function setInvisible(state)\n\tlocal character = player.Character or player.CharacterAdded:Wait()\n\n\tfor _, object in ipairs(character:GetDescendants()) do\n\t\tif object:IsA(\"BasePart\") then\n\t\t\tobject.LocalTransparencyModifier = state and 1 or 0\n\t\telseif object:IsA(\"Decal\") then\n\t\t\tobject.Transparency = state and 1 or 0\n\t\tend\n\tend\n\n\tinvisible = state\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\n\tif input.KeyCode == Enum.KeyCode.G then\n\t\tsetInvisible(not invisible)\n\tend\nend)\n\nplayer.CharacterAdded:Connect(function()\n\tinvisible = false\nend)\n","owner":{"_id":"6958ebf52b11b2370533bb08","username":"ramazan1337","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6958ebf52b11b2370533bb08","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":191,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/6f19824a9e81c53b82df7d46ca787add823dbbb234eddafd9c50de4aef6e50f0.webp","original":"https://scriptblox.com/images/sb/0-1786458612314.png","scriptblox":"https://scriptblox.com/images/script/0-1786458612314.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-08-11