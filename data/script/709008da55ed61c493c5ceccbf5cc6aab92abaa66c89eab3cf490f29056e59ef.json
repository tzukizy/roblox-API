l\") then\n            local wep = v:GetChildren()\n            for a,b in pairs(wep) do\n                if b.Name == \"LocalConfig\" then\n                    local configuration = b:GetChildren()\n                    for c,d in pairs(configuration) do\n                        if d.Name == \"Configuration\" then\n                            local wepconfigs = d:GetChildren()\n                            for e,f in pairs(wepconfigs) do\n                                --print(f.Name) -- PRINT THIS TO ADD MORE GUN MODS but disabled because laggy and fills up ur console\n                                if f.Name == \"Accuracy\" then\n                                    f.Value = Vector3.new(0,0,0)\n                                end\n                                if f.Name == \"RecoilMin\" then\n                                    f.Value = Vector3.new(0,0,0)\n                                end\n                                if f.Name == \"RecoilMax\" then\n                                    f.Value = Vector3.new(0,0,0)\n                                end\n                                if f.Name == \"MaximumRange\" then\n                                    f.Value = 10000\n                                end\n                            end\n                        end\n                    end\n                end\n            end\n        end\n    end\nend)","features":"Simple gunmods.\nyou can  add more like firerate.To SEE the stuff that you can change simply uncomment the print(f), then change the value accordingly.","tags":[],"discord":"","keyLink":"","owner":{"_id":"68aafd5c8843cab44a5bcc43","username":"RTX5090","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68aafd5c8843cab44a5bcc43","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict"