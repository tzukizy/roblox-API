d ahh died\")\n           RootPart = Character:FindFirstChild(\"HumanoidRootPart\")\n       else\n           RVelocity = RootPart.Velocity\n   \n           RootPart.Velocity = type(Velocity) == \"vector\" and Velocity or Velocity(RVelocity)\n       \n           RStepped:wait()\n       \n           RootPart.Velocity = RVelocity\n       end\n   end\n   \n   Heartbeat:wait()\nend","features":"might not work on some games but does work for da hood (not made by me btw)","tags":[],"discord":"","keyLink":"","owner":{"_id":"6314c1760526459ceca8fdb4","username":"ball_licker","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6314c1760526459ceca8fdb4","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:13:19.704Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e7ba","editBy":{"_id":"6314c1760526459ceca8fdb4","username":"ball_licker","status":"offline","id":"6314c1760526459ceca8fdb4"},"message":"Create script","createdAt":"2025-03-26T04:03:40.381Z"}],"comments":[{"_id":"632256dea2978f1fbded3ad4","commentBy":{"_id":"62eb269d023cd19cae08fb9a","username":"Novaz","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c952087f34f8e8972fadfc72455d28da51010169b1e8f0ce59304fb6022a0771.webp","original":"https://scriptblox.com/images/photo/62eb269d023cd19cae08fb9a-1693790334088.jpg"},"createdAt":"2022-08-04T01:53:33.754Z","lastActive":"2024-05-24T02:42:25.905Z","status":"offline","id":"62eb269d023cd19cae08fb9a","profile":{"url":"https://media.kocakz.me/c952087f34f8e8972fadfc72455d28da51010169b1e8f0ce59304fb6022a0771.webp","original":"https://scriptblox.com/images