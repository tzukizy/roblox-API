{"_id":"6953e96bcac26a93a7c3f00a","title":"Marts teleport tool","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/9fef8326a6043a2db1d403d7e1ed232597c7e4be4775d491eed7e51b9822ef88.webp","original":"https://scriptblox.com/images/sb/0-1767106923227.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/9fef8326a6043a2db1d403d7e1ed232597c7e4be4775d491eed7e51b9822ef88.webp","original":"https://scriptblox.com/images/sb/0-1767106923227.jpg"},"placeId":0},"slug":"Universal-Script-Marts-teleport-tool-80005","verified":false,"key":false,"keyless":false,"views":1194,"executes":6770,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ef75e3fc1be7c01c2f59f70c8088b3dbf02f5c8ed34033860db3bf592179ae12.webp","original":"https://scriptblox.com/images/sb/0-1767106923227.jpg","scriptblox":"https://scriptblox.com/images/script/0-1767106923227.jpg"},"thumbnail":{"url":"https://media.kocakz.me/ef75e3fc1be7c01c2f59f70c8088b3dbf02f5c8ed34033860db3bf592179ae12.webp","original":"https://scriptblox.com/images/sb/0-1767106923227.jpg","scriptblox":"https://scriptblox.com/images/script/0-1767106923227.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-30T15:02:03.250Z","updatedAt":"2025-12-30T15:02:03.250Z","lastBump":"2025-12-30T15:02:03.250Z","script":"-- Credit: MartTheScript\nloadstring([[\n    local Player = game.Players.LocalPlayer\n    local Mouse = Player:GetMouse()\n\n    -- Create the Tool\n    local Tool = Instance.new(\"Tool\")\n    Tool.Name = \"⚡ Instant-TP\"\n    Tool.RequiresHandle = true\n    Tool.CanBeDropped = false\n\n    -- Create the Visual Handle\n    local Handle = Instance.new(\"Part\")\n    Handle.Name = \"Handle\"\n    Handle.Size = Vector3.new(0.1, 0.1, 1.2)\n    Handle.BrickColor = BrickColor.new(\"Toothpaste\")\n    Handle.Material = Enum.Material.Neon\n    Handle.Parent = Tool\n\n    -- Create the Sound Effect\n    local Sound = Instance.new(\"Sound\", Handle)\n    Sound.SoundId = \"rbxassetid://153092227\"\n    Sound.Volume = 2\n\n    -- Teleportation Logic (No Flicking)\n    Tool.Activated:Connect(function()\n        if Mouse.Target then\n            local Character = Player.Character\n            if Character then\n                Sound:Play()\n                Character:MoveTo(Mouse.Hit.p)\n            end\n        end\n    end)\n\n    Tool.Parent = Player.Backpack\n]])()","features":"You can teleport anywhere","tags":["Tp","Tool","Universal","Script","Tptool"],"discord":"","keyLink":"","owner":{"_id":"6947b54906b900e862318bbe","username":"MartTheNewScripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/51725e10636a099d8be11388235aa943eea7d63a0f471a67787fedfcb7060c2f.webp","original":"https://scriptblox.com/images/photo/6947b54906b900e862318bbe-1766307271003.png"},"status":"offline","id":"6947b54906b900e862318bbe","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/51725e10636a099d8be11388235aa943eea7d63a0f471a67787fedfcb7060c2f.webp","original":"https://scriptblox.com/images/photo/6947b54906b900e862318bbe-1766307271003.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:35:22.045Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6953e96bcac26a93a7c3f00d","editBy":{"_id":"6947b54906b900e862318bbe","username":"MartTheNewScripter","status":"offline","id":"6947b54906b900e862318bbe"},"message":"This is my first, script made, by mart","createdAt":"2025-12-30T15:02:03.254Z"}],"comments":[]}