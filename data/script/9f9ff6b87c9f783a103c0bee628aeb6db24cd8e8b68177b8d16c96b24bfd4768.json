{"slug":"Universal-Script-teleport-tool-open-source-by-lunar-91377","_id":"6975201663b88be833e0947a","title":"teleport tool open source by lunar","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"gives u a tool to tp with","tags":[],"script":"-- Teleport Tool (LocalScript)\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal mouse = player:GetMouse()\n\n-- Create tool\nlocal tool = Instance.new(\"Tool\")\ntool.Name = \"Click Teleport\"\ntool.RequiresHandle = false\ntool.Parent = player:WaitForChild(\"Backpack\")\n\n-- Teleport on click\ntool.Activated:Connect(function()\n    local character = player.Character\n    if not character then return end\n\n    local hrp = character:FindFirstChild(\"HumanoidRootPart\")\n    if not hrp then return end\n\n    -- Teleport slightly above ground to avoid falling\n    hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))\nend)\n","owner":{"_id":"69516a20412eaa14db9b25d3","username":"therandomidiot4","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"69516a20412eaa14db9b25d3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":637,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/15eaf9d68bfe40a4bbb316f15064d70a1555f59987515d2a76ba64aa25568275.webp","original":"https://scriptblox.com/images/sb/0-1769283606455.webp","scriptblox":"https://scriptblox.com/images/script/0-1769283606455.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-01-24T19:40:06.496Z","executes":2786,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:35:57.610Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/15eaf9d68bfe40a4bbb316f15064d70a1555f59987515d2a76ba64aa25568275.webp","original":"https://scriptblox.com/images/sb/0-1769283606455.webp","scriptblox":"https://scriptblox.com/images/script/0-1769283606455.webp"},"changelog":[{"_id":"6975201663b88be833e0947d","editBy":{"_id":"69516a20412eaa14db9b25d3","username":"therandomidiot4","status":"offline","id":"69516a20412eaa14db9b25d3"},"message":"Create script","createdAt":"2026-01-24T19:40:06.500Z"}],"comments":[]}