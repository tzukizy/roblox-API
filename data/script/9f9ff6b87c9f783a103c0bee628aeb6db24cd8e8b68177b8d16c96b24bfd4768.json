")\n    if not hrp then return end\n\n    -- Teleport slightly above ground to avoid falling\n    hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))\nend)\n","features":"gives u a tool to tp with","tags":[],"discord":"","keyLink":"","owner":{"_id":"69516a20412eaa14db9b25d3","username":"therandomidiot4","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69516a20412eaa14db9b25d3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:42:30.214Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6975201663b88be833e0947d","editBy":{"_id":"69516a20412eaa14db9b25d3","username":"therandomidiot4","status":"offline","id":"69516a20412eaa14db9b25d3"},"message":"Create script","createdAt":"2026-01-24T19:40:06.500Z"}],"comments":[]}