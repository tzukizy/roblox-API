{"slug":"Universal-Script-Rainbow-delta-icon-69157","_id":"6922bba738daffe0188b5a51","title":"Rainbow delta icon","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1763883943640.jpg","placeId":0},"features":"rainbow delta","tags":[],"script":"getgenv().RainbowSpeed = 1 -- скорость смены цветов\n\nlocal CoreGui = game:GetService(\"CoreGui\")\nlocal RunService = game:GetService(\"RunService\")\n\n-- Подключение к Heartbeat для плавной анимации\nRunService.Heartbeat:Connect(function()\n    local time = tick() * getgenv().RainbowSpeed\n    local hue = time % 1\n    \n    for _, v in ipairs(CoreGui:GetDescendants()) do\n        if v:IsA(\"UIStroke\") and v.Parent:IsA(\"ImageButton\") and v.Parent.Parent:IsA(\"ScreenGui\") and v.Parent.Parent.Parent:IsA(\"Folder\") and v.Parent.Parent.Parent.Parent.Name == \"CoreGui\" then\n            v.Color = Color3.fromHSV(hue, 1, 1)\n        end\n    end\nend)","owner":{"_id":"690f54bbcff51b46c5fb591e","username":"simkaHUB","verified":false,"profilePicture":"/images/photo/690f54bbcff51b46c5fb591e-1762612455765.jpg","status":"offline","id":"690f54bbcff51b46c5fb591e"},"verified":false,"views":531,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1763883943640.jpg","likeCount":3,"dislikeCount":2,"createdAt":"2025-11-23T07:45:43.660Z","executes":935,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6922bba738daffe0188b5a53","editBy":{"_id":"690f54bbcff51b46c5fb591e","username":"simkaHUB","status":"offline","id":"690f54bbcff51b46c5fb591e"},"message":"Create script","createdAt":"2025-11-23T07:45:43.666Z"}],"comments":[{"_id":"6922c5f95f27c264a6fcc475","commentBy":{"_id":"6834565bac1935f24d4b3715","username":"Shoma3","verified":false,"role":"user","profilePicture":"/images/photo/6834565bac1935f24d4b3715-1760836485149.jpg","createdAt":"2025-05-26T11:54:03.750Z","lastActive":"2026-10-07T