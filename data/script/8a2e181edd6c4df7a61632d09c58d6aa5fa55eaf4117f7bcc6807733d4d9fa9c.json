{"slug":"Swim-League-New-World-8-10X-FASTER-MUSCLE-23926","_id":"67536d98c211fe7d63a25278","title":"10X FASTER MUSCLE","game":{"_id":"67e5e1ffb360710ec3c78014","gameId":132495346586140,"name":"Swim League [ Xmas🎅]","imageUrl":"https://tr.rbxcdn.com/180DAY-a528a8ee898d39d42e50cf1b034b4a79/500/280/Image/Jpeg/noFilter","placeId":132495346586140},"features":"This just fires a remote each 0.1 seconds and it finishes the workout instantly\n\nWARNING: YOU HAVE TO TRAIN ON THE MACHINES!!\n\nKEYBIND: T ON/OFF","tags":[],"script":"-- Variables\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TrainRemote = ReplicatedStorage.Train.Remote.TrainAnimeHasEnded\n\n-- State\nlocal isToggled = false\nlocal loopConnection\n\n-- Function to toggle the loop\nlocal function toggleLoop()\n    isToggled = not isToggled\n    if isToggled then\n        -- Start the loop\n        loopConnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\n            TrainRemote:FireServer()\n            wait(0.1) -- Adjusts the activation rate\n        end)\n    else\n        -- Stop the loop\n        if loopConnection then\n            loopConnection:Disconnect()\n            loopConnection = nil\n        end\n    end\nend\n\n-- Listen for the T key press\nUserInputService.InputBegan:Connect(function(input, isProcessed)\n    if not isProcessed and input.KeyCode == Enum.KeyCode.T then\n        toggleLoop()\n    end\nend)\n","owner":{"_id":"62c2ba1d1b5c9eb83fcd5c71","username":"Dev10","verified":false,"profilePicture":"/images/photo/62c2ba1d1b5c9eb83fcd5c71-1729474592003.jpg","status":"offline","id":"62c2ba1d1b5c9eb83fcd5c71","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":8150,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-12-06T21:33:12.582Z","dislikeCount":4,"likeCount":0,"image":"https://tr.rbxcdn.com/180D