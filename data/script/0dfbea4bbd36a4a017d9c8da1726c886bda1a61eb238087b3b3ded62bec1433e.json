        esp.Adornee = torso\n        esp.Size = torso.Size + Vector3.new(0.1, 0.1, 0.1) -- Slightly larger than the torso\n        esp.Color3 = ESP_COLOR\n        esp.Transparency = ESP_TRANSPARENCY\n        esp.AlwaysOnTop = true\n        esp.ZIndex = 5\n        esp.Parent = torso\n    end\nend\n\n-- Function to update ESP positions\nlocal function updateESP()\n    for _, player in ipairs(game.Players:GetPlayers()) do\n        createESP(player)\n    end\nend\n\n-- Initial ESP creation\nfor _, player in ipairs(game.Players:GetPlayers()) do\n    createESP(player)\nend\n\n-- Update ESP periodically\nwhile true do\n    updateESP()\n    wait(UPDATE_FREQUENCY)\nend\n","features":"Just esp (UPDATED)","tags":[],"discord":"","keyLink":"","owner":{"_id":"662d33150d15d5289ba1823b","username":"steamsignup08","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6ff30e9d65c45264b7d634e523909372a8afe5fea2429269861d19ff69a71e55.webp","original":"https://scriptblox.com/images/photo/662d33150d15d5289ba1823b-1714238263619.png"},"status":"offline","id":"662d33150d15d5289ba1823b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/6ff30e9d65c45264b7d634e523909372a8afe5fea2429269861d19ff69a71e55.webp","original":"https://scriptblox.com/images/photo/662d33150d15d5289ba1823b-1714238263619.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:59:27.157Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c327","editBy":{"_id":"662d33150d15d5289ba1823b","username":"steamsignup08","status":"offline","id":"662d33150d15d5289ba1823b"},"message":"Create script","createdAt":"2024-05-11T18:54:42.422Z"},{"_id":"67e5e1e5b360710ec3c50cb6","editBy":{"_id":"662d33150d15d5289ba1823b","username":"steamsignup08","status":"offline","id":"662d3315