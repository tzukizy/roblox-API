r3.new(-25.95, 84, 3537.55)\n            local Weld = Instance.new(\"Weld\", Seat)\n            Weld.Part0 = Seat\n            Weld.Part1 = game.Players.LocalPlayer.Character:FindFirstChild(\"Torso\") or game.Players.LocalPlayer.Character.UpperTorso\n            wait()\n            Seat.CFrame = savedpos\n            game.StarterGui:SetCore(\"SendNotification\", {\n                Title = \"Invis On\";\n                Duration = 1;\n                Text = \"\";\n            })\n        else\n            workspace:FindFirstChild('invischair'):Remove()\n            game.StarterGui:SetCore(\"SendNotification\", {\n                Title = \"Invis Off\";\n                Duration = 1;\n                Text = \"\";\n            })\n        end\n    end\nend\n\ngame:GetService(\"UserInputService\").InputBegan:connect(onKeyPress)","features":"-X to go invisble","tags":[],"discord":"","keyLink":"","owner":{"_id":"625f9ff2efd5c73948e3edf6","username":"yucko","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"625f9ff2efd5c73948e3edf6","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:10:39.666Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50778","editBy":{"_id":"625f9ff2efd5c73948e3edf6","username":"yucko","status":"offline","id":"625f9ff2efd5c73948e3edf6"},"message":"Create script","createdAt":"2025-03-27T23:06:23.866Z"}],"comments":[{"_id":"660128e9cfe16afcfd1203f4","commentBy":{"_id":"625f9ff2efd5c73948e3edf6","username":"yucko","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-04-2