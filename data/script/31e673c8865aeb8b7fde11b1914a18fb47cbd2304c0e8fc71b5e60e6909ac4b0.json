goImage.Size = UDim2.new(1, 0, 0, 150)\nLogoImage.Image = \"rbxassetid://106113675537942\"\nLogoImage.BackgroundTransparency = 1\n\n-- BAŞLIK\nTitle.Parent = MainFrame\nTitle.Size = UDim2.new(1, 0, 0, 40)\nTitle.Position = UDim2.new(0, 0, 0, 150)\nTitle.Text = \"🎯 REIS HUB v2.0\"\nTitle.TextColor3 = Color3.fromRGB(255, 255, 255)\nTitle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nTitle.Font = Enum.Font.Michroma\nTitle.TextSize = 20\n\n-- BUTONLARI OLUŞTUR\nlocal function createButton(name, url, position)\n    local button = Instance.new(\"TextButton\")\n    button.Parent = MainFrame\n    button.Size = UDim2.new(0.4, 0, 0, 40)\n    button.Position = position\n    button.Text = name\n    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)\n    button.TextColor3 = Color3.fromRGB(255, 255, 255)\n    button.Font = Enum.Font.Michroma\n    button.TextSize = 14\n    \n    -- DELTA İÇİN DİREKT EVENT EKLE\n    button.MouseButton1Click:Connect(function()\n        loadstring(game:HttpGet(url))()\n    end)\n    \n    return button\nend\n\n-- BUTONLARI EKLE\ncreateButton(\"🌀 INVISIBLE\", \"https://rawscripts.net/raw/Universal-Script-Invisible-script-20557\", UDim2.new(0.05, 0, 0.25, 0))\ncreateButton(\"💣 RC7\", \"https://raw.githubusercontent.com/CoreGui/Scripts/main/RC7\", UDim2.new(0.55, 0, 0.25, 0))\ncreateButton(\"⚔️ CADUCUA\", \"https://pastebin.com/raw/XJeBNe0s\", UDim2.new(0.05, 0, 0.35, 0))\ncreateButton(\"🎨 SPRAY\", \"https://raw.githubusercontent.com/srzmnx/OLD-roblox-scripts/refs/heads/master/spray%20can.txt\", UDim2.new(0.55, 0, 0.35, 0))\ncreateButton(\"👻 NOCLIP\", \"https://pastebin.com/raw/wQmCgz2Y\", UDim2.new(0.05, 0, 0.45, 0))\ncreateButton(\"🚗 TOY CAR\", \"https://pastebin.com/raw/wQmCgz2Y\", UDim2.new(0.55, 0, 0.45, 0))\ncreateButton(\"💥 FLING\", \"https://raw.githubusercontent.com/Thuan6565/Script/refs/heads/main/FeFlingGui\", UDim2.new(0.05, 0, 0.55, 0))\n\n-- ANTI-CHEAT BUTONU (ÖZEL)\nlocal antiCheatBtn = createButton(\"🛡️ ANTI-CHEAT\", \"https://pastebin.com/raw/XXXXXXXX\", UDim2.new(0.55, 0, 0.55, 0))\nantiCheatBtn.MouseButton1Click:Connect(function()\n    -- ANTI-CHEAT BYPASS KODU BURAYA\n    print(\"🎯 ANTI-CHEAT BYPASS AKTİF!\")\nend)\n\nprint(\"🎯 REIS HUB - DELTA UYUMLU AKTİF!\")\nprint(\"🖼️ Logo: 106113675537942\")","features":"Idk","tags":[],"discord":"","keyLink":"","owner":{"_id":"68c57ca7ff7e9ac8957a3949","username":"Povvther","verified":false,"profilePicture":{"url":"https://media.kocakz.me/17ed419ea6325259aaf74169f9606147a1fc70096f549d57a5ac170066512232.webp","original":"https://scriptblox.com/images/photo/68c57ca7ff7e9ac8957a3949-1758222624201.jpg"},"status":"offline","id":"68c57ca7ff7e9ac8957a3949","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/17ed419ea6325259aaf74169f9606147a1fc70096f549d57a5ac170066512232.webp","original":"https://scriptblox.com/images/photo/68c57ca7ff7e9ac8957a3949-1758222624201.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:41:13.911Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e66c34448dfaca94f18405","editBy":{"_id":"68c57ca7ff7e9ac8957a3949","username":"Povvther","status":"offline","id":"68c57ca7ff7e9ac8957a3949"},"message":"Create script","createdAt":"2025-10-08T13:50:44.643Z"}],"comments":[{"_id":"68e67d549cdba9aed073b594","commentBy":{"_id":"68bc8acee7c433fa34ce957d","username":"byprol","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/d5a7b68b3ca6cdb107e925f123c5d94eea4e79b6e7522f68770ed9d119488abc.webp","original":"https://scriptblox.com/images/photo/68bc8acee7c433fa34ce957d-1760166747412.png"},"createdAt":"2025-09-06T19:26:06.717Z","lastActive":"2025-10-25T11:22:41.250Z","status":"offline","id":"68bc8acee7c433fa34ce957d","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https