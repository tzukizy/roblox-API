{"slug":"Impossible-Glass-Bridge-Obby!-(Squid-Game)-See-es-on-obby-9802","_id":"6595927a1c21857fdf1ed281","title":"Read feature","game":{"_id":"67e5e1ffb360710ec3c77f0a","gameId":7952502098,"name":"Impossible Glass Bridge Obby! (Squid Game)","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":7952502098},"features":"The script make you see the good glass and bas glass to troll kids thinking robux games real.\n\nThe script only works for Creator_Studio's glass bridge obby\nBlue = You can go in | Red = you cant go in\n\nCredits to the owner","tags":[],"script":"\nlocal test = game:GetService(\"Workspace\")[\"Glass Bridge\"].GlassPane\nlocal red = Color3.new(151, 0, 0)\nlocal function wrongcolor()\n        for i,v in pairs(test:GetDescendants()) do\n        if v:IsA(\"Folder\") then\n            for _,g in pairs(v:GetDescendants()) do\n                if g.ClassName == \"Part\" then\n                    for _, kill in pairs(g:GetDescendants()) do\n                        if kill.ClassName == \"TouchTransmitter\" and kill.Name == \"TouchInterest\" then\n                            g.Color = red\n                        end\n                    end\n                end\n            end\n        end\n    end\nend\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    wrongcolor()\nend)","owner":{"_id":"656f9732c93466871004fa73","username":"imposteurbleu123","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9692a41199d8e03cedd52d78144f84c02fc01d2b3095edea89b5ab2cfc508610.webp","original":"https://scriptblox.com/images/photo/656f9732c93466871004fa73-1726338349990.png"},"status":"offline","id":"656f9732c93466871004fa73","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/9692a41199d8e03cedd52d78144f84c02fc01d2b3095edea89b5ab2cfc508610.webp","original":"https://scriptblox.com/images/