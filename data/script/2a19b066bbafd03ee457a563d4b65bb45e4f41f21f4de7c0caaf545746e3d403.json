.07138129e-08, -0.999137938, -4.94420016e-09, 1, 2.09371116e-08, 0.999137938, 5.80910164e-09, -0.041513063)}):Play()\nwait()\nfireproximityprompt(game:GetService(\"Workspace\").MapStuff.Jobs.HaroldsCleaning.JobBoard.Start.ProximityPrompt)\nelse\n    for i,v in pairs(game:GetService(\"Workspace\").MapStuff.Jobs.HaroldsCleaning.CleaningParts:GetChildren()) do\n        wait(1)\n        if v.Handler.Cleaned.Value == true then\n        elseif v.Handler.Cleaned.Value == false then\n            if mychar.HumanoidRootPart.Anchored == true then\n            else\n                mychar.HumanoidRootPart.CFrame = v.CFrame\n                wait(0.2)\n                fireproximityprompt(v.Prompt)\n            end\n        end\n    end\nend\n    wait(1)\nend","features":"AUTOFARM\ndiscord.gg/FKHmERC6y5","tags":[],"discord":"","keyLink":"","owner":{"_id":"627ece366046968669823190","username":"lobox920","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"627ece366046968669823190","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:24:28.359Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b6a8","editBy":{"_id":"627ece366046968669823190","username":"lobox920","status":"offline","id":"627ece366046968669823190"},"message":"Create script","createdAt":"2022-06-30T23:46:14.241Z"},{"_id":"67e5e1e4b360710ec3c4f352","editBy":{"_id":"627ece366046968669823190","username":"lobox920","status":"offline","id":"627ece366046968669823190"},"message":"Update script","createdAt":"2025-03-27T22:23:58.705Z"}],"comments":[{"_id":"62be7b101b5c9eb83fbf1281","commentBy":{"_id":"61e37bbe4889e8d9823e4f3d","use