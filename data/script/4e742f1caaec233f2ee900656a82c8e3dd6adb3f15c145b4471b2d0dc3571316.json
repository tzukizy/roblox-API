{"slug":"Universal-Script-luaumcp-239251","_id":"6a3c6beed779763081b682b5","title":"luaumcp","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"this script makes everything work together:\n\nalt account manager - run scripts across alts at once, in bulk\nconnect ai to executor so it can reverse games, etc\neverything is open source on github so you can publish your own site to vercel or wherever\nthe website at https://luaumcp.vercel.app has monaco editor, console, exec/clear buttons\ntop right has a blurred key (not harmful, just a fun option) - hover to reveal, click to copy, and a regenerate button beside it\nthe key goes into local key = \"\" in the script below\nsource: https://github.com/setidentity/luaumcp","tags":[],"script":"local http = game:GetService(\"HttpService\")\nlocal key = \"\"\nlocal lp = game:GetService(\"Players\").LocalPlayer\n\npcall(request, {\n   Url = \"https://luaumcp.vercel.app/api/log\",\n   Method = \"POST\",\n   Headers = { [\"Content-Type\"] = \"application/json\" },\n   Body = http:JSONEncode({ text = http:JSONEncode({ name = lp.Name, display = lp.DisplayName, id = lp.UserId }), type = \"join\", key = key })\n})\n\ntask.spawn(function()\n  game:GetService(\"LogService\").MessageOut:Connect(function(msg, type)\n    pcall(request, {\n      Url = \"https://luaumcp.vercel.app/api/log\",\n      Method = \"POST\",\n      Headers = { [\"Content-Type\"] = \"application/json\" },\n      Body = http:JSONEncode({ text = msg, type = type == Enum.MessageType.MessageOutput and \"output\" or type == Enum.MessageType.MessageWarning and \"warning\" or type == Enum.MessageType.MessageError and \"error\" or \"info\", key = key })\n    })\n  end)\nend)\n\ntask.spawn(function()\n  while true do\n    pcall(function()\n      local d = http:JSONDecode(request({ Url = \"https://luaumcp.vercel.app/api/code?key=\" .. key, Method = \"GET\" }).Body)\n      if d and d.code then\n        local ro, rv = pcall(loadstring(d.code))\n        request({\n          Url = \"https://luaumcp.vercel.app/api/code\",\n          Method = \"POST\",\n          Headers = { [\"Content-Type\"] = \"application/json\" },\n          Body = http:JSONEncode({ id = d.id, key = key, output = ro and tostring(rv) or rv, success = ro })\n        })\n      end\n    end)\n    task.wait(0.2)\n  end\nend)\n","owner":{"_id":"68f6c1ffa73faf2a229913fa","username":"realm","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c4606def2e3acb534c7c4169a41efa9db9af6ecc456f3777dcc905a474c3eec3.webp","original":"https://scriptblox.com/images/photo/68f6c1ffa73faf2a229913fa-1762897629207.png"},"status":"offline","id":"68f6c1ffa73faf2a229913fa","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/c4606def2e3acb534c7c4169a41efa9db9af6ecc456f3777dcc905a474c3eec3.webp","original":"https://scriptblox.com/images/photo/68f6c1ffa73faf2a229913fa-1762897629207.png"}},"verified":false,"views":3072,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/1334843afe00f345eee7636cdfda2efe4b3f5eb421583140087b16ce2378d3cb.webp","original":"https://scriptblox.com/images/sb/0-1782344686600.png","scriptblox":"https://scriptblox.com/images/script/0-1782344686600.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2026-06-24T23:44:46.609Z","executes":325,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:14:53.625Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/1334843afe00f345eee7636cdfda2efe4b3f5eb421583140087b16ce2378d3cb.webp","original":"h