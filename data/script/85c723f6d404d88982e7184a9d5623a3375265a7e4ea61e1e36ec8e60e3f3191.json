{"slug":"The-Strongest-Battlegrounds-Devil-moveset-191330","_id":"69d2ec9ebcfd2672a43195d6","title":"Devil moveset (Saitama)","game":{"_id":"67e5e1ffb360710ec3c77d29","gameId":10449761463,"name":"The Strongest Battlegrounds","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":10449761463},"features":"Idk I just created smth out of bordem","tags":["Tsb","Moveset","Horror"],"script":"--// SETTINGS \\\\--\n\ngetgenv().Night = false -- false = night mode, true = normal\n\nloadstring(game:HttpGet(\"https://pastebin.com/raw/Ke6M8CML\"))()\n\n-- APPLY AFTER LOAD\ntask.wait(1)\n\n-- sync with script\nif getgenv().Night ~= nil then\n    _G.NightModeEnabled = getgenv().Night\n\n    if _G.NightModeEnabled then\n        if _G.applyNightMode then\n            _G.applyNightMode()\n        end\n    else\n        -- disable night\n        local Lighting = game:GetService(\"Lighting\")\n        pcall(function()\n            Lighting.ClockTime = 14\n            Lighting.Brightness = 2\n            Lighting.Ambient = Color3.fromRGB(178,178,178)\n            Lighting.OutdoorAmbient = Color3.fromRGB(178,178,178)\n            Lighting.FogStart = 0\n            Lighting.FogEnd = 1000\n            Lighting.FogColor = Color3.fromRGB(200,200,200)\n\n            for _, v in ipairs(Lighting:GetChildren()) do\n                if v.Name == \"StarringOneCC\" or v.Name == \"StarringOneBloom\" then\n                    v:Destroy()\n                end\n            end\n        end)\n    end\nend","owner":{"_id":"698246c7e96ccd295677dd38","username":"RAFAEL_4rNotRN","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"698246c7e96ccd295677dd38","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":4236,"scriptType":"free","