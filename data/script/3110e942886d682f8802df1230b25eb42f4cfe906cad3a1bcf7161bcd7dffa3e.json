{"slug":"Zombie-lab-100M-visits-FE-kill-all-script-14532","_id":"6677b922aa512eac31ffb425","title":"FE kill all script","game":{"_id":"67e5e1ffb360710ec3c78091","gameId":6741970382,"name":"Zombie lab [Equal Avatar Scale📏]","imageUrl":"/images/sb/rbx-1dedf41046c6487320de5c92ece344f0-a0f99a6e5d13.png","placeId":6741970382},"features":"Must not Be on Zombie to make script work\nThen Equip pistol then execute and it will kill every zombie \nExecute rapidly to make sure all zombie team really died","tags":[],"script":"--Equip Gun to Make Kill all work\n--- and Execute this script rapidly to Make all player in zombie died\n--- enjoy\nlocal player = game.Players.LocalPlayer\nfor i,v in ipairs(game.Players:GetPlayers()) do\n  if v.Name ~= player.Name then\n    local BH = v.Character.Humanoid or v.Character:FindFirstChild(\"Humanoid\")\n    local BK = v.Character.HumanoidRootPart or v.Character:FindFirsrChild(\"HumanoidRootPart\")\n    local args = {\n    [1] = BH,\n    [2] = BK,\n    [3] = 10,\n    [4] = Vector3.new(0.9932631850242615, 0.018498189747333527, 0.11439403146505356),\n    [5] = 2,\n    [6] = 0,\n    [7] = false\n    }\n    game:GetService(\"Players\").LocalPlayer.Character.Pistol.GunScript_Server.InflictTarget:FireServer(unpack(args))\n  end\nend\n","owner":{"_id":"666c005ac859d5f27bbbe650","username":"weenachuangkud","verified":false,"profilePicture":"/images/photo/666c005ac859d5f27bbbe650-1718354176685.jpeg","status":"offline","id":"666c005ac859d5f27bbbe650","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"keyLink":"","views":18857,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-23T05:56:50.650Z","dislikeCount":3,"likeCount":2,"image":"https://tr.rbxcdn.com/989cacc8dcbb8a07fa105763902e90ee/500/280/Image/Jpeg","executes":572,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c511da","editBy":{"_id":"666c005ac859d5f27b