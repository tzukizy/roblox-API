{"slug":"Universal-Script-Kick-gui-CS-64739","_id":"6911774315719ef48c00cd4a","title":"Kick gui CS","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1762752323817.jpg","placeId":0},"features":"Kicking player who inputed in TextBox lolll","tags":["kick","Gui","Kick","V"],"script":"-- Kick Gui CS\nlocal player = game.Players.LocalPlayer.Name\nlocal ppl = game.Players.LocalPlayer.PlayerGui\nInstance.new(\"ScreenGui\", ppl)\nppl.ScreenGui.Name = \"kick\"\nInstance.new(\"TextBox\", ppl.kick)\nlocal tb = game.Players.LocalPlayer.PlayerGui.kick.TextBox\ntb.Text = \"Username\"\ntb.Size = UDim2.new(0.3, 1, 0.1)\ntb.TextScaled = true\ntb.Draggable = true\nInstance.new(\"TextButton\", ppl.kick)\nlocal b = game.Players.LocalPlayer.PlayerGui.kick.TextButton\nb.TextScaled = true\nb.Draggable = true\nb.Text = \"Kick player\"\nb.Size = UDim2.new(0.3, 1, 0.1)\nb.MouseButton1Click:Connect(function()\nlocal pk = game.Players.LocalPlayer.PlayerGui.kick.TextBox.Text\nWorkspace[pk].Head.Anchored = true\nwait(1)\nWorkspace[pk]:Destroy()\ngame.Players[pk]:Destroy()\ngame.TextChatService.TextChannels.RBXGeneral[pk]:Destroy()\ngame.TextChatService.TextChannels.RBXSystem[pk]:Destroy()\nend)","owner":{"_id":"688f92f6b0f6492db34c9db2","username":"abobspongeb","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"688f92f6b0f6492db34c9db2","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":4213,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1762752323817.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2025-11-10T05:25:23.833Z","executes":1206,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6911774315719ef48c00cd4c","editBy":{"_id":"688f92f6b0f6492db34c9db2","username":"abobspongeb","status":"offline","id":"688f92f6b0f6492db34c9db2"},"message":"Create script","createdAt":"2025-1