{"_id":"6991ed186a2dd94ec008c9de","title":"Floating Pad F3x Made by me","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/88d5a687e6ce06e384d33d6218317eb25b1d608af394af5ef0684d21ac6f723a.webp","original":"https://scriptblox.com/images/sb/0-1771171096825.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/88d5a687e6ce06e384d33d6218317eb25b1d608af394af5ef0684d21ac6f723a.webp","original":"https://scriptblox.com/images/sb/0-1771171096825.png"},"placeId":0},"slug":"Universal-Script-Floating-Pad-F3x-Made-by-me-111926","verified":false,"key":false,"keyless":false,"views":957,"executes":2599,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f69ac86870aaba3b6c06bc02a15cadc702aaddbee59cc35fe778f43bbe48d172.webp","original":"https://scriptblox.com/images/sb/0-1771171096825.png","scriptblox":"https://scriptblox.com/images/script/0-1771171096825.png"},"thumbnail":{"url":"https://media.kocakz.me/f69ac86870aaba3b6c06bc02a15cadc702aaddbee59cc35fe778f43bbe48d172.webp","original":"https://scriptblox.com/images/sb/0-1771171096825.png","scriptblox":"https://scriptblox.com/images/script/0-1771171096825.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-15T15:58:16.845Z","updatedAt":"2026-02-15T15:58:16.845Z","lastBump":"2026-02-15T15:58:16.845Z","script":"local player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal tool\n\n\nfor _, v in player:GetDescendants() do\n    if v.Name == \"SyncAPI\" then\n        tool = v.Parent\n        break\n    end\nend\nfor _, v in game.ReplicatedStorage:GetDescendants() do\n    if v.Name == \"SyncAPI\" then\n        tool = v.Parent\n        break\n    end\nend\n\nlocal remote = tool.SyncAPI.ServerEndpoint\nlocal function Send(args) remote:InvokeServer(unpack(args)) end\n\n\nlocal function CreatePart(cf, parent)\n    Send({\"CreatePart\", \"Normal\", cf, parent})\nend\nlocal function MovePart(part, cf)\n    Send({\"SyncMove\", {{Part = part, CFrame = cf}}})\nend\nlocal function SetAnchor(bool, part)\n    Send({\"SyncAnchor\", {{Part = part, Anchored = bool}}})\nend\nlocal function SetLocked(part, bool)\n    Send({\"SetLocked\", {part}, bool})\nend\nlocal function AddMesh(part)\n    Send({\"CreateMeshes\", {{Part = part}}})\nend\nlocal function Resize(part, size, cf)\n    Send({\"SyncResize\", {{Part = part, Size = size, CFrame = cf}}})\nend\nlocal function SetColor(part, color)\n    Send({\"SyncColor\", {{Part = part, Color = color, UnionColoring = false}}})\nend\nlocal function SetCylinderMesh(part)\n    \n    local args = {\n        \"CreateMeshes\",\n        {\n            {\n                Part = part\n            }\n        }\n    }\n    Send(args)\n    -- Resize mesh\n    Send({\n        \"SyncMesh\",\n        {\n            {\n                Part = part,\n                Scale = Vector3.new(1, 0.5, 1)\n            }\n        }\n    })\nend\n\n\nlocal padCF = CFrame.new(hrp.Position.X, hrp.Position.Y - 4, hrp.Position.Z)\nCreatePart(padCF, workspace)\n\n\nlocal pad\nfor _, v in workspace:GetDescendants() do\n    if v:IsA(\"BasePart\") and (v.Position - Vector3.new(hrp.Position.X, hrp.Position.Y - 4, hrp.Position.Z)).Magnitude < 0.1 then\n        pad = v\n        break\n    end\nend\n\nif pad then\n    SetAnchor(true, pad)\n    SetLocked(pad, true)\n    Resize(pad, Vector3.new(8, 1.2, 8), pad.CFrame)\n    SetColor(pad, Color3.fromRGB(255, 105, 180))\n    SetCylinderMesh(pad)\n\n    \n    while true do\n        local targetCF = CFrame.new(hrp.Position.X, hrp.Position.Y - 4, hrp.Position.Z)\n        MovePart(pad, targetCF)\n        wait()\n    end\nend","features":"Made by me if u using this pls give creds","tags":[],"discord":"","keyLink":"","owner":{"_id":"694e306e9f586c34157887e5","username":"Official_xtr00pk1d","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8ff2bcf254db0b4c1091d80e42c5356549c840da0b9ff780dcbdb10fde0063a0.webp","original":"https://scriptblox.com/images/photo/694e306e9f586c34157887e5-1768936118236.jpg"},"status":"offline","id":"694e306e9f586c34157887e5","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/8ff2bcf254db0b4c1091d80e42c5356549c840da0b9ff780dcbdb10fde0063a0.webp","original":"https://scriptblox.com/images/photo/694e306e9f586c34157887e5-1768936118236.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:44:01.852Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6991ed186a2dd94ec008c9e1","editBy":{"_id":"694e306e9f586c34157887e5","username":"Official_xtr00pk1d","status":"offline","id":"694e306e9f586c34157887e5"},"message":"Create script","createdAt":"2026-02-15T15:58:16.850Z"}],"comments":[{"_id":"6991f49d9cc5132d60c3eda0","commentBy":{"_id":"69811c8721f3006edbf255e1","username":"skyl0rdbanned","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/9987341ce270051d71a9107d491a20583b00ee3459c0b8feab4daf3f1f54951c.webp","original":"https://scriptblox.com/images/photo/69811c8721f3006edbf255e1-1770992005807.jpg"},"lastActive":"2026-03-02T21:25:40.766Z","createdAt":"2026-02-02T21:52:07.002Z","status":"offline","id":"69811c8721f3006edbf255e1","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/9987341ce270051d71a9107d491a20583b00ee3459c0b8feab4daf3f1f54951c.webp","original":"https://scriptblox.com/images/photo/69811c8721f3006edbf255e1-1770992005807.jpg"}},"text":"stop","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-15T16:30:21.584Z","liked":false,"disliked":false},{"_id":"69924af963f1c03b3e459d27","comme