{"slug":"Universal-Script-Fe-Giant-79635","_id":"69524775426a0c4abced09d8","title":"Fe Giant","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1766999925573.jpg","placeId":0},"features":"Giant","tags":[],"script":"local Players = game:GetService(\"Players\")\n\nlocal GIANT_SIZE = 5 -- exact size (bigger than 4.2)\n\nlocal function applyGiant(character)\n\tlocal humanoid = character:WaitForChild(\"Humanoid\")\n\n\tif humanoid.RigType == Enum.HumanoidRigType.R15 then\n\t\t-- Set ABSOLUTE values (no multiplying, no stacking)\n\t\thumanoid.BodyHeightScale.Value = GIANT_SIZE\n\t\thumanoid.BodyWidthScale.Value = GIANT_SIZE\n\t\thumanoid.BodyDepthScale.Value = GIANT_SIZE\n\t\thumanoid.HeadScale.Value = GIANT_SIZE\n\telse\n\t\t-- R6 fallback (manual absolute scale)\n\t\tfor _, part in pairs(character:GetChildren()) do\n\t\t\tif part:IsA(\"BasePart\") then\n\t\t\t\tpart.Size = part.Size.Unit * GIANT_SIZE * 2\n\t\t\tend\n\t\tend\n\tend\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function(character)\n\t\ttask.wait(0.2)\n\t\tapplyGiant(character)\n\tend)\nend)","owner":{"_id":"691d8f9a5e26ef34faa8a8b5","username":"larkyqkwq","verified":false,"profilePicture":"/images/photo/691d8f9a5e26ef34faa8a8b5-1778469158595.jpg","status":"offline","id":"691d8f9a5e26ef34faa8a8b5","topMilestone":{"key":"creator.executions","tier":100000}},"verified":false,"views":4796,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1766999925573.jpg","likeCount":1,"dislikeCount":1,"createdAt":"2025-12-29T09:18:45.586Z","executes":1797,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69524775426a0c4abced09da","editBy":{"_id":"691d8f9a5e26ef34faa8a8b5","username":"larkyqkwq","status":"offline","id":"691d8f9a5e26ef34faa8a8b5"},"message":"Create script","createdAt":"2025-12-29T09:18:45.590Z"}],"comments":[{"_id":