 in pairs(character:GetChildren()) do\n\t\t\tif part:IsA(\"BasePart\") then\n\t\t\t\tpart.Size = part.Size.Unit * GIANT_SIZE * 2\n\t\t\tend\n\t\tend\n\tend\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function(character)\n\t\ttask.wait(0.2)\n\t\tapplyGiant(character)\n\tend)\nend)","features":"Giant","tags":[],"discord":"","keyLink":"","owner":{"_id":"691d8f9a5e26ef34faa8a8b5","username":"larkyqkwq","verified":false,"profilePicture":{"url":"https://media.kocakz.me/90ade107692998c01be418c1c3f7aaadb769b32b910dbb3f8af9a593bafbe514.webp","original":"https://scriptblox.com/images/photo/691d8f9a5e26ef34faa8a8b5-1778469158595.jpg"},"status":"offline","id":"691d8f9a5e26ef34faa8a8b5","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/90ade107692998c01be418c1c3f7aaadb769b32b910dbb3f8af9a593bafbe514.webp","original":"https://scriptblox.com/images/photo/691d8f9a5e26ef34faa8a8b5-1778469158595.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:35:28.587Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69524775426a0c4abced09da","editBy":{"_id":"691d8f9a5e26ef34faa8a8b5","username":"larkyqkwq","status":"offline","id":"691d8f9a5e26ef34faa8a8b5"},"message":"Create script","createdAt":"2025-12-29T09:18:45.590Z"}],"comments":[{"_id":"6954a53c5727f1f84cb19a8d","commentBy":{"_id":"694ab994426a0c4abc71a22b","username":"gorffff","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-03-01T01:45:41.828Z","createdAt":"2025-12-23T15:47:32.637Z","status":"offline","id":"694ab994426a0c4abc71a22b","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"clientsided","edited":false,"likeCount":1,"dislikeCount":0,"