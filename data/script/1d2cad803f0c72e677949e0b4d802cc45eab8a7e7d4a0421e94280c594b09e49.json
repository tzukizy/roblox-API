me\")\nframe.Size = UDim2.new(0, 200, 0, 200)\nframe.Position = UDim2.new(0.5, -100, 0.7, 0)\nframe.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\nframe.Active = true\nframe.Draggable = true -- Permite mover o teclado\nframe.Parent = screenGui\n\n-- Função para mover o personagem\nlocal speed = 10\nlocal moveVector = Vector3.new(0,0,0)\n\nlocal function updateMovement()\n    humanoidRootPart.Velocity = Vector3.new(moveVector.X, humanoidRootPart.Velocity.Y, moveVector.Z)\nend\n\n-- Detectando teclas\n","features":"Wow!! Teclado virtual","tags":[],"discord":"https://discord.gg/uSrzCTqGA","keyLink":"https://discord.gg/uSrzCTqGA","owner":{"_id":"68e1dc3b0490b777bce88636","username":"EujogadordeRoblox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":7,"status":"offline","id":"68e1dc3b0490b777bce88636","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:50:47.560Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"690437f86eb14cb501fdb321","editBy":{"_id":"68e1dc3b0490b777bce88636","username":"EujogadordeRoblox","status":"offline","id":"68e1dc3b0490b777bce88636"},"message":"Create script","createdAt":"2025-10-31T04:15:52.903Z"}],"comments":[]}