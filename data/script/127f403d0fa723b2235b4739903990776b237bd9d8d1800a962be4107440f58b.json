yCode == Enum.KeyCode.P then\n        running = false\n    end\nend)\n\nwhile running do\n    local player = game.Players.LocalPlayer\n    local char = player.Character or player.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n    local niga = workspace.Map.Spawn\n\n    for _, v in ipairs(niga:GetDescendants()) do\n        if not running then break end -- stop early if user pressed P\n        if v:IsA(\"ProximityPrompt\") then\n            hrp.CFrame = v.Parent.Parent.CFrame\n            task.wait(0.1)\n            fireproximityprompt(v)\n            task.wait(0.05)\n        end\n    end\n\n    if not running then break end\n    task.wait(120) -- 2 minutes\nend\n","features":"tps u to herb u do have to re execute it once in a while idk why i dont do much scripting","tags":[],"discord":"","keyLink":"","owner":{"_id":"674c641a2dee6ec27128c5f7","username":"4dclo","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fa013048cdc8adb669abca42f58260203849dd6db8f8510b912143dce7033e8c.webp","original":"https://scriptblox.com/images/photo/674c641a2dee6ec27128c5f7-1758716285125.png"},"lvl":8,"status":"offline","id":"674c641a2dee6ec27128c5f7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/fa013048cdc8adb669abca42f58260203849dd6db8f8510b912143dce7033e8c.webp","original":"https://scriptblox.com/images/photo/674c641a2dee6ec27128c5f7-1758716285125.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:40:01.641Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693197f736df090220c8cf59","editBy":{"_id":"674c641a2dee6ec27128c5f7","username":"4dclo","status":"offline","id":"674c641a2dee6ec27128c5f7"},"message":"Create script","createdAt":"2025-12-04T14:17:27.317Z"},{"_id":"6931980b4313af27e416b1bc","editBy