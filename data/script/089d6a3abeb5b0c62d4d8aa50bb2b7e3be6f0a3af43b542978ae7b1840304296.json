{"slug":"Universal-Script-Hitbox-26004","_id":"6779159d6a6add31304e5c58","title":"Simple Hitbox","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"•Simple hitbox\n\n-You can adjust the hitbox by adjusting it in Headsize\n- Recommended hitbox might be 10-15,20 might be too large\n-works on many games","tags":[],"script":"_G.HeadSize = 20\n_G.Disabled = true\n\ngame:GetService('RunService').RenderStepped:connect(function()\nif _G.Disabled then\nfor i,v in next, game:GetService('Players'):GetPlayers() do\nif v.Name ~= game:GetService('Players').LocalPlayer.Name then\npcall(function()\nv.Character.HumanoidRootPart.Size = Vector3.new(_G.HeadSize,_G.HeadSize,_G.HeadSize)\nv.Character.HumanoidRootPart.Transparency = 0.7\nv.Character.HumanoidRootPart.BrickColor = BrickColor.new(\"Really white\")\nv.Character.HumanoidRootPart.Material = \"white\"\nv.Character.HumanoidRootPart.CanCollide = false\nend)\nend\nend\nend\nend)","owner":{"_id":"6693b04748803f8f0004d1c7","username":"Kiyoooo","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6693b04748803f8f0004d1c7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":7235,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-01-04T11:03:57.551Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/82c4d781d6ab5bac31f3bf5f19e2ad497fa5df7e3cfbe108c7c2443748272a6e.webp","original":"https://scriptblox.com/images/sb/4707728-1735988637459.png","scriptblox":"https://scriptblox.com/images/script/4707728-1735988637459.png"},"executes":878,"keyless":false,"liked":false