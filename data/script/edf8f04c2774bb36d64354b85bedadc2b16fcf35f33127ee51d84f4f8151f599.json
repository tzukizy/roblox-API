{"_id":"62ff1c1d74e75bac06a44831","title":"Auto player","game":{"_id":"67e5e1ffb360710ec3c7875a","gameId":9733390246,"name":"Stair Mania!","imageUrl":{"url":"https://media.kocakz.me/44eca53f5a1eb89133586588a699b34408a95d557943b4f766b6e7568741277b.webp","original":"https://scriptblox.com/images/sb/rbx-e0bf01a42ed713c3b43dccf373e872d4-9d0845dc96d6.png"},"slug":"9733390246-stair-mania","path":"/game/9733390246-stair-mania","thumbnail":{"url":"https://media.kocakz.me/44eca53f5a1eb89133586588a699b34408a95d557943b4f766b6e7568741277b.webp","original":"https://scriptblox.com/images/sb/rbx-e0bf01a42ed713c3b43dccf373e872d4-9d0845dc96d6.png"},"placeId":9733390246},"slug":"New-Crates!-Stair-Tappers!-Auto-player-4995","verified":false,"key":false,"keyless":false,"views":13487,"executes":13,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/ae4ce5d175e42c716189add80e702ebf/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/ae4ce5d175e42c716189add80e702ebf/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/ae4ce5d175e42c716189add80e702ebf/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/ae4ce5d175e42c716189add80e702ebf/500/280/Image/Jpeg"},"likeCount":9,"dislikeCount":1,"createdAt":"2022-08-19T05:14:05.896Z","updatedAt":"2022-08-19T05:14:05.896Z","lastBump":"2022-08-19T05:14:05.896Z","script":"-- press q to toggle\nlocal speed = 0.1 -- lower = faster (going too fast may break it, i recommend 0.1 lowest)\nlocal randomizeSpeed = true -- will randomize your speed by a small value to look more legit\n\n-- services\nlocal players = game:GetService(\"Players\")\nlocal replicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal userInputService = game:GetService(\"UserInputService\")\n\n-- variables\nlocal player = players.LocalPlayer\nlocal info = player.PlayerGui.GameplayGUI.Timer.Title\nlocal playerScripts = player.PlayerScripts\nlocal characterModule = require(playerScripts.GameClient.CharacterModule)\nlocal character = characterModule:WaitFor(player)\nlocal primaryPart = character.PrimaryPart\nlocal startEvent = replicatedStorage.Remotes.StartRE\nlocal stairs = workspace.Stairs\nlocal enabled = true\n\n-- toggle\nuserInputService.InputBegan:Connect(function(input, procesing)\n  if (not processing) then\n      if (input.KeyCode == Enum.KeyCode.Q) then\n          enabled = not enabled\n      end\n  end\nend)\n\n-- autoplay\nlocal moveLeft, moveRight = nil, nil\n\nfor index, func in ipairs(getgc()) do\n  if (type(func) == \"function\") then\n      if (getinfo(func, \"n\").name == \"MoveLeft\") then\n          moveLeft = func\n      elseif (getinfo(func, \"n\").name == \"MoveRight\") then\n          moveRight = func\n      end\n  end\nend\n\nlocal random = Random.new(math.random(1, 1000))\n\nlocal function getClosestStairDirection()\n  local closestDistance, closestStair = math.huge, nil\n\n  for index, stair in ipairs(stairs:GetChildren()) do\n      local distance = (primaryPart.Position - stair.Position).Magnitude\n\n      if (distance < closestDistance and distance ~= 1.75 and stair.Transparency ~= 1) then\n          closestDistance = distance\n          closestStair = stair\n      end\n  end\n\n  return primaryPart.Position.Z <= closestStair.Position.Z and \"left\" or \"right\"\nend\n\nlocal function autoPlay()\n  stairs:WaitForChild(\"Stair\") -- wait for stairs to be added\n\n  while task.wait(randomSpeed and speed + random:NextNumber(-0.01, 0.05) or speed) do\n      if (stairs:FindFirstChild(\"Stair\")) then -- confirming the round hasn't ended\n          if (info.Text ~= \"Begining In...\" and enabled) then -- waiting til round starts and checking if enabled (both not good method idc)\n              local direction = getClosestStairDirection()\n\n              if (direction == \"left\") then\n                  moveLeft(nil, Enum.UserInputState.Begin)\n              else\n                  moveRight(nil, Enum.UserInputState.Begin)\n              end\n          end\n      else\n          break\n      end\n  end\nend\n\nstartEvent.OnClientEvent:Connect(autoPlay)\n\nif (stairs:FindFirstChild(\"Stair\")) then\n  autoPlay()\nend","features":"you can change the speed and randomness on the top 2 lines, press q to disable/enable","tags":[],"discord":"","keyLink":"","owner":{"_id":"62329bdf33d05e4bc9d5e615","username":"Walmart","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62329bdf33d05e4bc9d5e615","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:27:10.157Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e6e6","editBy":{"_id":"62329bdf33d05e4bc9d5e615","username":"Walmart","status":"offline","id":"62329bdf33d05e4bc9d5e615"},"message":"Create script","createdAt":"2025-03-27T21:39:50.019Z"}],"comments":[{"_id":"62ff94a374e75bac06a611d8","commentBy":{"_id":"62ff91216aee4e6eff035542","username":"YEETUSMCSKEETUS2052","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-08-19T13:33:21.658Z","lastActive":"2022-10-04T18:31:47.481Z","status":"offline","id":"62ff91216aee4e6eff035542","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"gud script","createdAt":"2022-08-19T13:48:19.326Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"62ff9a3ba9946ba07d4cc587","commentBy":{"_id":"62f6706974e75bac067fb784","username":"Foreverekk","verified":false,"role":"user","profil