part.BrickColor = BrickColor.new(\"Bright blue\")\npart.Parent = workspace\n\nc.Parent = nil\nhrp0.Parent = hrp1\nhrp0.RootJoint.Part0 = nil\nhrp1.Parent = c\nc.Parent = workspace\n\n\nlocal animId = \"rbxassetid://215384594\"\nlocal anim = Instance.new(\"Animation\")\nanim.AnimationId = animId\nlocal humanoid = c:WaitForChild(\"Humanoid\")\nlocal animTrack = humanoid:LoadAnimation(anim)\n    \n\n\n\n\nlocal h = game:GetService(\"RunService\").Heartbeat\nwhile h:Wait() and c and c.Parent do\n\nhumanoid.HipHeight = height\nhumanoid.JumpPower = 20\nanimTrack:Play()\nanimTrack:AdjustSpeed(0)\nanimTrack.TimePosition = 0.4\n    hrp0.CFrame = hrp1.CFrame \n    hrp0.Orientation = Vector3.new(90, 0, 0)\n    hrp0.Position = hrp1.Position - Vector3.new(0, hrp0.Size.Y / 2, 0) \n    hrp0.Velocity = hrp1.Velocity\n\n    part.Position = hrp0.Position + Vector3.new(-0.05, 0, 2.45)\nend\n","features":"What it do? \nIt makes you invisible but not with ur chat\n\nProof : https://youtu.be/XHhts-mbaN8?si=Dm604OZxrjVgA8n5\n\nIt may looks flying on your side\nBut not with other people\n\nOnly works on r6\nYou can check IS IT FE using alt\nDont ask random people because most of them are lying\n\ni want to make \nthe proof video later but,\n\n i have math test LITERALLY TODAY\nI hate schoool.....","tags":["Gazer","Gaze","Fe","Fe invisible"],"discord":"","keyLink":"","owner":{"_id":"6613887449e51a628a3b7ecd","username":"Gazer_HA","verified":false,"profilePicture":{"url":"https://media.kocakz.me/02ad5428738b7f0f9c3b35629ae14108e1a5abcff94ece882125a2d12a155c3c.webp","original":"https://scriptblox.com/images/photo/6613887449e51a628a3b7ecd-1733156111372.jpg"},"status":"offline","id":"6613887449e51a628a3b7ecd","profile":{"url":"https://media.kocakz.me/02ad5428738b7f0f9c3b35629ae14108e1a5abcff94ece882125a2d12a155c3c.webp","original":"https://scriptblox.com/images/photo/6613887449e51a628a3b7ecd-1733156111372.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":nu