ed = false\nend)\n\n-- Força comportamento de mouse\nUserInputService.MouseIcon = \"rbxasset://textures/ArrowFarCursor.png\" -- cursor padrão do Roblox\n\n-- Mantém o cursor sempre ativo\nUserInputService:GetPropertyChangedSignal(\"MouseIconEnabled\"):Connect(function()\n    if not UserInputService.MouseIconEnabled then\n        UserInputService.MouseIconEnabled = true\n    end\nend)\n\n-- Tenta impedir que o jogo volte pro modo touch\nlocal function forcePC()\n    UserInputService.MouseIconEnabled = true","features":"Um script de cursor pc","tags":[],"discord":"","keyLink":"","owner":{"_id":"68e1dc3b0490b777bce88636","username":"EujogadordeRoblox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":7,"status":"offline","id":"68e1dc3b0490b777bce88636","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-20T15:30:10.333Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:26:32.199Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ad6aa637535261eefe05163","editBy":{"_id":"68e1dc3b0490b777bce88636","username":"EujogadordeRoblox","status":"offline","id":"68e1dc3b0490b777bce88636"},"message":"Create script","createdAt":"2026-10-19T23:40:19.350Z"}],"comments":[]}