n\nButton.MouseButton1Click:Connect(function()\n    local EconomyService = ReplicatedStorage:WaitForChild(\"Packages\"):WaitForChild(\"Knit\")\n        :WaitForChild(\"Services\"):WaitForChild(\"EconomyService\")\n\n    for i = 1, 8 do\n        pcall(function()\n            EconomyService.RE.ClaimPlaytimeReward:FireServer(i)\n        end)\n        wait(0.2)\n    end\n\n    game.StarterGui:SetCore(\"SendNotification\", {\n        Title = \"HUB POBREZA!\";\n        Text = \"Recompensas coletadas! Reiniciando...\";\n        Duration = 3;\n    })\n\n    wait(2)\n    TeleportService:Teleport(game.PlaceId, player)\nend)\n","owner":{"_id":"67e754c67a05e7dd83d88f59","username":"Mano_Gustavo","verified":false,"profilePicture":"/images/photo/67e754c67a05e7dd83d88f59-1767493758654.png","status":"offline","id":"67e754c67a05e7dd83d88f59","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":9668,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/100759070542523-1746378832916.png","likeCount":4,"dislikeCount":4,"createdAt":"2025-05-04T17:13:52.948Z","executes":59,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6817a05013f9d19da3b6f286","editBy":{"_id":"67e754c67a05e7dd83d88f59","username":"Mano_Gustavo","status":"offline","id":"67e754c67a05e7dd83d88f59"},"message":"Create script","createdAt":"2025-05-04T17:13:52.951Z"}],"comments":[{"_id":"6817a1e243dcc7280d696f38","commentBy":{"_id":"68164bef43dcc7280d1b8e45","username":"elimiqueiasero","verified":false,"role":"user","profilePicture":"/images/photo/68164bef43dcc7280d1b8e45-1768140569764.png","createdAt":"2025-05-03T17:01:35.305Z","lastActive":"2026-03-18T17:09:17.247Z","status":"offline","id":"68164bef43dcc7280d1b8e45"},"text":"REINICIANDO WHAT","edited":false,"likeCount":3,"dislikeCount":0,"createdAt":"2025-05-04T17:20:34.559Z","liked":false,"disliked":false},{"_id":"6817a270605aada39a875bdb","commentBy":