{"slug":"Universal-Script-Just-a-script-that-sets-your-walkspeed-to-50-CHATGPT-SCRIPT-43972","_id":"6868ba83a429560935975568","title":"Just a script that sets your walkspeed to 50 CHATGPT SCRIPT","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Sets your walkspeed to 50","tags":[],"script":"-- Place this in a LocalScript (e.g., StarterPlayerScripts)\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- Wait for the character to load\nplayer.CharacterAdded:Connect(function(character)\n\tlocal humanoid = character:WaitForChild(\"Humanoid\")\n\thumanoid.WalkSpeed = 16\nend)\n\n-- If the character is already loaded when the script runs\nif player.Character then\n\tlocal humanoid = player.Character:FindFirstChild(\"Humanoid\")\n\tif humanoid then\n\t\thumanoid.WalkSpeed = 16\n\tend\nend","owner":{"_id":"66fd7017e9a9aa97b1df181d","username":"oguk336","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"66fd7017e9a9aa97b1df181d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":1371,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/a6d6d1c4a40b61e9a14847e8d11daefa7e0293535973b6497d5fc8afd122551d.webp","original":"https://scriptblox.com/images/sb/0-1751693955238.png","scriptblox":"https://scriptblox.com/images/script/0-1751693955238.png"},"likeCount":0,"dislikeCount":2,"createdAt":"2025-07-05T05:39:15.295Z","executes":4,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":