{"slug":"Universal-Script-Simple-speed-script-11770","_id":"6605c7cfac898ccd8e12146f","title":"Simple speed script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/5838988-1711654862986.webp","placeId":0},"features":"Simple speed script \n\n\n\n\nThe speed is adjustable in the script \n\n\n\n\nMade by me","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal humanoid = player.Character:WaitForChild(\"Humanoid\")\n\nlocal maxSpeed = 100 -- The maximum speed you want the player to reach\nlocal speedIncrease = 5 -- How much to increase the player's speed each step\nlocal speedInterval = 1 -- How often (in seconds) to increase the player's speed\n\nwhile true do\n    if humanoid.Health <= 0 then\n        break\n    end\n    \n    local currentSpeed = humanoid.WalkSpeed\n    if currentSpeed < maxSpeed then\n        humanoid.WalkSpeed = currentSpeed + speedIncrease\n    end\n    \n    wait(speedInterval)\nend\n","owner":{"_id":"65b8a20adf6ad39575b9f441","username":"SandDune","verified":false,"profilePicture":"/images/photo/65b8a20adf6ad39575b9f441-1762465404382.jpg","status":"offline","id":"65b8a20adf6ad39575b9f441","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"keyLink":"","views":12558,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-03-28T19:41:03.006Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/5838988-1711654862986.webp","executes":332,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c507ce","editBy":{"_id":"65b8a20adf6ad39575b9f441","username":"SandDune","status":"offline","id":"65b8a20adf6ad39575b9f441"},"message":"Create script","createdAt":"2025-03-27T22:13:57.024Z"}],"comments":[{"_id":"6605c7e771328c5de71f11f3","commentBy":{"_id":"65b8a20adf6ad39575b9f441","username":"SandDune","verified":false,"role":"user","profilePicture":"/images/photo/65b8a