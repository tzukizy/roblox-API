{"_id":"678cf8c64705b125894207d7","title":"open source skin changer","game":{"_id":"67e5e1ffb360710ec3c77d59","gameId":17625359962,"name":"[🎃] RIVALS","imageUrl":{"url":"https://media.kocakz.me/c63f148d9f47d6f6e8544ab6423e581017e150ada16e8954529cdfbe5e45467f.webp","original":"https://tr.rbxcdn.com/180DAY-b2b718b190726ac0e498f3fd3afc30d9/150/150/Image/Png/noFilter"},"slug":"17625359962-rivals","path":"/game/17625359962-rivals","thumbnail":{"url":"https://media.kocakz.me/c63f148d9f47d6f6e8544ab6423e581017e150ada16e8954529cdfbe5e45467f.webp","original":"https://tr.rbxcdn.com/180DAY-b2b718b190726ac0e498f3fd3afc30d9/150/150/Image/Png/noFilter"},"placeId":17625359962},"slug":"RIVALS-open-source-skin-changer-27226","verified":false,"key":false,"keyless":false,"views":26167,"executes":560,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-cb065f8df04f27913778c97988b76955/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-cb065f8df04f27913778c97988b76955/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-cb065f8df04f27913778c97988b76955/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-cb065f8df04f27913778c97988b76955/500/280/Image/Jpeg/noFilter"},"likeCount":4,"dislikeCount":0,"createdAt":"2025-01-19T13:06:14.027Z","updatedAt":"2025-01-19T13:06:14.027Z","lastBump":"2025-01-19T13:06:14.027Z","script":"local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()\nlocal Window = OrionLib:MakeWindow({Name = \"HEXWARE\", HidePremium = false, SaveConfig = true, ConfigFolder = \"WeaponSkins\"})\n\nlocal Tab = Window:MakeTab({\n    Name = \"HEXWARE SKIN CHANGER\",\n    Icon = \"rbxassetid://4483345998\",\n    PremiumOnly = false\n})\n\nlocal weaponSkins = { -- Weapon skins table\n    [\"Bow\"] = {\"Compound Bow\", \"Raven Bow\"},\n    [\"Assault Rifle\"] = {\"AK-47\", \"AUG\", \"Boneclaw Rifle\"},\n    [\"Chainsaw\"] = {\"Blobsaw\", \"Handsaws\"},\n    [\"RPG\"] = {\"Nuke Launcher\", \"RPKEY\", \"Spaceship Launcher\"},\n    [\"Burst Rifle\"] = {\"Aqua Burst\", \"Electro Rifle\"},\n    [\"Exogun\"] = {\"Singularity\", \"Wondergun\"},\n    [\"Fists\"] = {\"Boxing Gloves\", \"Brass Knuckles\"},\n    [\"Flamethrower\"] = {\"Lamethrower\", \"Pixel Flamethrower\"},\n    [\"Flare Gun\"] = {\"Dynamite Gun\", \"Firework Gun\"},\n    [\"Freeze Ray\"] = {\"Bubble Ray\", \"Temporal Ray\"},\n    [\"Grenade\"] = {\"Water Balloon\", \"Whoopee Cushion\"},\n    [\"Grenade Launcher\"] = {\"Swashbuckler\", \"Uranium Launcher\"},\n    [\"Handgun\"] = {\"Blaster\"},\n    [\"Katana\"] = {\"Lightning Bolt\", \"Saber\"},\n    [\"Minigun\"] = {\"Lasergun 3000\", \"Pixel Minigun\"},\n    [\"Paintball Gun\"] = {\"Boba Gun\", \"Slime Gun\"},\n    [\"Revolver\"] = {\"Sheriff\", \"Desert Eagle\"},\n    [\"Slingshot\"] = {\"Goalpost\", \"Stick\"},\n    [\"Subspace Tripmine\"] = {\"Don't Press\", \"Spring\"},\n    [\"Uzi\"] = {\"Electro Uzi\", \"Water Uzi\"},\n    [\"Sniper\"] = {\"Pixel Sniper\", \"Hyper Sniper\", \"Eyething Sniper\"},\n    [\"Knife\"] = {\"Karambit\", \"Chancla\", \"Keyper\"},\n[\"Scythe\"] = {\"Anchor\", \"Scythe of Death\", \"Keythe\"},\n[\"Medkit\"] = {\"Laptop\", \"Sandwich\", \"Brief Case\"},\n}\n\nlocal assetFolder = game:GetService(\"Players\").LocalPlayer.PlayerScripts.Assets.ViewModels\nlocal activeWeapons = {}\n\n-- Function to swap weapon skins\nlocal function swapWeaponSkins(normalWeaponName, skinName, State)\n    if not normalWeaponName then\n        return\n    end\n    \n    local normalWeapon = assetFolder:FindFirstChild(normalWeaponName)\n    if not normalWeapon then\n        return\n    end\n\n    if State then\n        if skinName then\n            local skin = assetFolder:FindFirstChild(skinName)\n            if not skin then\n                return\n            end\n\n            normalWeapon:ClearAllChildren()\n            for _, child in pairs(skin:GetChildren()) do\n                local newChild = child:Clone()\n                newChild.Parent = normalWeapon\n            end\n            activeWeapons[normalWeaponName] = true\n        end\n    else\n        activeWeapons[normalWeaponName] = nil\n    end\nend\n\n-- UI for each weapon and its skins\nfor weapon, skins in pairs(weaponSkins) do\n    Tab:AddDropdown({\n        Name = weapon .. \" Skin Selector\",\n        Options = skins,\n        Callback = function(selectedSkin)\n            swapWeaponSkins(weapon, selectedSkin, true)\n        end\n    })\n\n    Tab:AddToggle({\n        Name = \"Enable \" .. weapon .. \" Skin\",\n        Default = false,\n        Callback = function(state)\n            if not state then\n                swapWeaponSkins(weapon, nil, false)\n            end\n        end\n    })\nend\n\nOrionLib:Init()","features":"skin changer\nhexware\nmost appreaciated if u can give credits","tags":["skin changer","rivals"],"discord":"","keyLink":"","owner":{"_id":"6745fe384be79be70ff77891","username":"HEXWARE","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6745fe384be79be70ff77891","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:11:14.018Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c543d2","editBy":{"_id":"6745fe384be79be70ff77891","username":"HEXWARE","status":"offline","id":"6745fe384be79be70ff77891"},"message":"Create script","createdAt":"2025-03-27T14:09:23.312Z"}],"comments":[{"_id":"678cfbf2001adb21041fc289","commentBy":{"_id":"66d366afde53e6feb7