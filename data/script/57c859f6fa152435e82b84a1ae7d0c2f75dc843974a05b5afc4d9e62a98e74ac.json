 gunSettings = require(gunHolding.Setting[\"1\"])\ngunSettings.BaseDamage = _G.GunDMG\nlocal InflictTarget = game.ReplicatedStorage.Remotes.InflictTarget\n\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input,gpe)\n    if input.KeyCode == Enum.KeyCode[_G.KillKeybind] and not gpe then\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Humanoid2\") and v.Humanoid2.Health >=0.0001 then\n                task.spawn(function() -- why task.spawn? it does it asynchronously (it kills them all at once basically)\n                    InflictTarget:InvokeServer(\n                        \"Gun\",\n                        gunHolding,\n                        gunSettings,\n                        v.Humanoid2,\n                        v.HumanoidRootPart,\n                        v.Head,\n                        {},\n                        250_000\n                    )\n                end)\n            end\n        end\n    end\nend)\n","features":"Kill all Zombies","tags":[],"discord":"","keyLink":"","owner":{"_id":"63376ca096ada006e9ea41d4","username":"yaar","verified":false,"profilePicture":{"url":"https://media.kocakz.me/be80da9914cd6cb05135ad7e828e6d5e1c69780075597bc4720a5ce5c8b01c5a.webp","original":"https://scriptblox.com/images/photo/63376ca096ada006e9ea41d4-1745705271858.png"},"status":"offline","id":"63376ca096ada006e9ea41d4","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/be80da9914cd6cb05135ad7e828e6d5e1c69780075597bc4720a5ce5c8b01c5a.webp","original":"https://scriptblox.com/images/photo/63376ca096ada006e9ea41d4-1745705271858.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:08:18.906Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6810271da89fd911d9bc58ec","editBy":{"_id":"63376ca0