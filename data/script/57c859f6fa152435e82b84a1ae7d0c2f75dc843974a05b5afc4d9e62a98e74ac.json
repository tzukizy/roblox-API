{"slug":"The-Backrooms-With-Guns-Kill-All-En*ies-38011","_id":"6810271da89fd911d9bc58ea","title":"Kill All Zombies","game":{"_id":"67e5e1ffb360710ec3c78739","gameId":8455137364,"name":"The Backrooms With Guns","imageUrl":"/images/sb/rbx-1065d54fd276f4159a7786ed170e95ce-ede2cb8cdc15.png","placeId":8455137364},"features":"Kill all Zombies","tags":[],"script":"_G.GunDMG = 9e9 -- _G because this game is so shit it wont be detected. Switch to getgenv() if you care to.\n-- also, negative dmg adds health to zombies in all modes and to plrs in survival/pvp mode\n_G.KillKeybind = \"E\"\n\nlocal gunHolding = game.Players.LocalPlayer.Character:FindFirstChildWhichIsA(\"Tool\") or game.Players.LocalPlayer.Backpack[\"M4A1\"]\nlocal gunSettings = require(gunHolding.Setting[\"1\"])\ngunSettings.BaseDamage = _G.GunDMG\nlocal InflictTarget = game.ReplicatedStorage.Remotes.InflictTarget\n\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input,gpe)\n    if input.KeyCode == Enum.KeyCode[_G.KillKeybind] and not gpe then\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Humanoid2\") and v.Humanoid2.Health >=0.0001 then\n                task.spawn(function() -- why task.spawn? it does it asynchronously (it kills them all at once basically)\n                    InflictTarget:InvokeServer(\n                        \"Gun\",\n                        gunHolding,\n                        gunSettings,\n                        v.Humanoid2,\n                        v.HumanoidRootPart,\n                        v.Head,\n                        {},\n                        250_000\n                    )\n                end)\n            end\n        end\n    end\nend)\n","owner":{"_id":"63376ca096ada006e9ea41d4","username":"yaar","verified":false,"profilePicture":"/images/photo/63376ca096ada006e9ea41d4-1745705271858.png","status":"offline","id":"63376ca096ada006e9ea41d4","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":7337,