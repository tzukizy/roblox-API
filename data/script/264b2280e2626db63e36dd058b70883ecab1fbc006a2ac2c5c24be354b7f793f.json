{"slug":"ORCS-Solo-Hunters-Kill-Aura-144561","_id":"69c0fdb79a8c747fb0a589c6","title":"Kill Aura","game":{"_id":"69733b4c92a4802284668feb","gameId":136599248168660,"name":"[ORCS] Solo Hunters","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":136599248168660},"features":"Kill Aura for Solo Hunters\n\nhttps://discord.gg/8wSP7XedR8","tags":[],"script":"-- https://discord.gg/8wSP7XedR8\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal CollectionService = game:GetService(\"CollectionService\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character\n\nlocal Comm = require(ReplicatedStorage.ReplicatedStorage.Packages.Comm)\nlocal CombatService = Comm.ClientComm.new(game.ReplicatedStorage.RemoteServices, false, \"CombatService\"):BuildObject()\n\nlocal function autoAttack()\n    if not character or not character:FindFirstChild(\"HumanoidRootPart\") then return end\n    \n    local mobs = {}\n    for _, mob in CollectionService:GetTagged(\"Mob\") do\n        if mob:IsDescendantOf(workspace) and mob:FindFirstChild(\"Humanoid\") then\n            local humanoid = mob.Humanoid\n            if humanoid.Health > 0 then\n                local distance = (mob:GetPivot().Position - character:GetPivot().Position).Magnitude\n                if distance <= 50 then\n                    table.insert(mobs, mob)\n                    if #mobs >= 5 then break end\n                end\n            end\n        end\n    end\n    \n    if #mobs > 0 then\n        CombatService:UseWeapon(1, mobs, 1, nil)\n    end\nend\n\nwhile true do\n    wait(0.1)\n    autoAttack()\nend","owner":{"_id":"68b632c70c09be736fe3459d","username":"megaskidwtf","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0949d69ea5f85e248abe650efad65928380e6745d3bafd488f5aa0b8884a3764.webp","original":"https://scriptblo