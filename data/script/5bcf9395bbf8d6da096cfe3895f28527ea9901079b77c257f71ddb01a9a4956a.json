end\n    end\nend\nlocal function resizeParts(player)\n    task.wait(0.1)\n    if isHostile(player) then\n        for i,v in ipairs(player.Hitbox:GetDescendants()) do\n            if v:IsA(\"BasePart\") then\n                local boxHandle = Instance.new(\"BoxHandleAdornment\")\n                boxHandle.Adornee = v\n                boxHandle.Transparency = 0.9\n                boxHandle.ZIndex = 10\n                boxHandle.AlwaysOnTop = true\n                v.Size = Vector3.new(3,3,3)\n                boxHandle.Size = v.Size+Vector3.new(0.1,0.1,0.1)\n                boxHandle.Parent = v\n            end\n        end\n    end\nend\nfor i,v in ipairs(workspace.Characters:GetChildren()) do\n    resizeParts(v)\nend\nworkspace.Characters.ChildAdded:Connect(resizeParts)","owner":{"_id":"61afb8b7047ce2dcaea84d13","username":"Shaymin","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/7c0327b842d958c476a187cfb88e6bd6f60c5ac21fa6ed2664f50f805712e85d.webp","original":"https://scriptblox.com/images/photo/61afb8b7047ce2dcaea84d13-1721572256064.png"},"status":"offline","id":"61afb8b7047ce2dcaea84d13","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://cdn.kocakz.me/images/7c0327b842d958c476a187cfb88e6bd6f60c5ac21fa6ed2664f50f805712e85d.webp","original":"https://scriptblox.com/images/photo/61afb8b7047ce2dcaea84d13-1721572256064.png"}},"verified":true,"views":194746,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-04-21T21:04:39.884Z","dislikeCount":1,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/d6a3332faaa54d1546ccb0c817e6397f/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/d6a3332faaa54d1546ccb0c817e6397f/500/280/Image/Jpeg"},"executes":81,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"re