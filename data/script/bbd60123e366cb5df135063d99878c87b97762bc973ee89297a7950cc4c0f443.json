ootPart.CFrame = Workspace.Slendrina.Head.CFrame * CFrame.new(0, 5, 0)\n  for _, part in next, workspace:GetPartBoundsInRadius(game.Players.LocalPlayer.Character.HumanoidRootPart.Position, 40) do\n    if part:FindFirstChild(\"TouchInterest\") then\n      for _, player in next, game.Players:GetPlayers() do\n         if player ~= game.Players.LocalPlayer and workspace:FindFirstChild(player.Name) then\n           for _, parte in next, player.Character:GetChildren() do\n             if parte:IsA(\"BasePart\") then\n               task.spawn(function()\n                 firetouchinterest(part, parte, 0)\n                 firetouchinterest(part, parte, 1)\n               end)\n             end\n           end\n         end\n       end\n     end\n   end\n end\nend","features":"Well, you can just kill all the players, but only if the NPC is not bugged or simply not there","tags":[],"discord":"","keyLink":"","owner":{"_id":"657de6ff3fc064145583e6bb","username":"ADSKer","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2ae6130da4a974a813eac45e8abf647a9f77a288fc5f80d9618fdf295fe6484f.webp","original":"https://scriptblox.com/images/photo/657de6ff3fc064145583e6bb-1711768867821.jpg"},"lvl":18,"status":"offline","id":"657de6ff3fc064145583e6bb","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/2ae6130da4a974a813eac45e8abf647a9f77a288fc5f80d9618fdf295fe6484f.webp","original":"https://scriptblox.com/images/photo/657de6ff3fc064145583e6bb-1711768867821.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:01:24.724Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6846438bac49f0aca7000ab9","editBy":{"_id":"657de6ff3fc064145583e6bb","username":"ADSKer","status":"offline","id":"657de6ff3fc064145583e6bb"},"message":"Create script","createdAt":"