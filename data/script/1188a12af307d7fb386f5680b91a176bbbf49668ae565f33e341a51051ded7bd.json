ndFirstChild(\"Head\") and plc:FindFirstChild(\"Pistol\") then\nlocal plh = plc:FindFirstChild(\"Pistol\").Handle.Position\nlocal npcpo = v:FindFirstChild(\"Head\").Position\nlocal res = (npcpo-plh).Unit\nif v.Humanoid.Health >= 0.1 then\nlocal args = {\n\tvector.create(plh.X, plh.Y, plh.Z),\n\tvector.create(res.X,res.Y,res.Z),\n    v:FindFirstChild(\"Head\"),\n\tvector.create(npcpo.X,npcpo.Y,npcpo.Z)\n}\ngame:GetService(\"Players\").LocalPlayer.Character:WaitForChild(\"Pistol\"):WaitForChild(\"Fire\"):FireServer(unpack(args))\nend\nend\nend\n\n\nend\nend","features":"It just equips your weapon and auto headshots","tags":["Shoot and eat RETROS"],"discord":"","keyLink":"","owner":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68309d74aef6b0af636efd8a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-09T12:57:05.758Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:25:23.625Z","last":"w","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ac211455209ac6c41055051","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"message":"Create script","createdAt":"2026-10-04T08:41:41.339Z"},{"_id":"6ac212a0160745b10f11956e","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"message":"Update script","createdAt":"2026-10-04T08:47:28.586Z"}],"comments":[]}