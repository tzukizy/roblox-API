{"_id":"686986b7ee47165092d893d6","title":"Super guy GUI maybe serversided","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/eeb83045464e1b1512ce52d436595b18cdedb1122ab9f1b42532846cef2730e1.webp","original":"https://scriptblox.com/images/sb/0-1751746231272.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/eeb83045464e1b1512ce52d436595b18cdedb1122ab9f1b42532846cef2730e1.webp","original":"https://scriptblox.com/images/sb/0-1751746231272.png"},"placeId":0},"slug":"Universal-Script-Super-guy-GUI-clientsided-44064","verified":false,"key":false,"keyless":false,"views":6893,"executes":32,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/1fa97e5cf4668cc5b12a5729a94731372e9291d13d4c1c0d09254df5d034841d.webp","original":"https://scriptblox.com/images/sb/0-1751746231272.png","scriptblox":"https://scriptblox.com/images/script/0-1751746231272.png"},"thumbnail":{"url":"https://media.kocakz.me/1fa97e5cf4668cc5b12a5729a94731372e9291d13d4c1c0d09254df5d034841d.webp","original":"https://scriptblox.com/images/sb/0-1751746231272.png","scriptblox":"https://scriptblox.com/images/script/0-1751746231272.png"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-07-05T20:10:31.306Z","updatedAt":"2025-07-05T20:10:31.306Z","lastBump":"2025-07-05T20:10:31.306Z","script":"\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- Create GUI\nlocal gui = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\ngui.Name = \"SuperGuyGUI\"\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 150, 0, 50)\nbutton.Position = UDim2.new(0.5, -75, 0.8, 0)\nbutton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)\nbutton.Text = \"🌈 SUPER GUY\"\nbutton.TextColor3 = Color3.new(1,1,1)\nbutton.Font = Enum.Font.GothamBold\nbutton.TextSize = 18\nbutton.Parent = gui\n\n-- Rainbow Function\nlocal function makeRainbow()\n    local char = player.Character or player.CharacterAdded:Wait()\n    local running = true\n\n    task.spawn(function()\n        while running do\n            for h = 0, 1, 0.02 do\n                local color = Color3.fromHSV(h, 1, 1)\n                for _, part in ipairs(char:GetDescendants()) do\n                    if part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n                        part.Color = color\n                        part.Material = Enum.Material.Neon\n                    end\n                end\n                task.wait(0.05)\n            end\n        end\n    end)\nend\n\n-- Connect button\nbutton.MouseButton1Click:Connect(function()\n    makeRainbow()\nend)\n","features":"makes you rainbow, its server sided depending on the executor","tags":[],"discord":"","keyLink":"","owner":{"_id":"6830ac14aef6b0af6370dc4f","username":"c00lscripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3be4cd79b76f9b0df5f8e426005020a4509e7ede5f3e34fc91e2bb3f652f661a.webp","original":"https://scriptblox.com/images/photo/6830ac14aef6b0af6370dc4f-1751743320183.png"},"status":"offline","id":"6830ac14aef6b0af6370dc4f","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/3be4cd79b76f9b0df5f8e426005020a4509e7ede5f3e34fc91e2bb3f652f661a.webp","original":"https://scriptblox.com/images/photo/6830ac14aef6b0af6370dc4f-1751743320183.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:53:26.252Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"686986b7ee47165092d893d8","editBy":{"_id":"6830ac14aef6b0af6370dc4f","username":"c00lscripter","status":"offline","id":"6830ac14aef6b0af6370dc4f"},"message":"Create script","createdAt":"2025-07-05T20:10:31.310