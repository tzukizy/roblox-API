{"slug":"Universal-Script-Super-guy-GUI-clientsided-44064","_id":"686986b7ee47165092d893d6","title":"Super guy GUI maybe serversided","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1751746231272.png","placeId":0},"features":"makes you rainbow, its server sided depending on the executor","tags":[],"script":"\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- Create GUI\nlocal gui = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\ngui.Name = \"SuperGuyGUI\"\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 150, 0, 50)\nbutton.Position = UDim2.new(0.5, -75, 0.8, 0)\nbutton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)\nbutton.Text = \"🌈 SUPER GUY\"\nbutton.TextColor3 = Color3.new(1,1,1)\nbutton.Font = Enum.Font.GothamBold\nbutton.TextSize = 18\nbutton.Parent = gui\n\n-- Rainbow Function\nlocal function makeRainbow()\n    local char = player.Character or player.CharacterAdded:Wait()\n    local running = true\n\n    task.spawn(function()\n        while running do\n            for h = 0, 1, 0.02 do\n                local color = Color3.fromHSV(h, 1, 1)\n                for _, part in ipairs(char:GetDescendants()) do\n                    if part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n                        part.Color = color\n                        part.Material = Enum.Material.Neon\n                    end\n                end\n                task.wait(0.05)\n            end\n        end\n    end)\nend\n\n-- Connect button\nbutton.MouseButton1Click:Connect(function()\n    makeRainbow()\nend)\n","owner":{"_id":"6830ac14aef6b0af6370dc4f","username":"c00lscripter","verified":false,"profilePicture":"/images/photo/6830ac14aef6b0af6370dc4f-1751743320183.png","status":"offline","id":"6830ac14aef6b0af6370dc4f","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":6883,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1751746231272.png","likeCount":1,"dislikeCount":2,"createdAt":"2025-07-05T20:10:31.306Z","executes":26,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"686986b7ee47165092d893d8","editBy":{"_id":"6830ac14aef6b0af6370dc4f","username":"c00lscripter","status":"offline","id":"6830ac14aef6b0af6370dc4f"},"message":"Create script","createdAt":"2025-07-05T20:10:31.310Z"}],"comments":[{"_id":"68698eb3e1763d2301f88abd","commentBy":{"_id":"6867e0e0bfaa36c66edb0a8d","username":"dreamsmp20192","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-07-04T14:10:40.373Z","lastActive":"2025-09-03T21:30:16.718Z","status":"offline","id":"6867e0e0bfaa36c66edb0a8d"},"text":"does this even show on other peoples screens??","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-05T20:44:35.810Z","liked":false,"disliked":false},{"_id":"686992d85ff8bc43bd614982","commentBy":{"_id":"684c9b2c0f380c18ee3b7a1d","username":"testgame593940","verified":false,"role":"user","profilePicture":"/images/photo/684c9b2c0f380c18ee3b7a1d-1751742312090.jpg","createdAt":"2025-06-13T21:42:04.446Z","lastActive":"2025-09-04T19:59:58.377Z","status":"offline","id":"684c9b2c0f380c18ee3b7a1d","topMilestone":{"key":"creator.scripts","tier":10}},"text":"check his *le its client side","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-05T21:02:16.109Z","liked":false,"disliked":false},{"_id":"68699e465ff8bc43bd630393","commentBy":{"_id":"6849f687df5a1e3916eda964","username":"BANGscripts","verified":false,"role":"user","profilePicture":"/images/photo/6849f687df5a1e3916eda964-1751137537567.png","createdAt":"2025-06-11T21:35:03.160Z","lastActive":"2025-10-14T01:53:53.252Z","status":"offline","id":"6849f687df5a1e3916eda964","topMilestone":{"key":"creator.scripts","tier":5}},"text":"its not clientside\ni tested with an alt","edited":false,"l