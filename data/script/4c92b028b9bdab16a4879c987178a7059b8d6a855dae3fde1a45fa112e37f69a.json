{"slug":"MINIONS-Forsaken-RP-Forsaken-rp-fling-script-53945","_id":"68cd5ccab9dad00cf7843c06","title":"fling script","game":{"_id":"688a2343994049fc8d3b35ff","gameId":76231371152392,"name":"Forsaken RP","imageUrl":"/images/sb/rbx-d5fb5de59b6884a121f43c0724a66973-7d2d650d3156.png","placeId":76231371152392},"features":"flings and omega fling","tags":[],"script":"PRESS THE RAGDOLL BUTTON FIRST AND USE FLY SRCIPT TO MOVE!!! THERE IS NO UNTOGGLE BUTTON!\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character\nlocal Root = Character:WaitForChild(\"HumanoidRootPart\")\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\nwalkflinging = true\n\nHumanoid.Died:Connect(function()\n    walkflinging = false\nend)\n\n-- Add jump ability\ngame:GetService(\"UserInputService\").JumpRequest:Connect(function()\n    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\nend)\n\nRoot.CanCollide = false\nHumanoid:ChangeState(11)\n\nrepeat \n    RunService.Heartbeat:Wait()\n    local vel = Root.Velocity\n    Root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)\n    RunService.RenderStepped:Wait()\n    Root.Velocity = vel\n    RunService.Stepped:Wait()\n    Root.Velocity = vel + Vector3.new(0, 0.1, 0)\nuntil walkflinging == false","owner":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","verified":false,"profilePicture":"/images/photo/6738cd64e48cf6c5ce787dfb-1738060288026.png","status":"offline","id":"6738cd64e48cf6c5ce787dfb","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":10878,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-d5fb5de59b6884a121f43c0724a66973-7d2d650d3156.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-09-19T13:38:18.918Z","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","status":"offline","id":"6738cd64e48cf6c5ce787dfb"},"executes":1088,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cd5ccab9dad00cf7843c08","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","status":"offline","id":"6738cd64e48cf6c5ce787dfb"},"message":"Create script","createdAt":"2025-09-19T13:38:18.922Z"},{"_id":"68cd5d0ecf1c043f82f7460e","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","status":"offline","id":"6738cd64e48cf6c5ce787dfb"},"message":"Update script","createdAt":"2025-09-19T13:39:26.247Z"},{"_id":"68cd5db95100bcf3f3be3179","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","status":"offline","id":"6738cd64e48cf6c5ce787dfb"},"message":"Update script","createdAt":"2025-09-19T13:42:17.677Z"},{"_id":"68cd5e26392c3656d738d8b5","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","status":"offline","id":"6738cd64e48cf6c5ce787dfb"},"message":"Update script","createdAt":"2025-09-19T13:44:06.447Z"}],"comments":[{"_id":"69298f235247ecb6d62c91f5","commentBy":{"_id":"6928141c4379fc8d9783ea67","username":"Freedysguy","verified":false,"role":"user","profilePicture":"/images/photo/6928141c4379fc8d9783ea67-1766081372652.jpg","lastActive":"2025-12-24T17:26:53.977Z","createdAt":"2025-11-27T09:04:28.800Z","status":"offline","id":"6928141c4379fc8d9783ea67"},"text":"Not work man","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-28T12:01:39.962Z","liked":false,"disliked":false}]}