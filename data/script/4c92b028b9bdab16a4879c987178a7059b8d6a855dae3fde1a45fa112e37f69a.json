Character:WaitForChild(\"HumanoidRootPart\")\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\nwalkflinging = true\n\nHumanoid.Died:Connect(function()\n    walkflinging = false\nend)\n\n-- Add jump ability\ngame:GetService(\"UserInputService\").JumpRequest:Connect(function()\n    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\nend)\n\nRoot.CanCollide = false\nHumanoid:ChangeState(11)\n\nrepeat \n    RunService.Heartbeat:Wait()\n    local vel = Root.Velocity\n    Root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)\n    RunService.RenderStepped:Wait()\n    Root.Velocity = vel\n    RunService.Stepped:Wait()\n    Root.Velocity = vel + Vector3.new(0, 0.1, 0)\nuntil walkflinging == false","features":"flings and omega fling","tags":[],"discord":"","keyLink":"","owner":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0c8d2c053c4f1899d28c11e129689910383b18c837ff20a44409c48e26e77341.webp","original":"https://scriptblox.com/images/photo/6738cd64e48cf6c5ce787dfb-1738060288026.png"},"status":"offline","id":"6738cd64e48cf6c5ce787dfb","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/0c8d2c053c4f1899d28c11e129689910383b18c837ff20a44409c48e26e77341.webp","original":"https://scriptblox.com/images/photo/6738cd64e48cf6c5ce787dfb-1738060288026.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:42:13.064Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cd5ccab9dad00cf7843c08","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","status":"offline","id":"6738cd64e48cf6c5ce787dfb"},"message":"Create script","createdAt":"2025-09-19T13:38:18.922Z"},{"_id":"68cd5d0ecf1c043f82f7460e","editBy":{"_id":"6738cd64e48cf6c5ce787dfb","username":"angel39exe","