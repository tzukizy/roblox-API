al mesh = Instance.new(\"SpecialMesh\")\n    mesh.MeshType = Enum.MeshType.FileMesh\n    mesh.MeshId = \"rbxassetid://7234998844\"\n    mesh.TextureId = \"rbxassetid://1009824086\"\n    mesh.Parent = part\n\n    local sound = Instance.new(\"Sound\")\n    sound.SoundId = noises[math.random(1, #noises)]\n    sound.Parent = part\n    sound:Play()\n    sound.Ended:Connect(function()\n        sound:Destroy()\n    end)\n\n    local goal = {}\n    goal.Position = part.Position - Vector3.new(0, 1000, 0)\n\n    local tweenInfo = TweenInfo.new(5)\n    local tween = TweenService:Create(part, tweenInfo, goal)\n    tween:Play()\n    tween.Completed:Connect(function()\n        part:Destroy()\n    end)\nend","features":"FefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefeFefefe","tags":[],"discord":"","keyLink":"","owner":{"_id":"67fed91ae490e657198fea98","username":"tomascalderonce","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67fed91ae490e657198fea98","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:00:49.444Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6851ba0167bebda6cda7379f","editBy":{"_id":"67fed91ae490e657198fea98","username":"tomascalderonce","status":"offline","id":"67fed91ae490e657198fea98"},"message":"Create script","createdAt":"2025-06-17T18:54:57.981Z"},{"_id":"6851bc7990576f2fd9a64519","editBy":{"_id":"67fed91ae490e657198fea98","username":"tomascalderonce","status":"offline","id":"67fed91ae490e657198fea98"},"message":"Update script","createdAt":"2025-06-17T19:05:29.768Z"}],"comments":[{"_id":"6