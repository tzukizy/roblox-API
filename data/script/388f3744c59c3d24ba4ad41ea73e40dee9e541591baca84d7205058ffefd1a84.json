{"slug":"Universal-Script-Smart-AI-Chatbot-Script-1951","_id":"625865d25dea2d1d8bbb6338","title":"Smart AI Chatbot Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2413889-1649960402404.jpg","placeId":0},"features":"Responds to what other people say in games automatically with an AI-generated response.\nVery smart, and very funny to use.","tags":[],"script":"local HttpService = game:GetService(\"HttpService\")\nlocal Players = game:GetService(\"Players\")\n \n_G.Owner = \"YourUsernameHere\"\n \nfunction getChat(message,plrname)\n \n   local Split = message:gsub(\" \", \"+\") -- This takes spaces within the person's message and turns it into for ex: Hi+How+Are+You... to ensure that there are no errors and to also make the URL work\n \n   local Response = game:HttpGet(\"https://api.affiliateplus.xyz/api/chatbot?message=\" .. Split .. \"&botname=\" .. plrname .. \"&ownername=\" .. _G.Owner .. \"&user=1\")\n   local Data = HttpService:JSONDecode(Response)\n   wait(1)\n   game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(Data.message, \"All\")\nend\n \nPlayers.PlayerChatted:Connect(function(type, plr, message)\n   if plr.Name ~= Players.LocalPlayer.Name then\n       getChat(message, plr.Name)\n   end\nend)","owner":{"_id":"6250bce5a74ac44114fcf6a5","username":"Zulrics","verified":false,"profilePicture":"/images/photo/6250bce5a74ac44114fcf6a5-1660938703726.jpg","status":"offline","id":"6250bce5a74ac44114fcf6a5","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":38586,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-04-14T18:20:02.418Z","dislikeCount":1,"likeCount":4,"image":"/images/sb/2413889-1649960402404.jpg","executes":124,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f0e4","editBy":{"_id":"6250bce5a74ac44114fc