anvas - [Automatically purchases larger drawing canvases when you have enough cash to build bigger and stronger rafts]\n\n[+] Collision Immunity - [Prevents damage from floating rocks, logs, and other player rafts so your vessel never breaks mid-journey]","tags":["DrawARaftSetSail","Draw A Raft Set Sail","Draw A Raft Set Sail Script"],"discord":"","keyLink":"","owner":{"_id":"6906a02b925d56977f4c58e5","username":"johnnyzhou69","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6906a02b925d56977f4c58e5","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:41:23.302Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69863959f168b5c5b0c458ea","editBy":{"_id":"6906a02b925d56977f4c58e5","username":"johnnyzhou69","status":"offline","id":"6906a02b925d56977f4c58e5"},"message":"Create script","createdAt":"2026-02-06T18:56:25.020Z"}],"comments":[{"_id":"69863da535987d06cfbddcea","commentBy":{"_id":"69840dea1a5b2310139c77be","username":"Jaxonfh201145676776","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-02-24T02:28:10.483Z","createdAt":"2026-02-05T03:26:34.261Z","status":"offline","id":"69840dea1a5b2310139c77be","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Testing","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-06T19:14:45.602Z","liked":false,"disliked":false},{"_id":"69863e17fe1749e018668cf9","commentBy":{"_id":"6983679c12004551b6897e23","username":"jakeolies","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp"