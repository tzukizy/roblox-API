{"slug":"Universal-Script-Sword-Auto-Kill-6391","_id":"633fe3b4549755f6b9c9e9e0","title":"Sword Auto Kill","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Range is only detect who are near and auto kill, If set much of range will have many change to die, 15 range is perfect, It just sword auto kill BUT NOT HOLD YOUR SWORD WHILE EXECUTE IT, Work in all game that have sword like picture.","tags":["Sword","Fighting","FPS","HITBOXS"],"script":"--// Setting \\\\--\nlocal range = 15\n\n--// Variable \\\\--\nlocal player = game:GetService(\"Players\").LocalPlayer\n\n--// Script \\\\--\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n    local p = game.Players:GetPlayers()\n    for i = 2, #p do local v = p[i].Character\n        if v and v:FindFirstChild(\"Humanoid\") and v.Humanoid.Health > 0 and v:FindFirstChild(\"HumanoidRootPart\") and player:DistanceFromCharacter(v.HumanoidRootPart.Position) <= range then\n            local tool = player.Character and player.Character:FindFirstChildOfClass(\"Tool\")\n            if tool and tool:FindFirstChild(\"Handle\") then\n                tool:Activate()\n                for i,v in next, v:GetChildren() do\n                    if v:IsA(\"BasePart\") then\n                        firetouchinterest(tool.Handle,v,0)\n                        firetouchinterest(tool.Handle,v,1)\n                    end\n                end\n            end\n        end\n    end\nend)","owner":{"_id":"6281bf3d376b5cd8ede5a6aa","username":"luckythaina15","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6281bf3d376b5cd8ede5a6aa","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","o