           firetouchinterest(tool.Handle,v,1)\n                    end\n                end\n            end\n        end\n    end\nend)","features":"Range is only detect who are near and auto kill, If set much of range will have many change to die, 15 range is perfect, It just sword auto kill BUT NOT HOLD YOUR SWORD WHILE EXECUTE IT, Work in all game that have sword like picture.","tags":["Sword","Fighting","FPS","HITBOXS"],"discord":"","keyLink":"","owner":{"_id":"6281bf3d376b5cd8ede5a6aa","username":"luckythaina15","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6281bf3d376b5cd8ede5a6aa","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:14:44.348Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e858","editBy":{"_id":"6281bf3d376b5cd8ede5a6aa","username":"luckythaina15","status":"offline","id":"6281bf3d376b5cd8ede5a6aa"},"message":"Create script","createdAt":"2025-03-27T23:04:56.273Z"}],"comments":[{"_id":"633febcb96ada006e91fb240","commentBy":{"_id":"6278a1ee283507f3a44a78cc","username":"LunarUI","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-05-09T05:09:02.377Z","lastActive":"2024-07-12T02:58:00.752Z","status":"offline","id":"6278a1ee283507f3a44a78cc","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"wow thanks for the \"killaura\"","createdAt":"2022-10-07T09:05:15.167Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"633ffdc9549755f6b9ca666a","commentBy":{"_id":"628