{"slug":"Universal-Script-Notification-System-49720","_id":"68a90bca70b7a147d063408b","title":"Notification System","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"sends notifications\n\nThis is meant to act like a table, you can change it to not be a return but a table.\n\nExample:\nNotif.NewNotification('journey.lol', 'test', 5, {\n            Callback = function(callback)\n                if callback then\n                    print(callback)\n                end\n            end,\n            Button1 = 'Accept',\n            Button2 = 'Decline'\n        })","tags":[],"script":"return {\n        NewNotification = function(title, txt, dur, buttons)\n            local starterGui = cloneref(game:GetService('StarterGui'))\n            local packet = {\n                Title = title,\n                Text = txt,\n                Duration = dur\n            }\n\n            for i,v in buttons do\n                packet[i] = v\n            end\n\n            starterGui:SetCore('SendNotification', packet)\n        end\n    }","owner":{"_id":"66f7165f1c15c6b5c2ce9c9c","username":"stav","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/8f6e3d3cae1f0b5dfc6f50b7b8722d28a8520a47db4679951acb31de2338d445.webp","original":"https://scriptblox.com/images/photo/66f7165f1c15c6b5c2ce9c9c-1727469218331.png"},"status":"offline","id":"66f7165f1c15c6b5c2ce9c9c","profile":{"url":"https://cdn.kocakz.me/images/8f6e3d3cae1f0b5dfc6f50b7b8722d28a8520a47db4679951acb31de2338d445.webp","original":"https://scriptblox.com/images/photo/66f7165f1c15c6b5c2ce9c9c-1727469218331.png"}},"verified":false,"views":1294,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/4821a654183633fb68253bf5330c5fd7a533