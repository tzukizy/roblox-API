{"slug":"BIG-Paintball!-PAINTBALL-(UNLOCK-ALL-GUNS-ALSO-GAMEPASS-GUNS)-2812","_id":"6288cfd9d255b62c7b211c06","title":"PAINTBALL (UNLOCK ALL GUNS ALSO GAMEPASS GUNS)","game":{"_id":"67e5e1ffb360710ec3c77da4","gameId":3527629287,"name":"BIG Paintball! Classic 🔫","imageUrl":"/images/sb/rbx-675d0e3e04698d7645e1f431fb37c209-bcada72def10.png","placeId":3527629287},"features":"Unlock all guns","tags":["OP","UNLOCKED","ALL","GUNS","VERY OP"],"script":"local library = require(game:GetService(\"ReplicatedStorage\").Framework.Library)\n\nlocal env = getsenv(game:GetService(\"Players\").LocalPlayer.PlayerScripts.Scripts.Game[\"First Person Controller\"])\n\nlocal unlock_all = true\n\n--// Gun Bypass\nlocal old_fire = library.Network.Fire\nlibrary.Network.Fire = newcclosure(function(self, ...)\n   local args = {...}\n\n   if unlock_all and tostring(self) == \"Request Respawn\" then\n       args[1] = \"1\"\n   end\n\n   return old_fire(self, unpack(args))\nend)\n\nlocal old_own = env.DoesOwnGun\nenv.DoesOwnGun = function(...)\n   return (unlock_all and true) or old_own(...)\nend\n--\n\n--// Unlock All\nlocal old_own_gun = library.GunCmds.DoesOwnGun\nlibrary.GunCmds.DoesOwnGun = newcclosure(function(self, ...)\n   return (unlock_all and true) or old_own_gun(self, ...)\nend)\n--\n\n--// Unlock Offsale\nfor _, gun in next, library.Directory.Guns do\n   gun[\"offsale\"] = false\nend\n--","owner":{"_id":"6288cccb5dc60d198ced4036","username":"omggsaraa","verified":false,"profilePicture":"/images/photo/6288cccb5dc60d198ced4036-1653155483432.png","status":"offline","id":"6288cccb5dc60d198ced4036","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":7541,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-05-21T11:41:13.831Z","dislikeCount":0,"likeCount":2,"image":"https://tr.rbxcdn.com/c9124fb028d0f3ba8e6ae70fd3a1bbf8/480/270/Image/Png","executes":78,"keyless":false,"liked":false,"disliked":false,"isHub":false,"support