{"slug":"Highrise-Rush-Credit-Autofarm-185148","_id":"69d15ebb77b4942be1d8a79f","title":"Credit Autofarm","game":{"_id":"69d15ebb77b4942be1d8a79c","gameId":131273255138534,"name":"Highrise Rush","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":131273255138534},"features":"🛠️ How to use:\n\nJoin the game lobby\nPut the script in your executor’s auto-execute folder","tags":[],"script":"\nlocal Players = game:GetService(\"Players\")\nlocal TeleportService = game:GetService(\"TeleportService\")\nlocal player = Players.LocalPlayer\n\nrepeat task.wait() until player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n\nlocal hrp = player.Character.HumanoidRootPart\n\ntask.wait(1)\n\nfor _, obj in ipairs(workspace:GetDescendants()) do\n    if obj:IsA(\"TouchTransmitter\") then\n        local part = obj.Parent\n        if part and part:IsA(\"BasePart\") then\n            pcall(function()\n                firetouchinterest(hrp, part, 0)\n                firetouchinterest(hrp, part, 1)\n            end)\n        end\n    end\nend\n\ntask.wait(2)\nTeleportService:Teleport(game.PlaceId, player)","owner":{"_id":"66e3624d8476a2b9b1e24d19","username":"uhxz","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/bcc2b229eb69acfad7a67f756c8489e475dd66ce526da37fdc0f85761defb172.webp","original":"https://scriptblox.com/images/photo/66e3624d8476a2b9b1e24d19-1726177916691.jpg"},"status":"offline","id":"66e3624d8476a2b9b1e24d19","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/bcc2b229eb69acfad7a67f756c8489e475dd66ce526da37fdc0f85761defb172.webp","original":"https://scriptblox.com/images/photo/66e3624d8476a2b9b1e24d19-1726177916691.jpg"}},"verified":false,"views":690,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/