"Loading...\")\n\n-- Function to update the time and date display\nlocal function UpdateTimeDisplay()\n    local currentTime = os.date(\"*t\")\n    local hour = currentTime.hour\n    local minute = string.format(\"%02d\", currentTime.min)\n    local second = string.format(\"%02d\", currentTime.sec)\n    local ampm = currentTime.hour >= 12 and \"PM\" or \"AM\"\n    local day = currentTime.day\n    local month = currentTime.month\n    local year = currentTime.year\n\n    -- Handle special cases for 12 PM and 12 AM\n    if hour == 0 then\n        hour = 12\n    elseif hour > 12 then\n        hour = hour - 12\n    end\n\n    -- Update the label with the current time and date\n    TimeLabel:UpdateLabel(string.format(\"%02d:%02d:%02d %s\\n%02d/%02d/%04d\", hour, minute, second, ampm, month, day, year))\nend\n\n-- Update the time display every second\nwhile true do\n    UpdateTimeDisplay()\n    wait(1)\nend","features":"This shows the real time","tags":[],"discord":"","keyLink":"","owner":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"},"status":"offline","id":"6570eb9b5d75332ca0540983","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:11:50.209Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c3bd","editBy":{"_id":"6570eb9b5d75332ca0540983","u