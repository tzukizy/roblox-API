{"slug":"RIVALS-Silent-Aim-OpenSource-148711","_id":"69c499cab8495bf9b67eb8a0","title":"Silent Aim (OpenSource + Keyless)","game":{"_id":"67e5e1ffb360710ec3c77d59","gameId":17625359962,"name":"RIVALS","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":17625359962},"features":"() Opensource - just credit if you use this in your own script\nSilent aim for rivals\n\nThere has been methods for silent aim but a bunch of LARPS keep gatekeeping it, so I made this version that's alot cleaner, optimized, and mobile friendly! \n\nDetection based on v3rm\nNote: I tend not to touch popular games so this is a rare release","tags":["Silent Aim","Rivals","FPS","Aim","Aimbot"],"script":"--[[\nrivals silent aim\n\nworking executers\nSynapse Z and any paid executer\n\nDoesnt work on\nXeno - maybe\nSolora - confirmed\n--]]\nlocal storage = game:GetService(\"ReplicatedStorage\")\nlocal youman = workspace.CurrentCamera \nlocal wow = require(storage.Modules.Utility)\n\nlocal function rando() \n    local targets = {} \n    for _, v in ipairs(workspace:GetChildren()) do \n        if v:FindFirstChildOfClass(\"Humanoid\") then \n            table.insert(targets, v) \n        elseif v.Name == \"HurtEffect\" then \n            for _, p in ipairs(v:GetChildren()) do \n                if p.ClassName ~= \"Highlight\" then table.insert(targets, p) end \n            end \n        end \n    end \n    return targets \nend \n\nlocal function thingidk(p)\n    local h = p:FindFirstChild(\"Head\")\n    local root = p:FindFirstChild(\"HumanoidRootPart\")\n    return (h and root) and (h.Position + (root.Velocity * 0)) or (h and h.Position)\nend\n\nlocal function idk() \n    local target, min = nil, math.huge \n    local char = game:GetService(\"Players\").LocalPlayer.Character \n    if not char then return end \n    for _, p in ipairs(rando()) do \n        if p ~= char and p:FindFirstChild(\"HumanoidRootPart\") then \n            local pos = thingidk(p)\n            local screen, vis = youman:WorldToViewportPoint(pos) \n            if vis then \n                local mag = (Vector2.new(youman.ViewportSize.X/2, youman.ViewportSize.Y/2) - Vector2.new(screen.X, screen.Y)).Magnitude \n                if mag < min then target, min = p, mag end \n            end \n        end \n    end \n    return target \nend \n\nlocal old = wow.Raycast \nwow.Raycast = function(...) \n    local args = {...} \n    if args[4] == 999 then \n        local target = idk() \n        if target then \n            local p = thingidk(target)\n            if p then args[3] = p end\n        end\n    end \n    return old(unpack(args)) \nend","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"verified":false,"views":4379,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/eadbbc34ed57beb6e683306297a507533076306bd95b3d220dc0b95fd0badb0e.webp","original":"https://scriptblox.com/images/sb/rbx-60c154f21752ff4cb520340183edb77a-7ca355fb0769.png","scriptblox":"https://scriptblox.com/images/script/rbx-60c154f21752ff4cb520340183edb77a-7ca355fb0769.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2026-03-26T02:28:26.421Z","keyLink":"","executes":551,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"c