{"_id":"6955966615942ffdef9439e9","title":"Discord joiner","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/e53ff9e2031172222df57096b3fb61906a2cfd73b6bafbcdd2decb0bba74e7de.webp","original":"https://scriptblox.com/images/sb/0-1767216742004.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/e53ff9e2031172222df57096b3fb61906a2cfd73b6bafbcdd2decb0bba74e7de.webp","original":"https://scriptblox.com/images/sb/0-1767216742004.png"},"placeId":0},"slug":"Universal-Script-Discord-joiner-80500","verified":false,"key":false,"keyless":false,"views":621,"executes":22,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/91c2f0d851d6f57972b50cc82ac348bafe5852f607d99adfb264c8d4af8cac08.webp","original":"https://scriptblox.com/images/sb/0-1767216742004.png","scriptblox":"https://scriptblox.com/images/script/0-1767216742004.png"},"thumbnail":{"url":"https://media.kocakz.me/91c2f0d851d6f57972b50cc82ac348bafe5852f607d99adfb264c8d4af8cac08.webp","original":"https://scriptblox.com/images/sb/0-1767216742004.png","scriptblox":"https://scriptblox.com/images/script/0-1767216742004.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-12-31T21:32:22.016Z","updatedAt":"2025-12-31T21:32:22.016Z","lastBump":"2025-12-31T21:32:22.016Z","script":"local function joindiscord(input)\n\tlocal HS, SG = game:GetService(\"HttpService\"), game:GetService(\"StarterGui\")\n\n\t-- incase someones dumbass puts the full join link this will make it still work\n\tlocal code = tostring(input):match(\"discord%.gg/([%w]+)\")\n\t\tor tostring(input):match(\"discord%.com/invite/([%w]+)\")\n\t\tor tostring(input)\n\tif not code or code == \"\" then\n\t\treturn\n\tend\n\n\tlocal copy = setclipboard or toclipboard\n\tif copy then\n\t\tpcall(copy, \"https://discord.gg/\" .. code)\n\tend\n\n\tlocal req = request or (syn and syn.request) or (http and http.request)\n\tif req then\n\t\tpcall(req, {\n\t\t\tUrl = \"http://127.0.0.1:6463/rpc?v=1\",\n\t\t\tMethod = \"POST\",\n\t\t\tHeaders = {\n\t\t\t\t[\"Content-Type\"] = \"application/json\",\n\t\t\t\t[\"Origin\"] = \"https://discord.com\",\n\t\t\t},\n\t\t\tBody = HS:JSONEncode({\n\t\t\t\tcmd = \"INVITE_BROWSER\",\n\t\t\t\targs = { code = code },\n\t\t\t\tnonce = HS:GenerateGUID(false),\n\t\t\t}),\n\t\t\tTimeout = 2,\n\t\t})\n\tend\n\n\tpcall(function()\n\t\tSG:SetCore(\"SendNotification\", {\n\t\t\tTitle = \"Discord\",\n\t\t\tText = \"Copied to clipboard\",\n\t\t\tDuration = 5,\n\t\t})\n\tend)\nend\n\njoindiscord(\"w5ZVbFS4Mf\")","features":"Simple function to join discord servers through a script\nIt attempts to join it for you but it also copies the join link to your clipboard for you if it doesn't\n\nHOW TO USE\nJust call the function with your join code or join link as a string as an argument when calling the function","tags":[],"discord":"","keyLink":"","owner":{"_id":"68bcb96de6a7b32f509d069c","username":"SuperBlueEyeball","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68bcb96de6a7b32f509d069c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:40:55.315Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6955966615942ffdef9439ec","editBy":{"_id":"68bcb96de6a7b32f509d069c","username":"SuperBlueEyeball","status":"offline","id":"68bcb96de6a7b32f509d069c"},"message":"Create script","createdAt":"2025-12-31T21:32:22.020Z"}],"comments":[{"_id":"6959d228c5ff0ff1ceb7c918","commentBy":{"_id":"68970587af11839269bd4e14","username":"2kr3kn","verified":fals