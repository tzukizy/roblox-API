{"slug":"Hot-Pot-Restaurant-Map-Destroyer-247357","_id":"69dbf7bbbee9400302a1e2d3","title":"Map Destroyer","game":{"_id":"68b447f19d3c07cb16e8e004","gameId":13521186297,"name":"Hot Pot Restaurant","imageUrl":"/images/sb/rbx-3e8e63a9ece9a8a64a0cc77727a56b2f-940dec2458c5.png","placeId":13521186297},"features":"Map go bye","tags":["ok","miketyson"],"script":"-- https://www.roblox.com/games/13521186297\n\nlocal PlacePlate = game:GetService(\"ReplicatedStorage\").PlacePlate\nlocal LP = game:GetService(\"Players\").LocalPlayer\nlocal Table = workspace.TablesChairs:GetChildren()[6].Table\n\nfor _, x in ipairs(workspace:GetDescendants()) do\n\tif x:IsA(\"BasePart\") and x.Anchored then\n\t\tPlacePlate:FireServer(LP,x,x.Position - Vector3.new(5,10,5),Table)\n\tend\nend\n\nwhile wait(1) do\n\tfor _, plr in next, game.Players:GetChildren() do\n\t\tif plr == LP then continue end\n\t\t\n\t\tpcall(function()\n\t\t\tPlacePlate:FireServer(LP,plr.Character[\"Left Arm\"],nil,Table)\n\t\t\tPlacePlate:FireServer(LP,plr.Character[\"Right Leg\"],nil,Table)\n\t\tend)\n\tend\nend","owner":{"_id":"6844e077059a9781e00e1ba7","username":"miketyson","verified":false,"profilePicture":"/images/photo/6844e077059a9781e00e1ba7-1757183112902.jpg","status":"offline","id":"6844e077059a9781e00e1ba7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":750,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/13521186297-1776023483604.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-04-12T19:51:23.634Z","executes":615,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dbf7bbbee9400302a1e2d7","editBy":{"_id":"6844e077059a9781e00e1ba7","username":"miketyson","status":"offline","id":"6844e077059a9781e00e1ba7"},"message":"Create script","createdAt":"2026-04-12T19:51:23.640Z"}],"comments":[{"_id":"6a361bb56d8d34f61825b4eb","commentBy":{"_id":"6a34ed09fc37bbab9df7acab","username":