{"slug":"Combat-Initiation:-Rocket-Arena-Kill-all-opensrc-15705","_id":"669913f4326133a730dcdb54","title":"Kill all opensrc","game":{"_id":"67e5e1ffb360710ec3c78559","gameId":13559635034,"name":"Combat Initiation","imageUrl":"/images/sb/rbx-6c257588551cecd73f962d8165e6b9f1-78ce94db949c.png","placeId":13559635034},"features":"Kill all\n\nuse any range weapons \n\nui made my chat gpt do not flame me","tags":["Combat initation"],"script":"-- Variables\nlocal lp = game.Players.LocalPlayer\nlocal path = game.Workspace.Enemies\ngetgenv().Farm = true\nlocal distance = 10 -- Adjustable distance\n\nlocal function BringNPCs()\n    while getgenv().Farm do\n        local playerHRP = lp.Character:WaitForChild(\"HumanoidRootPart\")\n        for _, npc in ipairs(path:GetChildren()) do\n            local npcHRP = npc:FindFirstChild(\"HumanoidRootPart\")\n            local npcHumanoid = npc:FindFirstChild(\"Humanoid\")\n            if npcHRP and npcHumanoid and npcHumanoid.Health > 0 then\n                npcHRP.CFrame = playerHRP.CFrame + playerHRP.CFrame.LookVector * distance\n            end\n        end\n        task.wait(0.1) -- Adjust the wait time as needed\n    end\nend\n\n-- Create GUI\nlocal screenGui = Instance.new(\"ScreenGui\")\nlocal frame = Instance.new(\"Frame\")\nlocal toggleButton = Instance.new(\"TextButton\")\n\nscreenGui.Parent = game.CoreGui\n\nframe.Size = UDim2.new(0, 200, 0, 50)\nframe.Position = UDim2.new(0.5, -100, 0.5, -25)\nframe.BackgroundColor3 = Color3.new(1, 1, 1)\nframe.Active = true\nframe.Draggable = true\nframe.Parent = screenGui\n\ntoggleButton.Size = UDim2.new(1, 0, 1, 0)\ntoggleButton.Position = UDim2.new(0, 0, 0, 0)\ntoggleButton.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5)\ntoggleButton.Text = \"Toggle Farm\"\ntoggleButton.Parent = frame\n\n-- Toggle functionality\ntoggleButton.MouseButton1Click:Connect(function()\n    getgenv().Farm = not getgenv().Farm\n    if getgenv().Farm then\n        toggleButton.Text = \"Stop Farm\"\n        BringNPCs()\n    else\n        toggleButton.Text = \"Start Farm\"\n    end\nend)\n","owner":{"_id":"62c49c6ba439e78286e8f117","username":"validspec","verified":false,"profilePicture":"/images/photo/62c49c6ba439e78286e8f117-1721487650887.jpg","status":"offline","id":"62c49c6ba439e78286e8f117"},"verified":false,"keyLink":"","views":62150,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-18T13:09:08.010Z","dislikeCount":0,"likeCount":11,"image":"https://tr.rbxcdn.com/73acd0427c236f9a51dc09bb63b3aca1/500/280/Image/Jpeg","executes":913,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c51675","editBy":{"_id":"62c49c6ba439e78286e8f117","username":"validspec","status":"offline","id":"62c49c6ba439e78286e8f117"},"message":"Create script","createdAt":"2025-03-27T20:39:53.797Z"}],"comments":[{"_id":"669915e0ae1c6fed73d4ffaa","commentBy":{"_id":"6698dd755a8e65f120a166f7","username":"InsurgencyX","verified":false,"role":"user","profilePicture":"/images/photo/6698dd755a8e65f120a166f7-1745137986594.png","createdAt":"2024-07-18T09:16:37.477Z","lastActive":"2025-07-19T10:58:33.781Z","status":"offline","id":"6698dd755a8e65f120a166f7"},"text":"Nice","createdAt":"2024-07-18T13:17:20.451Z","edited":true,"dislikeCount":0,"likeCount":3,"liked":false,"disliked":false},{"_id":"6699185a4da423b6e77e31f3","commentBy":{"_id":"62c49c6ba439e78286e8f117","username":"validspec","verified":false,"role":"user","profilePicture":"/images/photo/62c49c6ba439e78286e8f117-1721487650887.jpg","createdAt":"2022-07-05T20:17:47.271Z","lastActive":"2024-09-10T15:50:18.361Z","status":"offline","id":"62c49c6ba439e78286e8f117"},"text":"@Zealand1 Thank you!","createdAt":"2024-07-18T13:27:54.391Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"66991d3a8bb7b92ff2794913","commentBy":{"_id":"62e14f7245d45c9b6edc6a2b","username":"tigak","verified":false,"role":"user","profilePicture":"/ima