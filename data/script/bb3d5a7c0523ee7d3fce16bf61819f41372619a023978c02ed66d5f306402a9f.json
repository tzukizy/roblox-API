alue, level + 1)\n\t\telseif typeof(value) == \"function\" then\n\t\t\tlocal ok, result = pcall(value)\n\t\t\tif ok then\n\t\t\t\tif typeof(result) == \"table\" then\n\t\t\t\t\tprint(indent .. \"  Function returned a table:\")\n\t\t\t\t\tinspect(result, level + 2)\n\t\t\t\telse\n\t\t\t\t\tprint(indent .. \"  Function returned:\", result)\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tprint(indent .. \"  Function call failed.\")\n\t\t\tend\n\t\tend\n\tend\nend\n\nprint(\"Module contents:\")\ninspect(module)","features":"Check if the module is a table.\nPrints the keys and values.\nCalls functions and shows what they return.\nAdds more indentation for nested tables.","tags":[],"discord":"","keyLink":"","owner":{"_id":"64d74e5160ae83e54e4b1d4e","username":"barcon","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9d4a4a35ebf2ad503ff4bbd2baed1816bd2233f81da186d4ae795820d02923c8.webp","original":"https://scriptblox.com/images/photo/64d74e5160ae83e54e4b1d4e-1711538777552.jpg"},"status":"offline","id":"64d74e5160ae83e54e4b1d4e","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/9d4a4a35ebf2ad503ff4bbd2baed1816bd2233f81da186d4ae795820d02923c8.webp","original":"https://scriptblox.com/images/photo/64d74e5160ae83e54e4b1d4e-1711538777552.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:15:43.681Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d3c5","editBy":{"_id":"64d74e5160ae83e54e4b1d4e","username":"barcon","status":"offline","id":"64d74e5160ae83e54e4b1d4e"},"message":"Create script","createdAt":"2024-12-21T10:19:54.623Z"},{"_id":"67e5e1e6b360710ec3c53a42","editBy":{"_id":"64d74e5160ae83e54e4b1d4e","username":"barcon","status":"offline","id":"64d74e5160ae83e54e4b1d4e"},"message":"Update script","createdAt":"2025-03-27