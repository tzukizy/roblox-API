nabled = true\n\nlocal toggleGui = Instance.new(\"ScreenGui\")\ntoggleGui.Name = \"AdminToggleGui\"\ntoggleGui.ResetOnSpawn = false\ntoggleGui.Parent = playerGui\n\nlocal toggleButton = Instance.new(\"TextButton\")\ntoggleButton.Size = UDim2.fromScale(0.18, 0.08)\ntoggleButton.Position = UDim2.fromScale(0.02, 0.45)\ntoggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)\ntoggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\ntoggleButton.TextScaled = true\ntoggleButton.Font = Enum.Font.GothamBold\ntoggleButton.Text = \"Admin\"\ntoggleButton.BorderSizePixel = 0\ntoggleButton.Parent = toggleGui\n\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = UDim.new(0, 16)\ncorner.Parent = toggleButton\n\nlocal isVisible = true\n\nlocal function setVisible(state)\n\tisVisible = state\n\tadminPanel.Enabled = state\n\tfor _, v in ipairs(adminPanel:GetDescendants()) do\n\t\tif v:IsA(\"Frame\")\n\t\tor v:IsA(\"TextLabel\")\n\t\tor v:IsA(\"TextButton\")\n\t\tor v:IsA(\"ImageLabel\")\n\t\tor v:IsA(\"ImageButton\") then\n\t\t\tv.Visible = state\n\t\tend\n\tend\nend\n\ntoggleButton.MouseButton1Click:Connect(function()\n\tsetVisible(not isVisible)\nend)\n\nplayer.CharacterAdded:Connect(function()\n\ttask.wait(0.5)\n\tadminPanel = getAdminPanel()\n\tadminPanel.ResetOnSpawn = false\n\tsetVisible(isVisible)\nend)\n","features":"Just a admin panel","tags":[],"discord":"","keyLink":"","owner":{"_id":"692ce1a3f5fd79fe89fe928a","username":"Justsomescripter89","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7bd667cc1ff8e4edcf897f1a1a2c0b0e7dd19150f323e2888cf989a37df291df.webp","original":"https://scriptblox.com/images/photo/692ce1a3f5fd79fe89fe928a-1766171879302.jpeg"},"status":"offline","id":"692ce1a3f5fd79fe89fe928a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/7bd667cc1ff8e4edcf897f1a1a2c0b0e7dd19150f323e2888cf989a37df291df.webp","original":"https://scriptblox.com/images/photo/692ce1a3f5fd79fe89fe928a-1