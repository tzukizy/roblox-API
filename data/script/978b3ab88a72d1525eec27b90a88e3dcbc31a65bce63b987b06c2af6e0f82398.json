{"slug":"Universal-Script-Fix-Velocity-Drawing-116732","_id":"699ad18c40e47511c89b6972","title":"Fix Velocity Drawing","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"This script implements the Drawing.new function","tags":["Velocity"],"script":"local ScreenSize = Vector2.new(1920, 1080)  -- Write down your screen resolution and open Roblox in full screen mode\n\nif not getgenv().Fix then\n\tlocal obj = Drawing.new(\"Circle\")\n\tlocal mt = getrawmetatable(obj)\n\tsetreadonly(mt, false)\n\tlocal old_newindex = mt.__newindex\n\n\tmt.__newindex = function(self, key, value)\n\t\tif table.find({\"Position\", \"PointA\", \"PointB\", \"PointC\", \"PointD\", \"To\", \"From\"}, key) and typeof(value) == \"Vector2\" then\n\t\t\tlocal viewport = workspace.CurrentCamera.ViewportSize\n\n\t\t\tvalue = Vector2.new(\n\t\t\t\tvalue.X / viewport.X * ScreenSize.X,\n\t\t\t\tvalue.Y / viewport.Y * ScreenSize.Y\n\t\t\t)\n\t\tend\n\n\t\treturn old_newindex(self, key, value)\n\tend\n\tobj:Destroy()\n\tgetgenv().Fix = true\nend","owner":{"_id":"6586c7e1fbeea15dfa3fd2f0","username":"z0lupo4ka","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f5170d27fe84e412b6e260b12f0b17367dd6e51423c5d60df3fd2bf5338aeca7.webp","original":"https://scriptblox.com/images/photo/6586c7e1fbeea15dfa3fd2f0-1743154455820.png"},"status":"offline","id":"6586c7e1fbeea15dfa3fd2f0","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/f5170d27fe84e412b6e260b12f0b17367dd6e51423c5d60df3fd2bf5338aeca7.webp","original":"https://scriptblox.com/images/photo/6586c7e1fbeea15dfa3fd2f0-1743154455820.png"}},"verified":false,"views":22,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/imag