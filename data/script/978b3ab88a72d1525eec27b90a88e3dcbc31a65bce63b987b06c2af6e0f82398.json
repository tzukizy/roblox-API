ue = Vector2.new(\n\t\t\t\tvalue.X / viewport.X * ScreenSize.X,\n\t\t\t\tvalue.Y / viewport.Y * ScreenSize.Y\n\t\t\t)\n\t\tend\n\n\t\treturn old_newindex(self, key, value)\n\tend\n\tobj:Destroy()\n\tgetgenv().Fix = true\nend","features":"This script implements the Drawing.new function","tags":["Velocity"],"discord":"","keyLink":"","owner":{"_id":"6586c7e1fbeea15dfa3fd2f0","username":"z0lupo4ka","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f5170d27fe84e412b6e260b12f0b17367dd6e51423c5d60df3fd2bf5338aeca7.webp","original":"https://scriptblox.com/images/photo/6586c7e1fbeea15dfa3fd2f0-1743154455820.png"},"status":"offline","id":"6586c7e1fbeea15dfa3fd2f0","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/f5170d27fe84e412b6e260b12f0b17367dd6e51423c5d60df3fd2bf5338aeca7.webp","original":"https://scriptblox.com/images/photo/6586c7e1fbeea15dfa3fd2f0-1743154455820.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:39:55.715Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"699ad18c40e47511c89b6975","editBy":{"_id":"6586c7e1fbeea15dfa3fd2f0","username":"z0lupo4ka","status":"offline","id":"6586c7e1fbeea15dfa3fd2f0"},"message":"Create script","createdAt":"2026-02-22T09:51:08.744Z"}],"comments":[]}