: Unlimited Void\")\n\n\n-feel free to change whatever moves you have into different ones","owner":{"_id":"676db77b021ed1a13f309d34","username":"Notaskid52","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":9,"status":"offline","id":"676db77b021ed1a13f309d34","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":3838,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/4ec03ac5c51b93fca4ae792930b58dbebdf988b0b80b5bba278f94e06b321544.webp","original":"https://scriptblox.com/images/sb/rbx-24f6fe747331866e96805a04ec33c85a-b2fbeb645d7c.png","scriptblox":"https://scriptblox.com/images/script/rbx-24f6fe747331866e96805a04ec33c85a-b2fbeb645d7c.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-08T06:10:41.573Z","keyLink":"","executes":1363,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:05:50.957Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/4ec03ac5c51b93fca4ae792930b58dbebdf988b0b80b5bba278f94e06b321544.webp","original":"https://scriptblox.com/images/sb/rbx-24f6fe747331866e96805a04ec33c85a-b2fbeb645d7c.png","scriptblox":"https://scriptblox.com/images/script/rbx-24f6fe747331866e96805a04ec33c85a-b2fbeb645d7c.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69ad12e11f9615074192a383","editBy":{"_id":"676db77b021ed1a13f309d34","username":"Notaskid52","status":"offline","id":"676db77b021ed1a13f309d34"},"message":"Created script, enjoy!","createdAt":"2026-03-08T06:10:41.576Z"}],"comments":[{"_id":"69ad131711afc6c1a59df932","commentBy":{"_id":"676db77b021ed1a13f309d34","username":"Notaskid52","verified":false,"role":"user","profilePicture":{"url":"https://media.koca