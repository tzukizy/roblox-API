s://cdn.kocakz.me/images/56469aacdcc4f1dd0333e9ea789de973a5c2b1200fd96cc8ca733ede4b402be6.webp","original":"https://scriptblox.com/images/photo/68bec4c1e5cde5525f4c74fe-1766342172682.jpg"}},"text":"@HeroX Hi. It's as simple as it gets, sword deals damage via the “.Touched” event on its handle. `firetouchinterest(plr, handle, 1)` forces a touch simulation, and the server thinks the player has physically touched the handle.","parent":{"_id":"69dcf05586b0590cfb5e2a4c","commentBy":{"_id":"64cdd88c7037f1177477a89a","username":"irises","profilePicture":"/images/photo/64cdd88c7037f1177477a89a-1788347328738.png","status":"offline","id":"64cdd88c7037f1177477a89a"},"text":"could you give a quick explanation how this works?"},"edited":false,"likeCount":3,"dislikeCount":0,"createdAt":"2026-04-13T14:52:24.969Z","liked":false,"disliked":false},{"_id":"69de03f4c51da6300e39f26a","commentBy":{"_id":"64cdd88c7037f1177477a89a","username":"irises","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/35b05660f67180c8227d22d77346fea8ecc5d8214ac6af314d75539e12505c4c.webp","original":"https://scriptblox.com/images/photo/64cdd88c7037f1177477a89a-1788347328738.png"},"createdAt":"2023-08-05T05:05:16.696Z","lastActive":"2026-10-10T23:52:34.142Z","status":"offline","id":"64cdd88c7037f1177477a89a","profile":{"url":"https://cdn.kocakz.me/images/35b05660f67180c8227d22d77346fea8ecc5d8214ac6af314d75539e12505c4c.webp","original":"https://scriptblox.com/images/photo/64cdd88c7037f1177477a89a-1788347328738.png"}},"text":"@TesterD thats very cool, thanks!","parent":{"_id":"69dd03282b916fb10423aff7","commentBy":{"_id":"68bec4c1e5cde5525f4c74fe","username":"TesterD","profilePicture":"/images/photo/68bec4c1e5cde5525f4c74fe-1766342172682.jpg","status":"offline","id":"68bec4c1e5cde5525f4c74fe"},"text":"@HeroX Hi. It's as simple as it gets, sword deals damage via the “.Touched” event on its handle. `firetouchinterest(plr, handle, 1)` forces a touch simulation, and the server thinks the player has physically touched the handle."},"edited":false,"likeCount":3,"dislikeCount":0,"createdAt":"2026-04-14T09:08:04.185Z","liked":false,"disliked":false},{"_id":"69e4a719cd92f159c3523d91","commentBy":{"_id":"6840ca77f85943d072d2b885","username":"Shashlik","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/d09cb2f0db7f8116f143485dc7997f808f78d431271a3bbc8be3db7469d89f40.webp","original":"https://scriptblox.com/images/photo/6840ca77f85943d072d2b885-1750434289783.jpg"},"createdAt":"2025-06-04T22:36:39.758Z","lastActive":"2026-08-10T11:19:08.446Z","status":"offline","id":"6840ca77f85943d072d2b885","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/d09cb2f0db7f8116f143485dc7997f808f78d431271a3bbc8be3db7469d89f40.webp","original":"https://scriptblox.com/images/photo/6840ca77f85943d072d2b885-1750434289783.jpg"}},"text":"@TesterD а это случаем не самый классический метод reach sword? Просто видал что именно его чаще всего и детектят античиты. В аналогию можно взять визуальное увиличение самого хитбокса меча, правда что будет он убивать не моментально","parent":{"_id":"69dd03282b916fb10423aff7","commentBy":{"_id":"68bec4c1e5cde5525f4c74fe","username":"TesterD","profilePicture":"/images/photo/68bec4c1e5cde5525f4c74fe-1766342172682.jpg","status":"offline","id":"68bec4c1e5cde5525f4c74fe"},"text":"@HeroX Hi. It's as simple as it gets, sword deals damage via the “.Touched” event on its handle. `firetouchinterest(plr, handle, 1)` forces a touch simulation, and the server thinks the player has physically touched the handle."},"edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-19T09:57:45.719Z","liked":false,"disliked":false},{"_id":"69e505a2648141c4e948230e","commentBy":{"_id":"68bec4c1e5cde5525f4c74fe","username":"TesterD","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/56469aacdcc4f1dd0333e9ea789de973a5c2b1200fd96cc8ca733ede4b402be6.webp","original":"https://scriptblox.com/images/photo/68bec4c1e5cde5525f4c74fe-1766342172682.jpg"},"createdAt":"2025-09-08T11:57:53.084Z","lastActive":"2026-10-13T17:55:35.725Z","lvl":7,"status":"offline","id":"68bec4c1e5cde5525f4c74fe","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/56469aacdcc4f1dd0333e9ea789de973a5c2b1200fd96cc8ca733ede4b402be6.webp","original":"https://scriptblox.com/images/photo/68bec4c1e5cde5525f4c74fe-1766342172682.jpg"}},"text":"@Shashlik Привет, самое классическое это как раз таки Handle Resize, где ты напрямую меняешь параметр \"Size\" у хендла, как раз такое и детектируется. А здесь просто firetouchinterest, функция которая позволяет симулировать с определённой дистанции событие .Touched,  заставляя сервер обрабатывать это событие как настоящее, анти читы не детектируют такое, это симуляция касания, не более. Максимум что могут в таких случаях сделать, это перейти с .Touched на Raycast или детектировать такие вещи через расстояние (Magnitude), если грамотно выставлять дистанцию в этом Utility, то будешь спокойно играть без обнаружения, разве что люди могут тебя в чём - то подозревать... Как то так","parent":{"_id":"69e4a719cd92f159c3523d91","commentBy":{"_id":"6840ca77f85943d072d2b885","username":"Shashlik","profilePicture":"/images/photo/6840ca77f85943d072d2b885-1750434289783.jpg","status":"offline","id":"6840ca77f85943d072d2b885"},"text":"@TesterD а это случаем не самый классический метод reach sword? Просто видал что именно его чаще всего и детектят античиты. В аналогию можно взять визуальное увиличение самого хитбокса меча, правда что будет он убивать не моментально"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-19T16:41:06.202Z","liked":false,"disliked":false}]}