{"_id":"66c7176a51cd568dd167df3c","title":"Fps and ping counter","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/6a5159444cd4de7d11194f826e745eea03aa470aee0a71eb2c87ce3024cfc8bc.webp","original":"https://scriptblox.com/images/sb/3649536-1724323690861.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/6a5159444cd4de7d11194f826e745eea03aa470aee0a71eb2c87ce3024cfc8bc.webp","original":"https://scriptblox.com/images/sb/3649536-1724323690861.png"},"placeId":0},"slug":"Universal-Script-Fps-and-ping-counter-17509","verified":false,"key":false,"keyless":false,"views":96772,"executes":60,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c693f9198a249733e595cccfdf5188051baac55711ee1cc91ee047a17e5f2b61.webp","original":"https://scriptblox.com/images/sb/3649536-1724323690861.png","scriptblox":"https://scriptblox.com/images/script/3649536-1724323690861.png"},"thumbnail":{"url":"https://media.kocakz.me/c693f9198a249733e595cccfdf5188051baac55711ee1cc91ee047a17e5f2b61.webp","original":"https://scriptblox.com/images/sb/3649536-1724323690861.png","scriptblox":"https://scriptblox.com/images/script/3649536-1724323690861.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2024-08-22T10:48:10.894Z","updatedAt":"2024-08-22T10:48:10.894Z","lastBump":"2024-08-22T10:48:10.894Z","script":"local screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"StatsGui\"\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = game.Players.LocalPlayer:WaitForChild(\"PlayerGui\")\n\nlocal statsLabel = Instance.new(\"TextLabel\")\nstatsLabel.Size = UDim2.new(0, 150, 0, 40)\nstatsLabel.Position = UDim2.new(0, 10, 1, -50)\nstatsLabel.BackgroundColor3 = Color3.new(0, 0, 0)\nstatsLabel.BackgroundTransparency = 0.5\nstatsLabel.TextColor3 = Color3.new(1, 1, 1)\nstatsLabel.TextStrokeTransparency = 0\nstatsLabel.TextStrokeColor3 = Color3.new(1, 1, 1)\nstatsLabel.TextScaled = true\nstatsLabel.Text = \"FPS: 0\\nPing: 0\"\nstatsLabel.Parent = screenGui\n\nlocal uiCorner = Instance.new(\"UICorner\")\nuiCorner.CornerRadius = UDim.new(0, 10)\nuiCorner.Parent = statsLabel\n\nlocal uiStroke = Instance.new(\"UIStroke\")\nuiStroke.Parent = statsLabel\nuiStroke.Thickness = 3\nuiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border\n\nlocal function updateFPSAndPing()\n    local lastUpdate = tick()\n    while true do\n        local now = tick()\n        local fps = math.floor(1 / (now - lastUpdate))\n        lastUpdate = now\n\n        local stats = game:GetService(\"Stats\")\n        local pingValue = stats.Network.ServerStatsItem[\"Data Ping\"]:GetValueString()\n\n        statsLabel.Text = \"FPS: \" .. fps .. \"\\nPing: \" .. pingValue\n\n        wait(0.01)\n    end\nend\n\ncoroutine.wrap(updateFPSAndPing)()\n\nlocal function rainbowEffect()\n    local hue = 0\n    while true do\n        hue = hue + 1 / 360\n        if hue > 1 then hue = 0 end\n        uiStroke.Color = Color3.fromHSV(hue, 1, 1)\n        wait(0.03)\n    end\nend\n\ncoroutine.wrap(rainbowEffect)()","features":"Cool ping and fps counter","tags":[],"discord":"","keyLink":"","owner":{"_id":"668f2817015ee9f5c1af80ac","username":"PlayerExploits","verified":false,"profilePicture":{"url":"https://media.kocakz.me/816090c53420a440ea9d095ebcc616caab9be3f59df48072e9ba11c5121371e0.webp","original":"https://scriptblox.com/images/photo/668f2817015ee9f5c1af80ac-1724314740927.png"},"status":"offline","id":"668f2817015ee9f5c1af80ac","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/816090c53420a440ea9d095ebcc616caab9be3f59df48072e9ba11c5121371e0.webp","original":"https://scriptblox.com/images/photo/668f2817015ee9f5c1af80ac-1724314740927.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detecte