:GetService(\"UserInputService\")\nlocal virtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal runService = game:GetService(\"RunService\")\nlocal replicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal guiService = game:GetService(\"GuiService\")\nlocal tweenService = game:GetService(\"TweenService\")\nlocal httpService = game:GetService(\"HttpService\")\nlocal placeId = game.PlaceId\nlocal coreGui = game:GetService(\"CoreGui\")\nlocal currentCamera = workspace.CurrentCamera\nlocal keyCode = Enum.KeyCode\nlocal instanceNew = Instance.new\nlocal uDim2New = UDim2.new\nlocal vector2New = Vector2.new\nlocal vector3New = Vector3.new\nlocal color3New = Color3.new\nlocal cFrameNew = CFrame.new\n\n--[[ local variables ]]\nlocal tycoons = workspace:FindFirstChild(\"Tycoons\")\nlocal factory\nfor _,v in tycoons:GetChildren() do \n    if v.Owner.Value == localPlayer.Name then \n        factory = v \n        break\n    end\nend\n\n--[[ Main code ]]\nrunService.RenderStepped:Connect(function()\n    for _,v in workspace.DroppedParts[factory.Name]:GetChildren() do\n        for i,b in factory:GetChildren() do\n            if b.ClassName == \"Model\" and b:FindFirstChild(\"Model\") and b.Model:FindFirstChild(\"UpgraderShip\") then\n                local upgrader = b.Model:FindFirstChild(\"Upgrade\") or b.Model:FindFirstChild(\"Scan\")\n                firetouchinterest(v, upgrader, 0)\n            end\n        end\n    end\nend)\n","features":"upgrades all of the ores that spawn on your tycoon in miners haven","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followe