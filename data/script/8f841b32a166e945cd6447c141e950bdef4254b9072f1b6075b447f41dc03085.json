{"slug":"Universal-Script-basic-Moonsec-v3-dumper-54706","_id":"68d4323c2ea56fb1c84bf197","title":"basic Moonsec v3 dumper (readable version)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1758736956848.jpg","placeId":0},"features":"readable","tags":[],"script":"local output_dir = \"unpacked_output\"\nif not isfolder(output_dir) then makefolder(output_dir) end\n\nlocal headers = { \"all\", \"readable\", \"obfuscated\", \"suspicious\" }\nlocal output_files = {}\nfor _, name in ipairs(headers) do\n    local path = output_dir .. \"/\" .. name .. \".txt\"\n    output_files[name] = path\n    if not isfile(path) then\n        writefile(path, \"-- \" .. name:upper() .. \" --\\n\\n\")\n    end\nend\n\nlocal orig_appendfile = appendfile or function() end\nfunction appendfile(file, content)\n    if not isfile(file) then writefile(file, \"\") end\n    orig_appendfile(file, content)\nend\n\nlocal function classify(k, v)\n    local cats = {}\n    if type(v) == \"string\" then\n        if #v > 40 and v:match(\"[^%w%s]\") then cats.obfuscated = true end\n        if #v > 100 and not v:match(\"[%s]\") then cats.suspicious = true end\n        if #v > 2 and not v:match(\"^%d+$\") then cats.readable = true end\n    end\n    return cats\nend\n\nlocal function deep_unpack(tbl)\n    for _, v in pairs(tbl) do\n        if type(v) == \"table\" then\n            deep_unpack(v)\n        elseif type(v) == \"string\" then\n            local cats = classify(_, v)\n            for cat in pairs(cats) do\n                if output_files[cat] then appendfile(output_files[cat], v .. \"\\n\") end\n            end\n        end\n    end\nend\n\nlocal original_unpack = unpack or table.unpack\nfunction unpack(...)\n    for _, v in ipairs({...}) do\n        if type(v) == \"table\" then deep_unpack(v) end\n    end\n    return original_unpack(...)\nend\n\n_G.unpack = unpack\n_G.appendfile = appendfile\n--use the example below pase a script loadstring and it may freeze your game\n--basic readable moonsec dumper v3\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/mokaEZF/SczerRx/refs/heads/main/local\",true))()\n-- u can change the link","owner":{"_id":"66a02c6faf15e066732bf2d4","username":"VerbalHubOfficial","verified":false,"profilePicture":"/images/photo/66a02c6faf15e066732bf2d4-1746662843505.png","status":"offline","id":"66a02c6faf15e066732bf2d4","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":2350,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1758736956848.jpg","likeCount":4,"dislikeCount":0,"createdAt":"2025-09-24T18:02:36.871Z","editBy":{"_id":"66a02c6faf15e066732bf2d4","username":"VerbalHubOfficial","status":"offline","id":"66a02c6faf15e066732bf2d4"},"executes":22,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d4323c2ea56fb1c84bf199","editBy":{"_id":"66a02c6faf15e066732bf2d4","username":"VerbalHubOfficial","status":"offline","id":"66a02c6faf15e066732bf2d4"},"message":"Create script","createdAt":"2025-09-24T18:02:36.873Z"},{"_id":"68d4349cf9271b3461bb5b18","editBy":{"_id":"66a02c6faf15e066732bf2d4","username":"VerbalHubOfficial","status":"offline","id":"66a02c6faf15e066732bf2d4"},"message":"Update script","createdAt":"2025-09-24T18:12:44.007Z"}],"comments":[{"_id":"68d43df9f7a491ee24976146","commentBy":{"_id":"68c0212614548da8fe873ab9","username":"SyrexGenesis","verified":false,"role":"user","profilePicture":"/images/photo/68c0212614548da8fe873ab9-1757941704674.png","createdAt":"2025-09-09T12:44:22.090Z","lastActive":"2025-10-21T00:23:01.534Z","status":"offline","id":"68c0212614548da8fe873ab9"},"text":"When I put the load string it will create a txt file in workspace right?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-24T18:52:41.640Z","liked":false,"disliked":false},{"_id":"68d43e760f185f588ae9a637","commentBy":{"_id":"68c021261454