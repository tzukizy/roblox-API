{"slug":"Sword-Fights-on-the-Heights-IV-Give-all-items-89909","_id":"6972d7a7ed2fb76bbc79244f","title":"Give all items","game":{"_id":"67e5e1ffb360710ec3c77fb9","gameId":47324,"name":"Sword Fights on the Heights IV","imageUrl":"/images/sb/rbx-c9dffb3a06853329f713af88cf6233d3-48b428013118.png","placeId":47324},"features":"Gives all items","tags":["Item giver"],"script":"local itemsToFind = {\n\t\"Illumina\", \"MedKit\", \"Venomshank\", \n\t\"Ice Dagger\", \"Firebrand\", \"Windforce\", \n\t\"Darkheart\", \"Ghostwalker\"\n}\n\nlocal player = game.Players.LocalPlayer\n\nlocal function teleportToItems(character)\n\tlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\t\n\tfor _, itemName in pairs(itemsToFind) do\n\t\tlocal tool = game.Workspace:FindFirstChild(itemName, true)\n\t\t\n\t\tif tool and tool:IsA(\"Tool\") then\n\t\t\tlocal handle = tool:FindFirstChild(\"Handle\") or tool:FindFirstChildWhichIsA(\"BasePart\")\n\t\t\t\n\t\t\tif handle then\n\t\t\t\thrp.CFrame = handle.CFrame * CFrame.new(0, 3, 0)\n\t\t\t\ttask.wait(0.5) \n\t\t\tend\n\t\tend\n\tend\nend\n\nif player.Character then teleportToItems(player.Character) end\nplayer.CharacterAdded:Connect(teleportToItems)","owner":{"_id":"692153f1b045d4edda59d84a","username":"Robloxplayer37864","verified":false,"profilePicture":"/images/photo/692153f1b045d4edda59d84a-1764669962549.png","status":"offline","id":"692153f1b045d4edda59d84a","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1102,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-dac6361bf791f88892ab4d123ac8fda8-3eee00e2894a.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-01-23T02:06:31.293Z","executes":2003,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6972d7a7ed2fb76bbc792452","editBy":{"_id":"692153f1b045d4edda59d84a","username":"Robloxplayer37864","status":"offline","id":"692153f1b045d4edda59d84a"},"message":"Cr