pe == Enum.HumanoidRigType.R15 then\n            local lowerTorso = char:FindFirstChild(\"LowerTorso\")\n            local rootJoint = lowerTorso and lowerTorso:FindFirstChild(\"Root\")\n            if rootJoint then\n                rootJoint.C0 = CFrame.new(rootJoint.C0.Position) * CFrame.Angles(0, rad, 0)\n            end\n        else\n            local torso = char:FindFirstChild(\"Torso\")\n            local rootJoint = rootPart:FindFirstChild(\"RootJoint\")\n            if rootJoint then\n                rootJoint.C0 = CFrame.new(rootJoint.C0.Position) * CFrame.Angles(-math.pi/2, 0, math.pi) * CFrame.Angles(0, 0, rad)\n            end\n        end\n    end\nend)\n","features":"AntiAim Universal Script R15|R6","tags":[],"discord":"","keyLink":"","owner":{"_id":"6948b7ec412eaa14db0eeb7a","username":"FurstyTwink","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0471dbfcda671fb5998b9f5500d8ee036c59ffac8e5aadc368471af8aa123cd3.webp","original":"https://scriptblox.com/images/photo/6948b7ec412eaa14db0eeb7a-1771683683609.jpg"},"status":"offline","id":"6948b7ec412eaa14db0eeb7a","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/0471dbfcda671fb5998b9f5500d8ee036c59ffac8e5aadc368471af8aa123cd3.webp","original":"https://scriptblox.com/images/photo/6948b7ec412eaa14db0eeb7a-1771683683609.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:33:12.427Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6999c8b286bd59b21c05c98f","editBy":{"_id":"6948b7ec412eaa14db0eeb7a","username":"FurstyTwink","status":"offline","id":"6948b7ec412eaa14db0eeb7a"},"message":"Create script","createdAt":"2026-02-21T15:01:06.298Z"}],"comments":[{"_id":"6999ce8a117779f29809ef82","commentBy":{"_id":"6975ad15371e4249b541b864","username":"ozh08","verified":f