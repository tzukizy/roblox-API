ter\n    local tool = character:FindFirstChildWhichIsA(\"Tool\")\n    if tool and not string.find(string.lower(tool.Name), \"pickaxe\") and not string.find(string.lower(tool.Name), \"hatchet\") and not string.find(string.lower(tool.Name), \"shovel\") then\n        workspace.Remotes.UseItem:FireServer(tool,false)\n        virtualInputManager:SendMouseButtonEvent(1622, 682, 0, true, game, 1)\n        virtualInputManager:SendMouseButtonEvent(1622, 682, 0, false, game, 1)\n        for _,v in workspace.Areas:GetDescendants() do\n            if v.ClassName == \"Model\" and v:FindFirstChild(\"EnemyHumanoid\") and v.EnemyHumanoid.Health > 0 and v:FindFirstChild(\"HumanoidRootPart\") and v.Name ~= \"Target Dummy\" then\n                character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame:ToWorldSpace(cframeNew(0,0,7.5))\n            end\n        end\n    end\nend)\n","features":"it now tps you to each enemy instead of tping all of them to you so its a bit less effective","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:09:27.948Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d7d3","editBy":{"_id