{"slug":"Universal-Script-Take-A-Screenshot-16507","_id":"66aaa38d862a2069b6724827","title":"Take A Screenshot","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Idk","tags":["Universal","universal script","Screenshot"],"script":"-- Load the Orion Library\nlocal OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()\n\n-- Create a window\nlocal Window = OrionLib:MakeWindow({Name = \"Screenshot\", HidePremium = false, SaveConfig = true, ConfigFolder = \"OrionExample\"})\n\n-- Create a tab\nlocal Tab = Window:MakeTab({\n    Name = \"Main\",\n    Icon = \"rbxassetid://4483345998\",\n    PremiumOnly = false\n})\n\n-- Add a section\nlocal Section = Tab:AddSection({\n    Name = \"Section 1\"\n})\n\n-- Add a button to take a screenshot\nTab:AddButton({\n    Name = \"Take Screenshot\",\n    Callback = function()\n        game:GetService(\"CoreGui\"):TakeScreenshot()\n        OrionLib:MakeNotification({\n            Name = \"Screenshot Taken\",\n            Content = \"A screenshot has been successfully taken.\",\n            Image = \"rbxassetid://4483345998\",\n            Time = 5\n        })\n    end    \n})\n\n-- Initialize the GUI\nOrionLib:Init()","owner":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"https://scriptblox.com/images/photo/6570eb9b5d75332ca0540983-1738547621153.png"},"status":"offline","id":"6570eb9b5d75332ca0540983","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/3bb09808cdea92237e1b0c3f263d98e1439cf6d56a63c6021912272ab762fefa.webp","original":"h