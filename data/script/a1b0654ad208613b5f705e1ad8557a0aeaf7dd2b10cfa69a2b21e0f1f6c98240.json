Part = checkpointsFolder:FindFirstChild(nextCheckpointName)\n    return nextCheckpointPart\nend\n\nlocal function teleportToCheckpoint(checkpointPart)\n    if checkpointPart then\n        local targetCFrame = checkpointPart.CFrame * CFrame.new(0, 3, 0)\n        player.Character:SetPrimaryPartCFrame(targetCFrame)\n    end\nend\n\nlocal function startTeleportingFromCurrentStage()\n    local currentStage = currentStageValue.Value\n    while true do\n        local nextCheckpoint = getNextCheckpoint(currentStage)\n        if not nextCheckpoint then break end\n        teleportToCheckpoint(nextCheckpoint)\n        currentStage = currentStage + 1\n        currentStageValue.Value = currentStage\n        wait(0.5)\n    end\nend\n\nstartTeleportingFromCurrentStage()","features":"Features: \n\n- Auto Stages\n- Free Coins & Gems every STAGES\n\n- ProjectScripter200","tags":[],"discord":"","keyLink":"","owner":{"_id":"66e294dec213bb7678acb60d","username":"ProjectScripter200","verified":false,"profilePicture":{"url":"https://media.kocakz.me/30507dd5ae1180f8ce1cc28a019e431252a059b67cfb3d1e485946a56f73e19d.webp","original":"https://scriptblox.com/images/photo/66e294dec213bb7678acb60d-1726126084062.png"},"status":"offline","id":"66e294dec213bb7678acb60d","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/30507dd5ae1180f8ce1cc28a019e431252a059b67cfb3d1e485946a56f73e19d.webp","original":"https://scriptblox.com/images/photo/66e294dec213bb7678acb60d-1726126084062.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:57:08.147Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52519","editBy":{"_id":"66e294dec213bb7678acb60d","username":"ProjectScripter200","status":"offline","id":"66e294dec213bb7678acb60d"},"message":"Create script","createdA