{"_id":"6923308b5f27c264a613febf","title":"Godmode OPEN SOURCE","game":{"_id":"6922de19be2b549c40cc2efb","gameId":92371631484540,"name":"100 Waves Later","imageUrl":{"url":"https://media.kocakz.me/ae156185109c032ae3acb160254fcbce351741d0699961723b80f6b23caa033f.webp","original":"https://tr.rbxcdn.com/180DAY-bd05ed57fc0af36b198e9cb068e47ac8/150/150/Image/Png/noFilter"},"slug":"92371631484540-100-waves-later","path":"/game/92371631484540-100-waves-later","thumbnail":{"url":"https://media.kocakz.me/ae156185109c032ae3acb160254fcbce351741d0699961723b80f6b23caa033f.webp","original":"https://tr.rbxcdn.com/180DAY-bd05ed57fc0af36b198e9cb068e47ac8/150/150/Image/Png/noFilter"},"placeId":92371631484540},"slug":"Survive-Wave-Z-Godmode-OPEN-SOURCE-69287","verified":false,"key":false,"keyless":false,"views":15497,"executes":33,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/dc8c823e3d68d5f0f981fb8c96742f77fff8d84f8a360c30aa54a313a80a8aa5.webp","original":"https://scriptblox.com/images/sb/92371631484540-1763913867864.webp","scriptblox":"https://scriptblox.com/images/script/92371631484540-1763913867864.webp"},"thumbnail":{"url":"https://media.kocakz.me/dc8c823e3d68d5f0f981fb8c96742f77fff8d84f8a360c30aa54a313a80a8aa5.webp","original":"https://scriptblox.com/images/sb/92371631484540-1763913867864.webp","scriptblox":"https://scriptblox.com/images/script/92371631484540-1763913867864.webp"},"likeCount":6,"dislikeCount":5,"createdAt":"2025-11-23T16:04:27.892Z","updatedAt":"2025-11-23T16:04:27.892Z","lastBump":"2025-11-23T16:04:27.892Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\n\ngetgenv().config = {\n    active = true,\n    assist = true\n}\n\nlocal function restoreSelf()\n    if not player.Character then return end\n    \n    local character = player.Character\n    local humanoid = character:FindFirstChild(\"Humanoid\")\n    local head = character:FindFirstChild(\"Head\")\n    \n    if humanoid and head and humanoid.Health == 0 then\n        local prompt = head:FindFirstChild(\"RevivePrompt\")\n        if prompt then\n            fireproximityprompt(prompt)\n        end\n    end\nend\n\nlocal function restoreOthers()\n    if not player.Character then return end\n    \n    local character = player.Character\n    local humanoid = character:FindFirstChild(\"Humanoid\")\n    local root = character:FindFirstChild(\"HumanoidRootPart\")\n    \n    if not humanoid or not root or humanoid.Health == 0 then return end\n    \n    for _, otherPlayer in ipairs(Players:GetPlayers()) do\n        if otherPlayer == player then continue end\n        \n        local otherCharacter = otherPlayer.Character\n        if not otherCharacter then continue end\n        \n        local otherHumanoid = otherCharacter:FindFirstChild(\"Humanoid\")\n        local otherHead = otherCharacter:FindFirstChild(\"Head\")\n        local otherRoot = otherCharacter:FindFirstChild(\"HumanoidRootPart\")\n        \n        if otherHumanoid and otherHead and otherRoot and otherHumanoid.Health == 0 then\n            local prompt = otherHead:FindFirstChild(\"RevivePrompt\")\n            if prompt then\n                root.CFrame = otherRoot.CFrame\n                fireproximityprompt(prompt)\n            end\n        end\n    end\nend\n\nRunService.Heartbeat:Connect(function()\n    if not getgenv().config.active then return end\n    \n    restoreSelf()\n    \n    if getgenv().config.assist then\n        restoreOthers()\n    end\nend)","features":"GODMODE! PLEASE LIKE","tags":["godmode","SurviveWaveZ"],"discord":"","keyLink":"","owner":{"_id":"690f54bbcff51b46c5fb591e","username":"simkaHUB","verified":false,"profilePicture":{"url":"https://media.kocakz.me/39c8d09b3dfc7e580d979fa3106a7da11db80478fbbb41796cc702ec086d214f.webp","original":"https://scriptblox.com/images/photo/690f54bbcff51b46c5fb591e-17626