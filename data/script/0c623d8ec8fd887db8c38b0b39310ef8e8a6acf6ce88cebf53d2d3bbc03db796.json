ol.RequiresHandle = true\n\nlocal fakeHandle = Instance.new(\"Part\")\nfakeHandle.Name = \"Handle\"\nfakeHandle.Size = Vector3.new(1,4,1)\nfakeHandle.Transparency = 1\nfakeHandle.CanCollide = false\nfakeHandle.Parent = fakeTool\n\nfakeTool.Parent = player.Backpack\n\nlocal slashAnimID = anim2track(\"rbxassetid://82407225122935\")\nlocal slashAnimation = Instance.new(\"Animation\")\nslashAnimation.AnimationId = slashAnimID\n\nlocal slashTrack = hum:LoadAnimation(slashAnimation)\nslashTrack.Priority = Enum.AnimationPriority.Action\nslashTrack.Looped = false\n\nlocal function getRealTool()\n\tfor _, v in pairs(player.Backpack:GetChildren()) do\n\t\tif v:IsA(\"Tool\") and v ~= fakeTool and v:FindFirstChild(\"Handle\") then\n\t\t\treturn v\n\t\tend\n\tend\n\tfor _, v in pairs(char:GetChildren()) do\n\t\tif v:IsA(\"Tool\") and v ~= fakeTool and v:FindFirstChild(\"Handle\") then\n\t\t\treturn v\n\t\tend\n\tend\nend\n\nlocal function cleanRealTool(tool)\n\tfor _, obj in pairs(tool:GetDescendants()) do\n\t\tif obj:IsA(\"BasePart\") then\n\t\t\tobj.LocalTransparencyModifier = 1\n\t\tend\n\t\tif obj:IsA(\"Sound\") then\n\t\t\tobj.Volume = 0\n\t\tend\n\t\tif obj:IsA(\"Animation\") then\n\t\t\tobj:Destroy()\n\t\tend\n\tend\nend\n\nlocal att0 = Instance.new(\"Attachment\", root)\nlocal att1 = Instance.new(\"Attachment\", root)\natt0.Position = Vector3.new(0, 1, 0)\natt1.Position = Vector3.new(0, -1, 0)\n\nlocal trail = Instance.new(\"Trail\", root)\ntrail.Attachment0 = att0\ntrail.Attachment1 = att1\ntrail.Color = ColorSequence.new{\n\tColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),\n\tColorSequenceKeypoint.new(1, Color3.fromRGB(120,0,120))\n}\ntrail.Lifetime = 0.4\ntrail.LightEmission = 1\n\nlocal debounce = false\n\nfakeTool.Activated:Connect(function()\n\tif debounce then return end\n\tdebounce = true\n\n\tlocal realTool = getRealTool()\n\tif realTool then\n\t\tcleanRealTool(realTool)\n\t\tslashTrack:Play()\n\t\ttask.wait(slashTrack.Length * 0.9)\n\t\thum:EquipTool(realTool)\n\t\ttask.wait(0.15)\n\t\trealTool:Activate()\n\t\ttask.wait(0.25)\n\t\thum:EquipTool(fakeTool)\n\tend\n\n\ttask.wait(0.3)\n\tdebounce = false\nend)\n\ntask.spawn(function()\n\twhile task.wait() do\n\t\tlocal t = getRealTool()\n\t\tif t then cleanRealTool(t) end\n\tend\nend)","features":"Cool john doe slash\n\nREQUIREMENTS\nR15 Game for FE anims\nDamage Tool for Damage\nNothing Else :D","tags":[],"discord":"","keyLink":"","owner":{"_id":"68e21e63ff3fde752aa1f5e3","username":"RemoteAbuser","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5f86a04ba9b3fa78763a9dbd22cef5560433a93971386fea689124bfb89b4bf8.webp","original":"https://scriptblox.com/images/photo/68e21e63ff3fde752aa1f5e3-1772289350449.png"},"status":"offline","id":"68e21e63ff3fde752aa1f5e3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/5f86a04ba9b3fa78763a9dbd22cef5560433a93971386fea689124bfb89b4bf8.webp","original":"https://scriptblox.com/images/photo/68e21e63ff3fde752aa1f5e3-1772289350449.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:31:27.872Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c79f319c69ac11d87454ff","editBy":{"_id":"68e21e63ff3fde752aa1f5e3","username":"RemoteAbuser","status":"offline","id":"68e21e63ff3fde752aa1f5e3"},"message":"Create script","createdAt":"2026-03-28T09:28:17.469Z"}],"comments":[{"_id":"69c79f4c64b477aa3a358a9d","commentBy":{"_id":"68e21e63ff3fde752aa1f5e3","username":"RemoteAbuser","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/5f86a04ba9b3fa78763a9dbd22cef5560433a93971386fea689124bfb89b4bf8.webp","original":"https://scriptblox.com/images/photo/68e21e63ff3fde752aa1f5e3-1772289350449.png"},"createdAt":"2025-10-05T07:29:39.642Z","lastActive":"2026-09-03T17:34:22.890Z","status":"o