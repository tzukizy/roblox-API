{"_id":"69f0d7398a02e3796623a5f9","title":"Print Your entire Inventory","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/8d045f6f2bdb12cbf12ecd42dada76e2eaa8dcc48917dbaa53932f9ccad1cfde.webp","original":"https://scriptblox.com/images/sb/0-1777391417576.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/8d045f6f2bdb12cbf12ecd42dada76e2eaa8dcc48917dbaa53932f9ccad1cfde.webp","original":"https://scriptblox.com/images/sb/0-1777391417576.png"},"placeId":0},"slug":"Universal-Script-Print-Your-entire-Inventory-208426","verified":false,"key":false,"keyless":false,"views":405,"executes":9,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/34b03762a8efb95c59cbc3e80405f73b01ddc9167b8fec8aa147399ea3d6b41e.webp","original":"https://scriptblox.com/images/sb/0-1777391417576.png","scriptblox":"https://scriptblox.com/images/script/0-1777391417576.png"},"thumbnail":{"url":"https://media.kocakz.me/34b03762a8efb95c59cbc3e80405f73b01ddc9167b8fec8aa147399ea3d6b41e.webp","original":"https://scriptblox.com/images/sb/0-1777391417576.png","scriptblox":"https://scriptblox.com/images/script/0-1777391417576.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-04-28T15:50:17.599Z","updatedAt":"2026-04-28T15:50:17.599Z","lastBump":"2026-04-28T15:50:17.599Z","script":"local player = game.Players.LocalPlayer\n\nlocal function getAllItems()\n    local items = {}\n\n    local function scan(container)\n        if not container then return end\n        for _, v in pairs(container:GetChildren()) do\n            if v:IsA(\"Tool\") then\n                items[v.Name] = (items[v.Name] or 0) + 1\n            end\n        end\n    end\n\n    scan(player:FindFirstChild(\"Backpack\"))\n    scan(player.Character)\n\n    return items\nend\n\nlocal function printSortedInventory()\n    local items = getAllItems()\n\n    local list = {}\n    for name, count in pairs(items) do\n        table.insert(list, {name = name, count = count})\n    end\n\n    table.sort(list, function(a, b)\n        return a.count < b.count\n    end)\n\n    for _, item in ipairs(list) do\n        print(item.name .. \" x\" .. item.count)\n    end\nend\n\nprintSortedInventory()","features":"prints ur entire backpack/inventory and says how many of that thing u have","tags":["open source","backpack"],"discord":"","keyLink":"","owner":{"_id":"680a5b1e8fe2d5b198d0fd34","username":"becausewhyy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"680a5b1e8fe2d5b198d0fd34","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:30:22.319Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69f0d7398a02e3796623a5fc","editBy":{"_id":"680a5b1e8fe2d5b198d0fd34","username":"becausewhyy","status":"offline","id":"680a5b1e8fe2d5b198d0fd34"},"message":"Create script","createdAt":"2026-04-28T15:50:17.603Z"}],"comments":[]}