{"_id":"67b0bcee69705ee3e4baab3a","title":"grab anyones country and ip","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/6073be03fab3d7ff978233883fb3b856bcdbc97d289402f705d145897ff86a06.webp","original":"https://scriptblox.com/images/sb/1235122-1739635950923.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/6073be03fab3d7ff978233883fb3b856bcdbc97d289402f705d145897ff86a06.webp","original":"https://scriptblox.com/images/sb/1235122-1739635950923.png"},"placeId":0},"slug":"Universal-Script-grab-anyones-country-and-ip-29290","verified":false,"key":false,"keyless":false,"views":6377,"executes":61,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/892d043ecf9028fd0496dc446545dcc0038779b0b561631994812828294ec2fa.webp","original":"https://scriptblox.com/images/sb/1235122-1739635950923.png","scriptblox":"https://scriptblox.com/images/script/1235122-1739635950923.png"},"thumbnail":{"url":"https://media.kocakz.me/892d043ecf9028fd0496dc446545dcc0038779b0b561631994812828294ec2fa.webp","original":"https://scriptblox.com/images/sb/1235122-1739635950923.png","scriptblox":"https://scriptblox.com/images/script/1235122-1739635950923.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-02-15T16:12:30.954Z","updatedAt":"2025-02-15T16:12:30.954Z","lastBump":"2025-02-15T16:12:30.954Z","script":"local player = game.Players.LocalPlayer\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal textLabel = Instance.new(\"TextLabel\")\ntextLabel.Parent = screenGui\ntextLabel.Size = UDim2.new(0, 600, 0, 100)\ntextLabel.Position = UDim2.new(0.5, -300, 0.5, -50)\ntextLabel.BackgroundTransparency = 0.5\ntextLabel.TextColor3 = Color3.fromRGB(255, 0, 0)\ntextLabel.TextScaled = true\n\nlocal function generateFakeIP()\n    local ip = \"\"\n    for i = 1, 3 do\n        ip = ip .. math.random(0, 999)\n        if i < 3 then\n            ip = ip .. \".\"\n        end\n    end\n    return ip\nend\n\ntextLabel.Text = \"Processing IP Logger...\"\nwait(0.3)\ntextLabel.Text = \"Your IP is: \" .. generateFakeIP()\n\nlocal dragging = false\nlocal dragInput, dragStart, startPos\n\ntextLabel.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n        dragging = true\n        dragStart = input.Position\n        startPos = textLabel.Position\n        input.Consumed = true\n    end\nend)\n\ntextLabel.InputChanged:Connect(function(input)\n    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then\n        local delta = input.Position - dragStart\n        textLabel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\n    end\nend)\n\ntextLabel.InputEnded:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n        dragging = false\n    end\nend)","features":"Grabs the country and ip of the selected player in the gui of the svripty","tags":[],"discord":"","keyLink":"","owner":{"_id":"676d59793f240494561e5861","username":"temokotegamesnoonef","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"676d59793f240494561e5861","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:02:17.918Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54d95","editBy":{"_id":"676d59793f240494561e5861","username":"temokotegamesnoonef","status":"offline","id":"676d59793f240494561e5861"},"message":"Create script","createdAt":"2025-03-27T16:24:37.854Z"}],"comments":[{"_id":"67b0bdddc37b0650897c8b4e","commentBy":{"_id":"67b080ae69705ee3e4b2c5e8","username":"DJUNITAZ","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-02-15T11:55:26.478Z","lastActive":"2025-02-25T16:40:52.296Z","status":"offline","id":"67b080ae69705ee3e4b2c5e8","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"generateFakeIp() function be like:","createdAt":"2025-02-15T16:16:29.747Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"67b0bdf7cb0485f5764693cb","commentBy":{"_id":"67b080ae69705ee3e4b2c5e8","username":"DJUNITAZ","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-02-15T11:55:26.478Z","lastActive":"2025-02-25T16:40:52.296Z","status":"offline","id":"67b080ae69705ee3e4b2c5e8","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"and before the dot number can be only 1-255","createdAt":"2025-02-15T16:16:55.237Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"68ae36149d3c07cb163806ba","commentBy":{"_id":"6899629d01046640f51e8af5","username":"Unbounded","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/00236b9b304fda50b90634e6bad4b735fc0152c26299e33cab3eb19cf38ae63b.webp","original":"https://scriptblox.com/images/photo/6899629d01046640f51e8af5-1754882921951.jpg"},"createdAt":"2025-08-11T03:25:17.466Z","lastActive":"2025-09-06T09:47:05.428Z","status":"offline","id":"6899629d01046640f51e8af5","profile":{"url":"https://media.kocakz.me/00236b9b304fda50b90634e6bad4b735fc0152c26299e33cab3eb19cf38ae63b.webp","original":"https://scr