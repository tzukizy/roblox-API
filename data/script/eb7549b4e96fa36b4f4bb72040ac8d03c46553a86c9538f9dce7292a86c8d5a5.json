{"slug":"Low-player-Low-ping-server_713","_id":"6208f2263ed0c9f67dabd553","title":"Low player / Low ping server","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2766889-1644753446106.jpg","placeId":0},"features":"Joins you the lowest player server or lowest ping server","tags":[],"script":"local Lowest = \"ping\" -- set to \"playing\" to find the lowest player server\n\nlocal HTTPService = game:GetService(\"HttpService\")\n\nlocal success, servers = pcall(function()\n   return HTTPService:JSONDecode(game:HttpGet(\n       \"https://games.roblox.com/v1/games/\" .. tostring(game.PlaceId) .. \"/servers/Public?limit=100\"\n   )).data\nend)\n\nif not success then return end\n\nlocal server = servers[1]\n\nfor i,svr in pairs(servers) do\n   if svr[Lowest] < server[Lowest] then\n       server = svr\n   end\nend\n\ngame:GetService(\"TeleportService\"):TeleportToPlaceInstance(game.PlaceId, server.id)","owner":{"_id":"6208f07d8b3671e7d680afb1","username":"Seby","verified":false,"profilePicture":"/images/photo/6208f07d8b3671e7d680afb1-1720108824846.jpg","status":"offline","id":"6208f07d8b3671e7d680afb1","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":28796,"scriptType":"free","isUniversal":true,"isPatched":false,"createdAt":"2022-02-13T11:57:26.116Z","visibility":"public","dislikeCount":0,"likeCount":0,"image":"/images/sb/2766889-1644753446106.jpg","executes":606,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e736","editBy":{"_id":"6208f07d8b3671e7d680afb1","username":"Seby","status":"offline","id":"6208f07d8b3671e7d680afb1"},"message":"Create script","createdAt":"2025-03-27T21:51:11.531Z"}],"comments":[{"_id":"620903964a0cf54d01a506f0","commentBy":{"_id":"61f32a6370b1fa6c8509a1a6","username":"ThunderMods","verified":true,"role":"owner","profilePicture":"/images/photo/61f32a6370b1fa6c8509a1a6-1697324427148.gif","createdAt