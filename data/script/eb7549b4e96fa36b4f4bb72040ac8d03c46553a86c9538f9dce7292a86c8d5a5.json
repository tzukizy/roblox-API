{"slug":"Low-player-Low-ping-server_713","_id":"6208f2263ed0c9f67dabd553","title":"Low player / Low ping server","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Joins you the lowest player server or lowest ping server","tags":[],"script":"local Lowest = \"ping\" -- set to \"playing\" to find the lowest player server\n\nlocal HTTPService = game:GetService(\"HttpService\")\n\nlocal success, servers = pcall(function()\n   return HTTPService:JSONDecode(game:HttpGet(\n       \"https://games.roblox.com/v1/games/\" .. tostring(game.PlaceId) .. \"/servers/Public?limit=100\"\n   )).data\nend)\n\nif not success then return end\n\nlocal server = servers[1]\n\nfor i,svr in pairs(servers) do\n   if svr[Lowest] < server[Lowest] then\n       server = svr\n   end\nend\n\ngame:GetService(\"TeleportService\"):TeleportToPlaceInstance(game.PlaceId, server.id)","owner":{"_id":"6208f07d8b3671e7d680afb1","username":"Seby","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/bcbc945aa298bae87949a96b184f4b6490cedca1e495e86f902defe65f133d7f.webp","original":"https://scriptblox.com/images/photo/6208f07d8b3671e7d680afb1-1720108824846.jpg"},"status":"offline","id":"6208f07d8b3671e7d680afb1","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/bcbc945aa298bae87949a96b184f4b6490cedca1e495e86f902defe65f133d7f.webp","original":"https://scriptblox.com/images/photo/6208f07d8b3671e7d680afb1-1720108824846.jpg"}},"verified":false,"views":28844,"scriptType":"free","isUniversal":true,"isPatched":false,"createdAt":"2022-02-13T11:57:26.116Z","visibility":"public","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/2766889-1644753446106.jpg","scriptbl