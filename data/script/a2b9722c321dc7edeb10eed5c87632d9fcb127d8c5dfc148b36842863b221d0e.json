{"slug":"Total-Roblox-Drama-LONG-NAME-DESTROYER-LAG-FIX-TRD-49039","_id":"68a1d3b5447c85e4df34dc6e","title":"LONG NAME DESTROYER  [LAG FIX]","game":{"_id":"67e5e1ffb360710ec3c77daa","gameId":4889315193,"name":"Total Roblox Drama","imageUrl":"/images/sb/rbx-38c8028c60926e8a3c5e53e459965b40-815214c21a2d.png","placeId":4889315193},"features":"- Fixes lag from exploiters with custom name\n- Destroys any names over 500 / 750 characters\n- Open-source","tags":["trd","total drama","total roblox drama","syla","jann"],"script":"local function destroyLongTextElements(parent)\n    for _, element in ipairs(parent:GetDescendants()) do\n     \n        if pcall(function() return element.Text end) and type(element.Text) == \"string\" and #element.Text > 750 then\n            element:Destroy() -- Completely destroy the element\n        end\n    end\nend\n\nlocal function scanGame()\n  \n    for _, service in ipairs(game:GetChildren()) do\n        destroyLongTextElements(service)\n    end\n\n    destroyLongTextElements(game:GetService(\"Players\").LocalPlayer.PlayerGui)\n    destroyLongTextElements(game:GetService(\"ReplicatedStorage\"))\n    destroyLongTextElements(game:GetService(\"Workspace\"))\nend\n\nscanGame()\n\ngame.DescendantAdded:Connect(function(descendant)\n    if pcall(function() return descendant.Text end) and type(descendant.Text) == \"string\" and #descendant.Text > 750 then\n        descendant:Destroy()\n    end\nend)","owner":{"_id":"688ea00645b82f55b62bfa27","username":"joshwessels13","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"688ea00645b82f55b62bfa27","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":8022,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-43ca50b3f429d61283654469d56ed9f1-45ab683ac3b1.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-08-17T13:05:57.209Z","editBy":{"_id":"688ea00645b82f55b62bfa27","username":"joshwess