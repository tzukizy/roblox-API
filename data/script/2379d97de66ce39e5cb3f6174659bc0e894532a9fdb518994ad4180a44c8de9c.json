{"slug":"Tower-of-Hell-god-mode-(opensrc)-224953","_id":"6a899bea8e999b0c4faf9f76","title":"god mode (opensrc)","game":{"_id":"67e5e1ffb360710ec3c77e21","gameId":1962086868,"name":"Tower of Hell","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":1962086868},"features":"feel free to use it","tags":[],"script":"local Players=game:GetService(\"Players\")\nlocal LP=Players.LocalPlayer\nlocal currentHum=nil\nlocal function getHumanoid()\nlocal char=LP.Character\nreturn char and char:FindFirstChildOfClass(\"Humanoid\")\nend\ncurrentHum=getHumanoid()\nif currentHum then currentHum.Health=currentHum.MaxHealth end\nlocal oldNC\noldNC=hookmetamethod(game,\"__namecall\",newcclosure(function(self,...)\nlocal method=getnamecallmethod()\nif currentHum then\nif method==\"TakeDamage\"and self:IsA(\"Humanoid\")and self==currentHum then return nil end\nif method==\"BreakJoints\"and self:IsA(\"Model\")and self==LP.Character then return nil end\nif method==\"ChangeState\"and self:IsA(\"Humanoid\")and self==currentHum then\nlocal state=select(1,...)\nif state==Enum.HumanoidStateType.Dead then return nil end\nend\nif method==\"Kill\"and self:IsA(\"Humanoid\")and self==currentHum then return nil end\nend\nreturn oldNC(self,...)\nend))\nlocal oldNI\noldNI=hookmetamethod(game,\"__newindex\",newcclosure(function(self,key,value)\nif currentHum and self:IsA(\"Humanoid\")and self==currentHum then\nif key==\"Health\"and(typeof(value)==\"number\"and value<self.MaxHealth)then return end\nend\nreturn oldNI(self,key,value)\nend))\nLP.CharacterAdded:Connect(function(char)\ntask.wait(0.5)\ncurrentHum=char:FindFirstChildOfClass(\"Humanoid\")\nif currentHum then currentHum.Health=currentHum.MaxHealth end\nend)","owner":{"_id":"690b476e14e89bc08d4df4ba","username":"Light1Light","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/01fadcf2e0d6d0712a7eeaf5d83136ce91139697