e() end) end\n    if obj.tracer          then pcall(function() obj.tracer:Remove() end) end\n    if obj.healthBillboard then obj.healthBillboard:Destroy() end\n    if obj.nameBillboard   then obj.nameBillboard:Destroy() end\n    espObjects[p] = nil\nend\n \nlocal function newDrawing(type_, props)\n    local ok, obj = pcall(Drawing.new, type_)\n    if not ok then return nil end\n    for k, v in pairs(props) do pcall(function() obj[k] = v end) end\n    return obj\nend\n \n-- Highlight: vždy znovu vytvoř s aktuálním charakterem, zabraňuje blikání\nlocal","parent":{"_id":"6a1ae867c17fcebb39a7c647","commentBy":{"_id":"6a1ae79040db370c035111d4","username":"Malikemilagba","profilePicture":"/images/user-default.webp","status":"offline","id":"6a1ae79040db370c035111d4"},"text":"How to get the script"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-24T15:33:50.313Z","liked":false,"disliked":false}]}