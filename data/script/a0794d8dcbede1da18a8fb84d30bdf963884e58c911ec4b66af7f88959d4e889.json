{"slug":"Kill-Streak-Kill-Streak-Script-OP-43384","_id":"685f88c3c1924cae595af65c","title":"Script OP","game":{"_id":"67e5e1ffb360710ec3c78668","gameId":12998806177,"name":"Kill Streak  ","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":12998806177},"features":"Killaura\nNo gui\n\n\n\nMade by me","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal lp = Players.LocalPlayer\nlocal char = lp.Character or lp.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal rs = game:GetService(\"ReplicatedStorage\")\nlocal hit = rs:WaitForChild(\"Remotes\"):WaitForChild(\"Hit\")\n\nwhile true do\n    for _, plr in pairs(Players:GetPlayers()) do\n        if plr ~= lp and plr.Character and plr.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local dist = (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude\n            if dist <= 10 then\n                local args = {\n                    [1] = {\n                        [plr.Name] = {\n                            Victim = plr,\n                            Vector = Vector3.new(1, 0, 0)\n                        }\n                    }\n                }\n                hit:FireServer(unpack(args))\n            end\n        end\n    end\n    wait(0.25)\nend","owner":{"_id":"684e3d6e901cfa8ce80dd454","username":"0111","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"684e3d6e901cfa8ce80dd454","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"discord":"https://discord.gg/seYEEamxSg","views":11268,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/e2a5ef90e3f09d04a745ecda718ac79951878045