{"slug":"Kill-Streak-Kill-Streak-Script-OP-43384","_id":"685f88c3c1924cae595af65c","title":"Script OP","game":{"_id":"67e5e1ffb360710ec3c78668","gameId":12998806177,"name":"Kill Streak  ","imageUrl":"/images/sb/rbx-767df4a1914bdbac41e972b223c4db9f-22127948145b.png","placeId":12998806177},"features":"Killaura\nNo gui\n\n\n\nMade by me","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal lp = Players.LocalPlayer\nlocal char = lp.Character or lp.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal rs = game:GetService(\"ReplicatedStorage\")\nlocal hit = rs:WaitForChild(\"Remotes\"):WaitForChild(\"Hit\")\n\nwhile true do\n    for _, plr in pairs(Players:GetPlayers()) do\n        if plr ~= lp and plr.Character and plr.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local dist = (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude\n            if dist <= 10 then\n                local args = {\n                    [1] = {\n                        [plr.Name] = {\n                            Victim = plr,\n                            Vector = Vector3.new(1, 0, 0)\n                        }\n                    }\n                }\n                hit:FireServer(unpack(args))\n            end\n        end\n    end\n    wait(0.25)\nend","owner":{"_id":"684e3d6e901cfa8ce80dd454","username":"0111","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"684e3d6e901cfa8ce80dd454","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord.gg/seYEEamxSg","views":11253,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/12998806177-1751091395851.jpg","likeCount":2,"dislikeCount":2,"createdAt":"2025-06-28T06:16:35.900Z","executes":1466,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"685f88c3c1924cae595af65e","editBy":{"_id":"684e3d6e