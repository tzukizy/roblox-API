{"slug":"Universal-Script-CONSOLE-BACKDOOR-SCANNER-62580","_id":"69077fc50e56b4b109adadf9","title":"CONSOLE BACKDOOR SCANNER","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Open source backdoor scanner for game owners and exploiters!","tags":[],"script":"-- dudebolt69's CONSOLE BACKDOOR SCANNER\n-- Prints results in F9 console\n-- Works in ALL executors\n\nprint(\"\\n=== DUDEBOLT69 BACKDOOR SCANNER ===\")\nprint(\"Scanning all scripts in game...\")\n\nlocal patterns = {\n    \"loadstring%s*%(%s*game:HttpGet\",           -- Remote script loader\n    \"game:HttpGet%s*%(%s*[\\\"']https?://\",       -- HttpGet to external\n    \"require%s*%(%s*%d%d%d%d%d%d%d%d%d%d+\",     -- Big asset ID\n    \"writefile\",                                -- Cookie stealer\n    \"syn%.request\",                             -- Synapse hook\n    \"spawn%s*%(%s*function%s*%(%s*%)%s*while\",  -- Hidden loop\n    \"https?://[^'\\\"]*%.(tk|xyz|top|cf|ga|ml)/\"  -- Shady domains\n}\n\nlocal found = 0\nlocal scanned = 0\n\nfor _, obj in ipairs(game:GetDescendants()) do\n    if obj:IsA(\"Script\") or obj:IsA(\"LocalScript\") or obj:IsA(\"ModuleScript\") then\n        scanned = scanned + 1\n        local src = \"\"\n        pcall(function() src = obj.Source or \"\" end)\n        \n        if src ~= \"\" then\n            local lineNum = 0\n            for line in src:gmatch(\"[^\\n]+\") do\n                lineNum = lineNum + 1\n                for _, pat in ipairs(patterns) do\n                    if line:find(pat) then\n                        found = found + 1\n                        print(string.format(\n                            \"\\n[BACKDOOR] %s | Line %d\\n   > %s\\n   → %s\",\n                            obj:GetFullName(), lineNum, line:sub(1, 100), pat\n                        ))\n                        break\n                    end\n                end\n            end\n        end\n    end\nend\n\nprint(\"\\n\" .. string.rep(\"=\", 50))\nif found == 0 then\n    print(\"SAFE: No backdoors found in \" .. scanned .. \" scripts!\")\nelse\n    print(\"ALERT: \" .. found .. \" backdoor(s) detected! Delete them NOW!\")\nend\nprint(\"SCAN COMPLETE\\n\")","owner":{"_id":"68dfcb3dc0e225ecfe833fc0","username":"Anonist","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/298c827bf4b0e9af324583e5a8dea82d6a12d15a3ee920f0ebf3c9270369c3c2.webp","original":"https://scriptblox.com/images/photo/68dfcb3dc0e225ecfe833fc0-1762343399129.png"},"status":"offline","id":"68dfcb3dc0e225ecfe833fc0","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/298c827bf4b0e9af324583e5a8dea82d6a12d15a3ee920f0ebf3c9270369c3c2.webp","original":"https://scriptblox.com/images/photo/68dfcb3dc0e225ecfe833fc0-1762343399129.png"}},"verified":false,"views":6399,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/c93367a2cf62a6e6021099a0ac2e37d4a1add5f5c5bb17f73bf82f35c0699ebc.webp","original":"https://scriptblox.com/images/sb/0-1762099141065.png","scriptblox":"https://scriptblox.com/images/script/0-1762099141065.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-02T15:59:01.086Z","executes":128,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:47:18.149Z"},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/c93367a2cf62a6e6021099a0ac2e37d4a1add5f5c5bb17f73bf82f35c0699ebc.webp","original":"https://scriptblox.com/images/sb/0-1762099141065.png","scriptblox":"https://scriptblox.com/images/script/0-1762099141065.png"},"changelog":[{"_id":"69077fc50e56b4b109ad