{"_id":"68fcfb965f8a0dedcf6d50c3","title":"BEST 2016 COREUI WORKING WITH CONTROLLER TOO!","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/60eba6541e01e70811e8a11248861405112c58377284d3ca1d74972198f7457b.webp","original":"https://scriptblox.com/images/sb/0-1761409942930.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/60eba6541e01e70811e8a11248861405112c58377284d3ca1d74972198f7457b.webp","original":"https://scriptblox.com/images/sb/0-1761409942930.jpg"},"placeId":0},"slug":"Universal-Script-BEST-2016-COREUI-WORKING-60721","verified":false,"key":false,"keyless":false,"views":1678254,"executes":4192,"scriptType":"free","isUniversal":true,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/410e9ef3a751d441624810103ce7143f35af5e43a1c6f8cc077a855270df7e83.webp","original":"https://scriptblox.com/images/sb/0-1761409942930.jpg","scriptblox":"https://scriptblox.com/images/script/0-1761409942930.jpg"},"thumbnail":{"url":"https://media.kocakz.me/410e9ef3a751d441624810103ce7143f35af5e43a1c6f8cc077a855270df7e83.webp","original":"https://scriptblox.com/images/sb/0-1761409942930.jpg","scriptblox":"https://scriptblox.com/images/script/0-1761409942930.jpg"},"likeCount":11,"dislikeCount":1,"createdAt":"2025-10-25T16:32:22.955Z","updatedAt":"2025-10-25T16:32:22.955Z","lastBump":"2025-10-25T16:32:22.955Z","script":"loadstring(game:HttpGet(\"https://pastebin.com/raw/9AQrDua1\"))()\n\nloadstring(game:HttpGet(\"https://rawscripts.net/raw/Jailbreak-Turn-your-Roblox-into-2016-Nostalgia-Roblox-1803\"))()\n\n--delete modern coreui(this part is made by ai)\n\nlocal CoreGui = game:GetService(\"CoreGui\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function createGUI()\n    -- Remove old TopBar if exists\n    if CoreGui:FindFirstChild(\"TopBarApp\") then\n        CoreGui.TopBarApp:Destroy()\n    end\n\n    -- Create TopBarApp\n    local topbar = Instance.new(\"ScreenGui\")\n    topbar.Name = \"TopBarApp\"\n    topbar.Parent = CoreGui\n\n    local topBarFrame = Instance.new(\"Frame\")\n    topBarFrame.Name = \"TopBarApp\"\n    topBarFrame.Size = UDim2.new(1,0,0,50)\n    topBarFrame.Position = UDim2.new(0,0,0,0)\n    topBarFrame.BackgroundTransparency = 1\n    topBarFrame.Parent = topbar\n\n    local menu = Instance.new(\"Frame\")\n    menu.Name = \"UnibarLeftFrame\"\n    menu.Parent = topBarFrame\n\n    local menuInner = Instance.new(\"Frame\")\n    menuInner.Name = \"UnibarMenu\"\n    menuInner.Parent = menu\n\n    local trigger = Instance.new(\"ImageButton\")\n    trigger.Name = \"TriggerPoint\"\n    trigger.Parent = topBarFrame\n    trigger.Size = UDim2.new(0,50,0,36)\n    trigger.Position = UDim2.new(0,0,0,8.9)\n    trigger.BackgroundTransparency = 1\n\n    local nameLabel = Instance.new(\"TextLabel\")\n    nameLabel.Name = \"PlayerNameLabel\"\n    nameLabel.Parent = healthFrame\n    nameLabel.Text = LocalPlayer.Name\n    nameLabel.Font = Enum.Font.GothamBold\n    nameLabel.TextSize = 12\n    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)\n    nameLabel.BackgroundTransparency = 1\n    nameLabel.AnchorPoint = Vector2.new(1,0)\n    nameLabel.Position = UDim2.new(1,-23,0,-19)\n    nameLabel.Size = UDim2.new(0,200,0,25)\n    nameLabel.TextXAlignment = Enum.TextXAlignment.Left\n\n    return {topbar=topbar, trigger=trigger, health=healthFrame}\nend\n\n-- Create the GUI initially\nlocal guiRefs = createGUI()\nlocal trigger = guiRefs.trigger\nlocal health = guiRefs.health\n\n--// Initial states\ntrigger.BackgroundTransparency = 1\nhealth.Visible = true\ntrigger.ScalingIcon.Size = UDim2.new(0,32,0,25)\n\nlocal state = false\n\n--// Loop toggle\ntask.spawn(function()\n    while true do\n        if state then\n            trigger.BackgroundTransparency = 1\n            health.Visible = true\n            trigger.ScalingIcon.Size = UDim2.new(0,32,0,25)\n        else\n        end\n        state = not state\n        task.wait()\n    end\nend)\n\n--// Loop to constantly recreate GUI\ntask.spawn(function()\n    while true do\n        task.wait(0.5)\n        if not CoreGui:FindFirstChild(\"TopBarApp\") then\n            guiRefs = createGUI()\n            trigger = guiRefs.trigger\n            health = guiRefs.health\n        end\n    end\nend)","features":"IT RECREATES THE 2016-2019 COREGUI PERFECTLY (except the chat, wich doesnt work and gets disbabled :/) ALL THE ROBUX PURCHASES WILL HAVE OLD GUI TOO! (dont worry it doesnt steal your robux) AND NOW WORKS FOR CONTROLLER TOO!!! check the full guide here! https://youtu.be/130V4u8XkW4?si=kp6N6hZPRFwUtbFq","tags":["retro","nostalgia","old roblox","WORKING"],"discord":"https://discord.gg/tQJRj8yw7","keyLink":"","owner":{"_id":"68efb514f19c9f8855c8ed0a","username":"MOCCOHAC","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7f7b9833d5bb26bb9135f83a96919fe4bb8f20df3c530614fa23a570cf202b78.webp","original":"https://scriptblox.com/images/photo/68efb514f19c9f8855c8ed0a-1760540039114.png"},"lvl":9,"status":"offline","id":"68efb514f19c9f8855c8ed0a","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/7f7b9833d5bb26bb9135f83a96919fe4bb8f20df3c530614fa23a570cf202b78.webp","original":"https://scriptblox.com/images/photo/68efb514f19c9f8855c8ed0a-1760540039114.png"}},"reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-16T16:59:52.581Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:50:38.036Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68fcfb965f8a0dedcf6d50c6","editBy":{"_id":"68efb514f19c9f8855c8ed0a","username":"MOCCOHAC","status":"offline","id":"68efb514f19c9f8855c8ed