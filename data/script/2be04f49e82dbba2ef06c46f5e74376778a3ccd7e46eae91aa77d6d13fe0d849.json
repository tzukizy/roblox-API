{"slug":"Squid-Game-with-GUNS-Kill-All-27041","_id":"678b698bb05b0036d091a400","title":"Kill All","game":{"_id":"67e5e1ffb360710ec3c77f3c","gameId":7541029066,"name":"Squid Game with GUNS","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":7541029066},"features":"Looking at another site with scripts, I saw the same script that should kill all players in the game, but it had a key system, so I decided to make my own\n\n*in order for the script to work, you need to equip any weapon","tags":["kill all","kill","farm"],"script":"getgenv().killall = true -- false/true\n\nlocal players = game:GetService(\"Players\")\nlocal plr = players.LocalPlayer\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal function kill(gun, player)\n    if\n        gun and player and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") and\n            player.Character:FindFirstChild(\"Humanoid\")\n     then\n        local a = {\n            [1] = gun,\n            [2] = {\n                [\"p\"] = Vector3.new(184.38491821289062, 80.81703186035156, -31.51180648803711),\n                [\"pid\"] = 1,\n                [\"part\"] = player.Character.HumanoidRootPart,\n                [\"d\"] = 1.7668241262435913,\n                [\"maxDist\"] = 1.7155888080596924,\n                [\"h\"] = player.Character.Humanoid,\n                [\"m\"] = Enum.Material.Plastic,\n                [\"n\"] = Vector3.new(-0.845337986946106, 0, 0.5342320203781128),\n                [\"t\"] = 0.44032757240082787,\n                [\"sid\"] = 1\n            }\n        }\n        ReplicatedStorage:WaitForChild(\"WeaponsSystem\"):WaitForChild(\"Network\"):WaitForChild(\"WeaponHit\"):FireServer(\n            unpack(a)\n        )\n    end\nend\n\nwhile getgenv().killall do\n    for _, p in pairs(players:GetPlayers()) do\n        if not getgenv().killall then\n            break\n        end\n        if p ~= plr then\n            local tool = plr.Character:FindFirstChildOfClass(\"Tool\")\n            if tool then\n                kill(tool, p)\n            end\n        end\n    end\n    wait(0.6)\nend","owner":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/4c296a9201f9551996a357d62ae1913747bd75c28208290884e9e394f442f870.webp","original":"https://scriptblox.com/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png"},"lvl":24,"status":"offline","id":"61f96cc63ede52bf4f7e299d","leaderboard":{"tag":{"kind":"hall","rank":1,"period":"all","metric":"views","value":17476254}},"topMilestone":{"key":"creator.likes","tier":1000},"profile":{"url":"https://cdn.kocakz.me/images/4c296a9201f9551996a357d62ae1913747bd75c28208290884e9e394f442f870.webp","original":"https://scriptblox.com/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png"}},"verified":true,"keyLink":"","views":122146,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-18T08:42:51.659Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-0b4555af0c0c83b6b99f7a92606962b5/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-0b4555af0c0c83b6b99f7a92606962b5/500/280/Image/Jpeg/noFilter"},"executes":137,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:09:51.611Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-0b4555af0c0c83b6b99f7a92606962b5/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-0b4555af0c0c83b6b99f7a92606962b5/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"cha