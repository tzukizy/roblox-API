{"slug":"Universal-Script-Bytox-Ui-libray-GstLib-60630","_id":"68fc9ef5dc97b5c4c0972d8c","title":"Bytox Ui libray GstLib","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1761386229271.jpg","placeId":0},"features":"New update from bytox","tags":["ui lib","lib","bytox","libray","ui"],"script":"-- تحميل مكتبة Gst مباشرة من GitHub\nlocal GstLib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/ByxCommunityZz6/GstLib/refs/heads/main/Gst.lua\"))()\n\n-- إنشاء واجهة تجريبية\nlocal UI = GstLib:New(\"تجربة Bytox\")\n\n-- إضافة تاب\nlocal tab = UI:AddTab(\"Main\")\n\n-- زر تجريبي\nUI:AddButton(tab, \"اضغطني\", function()\n    print(\"تم الضغط على الزر!\")\nend)\n\n-- Toggle تجريبي\nUI:AddToggle(tab, \"تفعيل\", false, function(val)\n    print(\"Toggle:\", val)\nend)\n\n-- Slider تجريبي للعرب فقط و شكرا\nUI:AddSlider(tab, \"سرعة\", 0, 100, 50, function(val)\n    print(\"Slider Value:\", val)\nend)\n\n-- Dropdown تجريبي\nUI:AddDropdown(tab, \"اختر خيار\", {\"خيار 1\", \"خيار 2\", \"خيار 3\"}, function(opt)\n    print(\"تم اختيار:\", opt)\nend)","owner":{"_id":"6853c3c521dc02b8fe7f0e79","username":"Bytox","verified":false,"profilePicture":"/images/photo/6853c3c521dc02b8fe7f0e79-1752409302902.jpg","status":"offline","id":"6853c3c521dc02b8fe7f0e79","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":529,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1761386229271.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2025-10-25T09:57:09.294Z","editBy":{"_id":"6853c3c521dc02b8fe7f0e79","username":"Bytox","status":"offline","id":"6853c3c521dc02b8fe7f0e79"},"executes":112,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68fc9ef5dc97b5c4c0972d8e","editBy":{"_id":"6853c3c521dc02b8fe7f0e79","username":"Bytox","status":"offline","id":"6853c3c521dc02b8fe7f0e79"},"message":"Create script","creat