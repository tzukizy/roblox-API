{"slug":"Universal-Script-Bytox-Ui-libray-GstLib-60630","_id":"68fc9ef5dc97b5c4c0972d8c","title":"Bytox Ui libray GstLib","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"New update from bytox","tags":["ui lib","lib","bytox","libray","ui"],"script":"-- تحميل مكتبة Gst مباشرة من GitHub\nlocal GstLib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/ByxCommunityZz6/GstLib/refs/heads/main/Gst.lua\"))()\n\n-- إنشاء واجهة تجريبية\nlocal UI = GstLib:New(\"تجربة Bytox\")\n\n-- إضافة تاب\nlocal tab = UI:AddTab(\"Main\")\n\n-- زر تجريبي\nUI:AddButton(tab, \"اضغطني\", function()\n    print(\"تم الضغط على الزر!\")\nend)\n\n-- Toggle تجريبي\nUI:AddToggle(tab, \"تفعيل\", false, function(val)\n    print(\"Toggle:\", val)\nend)\n\n-- Slider تجريبي للعرب فقط و شكرا\nUI:AddSlider(tab, \"سرعة\", 0, 100, 50, function(val)\n    print(\"Slider Value:\", val)\nend)\n\n-- Dropdown تجريبي\nUI:AddDropdown(tab, \"اختر خيار\", {\"خيار 1\", \"خيار 2\", \"خيار 3\"}, function(opt)\n    print(\"تم اختيار:\", opt)\nend)","owner":{"_id":"6853c3c521dc02b8fe7f0e79","username":"Bytox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/88a1ce0d5fe4a259a71889119c7707e6d0c1125a33de20bbf51dd1707a91a179.webp","original":"https://scriptblox.com/images/photo/6853c3c521dc02b8fe7f0e79-1752409302902.jpg"},"status":"offline","id":"6853c3c521dc02b8fe7f0e79","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/88a1ce0d5fe4a259a71889119c7707e6d0c1125a33de20bbf51dd1707a91a179.webp","original":"https://scriptblox.com/images/photo/6853c3c521dc02b8fe7f0e79-1752409302902.jpg"}},"verified":false,"views":535,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/caa413e7a26a4de7feb139795c