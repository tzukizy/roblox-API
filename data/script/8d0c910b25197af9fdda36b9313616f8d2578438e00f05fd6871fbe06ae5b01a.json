{"slug":"Build-to-Become-Sniper-Basically-Silentaim-148324","_id":"69c379bfd1773619a8a063ce","title":"Basically Silentaim","game":{"_id":"69c379bfd1773619a8a063cb","gameId":81439468615186,"name":"Build to Become Sniper","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":81439468615186},"features":"() Opensource - credit if you use this script\nHas movement prediction support to help kill randos - customizable distance\nRandomly selects a player and attempts to shoot them","tags":[],"script":"-- I didn't make a loop for this since its opensourced, so you can either wrap it in a loop or don't.\nlocal ebt = game:GetService(\"Players\")\nlocal idk = game:GetService(\"ReplicatedStorage\")\nlocal you = ebt.LocalPlayer\n\nlocal prediction = 3 -- Increase this to change distance shots, without perdiction its hard to get kills on moving targets\n-- I cant talk today sorry its like 2 am and tired my grammar is hanging by a thread\n\nlocal youusetocallmeonmycellphone = {}\nfor _, player in ipairs(ebt:GetPlayers()) do\n    if player ~= you and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n        table.insert(youusetocallmeonmycellphone, player)\n    end\nend\n\nif #youusetocallmeonmycellphone > 0 then\n    local randomTarget = youusetocallmeonmycellphone[math.random(1, #youusetocallmeonmycellphone)]\n    local char = randomTarget.Character\n    local hrp = char.HumanoidRootPart\n    local humanoid = char:FindFirstChild(\"Humanoid\")\n    \n    local targetPos = hrp.Position\n        if humanoid and humanoid.MoveDirection.Magnitude > 0 then\n        targetPos = targetPos + (humanoid.MoveDirection * prediction)\n    end\n    local Event = idk.Functions.RemoteFunctions.SniperShoot\n        Event:InvokeServer(\n        targetPos,\n        Vector3.new(0, -1, 0), \n        0\n    )\nelse\n    return\nend","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"verified":false,"views":3150,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/4cdea521766936b92155439e23cb977616ce8f5db147df64342e0263e5936a75.webp","original":"https://scriptblox.com/images/sb/rbx-8375e486e293a3e15be5c1b96c895643-ef23fcdf3cfc.png","scriptblox":"https://scriptblox.com/images/script/rbx-8375e486e293a3e15be5c1b96c895643-ef23fcdf3cfc.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-25T05:59:27.403Z","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"keyLink":"","executes":625,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T01:36:31.840Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/4cdea521766936b92155439e23cb977616ce8f5db147df64342e0263e5936a75.webp","original":"https://scriptblox.com/images/sb/rbx-8375e486e293a3e15be5c1b96c895643-ef23fcdf3cfc.png","scriptblox":"https://scriptblox.com/images/script/rbx-8375e486e293a3e15be5c1b96c895643-ef23fcdf3cfc.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c379bfd1773619a8a063d1","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2