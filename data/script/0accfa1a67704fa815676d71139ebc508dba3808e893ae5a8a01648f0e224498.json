{"slug":"Universal-Script-Client-Event-Tracker-16516","_id":"66aac3e6862a2069b679ae04","title":"Client Event Tracker(BETA)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Track OnClientEvent Events","tags":[],"script":"local Configs = {\n    [\"Numbers\"] = true,\n    [\"Path\"] = true,\n    [\"Debug Mode\"] = true\n}\n\nlocal blacklist = {\n    [\"Example Remote\"] = true -- Example\n}\n\nfor _, v in pairs(game:GetDescendants()) do\n    if (v:IsA(\"RemoteEvent\") or v:IsA(\"Event\")) and not blacklist[v.Name] then\n        v.OnClientEvent:Connect(\n            function(...)\n                local args = {...}\n                print(\"-------------------------------------------------\")\n                if Configs[\"Path\"] then\n                    print(\"Path: \" .. v:GetFullName())\n                end\n                if next(args) ~= nil then\n                    local niltable = {}\n                    local function is_empty(t)\n                        return next(t) == nil\n                    end\n\n                    if is_empty(niltable) then\n                        print(\"nil\")\n                    end\n                else\n                    print(\"No Args\")\n                end\n                print(\"-------------------------------------------------\")\n            end\n        )\n    end\nend\n","owner":{"_id":"6601cf2f23dbddefecad2523","username":"RIOT","verified":true,"profilePicture":{"url":"https://media.kocakz.me/d9cbb9645deeb1606808b5ac177cd77de51eb9da579d807e569ea8fc15772184.webp","original":"https://scriptblox.com/images/photo/6601cf2f23dbddefecad2523-1763442842985.jpg"},"status":"offline","id":"6601cf2f23dbddefecad2523","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/d9cbb9645deeb16068