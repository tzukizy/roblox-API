 Person - (Switches camera to third person view)","tags":["BloxStrike","BloxStrike Script"],"script":"loadstring(game:HttpGet('https://raw.githubusercontent.com/darklegion4773/BloxStrike/main/BloxStrike.lua'))()\n","owner":{"_id":"6775a6c521958b1e79d7afa6","username":"AIMScripts","verified":false,"profilePicture":"/images/photo/6775a6c521958b1e79d7afa6-1770089823573.png","status":"offline","id":"6775a6c521958b1e79d7afa6","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":6082,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-b68baea1686bcb4801edc2fbc76bf69f-ce88292ebd79.png","likeCount":6,"dislikeCount":6,"createdAt":"2026-02-03T03:48:39.507Z","executes":467,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"698170174bfacc3469fce3a1","editBy":{"_id":"6775a6c521958b1e79d7afa6","username":"AIMScripts","status":"offline","id":"6775a6c521958b1e79d7afa6"},"message":"Create script","createdAt":"2026-02-03T03:48:39.510Z"}],"comments":[{"_id":"6981708dae2cbb5849ac44b5","commentBy":{"_id":"697f5d25fc57b27942c2db31","username":"kovacekalexie7","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-02-06T20:49:33.871Z","createdAt":"2026-02-01T14:03:17.399Z","status":"offline","id":"697f5d25fc57b27942c2db31"},"text":"thx , work , but only pc version","edited":false,"likeCount":4,"dislikeCount":1,"createdAt":"2026-02-03T03:50:37.431Z","liked":false,"disliked":false},{"_id":"6981744887d3cdd14e188b9d","commentBy":{"_id":"69734c65ff3b2b4dbcfd8b8d","username":"sankkii","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-02-03T05:11:03.671Z","createdAt":"2026-01-23T10:24:37.439Z","status":"offline","id":"69734c65ff3b2b4dbcfd8b8d"},"text":"W","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2026-02-03T04:06:32.542Z","liked":false,"disliked":false},{"_id":"6981876502