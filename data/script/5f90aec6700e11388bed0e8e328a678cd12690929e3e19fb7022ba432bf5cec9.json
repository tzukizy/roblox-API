\n    task.wait(1)\n    addHighlight(character)\nend\n\nfor _, player in pairs(Players:GetPlayers()) do\n    if player ~= LocalPlayer then\n        if player.Character then\n            addHighlight(player.Character)\n        end\n        player.CharacterAdded:Connect(onCharacterAdded)\n    end\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n    if player ~= LocalPlayer then\n        player.CharacterAdded:Connect(onCharacterAdded)\n    end\nend)\n","features":"ESPs all users except you \nchange log:\n>red outline instead of white outline","tags":[],"discord":"","keyLink":"","owner":{"_id":"6876a5edad26070596c2ab50","username":"utemporary471","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2153ed4a862f2c9dd2400ec74af7483ec1f35061cd08a097d193627259836a8c.webp","original":"https://scriptblox.com/images/photo/6876a5edad26070596c2ab50-1755685008182.png"},"status":"offline","id":"6876a5edad26070596c2ab50","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/2153ed4a862f2c9dd2400ec74af7483ec1f35061cd08a097d193627259836a8c.webp","original":"https://scriptblox.com/images/photo/6876a5edad26070596c2ab50-1755685008182.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:55:25.409Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d9665c3cacb7aba93586bc","editBy":{"_id":"6876a5edad26070596c2ab50","username":"utemporary471","status":"offline","id":"6876a5edad26070596c2ab50"},"message":"Create script","createdAt":"2025-09-28T16:46:20.934Z"},{"_id":"68d96b2dbc79956da3c34b42","editBy":{"_id":"6876a5edad26070596c2ab50","username":"utemporary471","status":"offline","id":"6876a5edad26070596c2ab50"},"message":"Update script","createdAt":"2025-09-28T17:06:53.621Z"},{"_id":"6909f976ad8f54230a417ece","editBy":{"_id":"6876a5edad26070596c2a