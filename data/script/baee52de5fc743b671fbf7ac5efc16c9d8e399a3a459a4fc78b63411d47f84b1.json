{"slug":"Universal-Script-rainbow-disco-*-95709","_id":"697c80f03b83f72307f0ff39","title":"rainbow disco *","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"a silly script to have fun, when you click on the left mouse button, neon balls appear. This is my first script","tags":["universal"],"script":"local player = game.Players.LocalPlayer\nlocal mouse = player:GetMouse()\n\n-- Функция для создания и запуска огненного шара\nlocal function throwFireball()\n    local fireball = Instance.new(\"Part\")\n    fireball.Size = Vector3.new(1, 1, 1)\n    fireball.Shape = Enum.PartType.Ball\n    fireball.Material = Enum.Material.Neon\n    fireball.Position = player.Character.Head.Position + (player.Character.Head.CFrame.LookVector * 3)\n    fireball.Anchored = false\n    fireball.CanCollide = true\n    fireball.Parent = workspace\n\n    -- Функция для создания радужного эффекта\n    local function updateColor()\n        while fireball do\n            for i = 0, 1, 0.1 do\n                local color = Color3.fromHSV(i, 1, 1) -- Генерация радужного цвета\n                fireball.BrickColor = BrickColor.new(color)\n                wait(0.1) -- Задержка между изменениями цвета\n            end\n        end\n    end\n\n    -- Запускаем обновление цвета в отдельном потоке\n    coroutine.wrap(updateColor)()\n\n    -- Добавляем физику к огненному шару\n    local bodyVelocity = Instance.new(\"BodyVelocity\")\n    bodyVelocity.Velocity = (mouse.Hit.p - fireball.Position).unit * 50 -- скорость полета\n    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)\n    bodyVelocity.Parent = fireball\n\n    -- Удаляем огненный шар через 5 секунд\n    game:GetService(\"Debris\"):AddItem(fireball, 5)\nend\n\n-- Привязываем функцию к событию нажатия клавиши\nmouse.Button1Down:Connect(throwFireball)\n","owner":{"_id":"669e430dfab9a0ab3ebff987","username":"xbnth609","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/ed15fb3454c5ce5d6d5a9f584c0f2974db17b29945b15e59fcbea24e53f212b1.webp","original":"https://scriptblox.com/images/photo/669e430dfab9a0ab3ebff987-1769760416394.jpg"},"status":"offline","id":"669e430dfab9a0ab3ebff987","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/ed15fb3454c5ce5d6d5a9f584c0f2974db17b29945b15e59fcbea24e53f212b1.webp","original":"https://scriptblox.com/images/photo/669e430dfab9a0ab3ebff987-1769760416394.jpg"}},"verified":false,"views":600,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8c1d161a2505c02968b65d2028a6fbf8fad3df5731b69a27959c4c2d187a4fe8.webp","original":"https://scriptblox.com/images/sb/0-1769767152986.jpg","scriptblox":"https://scriptblox.com/images/script/0-1769767152986.jpg"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-30T09:59:13.001Z","executes":28,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:27:39.553Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/8c1d161a2505c02968b65d2028a6fbf8fad3df5731b69a27959c4c2d187a4fe8.webp","original":"https://scriptblox.com/images/sb/0-1769767152986.jpg","scriptblox":"https://scriptblox.com/images/script/0-1769767152986.jpg"},"changelog":[{"_id":"697c80f13b83f72307f0ff3c","editBy":{"_id":"669e430dfab9a0ab3ebff987","username":"xbnth609","status":"offline","id":"669e430dfab9a0ab3ebff987"},"message":"Create script","createdAt":"2026-01-30T09:59:13.004Z"}],"comments":[{"_id":"697c812461e4b86da4d87558","commentBy":{"_id":"697c80fbf4e0bf67ac7c15b5","username":"Modkakk","verified":false,"role":"user","profileP