\n-- Button Click Logic\nButton.MouseButton1Click:Connect(function()\n    ScreenGui:Destroy()\nend)\n","owner":{"_id":"6a01cac9486f2508067cce6d","username":"Keb67678KoiKoiKoi","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a01cac9486f2508067cce6d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":1035,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/7e4a5c4089e90cdd1be816e9c886111d2f82ad670edcf664d253654cb8ddeaf6.webp","original":"https://scriptblox.com/images/sb/rbx-f45f818a6202169c9987b2e9a5bcbfe9-b2bc9c374079.png","scriptblox":"https://scriptblox.com/images/script/rbx-f45f818a6202169c9987b2e9a5bcbfe9-b2bc9c374079.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-06-15T01:23:17.585Z","executes":97,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:03:03.345Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/7e4a5c4089e90cdd1be816e9c886111d2f82ad670edcf664d253654cb8ddeaf6.webp","original":"https://scriptblox.com/images/sb/rbx-f45f818a6202169c9987b2e9a5bcbfe9-b2bc9c374079.png","scriptblox":"https://scriptblox.com/images/script/rbx-f45f818a6202169c9987b2e9a5bcbfe9-b2bc9c374079.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a2f54054593511e355451d1","editBy":{"_id":"6a01cac9486f2508067cce6d","username":"Keb67678KoiKoiKoi","status":"offline","id":"6a01cac9486f2508067cce6d"},"message":"Create script","createdAt":"2026-06-15T01:23:17.588Z"}],"comments":[{"_id":"6a397c63671a41a8d73010b1","commentBy":{"_id":"69ef6dedf33d28cfa4177c9e","username":"IamNikolaTesla","verified":false,"role":"user","profilePicture":{"url":"https://media.k