{"slug":"town-no-recoil-script-13267","_id":"664e94c953362cd7d54c5cdd","title":"no recoil script","game":{"_id":"67e5e1ffb360710ec3c77f62","gameId":4991214437,"name":"town","imageUrl":"/images/sb/rbx-6f7989b622e1a1d5a8fbfb3838df41d1-a1962e265f3f.png","placeId":4991214437},"features":"No recoil For a gun","tags":[],"script":"local player = game.Players.LocalPlayer\n\nlocal function modifyHK416Stats()\n    for _, tool in pairs(player.Backpack:GetChildren()) do\n        if tool.Name == \"HK416\" then\n            local attachmentFolder = tool:FindFirstChild(\"AttachmentFolder\")\n            if attachmentFolder then\n                local suppressor = attachmentFolder:FindFirstChild(\"Suppressor\")\n                if suppressor then\n                    local stats = suppressor:FindFirstChild(\"Stats\")\n                    if stats then\n                        stats.GunRecoil.Value = 0\n                        stats.Scatter.Value = 99999\n                        stats.BulletSpeedMin.Value = 999999999\n                        stats.GunRecoilX.Value = 0\n                    end\n                end\n            end\n        end\n    end\nend\n\n-- Connect the function to run whenever a tool is equipped\nplayer.Backpack.ChildAdded:Connect(function(tool)\n    if tool.Name == \"HK416\" then\n        modifyHK416Stats()\n    end\nend)\n\n\nmodifyHK416Stats()\n\n\nwhile true do\n    modifyHK416Stats()\n    wait(1)\nend\n","owner":{"_id":"664482eeb051743d7d723057","username":"guma","verified":false,"profilePicture":"/images/photo/664482eeb051743d7d723057-1716533751524.png","status":"offline","id":"664482eeb051743d7d723057"},"verified":false,"keyLink":"","views":10860,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-05-23T00:58:49.550Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/cd50782882562dc5d1d83693bc3810f1/500/280/Image/Jpeg","executes":64,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c3df","editBy":{"_id":"664482eeb051743d7d723057","username":"guma","status":"offline","id":"664482eeb051743d7d723057"},"message":"Create script","createdAt":"2024-05-23T00:59:10.134Z"},{"_id":"67e5e1e5b360710ec3c50dcd","editBy":{"_id":"664482eeb051743d7d723057","username":"guma","status":"offline","id":"664482eeb051743d7d723057"},"message":"Update script","createdAt":"2025-03-27T12:11:09.269Z"}],"comments":[{"_id":"664e94f318c828b2557d11e9","commentBy":{"_id":"664482eeb051743d7d723057","username":"guma","verified":false,"role":"user","profilePicture":"/images/photo/664482eeb051743d7d723057-1716533751524.png","createdAt":"2024-05-15T09:39:58.815Z","lastActive":"2024-07-12T12:36:06.417Z","status":"offline","id":"664482eeb051743d7d723057"},"text":"this is just a simple code dont expect it to loop or be good","createdAt":"2024-05-23T00:59:31.476Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"664f02a918c828b25581a348","commentBy":{"_id":"61d29b2259e3da8b15cd4c51","username":"Crimson","verified":false,"role":"user","profilePicture":"/images/photo/61d29b2259e3da8b15cd4c51-1787246652500.jpg","createdAt":"2022-01-03T06:43:46.697Z","lastActive":"2026-09-04T21:09:12.344Z","status":"offline","id":"61d29b2259e3da8b15cd4c51","topMilestone":{"key":"creator.executions","tier":10000}},"text":"nice","createdAt":"2024-05-23T08:47:37.165Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"664fd21fb5cf3ffe35d4bbe0","commentBy":{"_id":"664482eeb051743d7d723057","username":"guma","verified":false,"role":"user","profilePicture":"/images/photo/664482eeb051743d7d723057-1716533751524.png","createdAt":"2024-05-15T09:39:58.815Z","lastActive":"2024-07-12T12:36:06.417Z","status":"offline","id":"664482eeb051743d7d723057"},"text":"make sure to have set your load out to !sts hk+blah blah blah+supp","createdAt":"2024-05-23T23:32:47.316Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":