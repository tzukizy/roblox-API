{"_id":"664e94c953362cd7d54c5cdd","title":"no recoil script","game":{"_id":"67e5e1ffb360710ec3c77f62","gameId":4991214437,"name":"town","imageUrl":{"url":"https://media.kocakz.me/e8271862a029ae5a761aa6148fa9203ab69e28176572a333d84544c09d25506d.webp","original":"https://tr.rbxcdn.com/180DAY-778eb2c16f0897c57bb585184486d9e8/150/150/Image/Png/noFilter"},"slug":"4991214437-town","path":"/game/4991214437-town","thumbnail":{"url":"https://media.kocakz.me/e8271862a029ae5a761aa6148fa9203ab69e28176572a333d84544c09d25506d.webp","original":"https://tr.rbxcdn.com/180DAY-778eb2c16f0897c57bb585184486d9e8/150/150/Image/Png/noFilter"},"placeId":4991214437},"slug":"town-no-recoil-script-13267","verified":false,"key":false,"keyless":false,"views":10873,"executes":68,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/cd50782882562dc5d1d83693bc3810f1/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/cd50782882562dc5d1d83693bc3810f1/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/cd50782882562dc5d1d83693bc3810f1/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/cd50782882562dc5d1d83693bc3810f1/500/280/Image/Jpeg"},"likeCount":1,"dislikeCount":0,"createdAt":"2024-05-23T00:58:49.550Z","updatedAt":"2024-05-23T00:58:49.550Z","lastBump":"2024-05-23T00:58:49.550Z","script":"local player = game.Players.LocalPlayer\n\nlocal function modifyHK416Stats()\n    for _, tool in pairs(player.Backpack:GetChildren()) do\n        if tool.Name == \"HK416\" then\n            local attachmentFolder = tool:FindFirstChild(\"AttachmentFolder\")\n            if attachmentFolder then\n                local suppressor = attachmentFolder:FindFirstChild(\"Suppressor\")\n                if suppressor then\n                    local stats = suppressor:FindFirstChild(\"Stats\")\n                    if stats then\n                        stats.GunRecoil.Value = 0\n                        stats.Scatter.Value = 99999\n                        stats.BulletSpeedMin.Value = 999999999\n                        stats.GunRecoilX.Value = 0\n                    end\n                end\n            end\n        end\n    end\nend\n\n-- Connect the function to run whenever a tool is equipped\nplayer.Backpack.ChildAdded:Connect(function(tool)\n    if tool.Name == \"HK416\" then\n        modifyHK416Stats()\n    end\nend)\n\n\nmodifyHK416Stats()\n\n\nwhile true do\n    modifyHK416Stats()\n    wait(1)\nend\n","features":"No recoil For a gun","tags":[],"discord":"","keyLink":"","owner":{"_id":"664482eeb051743d7d723057","username":"guma","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c8acc167c3a55412443b6d275adc760b01d37dbda71ebd83c187aacc8875ca1c.webp","original":"https://scriptblox.com/images/photo/664482eeb051743d7d723057-1716533751524.png"},"status":"offline","id":"664482eeb051743d7d723057","profile":{"url":"https://media.kocakz.me/c8acc167c3a55412443b6d275adc760b01d37dbda71ebd83c187aacc8875ca1c.webp","original":"https://scriptblox.com/images/photo/664482eeb051743d7d723057-1716533751524.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:21:40.898Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c3df","editBy":{"_id":"664482eeb051743d7d723057","username":"guma","status":"offline","id":"664482eeb051743d7d723057"},"message":"Create script","createdAt":"2024-05-23T00:59:10.134Z"},{"_id":"67e5e1e5b360710ec3c50dcd","editBy":{"_id":"664482eeb051743d7d723057","username":"guma","status":"offline","id":"664482eeb051743d7d723057"},"message":"Update script","createdAt":"2025-03-27T12:11:09.269Z"}],"comments":[{"_id":"664e94f318c828b2557d11e9","commentBy":{"_id":"6