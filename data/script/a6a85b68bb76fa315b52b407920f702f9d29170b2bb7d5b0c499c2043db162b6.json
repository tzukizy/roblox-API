{"_id":"690137d8d33070166800a60c","title":"Default Loading Menu   CoverGUI","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d64d9ccd90c8420229db6b54f535c1a857c0ff7a7baa44c5f92a047d8d14dbd4.webp","original":"https://scriptblox.com/images/sb/0-1761687512066.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d64d9ccd90c8420229db6b54f535c1a857c0ff7a7baa44c5f92a047d8d14dbd4.webp","original":"https://scriptblox.com/images/sb/0-1761687512066.png"},"placeId":0},"slug":"Universal-Script-Default-Loading-Menu-CoverGUI-61525","verified":false,"key":false,"keyless":false,"views":504,"executes":9,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/e5b6ae08ddf4c3a65e1f1ac3f126a32d91d87f5801958200703bf303db758f4e.webp","original":"https://scriptblox.com/images/sb/0-1761687512066.png","scriptblox":"https://scriptblox.com/images/script/0-1761687512066.png"},"thumbnail":{"url":"https://media.kocakz.me/e5b6ae08ddf4c3a65e1f1ac3f126a32d91d87f5801958200703bf303db758f4e.webp","original":"https://scriptblox.com/images/sb/0-1761687512066.png","scriptblox":"https://scriptblox.com/images/script/0-1761687512066.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-10-28T21:38:32.097Z","updatedAt":"2025-10-28T21:38:32.097Z","lastBump":"2025-10-28T21:38:32.097Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\n\n\n\n-- main toggle \nlocal enabled = true\nlocal YourText = \"Default Loading Menu - Edit this\"\n\n\n\n-- gui setup n stuff\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"FullscreenOverlay\"\nscreenGui.IgnoreGuiInset = true\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = playerGui\n\nlocal background = Instance.new(\"Frame\")\nbackground.Size = UDim2.new(1, 0, 1, 0)\nbackground.Position = UDim2.new(0, 0, 0, 0)\nbackground.BackgroundColor3 = Color3.new(0, 0, 0)\nbackground.BorderSizePixel = 0\nbackground.Parent = screenGui\n\nlocal thign = Instance.new(\"TextLabel\")\nthign.Size = UDim2.new(1, 0, 0.4, 0)\nthign.Position = UDim2.new(0, 0, 0, 0)\nthign.BackgroundTransparency = 1\nthign.Text = \"Loading\"\nthign.TextColor3 = Color3.new(1, 1, 1)\nthign.Font = Enum.Font.SourceSansBold\nthign.TextScaled = true\nthign.Parent = screenGui\n\nlocal thign1 = Instance.new(\"TextLabel\")\nthign1.Size = UDim2.new(1, 0, 0.6, 0)\nthign1.Position = UDim2.new(0, 0, 0.4, 0)\nthign1.BackgroundTransparency = 1\nthign1.Text = YourText\nthign1.TextColor3 = Color3.new(1, 1, 1)\nthign1.Font = Enum.Font.SourceSansBold\nthign1.TextScaled = true\nthign1.Parent = screenGui\n\n\n-- loading anim\nlocal dots = 0\nlocal maxDots = 3\nlocal timer = 0\nlocal interval = 0.3 -- seconds between adding a dot\n\n\nRunService.RenderStepped:Connect(function(deltaTime)\n    if not enabled then return end\n    timer = timer + deltaTime\n    if timer >= interval then\n        timer = timer - interval\n        dots = dots + 1\n        if dots > maxDots then\n            dots = 0\n        end\n        thign.Text = \"Loading\" .. string.rep(\".\", dots)\n    end\nend)\n","features":"Just a default script, like if you used this script!\nOpen-source","tags":["free","easy setup","gui","loading"],"discord":"","keyLink":"","owner":{"_id":"6635fc15a3ac063fc27e5441","username":"squhz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/625977f930fdd7329ff77d7e0d8c676c20a1530e9d3f901c283028f3e5f48895.webp","original":"https://scriptblox.com/images/photo/6635fc15a3ac063fc27e5441-1744292776340.png"},"status":"offline","id":"6635fc15a3ac063fc27e5441","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/625977f930fdd7329ff77d7e0d8c676c20a1530e9d3f901c283028f3e5f48895.webp","original":"https://scriptblox.com/images/photo/6635fc15a3ac063fc27e5441-1744292776340.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:39:29.168Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"690137d8d33070166800a60e","editBy":{"_id":"6635fc15a3ac063fc27e5441","username":"squhz","status":"offline","id":"6635fc15a3ac063fc27e5441"},"message":"Create script","createdAt":"2025-10-28T21:38:32.102Z"}],"comments":[{"_id":"6903463e2a34725e94072b4d","commentBy":{"_id":"67b4f0f003c3915d4c893cc7","username":"FobyCool","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/84fe3c45b981f7d914e6468972e1362a6432d56bb7bc011a6a169e1fc8ae373f.webp","original":"https://scriptblox.com/images/photo/67b4f0f003c3915d4c893cc7-1739911475737.jpg"},"createdAt":"2025-02-18T20:43:28.010Z","lastActive":"2026-06-08T15:56:16.437Z","status":"offline","id":"67b4f0f003c3915d4c893cc7","profile":{"url":"https://media.kocakz.me/84fe3c45b981f7d914e6468972e1362a6432d56bb7bc011a6a169e1fc8ae373f.webp","original":"https://scriptblox.com/images/photo/67b4f0f003c3915d4c893cc7-1739911475737.jpg"}},"text":"This script is so bad that it creates ScreenGui inside of PlayerGui, so easy to detect, stupid *hole.","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-10-30T11:04:30.629Z","liked":false,"disliked":false},{"_id":"6909cebd618ae815f1424175","commentBy":{"_id":"6635fc15a3ac063fc27e5441","username":"squhz","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/625977f930fdd7329ff77d7e0d8c676c20a1530e9d3f901c283028f3e5f48895.webp","original":"https://scriptblox.com/images/photo/6635fc15a3ac063fc27e5441-1744292776340.png"},"createdAt":"2024-05-04T09:12:53.329Z","lastActive":"2026-06-11T21:14:54.592Z","status":"offline","id":"6635fc15a3ac063fc27e5441","topMilesto