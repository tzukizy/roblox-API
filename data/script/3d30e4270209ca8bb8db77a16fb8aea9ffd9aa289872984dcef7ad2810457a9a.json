local ok = false\n\n\tif useG then\n\t\tok = pcall(_G.Badge, id)\n\tend\n\n\tif not ok then\n\t\tBG:FireServer(id)\n\tend\n\n\tif i % chunkSize == 0 or i == #allIds then\n\t\tpcall(function()\n\t\t\tSG:SetCore(\"SendNotification\", {\n\t\t\t\tTitle = \"Firing Badges\",\n\t\t\t\tText = \"Progress: \" .. tostring(i) .. \" / \" .. tostring(#allIds),\n\t\t\t\tDuration = 1.5\n\t\t\t})\n\t\tend)\n\n\t\ttask.wait(0.5)\n\tend\nend","owner":{"_id":"65780b159276115801e01e15","username":"Vyperia","verified":false,"profilePicture":{"url":"https://media.kocakz.me/bc6b83a1606d292e75ec49a72be7368c3565cf79152563a27c1cbc50b604f4f4.webp","original":"https://scriptblox.com/images/photo/65780b159276115801e01e15-1787302518717.png"},"lvl":12,"status":"offline","id":"65780b159276115801e01e15","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/bc6b83a1606d292e75ec49a72be7368c3565cf79152563a27c1cbc50b604f4f4.webp","original":"https://scriptblox.com/images/photo/65780b159276115801e01e15-1787302518717.png"}},"verified":false,"views":25220,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/be0525a497d9a73e3667e92c79ec703c788080da7fa8703a41f35822e3d37a82.webp","original":"https://scriptblox.com/images/sb/rbx-b8b395a1b0e0f21f03ceacabe577cae8-f55888b0d68c.png","scriptblox":"https://scriptblox.com/images/script/rbx-b8b395a1b0e0f21f03ceacabe577cae8-f55888b0d68c.png"},"likeCount":5,"dislikeCount":2,"createdAt":"2025-07-25T15:11:32.524Z","editBy":{"_id":"65780b159276115801e01e15","username":"Vyperia","status":"offline","id":"65780b159276115801e01e15"},"keyLink":"","executes":122,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:11:18.344Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/be0525a497d9a73e3667e92c7