{"_id":"6923323f5f27c264a6145ac6","title":"spell keybinds [open source]","game":{"_id":"691d1b02c583a5de753f1455","gameId":136178978872141,"name":"[🎙️] Wizard Arena","imageUrl":{"url":"https://media.kocakz.me/bde4fc241614d7806b315a5606a5522f952f511148d443589ffde508130813f4.webp","original":"https://scriptblox.com/images/sb/rbx-86d62af35babf663027543319921eb2f-82ecf3ba9b83.png"},"slug":"136178978872141-wizard-arena","path":"/game/136178978872141-wizard-arena","thumbnail":{"url":"https://media.kocakz.me/bde4fc241614d7806b315a5606a5522f952f511148d443589ffde508130813f4.webp","original":"https://scriptblox.com/images/sb/rbx-86d62af35babf663027543319921eb2f-82ecf3ba9b83.png"},"placeId":136178978872141},"slug":"Wizard-Arena-spell-keybinds-69293","verified":false,"key":false,"keyless":false,"views":3476,"executes":253,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/52a6fcf78f99d572b7d3fc9e60314ed2541a3f810fffd3f183085f17f4134316.webp","original":"https://scriptblox.com/images/sb/rbx-86d62af35babf663027543319921eb2f-82ecf3ba9b83.png","scriptblox":"https://scriptblox.com/images/script/rbx-86d62af35babf663027543319921eb2f-82ecf3ba9b83.png"},"thumbnail":{"url":"https://media.kocakz.me/52a6fcf78f99d572b7d3fc9e60314ed2541a3f810fffd3f183085f17f4134316.webp","original":"https://scriptblox.com/images/sb/rbx-86d62af35babf663027543319921eb2f-82ecf3ba9b83.png","scriptblox":"https://scriptblox.com/images/script/rbx-86d62af35babf663027543319921eb2f-82ecf3ba9b83.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-11-23T16:11:43.279Z","updatedAt":"2025-11-23T16:11:43.279Z","lastBump":"2025-11-23T16:11:43.279Z","script":"if not game:IsLoaded() then\n    game.Loaded:Wait()\nend\n\nlocal players = game:GetService(\"Players\")\nlocal user_input_service = game:GetService(\"UserInputService\")\nlocal replicated_storage = game:GetService(\"ReplicatedStorage\")\n\nlocal client = players.LocalPlayer\nlocal mouse = client:GetMouse()\n\nlocal packages = replicated_storage:WaitForChild(\"Packages\")\nlocal network_c = packages:WaitForChild(\"NetworkC\")\n\nlocal key_binds = {\"Z\", \"X\", \"C\", \"V\"}\n\nlocal function get_spells()\n    local spell_string = client:GetAttribute(\"Spells\")\n    if not spell_string then\n        return {}\n    end\n\n    local spells = {}\n    for spell in string.gmatch(spell_string, \"([^,]+)\") do\n        table.insert(spells, spell)\n    end\n    return spells\nend\n\nuser_input_service.InputBegan:Connect(function(input, game_processed)\n    if game_processed then\n        return\n    end\n\n    local key = input.KeyCode.Name\n\n    for index, bind in ipairs(key_binds) do\n        if key == bind then\n            local spells = get_spells()\n            local spell = spells[index]\n\n            if spell then\n                require(network_c):fire(\"castSpell\", spell, mouse.Hit.Position)\n            else\n                print(\"no spell assigned to this key\")\n            end\n        end\n    end\nend)\n","features":"cast spell by press key \nfor introvert people","tags":[],"discord":"","keyLink":"","owner":{"_id":"677a8dd484aaa6821ca0f3b0","username":"bigskidder","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6590d983bbb2a32e3312125524e7578b064e17abde64b3f1435c936a9fc1c54f.webp","original":"https://scriptblox.com/images/photo/677a8dd484aaa6821ca0f3b0-1740238363928.jpg"},"status":"offline","id":"677a8dd484aaa6821ca0f3b0","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/6590d983bbb2a32e3312125524e7578b064e17abde64b3f1435c936a9fc1c54f.webp","original":"https://scriptblox.com/images/photo/677a8dd484aaa6821ca0f3b0-1740238363928.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:48:31.846Z","last":"","win":14,"mat