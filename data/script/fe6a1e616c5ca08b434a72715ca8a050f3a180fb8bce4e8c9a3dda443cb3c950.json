{"slug":"Steal-a-Brainrot-Gg-51800","_id":"68bca44623ab45fd20b387a8","title":"11","game":{"_id":"68313258440874f0e1fb73d9","gameId":109983668079237,"name":"Steal a Brainrot","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":109983668079237},"features":"Plataforma e mais coisas","tags":[],"script":"-- Coloque este Script dentro de uma Part (plataforma) no Roblox Studio\n\nlocal plataforma = script.Parent\nlocal players = game.Players\n\n-- Configurações\nlocal valorMin = 1000000   -- 1M\nlocal valorMax = 9999000000 -- 9999M\nlocal velocidade = 10      -- Velocidade de subida\n\n-- Faz a plataforma subir para cima infinitamente\nwhile true do\n\tplataforma.CFrame = plataforma.CFrame * CFrame.new(0, velocidade * 0.1, 0)\n\twait(0.1)\nend\n\n-- Quando alguém tocar na plataforma\nplataforma.Touched:Connect(function(hit)\n\tlocal player = players:GetPlayerFromCharacter(hit.Parent)\n\tif player then\n\t\t-- Gera um valor de Brainrot aleatório\n\t\tlocal brainrot = math.random(valorMin, valorMax)\n\n\t\t-- Exibe no output (aqui você pode adaptar para seu sistema de pontos)\n\t\tprint(player.Name .. \" roubou \" .. brainrot .. \" Brainrot!\")\n\n\t\t-- Torna a plataforma invisível\n\t\tplataforma.Transparency = 1\n\t\tplataforma.CanCollide = false\n\n\t\t-- Depois de 5 segundos reaparece\n\t\twait(5)\n\t\tplataforma.Transparency = 0\n\t\tplataforma.CanCollide = true\n\tend\nend)","owner":{"_id":"68af62318843cab44adcc1f8","username":"Pinlo","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68af62318843cab44adcc1f8","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":1428,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/6d9