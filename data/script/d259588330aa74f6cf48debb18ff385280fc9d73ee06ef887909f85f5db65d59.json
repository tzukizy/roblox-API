\"Remotes\"):WaitForChild(\"InflictTarget\")\n\nwhile task.wait(0.1) do -- adjust the wait time if you want faster/slower hits\n    for _, monster in pairs(monsters:GetChildren()) do\n        local humanoid = monster:FindFirstChild(\"Humanoid\")\n        local root = monster:FindFirstChild(\"HumanoidRootPart\")\n        local head = monster:FindFirstChild(\"Head\")\n\n        if humanoid and root and head then\n            local args = {\n                \"Gun\",\n                weapon,\n                humanoid,\n                root,\n                head,\n                Vector3.zero,\n                {\n                    ChargeLevel = 0,\n                    ExplosionEffectFolder = game:GetService(\"ReplicatedStorage\").Miscs.GunVisualEffects.Common.ExplosionEffect,\n                    MuzzleFolder = game:GetService(\"ReplicatedStorage\").Miscs.GunVisualEffects.Common.MuzzleEffect,\n                    HitEffectFolder = game:GetService(\"ReplicatedStorage\").Miscs.GunVisualEffects.Common.HitEffect,\n                    BloodEffectFolder = game:GetService(\"ReplicatedStorage\").Miscs.GunVisualEffects.Common.BloodEffect\n                },\n                100\n            }\n\n            remote:FireServer(unpack(args))\n        end\n    end\nend\n","features":"auto shoot and auto kill it op","tags":[],"discord":"","keyLink":"","owner":{"_id":"6872b23a72384d2531ea144f","username":"jampilot4","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6872b23a72384d2531ea144f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:47:36.511Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id