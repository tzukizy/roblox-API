{"slug":"SUMMER-Randomizer:-Redux-Silent-Aim-Open-Source-240653","_id":"6a457d6a60023d64d5b1bb12","title":"Silent Aim Open Source","game":{"_id":"67e5e1ffb360710ec3c77ef2","gameId":99342262733194,"name":"[SUMMER] Randomizer: Redux","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":99342262733194},"features":"Silent Aim\nOpen Source\nEnjoy <3","tags":["silent aim","script","open source"],"script":"--@[SUMMER] Randomizer: Redux\nlocal GetService = game.GetService\n\n--\n\nlocal ReplicatedStorage = GetService(game, \"ReplicatedStorage\")\nlocal Workspace = GetService(game, \"Workspace\")\nlocal Players = GetService(game, \"Players\")\n\n--\n\nlocal Camera = Workspace.CurrentCamera\nlocal LocalPlayer = Players.LocalPlayer\nlocal CrosshairHandler = require(ReplicatedStorage.Modules.GunKit.CrosshairHandler)\n\n--\n\nlocal OldGetPosition = CrosshairHandler.GetPosition\n\nhookfunction(CrosshairHandler.GetPosition, function(Self, Tool)\n    local ClosestHead = nil\n    local ClosestDistance = math.huge\n\n    for _, Player in ipairs(Players:GetPlayers()) do\n        if Player == LocalPlayer then continue end\n\n        local Character = Player.Character\n        if not Character then continue end\n\n        local Head = Character:FindFirstChild(\"Head\")\n        local Humanoid = Character:FindFirstChildOfClass(\"Humanoid\")\n        if not Head or not Humanoid or Humanoid.Health <= 0 then continue end\n\n        local Distance = (Head.Position - Camera.CFrame.Position).Magnitude\n        if Distance < ClosestDistance then\n            ClosestDistance = Distance\n            ClosestHead = Head\n        end\n    end\n\n    if ClosestHead then\n        return ClosestHead.Position, ClosestHead\n    end\n\n    return OldGetPosition(Self, Tool)\nend)","owner":{"_id":"6a3c3b0bff01c65a89f1c044","username":"imnotcheatingdude68","verified":false,"profilePicture":{"url":"https: