{"slug":"Universal-Script-It-prints-the-level-of-your-executer-32676","_id":"67dcf8fa57898f5c2de0c4af","title":"It prints the level of your executer","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"It prints the level of your executer\n\nworks on all executer's","tags":[],"script":"print(\"🛠️ [Initial Identity]:\")\nprintidentity()\n\nspawn(function()\n    print(\"\\n🚀 [Spawned Thread]:\")\n    printidentity()\n\n    wait(1)\n    print(\"\\n⏱️ [Delayed in Spawn]:\")\n    printidentity()\nend)\n\n-- Using task.spawn\ntask.spawn(function()\n    print(\"\\n⚡ [Task.spawn Thread]:\")\n    printidentity()\n\n    task.defer(function()\n        print(\"\\n🔄 [Deferred in Task.spawn]:\")\n        printidentity()\n    end)\nend)\n\nlocal co = coroutine.create(function()\n    print(\"\\n🔧 [Coroutine]:\")\n    printidentity()\n\n    task.defer(function()\n        print(\"\\n🔂 [Deferred in Coroutine]:\")\n        printidentity()\n    end)\nend)\ncoroutine.resume(co)\n\ntask.delay(2, function()\n    print(\"\\n✅ [Final Identity Check]:\")\n    printidentity()\nend)\n","owner":{"_id":"663bfe5e4d8171671b033860","username":"angelboii","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"663bfe5e4d8171671b033860","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":2606,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-21T05:28:26.697Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/f8293925782320d63ecd3dcb053bf7e65e3fbd8e37a65373fd8cfc76733efa9f.webp","original":"https://scriptblox.com/images/sb/535