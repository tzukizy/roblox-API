ion()\n    print(\"\\n🔧 [Coroutine]:\")\n    printidentity()\n\n    task.defer(function()\n        print(\"\\n🔂 [Deferred in Coroutine]:\")\n        printidentity()\n    end)\nend)\ncoroutine.resume(co)\n\ntask.delay(2, function()\n    print(\"\\n✅ [Final Identity Check]:\")\n    printidentity()\nend)\n","features":"It prints the level of your executer\n\nworks on all executer's","tags":[],"discord":"","keyLink":"","owner":{"_id":"663bfe5e4d8171671b033860","username":"angelboii","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"663bfe5e4d8171671b033860","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:05:33.691Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4dd7d","editBy":{"_id":"663bfe5e4d8171671b033860","username":"angelboii","status":"offline","id":"663bfe5e4d8171671b033860"},"message":"Create script","createdAt":"2025-03-21T05:29:44.868Z"},{"_id":"67e5e1e3b360710ec3c4dd7e","editBy":{"_id":"663bfe5e4d8171671b033860","username":"angelboii","status":"offline","id":"663bfe5e4d8171671b033860"},"message":"Update script","createdAt":"2025-03-21T05:31:55.790Z"},{"_id":"67e5e1e3b360710ec3c4dd7f","editBy":{"_id":"663bfe5e4d8171671b033860","username":"angelboii","status":"offline","id":"663bfe5e4d8171671b033860"},"message":"Update script","createdAt":"2025-03-21T05:34:27.094Z"},{"_id":"67e5e1e7b360710ec3c55cf6","editBy":{"_id":"663bfe5e4d8171671b033860","username":"angelboii","status":"offline","id":"663bfe5e4d8171671b033860"},"message":"Update script","createdAt":"2025-03-27T16:20:41.909Z"}],"comments":[{"_id":"67dd2cce4ad63940b4e0bf08","commentBy":{"_id":"67dd2