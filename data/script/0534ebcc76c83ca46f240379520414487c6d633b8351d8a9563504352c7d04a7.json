 9) / 5\n\t\tlocal bobble_Y = math.abs(math.sin(now * 12)) / 5\n\n\t\tlocal bobble = Vector3.new(bobble_X, bobble_Y, 0) * math.min(1, velocity.Magnitude / humanoid.WalkSpeed)\n\t\thumanoid.CameraOffset = humanoid.CameraOffset:lerp(bobble, 0.25)\n\telse\n\t\t-- Scale down the CameraOffset so that it shifts back to its regular position.\n\t\thumanoid.CameraOffset = humanoid.CameraOffset * 0.75\n\tend\nend\n\nRunService.RenderStepped:Connect(updateBobbleEffect)\n","features":"Super jump","tags":[],"discord":"","keyLink":"","owner":{"_id":"6870585cc4bba2365d1833da","username":"kyama9251","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6870585cc4bba2365d1833da","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:45:48.842Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"687a5e6ec24d46c8bada66cf","editBy":{"_id":"6870585cc4bba2365d1833da","username":"kyama9251","status":"offline","id":"6870585cc4bba2365d1833da"},"message":"Create script","createdAt":"2025-07-18T14:47:10.253Z"}],"comments":[{"_id":"687a5eb80ff98ebfdd3f95ca","commentBy":{"_id":"67ab5331372107e62e7a23c2","username":"2orb","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c69ae8d172a5aa5b2414a50c84d9cb43ba45415894c138863de022111b2c854a.webp","original":"https://scriptblox.com/images/photo/67ab5331372107e62e7a23c2-1788770545982.png"},"createdAt":"2025-02-11T13:40:01.467Z","lastActive":"2026-10-18T13:19:57.538Z","lvl":7,"status":"offline","id":"67ab5331372107e62e7a23c2","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/c69ae8d172a5aa5b2414a50c84d9c