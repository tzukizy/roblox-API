\")\n\t\tend\n\tend\nend)\n\n-- التنقل عند الضغط على الشاشة\nmouse.Button1Down:Connect(function()\n\tif isReadingMode then\n\t\tlocal mousePos = mouse.Hit\n\t\tif mousePos then\n\t\t\tlocal character = player.Character\n\t\t\tif character and character:FindFirstChild(\"HumanoidRootPart\") then\n\t\t\t\tcharacter.HumanoidRootPart.CFrame = CFrame.new(mousePos.Position + Vector3.new(0, 5, 0))\n\t\t\tend\n\t\tend\n\tend\nend)","features":"H","tags":[],"discord":"","keyLink":"","owner":{"_id":"67e82654133d59648788f9ad","username":"vobBox","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1b06dac0db7a51708fb69fc7ff94093bf5114fefe5bfb86ee10e4ce92f52c59c.webp","original":"https://scriptblox.com/images/photo/67e82654133d59648788f9ad-1745267110167.png"},"status":"offline","id":"67e82654133d59648788f9ad","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/1b06dac0db7a51708fb69fc7ff94093bf5114fefe5bfb86ee10e4ce92f52c59c.webp","original":"https://scriptblox.com/images/photo/67e82654133d59648788f9ad-1745267110167.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:08:55.826Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"680567f169cfde8ffbb21d44","editBy":{"_id":"67e82654133d59648788f9ad","username":"vobBox","status":"offline","id":"67e82654133d59648788f9ad"},"message":"Create script","createdAt":"2025-04-20T21:32:33.911Z"}],"comments":[{"_id":"68056e08cd40f6a1ad199d35","commentBy":{"_id":"67f24f53497c029fb3c4e81b","username":"Poker","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-04-06T09:54:27.088Z","lastActive":"2026-10-05T04:25:32.554Z","status":"offline","id":"67f24f53497c029fb3c4e81b","topMilestone":{"key":"creator.executions","tier":10000},"pro