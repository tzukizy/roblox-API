ectOrb\",\n        [2] = orbType, -- Orb type (\"Red Orb\" or \"Gem\")\n        [3] = \"City\"\n    }\n\n    while true do\n        orbEvent:FireServer(unpack(args))\n        wait(0) -- Adjust delay as needed \n    end\nend\n\n-- Function to handle rebirthing\nlocal function autoRebirth()\n    local args = {\n        [1] = \"rebirthRequest\"\n    }\n\n    while true do\n        rebirthEvent:FireServer(unpack(args))\n        wait(1) -- Adjust delay to suit the rebirth mechanics in your game\n    end\nend\n\n-- Start multiple loops for orb collection\nfor i = 1, 50 do -- Adjust number of concurrent executions \n    coroutine.wrap(function() collectOrb(\"Red Orb\") end)()\n    coroutine.wrap(function() collectOrb(\"Gem\") end)()\nend\n\n-- Start auto-rebirth loop\ncoroutine.wrap(autoRebirth)()","features":"Free For All","tags":["free","keyless","speed","inf"],"discord":"","keyLink":"","owner":{"_id":"64e4ce7e745e83246e30c6ba","username":"maxmaster3602","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d3e132634ad799d7e3411a3af879ded6f22abc931f04ae091268e13adfd369e0.webp","original":"https://scriptblox.com/images/photo/64e4ce7e745e83246e30c6ba-1720289974930.jpg"},"status":"offline","id":"64e4ce7e745e83246e30c6ba","profile":{"url":"https://media.kocakz.me/d3e132634ad799d7e3411a3af879ded6f22abc931f04ae091268e13adfd369e0.webp","original":"https://scriptblox.com/images/photo/64e4ce7e745e83246e30c6ba-1720289974930.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:04:52.773Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53687","editBy":{"_id":"64e4ce7e745e83246e30c6ba","username":"maxmaster3602","status":"offline","id":"64e4ce7e745e83246e30c6ba"},"message":"Create script","createdAt":"2025-03-27T17:45:23.409Z"}],"comments":[{"_id":"6754b8be4b2a677f