{"slug":"Be-a-Beggar!-Be-a-beggar-autofarm-55108","_id":"68d72c007f9f7255ef98f317","title":"Be a beggar autofarm","game":{"_id":"68ccffd7934e08306bfe53a3","gameId":119574637420814,"name":"Be a Beggar!","imageUrl":"/images/sb/rbx-dace99e2df9ab793521f09ef20891db6-195237de555a.png","placeId":119574637420814},"features":"autofarm for money fast","tags":["be a beggar","autofarm","inf money"],"script":"local plrs = game:GetService(\"Players\")\nlocal rs = game:GetService(\"ReplicatedStorage\")\nlocal me = plrs.LocalPlayer\nlocal char = me.Character or me.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal bases = workspace:WaitForChild(\"Bases\")\nlocal ev = rs.Remotes:WaitForChild(\"MinigameEvent\")\nlocal run = game:GetService(\"RunService\")\n\nlocal function findBase()\n\tfor _,b in pairs(bases:GetChildren()) do\n\t\tlocal o = b:FindFirstChild(\"Owner\")\n\t\tif o then\n\t\t\tlocal v = o.Value\n\t\t\tif v == me or tostring(v) == me.Name or tonumber(v) == me.UserId then\n\t\t\t\treturn b\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal b = findBase()\nif b then\n\tlocal beg = b:WaitForChild(\"BegPrompt\")\n\tlocal prompt = beg:WaitForChild(\"ProximityPrompt\")\n\thrp.CFrame = beg.CFrame + Vector3.new(0,3,0)\n\tfireproximityprompt(prompt)\n\twhile true do\n\t\trun.RenderStepped:Wait()\n\t\tev:FireServer(true)\n\tend\nend\n","owner":{"_id":"66a728969af5d4ccc42d5473","username":"Nismo","verified":true,"profilePicture":"/images/photo/66a728969af5d4ccc42d5473-1789892678518.png","status":"offline","id":"66a728969af5d4ccc42d5473","leaderboard":{"tag":{"kind":"week","rank":18,"period":"week","metric":"views","value":20006}},"topMilestone":{"key":"creator.streak","tier":30}},"verified":false,"views":5333,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-2f0892abafd467933119e56b07c66585-244340b3d6e5.png","likeCount":6,"dislikeCount":9,"createdAt":"2025-09-27T00:12:48.641Z","editBy":{"_id":"66a728969af5d4