{"slug":"Universal-Script-Scary-Mario-43390","_id":"6860efe34386e75f9198e825","title":"Scary Mario","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1751183331651.png","placeId":0},"features":"Is A Scary Mario In Work at Pizza Place Hacked!","tags":[],"script":"-- Looping Spooky Sound (Low Pitch)\nlocal Spooky1 = Instance.new(\"Sound\", game.Workspace)\nSpooky1.Name = \"SpookyLoop\"\nSpooky1.SoundId = \"rbxassetid://133180219581309\"\nSpooky1.Volume = 10\nSpooky1.Looped = true\nSpooky1.Pitch = 0.09\nSpooky1:Play()\n\n-- Apply Decal to All Sides\nlocal decalId = \"rbxassetid://86166390223728\"\nlocal function applyDecalToAllSides(part)\n\tlocal faces = {\n\t\tEnum.NormalId.Top,\n\t\tEnum.NormalId.Bottom,\n\t\tEnum.NormalId.Left,\n\t\tEnum.NormalId.Right,\n\t\tEnum.NormalId.Front,\n\t\tEnum.NormalId.Back\n\t}\n\n\tfor _, face in ipairs(faces) do  \n\t\tlocal decal = Instance.new(\"Decal\")  \n\t\tdecal.Texture = decalId  \n\t\tdecal.Face = face  \n\t\tdecal.Parent = part  \n\tend\nend\n\nfor _, part in ipairs(workspace:GetDescendants()) do\n\tif part:IsA(\"BasePart\") then\n\t\tapplyDecalToAllSides(part)\n\tend\nend\n\n-- Set Custom Skybox\nlocal skyId = \"rbxassetid://86166390223728\"\nlocal sky = Instance.new(\"Sky\")\nsky.SkyboxBk = skyId\nsky.SkyboxDn = skyId\nsky.SkyboxFt = skyId\nsky.SkyboxLf = skyId\nsky.SkyboxRt = skyId\nsky.SkyboxUp = skyId\nsky.Parent = game.Lighting\n\n-- Set Only Fog (No Night)\nlocal lighting = game.Lighting\nlighting.FogColor = Color3.fromRGB(20, 20, 20)\nlighting.FogStart = 0\nlighting.FogEnd = 300\n\n-- 🔁 Repeating Sound Every 10 Seconds\ntask.spawn(function()\n\twhile true do\n\t\tlocal repeatSound = Instance.new(\"Sound\", game.Workspace)\n\t\trepeatSound.Name = \"RepeatingSound\"\n\t\trepeatSound.SoundId = \"rbxassetid://7337298420\"\n\t\trepeatSound.Volume = 10\n\t\trepeatSound.Looped = false\n\t\trepeatSound:Play()\n\t\trepeatSound.Ended:Connect(function()\n\t\t\trepeatSound:Destroy()\n\t\tend)\n\t\ttask.wait(10)\n\tend\nend)","owner":{"_id":"6843fa9a28f4e97b9e138ab5","username":"tubers93villain","verified":false,"profilePicture":"/images/photo/6843fa9a28f4e97b9e138ab5-1751183172489.png","status":"offline","id":"6843fa9a28f4e97b9e138ab5","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":9818,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1751183331651.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-06-29T07:48:51.696Z","editBy":{"_id":"6843fa9a28f4e97b9e138ab5","username":"tubers93villain","status":"offline","id":"6843fa9a28f4e97b9e138ab5"},"executes":1357,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6860efe34386e75f9198e827","editBy":{"_id":"6843fa9a28f4e97b9e138ab5","username":"tubers93villain","status":"offline","id":"6843fa9a28f4e97b9e138ab5"},"message":"Create script","createdAt":"2025-06-29T07:48:51.697Z"},{"_id":"6860f0e046409c6ae4e0bb90","editBy":{"_id":"6843fa9a28f4e97b9e138ab5","username":"tubers93villain","status":"offline","id":"6843fa9a28f4e97b9e138ab5"},"message":"Update script","createdAt":"2025-06-29T07:53:04.578Z"}],"comments":[{"_id":"6860f0234386e75f9198f69f","commentBy":{"_id":"67e890f5a281cd97f1f7d7e4","username":"skidIord","verified":false,"role":"user","profilePicture":"/images/photo/67e890f5a281cd97f1f7d7e4-1773424119567.jpg","createdAt":"2025-03-30T00:31:49.634Z","lastActive":"2026-07-02T10:35:38.187Z","status":"offline","id":"67e890f5a281cd97f1f7d7e4","topMilestone":{"key":"creator.followers","tier":10}},"text":"this is not tuff in 2025 lil bro","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-06-29T07:49:55.276Z","liked":false,"disliked":false},{"_id":"6860f09f2206934a9c7e1543","commentBy":{"_id":"678bc6f789df38213ce94ce4","username":"bbl123","verified":false,"role":"user","profilePicture":"/images/photo/678bc6f789df38213ce94ce4-1752299640751.png","c