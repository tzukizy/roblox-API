{"_id":"68e2a71ebb155ab7ad3091b0","title":"Wall Walk working","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/67de0b08eddfb6e6f22a656348c9ffb55eb75970d3b281245b63fbe5b2272b0a.webp","original":"https://scriptblox.com/images/sb/0-1759684382726.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/67de0b08eddfb6e6f22a656348c9ffb55eb75970d3b281245b63fbe5b2272b0a.webp","original":"https://scriptblox.com/images/sb/0-1759684382726.png"},"placeId":0},"slug":"Universal-Script-Wall-Walk-working-56706","verified":false,"key":false,"keyless":false,"views":7996,"executes":6370,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/8dccec5931a79a2de4de8ad6dab38b493238cc1e0e9745524426e7cc70306a7a.webp","original":"https://scriptblox.com/images/sb/0-1759684382726.png","scriptblox":"https://scriptblox.com/images/script/0-1759684382726.png"},"thumbnail":{"url":"https://media.kocakz.me/8dccec5931a79a2de4de8ad6dab38b493238cc1e0e9745524426e7cc70306a7a.webp","original":"https://scriptblox.com/images/sb/0-1759684382726.png","scriptblox":"https://scriptblox.com/images/script/0-1759684382726.png"},"likeCount":1,"dislikeCount":3,"createdAt":"2025-10-05T17:13:02.753Z","updatedAt":"2025-10-05T17:13:02.753Z","lastBump":"2025-10-05T17:13:02.753Z","script":"--// Smooth Wall + Edge Transition Script\n--// LocalScript in StarterPlayerScripts\n\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hum = char:WaitForChild(\"Humanoid\")\nlocal root = char:WaitForChild(\"HumanoidRootPart\")\n\nlocal wallMode = false\nlocal wallCheckDist = 7\nlocal floorCheckDist = 6\nlocal climbSpeed = 24\nlocal stickForce = 61\nlocal rotateSpeed = 0.4\n\n-- Toggle with X\nUserInputService.InputBegan:Connect(function(input, gpe)\n\tif gpe then return end\n\tif input.KeyCode == Enum.KeyCode.X then\n\t\twallMode = not wallMode\n\t\tprint(wallMode and \"Wall Mode ON\" or \"Wall Mode OFF\")\n\t\tif not wallMode then\n\t\t\thum:ChangeState(Enum.HumanoidStateType.Freefall)\n\t\tend\n\tend\nend)\n\nRunService.Heartbeat:Connect(function(dt)\n\tif not wallMode then return end\n\tif not root or not hum then return end\n\n\tlocal rayParams = RaycastParams.new()\n\trayParams.FilterDescendantsInstances = {char}\n\trayParams.FilterType = Enum.RaycastFilterType.Exclude\n\n\t-- Forward ray to find walls\n\tlocal forwardRay = workspace:Raycast(root.Position, root.CFrame.LookVector * wallCheckDist, rayParams)\n\t-- Downward ray to detect ground when transitioning\n\tlocal downRay = workspace:Raycast(root.Position, -root.CFrame.UpVector * floorCheckDist, rayParams)\n\n\tlocal surfaceHit = forwardRay or downRay\n\n\tif surfaceHit then\n\t\tlocal normal = surfaceHit.Normal\n\t\tlocal moveDir = hum.MoveDirection\n\n\t\t-- Calculate alignment\n\t\tlocal forward = -normal\n\t\tlocal up = Vector3.new(0, 1, 0)\n\t\tlocal right = forward:Cross(up)\n\t\tup = right:Cross(forward)\n\n\t\t-- If we're near a floor edge (surface facing mostly upward)\n\t\tif math.abs(normal.Y) > 0.6 then\n\t\t\t-- Smoothly reset upright when walking over ledge\n\t\t\tlocal uprightCF = CFrame.fromMatrix(root.Position, right, Vector3.new(0,1,0))\n\t\t\troot.CFrame = root.CFrame:Lerp(uprightCF, rotateSpeed)\n\t\telse\n\t\t\t-- Align to wall\n\t\t\tlocal wallCF = CFrame.fromMatrix(root.Position, right, up)\n\t\t\troot.CFrame = root.CFrame:Lerp(wallCF, rotateSpeed)\n\t\tend\n\n\t\t-- Movement logic\n\t\tif moveDir.Magnitude > 0.05 then\n\t\t\t-- Project onto surface plane so we move along it\n\t\t\tlocal surfaceMove = (moveDir - normal * moveDir:Dot(normal)).Unit\n\t\t\tlocal climbVel = surfaceMove * climbSpeed\n\n\t\t\t-- Add upward bias when wall is steep\n\t\t\tif normal.Y < 0.5 then\n\t\t\t\tclimbVel += up * (climbSpeed * 0.6)\n\t\t\tend\n\n\t\t\troot.AssemblyLinearVelocity = climbVel - normal * stickForce\n\t\telse\n\t\t\troot.AssemblyLinearVelocity *= 0.8\n\t\tend\n\telse\n\t\thum:ChangeState(Enum.HumanoidStateType.Freefall)\n\tend\nend)\n","features":"you can now walk on walls (i will edit this later)","tags":["working","free","wallwalk"],"discord":"","keyLink":"","owner":{"_id":"68334c8d6c76333235994b77","username":"EstractomonyYx","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68334c8d6c76333235994b77","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:48:55.827Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e2a71ebb155ab7ad3091b2","editBy":{"_id":"68334c8d6c76333235994b77","username":"EstractomonyYx","status":"offline","id":"68334c8d6c76333235994b77"},"message":"Created script about wall walking","createdAt":"2025-10-05T17:13:02.757Z"}],"comments":[{"_id":"68e2a76214bd204be2afdcc5","commentBy":{"_id":"68334c8d6c76333235994b77","username":"EstractomonyYx","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-05-25T16:59:57.624Z","lastActive":"2025-10-05T17:44:21.866Z","status":"offline","id":"68334c8d6c76333235994b77","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Toggleable with X","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-10-05T17:14:10.180Z","liked":false,"disliked":false},{"_id":"68e2a9958a