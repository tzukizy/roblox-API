{"_id":"62e8dccda226d25733a96d9c","title":"Auto typer","game":{"_id":"67e5e1ffb360710ec3c784f4","gameId":7232779505,"name":"Type Race!","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"7232779505-type-race","path":"/game/7232779505-type-race","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":7232779505},"slug":"Type-Race!-Auto-typer-4578","verified":true,"key":false,"keyless":false,"views":102531,"executes":990,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/4721e16c376ea2d97594dca7352bf60e/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/4721e16c376ea2d97594dca7352bf60e/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/4721e16c376ea2d97594dca7352bf60e/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/4721e16c376ea2d97594dca7352bf60e/500/280/Image/Jpeg"},"likeCount":4,"dislikeCount":1,"createdAt":"2022-08-02T08:14:05.038Z","updatedAt":"2022-08-02T08:14:05.038Z","lastBump":"2022-08-02T08:14:05.038Z","script":"_G.wpmlimit = 201 -- Max WPM you can hit, will start stuttering at this limit\n_G.keydelay = 0.0525 -- Delay between keys to seem more legit. 0.075 ~ 144wpm\n\nlocal vim = game:GetService(\"VirtualInputManager\") -- I specifically did this bc keypress used only VK bytecodes\n-- Interpreting straight letter to VIM seems to be faster than using VK, and it works without needing game focus\n\n---- vvvvv I DID NOT MAKE ANYTHING IN THIS SECTION vvvvv ----\nlocal function findLetterTable()\nfor i,obj in pairs( getgc() ) do\nif type(obj) == \"function\" and getfenv(obj).script == game:GetService(\"Players\").LocalPlayer.PlayerGui.LocalMain then\nlocal consts=debug.getconstants(obj)\nif consts[8]==\"idXTO3JVlV0CBTmiSbaQ\" then\n--local tab=debug.getupvalue(obj,4)\nreturn debug.getupvalue(obj,4) -- FULL CREDIT TO IDoN0t ON V3RM FOR THIS THING [showthread.php?tid=1140292]\nend end end end -- I have no idea what's going on in this thing, other than just raw letters come out of it\n---- ^^^^^ I DID NOT MAKE ANYTHING IN THIS SECTION ^^^^^ ----\n\nlocal descendants = findLetterTable()\nfor index, descendant in pairs(descendants) do\n    if string.upper(descendant) ~= \" \" then -- Remnant of an old method of getting letters\n        local key = Enum.KeyCode[string.upper(descendant)]\n        vim:SendKeyEvent(1,key,0,nil)\n        vim:SendKeyEvent(0,key,0,nil) \n        else\n        vim:SendKeyEvent(1,32,0,nil) -- This is how I used to interpret spaces safely\n        vim:SendKeyEvent(0,32,0,nil) -- It's crusty, but it works\n        end\n    while tonumber(game.Players.LocalPlayer.PlayerGui.ScreenGui.Main.RaceScreen.LiveStats.WPM.Stat.Text) > _G.wpmlimit do\n    task.wait() -- This section hard limits at the set WPM cap. Should this also be keydelay so it's less jittery/stuttery?\n    end\n    wait(_G.keydelay)\n    if game.Workspace:FindFirstChild(\"Doll\") then -- To avoid bugs with non RLGL modes\n        while game:GetService(\"SoundService\").DollSaying.TimePosition > 5 or game:GetService(\"SoundService\").DollSaying.TimePosition <= 0 do\n            task.wait() -- I encourage experimenting with the timepos to squeeze the most out of the time you have. 5 is the highest it's reliable at.\n        end\n    end\nend","features":"Credit to IDoN0t on v3rm for the section that finds which letters to type. This wouldn't be possible without it.\n\nCustomisable WPM cap (to avoid triggering the anticheat) and customisable key delay (to make it seem more legit)\n-- Try to avoid going too high, as the game does have a very basic anticheat in place. I am unsure what the hard limit for the anticheat is, but it does permaban if you go too high.\n\nHow to use: Execute when the round starts (NOT before it starts, as it starts typing immediately and will just start typing the wrong letters/be out of sync)","tags":["auto","type race","automatic","typer"],"discord":"","keyLink":"","owner":{"_id":"62e7364da190000aea61f6e1","username":"CraX","verified":true,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62e7364da190000aea61f6e1-1659319968412.jpg"},"status":"offline","id":"62e7364da190000aea61f6e1","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62e7364da190000aea61f6e1-1659319968412.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:17:05.811Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e6c2","editBy":{"_id":"62e7364da190000aea61f6e1","username":"CraX","status":"offline","id":"62e7364da190000aea61f6e1"},"message":"Create script","createdAt":"2025-03-27T22:30:48.701Z"}],"comments":[{"_id":"62e8e4a76148fb03ce9bcf94","commentBy":{"_id":"62d56842fd7ad314dede4ed2","username":"Fascinating","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-07-18T14:03:46.735Z","lastActive":"2026-06-06T23:10:18.081Z","status":"offline","id":"62d56842fd7ad314dede4ed2","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"below 400 is fine ig, got banned at 401 words 0.00075 sec","createdAt":"2022-08-02T08:47:35.160Z","edited":true,"dislikeCount":0,"likeCount":3,"liked":false,"disliked":false},{"_id":"62e9314d6232ac1a8c2b6a42","commentBy":{"_id":"62dd3b5eea0cb7cbab7e805c","username":"LuckyDuck","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62dd3b5eea0cb7cbab7e80