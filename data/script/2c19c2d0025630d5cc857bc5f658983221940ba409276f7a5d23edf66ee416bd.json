{"_id":"6764423518456f3363d16651","title":"FE Anti Void/Fling","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/e12502ae708c561e691d62182fdeea2a63c5840a27d07d51d433dde253be7320.webp","original":"https://scriptblox.com/images/sb/0-1769349487301.webp"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/e12502ae708c561e691d62182fdeea2a63c5840a27d07d51d433dde253be7320.webp","original":"https://scriptblox.com/images/sb/0-1769349487301.webp"},"placeId":0},"slug":"Universal-Script-FE-Anti-Void-24788","verified":false,"key":false,"keyless":false,"views":9087,"executes":180,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/236776ff1eb2714f6c263f0c2df509a52a7d1b510866abc0973e5cea053ce343.webp","original":"https://scriptblox.com/images/sb/0-1769349487301.webp","scriptblox":"https://scriptblox.com/images/script/0-1769349487301.webp"},"thumbnail":{"url":"https://media.kocakz.me/236776ff1eb2714f6c263f0c2df509a52a7d1b510866abc0973e5cea053ce343.webp","original":"https://scriptblox.com/images/sb/0-1769349487301.webp","scriptblox":"https://scriptblox.com/images/script/0-1769349487301.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-12-19T15:56:37.267Z","updatedAt":"2024-12-19T15:56:37.267Z","lastBump":"2024-12-19T15:56:37.267Z","script":"getgenv().AntiVoid = true\n\nlocal Players = game:GetService(\"Players\")\n\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function toolMatch(Handle)\n    local allPlayers = Players:GetPlayers()\n    for i = 1, #allPlayers do\n        -- // Vars\n        local Player = allPlayers[i]\n        if (Player == LocalPlayer) then continue end\n\n        local Character = Player.Character\n        local RightArm = Character:WaitForChild(\"Right Arm\")\n        local RightGrip = RightArm:FindFirstChild(\"RightGrip\")\n\n        if (RightGrip and RightGrip.Part1 == Handle) then\n            return Player\n        end\n    end\nend\n\nlocal function onCharacter(Character)\n    local RightArm = Character:WaitForChild(\"Right Arm\")\n\n    RightArm.ChildAdded:Connect(function(child)\n        if (child:IsA(\"Weld\") and child.Name == \"RightGrip\" and getgenv().AntiVoid) then\n            local ConnectedHandle = child.Part1\n\n            local matched = toolMatch(ConnectedHandle)\n\n            if (matched) then\n                ConnectedHandle.Parent:Destroy()\n                print(matched, \"just tried to void you lol!\")\n            end\n        end\n    end)\nend\n\nonCharacter(LocalPlayer.Character)\nLocalPlayer.CharacterAdded:Connect(onCharacter)","features":"+ Makes you unflingable from others\n- Anti Fling","tags":["FE","Fling","Void","Anti","script"],"discord":"","keyLink":"","owner":{"_id":"674c3e6a8e333c507435e20f","username":"Zyko","verified":false,"profilePicture":{"url":"https://media.kocakz.me/844cd1dbd08505592c7a53ec8043df9c7c98a877e03a13210fa820da4cb48c52.webp","original":"https://scriptblox.com/images/photo/674c3e6a8e333c507435e20f-1787933046752.jpg"},"status":"offline","id":"674c3e6a8e333c507435e20f","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/844cd1dbd08505592c7a53ec8043df9c7c98a877e03a13210fa820da4cb48c52.webp","original":"https://scriptblox.com/images/photo/674c3e6a8e333c507435e20f-1787933046752.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:07:43.366Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c539b4","editBy":{"_id":"674c3e6a8e333c507435e20f","username":"Zyko","status":"offline","id":"674c3e6a8e333c507435e20f"},"message":"Create script","createdAt":"2025-03-27T22:54:04.343Z"},{"_id":"697621210d28d6d14fd05d26","editBy":{"_id":