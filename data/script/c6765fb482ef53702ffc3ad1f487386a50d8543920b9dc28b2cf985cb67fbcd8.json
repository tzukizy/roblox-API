oundTransparency = 1\nImage.Image = \"rbxassetid://136970392376069\"\nImage.ScaleType = Enum.ScaleType.Fit\nImage.Parent = ScreenGui\nImage.Visible = false\n\n-- Textul cel mare și enervant\nlocal TextLabel = Instance.new(\"TextLabel\")\nTextLabel.Size = UDim2.new(1, 0, 0.25, 0)\nTextLabel.Position = UDim2.new(0, 0, 0.375, 0)   -- cam la mijloc\nTextLabel.BackgroundTransparency = 1\nTextLabel.Text = \"sorry skid make u own skid\"\nTextLabel.TextColor3 = Color3.new(1, 1, 1)\nTextLabel.TextStrokeTransparency = 0\nTextLabel.TextStrokeColor3 = Color3.new(0, 0, 0)\nTextLabel.Font = Enum.Font.SourceSansBold\nTextLabel.TextScaled = true\nTextLabel.TextSize = 100   -- valoare maximă de bază (încă se scalează)\nTextLabel.Parent = ScreenGui\n\nlocal RunService = game:GetService(\"RunService\")\nlocal hue = 0\n\nRunService.Heartbeat:Connect(function(delta)\n    hue = (hue + delta * 1100) % 1          -- cât mai rapid posibil\n    Frame.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)\n    \n    -- Flicker imagine + text în același timp (maximă nebunie)\n    local visible = not Image.Visible\n    Image.Visible = visible\n    TextLabel.Visible = visible\nend)","features":"-sky box 50 buttons skybox\n-tryppy skybox\n-decal\n-particle\n-rain \n-slap tower spawn\n-spawn krasty krabs\n-patrik\n-spongebob\n-rain troll\nmore more more","tags":[],"discord":"","keyLink":"","owner":{"_id":"6955bbbce2b3f9aafd995545","username":"moraruangela63","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6955bbbce2b3f9aafd995545","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:39:07.412Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],