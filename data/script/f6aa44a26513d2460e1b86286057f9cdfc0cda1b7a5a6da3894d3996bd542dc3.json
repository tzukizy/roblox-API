{"_id":"69d28d2cd505036aa6940e1d","title":"Tp google script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/ce1d0456429b394ec05d575eb0d6c30fa9ccc58d2299d964a259109eefcff1e6.webp","original":"https://scriptblox.com/images/sb/0-1775406380433.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/ce1d0456429b394ec05d575eb0d6c30fa9ccc58d2299d964a259109eefcff1e6.webp","original":"https://scriptblox.com/images/sb/0-1775406380433.png"},"placeId":0},"slug":"Universal-Script-Tp-google-script-190361","verified":false,"key":false,"keyless":false,"views":425,"executes":714,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/dfead4fb09a222b59cfdc097660538fc02121541b2e136c41519afb7915677f5.webp","original":"https://scriptblox.com/images/sb/0-1775406380433.png","scriptblox":"https://scriptblox.com/images/script/0-1775406380433.png"},"thumbnail":{"url":"https://media.kocakz.me/dfead4fb09a222b59cfdc097660538fc02121541b2e136c41519afb7915677f5.webp","original":"https://scriptblox.com/images/sb/0-1775406380433.png","scriptblox":"https://scriptblox.com/images/script/0-1775406380433.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-04-05T16:26:20.448Z","updatedAt":"2026-04-05T16:26:20.448Z","lastBump":"2026-04-05T16:26:20.448Z","script":"-- Configurações\nlocal player = game:GetService(\"Players\").LocalPlayer\nlocal mouse = player:GetMouse()\nlocal backpack = player:WaitForChild(\"Backpack\")\n\n-- Criando a Tool via Script\nlocal teleportTool = Instance.new(\"Tool\")\nteleportTool.Name = \"TP Exploit\"\nteleportTool.RequiresHandle = false -- Não precisa de um bloco (Part) para funcionar\nteleportTool.Parent = backpack\n\n-- Função de Teleporte\nteleportTool.Activated:Connect(function()\n    local character = player.Character\n    if character and character:FindFirstChild(\"HumanoidRootPart\") then\n        local targetPos = mouse.Hit.Position\n        \n        -- Teleporte instantâneo usando PivotTo (Bypassa checks de WalkSpeed)\n        -- Adicionamos 3 studs no eixo Y para você não spawnar dentro do chão\n        character:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))\n        \n        print(\"Teleportado para: \" .. tostring(targetPos))\n    end\nend)\n\nprint(\"Ferramenta de Teleporte adicionada ao seu inventário!\")\n","features":"this time google made it better","tags":[],"discord":"","keyLink":"","owner":{"_id":"69c1b1cb8eb9295c7ebd1a57","username":"GOOGLEEXPLOITS","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3cea8859ee2d50ceff354f2743efa9d0afad979af79fdccc3e86e6d9320943ba.webp","original":"https://scriptblox.com/images/photo/69c1b1cb8eb9295c7ebd1a57-1774301765093.png"},"status":"offline","id":"69c1b1cb8eb9295c7ebd1a57","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/3cea8859ee2d50ceff354f2743efa9d0afad979af79fdccc3e86e6d9320943ba.webp","original":"https://scriptblox.com/images/photo/69c1b1cb8eb9295c7ebd1a57-1774301765093.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:31:10.893Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d28d2cd505036aa6940e20","editBy":{"_id":"69c1b1cb8eb9295c7ebd1a57","username":"GOOGLEEXPLOITS","status":"offline","id":"69c1b1cb8eb9295c7ebd1a57"},"message":"Create script","createdAt":"2026-04-05T16:26:20.452Z"}],"comments":[]}