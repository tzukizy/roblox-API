{"slug":"Universal-Script-Instant-PROXIMITY-PROMPT-INFINITE-MAX-DISTANCE-66004","_id":"69176cb892d8137c524cc4fc","title":"Instant PROXIMITY PROMPT INFINITE MAX DISTANCE","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"TESTED ON XENO (All Executors SUPPORTED)\n\nInstant PROXIMITY PROMPT + INFINITE MAX DISTANCE by me\n\nJust Added 'math.huge' into 'MaxActivationDistance' So You Can Use Proximity Prompt From Any Distances.\n\n[Add this script into 'autoexec' folder or you can run it manually.]","tags":["PROXIMITY PROMPT"],"script":"local Workspace = game:GetService(\"Workspace\")\nlocal function configureInfinitePrompt(prompt: Instance)\nif prompt:IsA(\"ProximityPrompt\") then\n\t\tprompt.HoldDuration = 0\n\t\tprompt.MaxActivationDistance = math.huge\n\tend\nend\nfor _, descendant: Instance in ipairs(Workspace:GetDescendants()) do\n\tconfigureInfinitePrompt(descendant)\nend\nWorkspace.DescendantAdded:Connect(configureInfinitePrompt)","owner":{"_id":"664b971b7b31a40c47060765","username":"Irfannnnn","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/cbf10bc0c867955a93b4cc77ef7cfa540e1e7c3cda35fee5351587a9a91048ff.webp","original":"https://scriptblox.com/images/photo/664b971b7b31a40c47060765-1736073755213.jpg"},"status":"offline","id":"664b971b7b31a40c47060765","leaderboard":{"tag":null},"topMilestone":{"key":"creator.executions","tier":1000000},"profile":{"url":"https://cdn.kocakz.me/images/cbf10bc0c867955a93b4cc77ef7cfa540e1e7c3cda35fee5351587a9a91048ff.webp","original":"https://scriptblox.com/images/photo/664b971b7b31a40c47060765-1736073755213.jpg"}},"verified":false,"views":4340,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/1c98228ab94554840e775e41dec9560c35d5