{"slug":"Universal-Script-Universal-Smoking-92511","_id":"6976d46592a4802284ae95e5","title":"Universal Smoking","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"script that breathes smoke.","tags":["Smoke vape Pod Smoking Fumaa"],"script":"\nlocal p = game.Players.LocalPlayer\nlocal pg = p:WaitForChild(\"PlayerGui\")\n\nif pg:FindFirstChild(\"FumacaOficial\") then pg.FumacaOficial:Destroy() end\n\nlocal sg = Instance.new(\"ScreenGui\", pg)\nsg.Name = \"FumacaOficial\"\nsg.ResetOnSpawn = false\n\nlocal btn = Instance.new(\"TextButton\", sg)\nbtn.Size = UDim2.new(0, 140, 0, 45)\nbtn.Position = UDim2.new(0.5, -70, 0.2, 0)\nbtn.Text = \"FUMAÇA: OFF\"\nbtn.Draggable = true\nbtn.Active = true\nbtn.BackgroundColor3 = Color3.new(0,0,0)\nbtn.TextColor3 = Color3.new(1,1,1)\nInstance.new(\"UICorner\", btn)\n\nlocal ligado = false\n\nlocal function smoke()\n    local char = p.Character\n    if not char then return end\n    local head = char:WaitForChild(\"Head\", 5)\n    \n    if head then\n        if head:FindFirstChild(\"M\") then head.M:Destroy() end\n        if ligado then\n            local a = Instance.new(\"Attachment\", head)\n            a.Name = \"M\"\n            a.Position = Vector3.new(0, -0.45, -0.6)\n\n            local s = Instance.new(\"ParticleEmitter\", a)\n            -- ESTA TEXTURA É NATIVA, NÃO PRECISA BAIXAR:\n            s.Texture = \"rbxasset://textures/particles/smoke_main.dds\" \n            \n            s.Color = ColorSequence.new(Color3.new(1, 1, 1))\n            s.Transparency = NumberSequence.new(0.1) -- A força 0.10 que você quer\n            s.LightInfluence = 0\n            s.Size = NumberSequence.new(0.5, 2)\n            s.Rate = 100\n            s.Lifetime = NumberRange.new(1, 1.5)\n            s.Speed = NumberRange.new(3, 5)\n            s.EmissionDirection = Enum.NormalId.Front\n        end\n    end\nend\n\nbtn.MouseButton1Click:Connect(function()\n    ligado = not ligado\n    btn.Text = ligado and \"FUMAÇA: ON\" or \"FUMAÇA: OFF\"\n    btn.BackgroundColor3 = ligado and Color3.new(0, 0.6, 1) or Color3.new(0,0,0)\n    smoke()\nend)\n\np.CharacterAdded:Connect(function()\n    task.wait(3)\n    if ligado then smoke() end\nend)\n","owner":{"_id":"68e8650e103721b523efebc5","username":"PARTYBE","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68e8650e103721b523efebc5","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":1680,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/fd367f84964dea8d5be98dc92053dda19dad65a768a07f142b63da4f2daab568.webp","original":"https://scriptblox.com/images/sb/0-1769395301808.jpg","scriptblox":"https://scriptblox.com/images/script/0-1769395301808.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-01-26T02:41:41.823Z","executes":2470,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:07:10.797Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/fd367f84964dea8d5be98dc92053dda19dad65a768a07f142b63da4f2daab568.webp","original":"https://scriptblox.com/images/sb/0-1769395301808.jpg","scriptblox":"https://scriptblox.com/images/script/0-1769395301808.jpg"},"changelog":[{"_id":"6976d46592a4802284ae95e8","editBy":{"_id":"68e8650e103721b523efebc5","username":"PARTYBE","status":"offline","id":"68e8650e103721b523efebc5"},"message":"Lançamento oficial - Fumaça 0.10","createdAt":"2026-01-26T02:41:41.826Z"}],"comments":[{"_id":"6976d82528b1