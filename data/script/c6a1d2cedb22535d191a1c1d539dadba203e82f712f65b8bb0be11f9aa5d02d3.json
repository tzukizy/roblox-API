{"slug":"99percent-QUIT-OBBY-Auto-Finish-14649","_id":"667ad7598308bbe74b6acc27","title":"Auto Finish","game":{"_id":"67e5e1ffb360710ec3c78cd4","gameId":17858616001,"name":"99% QUIT OBBY","imageUrl":"https://tr.rbxcdn.com/db1caa9a1f7acd4dd30569795581f1d9/500/280/Image/Jpeg","placeId":17858616001},"features":"Auto Finish\nAuto Rebirth","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal player = Players.LocalPlayer\nlocal checkpoints = game.Workspace:FindFirstChild(\"Checkpoints\")\n\nlocal currentStage = player.leaderstats.Stage.Value\n\nlocal function moveToCheckpoint(checkpointNumber)\n    local part = checkpoints:FindFirstChild(checkpointNumber)\n    if part then\n        player.Character:MoveTo(part.Position)\n    end\nend\n\nif checkpoints then\n    for i = currentStage, 200 do\n        moveToCheckpoint(i)\n        wait(0.25)\n        \n        if i == 200 then\n            local args = {\n                [1] = \"Yes\"\n            }\n            ReplicatedStorage.Remotes.PlayerSettings.RebirthConfirm:FireServer(unpack(args))\n        end\n    end\nend\n","owner":{"_id":"62713a92769ea1383ba6a8c6","username":"idk123234325","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"62713a92769ea1383ba6a8c6","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":4889,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-25T14:42:33.163Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/db1caa9a1f7acd4dd30569795581f1d9/500/280/Image/Jpeg","executes":2,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c5f2","editBy":{"_id":"62713a92769ea1383ba6a8c6","username":"idk123234325","status":"offline","id":"62713a92769ea1383ba6a8c6"},"message":"Create script","createdAt":"2024-06-25T16:00:36.143Z"},{