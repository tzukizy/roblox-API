{"slug":"Universal-Script-Calculator-14769","_id":"667c92ede1255dc2e5e09880","title":"Calculator","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"epic","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal gui = Instance.new(\"ScreenGui\")\nlocal frame = Instance.new(\"Frame\")\nlocal display = Instance.new(\"TextLabel\")\nlocal buttons = {}\nlocal isDragging = false\nlocal offset = Vector2.new()\n\n-- Stellen Sie die GUI-Elemente ein\ngui.Parent = player.PlayerGui\ngui.Name = \"CalculatorGUI\"\nframe.Parent = gui\nframe.Size = UDim2.new(0, 200, 0, 300)\nframe.Position = UDim2.new(0.5, -100, 0.5, -150)\nframe.BackgroundTransparency = 0.5\n\ndisplay.Parent = frame\ndisplay.Size = UDim2.new(1, 0, 0.2, 0)\ndisplay.TextSize = 24\ndisplay.BackgroundColor3 = Color3.new(0, 0, 0)\ndisplay.TextColor3 = Color3.new(1, 1, 1)\ndisplay.Text = \"0\"\n\n-- Funktion zum Hinzufügen von Schaltflächen\nlocal function addButton(text, x, y)\n    local button = Instance.new(\"TextButton\")\n    button.Parent = frame\n    button.Size = UDim2.new(0.2, 0, 0.1, 0)\n    button.Position = UDim2.new(x, 0, y, 0)\n    button.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)\n    button.Text = text\n    button.MouseButton1Click:Connect(function()\n        -- Hier fügen Sie die Logik für die Schaltflächen hinzu\n        if text == \"=\" then\n            -- Berechnung durchführen und Ergebnis anzeigen\n            local result = loadstring(\"return \" .. display.Text)()\n            display.Text = tostring(result)\n        elseif text == \"C\" then\n            -- Löschen Sie den Anzeigetext\n            display.Text = \"0\"\n        else\n            -- Zahlen und Operatoren hinzufügen\n            if display.Text == \"0\" then\n                display.Text = text\n            else\n                display.Text = display.Text .. text\n            end\n        end\n    end)\n    table.insert(buttons, button)\nend\n\n-- Erstellen Sie Schaltflächen\naddButton(\"7\", 0, 0.3)\naddButton(\"8\", 0.3, 0.3)\naddButton(\"9\", 0.6, 0.3)\naddButton(\"/\", 0.9, 0.3)\naddButton(\"4\", 0, 0.5)\naddButton(\"5\", 0.3, 0.5)\naddButton(\"6\", 0.6, 0.5)\naddButton(\"*\", 0.9, 0.5)\naddButton(\"1\", 0, 0.7)\naddButton(\"2\", 0.3, 0.7)\naddButton(\"3\", 0.6, 0.7)\naddButton(\"-\", 0.9, 0.7)\naddButton(\"0\", 0, 0.9)\naddButton(\"C\", 0.3, 0.9)\naddButton(\"=\", 0.6, 0.9)\naddButton(\"+\", 0.9, 0.9)\n\n-- Implementieren Sie die Mausverschiebung\nframe.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 then\n        isDragging = true\n        offset = frame.Position - UDim2.new(0, input.Position.X, 0, input.Position.Y)\n    end\nend)\n\nframe.InputEnded:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 then\n        isDragging = false\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputChanged:Connect(function(input)\n    if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then\n        frame.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y) + offset\n    end\nend)","owner":{"_id":"629dfc67ee6d3da00eafbd2e","username":"Moor","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0bf7bf98c2dcf1f56c46d6a749a59e3d53521ec40b5e69cb6141fd2028c7e78a.webp","original":"https://scriptblox.com/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png"},"status":"offline","id":"629dfc67ee6d3da00eafbd2e","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/0bf7bf98c2dcf1f56c46d6a749a59e3d53521ec40b5e69cb6141fd2028c7e78a.webp","original":"https://scriptblox.com/images/photo/629dfc67ee6d3da00eafbd2e-1744662497740.png"}},"verified":false,"keyLink":"","views":5177,"scriptType":"free","isUniversal":true,"isPatched":f