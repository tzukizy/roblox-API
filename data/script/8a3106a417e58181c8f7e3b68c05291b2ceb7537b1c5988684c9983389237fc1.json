        return response.data\n    end\n\n    return nil\nend\n\nlocal placeId = game.PlaceId\nlocal serverLimit = 100\nlocal servers = fetchServersData(placeId, serverLimit)\n\nif not servers then\n    return\nend\n\nlocal lowestPingServer = servers[1]\n\nfor _, server in pairs(servers) do\n    if server[\"ping\"] < lowestPingServer[\"ping\"] then\n        lowestPingServer = server\n    end\nend\n\nlocal commonLoadTime = 5\ntask.wait(commonLoadTime)\n\nlocal pingThreshold = 100\nlocal serverStats = StatsService.Network.ServerStatsItem\nlocal dataPing = serverStats[\"Data Ping\"]:GetValueString()\nlocal pingValue = tonumber(dataPing:match(\"(%d+)\"))\n\nif pingValue >= pingThreshold then\n    TeleportService:TeleportToPlaceInstance(placeId, lowestPingServer.id)\nelse\n   \t-- Good ping\nend","features":"Joins the server with the best ping to have barley any lag","tags":[],"discord":"","keyLink":"","owner":{"_id":"64de08ae63cedb717c97dce3","username":"Vorti","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1fb7045edf1f93bb053508073bb8c20e4682d96bec33071e1280bd016ecd846c.webp","original":"https://scriptblox.com/images/photo/64de08ae63cedb717c97dce3-1696169298449.png"},"status":"offline","id":"64de08ae63cedb717c97dce3","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/1fb7045edf1f93bb053508073bb8c20e4682d96bec33071e1280bd016ecd846c.webp","original":"https://scriptblox.com/images/photo/64de08ae63cedb717c97dce3-1696169298449.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T03:00:37.414Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f793","editBy":{"_id":"64de08ae63cedb717c97dce3","username":"Vorti","status":"offline","id":"64de08ae63cedb717c97dce3"},"message":"Create script","createdAt":"2025-03-27T13:5