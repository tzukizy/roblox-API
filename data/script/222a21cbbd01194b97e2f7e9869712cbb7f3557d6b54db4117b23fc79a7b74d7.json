{"slug":"Re:Battlegrounds-(Uncopylocked)-Re-battlegrounds-Script-136075","_id":"69b0714d67b3dcfd3621114c","title":"Cool owner text above your head","game":{"_id":"69b0714d67b3dcfd36211149","gameId":17824148122,"name":"Re:Battlegrounds (Uncopylocked)","imageUrl":"/images/sb/rbx-bb2272da6c37cdeb71132e560884fba3-a24efac4655c.png","placeId":17824148122},"features":"Very cool when you spawn in then there will be a text above your head and it will say owner","tags":[],"script":"local Players = game:GetService(\"Players\")\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function(character)\n\n\t\tlocal head = character:WaitForChild(\"Head\")\n\n\t\tlocal billboard = Instance.new(\"BillboardGui\")\n\t\tbillboard.Size = UDim2.new(0,200,0,50)\n\t\tbillboard.StudsOffset = Vector3.new(0,2,0)\n\t\tbillboard.AlwaysOnTop = true\n\t\tbillboard.Parent = head\n\n\t\tlocal text = Instance.new(\"TextLabel\")\n\t\ttext.Size = UDim2.new(1,0,1,0)\n\t\ttext.BackgroundTransparency = 1\n\t\ttext.Text = \"Owner\"\n\t\ttext.TextScaled = true\n\t\ttext.TextColor3 = Color3.fromRGB(255, 255, 0)\n\t\ttext.Font = Enum.Font.GothamBold\n\t\ttext.Parent = billboard\n\n\tend)\nend)","owner":{"_id":"69832effe96ccd295682caf5","username":"Dashhagewood4","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69832effe96ccd295682caf5","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":471,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/17824148122-1773171021885.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-10T19:30:21.901Z","editBy":{"_id":"69832effe96ccd295682caf5","username":"Dashhagewood4","status":"offline","id":"69832effe96ccd295682caf5"},"keyLink":"","executes":39,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b0714d67b3dcfd3621114f","editBy":{"_id":"69832effe96ccd295682caf5","username":"Da