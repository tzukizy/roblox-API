{"slug":"Open-Beta-Legend-Piece-Kill-Script-3703","_id":"62ba9927e67733f5f267f078","title":"Infinite Stats/Kill All","game":{"_id":"67e5e1ffb360710ec3c7832a","gameId":8123652942,"name":"[Open Beta] Legend Piece","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":8123652942},"features":"Kill mobs and players.(scroll down)\n--Pretty sure it requires to be outside the safezone, I can't be bothered as this game is ass\nInfinite Levels (instructions in comment code)","tags":["kill"],"script":"--[[]\nExecute the script below, allocate all your points, then when it hits 0, press reset stats, and then execute again. Max level is 1000. You can do the same with Beli and Gem, and you can even do it for Bounty too. (Two forms of currency for this game)\n--]]\n\nlocal args = {\n    [1] = game:GetService(\"Players\").LocalPlayer.Data.Level,\n    [2] = 1, --Change number to amount of points you have\n    [4] = \"ouifdhasdfnJNASDIFN_AIDFNnijsdifnNIFASND_FAIAasjddsfDJFSDN!)@NASD@nasdj!@*$#(jfd\"\n}\n\ngame:GetService(\"ReplicatedStorage\").Remotes.Stats:FireServer(unpack(args))\n\n\n--Kill Players\nfor i,v in pairs(game:GetService(\"Players\"):GetChildren()) do\nif not(v.Name == game.Players.LocalPlayer.Name) then\n    local args = {\n        [1] = \"TakeDamage\",\n        [2] = {\n            [\"target\"] = v,\n            [\"damage\"] = 9e+99\n        },\n        [3] = \"QWEFN@R}ASDF!@}R|DSFMQ@FASF:LWQE\"\n    }\n    \n    game:GetService(\"ReplicatedStorage\").Remotes.DamageRemoteEvent:FireServer(unpack(args))\nend\nend\n\n\n--Kill Mobs\nfor i,v in pairs(game:GetService(\"Workspace\").Monster:GetChildren()) do\n    local args = {\n        [1] = \"TakeDamage\",\n        [2] = {\n            [\"target\"] = v,\n            [\"damage\"] = 9e+99\n        },\n        [3] = \"QWEFN@R}ASDF!@}R|DSFMQ@FASF:LWQE\"\n    }\n    \n    game:GetService(\"ReplicatedStorage\").Remotes.DamageRemoteEvent:FireServer(unpack(args))\nend","owner":{"_id":"62a197cead097a168f3a614f","username":"UserWithNoLife","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"62a197cead097a168f3a614f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":true,"views":63655,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-06-28T06:01:11.926Z","dislikeCount":0,"likeCount":5,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/71ad9465ed7c896ca3710b6cf121da8b/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/71ad9465ed7c896ca3710b6cf121da8b/500/280/Image/Jpeg"},"executes":31,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:25:55.407Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/71ad9465ed7c896ca3710b6cf121da8b/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/71ad9465ed7c896ca3710b6cf121da8b/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b69f","editBy":{"_id":"62a197cead097a168f3a614f","username":"UserWithNoLife","status":"offline","id":"62a197cead097a168f3a614f"},"message":"Create script","createdAt":"2022-06-28T06:07:30.910Z"},{"_id":"67e5e1e3b360710ec3c4e882","editBy":{"_id":"62a197cead097a168f3a614f","username":"UserWithNoLife","status":"offline","id":"62a197cead097a168f3a614f"},"message":"Update script","createdAt":"2025-03-27T22:45:28.175Z"}],"comments":[{"_id":"62ba99edb583da04054d5a82","commentBy":{"_id":"62a197cead097a168f3a614f","username":"UserWithNoLife","verified":false,"role":"user","profilePicture":{"url":