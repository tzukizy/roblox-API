{"_id":"6933272e6c9262e8fa43dd54","title":"FE tool orbit but tool can spin","game":{"_id":"68966c2c1db541b05096cd52","gameId":14113053169,"name":"Free Client Script Executor *BACK*","imageUrl":{"url":"https://media.kocakz.me/ee9cd5d22b0130fa183d984f3a68f029e9df5ef4596e46f028c9123c6bbc73a8.webp","original":"https://scriptblox.com/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png"},"slug":"14113053169-free-client-script-executor-back","path":"/game/14113053169-free-client-script-executor-back","thumbnail":{"url":"https://media.kocakz.me/ee9cd5d22b0130fa183d984f3a68f029e9df5ef4596e46f028c9123c6bbc73a8.webp","original":"https://scriptblox.com/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png"},"placeId":14113053169},"slug":"Free-Client-Script-Executor-*BACK*-FE-tool-orbit-but-tool-can-spin-72742","verified":false,"key":false,"keyless":false,"views":1383,"executes":222,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d98437442572151102.webp","original":"https://scriptblox.com/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","scriptblox":"https://scriptblox.com/images/script/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png"},"thumbnail":{"url":"https://media.kocakz.me/2fdc3ee6a96760d4eee8fb0d900dc38afccf1c7f75e9d9d98437442572151102.webp","original":"https://scriptblox.com/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","scriptblox":"https://scriptblox.com/images/script/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-12-05T18:40:46.173Z","updatedAt":"2025-12-05T18:40:46.173Z","lastBump":"2025-12-05T18:40:46.173Z","script":"game.Players.LocalPlayer.Character.Humanoid:UnequipTools()\ngame.Players.LocalPlayer.Character.Humanoid:EquipTool(game.Players.LocalPlayer.Backpack:FindFirstChildOfClass(\"Tool\"))\ntask.wait(0.2)\nlocal connection\nconnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\nfor _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do\nif v.Name == \"Handle\" and v.Parent:IsA(\"Tool\") then\nv.Velocity = Vector3.new(50,0,0)\nend end end)\ntask.wait(0.2)\nlocal boombox = game.Players.LocalPlayer.Character:FindFirstChildOfClass(\"Tool\")\nlocal handle = boombox.Handle\nif game.Players.LocalPlayer.Character.Humanoid.RigType == Enum.HumanoidRigType.R15 then\ngame.Players.LocalPlayer.Character.RightHand:Destroy()\nelse\ngame.Players.LocalPlayer.Character[\"Right Arm\"]:Destroy()\nend\nlocal hrp = game.Players.LocalPlayer.Character.HumanoidRootPart\nlocal radius = 4.5\nlocal angle = 0\nlocal speed = 2\nconnection4 = game:GetService(\"RunService\").Heartbeat:Connect(function(deltatime)\nangle = angle + speed * deltatime\nlocal pos = hrp.Position\nlocal x = pos.X + math.sin(angle) * radius\nlocal y = pos.Y\nlocal z = pos.Z + math.cos(angle) * radius\nhandle.Position = Vector3.new(x,y,z)\nend)\nlocal connec\nconnec = game:GetService(\"TextChatService\").SendingMessage:Connect(function(msg)\nif msg.Text == \";unpositiontoolorbit\" or msg.Text == \";unptorbit\" then\nconnec:Disconnect()\nconnec = nil\nconnection4:Disconnect()\nconnection4 = nil\nconnection:Disconnect()\nconnection = nil\nend end)","features":"Needs a tool in inventory. This tool will, by default, orbit you faster than the other one. Say ;unptorbit to stop the orbit. Netless is included. Only one tool can orbit in this script.","tags":[],"discord":"","keyLink":"","owner":{"_id":"69237472df5c9c28cb000392","username":"Automated_Account","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8a5ddbd218e23b4214ea5686aa7d6bd8b3710b5a051962059566810ddb5a1e0f.webp","original":"https://scriptblox.com/images/photo/69237472df5c9c28cb000392-1763931573809.jpeg"},"status":"offline","id":"69237472df5c9c28cb000392","topMilestone":{"key":"creator.followers","tier":10},"profile":{"