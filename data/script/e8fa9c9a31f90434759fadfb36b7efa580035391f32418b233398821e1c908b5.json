{"slug":"Hell's-Kitchen-auto-pantry-and-fridge-34796","_id":"67f5b6eb39e310f562bf8755","title":"auto pantry and fridge","game":{"_id":"67e5e1ffb360710ec3c789ac","gameId":18130218021,"name":"Hell's Kitchen","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":18130218021},"features":"Execute when pre-service starts or whenever, should auto collect ingredients from pantry and fridge\n\nIf it stops working simply execute it again.\n\nWIP","tags":["auto","hub","full","free","keyless"],"script":"local LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal NextSteps = LocalPlayer.PlayerGui.ScreenGui.NextSteps\nlocal Steps = NextSteps.Steps\nlocal CurrentAction = NextSteps.CurrentAction\n\nlocal function GetCurrentTask()\n    if CurrentAction.Value == 0 then return false end\n    return Steps[tostring(CurrentAction.Value)]\nend\n\nwarn(Action)\nlocal function GetIngredients(CurrentTask)\n    local TempIngredients = CurrentTask.Ingredients:GetChildren()\n    local Ingredients = {}\n    for i,v in pairs(TempIngredients) do\n        if v.ClassName ~= \"Frame\" then continue end\n        local Ingred = v.ViewportFrame:FindFirstChildWhichIsA(\"Model\")\n        if v.Name == \"Ingredient\" and Ingred then\n            table.insert(Ingredients, Ingred.Name)\n        end\n    end\n    return Ingredients\nend\nlocal function GatherIngredient(dum, IngredientName)\ntask.spawn(function()\nlocal args = {\n    [1] = IngredientName\n}\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"LocalModules\"):WaitForChild(\"LMKitchen\"):WaitForChild(\"ServerRec\"):WaitForChild(\"ObtainFood\"):InvokeServer(unpack(args))\nend)\nend\n\nwhile wait(.1) do\n    local CurrentTask = GetCurrentTask()\n    local Action = CurrentTask.Action.TextLabel.Text\n    warn(Action)\n    if Action == \"Pantry\" or Action == \"Fridge\" then\n        table.foreach(GetIngredients(CurrentTask), GatherIngredient)\n    end\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11023795}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"verified":true,"views":47288,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-04-08T23:53:15.437Z","executes":126,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:52:47.917Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f5b6eb39e310f562bf8757","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Upload Script","createdAt":"2025-04-08T23:53:15.439Z"}],"comments":[{"_id":"680a6943349