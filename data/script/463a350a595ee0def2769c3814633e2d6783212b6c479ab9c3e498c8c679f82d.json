{"slug":"Fling-to-Climb!-Fling-To-Climb-Autofarm-Coins-238774","_id":"6a39b47701df8f199767021f","title":"Fling To Climb Autofarm Coins","game":{"_id":"68eba2cbc76ed0d8043089c5","gameId":76193707924033,"name":"Fling to Climb!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":76193707924033},"features":"Auto collects all coins on the map","tags":["autofarm","fling","fling to climb","Coins","OP"],"script":"local autoFarm = true\n\ntask.spawn(function()\n\twhile true do\n\t\tif autoFarm then\n\t\t\tlocal character = game.Players.LocalPlayer.Character\n\t\t\tlocal hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tlocal coinsFolder = workspace.World.Coins\n\n\t\t\tif hrp and coinsFolder then\n\t\t\t\tfor _, coin in ipairs(coinsFolder:GetChildren()) do\n\t\t\t\t\tif coin:IsA(\"Model\") then\n\t\t\t\t\t\thrp.CFrame = coin:GetPivot()\n\t\t\t\t\telseif coin:IsA(\"BasePart\") then\n\t\t\t\t\t\thrp.CFrame = coin.CFrame\n\t\t\t\t\tend\n\n\t\t\t\t\ttask.wait(0.05)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\ttask.wait()\n\tend\nend)","owner":{"_id":"67e32b4eb42a0fb0022f4856","username":"Member","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9b192d62543da6a4e1676da2653fbc0bf29e5bcf3db62bdde62d07e661dc9cc1.webp","original":"https://scriptblox.com/images/photo/67e32b4eb42a0fb0022f4856-1756635677258.png"},"status":"offline","id":"67e32b4eb42a0fb0022f4856","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/9b192d62543da6a4e1676da2653fbc0bf29e5bcf3db62bdde62d07e661dc9cc1.webp","original":"https://scriptblox.com/images/photo/67e32b4eb42a0fb0022f4856-1756635677258.png"}},"verified":false,"views":424,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/d467440c3080fa88754db01f213ad67596ec32d1d5598d24da1cb36db171