   for _, Bot in (Workspace:GetChildren()) do\n        if (not Bot:GetAttribute(\"IsBot\")) or (Bot:FindFirstChildWhichIsA(\"ForceField\")) then\n            continue\n        end\n\n        local Humanoid = Bot:FindFirstChildWhichIsA(\"Humanoid\")\n        local Head = Bot:FindFirstChild(\"Head\")\n\n        if (not Head) or (not Humanoid) or (Humanoid.Health <= 0) then\n            continue\n        end\n\n        local Distance = (Head.Position - LocalPlayer.Character.Head.Position).Magnitude\n\n        if (Distance < ClosestRange) then\n            table.insert(ClosestTargets, {\n                [\"IsBot\"] = true,\n                [\"Head\"] = Head\n            })\n        end\n    end\n\n    return ClosestTargets\nend\n\nwhile (task.wait()) do\n    local ClosestTargets = ClosestTargets()\n    if (#ClosestTargets > 0) then\n        for _, Target in (ClosestTargets) do\n            local Player\n\n            if (Target.IsBot) then\n                Player = Target.Head.Parent\n            else\n                Player = Players:GetPlayerFromCharacter(Target.Head.Parent)\n            end\n\n            TEvent.FireRemote(\"HookFire\", {\n                [\"hookId\"] = 67,\n                [\"startPosition\"] = nil,\n                [\"direction\"] = (Target.Head.Position - LocalPlayer.Character.Head.Position).Unit,\n                [\"distance\"] = 9e9,\n                [\"hookFlyTime\"] = 0,\n                [\"hookBackSpeed\"] = 9e9,\n                [\"fireTime\"] = 0\n            })\n\n            TEvent.FireRemote(\"HookHit\", { -- changing it to FireRemote bypasses all checks\n                [\"hookId\"] = 67,\n                [\"targetPlayer\"] = Player,\n                [\"targetPartName\"] = Target.Head.Name,\n                [\"hookBackSpeed\"] = 9e9\n            })\n\n            TEvent.FireRemote(\"HookRelease\", {\n                [\"hookId\"] = 67,\n                [\"targetPlayer\"] = Player,\n                [\"reason\"] = \"was a faggot\"\n            })\n        end\n    end\nend","owner":{"_id":"6959d05ce248e163a217ec23","username":"BoyWife","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6959d05ce248e163a217ec23-1767493741070.PNG"},"status":"offline","id":"6959d05ce248e163a217ec23","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6959d05ce248e163a217ec23-1767493741070.PNG"}},"verified":false,"views":5736,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/21a78d655d6b2a794d22d8f895e8355d597ea44ed3eb6890895647d2a3be0a1f.webp","original":"https://scriptblox.com/images/sb/rbx-b03d2911c4953a0c8302d413bf8defb4-ce47cabc79bf.png","scriptblox":"https://scriptblox.com/images/script/rbx-b03d2911c4953a0c8302d413bf8defb4-ce47cabc79bf.png"},"likeCount":13,"dislikeCount":5,"createdAt":"2026-03-16T15:34:54.745Z","executes":2686,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:21:22.556Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/21a78d655d6b2a794d22d8f895e8355d597ea44ed3eb6890895647d2a3be0a1f.webp","original":"https://scriptblox.com/images/sb/rbx-b03d2911c4953a0c8302d413bf8defb4-ce47cabc79bf.png","scriptblox":"https://scriptblox.com/images/script/rbx-b03d2911c4953a0c8302d413bf8defb4-ce47cabc79bf.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b8231edcf2ddab0da6af02","editBy":{"_id":"6959d05ce248e163a217ec23","username":"BoyWife","status":"offline","id":"6959d05ce248e163a217ec23"},"message":"Create script","createdAt":"2026-03-16T15:34:54.746Z"}],"comments":[{"_id":"69b83f79942b0cf7aaeb112b","commentBy":{"_id":"69a270d1672a8f6d99395abd","username":"svt