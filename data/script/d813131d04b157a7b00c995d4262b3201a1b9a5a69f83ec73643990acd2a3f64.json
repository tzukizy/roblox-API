{"_id":"69b5ced49c5da0f34e54fe06","title":"Auto farm easy","game":{"_id":"6959526c0597a5542a8de666","gameId":0,"name":"Script hub","imageUrl":{"url":"https://media.kocakz.me/d017cbc88271b527fb678087e57be28e32b5c73548422a59d1e5eece8315bc8e.webp","original":"https://scriptblox.com/images/sb/0-1773522644513.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d017cbc88271b527fb678087e57be28e32b5c73548422a59d1e5eece8315bc8e.webp","original":"https://scriptblox.com/images/sb/0-1773522644513.jpg"},"placeId":0},"slug":"Universal-Script-Auto-farm-easy-140307","verified":false,"key":false,"keyless":false,"views":1750,"executes":587,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d6ee5a7278bea11565635019fb351e6d6339380db1de355394418b93fad4d949.webp","original":"https://scriptblox.com/images/sb/0-1773522644513.jpg","scriptblox":"https://scriptblox.com/images/script/0-1773522644513.jpg"},"thumbnail":{"url":"https://media.kocakz.me/d6ee5a7278bea11565635019fb351e6d6339380db1de355394418b93fad4d949.webp","original":"https://scriptblox.com/images/sb/0-1773522644513.jpg","scriptblox":"https://scriptblox.com/images/script/0-1773522644513.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2026-03-14T21:10:44.545Z","updatedAt":"2026-03-14T21:10:44.545Z","lastBump":"2026-03-14T21:10:44.545Z","script":"-- Define the game objects\nlocal player = game.Players.LocalPlayer\nlocal foodPlace = game.Workspace.FoodPlace\nlocal tacos = foodPlace.Tacos\nlocal fakeWatch = foodPlace.FakeWatch\nlocal smuggler = game.Workspace.Smuggler\nlocal machine = game.Workspace.Machine\nlocal guy = game.Workspace.Guy\n\n-- Function to pick up items\nlocal function pickUpItem(item)\n    item.Transparency = 0\n    item.CanCollide = false\n    item.Parent = player.Backpack\nend\n\n-- Function to give item to guy\nlocal function giveItem(item)\n    item.Transparency = 0\n    item.CanCollide = false\n    item.Parent = guy.Backpack\nend\n\n-- Function to put item in machine\nlocal function putItemInMachine(item)\n    item.Transparency = 0\n    item.CanCollide = false\n    item.Parent = machine\nend\n\n-- Main loop\nwhile true do\n    -- Pick up tacos and fake watch\n    pickUpItem(tacos)\n    pickUpItem(fakeWatch)\n\n    -- Teleport items to smuggler\n    tacos.CFrame = smuggler.CFrame\n    fakeWatch.CFrame = smuggler.CFrame\n\n    -- Give items to guy\n    giveItem(tacos)\n    giveItem(fakeWatch)\n\n    -- Put items in machine\n    putItemInMachine(tacos)\n    putItemInMachine(fakeWatch)\n\n    -- Wait for a bit\n    wait(5)\nend","features":"Easy auto farm and that's it","tags":[],"discord":"","keyLink":"","owner":{"_id":"69569e648e535dc46ece2505","username":"Zakir_m2","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69569e648e535dc46ece2505","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:34:06.245Z","last":"","win":14,"math":4},"isHub":true,"supportedGames":[{"_id":"699700df63f1c03b3e958bb3","gameId":109872214376771,"placeId":109872214376771,"name":"El Paso, Texas: Border Roleplay","imageUrl":{"url":"https://media.kocakz.me/493adc086edb7ad8700e5620148d0927fab3d6acf0d2bd5fcfacc5e57ba37a4f.webp","original":"https://tr.rbxcdn.com/180DAY-005d83b9d7e20b56c8c5eb26cf298cf7/150/150/Image/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/493adc086edb7ad8700e5620148d0927fab3d6acf0d2bd5fcfacc5e57ba37a4f.webp","original":"https://tr.rbxcdn.com/180DAY-005d83b9d7e20b56c8c5eb26cf298cf7/150/150/Image/Png/noFilter"}}],"changelog":[{"_id":"69b5ced49c5da0f34e54fe0d","editBy":{"_id":"69569e648e535dc46e