{"slug":"Universal-Script-websocket-testing-14634","_id":"667a67a24634d565bff0241b","title":"websocket testing","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/7512103-1719297953963.webp","placeId":0},"features":"websocket tester, echos your username every 2 seconds","tags":[],"script":"local WebSocket = WebSocket.connect(\"wss://echo.websocket.org\") -- Specify your WebSocket URL here.\n\nprint(\"Connected.\")\n\nWebSocket.OnMessage:Connect(function(Msg)\n    print(\"Message: \")\n    print(Msg)\nend)\n\nlocal Ctr = 1\nwhile wait(1) do\n    print(\"Sending your username...\")\n    WebSocket:Send(game.Players.LocalPlayer.Name)\n    Ctr = Ctr + 1\n\n    if Ctr == 5 then \n        print(\"Closing connection...\")\n        WebSocket:Close() -- Close the websocket when you are done! (this is done implicitly on teleports aswell)\n        do return end\n    end\nend\n","owner":{"_id":"65fed24fac98ce459294f1fb","username":"Imperial","verified":true,"profilePicture":"/images/photo/65fed24fac98ce459294f1fb-1716537851558.png","status":"offline","id":"65fed24fac98ce459294f1fb","leaderboard":{"tag":{"kind":"hall","rank":1,"period":"all","metric":"executes","value":13271264}},"topMilestone":{"key":"creator.executions","tier":10000000}},"verified":false,"keyLink":"","views":4583,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-06-25T06:45:54.007Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/7512103-1719297953963.webp","editBy":{"_id":"65fed24fac98ce459294f1fb","username":"Imperial","status":"offline","id":"65fed24fac98ce459294f1fb"},"executes":30,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c5122d","editBy":{"_id":"65fed24fac98ce459294f1fb","username":"Imperial","status":"offline","id":"65fed24fac98ce459294f1fb"},"message":"Create script","createdAt":"2025-03-27T07:25:04.983Z"},{"_id":"685d83a27a50