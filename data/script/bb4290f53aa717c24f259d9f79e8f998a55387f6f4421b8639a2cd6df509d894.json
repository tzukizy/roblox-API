{"slug":"a-dusty-trip-ROCKET-INF-STMIN-12835","_id":"66366c012bfd2871391f120d","title":"INF STMIN","game":{"_id":"67e5e1ffb360710ec3c77d31","gameId":16389395869,"name":"a dusty trip [🐺WOLF]","imageUrl":"/images/sb/rbx-c7bb56c7b813baf35d1a7335ec3e48fd-34b13dc2c04b.png","placeId":16389395869},"features":"Inf stamina for dusty trip","tags":["INF","dusty trip","free"],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\n\nhumanoid:SetAttribute(\"Stamina\", 1) -- 1 is full stamina\nlocal normalWalkSpeed = 10\nlocal runningWalkSpeed = 19.2\n\nlocal function maintainFullStamina()\n    while true do\n        humanoid:SetAttribute(\"Stamina\", 1)\n        wait(0.1)\n    end\nend\n\nlocal function toggleRun(isRunning)\n    if isRunning then\n        humanoid.WalkSpeed = runningWalkSpeed\n    else\n        humanoid.WalkSpeed = normalWalkSpeed\n    end\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then\n        toggleRun(true)\n    end\nend)\n\nUserInputService.InputEnded:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then\n        toggleRun(false)\n    end\nend)\n\ntask.spawn(maintainFullStamina)\n","owner":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","verified":false,"profilePicture":"/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png","status":"offline","id":"64caa76229c6e48e1e6517b2","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":31108,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdA