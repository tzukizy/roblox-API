{"_id":"66366c012bfd2871391f120d","title":"INF STMIN","game":{"_id":"67e5e1ffb360710ec3c77d31","gameId":16389395869,"name":"a dusty trip [🐺WOLF]","imageUrl":{"url":"https://media.kocakz.me/4680057b9d591308d007d360b488d47f40471ea3cf6ac920675281a04488e396.webp","original":"https://tr.rbxcdn.com/180DAY-64b11992ead259f538b037374a3481ac/150/150/Image/Png/noFilter"},"slug":"16389395869-a-dusty-trip","path":"/game/16389395869-a-dusty-trip","thumbnail":{"url":"https://media.kocakz.me/4680057b9d591308d007d360b488d47f40471ea3cf6ac920675281a04488e396.webp","original":"https://tr.rbxcdn.com/180DAY-64b11992ead259f538b037374a3481ac/150/150/Image/Png/noFilter"},"placeId":16389395869},"slug":"a-dusty-trip-ROCKET-INF-STMIN-12835","verified":false,"key":false,"keyless":false,"views":31124,"executes":58,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/255dbf2b1577b19816e5979ecc6a27a7/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/255dbf2b1577b19816e5979ecc6a27a7/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/255dbf2b1577b19816e5979ecc6a27a7/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/255dbf2b1577b19816e5979ecc6a27a7/500/280/Image/Jpeg"},"likeCount":4,"dislikeCount":0,"createdAt":"2024-05-04T17:10:25.950Z","updatedAt":"2024-05-04T17:10:25.950Z","lastBump":"2024-05-04T17:10:25.950Z","script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\n\nhumanoid:SetAttribute(\"Stamina\", 1) -- 1 is full stamina\nlocal normalWalkSpeed = 10\nlocal runningWalkSpeed = 19.2\n\nlocal function maintainFullStamina()\n    while true do\n        humanoid:SetAttribute(\"Stamina\", 1)\n        wait(0.1)\n    end\nend\n\nlocal function toggleRun(isRunning)\n    if isRunning then\n        humanoid.WalkSpeed = runningWalkSpeed\n    else\n        humanoid.WalkSpeed = normalWalkSpeed\n    end\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then\n        toggleRun(true)\n    end\nend)\n\nUserInputService.InputEnded:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then\n        toggleRun(false)\n    end\nend)\n\ntask.spawn(maintainFullStamina)\n","features":"Inf stamina for dusty trip","tags":["INF","dusty trip","free"],"discord":"","keyLink":"","owner":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","verified":false,"profilePicture":{"url":"https://media.kocakz.me/aa4daef6f4804a6fe8345abbeb3e121228200fe1535229158ec1e64d0f5b4ff8.webp","original":"https://scriptblox.com/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png"},"status":"offline","id":"64caa76229c6e48e1e6517b2","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/aa4daef6f4804a6fe8345abbeb3e121228200fe1535229158ec1e64d0f5b4ff8.webp","original":"https://scriptblox.com/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:17:29.018Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50c05","editBy":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","status":"offline","id":"64caa76229c6e48e1e6517b2"},"message":"Create script","createdAt":"2025-03-27T18:33:01.427Z"}],"comments":[{"_id":"66366c829f6b1fc4e4