{"slug":"Examination-Infinite-Stamina-242142","_id":"6a5091bc8fddf2c57938f04f","title":"Infinite Stamina Open Source","game":{"_id":"68718783e35839cbda7d0e98","gameId":10165583746,"name":"Examination","imageUrl":"/images/sb/rbx-a7ec00b4546078d270f35a6e0bd048cb-2a170f0290cb.png","placeId":10165583746},"features":"Makes your stamina impossible to run out xd","tags":["Examination","Stamina"],"script":"local player = game.Players.LocalPlayer\n\nlocal function setup(char)\n    local State = require(char:WaitForChild(\"Client\"):WaitForChild(\"State\"))\n    game:GetService(\"RunService\").Heartbeat:Connect(function()\n        State.stamina.current = 200\n        State.stamina.fullRegen = false\n        State.stamina.regenDelay = 0\n    end)\nend\n\n--doing this so when you die it doesnt resets itself\nif player.Character then setup(player.Character) end\nplayer.CharacterAdded:Connect(setup)","owner":{"_id":"6a43793c3e2fa9b241749d7a","username":"expresso5184","verified":false,"profilePicture":"/images/photo/6a43793c3e2fa9b241749d7a-1782806890557.jpg","status":"offline","id":"6a43793c3e2fa9b241749d7a","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":3503,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-17c81fe0bba2dc36d0245a36701fd5ed-9f340ce3aad9.png","likeCount":2,"dislikeCount":1,"createdAt":"2026-07-10T06:31:24.317Z","keyLink":"","executes":5631,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a5091bc8fddf2c57938f051","editBy":{"_id":"6a43793c3e2fa9b241749d7a","username":"expresso5184","status":"offline","id":"6a43793c3e2fa9b241749d7a"},"message":"Create script","createdAt":"2026-07-10T06:31:24.318Z"}],"comments":[{"_id":"6a5a67f64c0da3940c446321","commentBy":{"_id":"69a7843943eb3299c5ee23d8","username":"Seryozha","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-10-08T09:31:06.576Z",