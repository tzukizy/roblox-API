{"slug":"Examination-Infinite-Stamina-242142","_id":"6a5091bc8fddf2c57938f04f","title":"Infinite Stamina Open Source","game":{"_id":"68718783e35839cbda7d0e98","gameId":10165583746,"name":"Examination","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":10165583746},"features":"Makes your stamina impossible to run out xd","tags":["Examination","Stamina"],"script":"local player = game.Players.LocalPlayer\n\nlocal function setup(char)\n    local State = require(char:WaitForChild(\"Client\"):WaitForChild(\"State\"))\n    game:GetService(\"RunService\").Heartbeat:Connect(function()\n        State.stamina.current = 200\n        State.stamina.fullRegen = false\n        State.stamina.regenDelay = 0\n    end)\nend\n\n--doing this so when you die it doesnt resets itself\nif player.Character then setup(player.Character) end\nplayer.CharacterAdded:Connect(setup)","owner":{"_id":"6a43793c3e2fa9b241749d7a","username":"expresso5184","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/a020f80f163856baf760fc4b1106178d228a79c5889de8241c174d3a22fa59ce.webp","original":"https://scriptblox.com/images/photo/6a43793c3e2fa9b241749d7a-1782806890557.jpg"},"lvl":5,"status":"offline","id":"6a43793c3e2fa9b241749d7a","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/a020f80f163856baf760fc4b1106178d228a79c5889de8241c174d3a22fa59ce.webp","original":"https://scriptblox.com/images/photo/6a43793c3e2fa9b241749d7a-1782806890557.jpg"}},"verified":false,"views":3615,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6962e0b9b82bccf9840dfdc2b9cc01a34f782424f7b558293d92d878b41e3ae8.webp","original":"https://scriptblox.com/images/sb/rbx-17c81fe0bba2dc36d0245a36701fd5ed-9f340ce3aad9.png","scriptblox":"https://scriptblox.com/images/script/rbx-17c81fe