ame.Angles(math.rad(44.462), math.rad(33.002), math.rad(29.049)) * CFrame.new(-1,0,-1)\n\theadweld.C0=CFrame.new(0,1.5,0)\nend\nfunction attack()\n\tif deb==false then\n\t\tknife.knife:Play()\n\t\tcharacter.Humanoid.WalkSpeed = 32\n\t\tdeb=true\n\t\tweldTorso.C0=CFrame.Angles(math.rad(0),math.rad(-90),math.rad(0))\n\t\tleftarmweld.C0=CFrame.new(-1.5,0,0) * CFrame.Angles(math.rad(0),math.rad(-0),math.rad(0))\n\t\theadweld.C0=CFrame.Angles(math.rad(0),math.rad(-90),math.rad(0)) * CFrame.new(0,1.5,0)\n\t\trightarmweld.C0=CFrame.new(1.85,0.5,0) * CFrame.Angles(math.rad(0),math.rad(0),math.rad(90))\n\t\tknifeweld.C0=CFrame.Angles(math.rad(180),math.rad(90),math.rad(0)) * CFrame.new(0,2.5,0)\n\t\twait(1)\n\t\tdeb=false\n\t\tcharacter.Humanoid.WalkSpeed = 8\n\t\tIdle()\n\tend\nend\nfunction taunt()\n\tif deb==false then\n\t\tdeb=true\n\t\tcharacter.Humanoid.WalkSpeed=0\n\t\tlocal leftlegweld = Instance.new(\"Weld\")\n\t\tleftlegweld.Parent=Torso\n\t\tleftlegweld.Part0=Torso\n\t\tleftlegweld.Part1=character[\"Left Leg\"]\n\n\t\tlocal rightlegweld = Instance.new(\"Weld\")\n\t\trightlegweld.Parent=Torso\n\t\trightlegweld.Part0=Torso\n\t\trightlegweld.Part1=character[\"Right Leg\"]\n\t\tmusicx = Instance.new(\"Sound\")\n\t\tmusicx.Parent=character.HumanoidRootPart\n\t\tmusicx.SoundId=\"rbxassetid://130834939\"\n\t\tmusicx.Volume=2\n\t\tmusicx:Play()\n\t\tmusicx.Played:Connect(function()\n\t\t\tmusicx:Destroy()\n\t\tend)\n\t\tfor i = 1,9 do\n\t\t\tweldTorso.C0=CFrame.Angles(0,0,0)\n\t\t\tknifeweld.C0=CFrame.Angles(53.5,0,0) * CFrame.new(0,1.5,0)\n\t\t\trightarmweld.C0=CFrame.Angles(90,0,0) * CFrame.new(1.5,-1,-0.5)\n\t\t\tleftarmweld.C0=CFrame.Angles(0,0,0) * CFrame.new(-1.5,0,0)\n\t\t\theadweld.C0=CFrame.Angles(0,0,0) * CFrame.new(0,1.5,0)\n\t\t\tleftlegweld.C0=CFrame.Angles(-90,0,0) * CFrame.new(0.5,2,0)\n\t\t\trightlegweld.C0=CFrame.Angles(0,0,0) * CFrame.new(-0.5,-2,0)\n\t\t\twait(0.2)\n\t\t\tweldTorso.C0=CFrame.Angles(0,0,0)\n\t\t\tknifeweld.C0=CFrame.Angles(53.5,0,0) * CFrame.new(0,1.5,0)\n\t\t\trightarmweld.C0=CFrame.Angles(0,0,0) * CFrame.new(1.5,0,0)\n\t\t\tleftarmweld.C0=CFrame.Angles(90,0,0) * CFrame.new(-1.5,-1,-0.5)\n\t\t\tleftlegweld.C0=CFrame.Angles(0,0,0) * CFrame.new(0.5,-2,0)\n\t\t\trightlegweld.C0=CFrame.Angles(-90,0,0) * CFrame.new(-0.5,2,0)\n\t\t\theadweld.C0=CFrame.Angles(0,0,0) * CFrame.new(0,1.5,0)\n\t\t\twait(0.2)\n\t\tend\n\t\tcharacter.Humanoid.WalkSpeed=8\n\t\trightlegweld:Destroy()\n\t\tleftlegweld:Destroy()\n\t\tIdle()\n\t\tdeb=false\n\tend\nend\nknife.Touched:Connect(function(plrwhotouched)\n\tif deb == true then\n\t\tlocal character = plrwhotouched.Parent\n\t\tlocal humanoid = character:FindFirstChildWhichIsA(\"Humanoid\")\n\t\tif humanoid and humanoid.Health > 0 then\n\t\t\thumanoid.Health -= damage\n\t\t\tknife.blood:Play()\n\t\t\tlocal rootPart = character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif rootPart then\n\t\t\t\tlocal existingSound = rootPart:FindFirstChild(\"Scream\")\n\t\t\t\tif not existingSound then\n\t\t\t\t\tlocal sound = Instance.new(\"Sound\")\n\t\t\t\t\tsound.Name = \"Scream\"\n\t\t\t\t\tsound.Parent = rootPart\n\t\t\t\t\tsound.Volume = 1\n\t\t\t\t\tsound.SoundId = \"http://www.roblox.com/asset/?id=111896685\"\n\t\t\t\t\tsound.RollOffMaxDistance = 1000\n\t\t\t\t\tsound.RollOffMinDistance = 2\n\t\t\t\t\tsound.Ended:Connect(function()\n\t\t\t\t\t\tsound:Destroy()\n\t\t\t\t\tend)\n\t\t\t\t\tsound:Play()\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend)\n\n--███╗░░░███╗░█████╗░██╗███╗░░██╗\n--████╗░████║██╔══██╗██║████╗░██║\n--██╔████╔██║███████║██║██╔██╗██║\n--██║╚██╔╝██║██╔══██║██║██║╚████║\n--██║░╚═╝░██║██║░░██║██║██║░╚███║\n--╚═╝░░░░░╚═╝╚═╝░░╚═╝╚═╝╚═╝░░╚══╝\nknife.Parent=character\nIdle()\nkeyboardservice.InputBegan:Connect(function(input, gameProcessed)\n\tif input.UserInputType == Enum.UserInputType.MouseButton1 and not gameProcessed then\n\t\tattack()\n\tend\nend)\ngame:GetService(\"UserInputService\").InputBegan:Connect(function(input, gameProcessed)\n\tif not gameProcessed then\n\t