{"slug":"Minecraft-Nuker-165559","_id":"69c9ab431cc83da1842460a0","title":"Nuker","game":{"_id":"6981fe1010146ba1ee1ab80f","gameId":102019850130872,"name":"Minecraft","imageUrl":{"url":"https://cdn.kocakz.me/images/e34f8c448c0e7f0ec6b7a985e210348ba5c2ab202e5950e63db7216cb958c955.webp","original":"https://tr.rbxcdn.com/180DAY-a17918617b20ac9c39b305241f23e58a/480/270/UnapprovedImage/Png/noFilter"},"thumbnail":{"url":"https://cdn.kocakz.me/images/e34f8c448c0e7f0ec6b7a985e210348ba5c2ab202e5950e63db7216cb958c955.webp","original":"https://tr.rbxcdn.com/180DAY-a17918617b20ac9c39b305241f23e58a/480/270/UnapprovedImage/Png/noFilter"},"placeId":102019850130872},"features":"Basically an open source nuker, you need a good executer otherwise it wont work. Already had complaints. Breaks everything near you!","tags":[],"script":"-- should work on your executer if not then try to fix it yourself, I left it open source.\n-- breaks any blocks within a 5 by 5 block radius\nlocal rs = game:GetService(\"RunService\")\nlocal ws = game:GetService(\"Workspace\")\nlocal ps = game:GetService(\"Players\")\nlocal liberal = game:GetService(\"ReplicatedStorage\").Libs\nlocal sys = game:GetService(\"ReplicatedStorage\").Systems\nlocal m_Coord = require(liberal.Coordinates)\nlocal m_Act = require(sys.ActionsSystem)\nlocal m_State = require(liberal.BlockState)\nlocal larp = ps.LocalPlayer\nlocal map = ws:FindFirstChild(\"Map\")\nlocal rad, wait = 5, 0.001\n\nlocal function nuker()\n    local root = larp.Character and larp.Character:FindFirstChild(\"HumanoidRootPart\")\n    if not root or not map then return end\n    local p_list = ws:GetPartBoundsInRadius(root.Position, rad * 4)\n    for i = 1, #p_list do\n        local p = p_list[i]\n        if not p or not p:IsDescendantOf(map) then continue end\n        local attr = p:GetAttribute(m_State.ATTRIBUTE)\n        if not attr then continue end\n        local ok, pos = pcall(m_Coord.coordinatesFromWorkspaceVector3, p.Position)\n        if not ok or not pos then continue end\n        local r, ch, bn = m_Coord.regionNameFromCoordinates(pos), m_Coord.chunkNameFromCoordinates(pos), m_Coord.blockNameFromCoordinates(pos)\n        if r and ch and bn then\n            task.spawn(m_Act.client_breakBlock, r, ch, bn, m_State.getBlockId(attr) or 1)\n            if i % 2 == 0 then task.wait(wait) end\n        end\n    end\nend\n\ntask.spawn(function()\n    while true do\n        nuker()\n        rs.Heartbeat:Wait()\n    end\nend)","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"verified":false,"views":1854,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-f0d9225d5a028d5ee28988bde6d4ff1b-9a757ef4fe49.png","scriptblox":"https://scriptblox.com/images/script/rbx-f0d9225d5a028d5ee28988bde6d4ff1b-9a757ef4fe49.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2026-03-29T22:44:19.276Z","keyLink":"","executes":22,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:19:46.036Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-f0d9225d5a028d5ee28988bde6d4ff1b-9a757ef4fe49