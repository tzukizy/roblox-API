{"_id":"66f47fef9610383ee9785812","title":"OpenSource OP Script","game":{"_id":"67e5e1ffb360710ec3c789a4","gameId":18662027332,"name":"Toilet Defense RNG","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"18662027332-toilet-defense-rng","path":"/game/18662027332-toilet-defense-rng","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":18662027332},"slug":"Toilet-Defense-RNG-OpenSource-19003","verified":false,"key":false,"keyless":false,"views":28683,"executes":57,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/69e5c298847f55a2c7ec8e2ad1ebb26403a460acf4e3d106cc68b4a058ec36b4.webp","original":"https://scriptblox.com/images/sb/18662027332-1727299567123.png","scriptblox":"https://scriptblox.com/images/script/18662027332-1727299567123.png"},"thumbnail":{"url":"https://media.kocakz.me/69e5c298847f55a2c7ec8e2ad1ebb26403a460acf4e3d106cc68b4a058ec36b4.webp","original":"https://scriptblox.com/images/sb/18662027332-1727299567123.png","scriptblox":"https://scriptblox.com/images/script/18662027332-1727299567123.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2024-09-25T21:26:07.180Z","updatedAt":"2024-09-25T21:26:07.180Z","lastBump":"2024-09-25T21:26:07.180Z","script":"_G.x = 1000000\n---Delete Unit\nspawn(function()\n    while wait() do\n        for i,v in pairs(game:GetService(\"Players\").LocalPlayer.PlayerGui.UnitBagGui.main.Left:GetChildren()) do\n            if v:FindFirstChild(\"Button\") then\n                a = v.Button.Rarity.Text\n                if a:find(\"1/\") then\n                    a = a:gsub(\"1/\",\"\")\n                end\n                if tonumber(a) < _G.x then\n                    local args = {\n                        [1] = \"client_del_unit\",\n                        [2] = {\n                            [\"1\"] = {\n                                [\"1\"] = tonumber(v.Name)\n                            }\n                        }\n                    }\n    \n                    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteFunction\"):InvokeServer(unpack(args))\n                end\n            end\n        end\n    end\nend)\n---Auto Roll\nspawn(function()\n    while wait() do\n        local args = {\n            [1] = \"client_get_roll_item\",\n            [2] = {}\n        }\n    \n        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteFunction\"):InvokeServer(unpack(args))\n        wait()\n        local args = {\n            [1] = \"put_in_unit_backpack\",\n            [2] = {}\n        }\n    \n        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteFunction\"):InvokeServer(unpack(args))\n    end\nend)\n---Collect Drop\nspawn(function()\n    while wait() do\n        for i,v in pairs(workspace.scene_drop:GetChildren()) do\n            v:SetPrimaryPartCFrame(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame)\n        end\n    end\nend)\n","features":"Auto Roll\nCollect Drop\nAuto Delete Unit (lower x)","tags":[],"discord":"","keyLink":"","owner":{"_id":"64edd7a9d344347e09644fae","username":"DragonZ_TH","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8be9c75fcb28a91610b40f71ca3de0a084f3bfc3acce8b9100166ebbd01bc616.webp","original":"https://scriptblox.com/images/photo/64edd7a9d344347e09644fae-1727299711284.jpg"},"status":"offline","id":"64edd7a9d344347e09644fae","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/8be9c75fcb28a91610b40f71ca3de0a084f3bfc3acce8b9100166ebbd01bc616.webp","original":"https://scriptblox.com/images/photo/64edd7a9d344347e09644fae-1727299711284.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:14:19.340Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[