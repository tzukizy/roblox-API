{"_id":"69002247bb64f2b82a00b2b5","title":"God Mode kinda","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://media.kocakz.me/4d971323d4e760c0ab14aa8b1d4cf37289a279ff54af135ecbeaeb6cf138497b.webp","original":"https://tr.rbxcdn.com/180DAY-fee67c1f98361eac15c13f80b03592ae/150/150/Image/Png/noFilter"},"slug":"155615604-prison-life","path":"/game/155615604-prison-life","thumbnail":{"url":"https://media.kocakz.me/4d971323d4e760c0ab14aa8b1d4cf37289a279ff54af135ecbeaeb6cf138497b.webp","original":"https://tr.rbxcdn.com/180DAY-fee67c1f98361eac15c13f80b03592ae/150/150/Image/Png/noFilter"},"placeId":155615604},"slug":"Prison-Life-God-Mode-61341","verified":true,"key":false,"keyless":false,"views":12518,"executes":167,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/0a4b821499ff5d38712d79faacacda3c1be7b7a1711fe5e9f2c7391c64844e56.webp","original":"https://scriptblox.com/images/sb/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png","scriptblox":"https://scriptblox.com/images/script/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png"},"thumbnail":{"url":"https://media.kocakz.me/0a4b821499ff5d38712d79faacacda3c1be7b7a1711fe5e9f2c7391c64844e56.webp","original":"https://scriptblox.com/images/sb/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png","scriptblox":"https://scriptblox.com/images/script/rbx-3c69710523b585b62f53aa0d4c6c32ed-91cb0c4f82c5.png"},"likeCount":5,"dislikeCount":0,"createdAt":"2025-10-28T01:54:15.472Z","updatedAt":"2025-10-28T01:54:15.472Z","lastBump":"2025-10-28T01:54:15.472Z","script":"local RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal PlayerTased = ReplicatedStorage.GunRemotes.PlayerTased\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character\nlocal Camera = workspace.Camera\nlocal CamCFrame = Camera.CFrame\n\nlocal Teams = game:GetService(\"Teams\")\nlocal TeamEvent = workspace:WaitForChild(\"Remote\"):WaitForChild(\"TeamEvent\")\n\nlocal TeamAPI = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/tomatotxt/Prison-Life/refs/heads/main/teamapi.luau\"))()\n-- Teams table\n-- ChangeTeam, and CanQuickRespawn functions\n\n-- Anti-TASE\nlocal FakePlayerTased = PlayerTased:Clone()\nFakePlayerTased.Parent = PlayerTased.Parent\nPlayerTased:Destroy()\n\nlocal function Teleport(TargetCFrame, Character)\n    CamCFrame = Camera.CFrame\n    if not Character then Character = LocalPlayer.Character end\n    if Character and Character:FindFirstChild(\"Humanoid\") then\n        Character.Humanoid:ChangeState(Enum.HumanoidStateType.Dead)\n        Character.Humanoid.Name = \"Valid\"\n    end\n    local RootPart\n    local OnRespawn\n    OnRespawn = LocalPlayer.CharacterAdded:Connect(function(Character)\n        RootPart = Character:WaitForChild(\"HumanoidRootPart\")\n        RootPart.CFrame = TargetCFrame\n        print(\"Teleport Success!\")\n        OnRespawn:Disconnect()\n    end)\n    LocalPlayer.CharacterAdded:wait()\n    repeat task.wait() until RootPart and (RootPart.Position - TargetCFrame.Position).Magnitude < 1\nend\n\nlocal CrimBase = CFrame.new(-927, 94, 2055)\nlocal Yard = CFrame.new(832, 98, 2510)\n\nlocal Count = 0\nlocal function CountTP()\n    Count += 1\n    print(\"Teleport #\", Count)\nend\nlocal Once = false\nlocal function QuickSetup(Character)\n    local Humanoid = Character:WaitForChild(\"Humanoid\")\n    local Connect\n    Connect = Humanoid.Died:Connect(function()\n        if TeamAPI.CanQuickRespawn() then\n            print(\"Using Quick Respawn\")\n            TeamAPI.ChangeTeam(LocalPlayer.Team)\n        end\n        Connect:Disconnect()\n    end)\n    task.wait(5)\n    if LocalPlayer.Team == Teams.Criminals then\n        repeat task.wait() until not LocalPlayer.Character:FindFirstChild(\"ForceField\")\n        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Dead)\n        print(\"Anti-Arrest killed you!\")\n    end\nend\ntask.spawn(QuickSetup, LocalPlayer.Character)\nLocalPlayer.CharacterAdded:Connect(QuickSetup)\n\nLocalPlayer.CharacterRemoving:Connect(function(Character)\n    if Character.Humanoid.Name ~= \"Valid\" then\n        Teleport(Character.HumanoidRootPart.CFrame, Character)\n        task.wait()\n        Camera.CFrame = CamCFrame\n        print(\"Since you died I felt the need to put you back.\")\n    end\nend)\n\nlocal function JapaDo()\n    LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Dead)\n    print(\"JapaDo'ed\")\nend\n\nlocal Status = LocalPlayer.Status\nlocal isArrested = Status.isArrested\nRunService.Heartbeat:Connect(function()\n    if isArrested.Value == true then\n        JapaDo()\n    end\nend)\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/tomatotxt/Prison-Life/refs/heads/main/autoguns.luau\"))()\nTeamAPI.ChangeTeam(TeamAPI.Teams.Criminals)\nlocal Humanoid = LocalPlayer.Character:WaitForChild(\"Humanoid\")\nHumanoid:ChangeState(Enum.HumanoidStateType.Dead)","features":"Makes you immune to Damage, Arrest, and Tase\nAutomatically gives you AK-47, and Remington 870.\n\n\n\n\nNo you cannot get rid of this caveat.\nCaveat: You respawn every 10 seconds.","tags":["god mode","res*","prison","life","hub"],"discord":"","keyLink":"","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11050721}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1