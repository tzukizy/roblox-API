{"_id":"6969ca85ce7e338b9dbbdf06","title":"Universal Speed Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/94c1019318923e23e031856747f1751993f0c32caa5e312d54a0eb0a2ac7aed3.webp","original":"https://scriptblox.com/images/sb/0-1768540805503.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/94c1019318923e23e031856747f1751993f0c32caa5e312d54a0eb0a2ac7aed3.webp","original":"https://scriptblox.com/images/sb/0-1768540805503.png"},"placeId":0},"slug":"Universal-Script-Universal-Speed-Script-86327","verified":false,"key":false,"keyless":false,"views":2504,"executes":17068,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6dbb94c3960a2cc47c241f4417da079d40868c3802f22cc5d3110931c8c94683.webp","original":"https://scriptblox.com/images/sb/0-1768540805503.png","scriptblox":"https://scriptblox.com/images/script/0-1768540805503.png"},"thumbnail":{"url":"https://media.kocakz.me/6dbb94c3960a2cc47c241f4417da079d40868c3802f22cc5d3110931c8c94683.webp","original":"https://scriptblox.com/images/sb/0-1768540805503.png","scriptblox":"https://scriptblox.com/images/script/0-1768540805503.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-16T05:20:05.528Z","updatedAt":"2026-01-16T05:20:05.528Z","lastBump":"2026-01-16T05:20:05.528Z","script":"-- Created By Stormzy\n-- Works on most games (bypass-dependent)\n\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\n-- Set walkspeed (100-etc)\n-- For game bypasses don't go above 75 - 100\nlocal NEW_SPEED = 50\n\nlocal function setWalkSpeed(speed)\n    if Humanoid then\n        Humanoid.WalkSpeed = speed\n    end\nend\n\nsetWalkSpeed(NEW_SPEED)\n\nLocalPlayer.CharacterAdded:Connect(function(newChar)\n    Character = newChar\n    Humanoid = Character:WaitForChild(\"Humanoid\")\n    setWalkSpeed(NEW_SPEED)\nend)\n\n-- Constantly enforces speed (bypasses most anticheats with disables and variables)\nspawn(function()\n    while true do\n        if Humanoid and Humanoid.Parent then\n            Humanoid.WalkSpeed = NEW_SPEED\n        end\n        wait(0.1) -- If you're experiencing delays, you can change this. (performance based)\n    end\nend)\n\nprint(\"WalkSpeed set to \" .. NEW_SPEED .. \" | Script loaded successfully!\")\n\n-- Script by Stormzy, open source to use, enjoy!","features":"**WALKSPEED SCRIPT**\n\nThis is a universal Roblox speed script I just made up.\nYou can use it for whatever, works on most games, will add a bypass for certain games of your choice, just comment whatever you'd like.","tags":["Universal","No Key","Open Source","Free To Use"],"discord":"https://discord.gg/6Gqf8cKE","keyLink":"","owner":{"_id":"690c1482a7ddf5f6c323635d","username":"Stormzy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"690c1482a7ddf5f6c323635d","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:43:16.072Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6969ca85ce7e338b9dbbdf09","editBy":{"_id":"690c1482a7ddf5f6c323635d","username":"Stormzy","status":"offline","id":"690c1482a7ddf5f6c323635d"},"message":"Create Script","createdAt":"2026-01-16T05:20:05.530Z"},{"_id":"6969cbaf877302493fd5ffbb","editBy":{"_id":"690c1482a7ddf5f6c323635d","username":"Stormzy","status":"offline","id":"690c1482a7ddf5f6c323635d"},"message":"Update script","createdAt":"2026-01-16T05:25:03.602Z"}],"comments":[{"_id":"6969