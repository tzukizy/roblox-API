{"slug":"Blood-Debt-COMPLIANCE-No-recoil-246014","_id":"6a686c8321e47a8ad4b1530c","title":"No recoil","game":{"_id":"67eacb40359379244cdf8643","gameId":139252529145498,"name":"Blood Debt [COMPLIANCE]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":139252529145498},"features":"If B is pressed, it'll disable recoil. If pressed again, re-enables recoil\n\nRequires run on actor and get actors [will not work on Xeno/Solara]\n\nWorks on Madium","tags":["blood debt","casim","ital","no recoil"],"script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal localPlayer = Players.LocalPlayer\nlocal isModified = true\nlocal function getActiveActors()\n    local actors = {}\n    local function searchContainer(container)\n        if not container then return end\n        for _, obj in ipairs(container:GetDescendants()) do\n            if obj:IsA(\"Actor\") and obj:FindFirstChild(\"weap_cl\", true) then\n                table.insert(actors, obj)\n            end\n        end\n    end\n    if localPlayer.Character then\n        searchContainer(localPlayer.Character)\n    end\n    searchContainer(localPlayer:FindFirstChild(\"Backpack\"))\n    if #actors == 0 then\n        if getactors then\n            for _, actor in ipairs(getactors()) do\n                if actor:FindFirstChild(\"weap_cl\", true) then\n                    table.insert(actors, actor)\n                end\n            end\n        else\n            searchContainer(workspace)\n        end\n    end\n    return actors\nend\nlocal function runInjection()\n    local recoilScale = isModified and 0 or 1\n    local disableAnims = isModified\nlocal scriptCode = string.format([[\n        local RECOIL_SCALE = %f\n        local DISABLE_ANIMS = %s\n        local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n        \n        local success, sharedLib = pcall(function()\n            return require(ReplicatedStorage.gun_res.lib.shared)\n        end)\n        \n        if success and sharedLib and sharedLib.getStat then\n            \n            -- FIX: Store the old function and states directly inside the module table, avoiding _G entirely.\n            if not sharedLib._oldGetStat then\n                sharedLib._oldGetStat = sharedLib.getStat\n                \n                sharedLib.getStat = function(p1, p2, ...)\n                    -- Call the old function from the table reference\n                    local result = sharedLib._oldGetStat(p1, p2, ...)\n                    \n                    if p2 == \"mult\" or p2 == \"recoilMult\" then\n                        if type(result) == \"number\" then\n                            return result * sharedLib._RECOIL_SCALE\n                        end\n                    end\n                    \n                    if sharedLib._DISABLE_ANIMS and (p2 == \"fire\" or p2 == \"adsFire\" or p2 == \"Stockedfire\") then\n                        return \"\" \n                    end\n                    \n                    return result\n                end\n            end\n            \n            -- Update the state inside the table so the hook can read it dynamically\n            sharedLib._RECOIL_SCALE = RECOIL_SCALE\n            sharedLib._DISABLE_ANIMS = DISABLE_ANIMS\n            \n            print(\"[Actor VM] Updated! Recoil Scale: \" .. tostring(RECOIL_SCALE) .. \" | Disable Fire Anims: \" .. tostring(DISABLE_ANIMS))\n        end\n    ]], recoilScale, tostring(disableAnims))\n    local actors = getActiveActors()\n    local injectedCount = 0\n    for _, actor in ipairs(actors) do\n        if actor and actor.Parent then\n            pcall(function()\n                runonactor(actor, scriptCode)\n                injectedCount = injectedCount + 1\n            end)\n        end\n    end\n    if injectedCount > 0 then\n        print(string.format(\"[Injector] Successfully updated %d weapon Actor(s) | State -> Recoil: %s, Anims Disabled: %s\", \n            injectedCount, tostring(recoilScale), tostring(disableAnims)))\n    else\n        warn(\"[Injector] No active weapon Actors found. Equip a weapon first.\")\n    end\nend\nrunInjection()\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if not gameProcessed and input.KeyCode == Enum.KeyCode.B then\n        -- Toggle the state\n        isModified = not isModified\n        print(string.format(\"\\n[Keybind] 'B' pressed, Toggling weapon state to: [Recoil Enabled: %s]\", tostring(not isModified)))\n        runInjection()\n    end\nend)\nlocalPlayer.CharacterAdded:Connect(function(char)\n    task.wait(1)\n    runInjection()\nend)","owner":{"_id":"66c05f2f6a1b93c539ff3c80","username":"janakiikar","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"lvl":7,"status":"offline","id":"66c05f2f6a1b93c539ff3c80","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":3073,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8a93894c72c45a38d3124edeaf2ecfad99e8d56d9254514066989a7e1bee76a2.webp","original":"https://scriptblox.com/images/sb/rbx-953683f072155b207a08508e2e885c52-d22a4200546e.png","scriptblox":"https://scriptblox.com/images/script/rbx-953683f072155b207a08508e2e885c52-d22a4200546e.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-07-28T08:46:59.880Z","editBy":{"_id":"66c05f2f6a1b93c539ff3c80","username":"janakiikar","status":"offline","id":"66c05f2f6a1b93c539ff3c80"},"keyLink":"","executes":1898,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:12:4