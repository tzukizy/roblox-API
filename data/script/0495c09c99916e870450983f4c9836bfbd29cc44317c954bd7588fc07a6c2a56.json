{"slug":"Legends-Of-Speed-What-Quests-are-Today-43953","_id":"68684ff42c51773915a339a0","title":"What Quests are Today","game":{"_id":"67e5e1ffb360710ec3c77d9a","gameId":3101667897,"name":"Legends Of Speed ⚡","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":3101667897},"features":"Says what quests are today.  (works EVERY DAY!!)","tags":[],"script":"-- ^^ Made by BigBoyTimme ^^ --\n\nlocal function getCurrentDay()\n\tlocal currentDay = os.date(\"*t\").wday\n\tlocal daysOfWeek = {\n\t\t[1] = \"Sunday\",\n\t\t[2] = \"Monday\",\n\t\t[3] = \"Tuesday\",\n\t\t[4] = \"Wednesday\",\n\t\t[5] = \"Thursday\",\n\t\t[6] = \"Friday\",\n\t\t[7] = \"Saturday\",\n\t}\n\treturn daysOfWeek[currentDay] or \"Unknown\"\nend\nlocal day = getCurrentDay()\nlocal questsFolder = game.ReplicatedStorage.Quests[\"Daily Quests\"]:WaitForChild(day)\nif questsFolder then\n    print(\"\\n\\n Quests today\", \"(\" .. day .. \"):\\n\")\n\tfor _, child in ipairs(questsFolder:GetChildren()) do\n\t\tprint(\"#\", child.Name)\n\tend\nend","owner":{"_id":"684cabd90f380c18ee3d7a59","username":"ScriptbloxTermedMe","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/dd5b83b147d3877c4815ff6f2ab18f092456a9b1f1edcf6e7e3c6e4b76df7f86.webp","original":"https://scriptblox.com/images/photo/684cabd90f380c18ee3d7a59-1749855326751.jpg"},"status":"offline","id":"684cabd90f380c18ee3d7a59","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/dd5b83b147d3877c4815ff6f2ab18f092456a9b1f1edcf6e7e3c6e4b76df7f86.webp","original":"https://scriptblox.com/images/photo/684cabd90f380c18ee3d7a59-1749855326751.jpg"}},"verified":false,"views":2909,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/ee6ca59fde06bc7b23602f5d5a2ca0afd127e699def02f142df7563c61d55e98.webp","original":"https