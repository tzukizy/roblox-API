{"slug":"Legends-Of-Speed-What-Quests-are-Today-43953","_id":"68684ff42c51773915a339a0","title":"What Quests are Today","game":{"_id":"67e5e1ffb360710ec3c77d9a","gameId":3101667897,"name":"Legends Of Speed ⚡","imageUrl":"/images/sb/rbx-2c0b08602ee3b90d10ec04723b0ee011-da49be6fe690.png","placeId":3101667897},"features":"Says what quests are today.  (works EVERY DAY!!)","tags":[],"script":"-- ^^ Made by BigBoyTimme ^^ --\n\nlocal function getCurrentDay()\n\tlocal currentDay = os.date(\"*t\").wday\n\tlocal daysOfWeek = {\n\t\t[1] = \"Sunday\",\n\t\t[2] = \"Monday\",\n\t\t[3] = \"Tuesday\",\n\t\t[4] = \"Wednesday\",\n\t\t[5] = \"Thursday\",\n\t\t[6] = \"Friday\",\n\t\t[7] = \"Saturday\",\n\t}\n\treturn daysOfWeek[currentDay] or \"Unknown\"\nend\nlocal day = getCurrentDay()\nlocal questsFolder = game.ReplicatedStorage.Quests[\"Daily Quests\"]:WaitForChild(day)\nif questsFolder then\n    print(\"\\n\\n Quests today\", \"(\" .. day .. \"):\\n\")\n\tfor _, child in ipairs(questsFolder:GetChildren()) do\n\t\tprint(\"#\", child.Name)\n\tend\nend","owner":{"_id":"684cabd90f380c18ee3d7a59","username":"ScriptbloxTermedMe","verified":false,"profilePicture":"/images/photo/684cabd90f380c18ee3d7a59-1749855326751.jpg","status":"offline","id":"684cabd90f380c18ee3d7a59","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":2907,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-2bb5d054c74276ef8865f64d7d550c9f-20d337194dfe.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-07-04T22:04:36.148Z","executes":9,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68684ff42c51773915a339a2","editBy":{"_id":"684cabd90f380c18ee3d7a59","username":"ScriptbloxTermedMe","status":"offline","id":"684cabd90f380c18ee3d7a59"},"message":"Create script","createdAt":"2025-07-04T22:04:36.150Z"}],"comments":[{"_id":"68686d52fff90ed807e274bd","commentBy":{"_id":"628d7f7fa30903ff69051