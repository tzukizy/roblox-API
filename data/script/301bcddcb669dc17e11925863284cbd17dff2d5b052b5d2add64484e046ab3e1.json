{"slug":"NEW-MAP-+-MENU-Michael's-Zombies-KILL-AURA-5494","_id":"6315039f0526459cecaa9fc3","title":"KILL AURA","game":{"_id":"67e5e1ffb360710ec3c784b1","gameId":8054462345,"name":"Michael's Zombies","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":8054462345},"features":"kill aura, that's all, lol!\n(the entire script is not mine, original post {i guess}: https://v3rmillion.net/showthread.php?tid=1186588)","tags":["Zombies","Kill Aura","Ez","Shooter","Hack"],"script":"local LocalPlayer = game.Players.LocalPlayer\n\ngetgenv().run_loopy_pls2 = true\n\nfunction is_within_distance(zombie, dist)\n    if zombie:FindFirstChild(\"HumanoidRootPart\") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then\n        return (LocalPlayer.Character.HumanoidRootPart.Position - zombie.HumanoidRootPart.Position).Magnitude <= (dist or 30)\n    end\n    return false\nend\n\n\nwhile task.wait(.1) and run_loopy_pls2 do\n    for i,v in pairs(workspace.Ignore.Zombies:GetChildren()) do\n        if v and v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"HumanoidRootPart\") and is_within_distance(v, 80) then\n            game:GetService(\"ReplicatedStorage\").Framework.Remotes.KnifeHitbox:FireServer(v.Humanoid)\n        end\n    end\nend","owner":{"_id":"62ebcf8c74e75bac065308da","username":"themothersabuser","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/62ebcf8c74e75bac065308da-1659621464673.png"},"lvl":6,"status":"offline","id":"62ebcf8c74e75bac065308da","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/62ebcf8c74e75bac065308da-1659621464673.png"}},"verified":false,"views":13759,"scriptType":"free","isUniversal":false,"isPatche