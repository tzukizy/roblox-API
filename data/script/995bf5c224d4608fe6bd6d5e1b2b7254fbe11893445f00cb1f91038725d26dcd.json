{"slug":"KJ-The-Strongest-Battlegrounds-Tsb-custom-moveset-script-27099","_id":"678bccba39bb70594333040c","title":"Tsb custom moveset script","game":{"_id":"67e5e1ffb360710ec3c77d29","gameId":10449761463,"name":"The Strongest Battlegrounds","imageUrl":"/images/sb/rbx-c947df5b221c30672c3591247a8c6495-d88fb8427541.png","placeId":10449761463},"features":"Tsb custom moveset","tags":[],"script":"local weapon = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/softbf395/Utilities/refs/heads/main/TSB/Custom%20Weapon.lua\"))()\n-- remove all moves\nfor _, move in ipairs(game.Players.LocalPlayer.Backpack:GetChildren()) do\n  move:Destroy()\nend\n\n-- Create a move\nlocal Weapon1 = weapon:Create({\n    name = \"Example\";\n    cooldown = 3;\n    action = function()\n        local mouse=game.Players.LocalPlayer:GetMouse()\n        game.Players.LocalPlayer.Character.HumanoidRootPart.Position=mouse.Hit.Position+Vector3.new(0,2,0)\n    end\n})\n\n-- Modify the action later\n--Weapon1:SetCallback(function()\n--    print(\"new use example\")\n--end)","owner":{"_id":"6745a2eb8c9493d6f5190fc2","username":"RazaAce","verified":false,"profilePicture":"/images/photo/6745a2eb8c9493d6f5190fc2-1737215823043.png","status":"offline","id":"6745a2eb8c9493d6f5190fc2","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":13614,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-18T15:46:02.788Z","dislikeCount":2,"likeCount":0,"image":"https://tr.rbxcdn.com/180DAY-a13fa7fa734f7c261477edfc15ef3271/500/280/Image/Jpeg/noFilter","executes":133,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54362","editBy":{"_id":"6745a2eb8c9493d6f5190fc2","username":"RazaAce","status":"offline","id":"6745a2eb8c9493d6f5190fc2"},"message":"Create script","createdAt":"2025-03-27T22:22:22.401Z"}],"comments":[{"_id":"6939e22b8ca0397aaf8281a7","commentBy":{"