{"_id":"687dd3b0c459aedc73fac747","title":"Ayush hub touch to see part name","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/0486eb5211bd145d48fd5d320e4c7fddff005a174b47d3a91485420355c3fb8d.webp","original":"https://scriptblox.com/images/sb/0-1753076655992.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/0486eb5211bd145d48fd5d320e4c7fddff005a174b47d3a91485420355c3fb8d.webp","original":"https://scriptblox.com/images/sb/0-1753076655992.png"},"placeId":0},"slug":"Universal-Script-Ayush-hub-touch-to-see-part-name-45694","verified":false,"key":false,"keyless":false,"views":1554,"executes":165,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/38d9f0a9c012e8fe54a724c30d57e2ff047e3f8bf6033088c17a29d6771332c9.webp","original":"https://scriptblox.com/images/sb/0-1753076655992.png","scriptblox":"https://scriptblox.com/images/script/0-1753076655992.png"},"thumbnail":{"url":"https://media.kocakz.me/38d9f0a9c012e8fe54a724c30d57e2ff047e3f8bf6033088c17a29d6771332c9.webp","original":"https://scriptblox.com/images/sb/0-1753076655992.png","scriptblox":"https://scriptblox.com/images/script/0-1753076655992.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-07-21T05:44:16.074Z","updatedAt":"2025-07-21T05:44:16.074Z","lastBump":"2025-07-21T05:44:16.074Z","script":"-- Services\nlocal Players = game:GetService(\"Players\")\nlocal UIS = game:GetService(\"UserInputService\")\nlocal LocalPlayer = Players.LocalPlayer\n\n-- GUI\nlocal ScreenGui = Instance.new(\"ScreenGui\", LocalPlayer:WaitForChild(\"PlayerGui\"))\nScreenGui.Name = \"TouchNameGUI\"\nScreenGui.ResetOnSpawn = false\n\nlocal Frame = Instance.new(\"Frame\", ScreenGui)\nFrame.Size = UDim2.new(0, 200, 0, 100)\nFrame.Position = UDim2.new(0.4, 0, 0.4, 0)\nFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)\nFrame.Active = true\nFrame.Draggable = true\n\n-- Toggle Button\nlocal ToggleBtn = Instance.new(\"TextButton\", Frame)\nToggleBtn.Size = UDim2.new(1, 0, 0.4, 0)\nToggleBtn.Position = UDim2.new(0, 0, 0, 0)\nToggleBtn.Text = \"🟢 ON\"\nToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\nToggleBtn.TextColor3 = Color3.new(1, 1, 1)\nToggleBtn.Font = Enum.Font.SourceSansBold\nToggleBtn.TextScaled = true\n\n-- Label\nlocal InfoLabel = Instance.new(\"TextLabel\", Frame)\nInfoLabel.Size = UDim2.new(1, 0, 0.6, 0)\nInfoLabel.Position = UDim2.new(0, 0, 0.4, 0)\nInfoLabel.Text = \"Touch part to get name\"\nInfoLabel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nInfoLabel.TextColor3 = Color3.new(1, 1, 1)\nInfoLabel.Font = Enum.Font.SourceSans\nInfoLabel.TextScaled = true\nInfoLabel.TextWrapped = true\n\n-- Logic\nlocal enabled = true\nToggleBtn.MouseButton1Click:Connect(function()\n\tenabled = not enabled\n\tToggleBtn.Text = enabled and \"🟢 ON\" or \"🔴 OFF\"\nend)\n\n-- Touch event\nUIS.InputBegan:Connect(function(input, gpe)\n\tif gpe or not enabled then return end\n\tif input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then\n\t\tlocal mouse = LocalPlayer:GetMouse()\n\t\tlocal target = mouse.Target\n\t\tif target then\n\t\t\tInfoLabel.Text = \"📌 Name: \" .. target.Name\n\t\telse\n\t\t\tInfoLabel.Text = \"❌ No part touched\"\n\t\tend\n\tend\nend)","features":"Using this script you can see any part name you can create own auto farm more using this script this script is useful for who create his/her own script","tags":[],"discord":"","keyLink":"","owner":{"_id":"686fb85afb40b5a6dd4184d6","username":"jhoncean73","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"686fb85afb40b5a6dd4184d6","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus"