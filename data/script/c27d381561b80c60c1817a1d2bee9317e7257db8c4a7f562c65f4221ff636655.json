{"slug":"UPD-Knockout!-Push-All-112487","_id":"699363ac82ddf85bcae338f3","title":"Push All","game":{"_id":"6975a3066fe269b3ef31bc8e","gameId":136764190843219,"name":"[🎪] Knockout! 🐧","imageUrl":"/images/sb/rbx-152a83c0bc4a22f667e0a4d5f7e51c98-f10d5705733a.png","placeId":136764190843219},"features":"Must run in match and before first move!!!!!\nWorks on ALL executors.\nNo UNC or sUNC functions needed.\n\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\nMust run in match and before first move!!!!!\n\nUpdate: Added more \"Must run in match and before first move!!!!!\" for those who are blind and missed the one at the top, claiming that it is patched.","tags":["knockout","auto push","push all"],"script":"if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild(\"HitBox\") then\n    local lastPos = game.Players.LocalPlayer.Character.HitBox.CFrame\n    local WC = game.Players.LocalPlayer.Character:FindFirstChild(\"HitBox\").WeldConstraint\n    local cloneOf_WC = WC:Clone()\n    WC:Destroy()\n    for i,v in pairs(game.Players:GetPlayers()) do\n        if v ~= game.Players.LocalPlayer and v.Character and game.Players.LocalPlayer.Character and v.Character:FindFirstChild(\"HitBox\") and game.Players.LocalPlayer.Character:FindFirstChild(\"HitBox\") then\n            for _ = 1, 10 do\n                if not v.Character and game.Players.LocalPlayer.Character and v.Character:FindFirstChild(\"HitBox\") and game.Players.LocalPlayer.Character.FindFirstChild(\"HitBox\") then break end\n                game.Players.LocalPlayer.Character.HitBox.CFrame = v.Character.HitBox.CFrame\n                game.Players.LocalPlayer.Character.HitBox.Velocity = Vector3.new(500,500,500)\n                task.wait()\n            end\n        end\n    end\n    game.Players.LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0)\n    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = lastPos\n    task.wait(0.1)\n    if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild(\"HitBox\") then\n        game.Players.LocalPlayer.Character.HitBox.Velocity = Vector3.zero\n        game.Players.LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0)\n        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = lastPos\n        game.Players.LocalPlayer.Character.HitBox.CFrame = lastPos\n        cloneOf_WC.Parent = game.Players.LocalPlayer.Character.HitBox\n    end\nend","owner":{"_id":"64ce5d5efbbf5eb080abe152","username":"ProBaconHub","verified":false,"profilePicture":"/images/photo/64ce5d5efbbf5eb080abe152-1743575713534.png","status":"offline","id":"64ce5d5efbbf5eb080abe152","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"views":2923,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/rbx-a4ebb01b656f0399b195e68d51d5fa4f-1bdd69a06cdc.png","likeCount":6,"dislikeCount":6,"createdAt":"2026-02-16T18:36:28.240Z","keyLink":"","executes":49,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"699363ac82ddf85bcae338f6","editBy":{"_id":"64ce5d5efbbf5eb080abe152","username":"ProBaconHub","status":"offline","id":"64ce5d5efbbf5eb080abe152"},"message":"Create script","createdAt":"2026-02-16T18:36:28.242Z"}],"comments":[{"_id":"69936ad5314b374a46135942","commentBy":{"_id":"