{"slug":"Universal-Script-Speed-Boost-40622","_id":"682ff4196c7633323526ee85","title":"Speed Boost","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"⚔️Speed Changer Made By: shewithepanda⚔️","tags":["Script Booster","Jjsploit","Solara","Fluxus","Delta"],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal originalWalkSpeed = humanoid.WalkSpeed\n\nlocal speedBoost = 20 -- A more reasonable speed boost\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = player.PlayerGui\n\n-- Title (Positioned at the edge of the screen)\nlocal titleLabel = Instance.new(\"TextLabel\")\ntitleLabel.Parent = screenGui\ntitleLabel.Size = UDim2.new(0.2, 0, 0.05, 0) -- Adjust size as needed\ntitleLabel.Position = UDim2.new(0.01, 0, 0.01, 0) -- Top-left corner, near the edge\ntitleLabel.BackgroundTransparency = 1\ntitleLabel.TextColor3 = Color3.new(0, 1, 0)\ntitleLabel.Text = \"Made by: shewithepanda\"\ntitleLabel.Font = Enum.Font.SourceSans\ntitleLabel.TextSize = 14\n\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Parent = screenGui\nbutton.Size = UDim2.new(0.2, 0, 0.1, 0)\nbutton.Position = UDim2.new(0.4, 0, 0.15, 0)\nbutton.Text = \"Speed Boost: OFF\"\nbutton.BackgroundColor3 = Color3.new(0.5, 0.1, 0.1)\nbutton.TextColor3 = Color3.new(1, 1, 1)\n\nlocal isSpeedBoosted = false\n\nbutton.MouseButton1Click:Connect(function()\n    isSpeedBoosted = not isSpeedBoosted\n    if isSpeedBoosted then\n        humanoid.WalkSpeed = originalWalkSpeed + speedBoost\n        button.Text = \"Speed Boost: ON\"\n        button.BackgroundColor3 = Color3.new(0.1, 0.5, 0.1)\n    else\n        humanoid.WalkSpeed = originalWalkSpeed\n        button.Text = \"Speed Boost: OFF\"\n        button.BackgroundColor3 = Color3.new(0.5, 0.1, 0.1)\n    end\nend)","owner":{"_id":"6825af86f8062e8f4804d9c6","username":"angeloolavere64Cheez","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/10915c6f87c79306b0c0225da4473bca94fb9024c904694cefaff3a53e491aac.webp","original":"https://scriptblox.com/images/photo/6825af86f8062e8f4804d9c6-1748342423934.jpg"},"status":"offline","id":"6825af86f8062e8f4804d9c6","profile":{"url":"https://cdn.kocakz.me/images/10915c6f87c79306b0c0225da4473bca94fb9024c904694cefaff3a53e491aac.webp","original":"https://scriptblox.com/images/photo/6825af86f8062e8f4804d9c6-1748342423934.jpg"}},"verified":false,"views":4495,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/303a4e6c1de78ef22245f438e0d8e7f2c6fced6ecd41646b183ee9600c66c7aa.webp","original":"https://scriptblox.com/images/sb/0-1747973145646.jpg","scriptblox":"https://scriptblox.com/images/script/0-1747973145646.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-05-23T04:05:45.696Z","executes":206,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:58:33.055Z","last":"","win":14,"math":2},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://cdn.kocakz.me/images/303a4e6c1de78ef22245f438e0d8e7f2c6fced6ecd41646b183ee9600c66c7aa.webp","original":"https://scriptblox.com/images/sb/0-1747973145646.jpg","scriptblox":"https://scriptblox.com/images/script/0-1747973145646.jpg"},"changelog":[{"_id":"682ff4196c7633323526ee88","editBy":{"_id":"6825af86f8062e8f4804d9c6","username":"angeloolavere64Cheez","status":"offline","id":"6825af86f8062e8f4804d9c6"},"message":"Create script","createdAt":"2025-05-23T04:05:45.699Z"}],"comments":[{"_id":"682ff43a0bf7ae2157edf61f","commentBy":{