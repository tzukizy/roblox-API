{"slug":"Universal-Script-Reset-button-Beta-testing-25114","_id":"676a401783381cffbcf88563","title":"Reset button Beta testing","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Reset","tags":[],"script":"local ScreenGui = Instance.new(\"ScreenGui\")\nlocal ResetButton = Instance.new(\"TextButton\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nScreenGui.Parent = game.CoreGui\nScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\n\nResetButton.Name = \"ResetButton\"\nResetButton.Parent = ScreenGui\nResetButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)\nResetButton.Position = UDim2.new(0.5, -75, 0.9, -25)\nResetButton.Size = UDim2.new(0, 150, 0, 50)\nResetButton.Font = Enum.Font.GothamBold\nResetButton.Text = \"Reset Character\"\nResetButton.TextColor3 = Color3.fromRGB(255, 255, 255)\nResetButton.TextSize = 14.000\n\nUserInputService.InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.V then\n        UserInputService.MouseBehavior = \n            UserInputService.MouseBehavior == Enum.MouseBehavior.Default \n            and Enum.MouseBehavior.LockCenter \n            or Enum.MouseBehavior.Default\n    end\nend)\n\nResetButton.MouseButton1Click:Connect(function()\n    local character = player.Character\n    if character then\n        local humanoid = character:FindFirstChild(\"Humanoid\")\n        if humanoid then\n            humanoid.Health = 0\n        end\n        task.wait(0.1)\n        player:LoadCharacter()\n    end\nend)\n","owner":{"_id":"6749c52da2071ed30f61d7a0","username":"Nooby","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/13c82ce2a204f85910f8c7ba84b3db7e0fd41287bc4fe8847be4081acc667b8f.webp",