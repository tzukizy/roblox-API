{"slug":"Find-The-Flags-(350)-Find-ALL-Flags-45074","_id":"687731458b04a560d8417fc8","title":"Find ALL Flags","game":{"_id":"67e5e1ffb360710ec3c78b47","gameId":16276623981,"name":"Find The Flags (350) 🌍","imageUrl":"/images/sb/rbx-6a66c1a4ea49ff90ce0e90c84767048d-1f73377fc31d.png","placeId":16276623981},"features":"Features >\n\n> Find All Flags\n\ngivemecreditspls","tags":["keyless","opensourcer","give me credits","search tgmankaske in yt","join in dc server for more"],"script":"-- execute 3x for better script performace\n\nlocal Players = game:GetService(\"Players\")\nlocal localPlayer = Players.LocalPlayer\nlocal character = localPlayer.Character or localPlayer.CharacterAdded:Wait()\n\nlocal function teleportToTargets()\n\tlocal targetFolder = workspace:FindFirstChild(\"ToFind\")\n\tif not targetFolder then\n\t\twarn(\"Folder 'ToFind' not found in workspace.\")\n\t\treturn\n\tend\n\n\tlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n\tfor _, target in ipairs(targetFolder:GetChildren()) do\n\t\tif target:IsA(\"BasePart\") then\n\t\t\t-- Teleporta o jogador levemente acima da parte para evitar colisão\n\t\t\trootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0)\n\t\t\tprint(\"Teleported to:\", target.Name)\n\t\t\twait(0.1)\n\t\tend\n\tend\nend\n\nteleportToTargets()\n","owner":{"_id":"6830a134c236ccc4acf59745","username":"KMAN","verified":false,"profilePicture":"/images/photo/6830a134c236ccc4acf59745-1758858349070.png","status":"offline","id":"6830a134c236ccc4acf59745","leaderboard":{"tag":{"kind":"hall","rank":8,"period":"all","metric":"likes","value":542}},"topMilestone":{"key":"creator.hall_of_fame","tier":1}},"verified":false,"views":5767,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/16276623981-1752641861128.webp","likeCount":7,"dislikeCount":1,"createdAt":"2025-07-16T04:57:41.191Z","editBy":{"_id":"6830a134c236ccc4acf59745","username":"KMAN","status":"offline","id":"6830a134c236ccc4acf5974