= Color3.fromHSV(Hue, 1, 1)\n\n            for _, Part in ipairs(Character:GetDescendants()) do\n                if Part:IsA(\"BasePart\") then\n                    Part.Color = RainbowColor\n                end\n            end\n\n            task.wait(0.05)\n        end\n    end)\nend\n\nPlayer.CharacterAdded:Connect(function(Character)\n    task.wait(0.1)\n    ApplyRainbow(Character)\nend)\n\nif Player.Character then\n    ApplyRainbow(Player.Character)\nend\n","features":"It creates a cool effect for your character and if you die it will reapply.","tags":[],"discord":"","keyLink":"","owner":{"_id":"673cce33ae8ad48fd8849e0c","username":"purplesstrat","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e4d5f6d8b0bd2f58eda7922a1aeeb5d366e77ea31cf189006da716d31234397e.webp","original":"https://scriptblox.com/images/photo/673cce33ae8ad48fd8849e0c-1753727708365.png"},"status":"offline","id":"673cce33ae8ad48fd8849e0c","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/e4d5f6d8b0bd2f58eda7922a1aeeb5d366e77ea31cf189006da716d31234397e.webp","original":"https://scriptblox.com/images/photo/673cce33ae8ad48fd8849e0c-1753727708365.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:54:02.757Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d8fecae48466ac2f75a71b","editBy":{"_id":"673cce33ae8ad48fd8849e0c","username":"purplesstrat","status":"offline","id":"673cce33ae8ad48fd8849e0c"},"message":"Create script","createdAt":"2025-09-28T09:24:26.558Z"}],"comments":[{"_id":"68d9000440274d4d2beb9273","commentBy":{"_id":"677e4eb65f8bda990f6d10d8","username":"Noah1337","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/4b75fa478bee6e9a20a5684aaafe8f6232dd584b96da973247056d69ba75544b.webp","original":"https://scri