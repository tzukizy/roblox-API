n\"))\nlocal badfont = tostring(Font.new(\"rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json\"))\n\nlocal function skip(obj)\n\tif obj.TextStrokeTransparency ~= 1 then return true end\n\tlocal cur = tostring(obj.FontFace)\n\treturn cur == badfont or string.find(cur, \"BuilderIcons\")\nend\n\nlocal function apply(obj)\n\tif obj:IsA(\"TextLabel\") or obj:IsA(\"TextButton\") or obj:IsA(\"TextBox\") then\n\t\tif not skip(obj) then\n\t\t\tobj.FontFace = font\n\t\tend\n\tend\nend\n\nfor _, v in ipairs(game:GetDescendants()) do\n\ttask.spawn(function()\n\t\tapply(v)\n\tend)\nend\n\ngame.DescendantAdded:Connect(function(obj)\n\ttask.spawn(function()\n\t\tapply(obj)\n\tend)\nend)","features":"Minecraft font","tags":["StyearX","Font"],"discord":"","keyLink":"","owner":{"_id":"683c04b5f85943d072649c85","username":"styear","verified":false,"profilePicture":{"url":"https://media.kocakz.me/363dca406fe87448670842c7e22a81bafe286b61b1ab95bf1278df3c09593925.webp","original":"https://scriptblox.com/images/photo/683c04b5f85943d072649c85-1790679618483.png"},"status":"offline","id":"683c04b5f85943d072649c85","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/363dca406fe87448670842c7e22a81bafe286b61b1ab95bf1278df3c09593925.webp","original":"https://scriptblox.com/images/photo/683c04b5f85943d072649c85-1790679618483.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:02:11.561Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69cf707cc9beff7e3c237d5c","editBy":{"_id":"683c04b5f85943d072649c85","username":"styear","status":"offline","id":"683c04b5f85943d072649c85"},"message":"Create script","createdAt":"2026-04-03T07:47:08.274Z"}],"comments":[{"_id":"69d08437c472e7088f15c36a","commentBy":{"_id":"69aa6e431526fb78b4debb6b","