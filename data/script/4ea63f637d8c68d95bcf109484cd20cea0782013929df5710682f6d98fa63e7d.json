{"slug":"Airsoft-FE-MUSKET-hitbox-expander-16113","_id":"66a335fe40204cde3a309f21","title":"hitbox expander","game":{"_id":"67e5e1ffb360710ec3c77fef","gameId":6792057800,"name":"Airsoft FE","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":6792057800},"features":"its a simple hitbox expander that i made! :D\n(also usable in other shooter games i think)","tags":[],"script":"_G.HeadSize = 20 --adjust this if you want the hitbox to be bigger or smaller (20 recommended)\n_G.Disabled = true\ngame:GetService('RunService').RenderStepped:connect(function()\nif _G.Disabled then\nfor i,v in next, game:GetService('Players'):GetPlayers() do\nif v.Name ~= game:GetService('Players').LocalPlayer.Name then\npcall(function()\nv.Character.HumanoidRootPart.Size = Vector3.new(_G.HeadSize,_G.HeadSize,_G.HeadSize)\nv.Character.HumanoidRootPart.Transparency = 0.8 --transparency, lower = more visible, higher = less visible and more transparent\nv.Character.HumanoidRootPart.BrickColor = BrickColor.new(\"Forest Green\") --you can make this any color if you want\nv.Character.HumanoidRootPart.Material = \"Neon\"\nv.Character.HumanoidRootPart.CanCollide = false\nend)\nend\nend\nend\nend)","owner":{"_id":"6651a59ff417b3c3ddad5394","username":"childishfroggo","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6651a59ff417b3c3ddad5394","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":98264,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-26T05:37:02.530Z","dislikeCount":1,"likeCount":4,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/86d8188e1454d66805ffd025effcd79e/500/280/Image/Jpe