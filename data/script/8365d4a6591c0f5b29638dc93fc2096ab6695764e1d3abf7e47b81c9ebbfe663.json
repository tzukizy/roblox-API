)\nend\nend)\nrejoinIfLow(hum)\nend\n\nif plr.Character then setup(plr.Character)end\nplr.CharacterAdded:Connect(setup)\ntask.delay(10,function()busy=false end)","features":"Features:\n- Helpful Script\n- If your hp are low you will rejoin\n- Custom Script (change 15 from \"local thresh=15\" to set how many hp to rejoin)\n\nTags:\nLow Health Auto Rejoin, Low Hp Auto Rejoin, Low Health Point Auto Rejoin","tags":["Low","Health","Hp","Health Point","Rejoin"],"discord":"","keyLink":"","owner":{"_id":"6870b97dd938e470cfbc7e3b","username":"AzScripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/27f11e60e5c711e57f078cd511b4cc12d34059b0ec10560a804113f16eea0336.webp","original":"https://scriptblox.com/images/photo/6870b97dd938e470cfbc7e3b-1765384890753.jpeg"},"status":"offline","id":"6870b97dd938e470cfbc7e3b","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/27f11e60e5c711e57f078cd511b4cc12d34059b0ec10560a804113f16eea0336.webp","original":"https://scriptblox.com/images/photo/6870b97dd938e470cfbc7e3b-1765384890753.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:41:27.597Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"692a8d833d9fd21de4ac4919","editBy":{"_id":"6870b97dd938e470cfbc7e3b","username":"AzScripter","status":"offline","id":"6870b97dd938e470cfbc7e3b"},"message":"Simple Script","createdAt":"2025-11-29T06:06:59.366Z"}],"comments":[{"_id":"692a935bfebde29062986724","commentBy":{"_id":"6728f22b602123a04ef834e3","username":"WeakLess","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/6c2b46d6e640682d5f47eb83d8ba5968034065719d54ba67ea784888dfd8469a.webp","original":"https://scriptblox.com/images/photo/6728f22b602123a04ef834e3-1775892895682.jpg"},"createdAt":"2024-11-04T16:11:23.995Z