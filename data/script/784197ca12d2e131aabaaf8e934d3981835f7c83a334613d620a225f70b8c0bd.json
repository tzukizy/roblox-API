hen return end\n    if input.KeyCode == Enum.KeyCode.LeftShift then\n        running = true\n        currentSpeed = runSpeed\n    end\nend)\n\nUserInputService.InputEnded:Connect(function(input, gpe)\n    if input.KeyCode == Enum.KeyCode.LeftShift then\n        running = false\n        currentSpeed = walkSpeed\n    end\nend)\n\n\nRunService.RenderStepped:Connect(function(dt)\n    local moveDir = humanoid.MoveDirection\n    if moveDir.Magnitude > 0 then\n        \n        hrp.CFrame = hrp.CFrame + (moveDir * currentSpeed * dt)\n    end\nend)","features":"undetected in games omd","tags":[],"discord":"","keyLink":"","owner":{"_id":"69af8ae81526fb78b4401833","username":"elchapo101019","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69af8ae81526fb78b4401833","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:41:16.249Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bb74e1b61b7d7961d85040","editBy":{"_id":"69af8ae81526fb78b4401833","username":"elchapo101019","status":"offline","id":"69af8ae81526fb78b4401833"},"message":"Create script","createdAt":"2026-03-19T04:00:33.888Z"}],"comments":[{"_id":"69bb935310fe3271a42e2abe","commentBy":{"_id":"6978ba6be517c95302a95234","username":"XYunsi","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-04-08T13:25:51.219Z","createdAt":"2026-01-27T13:15:23.445Z","status":"offline","id":"6978ba6be517c95302a95234","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"detected","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"202