{"slug":"Universal-Script-Instant-Proximity-Prompt-Script-Roblox-86661","_id":"696b1f5df76c99c44502d41e","title":"Instant Proximity Prompt Script Roblox","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1779646544637.png","placeId":0},"features":"The script works by targeting the HoldDuration property of a ProximityPrompt. By setting this value to 0, the engine processes the Triggered event immediately upon input. This is often used for fast-paced games where fluid movement is more important than deliberate, timed interactions. All you have to do is change the \"v.HoldDuration = 0.0001\" If you want to change the ProximityPrompt.","tags":[],"script":"-- Loop Instant Proximity Prompt By DIR (TheUberAccount_x)\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal function updateProximityPrompts()\n    for i, v in ipairs(Workspace:GetDescendants()) do\n        if v.ClassName == \"ProximityPrompt\" then\n            v.HoldDuration = 0.0001\n        end\n    end\nend\n\nupdateProximityPrompts()\n\nWorkspace.DescendantAdded:Connect(function(descendant)\n    if descendant.ClassName == \"ProximityPrompt\" then\n        descendant.HoldDuration = 0.0001\n    end\nend)\n","owner":{"_id":"695a18c087491d6780dd0d95","username":"SignalDrop","verified":false,"profilePicture":"/images/photo/695a18c087491d6780dd0d95-1769325605391.png","status":"offline","id":"695a18c087491d6780dd0d95","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1308,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1779646544637.png","likeCount":3,"dislikeCount":0,"createdAt":"2026-01-17T05:34:21.492Z","keyLink":"","executes":944,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"696b1f5df76c99c44502d421","editBy":{"_id":"695a18c087491d6780dd0d95","username":"SignalDrop","status":"offline","id":"695a18c087491d6780dd0d95"},"m