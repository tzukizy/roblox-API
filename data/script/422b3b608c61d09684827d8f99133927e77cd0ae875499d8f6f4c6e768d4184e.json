{"slug":"Prime-Craftwars-pc-kill-all-fixed-27411","_id":"6791008f9c7bd8961a539b6c","title":"pc kill all fixed","game":{"_id":"67e5e1ffb360710ec3c7899f","gameId":132552829970998,"name":"Prime Craftwars","imageUrl":"/images/sb/rbx-dbe69113cf29a028aa9253cb0337a3a1-cf77d61217d8.png","placeId":132552829970998},"features":"this is a better one that now works with all melee weapons instead of only some and doesnt require you to type in the weapon you want as it automatically detects the weapon","tags":[],"script":"local game = game\nlocal players = game:GetService(\"Players\")\nlocal localPlayer = players.LocalPlayer\nlocal character = localPlayer.Character\nlocal runService = game:GetService(\"RunService\")\nlocal cd = 0\n\nrunService.RenderStepped:Connect(function(delta)\n    character = localPlayer.Character\n    local weapon = character:FindFirstChildWhichIsA(\"Tool\")\n    if cd > 0.005 then\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"Mob\") and v.Mob.Value == true and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"FEMeleeKitEvents\") then\n                weapon.FEMeleeKitEvents.Attack.Attack_Server:FireServer(v,\"Handle\")\n            elseif v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"Mob\") and v.Mob.Value == true and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"RemoteFunction\") then\n                weapon.RemoteFunction:InvokeServer(\"hit\",{v.Humanoid,100000})\n            end\n        end\n        cd = 0\n    end\n    cd += delta\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"keyLink":"","views":5804,"scriptTy