hen\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"Mob\") and v.Mob.Value == true and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"FEMeleeKitEvents\") then\n                weapon.FEMeleeKitEvents.Attack.Attack_Server:FireServer(v,\"Handle\")\n            elseif v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"Mob\") and v.Mob.Value == true and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"RemoteFunction\") then\n                weapon.RemoteFunction:InvokeServer(\"hit\",{v.Humanoid,100000})\n            end\n        end\n        cd = 0\n    end\n    cd += delta\nend)","features":"this is a better one that now works with all melee weapons instead of only some and doesnt require you to type in the weapon you want as it automatically detects the weapon","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:03:17.408Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d740","editBy":{"_id":"663f0f8448d95881c33f2023","username":