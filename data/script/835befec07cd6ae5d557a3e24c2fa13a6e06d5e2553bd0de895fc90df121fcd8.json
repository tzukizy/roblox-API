{"slug":"Amusement-Park-Tycoon-Auto-Tyccon-1269","_id":"622f9f96d199b8039fed7be3","title":"Auto Tyccon","game":{"_id":"67e5e1ffb360710ec3c787f1","gameId":7050521713,"name":"Amusement Park Tycoon","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":7050521713},"features":"Auto everything basically","tags":["auto"],"script":"spawn(function()\nwhile wait(2) do\n    game:GetService(\"ReplicatedStorage\").RE.emptyCollector:InvokeServer()\nend\nend)\n\nspawn(function()\nlocal tyconas\nfor a, b in pairs(workspace.Tycoon.Tycoons:GetChildren()) do\n    if b.Owner.Value == game.Players.LocalPlayer.Name then\n        tyconas = b\n    end\nend\nwhile wait(.3) do\n    for i, v in pairs(workspace.Tycoon.Tycoons[tostring(tyconas)].Buttons:GetChildren()) do\n        if v.Config.Gamepass.Value == false and v.Config.Owned.Value == false then\n            local money = game.Players.LocalPlayer.leaderstats.Money.Value\n\n            if money >= v.Config.Cost.Value then\n                local args = {\n                    [1] = v\n                }\n\n                game:GetService(\"ReplicatedStorage\").RE.purchaseButton:InvokeServer(unpack(args))\n                v.Config.Owned.Value = true\n            end\n        end\n    end\nend\nend)","owner":{"_id":"61ae3534dbec4f0207211d48","username":"Emptyness","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61ae3534dbec4f0207211d48-1647287055991.gif"},"status":"offline","id":"61ae3534dbec4f0207211d48","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61ae3534dbec4f0207211d48-1647287055991.gif"}},"verified":true,"views":33829,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-03-1