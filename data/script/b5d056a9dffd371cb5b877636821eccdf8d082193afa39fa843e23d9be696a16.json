{"_id":"6ad8c896eaf26181ea6078fe","title":"optimization","game":{"_id":"67e5e1ffb360710ec3c78408","gameId":18879239467,"name":"Bloody playground","imageUrl":{"url":"https://media.kocakz.me/1f2cad3d62337d19ed9e6b2c1d4ec5595a9cac25c771c3b62b62d89bc6ca93dd.webp","original":"https://scriptblox.com/images/sb/rbx-d0070fdd5740744cb348337b5fb81115-0efda3573ea1.png"},"slug":"18879239467-bloody-playground","path":"/game/18879239467-bloody-playground","thumbnail":{"url":"https://media.kocakz.me/1f2cad3d62337d19ed9e6b2c1d4ec5595a9cac25c771c3b62b62d89bc6ca93dd.webp","original":"https://scriptblox.com/images/sb/rbx-d0070fdd5740744cb348337b5fb81115-0efda3573ea1.png"},"placeId":18879239467},"slug":"Bloody-playground-optimization-232861","verified":false,"key":false,"keyless":false,"views":1093,"executes":74,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/768d1568266a83ac47257355b11f12c11730a61c178d8dba1ffd7ca0725a8eaf.webp","original":"https://scriptblox.com/images/sb/rbx-d0070fdd5740744cb348337b5fb81115-0efda3573ea1.png","scriptblox":"https://scriptblox.com/images/script/rbx-d0070fdd5740744cb348337b5fb81115-0efda3573ea1.png"},"thumbnail":{"url":"https://media.kocakz.me/768d1568266a83ac47257355b11f12c11730a61c178d8dba1ffd7ca0725a8eaf.webp","original":"https://scriptblox.com/images/sb/rbx-d0070fdd5740744cb348337b5fb81115-0efda3573ea1.png","scriptblox":"https://scriptblox.com/images/script/rbx-d0070fdd5740744cb348337b5fb81115-0efda3573ea1.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2026-10-21T14:13:42.958Z","updatedAt":"2026-10-21T14:13:42.958Z","lastBump":"2026-10-21T14:13:42.958Z","script":"-- Parquinho Sangrento | Otimizacao visual\n-- Roblox mobile - teste de desempenho\n\nlocal Lighting = game:GetService(\"Lighting\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal function optimize(obj)\n    pcall(function()\n        if obj:IsA(\"PostEffect\") then\n            obj.Enabled = false\n        elseif obj:IsA(\"BasePart\") then\n            obj.CastShadow = false\n        end\n    end)\nend\n\npcall(function()\n    Lighting.GlobalShadows = false\nend)\n\nfor _, obj in ipairs(Lighting:GetDescendants()) do\n    optimize(obj)\nend\n\nfor _, obj in ipairs(Workspace:GetDescendants()) do\n    optimize(obj)\nend\n\nprint(\"Ajustes visuais aplicados!\")","features":"🇧🇷: Esse script faz com que seu parquinho sangrento seja otimizado! Porém não remove partículas nem nada, mais tenta deixar otimizado!\n🇺🇸: This script makes your bloody playground optimized! However, it doesn't remove particles or anything, but it tries to keep it optimized!\"","tags":[],"discord":"","keyLink":"","owner":{"_id":"68d84746c38b2b1508fca7e1","username":"Arthurkeylesscripts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/07be745e466b62d470d4f4ef649f1eee578aca9e1e6fbd8dd74c07fa9ba88527.webp","original":"https://scriptblox.com/images/photo/68d84746c38b2b1508fca7e1-1791813033960.jpg"},"lvl":6,"status":"offline","id":"68d84746c38b2b1508fca7e1","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/07be745e466b62d470d4f4ef649f1eee578aca9e1e6fbd8dd74c07fa9ba88527.webp","original":"https://scriptblox.com/images/photo/68d84746c38b2b1508fca7e1-1791813033960.jpg"}},"reviewed":{"name":"QueueHero","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-22T16:22:10.547Z","profile":"/u/QueueHero"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:24:33.430Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ad8c896eaf26181ea607900","editBy":{"_id":"68d84746c38b2b1508fca7e1","username":"Arthurkeylesscripts","status":"offline","id":"68d84746c38b2b1508fca7e1"},"message":"Create script","createdAt":"2026-10-21T14:13:42.963Z"}],"comments":[]}