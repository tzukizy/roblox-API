{"slug":"Sky-Pushers-SQUID-GAME-3-Simple-Anti-Fall-49439","_id":"68a6638a5165138168ed0dfb","title":"Simple Anti Fall","game":{"_id":"68a6638a5165138168ed0df8","gameId":138957999879593,"name":"Sky Pushers [SQUID GAME 3]","imageUrl":"/images/sb/rbx-808ef990681c28dd725f596dce0c5419-40ec8b53d2a8.png","placeId":138957999879593},"features":"Enjoy:)","tags":[],"script":"local partName = \"Hehwu6s7wh2hw8q8w672j1hqa67shgdjwk$#4171#&@72hwk\"\n\nlocal function createPlatform()\n    local corner1 = Vector3.new(237.12, 132, 39.02) \n    local corner2 = Vector3.new(-264.34, 132, -186.48) \n\n    local center = (corner1 + corner2) / 2\n    center = center + Vector3.new(0, 5, 0)\n\n    local size = Vector3.new(\n        math.abs(corner1.X - corner2.X),\n        2,\n        math.abs(corner1.Z - corner2.Z)\n    )\n\n    local part = Instance.new(\"Part\")\n    part.Size = size\n    part.Position = center\n    part.Anchored = true\n    part.CanCollide = true\n    part.Transparency = 0.99\n    part.Color = Color3.fromRGB(0, 0, 0)\n    part.Name = partName\n    part.Parent = workspace\nend\n\nif not workspace:FindFirstChild(partName) then\n    createPlatform()\nend\n\nwhile task.wait(15) do\n    if not workspace:FindFirstChild(partName) then\n        createPlatform()\n    end\nend","owner":{"_id":"660e43bf29c1b3cba3e41200","username":"BopIsme","verified":false,"profilePicture":"/images/photo/660e43bf29c1b3cba3e41200-1749703148654.jpeg","status":"offline","id":"660e43bf29c1b3cba3e41200","leaderboard":{"tag":{"kind":"day","rank":4,"period":"day","metric":"executes","value":103099}},"topMilestone":{"key":"creator.executions","tier":1000000}},"verified":false,"views":4780,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-808ef990681c28dd725f596dce0c5419-40ec8b53d2a8.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-08-21T00:08:42.096Z","executes":353,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"ch