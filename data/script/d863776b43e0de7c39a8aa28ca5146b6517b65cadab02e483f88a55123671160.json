FirstChild(\"HumanoidRootPart\") then\n            for _, t in pairs(Workspace.Tycoons:GetChildren()) do\n                local owner = t:FindFirstChild(\"TycoonInfo\") and t.TycoonInfo:FindFirstChild(\"Owner\")\n                local debris = t:FindFirstChild(\"ItemDebris\")\n                if owner and owner.Value == player and debris then\n                    for _, item in pairs(debris:GetChildren()) do\n                        if item:IsA(\"BasePart\") or item:IsA(\"Model\") then\n                            RS:WaitForChild(\"RF\"):WaitForChild(\"CollectItem\"):InvokeServer(item)\n                        end\n                    end\n                end\n            end\n        end\n        wait(0.1)\n    end\nend)","features":"auto collect eggs\nopen source","tags":["open source","public","auto collect","egg farm tycoon"],"discord":"","keyLink":"","owner":{"_id":"668671b6a5ae0d4edf306473","username":"YOnikosYT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/094098c8f3b890d7caf768f9c94c3d0c3c908374a28f06d638f4d6a3b6d57812.webp","original":"https://scriptblox.com/images/photo/668671b6a5ae0d4edf306473-1756850597469.jpg"},"lvl":8,"status":"offline","id":"668671b6a5ae0d4edf306473","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/094098c8f3b890d7caf768f9c94c3d0c3c908374a28f06d638f4d6a3b6d57812.webp","original":"https://scriptblox.com/images/photo/668671b6a5ae0d4edf306473-1756850597469.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:59:42.645Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68bb6675c6c87d0001c3034c","editBy":{"_id":"668671b6a5ae0d4edf306473","username":"YOnikosYT","status":"offline","id":"668671b6a5ae0d4edf306473"},"message":"Create script","createdAt":"2025-09-05T22:38:45.206Z"},{"_id":"68bb66