.new(4, 4, 4) \n        block.Position = humanoid.RootPart.Position + Vector3.new(0, -block.Size.Y / 2, 0)\n        block.BrickColor = BrickColor.new(\"Bright blue\") \n        block.Anchored = true --set the Anchored thing\n        block.Parent = workspace\n    end\nend)","features":"<V2>\n<Universal>\n<Any executer>\n<Can be used to anti-fly>\n<Can bypass anti flys>","tags":[],"discord":"","keyLink":"","owner":{"_id":"661e026f3bbf4daefe25960b","username":"007n7z","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"661e026f3bbf4daefe25960b","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:59:37.120Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50acf","editBy":{"_id":"661e026f3bbf4daefe25960b","username":"007n7z","status":"offline","id":"661e026f3bbf4daefe25960b"},"message":"Create script","createdAt":"2025-03-26T06:36:54.590Z"}],"comments":[]}