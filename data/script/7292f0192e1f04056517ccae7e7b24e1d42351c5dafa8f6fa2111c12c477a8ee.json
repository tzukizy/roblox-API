{"_id":"6a135c055222e6295aac0cb6","title":"Teleport to Target script","game":{"_id":"67e5e1ffb360710ec3c77d7f","gameId":863266079,"name":"Apocalypse Rising 2","imageUrl":{"url":"https://media.kocakz.me/011c2a8c7949dfb1bca8f09e3ea140cac749c23570e8b995d596e158905289e9.webp","original":"https://tr.rbxcdn.com/180DAY-000d30d3e6dc41038f05b0a1a55692bd/150/150/Image/Png/noFilter"},"slug":"863266079-apocalypse-rising-2","path":"/game/863266079-apocalypse-rising-2","thumbnail":{"url":"https://media.kocakz.me/011c2a8c7949dfb1bca8f09e3ea140cac749c23570e8b995d596e158905289e9.webp","original":"https://tr.rbxcdn.com/180DAY-000d30d3e6dc41038f05b0a1a55692bd/150/150/Image/Png/noFilter"},"placeId":863266079},"slug":"Apocalypse-Rising-2-Teleport-to-Target-script-223048","verified":false,"key":false,"keyless":false,"views":4145,"executes":1585,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4c197ba55c6d352497402a6e1722aa7e1c54d33f11da8e68b8954ca50d1c983f.webp","original":"https://scriptblox.com/images/sb/rbx-a6ce8c4cabf5cb325b83860a845c9ee6-26e334e661fa.png","scriptblox":"https://scriptblox.com/images/script/rbx-a6ce8c4cabf5cb325b83860a845c9ee6-26e334e661fa.png"},"thumbnail":{"url":"https://media.kocakz.me/4c197ba55c6d352497402a6e1722aa7e1c54d33f11da8e68b8954ca50d1c983f.webp","original":"https://scriptblox.com/images/sb/rbx-a6ce8c4cabf5cb325b83860a845c9ee6-26e334e661fa.png","scriptblox":"https://scriptblox.com/images/script/rbx-a6ce8c4cabf5cb325b83860a845c9ee6-26e334e661fa.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-05-24T20:13:57.877Z","updatedAt":"2026-05-24T20:13:57.877Z","lastBump":"2026-05-24T20:13:57.877Z","script":"local target = \"TARGETS_USERNAME\" -- targets username\nlocal behindOffset = 10 -- how far behind the target you want to teleport\n\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\n\nlocal stableTime = 0\nlocal lastTeleportPos = nil\n\nwhile true do\n    local targetPlayer = Players:FindFirstChild(target)\n    if not targetPlayer or not player.Character or not targetPlayer.Character then break end\n\n    local myRoot = player.Character.HumanoidRootPart\n    local targetRoot = targetPlayer.Character.HumanoidRootPart\n    if not myRoot or not targetRoot then break end\n\n    if lastTeleportPos then\n        local myRootPos = myRoot.Position\n        local teleportCheck = math.abs(myRootPos.X - lastTeleportPos.X) >= 100 or math.abs(myRootPos.Y - lastTeleportPos.Y) >= 100 or math.abs(myRootPos.Z - lastTeleportPos.Z) >= 100\n\n        if teleportCheck then\n            stableTime = 0\n        else\n            stableTime = stableTime + 0.09\n            if stableTime >= 1.0 then\n                break\n            end\n        end\n    end\n\n    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, behindOffset)\n    lastTeleportPos = myRoot.Position\n    task.wait(0.09)\nend","features":"Hello guys.\n\nThis game is ass and they unpatched teleportation, so here is a free open sourced scuffed teleportation script I threw together real quick cause one of my users wanted it.\n\nMake sure you're not above the target as you will take fall damage upon teleporting in that case. Be on even ground or below the target.\n\nI expect this to be patched soon, so use it while you can!","tags":["AR","apoc","apocalypse rising","open source","teleport"],"discord":"https://discord.gg/rvWSHyHkbr","keyLink":"","owner":{"_id":"69ae03fd11afc6c1a5ac3c62","username":"Shenanigan","verified":false,"profilePicture":{"url":"https://media.kocakz.me/75e01c248c6616ea86d9d194d37e62f9d528f3c722b21d17c1024bd2a14dcd3a.webp","original":"https://scriptblox.com/images/photo/69ae03fd11afc6c1a5ac3c62-1779653495865.png"},"lvl":4,"status":"offline","id":"69ae03fd11afc6c1a5ac3c62","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/75e01c248c6616ea86d9d194d37e62f9d528f3c722b21d17c1024bd2a14dcd3a.webp","original":"https://scriptblox.com/images/photo/69ae03fd11afc6c1a5ac3c62-1779653495865.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:31:06.185Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a135c055222e6295aac0cb8","editBy":{"_id":"69ae03fd11afc6c1a5ac3c62","username":"Shenanigan","status":"offline","id":"69ae03fd11afc6c1a5ac3c62"},"message":"Create script","createdAt":"2026-05-24T20:13:57.879Z"}],"comments":[{"_id":"6a14939001aa285dbd7fe372","commentBy":{"_id":"6a0ce75bd43bc35dec720478","username":"0fex","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-06-16T19:38:55.152Z","createdAt":"2026-05-19T22:42:35.621Z","status":"offline","id":"6a0ce75bd43bc35dec720478","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"s*s you under the map","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-25T18:23:12.655Z","liked":false,"disliked":false},{"_id":"6a1744c4f92f380a5051a9f1","commentBy":{"_id":"69ae03fd11afc6c1a5ac3c62","username":"Shenanigan","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/75e01c248c6616ea86d9d194d37e62f9d528f3c722b21d17c1024bd2a14dcd3a.webp","original":"https://scriptblox.com/images/photo/69ae03fd11afc6c1a5ac3c62-1779653495865.png"},"lastActive":"2026-10-19T10:18:46.905Z","createdAt":"2026-03-08T23:19:25.061Z","lvl":4,"status":"offline","id":"69ae03fd11afc6c1a5ac3c62","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/75e01c248c6616ea86d9d194d37e62f9d528f3c722b21d17c1024bd2a14dcd3a.webp","original":"https://scriptblox.com/images/photo/69ae03fd11afc6c1a5ac3c62-1779653495865.png"}},"text":"@0fex ...","parent":{"_id":"6a14939001aa285dbd7fe372",