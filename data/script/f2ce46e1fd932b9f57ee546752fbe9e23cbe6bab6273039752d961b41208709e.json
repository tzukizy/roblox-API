{"slug":"Universal-Script-Hitbox-Enlarger-17922","_id":"66daf862abcc65b00a291bbf","title":"Hitbox Enlarger","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/2919228-1725626466603.png","placeId":0},"features":"The easy Hitbox Expander — a tool for effortless mass destruction.","tags":[],"script":"-- you can also enable collision, change expand part (head to torso), change transparency and size as well\n_G.HeadSize = 15 _G.Disabled = true game:GetService('RunService').RenderStepped:connect(function() if _G.Disabled then for i,v in next, game:GetService('Players'):GetPlayers() do if v.Name ~= game:GetService('Players').LocalPlayer.Name then pcall(function() v.Character.Head.Size = Vector3.new(_G.HeadSize,_G.HeadSize,_G.HeadSize) v.Character.Head.Transparency = 1 v.Character.Head.BrickColor = BrickColor.new(\"Red\") v.Character.Head.Material = \"Neon\" v.Character.Head.CanCollide = false v.Character.Head.Massless = true end) end end end end)","owner":{"_id":"66740c23fd0410f3801b10de","username":"Bi2_BlackSun","verified":false,"profilePicture":"/images/photo/66740c23fd0410f3801b10de-1718881474953.jpg","status":"offline","id":"66740c23fd0410f3801b10de","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"keyLink":"","views":72036,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-09-06T12:41:06.667Z","dislikeCount":3,"likeCount":3,"image":"/images/sb/2919228-1725626466603.png","executes":215,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51fbc","editBy":{"_id":"66740c23fd0410f3801b10de","username":"Bi2_BlackSun","status":"offline","id":"66740c23fd0410f3801b10de"},"message":"Create script","createdAt":"2025-03-27T23:03:48.408Z"}],"comments":[{"_id":"66daf9dd9305e61b135d6398","commentBy":{"_id":"66740c23fd0410f3801b10de","username":"Bi2_BlackSun","verified":false,"role":"user","pr