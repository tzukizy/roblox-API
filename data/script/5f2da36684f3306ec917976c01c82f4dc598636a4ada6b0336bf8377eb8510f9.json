{"_id":"66716ac2682748863c6fb1cb","title":"Button esp","game":{"_id":"67e5e1ffb360710ec3c7833b","gameId":7836133734,"name":"[LATE EASTER] Minus Elevation ","imageUrl":{"url":"https://media.kocakz.me/f3dfacde8d880f4ddd66cca1c135152b5ee563b88f2051243ed99a13a12a86da.webp","original":"https://tr.rbxcdn.com/180DAY-7fa6936c3b816942ae3351368b820fe0/150/150/Image/Png/noFilter"},"slug":"7836133734-minus-elevation","path":"/game/7836133734-minus-elevation","thumbnail":{"url":"https://media.kocakz.me/f3dfacde8d880f4ddd66cca1c135152b5ee563b88f2051243ed99a13a12a86da.webp","original":"https://tr.rbxcdn.com/180DAY-7fa6936c3b816942ae3351368b820fe0/150/150/Image/Png/noFilter"},"placeId":7836133734},"slug":"LATE-EASTER-Minus-Elevation-Button-esp-14322","verified":false,"key":false,"keyless":false,"views":7754,"executes":30,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/91285028fc274c8fff35efd6c5447bc0/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/91285028fc274c8fff35efd6c5447bc0/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/91285028fc274c8fff35efd6c5447bc0/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/91285028fc274c8fff35efd6c5447bc0/500/280/Image/Jpeg"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-06-18T11:08:50.433Z","updatedAt":"2024-06-18T11:08:50.433Z","lastBump":"2024-06-18T11:08:50.433Z","script":" local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal lp = Players.LocalPlayer\nlocal Buttons = workspace:WaitForChild(\"Buttons\")\n\n-- Function to create ESP for a button\nlocal function createESP(button)\n    local highlight = Instance.new(\"BoxHandleAdornment\")\n    highlight.Adornee = button.Parent\n    highlight.AlwaysOnTop = true\n    highlight.ZIndex = 5\n    highlight.Size = button.Parent.Size\n    highlight.Transparency = 0.5\n    highlight.Color3 = Color3.new(0, 1, 0) -- Neon green color\n    highlight.Parent = button.Parent\n    return highlight\nend\n\n-- Function to update ESP\nlocal function updateESP()\n    -- Remove existing ESP adornments\n    for _, child in pairs(Buttons:GetDescendants()) do\n        if child:IsA(\"BoxHandleAdornment\") then\n            child:Destroy()\n        end\n    end\n\n    -- Create new ESP adornments\n    for _, v in pairs(Buttons:GetDescendants()) do\n        if v:IsA(\"ProximityPrompt\") and v.Name == \"ButtonPrompt\" and v.Parent:FindFirstChild(\"PointLight\") and v.Parent:FindFirstChild(\"PointLight\").Enabled == true then\n            createESP(v)\n        end\n    end\nend\n\n-- Function to handle key press\nlocal function onKeyPress(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.B then\n        updateESP()\n    end\nend\n\n-- Connect the input event to the onKeyPress function\nUserInputService.InputBegan:Connect(onKeyPress) ","features":"Press B to activate","tags":[],"discord":"","keyLink":"","owner":{"_id":"650b108a6b50b6b31230b8af","username":"Maevers","verified":false,"profilePicture":{"url":"https://media.kocakz.me/82295f6d250952cb8675a9d309de27a01380809e173ff50096149b5c74d71a86.webp","original":"https://scriptblox.com/images/photo/650b108a6b50b6b31230b8af-1718709504928.png"},"status":"offline","id":"650b108a6b50b6b31230b8af","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/82295f6d250952cb8675a9d309de27a01380809e173ff50096149b5c74d71a86.webp","original":"https://scriptblox.com/images/photo/650b108a6b50b6b31230b8af-1718709504928.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:21:16.