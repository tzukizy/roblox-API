{"slug":"The-Ride-Anti-staff-auto-kick-13607","_id":"6658be1e01c49f10a07bd3f6","title":"Anti staff auto kick","game":{"_id":"67e5e1ffb360710ec3c78605","gameId":14911088043,"name":"[MOBILE UPDATE! 📱] The Ride","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14911088043},"features":"Safe you from staff when you auto farm","tags":[],"script":"local StaffRank = {\"Staff\", \"High Staff\", \"Admin\", \"Developer [ Drag Project ]\", \"Developer [ The Ride ]\", \"Owner\"}\n\nlocal Id = 33138186\n\n\n\nlocal function Verify(player)\n  if player:IsInGroup(Id) then\n        local role = player:GetRoleInGroup(Id)\n        for _, staffRole in ipairs(StaffRank) do\n            if role == staffRole then\n                game.Players.LocalPlayer:Kick(\"STAFF IN GAME [\"..player.name..\" Is Staff\")\n            else\n              print(player.name..\" Not\" ..role.. \"[ Safe ]\")\n              \n            end\n          \n        end\n  else\n    print(player.name..\" not in group\")\n  end\nend\n\nfor _, BB in game.Players:GetPlayers() do\n  \n  Verify(BB)\nend\n\ngame.Players.PlayerAdded:Connect(function(player)\n  Verify(player)\nend)","owner":{"_id":"664913c559d7566e81b3cb20","username":"ethandazy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"664913c559d7566e81b3cb20","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":14665,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-05-30T17:57:50.908Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/5c6b085a0058ae83f8dabe2dc84c6b36/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5c