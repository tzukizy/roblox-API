{"slug":"99-Nights-in-the-Forest-Inf-Candy-63551","_id":"690afe44f9af19a46eef1b30","title":"Inf Candy","game":{"_id":"68437b38a7d0bed5d5235e5c","gameId":79546208627805,"name":"99 Nights in the Forest 🔦","imageUrl":"/images/sb/rbx-ee923b1e9ac5564624ee9c484006166c-f56e8db3f7d9.png","placeId":79546208627805},"features":"Inf Candy\nYou can set true or false in the first line yourself","tags":["NightsintheForest","Nights in the Forest","Roblox"],"script":"_G.Auto = true --true or false\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Event = ReplicatedStorage.RemoteEvents.CarnivalCompleteShootingGallery\n\nlocal function findTargets(parent, depth)\n    if depth > 3 then return {} end\n    \n    local targets = {}\n    \n    for _, child in ipairs(parent:GetChildren()) do\n        if child:IsA(\"BasePart\") then\n            table.insert(targets, child)\n        end\n        \n        for _, subTarget in ipairs(findTargets(child, depth + 1)) do\n            table.insert(targets, subTarget)\n        end\n    end\n    \n    return targets\nend\n\nspawn(function()\n    while task.wait(3) do\n    \n        local targets = {}\n        local areas = {\n            workspace.Map,\n            workspace.Items, \n            workspace.Characters\n        }\n        \n        for _, area in ipairs(areas) do\n            for _, target in ipairs(findTargets(area, 0)) do\n                table.insert(targets, target)\n            end\n        end\n        \n        for index, target in ipairs(targets) do\n            if not _G.Auto then break end\n            \n            local success = pcall(function()\n                Event:FireServer(target)\n            end)\n            task.wait(0.05)\n        end\n    end\nend)","owner":{"_id":"675e20fca28d1257c7565f65","username":"ChuXia","verified":false,"profilePicture":"/images/photo/675e20fca28d1257c7565f65-1762328183283.png","status":"offline","id":"675e20fca28d1257c7565f65","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord.gg/Fq5MwymPt4","views":8837,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/79546208627805-1762328132238.png","likeCount":4,"dislikeCount":0,"createdAt":"2025-11-05T07:35:32.257Z","executes":22,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"690afe44f9af19a46eef1b32","editBy":{"_id":"675e20fca28d1257c7565f65","username":"ChuXia","status":"offline","id":"675e20fca28d1257c7565f65"},"message":"inf.lua","createdAt":"2025-11-05T07:35:32.262Z"}],"comments":[{"_id":"690b0263bb688c4383547a84","commentBy":{"_id":"680b27a28335c1f558305105","username":"The_admin_op_script","verified":false,"role":"user","profilePicture":"/images/photo/680b27a28335c1f558305105-1754179613916.jpg","createdAt":"2025-04-25T06:11:46.676Z","lastActive":"2025-12-24T03:54:01.470Z","status":"offline","id":"680b27a28335c1f558305105","topMilestone":{"key":"creator.followers","tier":10}},"text":"Can you do Gams?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-05T07:53:07.770Z","liked":false,"disliked":false},{"_id":"690b02c89d51712bc068900e","commentBy":{"_id":"675e20fca28d1257c7565f65","username":"ChuXia","verified":false,"role":"user","profilePicture":"/images/photo/675e20fca28d1257c7565f65-1762328183283.png","createdAt":"2024-12-15T00:21:16.865Z","lastActive":"2026-03-02T04:25:13.111Z","status":"offline","id":"675e20fca28d1257c7565f65","topMilestone":{"key":"creator.first_script","tier":1}},"text":"@The_admin_op_script ye","parent":{"_id":"690b0263bb688c4383547a84","commentBy":{"_id":"680b27a28335c1f558305105","username":"The_admin_op_script","profilePicture":"/images/photo/680b27a28335c1f558305105-1754179613916.jpg","status":"offline","id":"680b27a28335c1f558305105"},"text":"Can you do Gams?"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-05T07:54:48.081Z","liked":false,"disliked":false},{"_id":