\n        if child:IsA(\"BasePart\") then\n            table.insert(targets, child)\n        end\n        \n        for _, subTarget in ipairs(findTargets(child, depth + 1)) do\n            table.insert(targets, subTarget)\n        end\n    end\n    \n    return targets\nend\n\nspawn(function()\n    while task.wait(3) do\n    \n        local targets = {}\n        local areas = {\n            workspace.Map,\n            workspace.Items, \n            workspace.Characters\n        }\n        \n        for _, area in ipairs(areas) do\n            for _, target in ipairs(findTargets(area, 0)) do\n                table.insert(targets, target)\n            end\n        end\n        \n        for index, target in ipairs(targets) do\n            if not _G.Auto then break end\n            \n            local success = pcall(function()\n                Event:FireServer(target)\n            end)\n            task.wait(0.05)\n        end\n    end\nend)","features":"Inf Candy\nYou can set true or false in the first line yourself","tags":["NightsintheForest","Nights in the Forest","Roblox"],"discord":"https://discord.gg/Fq5MwymPt4","keyLink":"","owner":{"_id":"675e20fca28d1257c7565f65","username":"ChuXia","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9526236672f62429d55ff59061b7cbe5169216014f154641fccf693169c9af83.webp","original":"https://scriptblox.com/images/photo/675e20fca28d1257c7565f65-1762328183283.png"},"status":"offline","id":"675e20fca28d1257c7565f65","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/9526236672f62429d55ff59061b7cbe5169216014f154641fccf693169c9af83.webp","original":"https://scriptblox.com/images/photo/675e20fca28d1257c7565f65-1762328183283.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:55:03.874Z","last":"","win":14,"math":3},"isH