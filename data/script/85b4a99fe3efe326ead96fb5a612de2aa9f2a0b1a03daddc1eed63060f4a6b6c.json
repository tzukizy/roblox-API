{"slug":"UPD!-Hypershot-OPEN-SOURCE-Silent-Aim-239939","_id":"6a4183079099e2852d567edc","title":"OPEN SOURCE Silent Aim","game":{"_id":"6887efef8afb4b08db48b325","gameId":17516596118,"name":"[🔥NEW MYTHIC] Hypershot","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":17516596118},"features":"A undetected silent aim method p sure some other one was detected not sure tho i havent tested or looked at the anti cheat if it does have any\nKEEP IN MIND YOU CAN STILL GET MANUALY BANNED BY MODERATORS","tags":["Silent Aim","HyperShot","Undetected","Open Source","Source"],"script":"warn(\"Start !!\")\n-- // --\nlocal Plrs = game:GetService(\"Players\")\nlocal LclPlr = Plrs.LocalPlayer\nlocal Cam = workspace.CurrentCamera\nlocal Mse = LclPlr:GetMouse()\nlocal GameUiMod = require(LclPlr.PlayerGui.GameUI.GameUIMod)\nlocal GlbStf = require(game:GetService(\"ReplicatedStorage\").Modules.GlobalStuff)\nlocal Old = GameUiMod.GetMousePos\n-- // --\nlocal function GetTgt()\n    local Tgt\n    local Dist = math.huge\n    -- // --\n    for _, Val in Plrs:GetPlayers() do\n        if Val == LclPlr or not Val.Character then\n            continue\n        end\n        -- // --\n        local Chr = Val.Character\n        local Hum = Chr:FindFirstChild(\"Humanoid\")\n        if Chr:FindFirstChild(\"Head\") and Hum then\n            if Hum.Health > 0 and not GlbStf:SameTeam(LclPlr, Val) then\n                local Head = Chr.Head\n                local Pos, OnScr = Cam:WorldToViewportPoint(Head.Position)\n                -- // --\n                if OnScr then\n                    local MseDist = (Vector2.new(Mse.X, Mse.Y) - Vector2.new(Pos.X, Pos.Y)).Magnitude\n                    if MseDist < Dist then\n                        Dist = MseDist\n                        Tgt = Head\n                    end\n                end\n            end\n        end\n    end\n    -- // --\n    local Mobs = workspace:FindFirstChild(\"Mobs\")\n    if Mobs then\n        for _, Mob in Mobs:GetChildren() do\n            local Hum = Mob:FindFirstChild(\"Humanoid\")\n            if Mob:FindFirstChild(\"Head\") and Hum then\n                if Hum.Health > 0 and not GlbStf:SameTeam(LclPlr, Mob) then\n                    local Head = Mob.Head\n                    local Pos, OnScr = Cam:WorldToViewportPoint(Head.Position)\n                    -- // --\n                    if OnScr then\n                        local MseDist = (Vector2.new(Mse.X, Mse.Y) - Vector2.new(Pos.X, Pos.Y)).Magnitude\n                        if MseDist < Dist then\n                            Dist = MseDist\n                            Tgt = Head\n                        end\n                    end\n                end\n            end\n        end\n    end\n    -- // --\n    return Tgt\nend\n-- // --\nGameUiMod.GetMousePos = function(...)\n    local Src = debug.info(3, \"s\")\n    -- // --\n    if Src:find(\"Auto\") then\n        local Tgt = GetTgt()\n        -- // --\n        if Tgt then\n\t\t\t-- print(Tgt)\n            return Tgt.Position\n        end\n    end\n    -- // --\n    return Old(...)\nend\n-- // --\nwarn(\"Done !!\")\n","owner":{"_id":"6852be67fe7b473b704f584b","username":"deaggilisspees","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/d54f2b22b9388edd343dc6adc8446d08e4edd138733180194c93a25edb89721c.webp","original":"https://scriptblox.com/images/photo/6852be67fe7b473b704f584b-1775076993087.png"},"status":"offline","id":"6852be67fe7b473b704f584b","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/d54f2b22b9388edd343dc6adc8446d08e4edd138733180194c93a25edb89721c.webp","original":"https://scriptblox.com/images/photo/6852be67fe7b473b704f584b-1775076993087.png"}},"verified":true,"views":6829,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/im