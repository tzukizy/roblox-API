{"slug":"AURE-BASE-Brainrot-Ascension-go-to-spawn-and-go-to-end-open-source-265184","_id":"69dba0313ffa1ec82744999e","title":"go to spawn and go to end open source","game":{"_id":"69dba0313ffa1ec82744999a","gameId":73114021306475,"name":"[AURE BASE] Brainrot Ascension","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":73114021306475},"features":"features:\ngo to spawn\ngo to end\nthats all. im too lazy to make auto best rarity","tags":["open source"],"script":"local Xeno = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/itay299/RobloxScripts/refs/heads/main/Scripts/!MyLibrary\"))()\n\nlocal UI = Xeno:Create(\"Brainrot Ascension\", \"BrainrotAscension\")\nUI:BindToggle(\"Semicolon\")\n\nlocal player = game.Players.LocalPlayer\n\nlocal function tpTo(pos)\n    local char = player.Character or player.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n    hrp.CFrame = CFrame.new(pos)\nend\n\n-- Buttons\nUI:Button(\"Go to Spawn\", function()\n    tpTo(Vector3.new(-26, 1, 536.60))\nend)\n\nUI:Button(\"Go to End\", function()\n    tpTo(Vector3.new(3754, 1.25, 586.68))\nend)","owner":{"_id":"680a5b1e8fe2d5b198d0fd34","username":"becausewhyy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"680a5b1e8fe2d5b198d0fd34","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":773,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/b5a80df5f513e62e5e8e3bfbd7ddbc02dcb11a7ab4e41c07b3eec7bdbcb34824.webp","original":"https://scriptblox.com/images/sb/73114021306475-1776001073957.png","scriptblox":"https://scriptblox.com/images/script/73114021306475-1776001073957.png"},"likeCount":2,"dislikeCount":1,"cre