{"_id":"67ba680b42f850b2fcdff5b3","title":"Aimbot","game":{"_id":"67e5e1ffb360710ec3c77d73","gameId":7239319209,"name":"Ohio.","imageUrl":{"url":"https://media.kocakz.me/ce6f587dbd6f0e5e6f0eeb38153434672896e33059c4d67ccb8d61edc60a7c37.webp","original":"https://tr.rbxcdn.com/180DAY-927885c972ee86cd148e7bc0f9620de5/150/150/Image/Png/noFilter"},"slug":"7239319209-ohio","path":"/game/7239319209-ohio","thumbnail":{"url":"https://media.kocakz.me/ce6f587dbd6f0e5e6f0eeb38153434672896e33059c4d67ccb8d61edc60a7c37.webp","original":"https://tr.rbxcdn.com/180DAY-927885c972ee86cd148e7bc0f9620de5/150/150/Image/Png/noFilter"},"placeId":7239319209},"slug":"Ohio.-Aimbot-30040","verified":false,"key":false,"keyless":false,"views":10729,"executes":121,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-01f8eab3c83896ef9dd7c043cb3fdf70/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-01f8eab3c83896ef9dd7c043cb3fdf70/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-01f8eab3c83896ef9dd7c043cb3fdf70/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-01f8eab3c83896ef9dd7c043cb3fdf70/500/280/Image/Jpeg/noFilter"},"likeCount":0,"dislikeCount":2,"createdAt":"2025-02-23T00:12:59.670Z","updatedAt":"2025-02-23T00:12:59.670Z","lastBump":"2025-02-23T00:12:59.670Z","script":"```lua\nlocal Players = game:GetService(\"Players\")\nlocal UIS = game:GetService(\"UserInputService\")\nlocal localPlayer = Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\n\nUIS.InputBegan:Connect(function(input)\nif input.UserInputType == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.ButtonR2 then\nlocal closest = nil\nlocal maxDist = math.huge\n\nfor _, player in pairs(Players:GetPlayers()) do\nif player ~= localPlayer and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\nlocal distance = (player.Character.HumanoidRootPart.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude\nif distance < maxDist then\nclosest = player.Character.HumanoidRootPart\nmaxDist = distance\nend\nend\nend\n\nif closest then\ncamera.CFrame = CFrame.lookAt(camera.CFrame.Position, closest.Position)\nend\nend\nend)\n```","features":"Yes","tags":[],"discord":"","keyLink":"","owner":{"_id":"67a90ea28efbd8a821e82ceb","username":"zierewilliams90","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67a90ea28efbd8a821e82ceb","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:12:24.485Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c550f6","editBy":{"_id":"67a90ea28efbd8a821e82ceb","username":"zierewilliams90","status":"offline","id":"67a90ea28efbd8a821e82ceb"},"message":"Create script","createdAt":"2025-03-27T23:10:30.164Z"}],"comments":[]}