{"slug":"UPDATE-BloxStrike-No-Recoil-(Open-Source)-231784","_id":"6ac6ecddc2f20620a4cb754b","title":"No Recoil (Open Source)","game":{"_id":"68e92222467c47b2c34300cf","gameId":114234929420007,"name":"[NEW MAP] BloxStrike","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":114234929420007},"features":"just no recoil i got silent aim and no spread too and esp might post","tags":[],"script":"local gu = getupvalue or debug.getupvalue\nlocal cloneref = cloneref or function(o) return o end\nlocal ZERO = Vector3.new()\n\nlocal RS = cloneref(game:GetService(\"ReplicatedStorage\"))\nlocal RunService = cloneref(game:GetService(\"RunService\"))\nlocal lp = cloneref(game:GetService(\"Players\")).LocalPlayer\n\nlocal mods = getloadedmodules()\nlocal cam\nfor i = 1, #mods do\n    local ok, r = pcall(require, mods[i])\n    if ok and type(r) == \"table\" and type(r.setWeaponRecoil) == \"function\"\n       and type(r.weaponKick) == \"function\" then cam = r; break end\nend\nif not cam then return warn(\"hmmmmmm\") end\n\nlocal function hook(spring, method)\n    local orig = type(spring) == \"table\" and spring[method]\n    if type(orig) == \"function\" then\n        spring[method] = function(self, _, ...) return orig(self, ZERO, ...) end\n    end\nend\n\npcall(function()\n    hook(gu(cam.setWeaponRecoil, 1), \"setGoal\")\n    for u = 1, 2 do\n        local sp = gu(cam.weaponKick, u)\n        hook(sp, \"setPosition\"); hook(sp, \"impulse\"); hook(sp, \"setGoal\")\n    end\nend)\n\npcall(function()\n    require(RS.Interface.Screens.Gameplay.Middle.Crosshair.Settings)[\"Follow Recoil\"] = false\n\n    local frame = lp.PlayerGui.MainGui.Gameplay.Middle.Crosshair\n    local centre = UDim2.fromScale(0.5, 0.5)\n    RunService:BindToRenderStep(\"nr_pin\", Enum.RenderPriority.Last.Value, function()\n        if frame.Position ~= centre then\n            frame.Position = centre\n        end\n    end)\nend)","owner":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"verified":true,"keyless":false,"views":4091,"executes":8709,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/320abb0983957ed8ceda681f5d7e694469e2df69eb10f258e9939a12ec3a041d.webp","original":"https://scriptblox.com/images/sb/rbx-5de034057184c82666b530ef54e2898e-a4456a716291.png","scriptblox":"https://scriptblox.com/images/script/rbx-5de034057184c82666b530ef54e2898e-a4456a716291.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-10-08T01:07:41.371Z","editBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","status":"offline","id":"6227c42f7944271798ea1b15"},"keyLink":"","liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.2,"n":{"w":2,"b":0,"p":0,"d":0,"k":0},"total":2,"detected":false,"key":false,"recent":2,"at":"2026-10-15T21:25:22.849Z","last":"ww","win":14,"math":2,"upd":0},"thumbnail":{"url":"https://cdn.kocakz.me/images/320abb0983957ed8ceda681f5d7e694469e2df69eb10f258e9939a12ec3a041d.webp","original":"https://scriptblox.com/images/sb/rbx-5de034057184c82666b530ef54e2898e-a4456a716291.png","scriptblox":"https://scriptblox.com/images/script/rbx-5de034057184c82666b530ef54e2898e-a4456a716291.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ac6ecddc2f20620a4cb754d","editB