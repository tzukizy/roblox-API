oneref(game:GetService(\"Players\")).LocalPlayer\n\nlocal mods = getloadedmodules()\nlocal cam\nfor i = 1, #mods do\n    local ok, r = pcall(require, mods[i])\n    if ok and type(r) == \"table\" and type(r.setWeaponRecoil) == \"function\"\n       and type(r.weaponKick) == \"function\" then cam = r; break end\nend\nif not cam then return warn(\"hmmmmmm\") end\n\nlocal function hook(spring, method)\n    local orig = type(spring) == \"table\" and spring[method]\n    if type(orig) == \"function\" then\n        spring[method] = function(self, _, ...) return orig(self, ZERO, ...) end\n    end\nend\n\npcall(function()\n    hook(gu(cam.setWeaponRecoil, 1), \"setGoal\")\n    for u = 1, 2 do\n        local sp = gu(cam.weaponKick, u)\n        hook(sp, \"setPosition\"); hook(sp, \"impulse\"); hook(sp, \"setGoal\")\n    end\nend)\n\npcall(function()\n    require(RS.Interface.Screens.Gameplay.Middle.Crosshair.Settings)[\"Follow Recoil\"] = false\n\n    local frame = lp.PlayerGui.MainGui.Gameplay.Middle.Crosshair\n    local centre = UDim2.fromScale(0.5, 0.5)\n    RunService:BindToRenderStep(\"nr_pin\", Enum.RenderPriority.Last.Value, function()\n        if frame.Position ~= centre then\n            frame.Position = centre\n        end\n    end)\nend)","features":"just no recoil i got silent aim and no spread too and esp might post","tags":[],"discord":"","keyLink":"","owner":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.2,"n":{"w":2,"b":0,"p":0,"d":0,"k":0},"total":2,"detected":false,"key":false,"recent":0,"at":"2026-10-23T21:20:45.443Z","last":"ww","win":14,"math":4,"upd":0},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ac6ecddc2f20620a4cb754d","editBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","status":"offline","id":"6227c42f7944271798ea1b15"},"message":"Create script","createdAt":"2026-10-08T01:07:41.375Z"},{"_id":"6ac6ee44831efe0ad11b5d23","editBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","status":"offline","id":"6227c42f7944271798ea1b15"},"message":"fixed the cursor going up","createdAt":"2026-10-08T01:13:40.807Z"},{"_id":"6acc41b7a2ab5061ad7fea44","editBy":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","status":"offline","id":"6227c42f7944271798ea1b15"},"message":"Update script","createdAt":"2026-10-12T02:11:03.425Z"}],"comments":[{"_id":"6acb30ad191f0bafd398152f","commentBy":{"_id":"69741ffa9ee9e5ce93af9248","username":"TheGreatSar","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/82fe40dfccaa46fe8744c6529d8860b90ad5b8db0c59dedef54c96d86a7f97c9.webp","original":"https://scriptblox.com/images/photo/69741ffa9ee9e5ce93af9248-1791980872907.png"},"lastActive":"2026-10-23T09:31:03.239Z","createdAt":"2026-01-24T01:27:22.305Z","lvl":20,"status":"offline","id":"69741ffa9ee9e5ce93af9248","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/82fe40dfccaa46fe8744c6529d8860b90ad5b8db0c59dedef54c96d86a7f97c9.webp","original":"https://scriptblox.com/images/photo/69741ffa9ee9e5ce93af9248-1791980872907.png"}},"text":"w for making it open source bruv","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-10-11T06:46:05.749Z","liked":false,"disliked":false},{"_id":"6acb517cfe4cb5b977c38cdd","commentBy":{"_id":"6ac05d4fbbb1a0c6882528fc","username":"stalli",