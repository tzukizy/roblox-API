{"slug":"Universal-Script-Roblox-universal-reach-script-open-source-47410","_id":"6890053ee91336202bfd0195","title":"Roblox universal reach script open source","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1754268990087.png","placeId":0},"features":"reach\ncontact me : wiftyboy21\nmy discord  server : https://discord.gg/FNvnHhUP6m","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal reachSize = 10 -- reach size / distance anyways fuck you\n\nRunService.RenderStepped:Connect(function()\n    local char = player.Character\n    if not char then return end\n\n    for _, tool in pairs(char:GetChildren()) do\n        if tool:IsA(\"Tool\") and tool:FindFirstChild(\"Handle\") then\n            local handle = tool.Handle\n            handle.Size = Vector3.new(reachSize, reachSize, reachSize)\n            handle.Massless = true\n            handle.CanCollide = false\n        end\n    end\nend)\n","owner":{"_id":"6834d6956cf76c37ec8239c0","username":"syncc","verified":false,"profilePicture":"/images/photo/6834d6956cf76c37ec8239c0-1768954162333.png","status":"offline","id":"6834d6956cf76c37ec8239c0","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":1631,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1754268990087.png","likeCount":5,"dislikeCount":1,"createdAt":"2025-08-04T00:56:30.219Z","keyLink":"","executes":352,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6890053ee91336202bfd0198","editBy":{"_id":"6834d6956cf76c37ec8239c0","username":"syncc","status":"offline","id":"6834d6956cf76c37ec8239c0"},"message":"Create script","createdAt":"2025-08-04T00:56:30.225Z"}],"comments":[{"_id":"6916a770836c2528297462a1","commentBy":{"_id":"68f6c1ffa73faf2a229913