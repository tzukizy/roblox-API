{"_id":"6776b45da4cdd7b9b56ff73d","title":"auto V2","game":{"_id":"67e5e1ffb360710ec3c786c7","gameId":17142752129,"name":"Crack It!💆","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"17142752129-crack-it","path":"/game/17142752129-crack-it","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":17142752129},"slug":"Crack-It!-auto-V2-25858","verified":false,"key":false,"keyless":false,"views":8395,"executes":131,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter"},"likeCount":5,"dislikeCount":0,"createdAt":"2025-01-02T15:44:29.894Z","updatedAt":"2025-01-02T15:44:29.894Z","lastBump":"2025-01-02T15:44:29.894Z","script":"local player = game.Players.LocalPlayer\nlocal gui = player:WaitForChild(\"PlayerGui\"):WaitForChild(\"BarMiniGame\")\nlocal bar = gui:WaitForChild(\"Main\"):WaitForChild(\"BarBg\")\nlocal green = bar:WaitForChild(\"Green\")\nlocal slider = bar:WaitForChild(\"Slider\")\nlocal autoClicking = false\nlocal running = false\n\nlocal function click()\n    running = true\n    while autoClicking do\n        task.wait(0.007)\n        if slider and green then\n            local sliderPos = slider.AbsolutePosition\n            local greenPos = green.AbsolutePosition\n            local greenSize = green.AbsoluteSize\n            if sliderPos.X >= greenPos.X and sliderPos.X <= (greenPos.X + greenSize.X) then\n                local input = game:GetService(\"VirtualInputManager\")\n                if game:GetService(\"UserInputService\").TouchEnabled then\n                    input:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n                    task.wait(0.09)\n                    input:SendMouseButtonEvent(0, 0, 0, false, game, 0)\n                else\n                    input:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n                    task.wait(0.09)\n                    input:SendMouseButtonEvent(0, 0, 0, false, game, 0)\n                end\n            end\n        end\n    end\n    running = false\nend\n\nlocal function monitor()\n    gui:GetPropertyChangedSignal(\"Enabled\"):Connect(function()\n        if gui.Enabled then\n            autoClicking = true\n            if not running then\n                task.spawn(click)\n            end\n        else\n            autoClicking = false\n        end\n    end)\nend\n\nmonitor()\n","features":"V2 version is smoother and better and works on Pc & Mobiles","tags":["auto","Crack it","crack it","autofarm"],"discord":"","keyLink":"","owner":{"_id":"66f57fd5d56dd8085a8b51e3","username":"Zous","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff435566a18.webp","original":"https://scriptblox.com/images/photo/66f57fd5d56dd8085a8b51e3-1729628668273.png"},"status":"offline","id":"66f57fd5d56dd8085a8b51e3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff435566a18.webp","original":"https://scriptblox.com/images/photo/66f57fd5d56dd8085a8b51e3-1729628668273.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:10:36.140Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d53a","