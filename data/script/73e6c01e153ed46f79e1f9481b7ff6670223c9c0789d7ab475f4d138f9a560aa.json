{"_id":"69266ed58a95e85f3c4721b9","title":"Rato hub","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/41178a3e572751d0169175722529eb486a9c9145e6b3ed6fad7b353f20f6a5f5.webp","original":"https://scriptblox.com/images/sb/0-1764126421318.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/41178a3e572751d0169175722529eb486a9c9145e6b3ed6fad7b353f20f6a5f5.webp","original":"https://scriptblox.com/images/sb/0-1764126421318.jpg"},"placeId":0},"slug":"Universal-Script-Rato-hub-70170","verified":false,"key":false,"keyless":false,"views":576,"executes":1876,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/fc59f307bd702b81b64ccfd6058cf8c41004609fce68fe42435e7fff8b7d4787.webp","original":"https://scriptblox.com/images/sb/0-1764126421318.jpg","scriptblox":"https://scriptblox.com/images/script/0-1764126421318.jpg"},"thumbnail":{"url":"https://media.kocakz.me/fc59f307bd702b81b64ccfd6058cf8c41004609fce68fe42435e7fff8b7d4787.webp","original":"https://scriptblox.com/images/sb/0-1764126421318.jpg","scriptblox":"https://scriptblox.com/images/script/0-1764126421318.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-26T03:07:01.338Z","updatedAt":"2025-11-26T03:07:01.338Z","lastBump":"2025-11-26T03:07:01.338Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal savedPosition = nil\n\n-- Criar ScreenGui\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"TPGui\"\ngui.Parent = player:WaitForChild(\"PlayerGui\")\n\n-- Botão salvar posição\nlocal saveBtn = Instance.new(\"TextButton\")\nsaveBtn.Size = UDim2.new(0, 150, 0, 40)\nsaveBtn.Position = UDim2.new(0, 20, 0, 20)\nsaveBtn.Text = \"Salvar Posição\"\nsaveBtn.Parent = gui\n\n-- Botão teleportar\nlocal tpBtn = Instance.new(\"TextButton\")\ntpBtn.Size = UDim2.new(0, 150, 0, 40)\ntpBtn.Position = UDim2.new(0, 20, 0, 70)\ntpBtn.Text = \"Teleportar\"\ntpBtn.Parent = gui\n\n-- Salva posição do jogador\nsaveBtn.MouseButton1Click:Connect(function()\n    local char = player.Character or player.CharacterAdded:Wait()\n    local root = char:WaitForChild(\"HumanoidRootPart\")\n    savedPosition = root.Position\n    print(\"Posição salva:\", savedPosition)\nend)\n\n-- Teleporta o jogador\ntpBtn.MouseButton1Click:Connect(function()\n    if savedPosition then\n        local char = player.Character or player.CharacterAdded:Wait()\n        local root = char:WaitForChild(\"HumanoidRootPart\")\n        root.CFrame = CFrame.new(savedPosition)\n        print(\"Teleporte realizado!\")\n    else\n        warn(\"Nenhuma posição salva!\")\n    end\nend)\n","features":"Esse script e um script de teleporte, com um botão de salvar teleporte e teleportar","tags":[],"discord":"","keyLink":"","owner":{"_id":"691b766235f3d390dc9ec0b0","username":"Cleitu","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"691b766235f3d390dc9ec0b0","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:44:25.641Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69266ed58a95e85f3c4721bb","editBy":{"_id":"691b766235f3d390dc9ec0b0","username":"Cleitu","status":"offline","id":"691b766235f3d390dc9ec0b0"},"message":"Create script","createdAt":"2025-11-26T03:07:01.342Z"},{"_id":"69266f696dd12e3536401655","editBy":{"_id":"691b766235f3d390dc9ec0b0","username":"Cleitu","status":"offline","id":"691b766235f3d390dc9ec0b0"},"message":"Update script","createdAt":"2025-11-26T03:09:29.560Z"}],"comments":[{"_id":"692672d155dcfab03313