{"slug":"Universal-Script-talker-32737","_id":"67ddb6aa73dfe8a58f10e825","title":"talker","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"say :talk all {message}","tags":[],"script":"local players = game:GetService(\"Players\")\nlocal localplayer = players.LocalPlayer\nlocal chatservice = game:GetService(\"Chat\")\n\nlocalplayer.Chatted:Connect(function(msg)\n    local args = msg:split(\" \")\n    if args[1] == \":talk\" and args[2] and args[3] then\n        local target = args[2]\n        local message = msg:sub(#args[1] + #args[2] + 3)\n\n        if target == \"all\" then\n            for _, player in ipairs(players:GetPlayers()) do\n                if player.Character and player.Character:FindFirstChild(\"Head\") then\n                    chatservice:Chat(player.Character.Head, message, Enum.ChatColor.White)\n                end\n            end\n        else\n            local player = players:FindFirstChild(target)\n            if player and player.Character and player.Character:FindFirstChild(\"Head\") then\n                chatservice:Chat(player.Character.Head, message, Enum.ChatColor.White)\n            end\n        end\n    end\nend)\n","owner":{"_id":"67c38bc39dab27e9cd3825f1","username":"crischip123456","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"67c38bc39dab27e9cd3825f1","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":2054,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2025-03-21T18:57:46.047Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/ea6b622ed67bba7aff1c31d