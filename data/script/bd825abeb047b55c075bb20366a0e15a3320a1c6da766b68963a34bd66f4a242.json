") then\n                    chatservice:Chat(player.Character.Head, message, Enum.ChatColor.White)\n                end\n            end\n        else\n            local player = players:FindFirstChild(target)\n            if player and player.Character and player.Character:FindFirstChild(\"Head\") then\n                chatservice:Chat(player.Character.Head, message, Enum.ChatColor.White)\n            end\n        end\n    end\nend)\n","features":"say :talk all {message}","tags":[],"discord":"","keyLink":"","owner":{"_id":"67c38bc39dab27e9cd3825f1","username":"crischip123456","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67c38bc39dab27e9cd3825f1","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:51:57.902Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4dd88","editBy":{"_id":"67c38bc39dab27e9cd3825f1","username":"crischip123456","status":"offline","id":"67c38bc39dab27e9cd3825f1"},"message":"Create script","createdAt":"2025-03-21T19:02:27.621Z"},{"_id":"67e5e1e7b360710ec3c55d41","editBy":{"_id":"67c38bc39dab27e9cd3825f1","username":"crischip123456","status":"offline","id":"67c38bc39dab27e9cd3825f1"},"message":"Update script","createdAt":"2025-03-27T22:03:45.382Z"}],"comments":[]}