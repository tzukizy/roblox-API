layer.PlayerGui.money.pence.Text == _G.Pence then\nbreak\nelseif\ngame:GetService(\"Players\").LocalPlayer.PlayerGui.money.farthings.Text == _G.Farthings then\nbreak\nend\nend\nend\nend","owner":{"_id":"622fcb4230bf9906a9f14888","username":"MeatBall_Is_God","verified":true,"profilePicture":{"url":"https://media.kocakz.me/c7c29f0af3f993ac4a136712aeb06e761dd0fd08d32387c30ac5153e80bacd6f.webp","original":"https://scriptblox.com/images/photo/622fcb4230bf9906a9f14888-1744502996841.jpg"},"status":"offline","id":"622fcb4230bf9906a9f14888","leaderboard":{"tag":null},"topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/c7c29f0af3f993ac4a136712aeb06e761dd0fd08d32387c30ac5153e80bacd6f.webp","original":"https://scriptblox.com/images/photo/622fcb4230bf9906a9f14888-1744502996841.jpg"}},"verified":true,"views":38726,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-09-16T20:06:04.860Z","dislikeCount":1,"likeCount":3,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/4a5f355f6e8b56c1b664711159c387bb/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/4a5f355f6e8b56c1b664711159c387bb/500/280/Image/Jpeg"},"executes":41,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:22:00.145Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/4a5f355f6e8b56c1b664711159c387bb/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/4a5f355f6e8b56c1b664711159c387bb/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b989","editBy":{"_id":"622fcb4230bf9906a9f14888","username":"MeatBall_Is_God","status":"offline","id":"622fcb4230bf9906a9f14888"},"message":"Create script","createdAt":"2022-09-16T20:08:42.333Z