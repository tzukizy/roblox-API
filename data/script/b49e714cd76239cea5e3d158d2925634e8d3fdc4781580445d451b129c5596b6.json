{"slug":"Universal-Script-Decal-spam-f3x-108581","_id":"69897b6fe96ccd2956e77518","title":"Decal spam f3x","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1770617711256.png","placeId":0},"features":"Decals using f3x","tags":["febypaessssssssssssss"],"script":"local remote\n\nfor _, t in pairs(game.Players.LocalPlayer.Backpack:GetChildren()) do\n    if t:FindFirstChild(\"SyncAPI\") then\n        remote = t.SyncAPI.ServerEndpoint\n    end\nend\n\nfor _, t in pairs(game.Players.LocalPlayer.Character:GetChildren()) do\n    if t:FindFirstChild(\"SyncAPI\") then\n        remote = t.SyncAPI.ServerEndpoint\n    end\nend\n\nif not remote then return end\n\nlocal id = \"82935711171924\"\n\nlocal function addDecals(part)\n    for _, face in pairs({0,1,2,3,4,5}) do\n        remote:InvokeServer(\"CreateTextures\", {{Part = part, Face = face, TextureType = \"Decal\"}})\n        remote:InvokeServer(\"SyncTexture\", {{Part = part, Face = face, TextureType = \"Decal\", Texture = \"rbxassetid://\" .. id}})\n    end\nend\n\nlocal function spam()\n    for _, v in pairs(workspace:GetDescendants()) do\n        if v:IsA(\"BasePart\") or v:IsA(\"MeshPart\") or v:IsA(\"UnionOperation\") then\n            task.spawn(addDecals, v)\n        end\n    end\nend\n\nspam()\n\nwhile true do\n    task.wait(1.8)\n    spam()\nend","owner":{"_id":"697f40ee0d28d6d14f72314c","username":"0v3x281C4_Xzero","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"697f40ee0d28d6d14f72314c","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":1193,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1770617711256.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-02-09T06:15:11.272Z","executes":72,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69897b6fe96ccd2956e7751b","editBy":{"_id":"697f40ee0d28d