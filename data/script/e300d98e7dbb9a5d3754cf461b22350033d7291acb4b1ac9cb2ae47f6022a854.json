{"slug":"Clone-Tycoon-2-Infinite-Cash-(I-think)-3100","_id":"62980c06d50e166a42dc39ab","title":"Infinite Cash (I think)","game":{"_id":"67e5e1ffb360710ec3c78460","gameId":413424176,"name":"Clone Tycoon 2","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":413424176},"features":"Have an ore refinery and be close to it...","tags":[],"script":"function FindSelfTycoon()\n   for i,v in pairs(game:GetService(\"Workspace\").Tycoons:GetChildren()) do\n       if (v.Factory.Player.Value == game.Players.LocalPlayer.Name) then\n           return v\n       end\n   end\nend\n\nwhile true do\n   do\n       fireproximityprompt(FindSelfTycoon().Factory.Objects.BoughtItems[\"Ore Refinery\"].SpellVortex.Main.Attachment.SellOres)\n   end\n   \n   do\n       local minnerai = {\n           \"Coal\",\n           \"Iron\",\n           \"Gold\",\n           \"Diamonds\",\n           \"Stone\",\n       }\n   \n       for i,v in pairs(minnerai) do\n           workspace.Events.DataStores.uhoh:FireServer(\"mine\",v)\n       end\n   end\n\n   game.RunService.RenderStepped:Wait()\nend","owner":{"_id":"624b82fe917e7bffd3fc73a1","username":"Chig_Bungus","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/624b82fe917e7bffd3fc73a1-1649116403732.png"},"status":"offline","id":"624b82fe917e7bffd3fc73a1","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/624b82fe917e7bffd3fc73a1-1649116403732.png"}},"verified":false,"views":19398,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-06-02T01:01:58.273Z","dislikeCount":0,"likeCount":4,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://t4.rbxcdn.com/3f3ca0899ed8eded43cd8963596