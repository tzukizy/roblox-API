{"slug":"SILENCER-Corrupted-Crossroads-super-speed-69632","_id":"69247b854905845061b3edff","title":"super speed","game":{"_id":"68dadeb4ef86c1ca0c5a25fd","gameId":105457570355541,"name":"[JANUARY] Corrupted Crossroads","imageUrl":"/images/sb/rbx-36de6df8ce178bbfd1d8259d9aaf5724-c4b2d8c6aec9.png","placeId":105457570355541},"features":"super speed (customizable)","tags":["super speed","walkspeed","anticheat bypass"],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\n\nlocal SPEED = 100  -- Tweak this for faster speed\n\nlocal function getHumanoid()\n    return player.Character and player.Character:FindFirstChild(\"Humanoid\")\nend\n\n-- Initial set\nlocal humanoid = getHumanoid()\nif humanoid then\n    humanoid.WalkSpeed = SPEED\nend\n\n-- Loop: Enforces speed every frame (ignores game resets)\nRunService.Heartbeat:Connect(function()\n    local hum = getHumanoid()\n    if hum then\n        hum.WalkSpeed = SPEED\n    end\nend)\n\n-- Re-apply on respawn\nplayer.CharacterAdded:Connect(function(character)\n    character:WaitForChild(\"Humanoid\").WalkSpeed = SPEED\nend)","owner":{"_id":"67dea0a89a7e999f57399bfc","username":"titovvladislav623","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"67dea0a89a7e999f57399bfc","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":1693,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-0e4f447a7eae2f981bb2754087ed5d40-d48f62a68f87.png","likeCount":0,"dislikeCount":2,"createdAt":"2025-11-24T15:36:37.921Z","executes":409,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69247b854905845061b3ee01","editBy":{"_id":"67dea0a89a7e999f57399bfc","username":"titovvladislav623","status":"offline","id":"67dea0a89a7e999f57399bfc"},"message":"my greatest creation","createdAt":"2025-11-24T