{"slug":"Apocalypse-Rising-2-Bring-Containers-74872","_id":"693e2e61ccb38cc42761e663","title":"Open All Containers","game":{"_id":"67e5e1ffb360710ec3c77d7f","gameId":863266079,"name":"Apocalypse Rising 2","imageUrl":"/images/sb/rbx-a50c927293719b7f05e44f7a259c15ae-0b8a2ecd44c1.png","placeId":863266079},"features":"Title","tags":[],"script":"local ReplicatedFirst = game:GetService(\"ReplicatedFirst\")\nlocal ScriptContext = game:GetService(\"ScriptContext\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal Framework = require(ReplicatedFirst:FindFirstChild(\"Framework\"))\nFramework:WaitForLoaded()\n\nlocal Libraries = Framework.Libraries\nlocal Entities = Libraries.Entities\nlocal Network = Libraries.Network\n\ntask.spawn(function()\n    local Success, Error = pcall(function()\n        for _, Connection in getconnections(ScriptContext.Error) do\n            Connection:Disconnect()\n        end\n    end)\n\n    if not Success then\n        warn(Error)\n    end\nend)\n\nfor _, Element in pairs(Workspace.Map.Elements:GetChildren()) do\n    local Detail = Element:FindFirstChild(\"Detail\", true)\n    if not Detail then\n        continue\n    end\n\n    for _, Instance in pairs(Detail:GetChildren()) do\n        local Entity = Entities:Search(Instance)\n\n        if Entity and Entity.Type == \"Loot Group\" then\n            Network:Send(\"Client Interacted\", Entity.Id)\n        end\n    end\nend","owner":{"_id":"68c66f410e167a8f1d6c83d5","username":"Nullen","verified":false,"profilePicture":"/images/photo/68c66f410e167a8f1d6c83d5-1757836222408.jpg","status":"offline","id":"68c66f410e167a8f1d6c83d5","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":2401,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/863266079-1765682785616.webp","likeCount":2,"dislikeCount":2,"createdAt":"2025-12-14T03:26:25.638Z","keyLink":"","editBy":{"_id":"68c66f410e167a8f1d6c83d5","username":"Nullen","status":