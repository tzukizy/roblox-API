k\n\ntask.spawn(function()\n    local Success, Error = pcall(function()\n        for _, Connection in getconnections(ScriptContext.Error) do\n            Connection:Disconnect()\n        end\n    end)\n\n    if not Success then\n        warn(Error)\n    end\nend)\n\nfor _, Element in pairs(Workspace.Map.Elements:GetChildren()) do\n    local Detail = Element:FindFirstChild(\"Detail\", true)\n    if not Detail then\n        continue\n    end\n\n    for _, Instance in pairs(Detail:GetChildren()) do\n        local Entity = Entities:Search(Instance)\n\n        if Entity and Entity.Type == \"Loot Group\" then\n            Network:Send(\"Client Interacted\", Entity.Id)\n        end\n    end\nend","features":"Title","tags":[],"discord":"","keyLink":"","owner":{"_id":"68c66f410e167a8f1d6c83d5","username":"Nullen","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f7b721821650344d4bbb8d8b44ad2af6b9cd72502781ff1719c978046b5117e1.webp","original":"https://scriptblox.com/images/photo/68c66f410e167a8f1d6c83d5-1757836222408.jpg"},"status":"offline","id":"68c66f410e167a8f1d6c83d5","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/f7b721821650344d4bbb8d8b44ad2af6b9cd72502781ff1719c978046b5117e1.webp","original":"https://scriptblox.com/images/photo/68c66f410e167a8f1d6c83d5-1757836222408.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:27:20.756Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693e2e61ccb38cc42761e667","editBy":{"_id":"68c66f410e167a8f1d6c83d5","username":"Nullen","status":"offline","id":"68c66f410e167a8f1d6c83d5"},"message":"Create script","createdAt":"2025-12-14T03:26:25.644Z"},{"_id":"693f1dc79be37dfffd89603b","editBy":{"_id":"68c66f410e167a8f1d6c83d5","username":"Nullen","status":"offline","id":"68c66f410e167a8f1