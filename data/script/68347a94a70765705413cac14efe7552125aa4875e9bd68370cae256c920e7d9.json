{"_id":"69404394ccb38cc4278197be","title":"Hitbox","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/213e78c2156a4a7977227d2a3932d660cb448e203efa794fde60aa855c841d09.webp","original":"https://scriptblox.com/images/sb/0-1765819284817.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/213e78c2156a4a7977227d2a3932d660cb448e203efa794fde60aa855c841d09.webp","original":"https://scriptblox.com/images/sb/0-1765819284817.jpg"},"placeId":0},"slug":"Universal-Script-Hitbox-75284","verified":false,"key":false,"keyless":false,"views":1622,"executes":1392,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/832af71c3cd754bb6bcea3f34e8b0716f170eb2fe4db7b0eef3f71ace62e043a.webp","original":"https://scriptblox.com/images/sb/0-1765819284817.jpg","scriptblox":"https://scriptblox.com/images/script/0-1765819284817.jpg"},"thumbnail":{"url":"https://media.kocakz.me/832af71c3cd754bb6bcea3f34e8b0716f170eb2fe4db7b0eef3f71ace62e043a.webp","original":"https://scriptblox.com/images/sb/0-1765819284817.jpg","scriptblox":"https://scriptblox.com/images/script/0-1765819284817.jpg"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-12-15T17:21:24.831Z","updatedAt":"2025-12-15T17:21:24.831Z","lastBump":"2025-12-15T17:21:24.831Z","script":"-- CONFIGURAÇÕES\nlocal HITBOX_SIZE = Vector3.new(10, 10, 10) -- tamanho da hitbox\nlocal SPHERE_COLOR = Color3.fromRGB(255, 0, 0) -- vermelho\nlocal SPHERE_TRANSPARENCY = 0.6\n\n-- FUNÇÃO PRINCIPAL\nlocal function applyHitbox(character)\n\tlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\n\t-- Aumenta a hitbox\n\thumanoidRootPart.Size = HITBOX_SIZE\n\thumanoidRootPart.CanCollide = false\n\thumanoidRootPart.Transparency = 1 -- invisível\n\n\t-- Remove esfera antiga se existir\n\tif humanoidRootPart:FindFirstChild(\"HitboxSphere\") then\n\t\thumanoidRootPart.HitboxSphere:Destroy()\n\tend\n\n\t-- Cria a esfera visual\n\tlocal sphere = Instance.new(\"SphereHandleAdornment\")\n\tsphere.Name = \"HitboxSphere\"\n\tsphere.Adornee = humanoidRootPart\n\tsphere.Radius = HITBOX_SIZE.X / 2\n\tsphere.Color3 = SPHERE_COLOR\n\tsphere.Transparency = SPHERE_TRANSPARENCY\n\tsphere.AlwaysOnTop = true\n\tsphere.ZIndex = 5\n\tsphere.Parent = humanoidRootPart\nend\n\n-- APLICA EM TODOS OS PLAYERS\ngame.Players.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function(character)\n\t\ttask.wait(0.5)\n\t\tapplyHitbox(character)\n\tend)\nend)","features":"Aumente a minha hitbox, e deixe o jogo mais fácil.","tags":[],"discord":"","keyLink":"","owner":{"_id":"692a1aeff9ca06a48849c4d5","username":"MKcSCRIPTS","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"692a1aeff9ca06a48849c4d5","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:50:59.591Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69404394ccb38cc4278197c0","editBy":{"_id":"692a1aeff9ca06a48849c4d5","username":"MKcSCRIPTS","status":"offline","id":"692a1aeff9ca06a48849c4d5"},"message":"Create script","createdAt":"2025-12-15T17:21:24.833Z"}],"comments":[{"_id":"6940452abc7205ad0719785e","commentBy":{"_id":"685f44c3d0113c767862418b","username":"remotecontrol","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/61a5379f8e2ea9f459804b8af21dca044e20df9c652a12ec385bb6065f6968b5.webp","original":"https://scriptblox.com/images/photo/685f44c3d0113c767862418b-1754196331174.jpg"},"createdAt":"2025-06-28T01:26:27.156Z","lastActive":"2026-04-04T02:59:53.