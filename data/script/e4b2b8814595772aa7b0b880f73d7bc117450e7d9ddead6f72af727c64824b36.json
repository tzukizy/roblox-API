{"slug":"Universal-Script-HTTP-request-tester-37120","_id":"68099bf76d078cab6be6ded8","title":"HTTP request tester","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Tests you're executor if it supports HTTP request.","tags":[],"script":"local function getRequestFunction()\n    return (http_request or request or (syn and syn.request) or (fluxus and fluxus.request))\nend\n\nlocal requestFunc = getRequestFunction()\n\nif requestFunc then\n    print(\"Trying HTTP request...\")\n\n    local success, result = pcall(function()\n        return requestFunc({\n            Url = \"http://httpbin.org/get\", -- Safe public HTTP test endpoint\n            Method = \"GET\"\n        })\n    end)\n\n    if success and result and result.StatusCode == 200 then\n        print(\"HTTP Request successful! Executor supports HTTP.\")\n    else\n        warn(\"HTTP Request failed or response not OK.\")\n        if result then\n            warn(\"StatusCode:\", result.StatusCode)\n            warn(\"Body:\", result.Body)\n        end\n    end\nelse\n    warn(\"Your executor does not support HTTP requests.\")\nend","owner":{"_id":"67e9249b1a59c365c5936c93","username":"arbsturk","verified":false,"profilePicture":{"url":"https://media.kocakz.me/491f3d93cf8b5f71dfd99e1ee327b4687f1b001b9c08a9a82b96b2c606efcbbb.webp","original":"https://scriptblox.com/images/photo/67e9249b1a59c365c5936c93-1743332563580.png"},"status":"offline","id":"67e9249b1a59c365c5936c93","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/491f3d93cf8b5f71dfd99e1ee327b4687f1b001b9c08a9a82b96b2c606efcbbb.webp","original":"https://scriptblox.com/images/photo/67e9249b1a59c365c5936c93-1743332563580.png"}},"verified":false,"views":2096,"scriptType":"free","isUniversal":true,"isPatched":false,"