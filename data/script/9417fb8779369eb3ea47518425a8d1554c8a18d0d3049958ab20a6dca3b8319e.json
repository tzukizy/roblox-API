nt.new(getcustomasset(\"starborn.json\"))\n\n-- the roblox icon font we gotta leave alone (this is typically used for textlabels describing images so removing would turn images into texts)\nlocal badfont = tostring(Font.new(\"rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json\"))\n\nlocal function donttouch(this)\n    if this.TextStrokeTransparency ~= 1 then return false end\n    local cur = tostring(this.FontFace)\n    return cur == badfont or string.find(cur, \"BuilderIcons\")\nend\n\nlocal function changeit(txt)\n    if txt:IsA(\"TextLabel\") or txt:IsA(\"TextButton\") or txt:IsA(\"TextBox\") then\n        if not donttouch(txt) then\n            txt.FontFace = myfont\n        end\n    end\nend\n\n-- do everything that exists right now\nfor _, v in pairs(game:GetDescendants()) do\n    spawn(function() changeit(v) end)\nend\n\n-- new stuff\ngame.DescendantAdded:Connect(function(obj)\n    spawn(function() changeit(obj) end)\nend)\n\nfunction ln()\n    return \"made by lady noire\"\nend","features":"works like bloxstrap","tags":[],"discord":"","keyLink":"","owner":{"_id":"690ffd7f16269cc7bb747e89","username":"ladynoire","verified":false,"profilePicture":{"url":"https://media.kocakz.me/677a9f5c18f7d46df785f87140d9d26f5161921e30dbfb0b5d87d403cd039eff.webp","original":"https://scriptblox.com/images/photo/690ffd7f16269cc7bb747e89-1762670526469.png"},"status":"offline","id":"690ffd7f16269cc7bb747e89","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/677a9f5c18f7d46df785f87140d9d26f5161921e30dbfb0b5d87d403cd039eff.webp","original":"https://scriptblox.com/images/photo/690ffd7f16269cc7bb747e89-1762670526469.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:53:02.856Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog