{"_id":"68f369877bde9f29101bc337","title":"Deltarune Tenna simple morph","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d3e00fc995cac99a48607cdb27c2d70d83256123915441f7da12e6d9fc812fcc.webp","original":"https://scriptblox.com/images/sb/0-1760782727599.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d3e00fc995cac99a48607cdb27c2d70d83256123915441f7da12e6d9fc812fcc.webp","original":"https://scriptblox.com/images/sb/0-1760782727599.png"},"placeId":0},"slug":"Universal-Script-Deltarune-Tenna-simple-morph-59138","verified":false,"key":false,"keyless":false,"views":5724,"executes":2029,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/bb104bc4a054faa3832c1adadf7dadba5428a6cac750b54776161890b1b50b9c.webp","original":"https://scriptblox.com/images/sb/0-1760782727599.png","scriptblox":"https://scriptblox.com/images/script/0-1760782727599.png"},"thumbnail":{"url":"https://media.kocakz.me/bb104bc4a054faa3832c1adadf7dadba5428a6cac750b54776161890b1b50b9c.webp","original":"https://scriptblox.com/images/sb/0-1760782727599.png","scriptblox":"https://scriptblox.com/images/script/0-1760782727599.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-18T10:18:47.618Z","updatedAt":"2025-10-18T10:18:47.618Z","lastBump":"2025-10-18T10:18:47.618Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\n-- configs\nlocal Variant = \"Tenna\"\n\nlocal HatMeshID = \"rbxassetid://138977266310225\"\nlocal HatTextureID = \"rbxassetid://81342655410546\"\n\nlocal Variants = {\n    [\"Tenna\"] = {\n        Shirt = \"rbxassetid://102716611187263\",\n        Pants = \"rbxassetid://122608700035056\",\n        BodyColor = BrickColor.new(\"White\")\n    }\n}\n\nlocal function createMeshPart(name, meshId, textureId, scale)\n    local part = Instance.new(\"Part\")\n    part.Name = name\n    part.Size = Vector3.new(1, 1, 1)\n    part.CanCollide = false\n    part.Anchored = false\n    part.Transparency = 0\n    part.Parent = nil\n\n    local mesh = Instance.new(\"SpecialMesh\")\n    mesh.MeshType = Enum.MeshType.FileMesh\n    mesh.MeshId = meshId\n    mesh.TextureId = textureId\n    mesh.Scale = scale or Vector3.new(1, 1, 1)\n    mesh.Parent = part\n\n    return part\nend\n\nlocal function MorphPlayer()\n    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n    local variantData = Variants[Variant]\n    if not variantData then return end\n\n    for _, item in ipairs(character:GetChildren()) do\n        if item:IsA(\"Accessory\") or item:IsA(\"Hat\") or item:IsA(\"Shirt\") or item:IsA(\"Pants\") or item:IsA(\"ShirtGraphic\") then\n            item:Destroy()\n        end\n    end\n\n    local head = character:FindFirstChild(\"Head\")\n    if head then\n        for _, d in ipairs(head:GetChildren()) do\n            if d:IsA(\"Decal\") then d:Destroy() end\n        end\n    end\n\n    for _, part in ipairs(character:GetChildren()) do\n        if part:IsA(\"BasePart\") then\n            part.BrickColor = variantData.BodyColor\n        end\n    end\n\n    local shirt = Instance.new(\"Shirt\")\n    shirt.Name = \"It's\"\n    shirt.ShirtTemplate = variantData.Shirt\n    shirt.Parent = character\n\n    local pants = Instance.new(\"Pants\")\n    pants.Name = \"T V\"\n    pants.PantsTemplate = variantData.Pants\n    pants.Parent = character\n\n    if head then\n        local hat = createMeshPart(\"Time!\", HatMeshID, HatTextureID, Vector3.new(1.0, 1.0, 1.0))\n        hat.Parent = character\n\n        local weld = Instance.new(\"Weld\")\n        weld.Part0 = head\n        weld.Part1 = hat\n        weld.C0 = CFrame.new(-0.10, 0.9, -0.2)\n        weld.Parent = hat\n    end\nend\n\nLocalPlayer.CharacterAdded:Connect(function()\n    task.wait(1)\n    MorphPlayer()\nend)\n\nif LocalPlayer.Character then\n    task.wait(1)\n    MorphPlayer()\nend\n","features":"changes your character to the famous TV show host guy from deltarune chapter 3\n\nawesome morph\n\nget deltarune https://store.steampowered.com/app/1671210/DELTARUNE/\n\nfeelings of worthlessness and loneliness not included (unless you already have one)\n\nIT'S T V TIME!\n\nhas a small easteregg if you look at your character's hat mesh, shirt and pants name using something like dex explorer.\n\nrory nyte not included\n\nvideo showcase https://www.reddit.com/r/robloxhackers/comments/1o9s2tn/deltarune_tenna_morph_test/","tags":["tenna","deltarune","morph"],"discord":"","keyLink":"","owner":{"_id":"6738bf6d38523256d4446c75","username":"imdisplay","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7ae05ec435f40abac2f2f23b5656df2126e55cc1b7170c10768ca9e485b43c66.webp","original":"https://scriptblox.com/images/photo/6738bf6d38523256d4446c75-1761644320909.jpeg"},"status":"offline","id":"6738bf6d38523256d4446c75","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/7ae05ec435f40abac2f2f23b5656df2126e55cc1b7170c10768ca9e485b43c66.webp","original":"https://scriptblox.com/images/photo/6738bf6d38523256d4446c75-1761644320909.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:37:07.840Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f369877bde9f29101bc339","editBy":{"_id":"6738bf6d38523256d4446c75","username":"imdisplay","status":"offline","id":"6738bf6d38523256d4446c75"},"message":"Create script","createdAt":"2025-10-18T10:18:47.626Z"},{"_id":"68f36a1644cdd4abe7d7d0d1","editBy":{"_id":"6738bf6d38523256d4446c75","username":"imdisplay","status":"offline","id":"6738bf6d38523256d4446c75"},"message":"Update script","createdAt":"2025-10-18T10:21:10.987Z"}],"comments":[{"_id":"68f3