{"slug":"RoyaleHigh-The-Hunt!-ROYALE-HIGH-THE-HUNT-11403","_id":"65f846d0d26a5083f9738852","title":"ROYALE HIGH THE HUNT","game":{"_id":"67e5e1ffb360710ec3c780f8","gameId":735030788,"name":"Royale🎃High","imageUrl":"/images/sb/rbx-dfc7b7da37efc4e4d9a7d207370a1966-f7d9a18bd894.png","placeId":735030788},"features":"its not perfect you may have to adjust the delays i just made this fast for the badge\n\ni need friends https://discord.gg/ZJJTUcRs3Q","tags":["THEHUNT","ROYALE HIGH"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\nlocal eggsFolder = workspace.EggHuntMinigame.Eggs\nlocal nestClickbox = workspace.EggHuntMinigame.NestClickbox\nlocal eggClickedRemote = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"EasterEvent\"):WaitForChild(\"EggHuntRemotes\"):WaitForChild(\"EggClicked\")\n\nlocal function teleportAndInvokeEgg(part)\n    if part and part:IsA(\"BasePart\") then\n        humanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)\n        wait(0.1)\n\n        local args = { [1] = part.Name }\n        eggClickedRemote:InvokeServer(unpack(args))\n    end\nend\n\nwhile true do\n    local count = 0\n\n    for _, eggPart in ipairs(eggsFolder:GetChildren()) do\n        if count >= 10 then break end\n        teleportAndInvokeEgg(eggPart)\n        count = count + 1\n        wait(0.1)\n    end\n\n    humanoidRootPart.CFrame = nestClickbox.CFrame + Vector3.new(0, 3, 0)\n    wait(0.5)\nend","owner":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","verified":false,"profilePicture":"/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png","status":"offline","id":"64caa76229c6e48e1e6517b2","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":16537,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-03-18T13:51:12.200Z","dislikeCount":1,"likeCount":0,"image":"/images/sb/735030788-1710769872162.webp","executes":1604,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c506a4","editBy":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","status":"offline","id":"64caa76229c6e48e1e6517b2"},"message":"Create script","createdAt":"2025-03-27T00:33:11.343Z"}],"comments":[{"_id":"65f85d93d9c254aa706273e0","commentBy":{"_id":"625cbf533ca42ec1f3cbb504","username":"HourlyVoiceless","verified":false,"role":"user","profilePicture":"/images/photo/625cbf533ca42ec1f3cbb504-1773655486692.jpg","createdAt":"2022-04-18T01:30:59.628Z","lastActive":"2026-03-16T11:32:56.291Z","status":"offline","id":"625cbf533ca42ec1f3cbb504"},"text":"ty","createdAt":"2024-03-18T15:28:19.091Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"65f85ee4e997e5481ad26a00","commentBy":{"_id":"625cbf533ca42ec1f3cbb504","username":"HourlyVoiceless","verified":false,"role":"user","profilePicture":"/images/photo/625cbf533ca42ec1f3cbb504-1773655486692.jpg","createdAt":"2022-04-18T01:30:59.628Z","lastActive":"2026-03-16T11:32:56.291Z","status":"offline","id":"625cbf533ca42ec1f3cbb504"},"text":"@Aura could i know how you path? i cant use dex somehow (i tried the iy dex and odex)  that'd help  alot..","createdAt":"2024-03-18T15:33:56.449Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"65f87b9e049bd60773000770","commentBy":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","verified":false,"role":"user","profilePicture":"/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png","createdAt":"2023-08-02T18:58:42.161Z","lastActive":"2026-01-04T02:33:20.276Z","status":"offline","id":"64caa76229c6e48e1e6517b2","topMilestone":{"key":"creator.scripts","tier":25}},"text":"@Zynphxz i used the iy dex btw","createdAt":"2024-03-18T17:36:30.936Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"66010abf9e0c84be4d8c501f","commentBy":{"_id":"66010