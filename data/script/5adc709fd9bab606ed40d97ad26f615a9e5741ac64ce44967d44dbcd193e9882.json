.wait(0.5) -- small wait before checking dropoff points again\n\tend\nend)\n","owner":{"_id":"66c518aa80f5ab27c828ac0c","username":"cvvv","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"66c518aa80f5ab27c828ac0c","profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":4274,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/779caa5c8d0570b6f5aa971761162f5c33f8ac3e510125ea814ac343d31e6759.webp","original":"https://scriptblox.com/images/sb/583507031-1748727862605.webp","scriptblox":"https://scriptblox.com/images/script/583507031-1748727862605.webp"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-05-31T21:44:22.662Z","executes":16,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:00:47.636Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/779caa5c8d0570b6f5aa971761162f5c33f8ac3e510125ea814ac343d31e6759.webp","original":"https://scriptblox.com/images/sb/583507031-1748727862605.webp","scriptblox":"https://scriptblox.com/images/script/583507031-1748727862605.webp"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"683b78360b34d320e1bf06ae","editBy":{"_id":"66c518aa80f5ab27c828ac0c","username":"cvvv","status":"offline","id":"66c518aa80f5ab27c828ac0c"},"message":"Create script","createdAt":"2025-05-31T21:44:22.664Z"}],"comments":[{"_id":"683c499d059a9781e038de0b","commentBy":{"_id":"66c518aa80f5ab27c828ac0c","username":"cvvv","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"createdAt":"2024-08-20T22:28:58.303Z","lastActive":"2025-06-10T21:17:46.022Z","status":"offline","id":"66c518aa80f5ab27c828ac0c","profile":{"url":"https://cdn.kocakz.me/images