{"_id":"69362ed3d9a0d1f6b3a2933b","title":"Module X UI Library","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/42b8e6ded749cf1ede5ad33159c2dc9f886911c1098ab63b8def05efc2c22edf.webp","original":"https://scriptblox.com/images/sb/0-1765331598480.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/42b8e6ded749cf1ede5ad33159c2dc9f886911c1098ab63b8def05efc2c22edf.webp","original":"https://scriptblox.com/images/sb/0-1765331598480.png"},"placeId":0},"slug":"Universal-Script-Module-X-UI-Library-73284","verified":false,"key":false,"keyless":false,"views":1435,"executes":29,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/3140a91784aba191c23b22abb365aea26fa80b1f28816b955c2b720a59d53988.webp","original":"https://scriptblox.com/images/sb/0-1765331598480.png","scriptblox":"https://scriptblox.com/images/script/0-1765331598480.png"},"thumbnail":{"url":"https://media.kocakz.me/3140a91784aba191c23b22abb365aea26fa80b1f28816b955c2b720a59d53988.webp","original":"https://scriptblox.com/images/sb/0-1765331598480.png","scriptblox":"https://scriptblox.com/images/script/0-1765331598480.png"},"likeCount":2,"dislikeCount":2,"createdAt":"2025-12-08T01:50:11.437Z","updatedAt":"2025-12-08T01:50:11.437Z","lastBump":"2025-12-08T01:50:11.437Z","script":"local ModuleX = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Kyereal/ModuleX-UI-Library/refs/heads/main/Module%20X\"))()\nlocal UI = ModuleX.new()\n\n-- Loading Screen\nUI:SetLoadingText(\"Loading ModuleX...\")\nUI:SetCreditsText(\"kye._real\")\n\n-- Tabs\nUI:CreateTab(\"Universal\")\nUI:CreateTab(\"Random\")\n\n-- Buttons\nUI:AddButton(\"Universal\", \"Infinite Yield\", function()\n    loadstring(game:HttpGet('https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source'))()\nend)\n\nUI:AddButton(\"Random\", \"Print Hey\", function()\n\tprint(\"Hey\")\nend)\n\n-- Toggles\nUI:AddToggle(\"Universal\", \"Auto Farm\", false, function(state)\n    if state then\n        print(\"Auto farm turned ON\") -- Toggled\n    else\n        print(\"Auto farm turned OFF\") -- Not Toggled\n    end\nend)\n\n-- Slider Color\nUI:SetSliderColor(\"Green\")\n\n-- Slider\nUI:AddSlider(\"Universal\", \"WalkSpeed\", 16, 200, 16, function(value)\n    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = value\nend)","features":"I tried to script a UI Library, First time, send comments on what to add next it right now has buttons and etc. I got inspired by rayfield to try to do one of these. Some feature might not work. Ive only tested this on Xeno so idk about other executors. The slider color must come before the slider or else the slider wont work.\n\nModule X SetUp Commands\n\nUI:SetLoadingText(LoadingText)\nUI:SetCreditsText(CreditsName)\nUI:CreateTab(TabName)\nUI:AddButton(TabName, Button name)\nUI:AddToggle(tabName, text, defaultState)\nUI:AddSlider(tabName, text, min, max, defaultValue)\nUI:SetSliderColor(color)\n\nHow to use\nUI:AnyCommand(\"\")\n\nSilderColors:\n    Red = Color3.fromRGB(255,0,0)\n    Blue = Color3.fromRGB(0,170,255)\n    Green = Color3.fromRGB(0,255,0)\n    Yellow = Color3.fromRGB(255,255,0)\n    Purple = Color3.fromRGB(179,2,255)","tags":[],"discord":"https://discord.gg/52W5Fnwxs4","keyLink":"","owner":{"_id":"6836989add375eb082a5a93c","username":"Kyereal","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b9316e4a35a2e84ee05c7d242caf4a5f5f0318998b877c3fcbab2a3a14671c84.webp","original":"https://scriptblox.com/images/photo/6836989add375eb082a5a93c-1751374024015.jpg"},"status":"offline","id":"6836989add375eb082a5a93c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/b9316e4a35a2e84ee05c7d242caf4a5f5f0318998b877c3fcbab2a3a14671c84.webp","original":"https://scriptblox.com/images/photo/6836989add375eb082a5a93c-1751374024015.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:28:18.039Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69362ed3d9a0d1f6b3a2933d","editBy":{"_id":"6836989add375eb082a5a93c","username":"Kyereal","status":"offline","id":"6836989add375eb082a5a93c"},"message":"Create script","createdAt":"2025-12-08T01:50:11.441Z"},{"_id":"6938d28e06da572cb7e89f9d","editBy":{"_id":"6836989add375eb082a5a93c","username":"Kyereal","status":"offline","id":"6836989add375eb082a5a93c"},"message":"Added Toggle, Slider, SliderColor","createdAt":"2025-12-10T01:53:18.477Z"}],"comments":[{"_id":"69362f5fd9a0d1f6b3a29b42","commentBy":{"_id":"69362f1d53e4ff1d24eb1acf","username":"Thelon3lyguy123","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-03-21T10:38:44.376Z","createdAt":"2025-12-08T01:51:25.150Z","status":"offline","id":"69362f1d53e4ff1d24eb1acf","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"The start of something new W","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-12-08T01:52:31.839Z","liked":false,"disliked":false},{"_id":"69362f8e53e4ff1d24eb2140","commentBy":{"_id":"6836989add375eb082a5a93c","username":"Kyereal","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b9316e4a35a2e84ee05c7d242caf4a5f5f0318998b877c3fcbab2a3a14671c84.webp","original":"https://scriptblox.com/images/photo/6836989add375eb082a5a93c-1751374024015.jpg"},"createdAt":"2025-05-28T05:01:14.384Z","lastActive":"2026-10-17T23:50:38.648Z","status":"offline","id":"6836989add375eb082a5a93c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/b9316e4a35a2e84ee05c7d242caf4a5f5f0318998b877c3fcbab2a3a14671c84.webp","original"