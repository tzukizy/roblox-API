{"_id":"699f87df75756d91068bb10a","title":"fully automatic get plate script","game":{"_id":"67e5e1ffb360710ec3c77dd2","gameId":6403373529,"name":"[UPDATE👁️] Slap Battles👏","imageUrl":{"url":"https://media.kocakz.me/dc8c1e3bf18a83cd29d95e006e62b4e7c184904c2ba767254cc22d94a3ae5ea7.webp","original":"https://tr.rbxcdn.com/180DAY-8b6b8e78d4e680c9c4ce5d6f23e92db1/150/150/Image/Png/noFilter"},"slug":"6403373529-slap-battles","path":"/game/6403373529-slap-battles","thumbnail":{"url":"https://media.kocakz.me/dc8c1e3bf18a83cd29d95e006e62b4e7c184904c2ba767254cc22d94a3ae5ea7.webp","original":"https://tr.rbxcdn.com/180DAY-8b6b8e78d4e680c9c4ce5d6f23e92db1/150/150/Image/Png/noFilter"},"placeId":6403373529},"slug":"Slap-Battles-fully-automatic-get-plate-script-122178","verified":false,"key":false,"keyless":false,"views":2448,"executes":132,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/bb2b7e0437fe0f78cc2f8b4fc80c9d0b9f1467235fb16dca4e15661d3d296716.webp","original":"https://scriptblox.com/images/sb/rbx-01bb43634d02e38923c1543a029c95d5-a3dc77f03e62.png","scriptblox":"https://scriptblox.com/images/script/rbx-01bb43634d02e38923c1543a029c95d5-a3dc77f03e62.png"},"thumbnail":{"url":"https://media.kocakz.me/bb2b7e0437fe0f78cc2f8b4fc80c9d0b9f1467235fb16dca4e15661d3d296716.webp","original":"https://scriptblox.com/images/sb/rbx-01bb43634d02e38923c1543a029c95d5-a3dc77f03e62.png","scriptblox":"https://scriptblox.com/images/script/rbx-01bb43634d02e38923c1543a029c95d5-a3dc77f03e62.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-02-25T23:38:07.292Z","updatedAt":"2026-02-25T23:38:07.292Z","lastBump":"2026-02-25T23:38:07.292Z","script":"--this script uses best practices that have been approved by the state of israel ✅✅✅✅✅✅✅✅✅✅✅✅✅\n\nqueue_on_teleport([[\n\tlocal Players = game:GetService('Players')\n\tlocal LocalPlayer = Players.LocalPlayer\n\n\tlocal waxfiretouchinterest = firetouchinterest\n\tlocal firetouchinterest\n\tdo\n\t\tlocal test = Instance.new('Part')\n\t\tlocal s, r = pcall(waxfiretouchinterest, test, test, false) --good executor trust\n\t\tfiretouchinterest = (not s and r:find('number expected')) and function(p1, p2, b) return waxfiretouchinterest(p1, p2, b and 1 or 0) end or waxfiretouchinterest\n\tend\n\n\tworkspace:WaitForChild('Obstacles'):Destroy() --wow that was hard\n\n\t--for silly goyim who fall off (theres no obstacles so more like commit suicide willingly)\n\tdo\n\t\tlocal pos = Vector3.new(-260, 0, -260)\n\t\tlocal plate = Instance.new('Part')\n\t\tplate.Anchored = true\n\t\tplate.Size = Vector3.new(4e4, 10, 4e4)\n\t\tplate.Transparency = 1\n\t\tplate.CanCollide = false\n\t\tplate.Position = pos+Vector3.new(0, workspace.FallenPartsDestroyHeight, 0)\n\t\tworkspace.FallenPartsDestroyHeight = 0/0\n\t\tplate.Touched:Connect(function(v)\n\t\t\tif Players:GetPlayerFromCharacter(v:FindFirstAncestorWhichIsA('Model')) ~= LocalPlayer then\n\t\t\t\treturn\n\t\t\tend\n\t\t\tLocalPlayer.Character:MoveTo(pos+Vector3.new(0, 3, 0))\n\t\tend)\n\t\tplate.Parent = workspace\n\tend\n\n\t--putted it on the grid award ✅\n\tworkspace:GetAttributeChangedSignal('SpawnObstacles'):Once(function()\n\t\tlocal text = workspace:QueryDescendants('Part#Text >> TextLabel')[1]\n\t\tfor i = workspace:GetAttribute('Duration'), 1, -1 do\n\t\t\ttext.Text = tostring(i)\n\t\t\ttask.wait(1)\n\t\tend\n\t\ttext.Text = '✅'\n\tend)\n\n\t--get the glove sigma\n\tlocal hand = workspace:QueryDescendants('> Model > MeshPart#Hand')[1]\n\thand:GetPropertyChangedSignal('Transparency'):Connect(function()\n\t\tif hand.Transparency ~= 0 then\n\t\t\treturn\n\t\tend\n\t\tlocal char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n\t\tfor _,v in char:QueryDescendants('BasePart') do\n\t\t\tfiretouchinterest(v, hand, true)\n\t\t\ttask.defer(firetouchinterest, v, hand, false)\n\t\tend\n\tend)\n]])\n\ngame:GetService('TeleportService'):Teleport(106620300132058, game:GetService('Players').LocalPlayer)","features":"run it anywhere where the teleport permissions are in order\n\nyou dont have to do anything unlike the skidded script that PursuerDaCannibal2nd posted, its fully automatic just wait 2 minutes","tags":[],"discord":"","keyLink":"","owner":{"_id":"69587d0e08f999d584dbef29","username":"applesauce42","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f280ea0870fdd8f4fc99c78b6091eb450469f172cf472ca3e20dae08533f7181.webp","original":"https://scriptblox.com/images/photo/69587d0e08f999d584dbef29-1767406944940.jpg"},"status":"offline","id":"69587d0e08f999d584dbef29","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/f280ea0870fdd8f4fc99c78b6091eb450469f172cf472ca3e20dae08533f7181.webp","original":"https://scriptblox.com/images/photo/69587d0e08f999d584dbef29-1767406944940.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:39:41.066Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"699f87df75756d91068bb10d","editBy":{"_id":"69587d0e08f999d584dbef29","username":"applesauce42","status":"offline","id":"69587d0e08f999d584dbef29"},"message":"Create script","createdAt":"2026-02-25T23:38:07.296Z"}],"comments":[{"_id":"69a04b0b96d3ccea105c69b1","commentBy":{"_id":"6982c4e3e96ccd29567f4012","username":"a_m_i_r","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/18411f479dcc7afc4c452620f85d657b50ad5fac51dcc004e52decfda2945730.webp","original":"https://scriptblox.com/images/photo/6982c4e3e96ccd29567f4012-1773562894916.jpg"},"lastActive":"2026-04-30T03:46:00.150Z","createdAt":"2026-02-04T04:02:43.202Z","status":"offline","id":"6982c4e3e96ccd29567f4012","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/18411f479dcc7afc4c452620f85d657b50ad5