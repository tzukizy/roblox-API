{"slug":"Deltarune:-Connected-Noclip-and-Show-Collisions-89692","_id":"6972648763b88be833af1f9e","title":"Noclip and Show Collisions","game":{"_id":"6972648763b88be833af1f9b","gameId":12880465992,"name":"Deltarune: Connected","imageUrl":"/images/sb/rbx-f6b90b9687f23dda8e09a3b0e38fc65d-7423e972453f.png","placeId":12880465992},"features":"makes you noclip","tags":[],"script":"-- i didnt encrypt it because its easy to make such thing\nlocal collisions = game:GetService(\"Players\").LocalPlayer.PlayerGui.GameViewport.Main:WaitForChild(\"workspace\", 500):WaitForChild(\"Collisions\", 500)\nwhile task.wait() do\n    game:GetService(\"Players\").LocalPlayer.PlayerGui.GameViewport.Fade.BackgroundTransparency = 1\n    local collisions = game:GetService(\"Players\").LocalPlayer.PlayerGui.GameViewport.Main:WaitForChild(\"workspace\", 500):WaitForChild(\"Collisions\", 500)\n    for _, collision in ipairs(collisions:GetChildren()) do\n        if collision.Name == \"Collision\" then\n            collision:SetAttribute(\"CanCollide\", false)\n            collision.Visible = true\n        end\n        if collision.Name == \"Triangle\" then\n            collision:SetAttribute(\"CanCollide\", false)\n            collision.Visible = true\n        end\n        if collision.Name == \"DoorCollision\" then\n            collision.Visible = true\n            collision:SetAttribute(\"CanCollide\", true)\n        end\n        if collision.Name == \"SpawnMarker\" then\n            collision.Visible = true\n        end\n    end\nend","owner":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","verified":false,"profilePicture":"/images/photo/685d45da2206934a9cdfd06c-1756559314331.png","status":"offline","id":"685d45da2206934a9cdfd06c","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":2750,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/12880465992-1769117335481.png","likeCount":3,"dislikeCount":0,"createdAt":"2026-