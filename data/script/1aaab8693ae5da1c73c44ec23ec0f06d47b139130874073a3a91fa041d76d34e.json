{"_id":"68d1ba0990ad411225b425ba","title":"Auto Farm","game":{"_id":"68ccffd7934e08306bfe53a3","gameId":119574637420814,"name":"Be a Beggar!","imageUrl":{"url":"https://media.kocakz.me/94e37e5d93854ad9ab2447d0c71e5f8ad6f4dbb8578bb5b64fe166522b1bb0e3.webp","original":"https://tr.rbxcdn.com/180DAY-c1e053f85c8d2c06c5547676b5152e46/150/150/Image/Png/noFilter"},"slug":"119574637420814-be-a-beggar","path":"/game/119574637420814-be-a-beggar","thumbnail":{"url":"https://media.kocakz.me/94e37e5d93854ad9ab2447d0c71e5f8ad6f4dbb8578bb5b64fe166522b1bb0e3.webp","original":"https://tr.rbxcdn.com/180DAY-c1e053f85c8d2c06c5547676b5152e46/150/150/Image/Png/noFilter"},"placeId":119574637420814},"slug":"Be-a-Beggar!-Auto-Farm-54503","verified":false,"key":false,"keyless":false,"views":4880,"executes":22,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/043479bdf29440e3dc503c599934a15e09ea0085ce2244a15a61e228ef723e45.webp","original":"https://scriptblox.com/images/sb/rbx-2f0892abafd467933119e56b07c66585-244340b3d6e5.png","scriptblox":"https://scriptblox.com/images/script/rbx-2f0892abafd467933119e56b07c66585-244340b3d6e5.png"},"thumbnail":{"url":"https://media.kocakz.me/043479bdf29440e3dc503c599934a15e09ea0085ce2244a15a61e228ef723e45.webp","original":"https://scriptblox.com/images/sb/rbx-2f0892abafd467933119e56b07c66585-244340b3d6e5.png","scriptblox":"https://scriptblox.com/images/script/rbx-2f0892abafd467933119e56b07c66585-244340b3d6e5.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2025-09-22T21:05:13.945Z","updatedAt":"2025-09-22T21:05:13.945Z","lastBump":"2025-09-22T21:05:13.945Z","script":"-------------------------------\n_G.AutoBeg=true\n_G.AutoBuyUpgrades=true\n_G.AutoBuyEmployees=true\n_G.MoneyAura=true\n-------------------------------------\nlocal Replicate=game:GetService(\"ReplicatedStorage\")\nlocal MinigameEvent=Replicate.Remotes.MinigameEvent\nlocal Upgrade=Replicate.Remotes.Upgrade\nlocal Notification=Replicate.Remotes.Notification\nlocal BuyEmployee=Replicate.Remotes.BuyEmployee\nlocal Player=game.Players.LocalPlayer\nlocal Character=Player.Character or Player.CharacterAdded:Wait()\nlocal HRP=Character:WaitForChild(\"HumanoidRootPart\")\nlocal Money=workspace:WaitForChild(\"Money\")\ntask.spawn(function()while _G.AutoBeg do task.wait(0.0000000001)MinigameEvent:FireServer(true)end end)\ntask.spawn(function()while _G.AutoBeg do task.wait(0.0000000001)MinigameEvent:FireServer(true)end end)\ntask.spawn(function()while _G.AutoBeg do task.wait(0.0000000001)MinigameEvent:FireServer(true)end end)\ntask.spawn(function()while _G.AutoBeg do task.wait(0.0000000001)MinigameEvent:FireServer(true)end end)\ntask.spawn(function()while _G.AutoBeg do task.wait(0.0000000001)MinigameEvent:FireServer(true)end end)\ntask.spawn(function()while _G.AutoBuyUpgrades do task.wait(0.1)Upgrade:FireServer(\"Beg Power\")Upgrade:FireServer(\"Income\")Upgrade:FireServer(\"Box Tier\")Upgrade:FireServer(\"Alley Tier\")end end)\ntask.spawn(function()while _G.AutoBuyEmployees do for i=1,75 do if i~=13 and i~=14 then BuyEmployee:FireServer(i)task.wait(0.3)end end end end)\ntask.spawn(function()while _G.MoneyAura do\n    local OldCFrame=HRP.CFrame\n    for _,v in pairs(Money:GetDescendants())do\n        if v:IsA(\"ProximityPrompt\") and v.Parent:IsA(\"BasePart\")then\n            HRP.CFrame=v.Parent.CFrame + Vector3.new(0,3,0)\n            fireproximityprompt(v,0,true)\n        end\n    end\n    HRP.CFrame=OldCFrame\n    task.wait(0.5)\nend end)\nfiresignal(Notification.OnClientEvent,\"\",\"Thank you for using my script it means alot!\")","features":"# Open Source\n() I hated the current ones that were blocked behind a key-system so to combat that I created this free open source script!\n\n$ VIDEO OF THE SCRIPT - https://gofile.io/d/ct7V28\n\nFeatures:\n> Auto Beg - Must be in beg/sitting state (BASICALLY INFINITE MONEY)\n> Auto Buy Upgrades - Automatically buys all upgrades\n> Auto Buy Employees - Automatically buys exmployees for you\n> MoneyAura - Extended + autopick-ups money near you","tags":["Autofarm"],"discord":"","keyLink":"","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:55:43.322Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d1ba0990ad411225b425bc","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Create script","createdAt":"2025-09-22T21:05:13.947Z"},{"_id":"68d2f2ec1d12e20826a0cdff","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Added (Auto Money Aura - Auto pickups cash near you, extended distance. Auto Buy Employee's.)","createdAt":"2025-09-23T19:20:12.225Z"},{"_id":"68d3357f90ad411225eaf7ba","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Update script","createdAt":"2025-09-24T00:04:15.746Z"}],"comments":[{"_id":"68d1fe182b3cfa211986dbde","commentBy":{"_id":"68b312306aa51a06ce9d25b3","username":"Jaspyy","verified":false,"role":"user","profilePicture":{"url":"https://med