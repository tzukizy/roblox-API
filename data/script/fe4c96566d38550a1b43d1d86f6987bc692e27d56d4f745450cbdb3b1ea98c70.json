{"_id":"692b6f8a1e746d70d0b9e90a","title":"Fix Delta Sidebar","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/5289da86c1a4829134c2dde2cc2a50a1f7cb0bc8700eb8f50981df8d67bed723.webp","original":"https://scriptblox.com/images/sb/0-1764454282378.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/5289da86c1a4829134c2dde2cc2a50a1f7cb0bc8700eb8f50981df8d67bed723.webp","original":"https://scriptblox.com/images/sb/0-1764454282378.jpg"},"placeId":0},"slug":"Universal-Script-Fix-Delta-Sidebar-71185","verified":false,"key":false,"keyless":false,"views":870,"executes":290,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/b952949446e6e0117e50e5ff2a7b035fb36805aee956f2e1efd07ac28873c188.webp","original":"https://scriptblox.com/images/sb/0-1764454282378.jpg","scriptblox":"https://scriptblox.com/images/script/0-1764454282378.jpg"},"thumbnail":{"url":"https://media.kocakz.me/b952949446e6e0117e50e5ff2a7b035fb36805aee956f2e1efd07ac28873c188.webp","original":"https://scriptblox.com/images/sb/0-1764454282378.jpg","scriptblox":"https://scriptblox.com/images/script/0-1764454282378.jpg"},"likeCount":5,"dislikeCount":0,"createdAt":"2025-11-29T22:11:22.407Z","updatedAt":"2025-11-29T22:11:22.407Z","lastBump":"2025-11-29T22:11:22.407Z","script":"local cloneref=cloneref or clonereference or function(i)return i end\nlocal cg=cloneref(game:GetService(\"CoreGui\"))\n\nlocal function w(f)\n    local l,s,n=f.Position,0,.05\n    repeat\n        local c=f.Position\n        s=c~=l and 0 or s+.05\n        l=c\n        task.wait(.05)\n    until s>=n\nend\n\nlocal function g()\n    for _,o in cg:GetDescendants()do\n        if o.Name==\"Sidebar\"and o:IsA(\"Frame\")then\n            local p=o.Parent\n            if p and p:FindFirstChild(\"Console\")and p:FindFirstChild(\"Executor\")and p:FindFirstChild(\"Home\")and p:FindFirstChild(\"Scripthub\")and p:FindFirstChild(\"Settings\")then\n                return o\n            end\n        end\n    end\nend\n\nlocal b=g()\nif b then\n    b:GetPropertyChangedSignal(\"Position\"):Connect(function()\n        local p=b.Position\n        if p.X.Scale>1 then\n            task.spawn(function()\n                w(b)\n                if b.Parent and b.Position.X.Scale>1 then\n                    b.Position=UDim2.new(1.1,0,p.Y.Scale,p.Y.Offset)\n                end\n            end)\n        end\n    end)\nend","features":"I’m not totally sure if this works on every device, but it works on mine B). Some phones show this little sidebar line on the right side when you minimize delta, and it’s kinda annoying, so I wrote this simple script to fix it","tags":[],"discord":"","keyLink":"","owner":{"_id":"6921d3bfa9367369fc955862","username":"Ohmagic","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d4d3c7d2722e6f1967ab66fac56a6a1afb325343fdd5643ee415838fb867d2b2.webp","original":"https://scriptblox.com/images/photo/6921d3bfa9367369fc955862-1763824743757.jpg"},"status":"offline","id":"6921d3bfa9367369fc955862","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/d4d3c7d2722e6f1967ab66fac56a6a1afb325343fdd5643ee415838fb867d2b2.webp","original":"https://scriptblox.com/images/photo/6921d3bfa9367369fc955862-1763824743757.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:48:03.181Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"692b6f8a1e746d70d0b9e90c","editBy":{"_id":"6921d3bfa9367369fc955862","username":"Ohmagic","status":"offline","id":"6921d3bfa9367369fc955862"},"message":"Create script","createdAt":"2025-11-29T22:11:22.411Z"}],"comments":[{"_id":"692b7dd256c2667edbbcdd47","commentB