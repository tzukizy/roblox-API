{"slug":"Reminiscence-Zombies-Kill-all-open-source-244702","_id":"6a602e33a3bee6f2fcaa8f65","title":"Kill all open source","game":{"_id":"67e5e1ffb360710ec3c78741","gameId":2778230703,"name":"Reminiscence Zombies","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":2778230703},"features":"a simple kill all loop, useful for xp farming.","tags":[],"script":"-- DISCORD: 1_aegis\n-- got to wave 11 with this on nacht no problem.\n-- bricks ur game (cant shoot, run, but you can use ur knife.)\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Lighting = game:GetService(\"Lighting\")\n\nlocal LocalPlayer = Players.LocalPlayer\nlocal Functions = require(ReplicatedStorage:WaitForChild(\"Functions\"))\nlocal ETC = Lighting:WaitForChild(\"ETC\")\nlocal Hit_Object = Lighting:WaitForChild(\"Hit_Object\")\n\nlocal KnifeModel = ReplicatedStorage:WaitForChild(\"Resources\"):WaitForChild(\"Models\"):FindFirstChild(\"KnifeM\")\nlocal Handle = KnifeModel and KnifeModel:FindFirstChild(\"Handle\")\n\nlocal Damage = 1e9 \n\nlocal function killZombies()\n    local Character = LocalPlayer.Character\n    if not Character then return end\n    \n    local KG = Character:FindFirstChild(\"KG\")\n    if not KG then\n        KG = Instance.new(\"IntValue\")\n        KG.Name = \"KG\"\n        KG.Parent = Character\n    end\n    \n    local LeftArm = Character:FindFirstChild(\"Left Arm\") or Character:FindFirstChild(\"LeftHand\")\n    local Zombies = workspace:FindFirstChild(\"Zombies\")\n    local SpecialZ = workspace:FindFirstChild(\"SpecialZ\")\n    \n    local function damageZombie(Zombie)\n        local Humanoid = Zombie:FindFirstChild(\"Humanoid\")\n        local Torso = Zombie:FindFirstChild(\"Torso\") or Zombie:FindFirstChild(\"Head\") \n        \n        if Humanoid and Torso and Humanoid.Health > 0 then\n            Functions.UntagHumanoid(Humanoid)\n            Functions.TagHumanoid(Humanoid, LocalPlayer)\n            Humanoid:TakeDamage(Damage)\n            ETC:FireServer({\n                Humanoid,\n                Damage,\n                \"Damage6🐙\",\n                nil,\n                nil,\n                nil,\n                nil,\n                nil,\n                {\n                    KnifeHit = 0\n                }\n            })\n            \n            if Handle and LeftArm then\n                Hit_Object:FireServer({\n                    \"GK\",\n                    LocalPlayer,\n                    LeftArm,\n                    Handle,\n                    Torso.CFrame,\n                    CFrame.identity,\n                    0.55,\n                    KnifeModel\n                })\n            end\n        end\n    end\n\n    if Zombies then\n        for _, Zombie in pairs(Zombies:GetChildren()) do\n            damageZombie(Zombie)\n        end\n    end\n    \n    if SpecialZ then\n        for _, Zombie in pairs(SpecialZ:GetChildren()) do\n            damageZombie(Zombie)\n        end\n    end\nend\n\nwhile task.wait(0.5) do\n    pcall(killZombies)\nend","owner":{"_id":"62c14c3f5407a361d65731e7","username":"Aegis","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/84afffcf637155da491f17573444a5ec913306b720db1cfc34cb71c858e1caa2.webp","original":"https://scriptblox.com/images/photo/62c14c3f5407a361d65731e7-1732918494186.png"},"status":"offline","id":"62c14c3f5407a361d65731e7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/84afffcf637155da491f17573444a5ec913306b720db1cfc34cb71c858e1caa2.webp","original":"https://scriptblox.com/images/photo/62c14c3f5407a361d65731e7-1732918494186.png"}},"verified":false,"views":2597,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/1f64c947430b0d23de201b36da74