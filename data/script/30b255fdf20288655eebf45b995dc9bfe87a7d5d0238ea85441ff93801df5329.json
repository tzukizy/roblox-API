{"_id":"6922d91f79a38095a3ce9a0b","title":"Esp, must copy from the scriptblox to work","game":{"_id":"6922d91f79a38095a3ce9a08","gameId":138017076597011,"name":"Ready to act REWRITE Development *NEW MAP+UPDATE*","imageUrl":{"url":"https://media.kocakz.me/3964d7d6912b72adbae2b08c6ca4c294acc58be39f5535f6f5af7891fbe302cf.webp","original":"https://scriptblox.com/images/sb/rbx-8f74539147835223d1266ba6a2d7d0ba-1c599feb5c2f.png"},"slug":"138017076597011-ready-to-act-rewrite-development-new-map-update","path":"/game/138017076597011-ready-to-act-rewrite-development-new-map-update","thumbnail":{"url":"https://media.kocakz.me/3964d7d6912b72adbae2b08c6ca4c294acc58be39f5535f6f5af7891fbe302cf.webp","original":"https://scriptblox.com/images/sb/rbx-8f74539147835223d1266ba6a2d7d0ba-1c599feb5c2f.png"},"placeId":138017076597011},"slug":"Ready-to-act-REWRITE-Development-*NEW-MISSION*-Esp-red-is-suspect-69159","verified":false,"key":false,"keyless":false,"views":2317,"executes":896,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/b96c70455c6fd994ef023282e28174ad7fb5c7724f6e574b99509d9406ead0ae.webp","original":"https://scriptblox.com/images/sb/rbx-806c79ccb6a657b89fa99ea572abb7bb-7dd897f1d055.png","scriptblox":"https://scriptblox.com/images/script/rbx-806c79ccb6a657b89fa99ea572abb7bb-7dd897f1d055.png"},"thumbnail":{"url":"https://media.kocakz.me/b96c70455c6fd994ef023282e28174ad7fb5c7724f6e574b99509d9406ead0ae.webp","original":"https://scriptblox.com/images/sb/rbx-806c79ccb6a657b89fa99ea572abb7bb-7dd897f1d055.png","scriptblox":"https://scriptblox.com/images/script/rbx-806c79ccb6a657b89fa99ea572abb7bb-7dd897f1d055.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2025-11-23T09:51:27.335Z","updatedAt":"2025-11-23T09:51:27.335Z","lastBump":"2025-11-23T09:51:27.335Z","script":"local SUSPECT_NAME = \"Suspect\"\nlocal CIVILIAN_NAME = \"Civilian\"\n\nlocal function addOutline(model, fillColor)\n    -- Prevent duplicates\n    if model:FindFirstChild(\"OutlineHighlight\") then return end\n\n    local highlight = Instance.new(\"Highlight\")\n    highlight.Name = \"OutlineHighlight\"\n    highlight.FillColor = fillColor\n    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n    highlight.FillTransparency = 0.5\n    highlight.OutlineTransparency = 0\n    highlight.Parent = model\nend\n\nlocal function processModel(obj)\n    if not obj:IsA(\"Model\") then return end\n\n    if obj.Name == SUSPECT_NAME then\n        addOutline(obj, Color3.fromRGB(255, 0, 0)) -- Red\n    elseif obj.Name == CIVILIAN_NAME then\n        addOutline(obj, Color3.fromRGB(0, 255, 0)) -- Green\n    end\nend\n\n-- Apply to existing models\nfor _, obj in ipairs(workspace:GetDescendants()) do\n    processModel(obj)\nend\n\n-- Apply to models added later\nworkspace.DescendantAdded:Connect(function(obj)\n    processModel(obj)\nend)","features":"esp by ai","tags":[],"discord":"","keyLink":"","owner":{"_id":"68414ec5a7d0bed5d5ea6da5","username":"epicabadir","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"68414ec5a7d0bed5d5ea6da5","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:48:35.203Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6922d91f79a38095a3ce9a0d","editBy":{"_id":"68414ec5a7d0bed5d5ea6da5","username":"epicabadir","status":"offline","id":"68414ec5a7d0bed5d5ea6da5"},"message":"Create script","createdAt":"2025-11-23T09:51:27.339Z"},{"_id":"6957b62c114424dfe9a6af41","editBy":{"_id":"68414ec5a7d0bed5d5ea6da5","username":"epicabadir","status":"offline","id":"68414ec5a7d0bed5d5ea6da5"},"message":"Updat