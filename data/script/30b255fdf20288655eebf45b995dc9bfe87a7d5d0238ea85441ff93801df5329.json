{"slug":"Ready-to-act-REWRITE-Development-*NEW-MISSION*-Esp-red-is-suspect-69159","_id":"6922d91f79a38095a3ce9a0b","title":"Esp, must copy from the scriptblox to work","game":{"_id":"6922d91f79a38095a3ce9a08","gameId":138017076597011,"name":"Ready to act REWRITE Development *NEW MAP+UPDATE*","imageUrl":"/images/sb/rbx-8f74539147835223d1266ba6a2d7d0ba-1c599feb5c2f.png","placeId":138017076597011},"features":"esp by ai","tags":[],"script":"local SUSPECT_NAME = \"Suspect\"\nlocal CIVILIAN_NAME = \"Civilian\"\n\nlocal function addOutline(model, fillColor)\n    -- Prevent duplicates\n    if model:FindFirstChild(\"OutlineHighlight\") then return end\n\n    local highlight = Instance.new(\"Highlight\")\n    highlight.Name = \"OutlineHighlight\"\n    highlight.FillColor = fillColor\n    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n    highlight.FillTransparency = 0.5\n    highlight.OutlineTransparency = 0\n    highlight.Parent = model\nend\n\nlocal function processModel(obj)\n    if not obj:IsA(\"Model\") then return end\n\n    if obj.Name == SUSPECT_NAME then\n        addOutline(obj, Color3.fromRGB(255, 0, 0)) -- Red\n    elseif obj.Name == CIVILIAN_NAME then\n        addOutline(obj, Color3.fromRGB(0, 255, 0)) -- Green\n    end\nend\n\n-- Apply to existing models\nfor _, obj in ipairs(workspace:GetDescendants()) do\n    processModel(obj)\nend\n\n-- Apply to models added later\nworkspace.DescendantAdded:Connect(function(obj)\n    processModel(obj)\nend)","owner":{"_id":"68414ec5a7d0bed5d5ea6da5","username":"epicabadir","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68414ec5a7d0bed5d5ea6da5","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2277,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-806c79ccb6a657b89fa99ea572abb7bb-7dd897f1d055.png","likeCount":3,"dislikeCount":1,"createdAt":"2025-11-23T09:51:27.335Z","keyLink":"","editBy":{"_id":