{"slug":"Universal-Script-Hitbox-Expander-48375","_id":"689b941c25c96d2a678547b2","title":"Hitbox Expander","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1755026460409.jpg","placeId":0},"features":"Just a simple hitbox expander","tags":["universal","script","op","esp","anything"],"script":"--[[\n\nIf you want it except your team \nChange this code\nif v.Name ~= lp.Name then\nTo\nif v.Name ~= lp.Name  and v.Team ~= lp.Team then\n\n]]\n\nlocal rs=game:GetService\"RunService\"local rsd=rs.RenderStepped\nlocal lp=game.Players.LocalPlayer\nlocal hs = 30 -- hitbox size\nlocal bool = true\nx, y, z = hs, hs ,hs\n\nrsd:connect(\n    function()\n        if bool then\n            for i, v in next, game:GetService\"Players\":GetPlayers() do\n                if v.Name ~= lp.Name then\n                    pcall(\n                        function()\n                            v.Character.HumanoidRootPart.Size = Vector3.new(x, y, z)\n                            v.Character.HumanoidRootPart.Transparency = 0.7\n                            v.Character.HumanoidRootPart.CanCollide = false\n                        end\n                    )\n                end\n            end\n        end\n    end\n)","owner":{"_id":"67ca85400a02aba600298259","username":"uxni","verified":false,"profilePicture":"/images/photo/67ca85400a02aba600298259-1774596328783.jpg","status":"offline","id":"67ca85400a02aba600298259","topMilestone":{"key":"creator.executions","tier":100000}},"verified":false,"views":3385,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1755026460409.jpg","likeCount":1,"dislikeCount":0,"createdAt":"2025-08-12T19:21:00.431Z","executes":161,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"689b941c25c96d2a678547b4","editBy":{"_id":"67ca85400a02aba600298259","username":"uxni","status":"offline","id":"67ca85400a02aba600298259"},