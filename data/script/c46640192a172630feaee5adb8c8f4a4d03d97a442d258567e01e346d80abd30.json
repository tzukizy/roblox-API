{"slug":"10000-Ultimate-Obby-2.0-Open-source-stage-giver-(slow-but-effective)-226277","_id":"6a9572e0b3946ae81fc66906","title":"Open source stage giver (slow but effective)","game":{"_id":"6a9572e0b3946ae81fc66905","gameId":3934295745,"name":"[10000] Ultimate Obby 2.0","imageUrl":"/images/sb/rbx-71ddca0737a3f0760ab3b177a5369025-653d2520bbe0.png","placeId":3934295745},"features":"waits 0.1 secs with a while wait loop! then fires touch intrests, btw no ai was used making this so enjoy and also i updated it so it gives every badge","tags":[],"script":"local function getbadges()\n    for _, badgeinterest in workspace.Badges:GetDescendants() do\n    if badgeinterest:IsA(\"TouchTransmitter\") then\n        firetouchinterest(game.Players.LocalPlayer.Character.Torso, badgeinterest.Parent, 0)\n        end\n    end\nend\nlocal currentstage = game.Players.LocalPlayer.leaderstats.Stage.Value\nspawn(getbadges)\nwhile wait(0.1) do\n    currentstage+=1\n    firetouchinterest(game.Players.LocalPlayer.Character.Torso, workspace.levels:FindFirstChild(tostring(currentstage)), 0)\nend","owner":{"_id":"6a4208df53c5d1df064ea225","username":"IdkWhatToPutHereabj","verified":false,"profilePicture":"/images/photo/6a4208df53c5d1df064ea225-1782712640659.jpg","status":"offline","id":"6a4208df53c5d1df064ea225","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":266,"executes":669,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-71ddca0737a3f0760ab3b177a5369025-653d2520bbe0.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-08-31T12:26:08.912Z","keyLink":"","editBy":{"_id":"6a4208df53c5d1df064ea225","username":"IdkWhatToPutHereabj","status":"offline","id":"6a4208df53c5d1df064ea225"},"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a9572e0b3946ae81fc66908","editBy":{"_id":"6a4208df53c5d1df064ea225","username":"IdkWhatToPutHereabj","status":"offline","id":"6a4