{"slug":"Universal-Script-F5-36585","_id":"68055d9b2ba4bae0a33156b5","title":"F5","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1745182107002.png","placeId":0},"features":"F5","tags":[],"script":"-- خروج فوري من اللعبة عند الضغط على K بدون رسالة ظاهرة\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal player = game.Players.LocalPlayer\n\nUserInputService.InputBegan:Connect(function(input, isProcessed)\n    if isProcessed then return end -- تجاهل إذا كان المفتاح مستخدمًا بالفعل\n\n    if input.KeyCode == Enum.KeyCode.F5\n then\n        -- إعادة تحميل اللعبة كطريقة بديلة للخروج السريع\n        game:Shutdown()\n    end\nend)","owner":{"_id":"67e82654133d59648788f9ad","username":"vobBox","verified":false,"profilePicture":"/images/photo/67e82654133d59648788f9ad-1745267110167.png","status":"offline","id":"67e82654133d59648788f9ad","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1266,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1745182107002.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-04-20T20:48:27.059Z","executes":158,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68055d9b2ba4bae0a33156b7","editBy":{"_id":"67e82654133d59648788f9ad","username":"vobBox","status":"offline","id":"67e82654133d59648788f9ad"},"message":"Create script","createdAt":"2025-04-20T20:48:27.065Z"}],"comments":[]}