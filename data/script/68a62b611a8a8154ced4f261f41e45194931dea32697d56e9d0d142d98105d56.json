stChild(\"Granny\")\n                if granny then\n                    granny:Destroy() -- Removes Granny's entire model\n                    print(\"Granny successfully removed from \" .. presetName .. \"!\")\n                else\n                    print(\"Granny not found in \" .. presetName .. \"!\")\n                end\n\n                -- Remove Grandpa\n                local grandpa = preset:FindFirstChild(\"Grandpa\")\n                if grandpa then\n                    grandpa:Destroy() -- Removes Grandpa's entire model\n                    print(\"Grandpa successfully removed from \" .. presetName .. \"!\")\n                else\n                    print(\"Grandpa not found in \" .. presetName .. \"!\")\n                end\n            else\n                print(presetName .. \" not found in workspace!\")\n            end\n        end\n    end\n\n    -- Execute the function to remove Granny and Grandpa\n    removeGrannyAndGrandpaFromPresets()\n\n    -- Wait 60 seconds before running again\n    wait(60)\nend\n","features":"[+] Remove Granny, Grandpa Op Supports Chapter 3 only (If you want Chapter 1, 2 its on my page)\nRecommendation: You can use a get tools script. if you want it its also on my page.\nPlease Tell me if you have any issues or bugs tell me in the comments and I'll respond.","tags":["game","Granny","Granny Multiplayer","Op","op"],"discord":"","keyLink":"","owner":{"_id":"66abf415561cb7837af216d7","username":"A_Coder","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66abf415561cb7837af216d7","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:14:42.996Z","last":"","win":14,"math":3},"is