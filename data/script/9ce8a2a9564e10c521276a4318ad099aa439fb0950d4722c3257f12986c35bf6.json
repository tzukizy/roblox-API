{"_id":"6834af2ffa26c83804add112","title":"HexaHub Alt Control","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-HexaHub-Alt-Control-41108","verified":false,"key":false,"keyless":false,"views":7949,"executes":305,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/e3ba17503b9569808d6de8a83346763a06286382210a7445fe6bfd4b64f8a59e.webp","original":"https://scriptblox.com/images/sb/0-1748283183828.png","scriptblox":"https://scriptblox.com/images/script/0-1748283183828.png"},"thumbnail":{"url":"https://media.kocakz.me/e3ba17503b9569808d6de8a83346763a06286382210a7445fe6bfd4b64f8a59e.webp","original":"https://scriptblox.com/images/sb/0-1748283183828.png","scriptblox":"https://scriptblox.com/images/script/0-1748283183828.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-05-26T18:13:03.879Z","updatedAt":"2025-05-26T18:13:03.879Z","lastBump":"2025-05-26T18:13:03.879Z","script":"--Configuration\ngetgenv().Use_Displayname = true -- if true, put accounts displayname for bots | if false use the username of accounts\ngetgenv().bots = {\"TheBot1User\", \"TheBot2User\", \"TheBot3User\", \"TheBot4User\", \"TheBot5User\", \"TheBot6User\", \"TheBot7User\"} --bots\ngetgenv().owner = \"TheBotUserOwner\" --Owner (USER NAME, DO NOT PUT DISPLAYNAME)\ngetgenv().nbbot = 5 -- Number of bots you want to use\ngetgenv().prefix = \".\" -- Prefix\ngetgenv().botrender = false -- when true, bots use less CPU\ngetgenv().printcmd = true -- if true, displays all commands available in the console\n\nloadstring(game:HttpGet('https://raw.githubusercontent.com/elfcodes808/HexaHubAltController/refs/heads/main/altcontroller.lua'))()\n--[[\nINFO:\n\ndo ;quit to deactivate the script,\nactivate script only once,\nyou can check whether bots are active by doing ;status,\nif the bots don't execute the command, you'll have to redo the command until it's executed.,\nput the bots you want to use in the places of the list.,\nyou can try to fix bots with ;fix command,\n]]","features":"The script makes it so if you execute it on your alts and set the main account then you can use chat messages to control it.\nType .help for cmds in chat\nType .cmds and look at the console on one of the bots side\nHave fun!","tags":["AltControl","BotControl","Alts","Alt","Bot"],"discord":"","keyLink":"","owner":{"_id":"677b502f7550292c3b11edfb","username":"Lucidd","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f9aba1c5d1d032dfa94ef4e9e246f3eac3649e8f39439eee82e01e2f509e9a90.webp","original":"https://scriptblox.com/images/photo/677b502f7550292c3b11edfb-1751951369613.png"},"status":"offline","id":"677b502f7550292c3b11edfb","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/f9aba1c5d1d032dfa94ef4e9e246f3eac3649e8f39439eee82e01e2f509e9a90.webp","original":"https://scriptblox.com/images/photo/677b502f7550292c3b11edfb-1751951369613.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:53:55.547Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6834af2ffa26c83804add114","editBy":{"_id":"677b502f7550292c3b11edfb","username":"Lucidd","status":"offline","id":"677b502f7550292c3b11edfb"},"message":"Create Script","createdAt":"2025-05-26T18:13:03.880Z"}],"comments":[{"_id":"6834b62e3d31da294264a24c","commentBy":{"_id":"6834b2dedd375eb08273e274","username":"Goonman","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-05-26T18:28:46.58