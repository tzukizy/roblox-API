{"slug":"Universal-Script-Key-System-(Linkvertise-and-Work.Ink)-9656","_id":"658941cf930085d58fbc1232","title":"Key System (Linkvertise and Work.Ink)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"* Projects\n  * Name\n  * Key Expire Times (Instant - 1 week)\n  * Custom Slugs\n    * eg: mikecash.co/key/MyHub\n  * Work.Ink / Linkvertise\n  * Affiliate Earnings\n    *  5 - 25 %\n  * Exclude from Analytics\n* Detailed analytics\n  * Key Generations\n  * Key Verifications (Per Execute)\n  * Bypass Attempts\n  * Affiliate Redirects\n  * Page Views\n* Settings\n  * Discord invite on page","tags":["key","key system","monetization"],"script":"-- https://mikecash.co/key/mikecash-demo\nlocal HttpService = game:GetService(\"HttpService\")\nlocal SHA2 = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Egor-Skriptunoff/pure_lua_SHA/master/sha2.lua\"))()\nlocal Iris = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/x0581/Iris-Exploit-Bundle/main/bundle.lua\"))().Init(game.CoreGui)\n\nlocal Identifier = {53,51,49,50,55,53,101,53,55,52,49,48}\nlocal Nonce = 0\nfor i, Byte in next, Identifier do for j = 1, Byte do if j%2 == 2 then Nonce = Nonce + math.random() else Nonce = Nonce + Random.new():NextNumber() end end end\nlocal NonceEnd = SHA2.sha256(table.concat(Identifier,\"\"))\nlocal ShaNonce = SHA2.sha256(tostring(Nonce) .. NonceEnd)\n\nlocal Status = \"Check key\"\nlocal CanPress = true\nlocal Verified = false\n\nlocal function Verify(Key)\n  local Response = game:HttpGet((\"https://mikecash.co/api/keyverify?key=%s&project=531275e57410&nonce=%s\"):format(Key, tostring(Nonce)))\n  local Decode = HttpService:JSONDecode(Response)\n  Verified = Decode.success and Decode.nonce == ShaNonce\nend\n\nif isfile(\"remember_me_531275e57410.txt\") then\n  Verify(readfile(\"remember_me_531275e57410.txt\"))\nend\n\nIris:Connect(function()\n  if not Verified then\n    Iris.Window({\"MikeCash Demo - Key System\", [Iris.Args.Window.NoClose] = true, [Iris.Args.Window.NoResize] = true, [Iris.Args.Window.NoScrollbar] = true, [Iris.Args.Window.NoCollapse] = true}, {size = Iris.State(Vector2.new(175, 75))}) do\n      Key = Iris.InputText({\"\", [Iris.Args.InputText.TextHint] = \"Your key here.\"}, {value = Iris.State(Key)}).text.value\n        if Iris.Button({\"Check key\"}).clicked then\n          if CanPress then\n            task.spawn(function()\n              CanPress = false\n              Status = \"Verifying key..\"\n              Verify(Key)\n              Status = Verified and \"Valid key!\" or \"Invalid key!\"\n              if Verified then\n                writefile(\"remember_me_531275e57410.txt\", Key)\n              end\n              task.wait(2)\n              Status = \"Check key\"\n              CanPress = true\n            end)\n          end\n        end\n      Iris.End()\n    end\n  end\nend)\n\nrepeat task.wait() until Verified\n\nwarn(\"Verified! Now loading: MikeCash Demo.\")","owner":{"_id":"656b50638886862bc6313184","username":"fndotgg","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"656b50638886862bc6313184","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"https://mikecash.co/key/mikecash-demo","views":30661,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-12-25T08:48:15.644Z","dislikeCount":1,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/e2047cc97a4b46647b521ccfbb49692882c598e35e7688ccb66216cf173193bc.webp","original":"https://scriptblox.com/images/sb/9151026-1703494095616.webp","scriptblox":"https://scriptblox.com/images/script/9151026-170349