{"slug":"Push-Up-Training-Simulator-Auto-Train-7450","_id":"64ed3570d2e991ed6899126a","title":"Auto Train","game":{"_id":"67e5e1ffb360710ec3c784b0","gameId":13900376114,"name":"Push Up Training Simulator","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13900376114},"features":"A simple script, there's no menu or anything of the sort, its function is auto farm strength. When activated, you will automatically work out without needing to move a muscle, just activate the training mode.","tags":["push up simulator","simulator","muscle"],"script":"local G_Train = true \nlocal isTrainRequested = false\n\nwhile true do\n    if G_Train == true and not isTrainRequested then\n        isTrainRequested = true\n        \n        while G_Train == true do\n            local args = {\n                [1] = {\n                    [1] = \"Train_Request\"\n                }\n            }\n\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteEvent\"):FireServer(unpack(args))\n\n            wait(0.01)\n        end\n    elseif G_Train == false then\n        isTrainRequested = false\n        \n        \n        \n    end\n\n    wait(0.01) \n \nend","owner":{"_id":"64ea6035e320c681ed2e6aa5","username":"Blade","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/56eabc6ccea2829a4ce1e043b1842e2b6649175a88fe965131425a59ba26a428.webp","original":"https://scriptblox.com/images/photo/64ea6035e320c681ed2e6aa5-1693081719234.jpg"},"status":"offline","id":"64ea6035e320c681ed2e6aa5","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/56eabc6ccea2829a4ce1e043b1842e2b6649175a88fe965131425a59ba26a428.webp","original":"https://scriptblox.com/images/photo/64ea6035e320c681ed2e6aa5-1693081719234.jpg"}},"verified":false,"keyLink":"","views":26191,"scriptType":"free","isUniversal":false,"isPatched":false,"vi