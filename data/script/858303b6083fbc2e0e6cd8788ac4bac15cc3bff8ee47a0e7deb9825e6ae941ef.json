{"_id":"697a275e92a4802284e4a977","title":"Fast Train","game":{"_id":"697a275e92a4802284e4a970","gameId":122712103009609,"name":"[💸] Push Stuff to Get Rich!","imageUrl":{"url":"https://media.kocakz.me/a456a7142fa467449e068f146d1ac3d9506543c09bed89523fbb8b4b6c37602c.webp","original":"https://scriptblox.com/images/sb/rbx-7e472b3b99fcaf27c8de05b9e4c65465-72918032dd3a.png"},"slug":"122712103009609-push-stuff-to-get-rich","path":"/game/122712103009609-push-stuff-to-get-rich","thumbnail":{"url":"https://media.kocakz.me/a456a7142fa467449e068f146d1ac3d9506543c09bed89523fbb8b4b6c37602c.webp","original":"https://scriptblox.com/images/sb/rbx-7e472b3b99fcaf27c8de05b9e4c65465-72918032dd3a.png"},"placeId":122712103009609},"slug":"Push-Stuff-to-Get-Rich!-Fast-Train-94354","verified":false,"key":false,"keyless":false,"views":1006,"executes":364,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6e3d1e174cd29e8919dc6a80d8e85ca1f4c9ec83bcf163dfc8a4ec48ebc0925e.webp","original":"https://scriptblox.com/images/sb/122712103009609-1769613150594.webp","scriptblox":"https://scriptblox.com/images/script/122712103009609-1769613150594.webp"},"thumbnail":{"url":"https://media.kocakz.me/6e3d1e174cd29e8919dc6a80d8e85ca1f4c9ec83bcf163dfc8a4ec48ebc0925e.webp","original":"https://scriptblox.com/images/sb/122712103009609-1769613150594.webp","scriptblox":"https://scriptblox.com/images/script/122712103009609-1769613150594.webp"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-01-28T15:12:30.618Z","updatedAt":"2026-01-28T15:12:30.618Z","lastBump":"2026-01-28T15:12:30.618Z","script":"--- {settings} ---\nlocal TrainPriority = 0 -- time to wait when binding stuff with runservice (priority = time to wait basically)\nlocal EvenFasterTraining = false\n--------------------------------------------------------------\n\nlocal Players = game:GetService(\"Players\")\nlocal Player = Players.LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\nlocal Humanoid = Character:FindFirstChildWhichIsA(\"Humanoid\")\nlocal HumanoidRootPart = Character:FindFirstChild(\"HumanoidRootPart\")\n\nlocal CurrentWorld = Player[\"worlds\"].currentworld\n\nlocal Benchpress = nil\nlocal CurrentMap = nil\n\nfor num, item in workspace.maps:GetChildren() do\n\tif item.Name:gsub(\"%D\", \"\") == CurrentWorld.Value:gsub(\"%D\", \"\") then\n\t\tCurrentMap = item\n\t\tBenchpress = CurrentMap.training.benchpress\n\tend\nend\n\ngame.RunService:BindToRenderStep(\"FastTrain\", TrainPriority, function()\n\nlocal omginstance1 = Benchpress\nlocal omgboolean2 = true\n\ngame:GetService(\"ReplicatedStorage\").remotes.train:FireServer(omginstance1, omgboolean2)\n\nlocal omginstance1 = Benchpress\nlocal omgboolean2 = EvenFasterTraining\n\ngame:GetService(\"ReplicatedStorage\").remotes.train:FireServer(omginstance1, omgboolean2)\nend)","features":"Allows you to train really (and I mean REALLY) fast, at a configurable rate.","tags":["push","rich","slop","fast","op"],"discord":"","keyLink":"","owner":{"_id":"672d8d708c508a1395e21d2d","username":"thisisaname","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ea818d4f4d92033c932b2ccdda6ad95711819f5d860d01eabf0aa0394d75c7ea.webp","original":"https://scriptblox.com/images/photo/672d8d708c508a1395e21d2d-1731038713593.png"},"lvl":8,"status":"offline","id":"672d8d708c508a1395e21d2d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/ea818d4f4d92033c932b2ccdda6ad95711819f5d860d01eabf0aa0394d75c7ea.webp","original":"https://scriptblox.com/images/photo/672d8d708c508a1395e21d2d-1731038713593.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:33:06.532Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"697a275e92a4802284