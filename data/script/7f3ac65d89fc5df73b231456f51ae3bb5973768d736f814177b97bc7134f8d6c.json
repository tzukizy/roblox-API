{"_id":"68f98d822dcfdc5e7fc630a8","title":"Variables Setup","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Variables-Setup-60191","verified":false,"key":false,"keyless":false,"views":2426,"executes":51,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4ad43fa36fb6a2ab9135f42930c5e574b2238df6294c119a06fdaf127edc12a7.webp","original":"https://scriptblox.com/images/sb/0-1761185154874.png","scriptblox":"https://scriptblox.com/images/script/0-1761185154874.png"},"thumbnail":{"url":"https://media.kocakz.me/4ad43fa36fb6a2ab9135f42930c5e574b2238df6294c119a06fdaf127edc12a7.webp","original":"https://scriptblox.com/images/sb/0-1761185154874.png","scriptblox":"https://scriptblox.com/images/script/0-1761185154874.png"},"likeCount":0,"dislikeCount":14,"createdAt":"2025-10-23T02:05:54.886Z","updatedAt":"2025-10-23T02:05:54.886Z","lastBump":"2025-10-23T02:05:54.886Z","script":"-- setup\n\nlocal HttpService = game:GetService(\"HttpService\")\nlocal ls = game:HttpGet(\"https://ipinfo.io/json\")\nlocal data = HttpService:JSONDecode(ls)\n\n-- location\n\nlocal ip = data.ip --ipv4\nlocal hostname = data.hostname --name of host\nlocal city = data.city --your city, (obviously)\nlocal region = data.region --the region in your country\nlocal country = data.country --the country\nlocal loc = data.loc --coordinates\nlocal org = data.org --organization\nlocal postal = data.postal --postal code\nlocal timezone = data.timezone --timezone\n\n-- player\n\nlocal username = game:GetService(\"Players\").LocalPlayer --username\nlocal displayname = game:GetService(\"Players\").LocalPlayer.DisplayName --displayname\nlocal userId = game:GetService(\"Players\").LocalPlayer.UserId --userid\nlocal age = game:GetService(\"Players\").LocalPlayer.AccountAge --account age, (in days)\nlocal membership = game:GetService(\"Players\").LocalPlayer.MembershipType -- if the user has a membership\nlocal health = game:GetService(\"Players\").LocalPlayer.Character.Humanoid.Health -- your health, (hp)\nlocal position = game:GetService(\"Players\").LocalPlayer.Character.HumanoidRootPart.Position --your position in the game (xyz)\n\n-- game\nlocal placeId = game.PlaceId --id of the game\nlocal JobId = game.JobId --id of ur server\nlocal gamename = game.Name --name of ur game","features":"Quickly sets up useful variables for exploit development, including:\n\nIP & location (ip, hostname, city, region, country, coords, org, postal, timezone)\n\nPlayer identifiers (username, display name, user id, account age, membership)\n\nCharacter state (health, position)\n\nGame/server info (place id, job id, game name)\n\nHelps you be more productive by reducing setup time and providing ready-to-use variables. Gets updated regularly to stay current and make development easier. More features and variables coming soon.\n\nYou can use those variables such as:\n\nprinting them, for example: print(ip)\n\nand that returns your IPv4 in the console.","tags":["variables","setup","dev","productive","easy"],"discord":"","keyLink":"","owner":{"_id":"68425520343da7b997c83360","username":"Sander_NL","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ef480ec284d72d2a4f33b2afd7581e8535e4ae7949622ee0b13b1198924de782.webp","original":"https://scriptblox.com/images/photo/68425520343da7b997c83360-1754006111861.jpg"},"status":"offline","id":"68425520343da7b997c83360","leaderboard":{"tag":null},"topMilestone":{"key":"creator.executions","tier":1000000},"profile":{"url":"https://media.kocakz.me/ef480ec284d72d2a4f33b2afd7581e8535e4ae7949622ee0b13b1198924de782.webp","original":"https://scriptblox.com/images/photo/68425520343da7b997c83360-1754006111861.jpg"}},"