:IsA(\"MeshPart\") then\n                        -- Double the size of the MeshPart\n                        collisionMesh.Size = collisionMesh.Size * 10\n                        collisionMesh.CanCollide = false -- Disable collision\n                    end\n                end\n            end\n        end\n    end\nend\n\n-- Apply effect to players when the script starts\nresizeOtherPlayers()\n\n-- Update when a new player joins\nPlayers.PlayerAdded:Connect(function(player)\n    player.CharacterAdded:Connect(function()\n        task.wait(1) -- Wait for the character to fully load\n        resizeOtherPlayers()\n    end)\nend)\nend)","owner":{"_id":"673359e0bdaef29285037406","username":"StewBradar","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b5a562b87d03bd9795fde9235d0443bcbb62bab815f5ac605592ead2d327f103.webp","original":"https://scriptblox.com/images/photo/673359e0bdaef29285037406-1790446588742.png"},"status":"offline","id":"673359e0bdaef29285037406","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/b5a562b87d03bd9795fde9235d0443bcbb62bab815f5ac605592ead2d327f103.webp","original":"https://scriptblox.com/images/photo/673359e0bdaef29285037406-1790446588742.png"}},"verified":false,"views":11351,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-2eb655f5b003ff159936c52663202c97-73ed6b0877c5.png","scriptblox":"https://scriptblox.com/images/script/rbx-2eb655f5b003ff159936c52663202c97-73ed6b0877c5.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-06-09T18:54:24.540Z","editBy":{"_id":"673359e0bdaef29285037406","username":"StewBradar","status":"offline","id":"673359e0bdaef29285037406"},"keyLink":"","executes":1907,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0