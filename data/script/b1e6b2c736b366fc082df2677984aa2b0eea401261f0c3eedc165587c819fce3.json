{"slug":"Universal-Script-Universal-Raknet-Desync-267975","_id":"69dbb2ea74a52731e6ec1fa2","title":"Universal Raknet Desync","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Desync, uses raknet.","tags":["desync","universal"],"script":"-- Original: https://v3rm.net/threads/release-raknet-desync.27587/\n\nlocal function test(func)\n    if func then\n        return true\n    end\n\n    return false\nend\n\nlocal result = test(raknet)\nif result == false then\n    return\nend\n\nlocal uis = game:GetService(\"UserInputService\")\nlocal hooked = false\nlocal toggle = Enum.KeyCode.U\n\nlocal function rakhook(packet)\n    if packet.PacketId == 0x1B then\n        local buf = packet.AsBuffer\n        buffer.writeu32(buf, 1, 0xFFFFFFFF)\n        packet:SetData(buf)\n    end\nend\n\nuis.InputBegan:Connect(function(obj)\n    if obj.KeyCode ~= toggle then return end\n\n    if hooked then\n        raknet.remove_send_hook(rakhook)\n    else\n        raknet.add_send_hook(rakhook)\n    end\n\n    hooked = not hooked\n    print(\"Desync Enabled: \", hooked)\nend)","owner":{"_id":"681a0f9eca58dc6c5af99480","username":"refund","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/e41528c62fd128ec0d51babaf325cdbde217341503e65b6fb14f7f1f859a239f.webp","original":"https://scriptblox.com/images/photo/681a0f9eca58dc6c5af99480-1776791580805.png"},"status":"offline","id":"681a0f9eca58dc6c5af99480","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/e41528c62fd128ec0d51babaf325cdbde217341503e65b6fb14f7f1f859a239f.webp","original":"https://scriptblox.com/images/photo/681a0f9eca58dc6c5af99480-1776791580805.png"}},"verified":false,"views":2982,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public