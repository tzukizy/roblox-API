{"slug":"Universal-Script-Universal-Raknet-Desync-267975","_id":"69dbb2ea74a52731e6ec1fa2","title":"Universal Raknet Desync","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1776005866885.png","placeId":0},"features":"Desync, uses raknet.","tags":["desync","universal"],"script":"-- Original: https://v3rm.net/threads/release-raknet-desync.27587/\n\nlocal function test(func)\n    if func then\n        return true\n    end\n\n    return false\nend\n\nlocal result = test(raknet)\nif result == false then\n    return\nend\n\nlocal uis = game:GetService(\"UserInputService\")\nlocal hooked = false\nlocal toggle = Enum.KeyCode.U\n\nlocal function rakhook(packet)\n    if packet.PacketId == 0x1B then\n        local buf = packet.AsBuffer\n        buffer.writeu32(buf, 1, 0xFFFFFFFF)\n        packet:SetData(buf)\n    end\nend\n\nuis.InputBegan:Connect(function(obj)\n    if obj.KeyCode ~= toggle then return end\n\n    if hooked then\n        raknet.remove_send_hook(rakhook)\n    else\n        raknet.add_send_hook(rakhook)\n    end\n\n    hooked = not hooked\n    print(\"Desync Enabled: \", hooked)\nend)","owner":{"_id":"681a0f9eca58dc6c5af99480","username":"refund","verified":false,"profilePicture":"/images/photo/681a0f9eca58dc6c5af99480-1776791580805.png","status":"offline","id":"681a0f9eca58dc6c5af99480","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2949,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1776005866885.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-04-12T14:57:46.895Z","editBy":{"_id":"681a0f9eca58dc6c5af99480","username":"refund","status":"offline","id":"681a0f9eca58dc6c5af99480"},"keyLink":"","executes":501,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dbb2ea74a52731e6ec1fa5","editBy":{"_id":"681a0f9eca58dc6c5af99480","username":"refund","status":"offline","i