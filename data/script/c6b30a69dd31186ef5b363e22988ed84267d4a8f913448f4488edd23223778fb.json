{"slug":"Project-Slayers-Auto-Spin-Open-Source-4889","_id":"62fa514f297097657cb81713","title":"Auto Spin Open Source","game":{"_id":"67e5e1ffb360710ec3c77e0a","gameId":5956785391,"name":"Project Slayers","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":5956785391},"features":"Auto Spin","tags":[],"script":"local clans = {\n    ['Legendary'] = {'Kocho', 'Shinazugawa'},\n    ['Mythic'] = {'Tomioka'},\n    ['Supreme'] = {'Kamado', 'Agatsuma'}\n}\nlocal Wanted = 'Supreme'\n_G.CD = 0\n--[[\n\nYou can put a genre, or clan name in Wanted.\nExample 1: local Wanted = 'Supreme'\nExample 2: local Wanted = 'Kamado'\n\n]]\nwhile wait(_G.CD) do\n    local x, y = game.ReplicatedStorage.Remotes.To_Server.Handle_Initiate_S_:InvokeServer('check_can_spin')\n    if clans[Wanted] then\n        local data;\n        for i,v in pairs(clans[Wanted]) do\n            if v:lower() == y:lower() then\n                data = true;\n                break\n            end\n        end\n        if data then\n            break; \n        end\n    else\n        if y:lower() == Wanted:lower() then\n            break\n        end \n    end\nend","owner":{"_id":"61e1ca0582afb05a5b96e2db","username":"teres","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61e1ca0582afb05a5b96e2db-1642187468202.jpg"},"status":"offline","id":"61e1ca0582afb05a5b96e2db","profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61e1ca0582afb05a5b96e2db-1642187468202.jpg"}},"verified":false,"views":7990,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-08-15T13:59:43.523Z","dislikeCount":1,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/10dbd5cfc5f84fdb320258c209df