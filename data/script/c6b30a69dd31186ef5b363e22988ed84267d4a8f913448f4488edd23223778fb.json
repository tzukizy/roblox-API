] then\n        local data;\n        for i,v in pairs(clans[Wanted]) do\n            if v:lower() == y:lower() then\n                data = true;\n                break\n            end\n        end\n        if data then\n            break; \n        end\n    else\n        if y:lower() == Wanted:lower() then\n            break\n        end \n    end\nend","features":"Auto Spin","tags":[],"discord":"","keyLink":"","owner":{"_id":"61e1ca0582afb05a5b96e2db","username":"teres","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61e1ca0582afb05a5b96e2db-1642187468202.jpg"},"status":"offline","id":"61e1ca0582afb05a5b96e2db","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/61e1ca0582afb05a5b96e2db-1642187468202.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:33:06.216Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f26b","editBy":{"_id":"61e1ca0582afb05a5b96e2db","username":"teres","status":"offline","id":"61e1ca0582afb05a5b96e2db"},"message":"Create script","createdAt":"2025-03-25T17:23:51.796Z"}],"comments":[]}