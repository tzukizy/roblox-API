equency))\n        local char = characters[(x % #characters) + 1]\n\n        for offset = -2, 2 do\n            local index = x + (y + offset) * 80\n            if index > 0 and index <= #screen then\n                screen[index] = char\n            end\n        end\n    end\n\n    local output = {}\n    for index = 1, #screen do\n        table.insert(output, screen[index])\n        if index % 80 == 0 then\n            table.insert(output, \"\\n\")\n        end\n    end\n\n    print(\"\\n\" .. table.concat(output))\n    rconsoleprint(\"\\n\" .. table.concat(output))\n\n    t += 1\nend)","features":"pure nostalgia","tags":["fun","entertainment","nostalgia","old"],"discord":"","keyLink":"","owner":{"_id":"668d444def2f1c9d49505da5","username":"mxsynry","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9849f55addca9aa2421f77e8e27b6fd9c73108946f9de416da5a9d027bc45c16.webp","original":"https://scriptblox.com/images/photo/668d444def2f1c9d49505da5-1720534208532.jpg"},"status":"offline","id":"668d444def2f1c9d49505da5","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/9849f55addca9aa2421f77e8e27b6fd9c73108946f9de416da5a9d027bc45c16.webp","original":"https://scriptblox.com/images/photo/668d444def2f1c9d49505da5-1720534208532.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:13:50.550Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c546e9","editBy":{"_id":"668d444def2f1c9d49505da5","username":"mxsynry","status":"offline","id":"668d444def2f1c9d49505da5"},"message":"Create script","createdAt":"2025-03-27T11:02:42.868Z"}],"comments":[]}