{"slug":"One-Second-One-Year-(Shop-Update)-Auto-Arrest-17640","_id":"66cba0f5d2bab23d64ec09d4","title":"Auto Arrest","game":{"_id":"67e5e1ffb360710ec3c78996","gameId":16432610608,"name":"One Second = One Year 🧪(Evil Lab Update)🤖","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":16432610608},"features":"Auto Arrest","tags":["Auto","Arrest","All"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal function teleportToPlayer(targetPlayer)\n    if targetPlayer.Character then\n        local targetHRP = targetPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\n        if targetHRP then\n            hrp.CFrame = targetHRP.CFrame\n        end\n    end\nend\n\nlocal function checkPlayers()\n    for _, targetPlayer in pairs(game.Players:GetPlayers()) do\n        if targetPlayer ~= player and targetPlayer.Character then\n            local torso = targetPlayer.Character:FindFirstChild(\"Torso\") or targetPlayer.Character:FindFirstChild(\"UpperTorso\")\n            if torso and torso:FindFirstChild(\"IllegalGui\") then\n                local playerPosition = hrp.Position\n                local targetPosition = torso.Position\n                local distance = (playerPosition - targetPosition).Magnitude\n                if distance > 10 then\n                    teleportToPlayer(targetPlayer)\n                end\n            end\n        end\n    end\nend\n\nwhile true do\n    checkPlayers()\n    wait(0.1)\nend\n","owner":{"_id":"663bdfd54d8171671b024bab","username":"Xiamoi","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9230080f55a2f44d3cf5220d3dc438556dfebf51b0c736f192534cef6f313a9c.webp","original":"https://scriptblox.com/images/photo/663bdfd54d8171671b024bab-1715200391441.png"},"status":"offline","id"