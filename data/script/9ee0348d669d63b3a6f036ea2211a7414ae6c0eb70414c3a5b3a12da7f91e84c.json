argetHRP then\n            hrp.CFrame = targetHRP.CFrame\n        end\n    end\nend\n\nlocal function checkPlayers()\n    for _, targetPlayer in pairs(game.Players:GetPlayers()) do\n        if targetPlayer ~= player and targetPlayer.Character then\n            local torso = targetPlayer.Character:FindFirstChild(\"Torso\") or targetPlayer.Character:FindFirstChild(\"UpperTorso\")\n            if torso and torso:FindFirstChild(\"IllegalGui\") then\n                local playerPosition = hrp.Position\n                local targetPosition = torso.Position\n                local distance = (playerPosition - targetPosition).Magnitude\n                if distance > 10 then\n                    teleportToPlayer(targetPlayer)\n                end\n            end\n        end\n    end\nend\n\nwhile true do\n    checkPlayers()\n    wait(0.1)\nend\n","features":"Auto Arrest","tags":["Auto","Arrest","All"],"discord":"","keyLink":"","owner":{"_id":"663bdfd54d8171671b024bab","username":"Xiamoi","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9230080f55a2f44d3cf5220d3dc438556dfebf51b0c736f192534cef6f313a9c.webp","original":"https://scriptblox.com/images/photo/663bdfd54d8171671b024bab-1715200391441.png"},"status":"offline","id":"663bdfd54d8171671b024bab","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/9230080f55a2f44d3cf5220d3dc438556dfebf51b0c736f192534cef6f313a9c.webp","original":"https://scriptblox.com/images/photo/663bdfd54d8171671b024bab-1715200391441.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:15:08.823Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51e0a","editBy":{"_id":"663bdfd54d8171671b024bab","username":"Xiamoi","status":"offline","id":"663bdfd54d8171671b024bab"},"message":"Create script","c