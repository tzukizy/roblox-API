{"slug":"DUST-II-BloxStrike-Perfect-wallbang-all-maps-137758","_id":"69bee6f585ee453a13e5a14c","title":"Perfect wallbang all maps","game":{"_id":"68e92222467c47b2c34300cf","gameId":114234929420007,"name":"[NEW MAP] BloxStrike","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":114234929420007},"features":"Wallbang ( Use with aimbot ) updates to get more vision","tags":["bloxstrike wallbang op"],"script":"--[[\n    Deletes most parts except:\n    - floor/ground/dustfloor\n    - walls & doors\n    - characters\n    - shop/UI/interactions\n]]\n\nfor _, v in ipairs(workspace:GetDescendants()) do\n    if v:IsA(\"BasePart\") then\n\n        -- \n        if v:FindFirstAncestorOfClass(\"Model\") and\n           v:FindFirstAncestorOfClass(\"Model\"):FindFirstChildOfClass(\"Humanoid\") then\n            continue\n        end\n\n        local name = string.lower(v.Name)\n\n        -- \n        local isProtected =\n            string.find(name, \"floor\") or\n            string.find(name, \"ground\") or\n            string.find(name, \"terrain\") or\n            string.find(name, \"baseplate\") or\n            string.find(name, \"dustfloor\") or\n            string.find(name, \"grggrall\") or   -- walls\n            string.find(name, \"grge\")      -- doors\n\n        -- \n        if v:FindFirstAncestor(\"Shop\") or\n           v:FindFirstAncestor(\"UI\") or\n           v:FindFirstAncestor(\"StarterGui\") then\n            continue\n        end\n\n        if v:FindFirstChildOfClass(\"ProximityPrompt\") or\n           v:FindFirstChildOfClass(\"ClickDetector\") then\n            continue\n        end\n\n        -- optional: keep large structural parts\n        local looksLikeStructure =\n            v.Anchored and v.Size.X > 20 and v.Size.Z > 20 and v.Size.Y > 5\n\n        -- \n        if not isProtected and not looksLikeStructure then\n            v:Destroy()\n        end\n    end\nend","owner":{"_id":"663e027dbadcdfdc3f874725","username":"vreemdedjalla","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"663e027dbadcdfdc3f874725","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":2467,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/04fd3a66649665648f81205fdac8b464cfe9474105176c31d08417bc3896dca6.webp","original":"https://scriptblox.com/images/sb/114234929420007-1774173980391.png","scriptblox":"https://scriptblox.com/images/script/114234929420007-1774173980391.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-03-21T18:44:05.160Z","editBy":{"_id":"663e027dbadcdfdc3f874725","username":"vreemdedjalla","status":"offline","id":"663e027dbadcdfdc3f874725"},"keyLink":"","executes":290,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:27:25.339Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/04fd3a66649665648f81205fdac8b464cfe9474105176c31d08417bc3896dca6.webp","original":"https://scriptblox.com/images/sb/114234929420007-1774173980391.png","scriptblox":"https://scriptblox.com/images/script/114234929420007-1774173980391.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bee6f585ee453a13e5a14f","editBy":{"_id":"663e027dbadcdfdc3f874725","username":"vreemdedjalla","status":"offline","id":"663e027dbadcdfdc3f874725"},"message":"ezzzz","createdAt":"2026-03-21T18:44:05.161Z"},{"_id":"69beeb93c59b2f341f8d0963","editBy":{"_id":"663e027dbadcdfdc3f874725","username":"vreemdedjalla","status":"offline","id":"663e027dbadcdfdc3f874725"},"message":"Update script","createdAt":"2026-03-21T19:03:47.760Z"}],"comments":[{"_