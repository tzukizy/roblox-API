{"slug":"Free-Client-Script-Executor-*BACK*-Netless-chat-command-for-tools-71793","_id":"692dcc92dfbe18b779e8e09e","title":"Netless chat command for tools","game":{"_id":"68966c2c1db541b05096cd52","gameId":14113053169,"name":"Free Client Script Executor *BACK*","imageUrl":"/images/sb/rbx-f65f0ab404c585bcc443b18ad26b6cfe-6a8aef318dc9.png","placeId":14113053169},"features":"Say ;n or ;net to start netless. Say ;unn or ;unnet to end netless. Use when tool equipped only.","tags":[],"script":"local connection\ngame:GetService(\"TextChatService\").SendingMessage:Connect(function(msg)\nif msg.Text == \";net\" or msg.Text == \";n\" then\nconnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\nfor _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do\nif v.Name == \"Handle\" and v.Parent:IsA(\"Tool\") then\nv.Velocity = Vector3.new(50,0,0)\nend end end) end\nif msg.Text == \";unn\" or msg.Text == \";unnet\" then\nconnection:Disconnect()\nconnection = nil\nend end)\n","owner":{"_id":"69237472df5c9c28cb000392","username":"Automated_Account","verified":false,"profilePicture":"/images/photo/69237472df5c9c28cb000392-1763931573809.jpeg","status":"offline","id":"69237472df5c9c28cb000392","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":975,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-35a4414774c08c2507602e87dc384fe5-9fdcc6ffb4d3.png","likeCount":1,"dislikeCount":1,"createdAt":"2025-12-01T17:12:50.010Z","executes":89,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"692dcc92dfbe18b779e8e0a0","editBy":{"_id":"69237472df5c9c28cb000392","username":"Automated_Account","status":"offline","id":"69237472df5c9c28cb000392"},"message":"Create script","createdAt":"2025-12-01T17:12:50.014Z"}],"comments":[{"_id":"6a40b89382de8ff2008b0f6e","commentBy":{"_id":"67c17875783e848ca563b950","username":"slammy","verified":false,"r