e Dash – Removes the cooldown on dashing.\n\nInfinite Double Jump – Allows unlimited mid-air jumps.\n\nSpectate Tools – Quickly spectates players and displays useful player information.\n\nTeleports – Instantly teleports you to supported maps and champion locations.","tags":["death ball","death ball script","free death ball script","auto parry","unlimited dash"],"script":"loadstring(game:HttpGet(\"https://flowauth.net/v1/ui/a87f00d9adf63658655fcd02ab86a4ef.lua\"))()","owner":{"_id":"696ff36b3593559f36ddb741","username":"snowy","verified":true,"profilePicture":"/images/photo/696ff36b3593559f36ddb741-1789861822395.png","status":"offline","id":"696ff36b3593559f36ddb741","leaderboard":{"tag":{"kind":"hall","rank":2,"period":"all","metric":"likes","value":1908}},"topMilestone":{"key":"creator.followers","tier":1000}},"verified":true,"discord":"https://discord.gg/getsnowy","keyLink":"https://discord.com/invite/getsnowy","views":37265,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-5ae30b8b49314abab0d430362480e241-be62e39b2e23.png","likeCount":26,"dislikeCount":1,"createdAt":"2026-07-27T20:12:57.043Z","editBy":{"_id":"66a728969af5d4ccc42d5473","username":"Nismo","status":"offline","id":"66a728969af5d4ccc42d5473"},"executes":11501,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":10011,"at":"2026-10-02T08:30:05.174Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a67bbc9c9a63763b8e5c64e","editBy":{"_id":"696ff36b3593559f36ddb741","username":"snowy","status":"offline","id":"696ff36b3593559f36ddb741"},"message":"Create script","createdAt":"2026-07-27T20:12:57.045Z"},{"_id":"6a75fc87d7439f87f9fd1ad6","editBy":{"_id":"696ff36b3593559f36ddb741","username":"snowy","status":"offline","id":"696ff36b3593559f36ddb741"},"message":"Update script","createdAt":"2026-08-07T15:40:55.336Z"},{"_id":"6a76c260a6c6255590230023","editBy":{"_id":"66a728969af5d4ccc42d5473",