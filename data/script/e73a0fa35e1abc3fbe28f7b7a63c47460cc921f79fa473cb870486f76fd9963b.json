{"slug":"Universal-Script-Zombie-38425","_id":"68158246349aff89e6d99e52","title":"Zombie","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1746240070722.jpg","placeId":0},"features":"Zombycare rule 34","tags":["Zombie","RSix","RsixRig"],"script":"--Zombycare rule 34 Kevin_(Nyanwolf) on rule34\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\nlocal animation = Instance.new(\"Animation\")\nanimation.AnimationId = \"rbxassetid://223623937\"\nlocal animationTrack = Humanoid:LoadAnimation(animation)\nanimationTrack.Looped = true\nanimationTrack:Play()\n\nLocalPlayer.CharacterAdded:Connect(function(char)\n    Character = char\n    Humanoid = char:WaitForChild(\"Humanoid\")\n    \n    local newAnim = Instance.new(\"Animation\")\n    newAnim.AnimationId = \"rbxassetid://223623937\"\n    local newTrack = Humanoid:LoadAnimation(newAnim)\n    newTrack.Looped = true\n    newTrack:Play()\nend)\n\nRunService.RenderStepped:Connect(function()\n    if not animationTrack.IsPlaying then\n        animationTrack:Play()\n    end\nend)\n","owner":{"_id":"67f818cb1c98cf04c22f57da","username":"skibidimariodisney","verified":false,"profilePicture":"/images/photo/67f818cb1c98cf04c22f57da-1746770204465.jpg","status":"offline","id":"67f818cb1c98cf04c22f57da","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":10069,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1746240070722.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2025-05-03T02:41:10.778Z","executes":1032,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68158246349aff89e6d99e54","editBy":{"_id":"67f818cb1c98cf04c22f57da","username