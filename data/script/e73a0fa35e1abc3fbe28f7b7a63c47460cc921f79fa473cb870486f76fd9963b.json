{"slug":"Universal-Script-Zombie-38425","_id":"68158246349aff89e6d99e52","title":"Zombie","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Zombycare rule 34","tags":["Zombie","RSix","RsixRig"],"script":"--Zombycare rule 34 Kevin_(Nyanwolf) on rule34\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\nlocal animation = Instance.new(\"Animation\")\nanimation.AnimationId = \"rbxassetid://223623937\"\nlocal animationTrack = Humanoid:LoadAnimation(animation)\nanimationTrack.Looped = true\nanimationTrack:Play()\n\nLocalPlayer.CharacterAdded:Connect(function(char)\n    Character = char\n    Humanoid = char:WaitForChild(\"Humanoid\")\n    \n    local newAnim = Instance.new(\"Animation\")\n    newAnim.AnimationId = \"rbxassetid://223623937\"\n    local newTrack = Humanoid:LoadAnimation(newAnim)\n    newTrack.Looped = true\n    newTrack:Play()\nend)\n\nRunService.RenderStepped:Connect(function()\n    if not animationTrack.IsPlaying then\n        animationTrack:Play()\n    end\nend)\n","owner":{"_id":"67f818cb1c98cf04c22f57da","username":"skibidimariodisney","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e9fe55f86be09d6316ef9da185bec3481101a9bbdd137effa98f7a071dd6d1ed.webp","original":"https://scriptblox.com/images/photo/67f818cb1c98cf04c22f57da-1746770204465.jpg"},"status":"offline","id":"67f818cb1c98cf04c22f57da","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/e9fe55f86be09d6316ef9da185bec3481101a9bbdd137effa98f7a071dd6d1ed.webp","original":"https://scriptblox.com/images/photo/67f818cb1c98cf0