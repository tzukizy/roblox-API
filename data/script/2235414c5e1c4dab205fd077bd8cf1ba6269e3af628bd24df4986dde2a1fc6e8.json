{"_id":"69386c22f002b181caba80f6","title":"Return By Death script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/75bff4b73e72dfd6b13d4b056f1d3d84dd5171ee9c4807801d6b7740ddf7bbd7.webp","original":"https://scriptblox.com/images/sb/0-1765305378780.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/75bff4b73e72dfd6b13d4b056f1d3d84dd5171ee9c4807801d6b7740ddf7bbd7.webp","original":"https://scriptblox.com/images/sb/0-1765305378780.png"},"placeId":0},"slug":"Universal-Script-Return-By-Death-script-73749","verified":false,"key":false,"keyless":false,"views":2206,"executes":1286,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4bd887340ce8e58b0713ebee3c7befc34608b8890d6c49773a00637dcaee4c0d.webp","original":"https://scriptblox.com/images/sb/0-1765305378780.png","scriptblox":"https://scriptblox.com/images/script/0-1765305378780.png"},"thumbnail":{"url":"https://media.kocakz.me/4bd887340ce8e58b0713ebee3c7befc34608b8890d6c49773a00637dcaee4c0d.webp","original":"https://scriptblox.com/images/sb/0-1765305378780.png","scriptblox":"https://scriptblox.com/images/script/0-1765305378780.png"},"likeCount":2,"dislikeCount":1,"createdAt":"2025-12-09T18:36:18.797Z","updatedAt":"2025-12-09T18:36:18.797Z","lastBump":"2025-12-09T18:36:18.797Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal isTeleportEnabled = true \nlocal lastPosition = nil       \n\nlocal toggleButton = nil\n\nlocal function updateButtonDisplay()\n    if not toggleButton then return end\n\n    if isTeleportEnabled then\n        toggleButton.Text = \"RETURN BY DEATH: ON\"\n        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\n        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\n    else\n        toggleButton.Text = \"RETURN BY DEATH: OFF\" \n        toggleButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\n        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\n    end\nend\n\nlocal function toggleTeleport()\n    isTeleportEnabled = not isTeleportEnabled\n    updateButtonDisplay()\n    print(\"Teleport Toggled. Enabled: \" .. tostring(isTeleportEnabled))\nend\n\nlocal function setupGUI()\n    local gui = Instance.new(\"ScreenGui\")\n    gui.Name = \"RespawnToggleGui\"\n    \n    gui.ResetOnSpawn = false \n\n    gui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n    toggleButton = Instance.new(\"TextButton\")\n    toggleButton.Name = \"ToggleTeleport\"\n    toggleButton.Size = UDim2.new(0, 250, 0, 40)\n    toggleButton.Position = UDim2.new(0.5, -125, 0.05, 0) \n    toggleButton.Font = Enum.Font.SourceSansBold\n    toggleButton.TextSize = 18\n    toggleButton.BorderColor3 = Color3.fromRGB(27, 42, 53)\n    toggleButton.BorderSizePixel = 2\n    \n    \n    toggleButton.MouseButton1Click:Connect(toggleTeleport)\n    toggleButton.Parent = gui\n\n    \n    updateButtonDisplay()\nend\n\n\nlocal function onCharacterDied()\n    if isTeleportEnabled then\n        local character = LocalPlayer.Character\n        if character and character.PrimaryPart then\n            \n            local currentCFrame = character.PrimaryPart.CFrame\n            lastPosition = currentCFrame + Vector3.new(0, 0.5, 0)\n            print(\"Player died. Saving position: \" .. tostring(lastPosition))\n\n            \n            LocalPlayer:LoadCharacter()\n        end\n    end\nend\n\n\nlocal function onCharacterAdded(newCharacter)\n    \n    local rootPart = newCharacter:WaitForChild(\"HumanoidRootPart\", 5)\n\n    if rootPart and lastPosition and isTeleportEnabled then\n        \n        rootPart.CFrame = lastPosition\n        print(\"Character respawned and teleported back to the last position.\")\n        \n        lastPosition = nil\n    elseif not isTeleportEnabled then\n         print(\"Teleport is disabled. Standard respawn behavior followed.\")\n    end\n\n    \n    local humanoid = newCharacter:WaitForChild(\"Humanoid\", 10)\n    if humanoid then\n        humanoid.Died:Connect(onCharacterDied)\n    end\nend\n\n\nLocalPlayer.CharacterAdded:Connect(onCharacterAdded)\n\n\nif LocalPlayer.Character then\n    onCharacterAdded(LocalPlayer.Character)\nend\n\n\nsetupGUI()\n\nprint(\"Instant Respawn Script with GUI toggle loaded.\")","features":"when u die u go back to the same place where u died.","tags":["script","rbd","roblox","rezero"],"discord":"","keyLink":"","owner":{"_id":"692dd930dfbe18b779e992ed","username":"prideSubaru","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d1653081c3a7b69dc11db02d339c909bfc14de31b7c0b7ef8ec068bb2c0177e6.webp","original":"https://scriptblox.com/images/photo/692dd930dfbe18b779e992ed-1764612641123.jpg"},"status":"offline","id":"692dd930dfbe18b779e992ed","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/d1653081c3a7b69dc11db02d339c909bfc14de31b7c0b7ef8ec068bb2c0177e6.webp","original":"https://scriptblox.com/images/photo/692dd930dfbe18b779e992ed-1764612641123.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:28:03.159Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69386c22f002b181caba80f8","editBy":{"_id":"692dd930dfbe18b779e992ed","username":"prideSubaru","status":"offline","id":"692dd930dfbe18b779e992ed"},"message":".","createdAt":"2025-12-09T18:36:18.799Z"}],"comments":[{"_id":"69386d1c5f2af709e2fe52c7","commentBy":{"_id":"68de5bd55660e91db663fc55","username":"i_love_script","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp"