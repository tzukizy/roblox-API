{"slug":"Dual-Slap-Tower-Changer-power-and-speed-OPEN-SOURCE-44021","_id":"686943d2e1763d2301ebf614","title":"OP Changer power and slowdown OPEN SOURCE","game":{"_id":"6866c3742cc4717be830fdf5","gameId":87045359837415,"name":"Dual Slap Tower🙌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":87045359837415},"features":"a easy script for me ;)\n\nTIP: If not works, click on dual slap (unequip) and execute a script.","tags":["Changer"],"script":"\n-- WORKS ONLY ON DUAL SLAP! --\n-- GAME NAME: Dual Slap Tower --\n-- Resets if your character is reset! --\n\nif game.PlaceId == 87045359837415 then -- NOT CHANGE\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal backpack = player:WaitForChild(\"Backpack\")\nlocal dualslap = backpack:FindFirstChild(\"Dual Slap\")\n\nif dualslap then\n    local power = dualslap:FindFirstChild(\"Power\")\n    local speed = dualslap:FindFirstChild(\"Speed\")\n\n    if power then\n        power.Value = 5000000000000000000 -- Change a power if need ;)\n        print(\"Power set to\", power.Value)\n    end\n\n    if speed then\n        speed.Value = 0 -- Speed = slowdown. \n        print(\"Speed set to\", speed.Value)\n    end\nend\n\nelse\nwarn(\"script is stopped, because wrong game.\")\nend","owner":{"_id":"66ae2822790921c27a22c894","username":"BadScriptsMaker","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b49d3f8dde85b588984d329991790adb4438c3ffe7c50eabb175494a482faaac.webp","original":"https://scriptblox.com/images/photo/66ae2822790921c27a22c894-1752740696621.jpg"},"status":"offline","id":"66ae2822790921c27a22c894","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/b49d3f8dde85b588984d329991790adb4438c3ffe7c50eabb175494a482faaac.webp","original":"https://scriptblox.com/images/photo/66ae2822790921c27a22c894-1752740696621.jpg"}},"verifi