{"slug":"Universal-Script-tf2-bot-killsay-moment-5157","_id":"63070a90ebde93fd5e480ef8","title":"tf2 bot killsay moment","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"just like tf2 chat on casual","tags":[],"script":"\nwhile true do\nfor i, v in next, game.Players:GetChildren() do\nif v:IsA(\"Player\") then\nlocal r = math.random(1,3)\nif r == 1 then\nlocal A_1 = \"You tried your best \"..v.Name..\" But playing Heavy wont help you\"\nlocal a_e = \"All\"\nlocal Event = game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest\nEvent:FireServer(A_1,a_e)\nelseif r == 2 then \nlocal A_1 = \"If your main is sniper then you should quit \"..v.Name\nlocal a_e = \"All\"\nlocal Event = game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest\nEvent:FireServer(A_1,a_e)\nelseif r == 3 then\nlocal A_1 = \"Hey \"..v.Name..\" i see you cant play Spy try quiiting\"\nlocal a_e = \"All\"\nlocal Event = game:GetService(\"ReplicatedStorage\").DefaultChatSystemChatEvents.SayMessageRequest\nEvent:FireServer(A_1,a_e)\nend\n\nwait(10)\nend\nend\nend\n","owner":{"_id":"625657db33a63a393b22e429","username":"AXDWT","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c1ef9487fd4a0f84a10cc6c6ec2d6594fab99632ebc4a825ede3fe5fd423be43.webp","original":"https://scriptblox.com/images/photo/625657db33a63a393b22e429-1691074363178.png"},"status":"offline","id":"625657db33a63a393b22e429","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/c1ef9487fd4a0f84a10cc6c6ec2d6594fab99632ebc4a825ede3fe5fd423be43.webp","original":"https://scriptblox.com/images/photo/625657db33a63a393b22e429-1691074363178.png"}},"verified":false,"views":5166,"scriptType":"free","isUniversal":true,"isP