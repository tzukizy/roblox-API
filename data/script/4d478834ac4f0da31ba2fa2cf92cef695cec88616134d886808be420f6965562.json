{"_id":"670f6f70f1a77b537de24264","title":"Overpowered","game":{"_id":"67e5e1ffb360710ec3c78758","gameId":13468284385,"name":"Color Chairs","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"13468284385-color-chairs","path":"/game/13468284385-color-chairs","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":13468284385},"slug":"Color-Chairs-Overpowered-20394","verified":false,"key":false,"keyless":false,"views":13015,"executes":9,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5b3ac25a351c6167f25f5354bf5f7eea815f1744f87e10224c328e4322339da5.webp","original":"https://scriptblox.com/images/sb/13468284385-1729064815972.png","scriptblox":"https://scriptblox.com/images/script/13468284385-1729064815972.png"},"thumbnail":{"url":"https://media.kocakz.me/5b3ac25a351c6167f25f5354bf5f7eea815f1744f87e10224c328e4322339da5.webp","original":"https://scriptblox.com/images/sb/13468284385-1729064815972.png","scriptblox":"https://scriptblox.com/images/script/13468284385-1729064815972.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-10-16T07:46:56.025Z","updatedAt":"2024-10-16T07:46:56.025Z","lastBump":"2024-10-16T07:46:56.025Z","script":"-- Made by KevinMitnickHKR (Credit when using)\n\nlocal DrRayLibrary = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/AZYsGithub/DrRay-UI-Library/main/DrRay.lua\"))()\nlocal window = DrRayLibrary:Load(\"Color Chairs - Free - 🪑\", \"Default\")\n\nlocal tab = DrRayLibrary.newTab(\"Main\", \"ImageIdHere\")\n\nlocal coins = 69\nlocal autosit = false\n\ntab.newInput(\"Coins\", \"Set The Amount Of Desired Value\", function(inputCoins)\n    coins = tonumber(inputCoins)\n    game:GetService(\"ReplicatedStorage\").EggHatchingRemotes.HatchServer:InvokeServer(\"Mythic Egg\", -coins)\nend)\n\ntab.newToggle(\"Auto Sit\", \"Toggle\", false, function(autositToggle)\n    autosit = autositToggle\n    while autosit do\n        wait(0.1)\n\n        for _, chair in ipairs(workspace:WaitForChild(\"Chairs\"):GetChildren()) do\n            if chair:IsA(\"Model\") and chair:FindFirstChild(\"Seat\") and chair.Seat.Occupant == nil then\n                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = chair:GetPrimaryPartCFrame() * CFrame.new(0, 3, 0)\n                wait(2)\n                break\n            end\n        end\n    end\nend)\n\ntab.newButton(\"Obtain Trails\", \"Obtain All Trails\", function()\n    game:GetService(\"ReplicatedStorage\").GiveAllTrails:FireServer()\nend)","features":"Coins input, Obtain all Trails, and Auto sit.","tags":[],"discord":"","keyLink":"","owner":{"_id":"66606c90fdf16ad325df6a55","username":"kevinmitnickhkr","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fd22febf336ed3c3916056053d5765e03900ca2ceec17e90695db14ef1ce56d4.webp","original":"https://scriptblox.com/images/photo/66606c90fdf16ad325df6a55-1725335963650.jpg"},"status":"offline","id":"66606c90fdf16ad325df6a55","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/fd22febf336ed3c3916056053d5765e03900ca2ceec17e90695db14ef1ce56d4.webp","original":"https://scriptblox.com/images/photo/66606c90fdf16ad325df6a55-1725335963650.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:05:54.399Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52883","editBy":{"_id":"66606c90fdf16ad325df6a55","username":"kevinmitnickhkr","status":"offline","id":"66606c90fdf16ad325df6a55"},"message":"Create script","createdAt":"2025-03-27T21:40:03.874Z"}],"comments":[{"_id":"670f7280f1a77b537de273a7","commentBy":{"_id":"6696790b279f695f38bac9c5","username":"Work*e","verified":false,"role":"user","profilePicture":{"url":"htt