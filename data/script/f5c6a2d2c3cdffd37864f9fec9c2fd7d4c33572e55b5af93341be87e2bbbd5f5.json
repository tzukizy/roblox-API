{"slug":"Universal-Script-Correct-Unfair-Advantage-words-in-chat-7431","_id":"64ec86782a98dcdec0148b3c","title":"Correct Unfair Advantage words in chat","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/4955797-1693222520168.webp","placeId":0},"features":"This script will automatically detect whenever people say 'Hack'/'Hacker'/ Whatever other variation in chat, and correct it to 'Exploit'(er)(etc)\nHas a randomized delay so it isn't suspicious\nWorks in auto-exec\nWorks on every executor","tags":["chat","hack to exploit","correct people","correct terminology"],"script":"--[[\nThis script will automatically correct anyone who says 'hack' or 'hacker' or any other variation with 'exploit' or 'exploiter'\nScript was made for a user on v3rmillion\nWritten by Amiriki\n]]\n\nrepeat task.wait() until game:IsLoaded()\nlocal ReplicatedStorage = game:GetService('ReplicatedStorage')\nlocal ChatRemote = ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest\nlocal Players = game:GetService('Players')\nfunction onChatted(msg)\n    if msg:lower():find('hack') then\n        task.wait(math.random(0.5, 1.5))\n        ChatRemote:FireServer(msg:lower():gsub('hack', 'exploit')..'*', \"All\")\n    end\nend\n\nfor i, plr in pairs(Players:GetPlayers()) do\n    plr.Chatted:Connect(onChatted)\nend\n\nPlayers.PlayerAdded:Connect(function(plr)\n    plr.Chatted:Connect(onChatted)\nend)","owner":{"_id":"64e333e865fb04d1b2d801b0","username":"Amiriki","verified":false,"profilePicture":"/images/photo/64e333e865fb04d1b2d801b0-1692611642845.png","status":"offline","id":"64e333e865fb04d1b2d801b0","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":57690,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-08-28T11:35:20.231Z","dislikeCount":0,"likeCount":2,"image":"/images/sb/4955797-1693222520168.webp","executes":21,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f83a","editBy":{"_id":"64e333e865fb04d1b2d801b0","username":"Amiriki","status":"offline","id":"64e333e865fb04d1b2d801b0"},"message":"Create script","createdAt":"2025-03-27T10:45:41.679Z"}],"comments":[{"_id":"64ec9cbb8ce5b160d3622898","commentBy":{"_id":"64e2fe02cb2e89d7ef620759","username":"estonomola11","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-08-21T06:02:42.641Z","lastActive":"2023-10-09T13:02:50.085Z","status":"offline","id":"64e2fe02cb2e89d7ef620759"},"text":"*** tier","createdAt":"2023-08-28T13:10:19.419Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64ecb95726f634aac6788129","commentBy":{"_id":"64e333e865fb04d1b2d801b0","username":"Amiriki","verified":false,"role":"user","profilePicture":"/images/photo/64e333e865fb04d1b2d801b0-1692611642845.png","createdAt":"2023-08-21T09:52:40.076Z","lastActive":"2024-01-06T10:34:38.722Z","status":"offline","id":"64e333e865fb04d1b2d801b0","topMilestone":{"key":"creator.scripts","tier":5}},"text":"what","createdAt":"2023-08-28T15:12:23.449Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64ee4a15d9ba996740437757","commentBy":{"_id":"64e2fe02cb2e89d7ef620759","username":"estonomola11","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-08-21T06:02:42.641Z","lastActive":"2023-10-09T13:02:50.085Z","status":"offline","id":"64e2fe02cb2e89d7ef620759"},"text":"doesnt work on valyse x v2 premium","createdAt":"2023-08-29T19:42:13.811Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"64ee4a191ee60b132cabf114","commentBy":{"_id":"64e2fe02cb2e89d7ef620759","username":"estonomola11","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-08-21T06:02:42.641Z","lastActive":"2023-10-09T13:02:50.085Z","status":"offline","id":"64e2fe02cb2e89d7ef620759"},"text":"please fix"