{"slug":"Universal-Script-Key-Authentication-Console-8223","_id":"65182c3bcd68c9f961ee2451","title":"Key Authentication Console","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/8266549-1696083003806.webp","placeId":0},"features":"Extendable: Can easily integrate other scripts or features in the future.\nError Handling: Prompts users for re-entry on incorrect key submission.\n\nI used the Fluxus docs not sure if it works for other executors.\n\nJust making stuff for fun Lmaoo","tags":["Console","Key System"],"script":"local correctKey = \"Key\" -- Change to your desired key\n\nrconsoletitle(\"Key Authentication System\")\nrconsoleclear()\n\nrconsoleinfo(\"*************************************************************************\\n\")\nrconsoleinfo(\"DISCLAIMER: This console script is provided as an example\\n\")\nrconsoleinfo(\"*************************************************************************\\n\")\n\nrconsoleinfo(\"Welcome to the Key Authentication System!\\n\")\nrconsoleinfo(\"---------------------------------------------------\\n\")\nrconsoleinfo(\"To get your authentication key, please join our Discord server.\\n\")\nrconsoleinfo(\"You can find the link to our server in the game's description or on our game's website.\\n\")\nrconsoleinfo(\"---------------------------------------------------\\n\")\n\nlocal keyAccepted = false\nwhile not keyAccepted do\n    rconsoleprint(\"Please enter your key: \")\n\n    -- Get the user's key input\n    local userInput = rconsoleinput()\n\n    if userInput == correctKey then\n        rconsoleinfo(\"Key Accepted! Loading the Infinite Yield Script...\\n\")\n        keyAccepted = true\n        \n        -- Load the Infinite Yield Script (or any other desired script)\n        loadstring(game:HttpGet(\"https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source\"))() -- Change URL if different\n    else\n        rconsolewarn(\"Incorrect Key. Please verify your key or join our Discord for assistance.\\n\")\n    end\nend\n","owner":{"_id":"6513770d93822f9a66e042f2","username":"Jakey","verified":false,"profilePicture":"/images/photo/6513770d93822f9a66e042f2-1695774698972.png","status":"offline","id":"6513770d93822f9a66e042f2","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":20680,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2023-09-30T14:10:03.952Z","dislikeCount":0,"likeCount":2,"image":"/images/sb/8266549-1696083003806.webp","executes":15,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4fb1b","editBy":{"_id":"6513770d93822f9a66e042f2","username":"Jakey","status":"offline","id":"6513770d93822f9a66e042f2"},"message":"Create script","createdAt":"2025-03-27T18:16:15.874Z"}],"comments":[{"_id":"651837ffcd68c9f961ef1feb","commentBy":{"_id":"62f8aa6a9541ae5f4e58c5f7","username":"collorem","verified":false,"role":"user","profilePicture":"/images/photo/62f8aa6a9541ae5f4e58c5f7-1691005877745.jpg","createdAt":"2022-08-14T07:55:22.182Z","lastActive":"2023-10-07T00:31:58.719Z","status":"offline","id":"62f8aa6a9541ae5f4e58c5f7","topMilestone":{"key":"creator.followers","tier":10}},"text":"not secure","createdAt":"2023-09-30T15:00:15.851Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"651852ced3d3bbcd23a467b4","commentBy":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"role":"user","profilePicture":"/images/photo/64cb81f82512701e9a163c00-1699804719964.gif","createdAt":"2023-08-03T10:31:20.738Z","lastActive":"2026-10-04T08:41:27.719Z","status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13466257}},"topMilestone":{"key":"creator.views","tier":10000000}},"text":"not secure 2","createdAt":"2023-09-30T16:54:38.903Z","edited":true,"likeCount":1,"li