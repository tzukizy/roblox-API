{"slug":"110-Find-The-Bacons-Find-all-Bacons-5680","_id":"631df90d65c25e5884e23e33","title":"Find all Bacons","game":{"_id":"67e5e1ffb360710ec3c788e9","gameId":8891045283,"name":"[110] Find The Bacons","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":8891045283},"features":"Finds most of the bacons in \"Find The Bacons\"\n(gets all touch-based bacons atleast)","tags":["find the","find the bacons","badge","badges"],"script":"-- https://scriptblox.com/u/crimewave\n\nlocal root = game.Players.LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\n\nlocal bacons = game:GetService(\"Workspace\").AllBacons\n\nfor i, v in ipairs(bacons:GetDescendants()) do\n\tif v:IsA(\"TouchTransmitter\") and v.Parent.Name ~= \"Disconnected Bacon\" then\n\t\tfiretouchinterest(root, v.Parent, 0)\n\t\tfiretouchinterest(root, v.Parent, 1)\n\tend\nend","owner":{"_id":"63120394ebde93fd5e75d6ed","username":"crimewave","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/63120394ebde93fd5e75d6ed-1662125142182.png"},"status":"offline","id":"63120394ebde93fd5e75d6ed","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/63120394ebde93fd5e75d6ed-1662125142182.png"}},"verified":false,"views":9050,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-09-11T15:04:45.766Z","dislikeCount":0,"likeCount":3,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/85f55b550e5a359ef438280ca2d2d2b4/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/85f55b550e5a359ef438280ca2d2d2b4/500/280/Image/Jpeg"},"executes":62,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d