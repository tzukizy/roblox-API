{"slug":"110-Find-The-Bacons-Find-all-Bacons-5680","_id":"631df90d65c25e5884e23e33","title":"Find all Bacons","game":{"_id":"67e5e1ffb360710ec3c788e9","gameId":8891045283,"name":"[110] Find The Bacons","imageUrl":"https://tr.rbxcdn.com/85f55b550e5a359ef438280ca2d2d2b4/500/280/Image/Jpeg","placeId":8891045283},"features":"Finds most of the bacons in \"Find The Bacons\"\n(gets all touch-based bacons atleast)","tags":["find the","find the bacons","badge","badges"],"script":"-- https://scriptblox.com/u/crimewave\n\nlocal root = game.Players.LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\n\nlocal bacons = game:GetService(\"Workspace\").AllBacons\n\nfor i, v in ipairs(bacons:GetDescendants()) do\n\tif v:IsA(\"TouchTransmitter\") and v.Parent.Name ~= \"Disconnected Bacon\" then\n\t\tfiretouchinterest(root, v.Parent, 0)\n\t\tfiretouchinterest(root, v.Parent, 1)\n\tend\nend","owner":{"_id":"63120394ebde93fd5e75d6ed","username":"crimewave","verified":false,"profilePicture":"/images/photo/63120394ebde93fd5e75d6ed-1662125142182.png","status":"offline","id":"63120394ebde93fd5e75d6ed","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":9042,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-09-11T15:04:45.766Z","dislikeCount":0,"likeCount":3,"image":"https://tr.rbxcdn.com/85f55b550e5a359ef438280ca2d2d2b4/500/280/Image/Jpeg","executes":60,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b966","editBy":{"_id":"63120394ebde93fd5e75d6ed","username":"crimewave","status":"offline","id":"63120394ebde93fd5e75d6ed"},"message":"Create script","createdAt":"2022-09-12T10:57:44.596Z"},{"_id":"67e5e1e4b360710ec3c4ec9a","editBy":{"_id":"63120394ebde93fd5e75d6ed","username":"crimewave","status":"offline","id":"63120394ebde93fd5e75d6ed"},"message":"Update script","createdAt":"2025-03-27T07:17:26.003Z"}],"comments":[]}