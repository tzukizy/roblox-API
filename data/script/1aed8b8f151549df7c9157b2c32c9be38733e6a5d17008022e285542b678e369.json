{"slug":"UPDATE-1-Attack-on-Titan-Revolution-REVOLUTI-NAPE-EXPANDER-14900","_id":"667f313491cb704443e063b3","title":"AOT:R NAPE EXPANDER","game":{"_id":"67e5e1ffb360710ec3c77d18","gameId":13379208636,"name":"Attack on Titan Revolution","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13379208636},"features":"Nape Expander Open source\nDont use carnifex or butcher perk or u will get banned.\nDont extend more than default settings","tags":[],"script":"local workspace = game:GetService(\"Workspace\")\n\nlocal function findNape(hitFolder)\n    return hitFolder:FindFirstChild(\"Nape\")\nend\n\nlocal function expandNapeHitbox(hitFolder)\n    local napeObject = findNape(hitFolder)\n    if napeObject then\n        napeObject.Size = Vector3.new(105, 120, 100)\n        napeObject.Transparency = 0.96\n        napeObject.Color = Color3.new(1, 1, 1)\n        napeObject.Material = Enum.Material.Neon\n        napeObject.CanCollide = false\n        napeObject.Anchored = false\n    end\nend\n\nlocal function processTitans(titansBasePart)\n    for _, titan in ipairs(titansBasePart:GetChildren()) do\n        local hitboxesFolder = titan:FindFirstChild(\"Hitboxes\")\n        if hitboxesFolder then\n            local hitFolder = hitboxesFolder:FindFirstChild(\"Hit\")\n            if hitFolder then\n                expandNapeHitbox(hitFolder)\n            end\n        end\n    end\nend\n\nprint(\"Nape Expander Loaded\")\n\nlocal titansBasePart = workspace:FindFirstChild(\"Titans\")\nif titansBasePart then\n    processTitans(titansBasePart)\nend","owner":{"_id":"6654b09401c49f10a041724b","username":"Slynn","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/ddbe8c7aab286e5459ee22e25d972227b57e24e58e86fb20b465c3f116fb4229.webp","original":"https://scriptblox.com/images/photo/6654b09401c49f10a041724b-1716826323132.png"},"status":"offline","id":"6654b0940