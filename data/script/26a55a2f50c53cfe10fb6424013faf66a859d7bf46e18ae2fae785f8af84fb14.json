{"slug":"a-literal-baseplate.-Chnge-Mins-on-litirl-bseplte-15457","_id":"668d796cf86a688e6c00a258","title":"Chnge Mins on  litirl bseplte","game":{"_id":"67e5e1ffb360710ec3c77dac","gameId":4483381587,"name":"[TITLE UNAVAILABLE]","imageUrl":"https://tr.rbxcdn.com/180DAY-87249609dae614261c1058785f217b72/480/270/UnapprovedImage/Png/noFilter","placeId":4483381587},"features":"Makes mins go wooo","tags":[],"script":"-- Get the player and their leaderstats\nlocal player = game.Players.LocalPlayer\nlocal leaderstats = player:WaitForChild(\"leaderstats\")\nlocal minutesStat = leaderstats:WaitForChild(\"Minutes\")\n\n-- Function to increment the \"Minutes\" stat\nlocal function incrementMinutes()\n    minutesStat.Value = minutesStat.Value + 1\nend\n\n-- Function to start the timer\nlocal function startMinuteTimer()\n    -- Repeat indefinitely\n    while true do\n        -- Wait for 60 seconds (1 minute)\n        wait(1)\n        \n        -- Increment the \"Minutes\" stat\n        incrementMinutes()\n    end\nend\n\n-- Start the minute timer\nstartMinuteTimer()\n","owner":{"_id":"64e4ce7e745e83246e30c6ba","username":"maxmaster3602","verified":false,"profilePicture":"/images/photo/64e4ce7e745e83246e30c6ba-1720289974930.jpg","status":"offline","id":"64e4ce7e745e83246e30c6ba"},"verified":false,"keyLink":"","views":9972,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-09T17:54:52.100Z","dislikeCount":1,"likeCount":1,"image":"/images/sb/4483381587-1720547692059.png","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c71f","editBy":{"_id":"64e4ce7e745e83246e30c6ba","username":"maxmaster3602","status":"offline","id":"64e4ce7e745e83246e30c6ba"},"message":"Create script","createdAt":"2024-07-09T18:03:29.533Z"},{"_id":"67e5e1e5b360710ec3c51525","editBy":{"_id":"64e4ce7e745e83246e30c6ba","username":"maxmaster3602","status":"offline","id":"64e4ce7e745e8