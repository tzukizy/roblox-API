{"slug":"Universal-Script-funny-hub-193796","_id":"69d57d6415a034bc421bb7a4","title":"funny hub","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"you can ban players\n\nif something don't work get me I'm on line a lot","tags":["super gaming"],"script":"local RS = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal event = RS:WaitForChild(\"FunnyHubEvent\")\n\nlocal gui = script.Parent\n\n-- 😂 OPEN BUTTON\nlocal open = Instance.new(\"TextButton\", gui)\nopen.Size = UDim2.new(0,130,0,45)\nopen.Position = UDim2.new(0,10,1,-55)\nopen.Text = \"😂 FUNNY HUB\"\n\n-- 🎨 MAIN PANEL\nlocal frame = Instance.new(\"Frame\", gui)\nframe.Size = UDim2.new(0,450,0,280)\nframe.Position = UDim2.new(0.5,-225,0.5,-140)\nframe.BackgroundColor3 = Color3.fromRGB(20,20,20)\nframe.Visible = false\n\n-- TITLE\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1,0,0,40)\ntitle.Text = \"😂 FUNNY HUB 😂\"\ntitle.TextScaled = true\ntitle.BackgroundTransparency = 1\ntitle.TextColor3 = Color3.fromRGB(255,255,255)\n\n-- PLAYER LIST\nlocal list = Instance.new(\"ScrollingFrame\", frame)\nlist.Size = UDim2.new(0,200,1,-50)\nlist.Position = UDim2.new(0,10,0,45)\n\nlocal selected = nil\n\n-- ACTIONS\nlocal actions = {\n    {\"Kick 😂\",\"kick\"},\n    {\"Ban 💀\",\"ban\"},\n    {\"Give Coins 💰\",\"coins\"},\n    {\"Teleport 🚀\",\"tp\"},\n    {\"God Mode 😈\",\"god\"}\n}\n\nfor i,data in pairs(actions) do\n    local name, action = data[1], data[2]\n\n    local b = Instance.new(\"TextButton\", frame)\n    b.Size = UDim2.new(0,210,0,35)\n    b.Position = UDim2.new(0,230,0,50 + (i-1)*45)\n    b.Text = name\n\n    b.MouseButton1Click:Connect(function()\n        if selected then\n            event:FireServer(action, selected)\n        end\n    end)\nend\n\n-- TOGGLE\nopen.MouseButton1Click:Connect(function()\n    frame.Visible = not frame.Visible\nend)\n\n-- PLAYER LIST\nlocal function refresh()\n    for _,v in pairs(list:GetChildren()) do\n        if v:IsA(\"TextButton\") then v:Destroy() end\n    end\n\n    local y = 0\n    for _,p in pairs(Players:GetPlayers()) do\n        local b = Instance.new(\"TextButton\", list)\n        b.Size = UDim2.new(1,0,0,30)\n        b.Position = UDim2.new(0,0,0,y)\n        b.Text = p.Name\n\n        b.MouseButton1Click:Connect(function()\n            selected = p.Name\n        end)\n\n        y += 30\n    end\nend\n\nPlayers.PlayerAdded:Connect(refresh)\nPlayers.PlayerRemoving:Connect(refresh)\nrefresh()","owner":{"_id":"69c602438308c2a0ffbb43ed","username":"gavinthesigma","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8c7b3be2ad30c9419c91cc8357f2eccce8b090b9889e8a1956f6fb6287f12b62.webp","original":"https://scriptblox.com/images/photo/69c602438308c2a0ffbb43ed-1774660153378.jpeg"},"status":"offline","id":"69c602438308c2a0ffbb43ed","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/8c7b3be2ad30c9419c91cc8357f2eccce8b090b9889e8a1956f6fb6287f12b62.webp","original":"https://scriptblox.com/images/photo/69c602438308c2a0ffbb43ed-1774660153378.jpeg"}},"verified":false,"views":977,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/3f07b887931782a2a57f06d2b2a33c059b30e37d8d9b2a587d45b394f736a2ae.webp","original":"https://scriptblox.com/images/sb/0-1775598948461.jpg","scriptblox":"https://scriptblox.com/images/script/0-1775598948461.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-07T21:55:48.474Z","editBy":{"_id":"69c602438308c2a0ffbb43ed","username":"gavinthesigma","status":"offline","id":"69c602438308c2a0ffbb43ed"},"keyLink":"","executes":1056,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0