ayer.Character.HumanoidRootPart.CFrame = CFrame.new(originalPosition)\n            break\n        end\n        task.wait(1)\n    end\nend\n\nteleport()\nplayer.CharacterAdded:Connect(teleport)","features":"WARNING!!! Do not use more than once when in-game.\n\nTeleports you to the ak47 in Prison Life when ran and after respawn. Can easily change location target if needed. Works for inmates and guards (does not switch team to criminals if you are on the inmates team)\n\nAny bugs or recommendations for new scripts, post in comments please!","tags":[],"discord":"","keyLink":"","owner":{"_id":"67c49d2ffcc125c6206e8195","username":"C4_082","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c49b23e0f49fe94c01b517d6bcec93c8d5d62d6d750b36794f3608912cba2d53.webp","original":"https://scriptblox.com/images/photo/67c49d2ffcc125c6206e8195-1764976244406.png"},"status":"offline","id":"67c49d2ffcc125c6206e8195","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/c49b23e0f49fe94c01b517d6bcec93c8d5d62d6d750b36794f3608912cba2d53.webp","original":"https://scriptblox.com/images/photo/67c49d2ffcc125c6206e8195-1764976244406.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:52:05.710Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6933661932e62e631f0e7f36","editBy":{"_id":"67c49d2ffcc125c6206e8195","username":"C4_082","status":"offline","id":"67c49d2ffcc125c6206e8195"},"message":"Create script","createdAt":"2025-12-05T23:09:13.478Z"}],"comments":[{"_id":"693492598eee164afa2dad37","commentBy":{"_id":"67c49d2ffcc125c6206e8195","username":"C4_082","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c49b23e0f49fe94c01b517d6bcec93c8d5d62d6d750b36794f3608912cba2d53.webp","original":"https://scriptblox.com/images/photo