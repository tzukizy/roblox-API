{"_id":"68320e9241475527f39c0ee7","title":"Walkable desync","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/b8832776517d5285da24b8e488c588a88f793d6f261da5077a541cedd4c27ea1.webp","original":"https://scriptblox.com/images/sb/0-1748110993980.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/b8832776517d5285da24b8e488c588a88f793d6f261da5077a541cedd4c27ea1.webp","original":"https://scriptblox.com/images/sb/0-1748110993980.png"},"placeId":0},"slug":"Universal-Script-Walkable-desync-40864","verified":false,"key":false,"keyless":false,"views":8458,"executes":229,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/99a9925157a7e22300ecabaddafeea94d8012e9e055979a8f946efec2a0c3669.webp","original":"https://scriptblox.com/images/sb/0-1748110993980.png","scriptblox":"https://scriptblox.com/images/script/0-1748110993980.png"},"thumbnail":{"url":"https://media.kocakz.me/99a9925157a7e22300ecabaddafeea94d8012e9e055979a8f946efec2a0c3669.webp","original":"https://scriptblox.com/images/sb/0-1748110993980.png","scriptblox":"https://scriptblox.com/images/script/0-1748110993980.png"},"likeCount":2,"dislikeCount":2,"createdAt":"2025-05-24T18:23:14.037Z","updatedAt":"2025-05-24T18:23:14.037Z","lastBump":"2025-05-24T18:23:14.037Z","script":"\ngetgenv().DesyncEnabled = true\n\n\nlocal function clearUnwantedScripts(character)\n    for _, v in pairs(character:GetChildren()) do\n        if v:IsA(\"Script\") and v.Name ~= \"Health\" and v.Name ~= \"Sound\" and v:FindFirstChild(\"LocalScript\") then\n            v:Destroy()\n        end\n    end\nend\n\n\ngame.Players.LocalPlayer.CharacterAdded:Connect(function(char)\n    repeat task.wait() until char \n    clearUnwantedScripts(char)\n    \n    char.ChildAdded:Connect(function(child)\n        if child:IsA(\"Script\") and child:FindFirstChild(\"LocalScript\") then\n            task.wait(0.25) \n            child.LocalScript:FireServer() \n        end\n    end)\nend)\n\n\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    if getgenv().DesyncEnabled then\n        local hrp = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character.HumanoidRootPart\n        if hrp then\n            local currentVelocity = hrp.Velocity\n            \n            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(0.0001), 0)\n        \n            hrp.AssemblyLinearVelocity = Vector3.new(math.random(2000, 4000), math.random(2000, 4000), math.random(2000, 4000))\n            game:GetService(\"RunService\").RenderStepped:Wait() \n            hrp.Velocity = currentVelocity \n        end\n    end\nend)\n\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal toggleKey = Enum.KeyCode.E -- Change this to any key\n\nUserInputService.InputBegan:Connect(function(input, gameProcessedEvent)\n    if not gameProcessedEvent and input.KeyCode == toggleKey then\n        getgenv().DesyncEnabled = not getgenv().DesyncEnabled\n        print(\"Desync \" .. (getgenv().DesyncEnabled and \"Enabled\" or \"Disabled\"))\n    end\nend)","features":"Walkable desync\n\nChangeable keybind (normal keybind is E)","tags":["desync","anti aim"],"discord":"","keyLink":"","owner":{"_id":"6804f837cd40f6a1ad031a9d","username":"i1231931","verified":false,"profilePicture":{"url":"https://media.kocakz.me/006861f24dd3d922885356277f52520b527322213fb09c7c5286fa431f46dfae.webp","original":"https://scriptblox.com/images/photo/6804f837cd40f6a1ad031a9d-1775759283220.png"},"status":"offline","id":"6804f837cd40f6a1ad031a9d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/006861f24dd3d922885356277f52520b527322213fb09c7c5286fa431f46dfae.webp","original":"https://scriptblox.com/images/photo/6804f837cd40f6a1ad031a9d-1775759283220.png"}},"reviewed":null,"liked":false,"disliked":false,"cstat