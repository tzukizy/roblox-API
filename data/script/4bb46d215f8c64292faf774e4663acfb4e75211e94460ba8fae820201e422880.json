{"_id":"6a39624fe9b28162ce16c283","title":"Actor bypass execute anything on the Actor","game":{"_id":"6a2e492eab0643b6675a3400","gameId":94987506187454,"name":"REDLINER [⚡UZI]","imageUrl":{"url":"https://media.kocakz.me/2b0e696e953d3656432201e3bd5114c3fb4c6eb2c501f10673b070c9054a6104.webp","original":"https://tr.rbxcdn.com/180DAY-5da2b124681f1ae4ec96f16cf2a95a37/150/150/Image/Png/noFilter"},"slug":"94987506187454-redliner","path":"/game/94987506187454-redliner","thumbnail":{"url":"https://media.kocakz.me/2b0e696e953d3656432201e3bd5114c3fb4c6eb2c501f10673b070c9054a6104.webp","original":"https://tr.rbxcdn.com/180DAY-5da2b124681f1ae4ec96f16cf2a95a37/150/150/Image/Png/noFilter"},"placeId":94987506187454},"slug":"REDLINER-Actor-bypass-execute-anything-on-the-Actor-238687","verified":true,"key":false,"keyless":false,"views":5469,"executes":3838,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d1c410fc3c149e4442fc945806c15b628538f2fb6d14c075fd540c8a926407da.webp","original":"https://scriptblox.com/images/sb/94987506187454-1782145808548.png","scriptblox":"https://scriptblox.com/images/script/94987506187454-1782145808548.png"},"thumbnail":{"url":"https://media.kocakz.me/d1c410fc3c149e4442fc945806c15b628538f2fb6d14c075fd540c8a926407da.webp","original":"https://scriptblox.com/images/sb/94987506187454-1782145808548.png","scriptblox":"https://scriptblox.com/images/script/94987506187454-1782145808548.png"},"likeCount":6,"dislikeCount":3,"createdAt":"2026-06-22T16:26:55.566Z","updatedAt":"2026-06-22T16:26:55.566Z","lastBump":"2026-06-22T16:26:55.566Z","script":"-- depso\n-- This MUST be in Autoexec as the Actor will disable itself to prevent tamper\n\n--// Auto exec check, must run before ReplicatedFirst\nif game:IsLoaded() then\n    warn(\"Script must be in Autoexec!\")\n    return\nend\n\nconst function HookActor(Actor: Actor, TrampolineCommID: number)\n    -- You could use script:GetActor() but some executors like Potassium don't have a script global\n    run_on_actor(Actor, [[\n        const ActorName, TrampolineCommID = ...\n        const Trampoline = get_comm_channel(TrampolineCommID)\n        const Actor = game:GetService(\"ReplicatedFirst\"):WaitForChild(ActorName)\n        \n        if not Trampoline then\n            warn(\"Unable to fetch trampoline comm, UNSAFE\")\n            return\n        end\n\n        --// [EXAMPLE PAYLOAD] - dumps functions from the ClientRoot script \n        const ClientRoot = require(Actor.Start.Client.ClientRoot)\n        for Index, Value in next, debug.getupvalues(ClientRoot.Init) do\n            if typeof(Value) == \"function\" then\n                print(debug.info(Value, \"n\"))\n            else\n                print(Value)\n            end\n        end\n\n        --// Trampoline back\n        Trampoline:Fire()\n    ]], Actor.Name, TrampolineCommID)\nend\n\nconst Actor = cloneref(game:GetService(\"ReplicatedFirst\"):WaitForChild(\"Workspace\"))\n\n--// Fake a LocalScript to keep the actor active with the init disabled\nconst FakeInit = cloneref(Instance.new(\"LocalScript\", Actor))\nFakeInit.Enabled = true\nFakeInit.Name = \"Start\"\n\n--// Disable Actor init script\nconst RealInit = cloneref(Actor:WaitForChild(\"Start\"))\nRealInit.Enabled = false\n\n--// Trampoline comm\nconst TrampolineCommID, Trampoline = create_comm_channel()\nTrampoline.Event:Once(function()\n    RealInit.Enabled = true -- If you want to keep the Actor disabled for saveinstance reasons, comment this line out but the game will timeout and kick you after some time\n    FakeInit:Destroy()\n\n    warn(\"Successfully ran payload!\")\nend)\n\n--// Wait for the actor to become active\nwhile true do\n    const Success = pcall(HookActor, Actor, TrampolineCommID)\n    if Success then break end\n\n    task.wait()\nend","features":"This MUST be in Autoexec as the Actor will disable itself to prevent tamper\n\nExample payload is provided, please saveinstance to write your own scripts for this game!","tags":["bypass","util","example","open source"],"discord":"","keyLink":"","owner":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","verified":true,"profilePicture":{"url":"https://media.kocakz.me/1b35ef0065f63de7752aeed1639eb42485a1fab66658499cbc66da439d7aecd6.webp","original":"https://scriptblox.com/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg"},"lvl":9,"status":"offline","id":"682d7e6cb9ed364b3a0bda05","topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/1b35ef0065f63de7752aeed1639eb42485a1fab66658499cbc66da439d7aecd6.webp","original":"https://scriptblox.com/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:34:09.995Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a39624fe9b28162ce16c285","editBy":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","status":"offline","id":"682d7e6cb9ed364b3a0bda05"},"message":"Create script","createdAt":"2026-06-22T16:26:55.568Z"}],"comments":[{"_id":"6a396d001be43c13cd72d37d","commentBy":{"_id":"6a393b37671a41a8d7301072","username":"gorferss","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-07-12T23:10:04.381Z","createdAt":"2026-06-22T13:40:07.330Z","status":"offline","id":"6a393b37671a41a8d7301072","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"what does this help with","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-06-22T17:12:32.803Z","liked":false,"disliked":false},{"_id":"6a39723b01df8f19976701e6","commentBy":{"_id":"69ec992ca2b179af7cd83ae9","username":"ifprogod","verified":false,"role":"user","profilePicture":{"url":"https://med