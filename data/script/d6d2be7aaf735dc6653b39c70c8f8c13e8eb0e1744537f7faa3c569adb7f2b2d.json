il\n\nlocal function setupCharacter(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n    local animation = Instance.new(\"Animation\")\n    animation.AnimationId = \"rbxassetid://72722244508749\"\n    local animator = humanoid:FindFirstChildOfClass(\"Animator\") or Instance.new(\"Animator\", humanoid)\n    local animTrack = animator:LoadAnimation(animation)\n\n    screenGui:ClearAllChildren()\n\n    local frame = Instance.new(\"Frame\")\n    frame.Size = UDim2.new(0, 200, 0, 100)\n    frame.Position = UDim2.new(0.5, -100, 0.5, -50)\n    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\n    frame.BorderSizePixel = 0\n    frame.Parent = screenGui\n    frame.Active = true\n    frame.Draggable = true\n\n    local playBtn = Instance.new(\"TextButton\")\n    playBtn.Size = UDim2.new(0, 180, 0, 40)\n    playBtn.Position = UDim2.new(0, 10, 0, 10)\n    playBtn.Text = \"Play Animation\"\n    playBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)\n    playBtn.TextColor3 = Color3.new(1, 1, 1)\n    playBtn.Parent = frame\n\n    playBtn.MouseButton1Click:Connect(function()\n        animTrack:Play()\n    end)\n\n    local keybindBtn = Instance.new(\"TextButton\")\n    keybindBtn.Size = UDim2.new(0, 180, 0, 40)\n    keybindBtn.Position = UDim2.new(0, 10, 0, 50)\n    keybindBtn.Text = currentKey and (\"Set Keybind (Current: \" .. tostring(currentKey) .. \")\") or \"Set Keybind (Current: none)\"\n    keybindBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 150)\n    keybindBtn.TextColor3 = Color3.new(1, 1, 1)\n    keybindBtn.TextScaled = true\n    keybindBtn.Parent = frame\n\n    local waitingForKey = false\n\n    keybindBtn.MouseButton1Click:Connect(function()\n        keybindBtn.Text = \"Press a key...\"\n        waitingForKey = true\n    end)\n\n    UserInputService.InputBegan:Connect(function(input, gameProcessed)\n        if waitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then\n            currentKey = input.KeyCode\n            keybindBtn.Text = \"Set Keybind (Current: \" .. tostring(currentKey) .. \")\"\n            waitingForKey = false\n        elseif currentKey and input.KeyCode == currentKey and not gameProcessed then\n            animTrack:Play()\n        end\n    end)\nend\n\nif player.Character then\n    setupCharacter(player.Character)\nend\n\nplayer.CharacterAdded:Connect(function(char)\n    setupCharacter(char)\nend)\n","features":"Mobile and Pc Support","tags":["Forsaken"],"discord":"","keyLink":"","owner":{"_id":"6796b1b9b81fb3da1d3b033a","username":"F3Tx","verified":false,"profilePicture":{"url":"https://media.kocakz.me/677ae2d4849f4f8f9724cf69ccc32b3bc36e2de7b7077e867df51345c75ae9a5.webp","original":"https://scriptblox.com/images/photo/6796b1b9b81fb3da1d3b033a-1759183201524.png"},"status":"offline","id":"6796b1b9b81fb3da1d3b033a","leaderboard":{"tag":null},"topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/677ae2d4849f4f8f9724cf69ccc32b3bc36e2de7b7077e867df51345c75ae9a5.webp","original":"https://scriptblox.com/images/photo/6796b1b9b81fb3da1d3b033a-1759183201524.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-22T21:26:16.414Z","last":"b","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d9695376146a8207c8766a","editBy":{"_id":"6796b1b9b81fb3da1d3b033a","username":"F3Tx","status":"offline","id":"6796b1b9b81fb3da1d3b033a"},"message":"Create script","createdAt":"2025-09-28T16:58:59.156Z"}],"comments":[{"_id":"68d969dafd24bdd00ebb932c","commentBy":{"_id":"68d9698503da1ec2097a0a77","username":"Wyatt123","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-09-28T16:59:49.965Z","lastActive":"2025-09-28T17:04:27.107Z","status":"offline","id":"68d9698503da1ec2097a0a77","profile":{"url":"https: