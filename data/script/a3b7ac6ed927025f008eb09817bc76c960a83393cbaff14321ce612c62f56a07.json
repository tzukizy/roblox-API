{"_id":"6764f36946fd0685a6560c21","title":"classic parachute","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/b09041fd484e1d0c0ddac91aab931ffe317d08c05d856660147a6622c96691f4.webp","original":"https://scriptblox.com/images/sb/2678325-1734669160932.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/b09041fd484e1d0c0ddac91aab931ffe317d08c05d856660147a6622c96691f4.webp","original":"https://scriptblox.com/images/sb/2678325-1734669160932.png"},"placeId":0},"slug":"Universal-Script-classic-parachute-24843","verified":false,"key":false,"keyless":false,"views":9455,"executes":1344,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6de62715de930f0740a8f45e51cd2372f596f19635794308d511b29b41eed0a2.webp","original":"https://scriptblox.com/images/sb/2678325-1734669160932.png","scriptblox":"https://scriptblox.com/images/script/2678325-1734669160932.png"},"thumbnail":{"url":"https://media.kocakz.me/6de62715de930f0740a8f45e51cd2372f596f19635794308d511b29b41eed0a2.webp","original":"https://scriptblox.com/images/sb/2678325-1734669160932.png","scriptblox":"https://scriptblox.com/images/script/2678325-1734669160932.png"},"likeCount":3,"dislikeCount":2,"createdAt":"2024-12-20T04:32:41.056Z","updatedAt":"2024-12-20T04:32:41.056Z","lastBump":"2024-12-20T04:32:41.056Z","script":"local parachute = Instance.new(\"Tool\", game.Players.LocalPlayer.Backpack)\nparachute.Name = \"Parachute\"\nparachute.TextureId = \"rbxassetid://12092573037\"\nparachute.CanBeDropped = false\nparachute.RequiresHandle = true\n\nlocal handle = Instance.new(\"Part\", parachute)\nhandle.Name = \"Handle\"\nhandle.Size = Vector3.new(0.05, 0.05, 0.05)  \nhandle.Color = Color3.fromRGB(0, 0, 0) \nhandle.Anchored = false\nhandle.CanCollide = false\n\nlocal velocity = Instance.new(\"BodyVelocity\", handle)\nvelocity.MaxForce = Vector3.new(0, 99999, 0) \nvelocity.Velocity = Vector3.new(0, -10, 0)  \n\nlocal sphere = nil  \n\nparachute.Equipped:Connect(function()\n    sphere = Instance.new(\"Part\")\n    sphere.Shape = Enum.PartType.Ball\n    sphere.Size = Vector3.new(2, 1, 2) \n    sphere.Position = game.Players.LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0)  \n    sphere.Anchored = false  \n    sphere.CanCollide = false  \n    sphere.BrickColor = BrickColor.new(Color3.fromRGB(0, 0, 0))  \n    \n    sphere.Material = Enum.Material.SmoothPlastic\n    \n    local mesh = Instance.new(\"SpecialMesh\")\n    mesh.MeshType = Enum.MeshType.Sphere\n    mesh.Scale = Vector3.new(4, 2, 4)  \n    mesh.Parent = sphere\n    \n    sphere.Parent = game.Workspace\n\n    velocity.Parent = handle\n\n    game:GetService(\"RunService\").Heartbeat:Connect(function()\n        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local humanoidRootPart = game.Players.LocalPlayer.Character.HumanoidRootPart\n            local currentVelocity = humanoidRootPart.Velocity\n\n            velocity.Velocity = Vector3.new(0, -10, 0)  \n        end\n    end)\nend)\n\nparachute.Unequipped:Connect(function()\n    if sphere then\n        sphere:Destroy()\n    end\n\n    local bodyVelocity = handle:FindFirstChild(\"BodyVelocity\")\n    if bodyVelocity then\n        bodyVelocity.Parent = nil  \n    end\nend)\n\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    if sphere and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then\n        sphere.Position = game.Players.LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0)\n    end\nend)","features":"upgrade of some other simple parachute, i fixed the horizontal movement system, added a actually gear item and fixed a bunch of other bugs! :D\n\nOnly downside is the parachute model isn't server side, i might make it serverside later.","tags":["parachute","fe","cool","open source","free"],"discord":"","keyLink":"","owner":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","verified":false,"profilePicture":{"url":"https://media.kocakz.me/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"},"lvl":11,"status":"offline","id":"64ec64fa4f538af76763524a","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/231a91d6e162f05365b7028fe6fbcea55488e840152444b0d517467f8e14c6f9.webp","original":"https://scriptblox.com/images/photo/64ec64fa4f538af76763524a-1773045289605.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:38:36.566Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c539e7","createdAt":"2025-03-27T22:11:50.857Z","editBy":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","status":"offline","id":"64ec64fa4f538af76763524a"},"message":"Create script"}],"comments":[{"_id":"676557d7644ed1ba0b45f897","commentBy":{"_id":"64e29e08c7e5b92e28041d34","username":"Fnfcharters","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b78ebf091b9b4d9c52c118bbd5615363f7134c2e4e78e7989517078193eee16b.webp","original":"https://scriptblox.com/images/photo/64e29e08c7e5b92e28041d34-1729374775148.jpg"},"createdAt":"2023-08-20T23:13:12.688Z","lastActive":"2025-05-01T03:49:20.219Z","status":"offline","id":"64e29e08c7e5b92e28041d34","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/b78ebf091b9b4d9c52c118bbd5615363f7134c2e4e78e7989517078193eee16b.webp","original":"https://scriptblox.com/images/photo/64e29e08c7e5b92e28041d34-1729374775148.jpg"}},"cr