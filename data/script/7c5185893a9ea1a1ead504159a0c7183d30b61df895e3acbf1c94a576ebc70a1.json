{"slug":"Pet-Simulator-99!-NEW-efficient-auto-collect-orbs-9445","_id":"656ff68f0b1aa488a92d7afe","title":"efficient auto collect orbs","game":{"_id":"67e5e1ffb360710ec3c77d3b","gameId":8737899170,"name":"⛏️ [MINE] Pet Simulator 99! 🚀","imageUrl":"/images/sb/rbx-5a39cc7a7da0931e554dfead3d11c13d-edf2cb2a7ed3.png","placeId":8737899170},"features":"collect stuff from your autofarm while you open eggs.","tags":[],"script":"local a = game.Players.LocalPlayer.Character.HumanoidRootPart\nlocal b = workspace.__THINGS\n\nlocal function get()\n    local cf = a.CFrame\n    for i,v in pairs(b.Lootbags:GetChildren()) do\n    v:PivotTo(cf)\n    end\n    for i,v in pairs(b.Orbs:GetChildren()) do\n    v:PivotTo(cf)\n\n    end\nend\n\n\nwhile task.wait(0.5) do\nget()\nend","owner":{"_id":"63280cb12362bb8dea8e0c61","username":"daz_","verified":false,"profilePicture":"/images/photo/63280cb12362bb8dea8e0c61-1663607648317.png","status":"offline","id":"63280cb12362bb8dea8e0c61","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":45238,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-12-06T04:20:31.394Z","dislikeCount":1,"likeCount":2,"image":"/images/sb/8737899170-1701836431347.webp","executes":51,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bec7","editBy":{"_id":"63280cb12362bb8dea8e0c61","username":"daz_","status":"offline","id":"63280cb12362bb8dea8e0c61"},"message":"Create script","createdAt":"2023-12-07T18:23:10.656Z"},{"_id":"67e5e1e4b360710ec3c4ff6c","editBy":{"_id":"63280cb12362bb8dea8e0c61","username":"daz_","status":"offline","id":"63280cb12362bb8dea8e0c61"},"message":"Update script","createdAt":"2025-03-27T23:10:04.561Z"}],"comments":[{"_id":"65702612835d37c99116c484","commentBy":{"_id":"628f60e9630b1d3ab95d329a","username":"FrancesXiis","verified":false,"role":"user","profilePicture":"/images/photo/628f60e9630b1