{"slug":"Immortal-Craftwars-Revamped-(BETA)-ICV-kill-all-27410","_id":"679131cd7900406854e09e09","title":"ICV kill all","game":{"_id":"67e5e1ffb360710ec3c78560","gameId":116113757413163,"name":"Immortal Craftwars Revamped (BETA)","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":116113757413163},"features":"kills all enemies","tags":[],"script":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\nlocal game = game\nlocal players = game:GetService(\"Players\")\nlocal localPlayer = players.LocalPlayer\nlocal character = localPlayer.Character\nlocal runService = game:GetService(\"RunService\")\nlocal cd = 0\n\nrunService.RenderStepped:Connect(function(delta)\n    character = localPlayer.Character\n    local weapon = character:FindFirstChildWhichIsA(\"Tool\")\n    if cd > 0.5 then\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"EnemyMain\") and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"FEMeleeKitEvents\") then\n                weapon.FEMeleeKitEvents.Attack.Attack_Server:FireServer(v,\"Handle\")\n            elseif v:FindFirstChild(\"Humanoid\") and v:FindFirstChild(\"EnemyMain\") and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"RemoteFunction\") then\n                weapon.RemoteFunction:InvokeServer(\"hit\",{v.Humanoid,10000000000000000000000})\n            end\n        end\n        cd = 0\n    end\n    cd += delta\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":2