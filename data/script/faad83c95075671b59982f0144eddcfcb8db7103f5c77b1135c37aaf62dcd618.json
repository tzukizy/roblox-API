ion()\n    while task.wait(0.1) do\n        pcall(function()\n            StarterGui:SetCore(\"JumpButtonEnabled\", true)\n            StarterGui:SetCore(\"JumpButtonVisible\", true)\n        end)\n    end\nend)\n\nlocal function setupChar(char)\n    local hum = char:WaitForChild(\"Humanoid\")\n\n    RunService.RenderStepped:Connect(function()\n        if hum then\n            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)\n            hum.AutoJumpEnabled = false\n        end\n    end)\nend\n\nif lp.Character then\n    setupChar(lp.Character)\nend\nlp.CharacterAdded:Connect(setupChar)","features":"no jump cooldown, thats it","tags":["Outcome memories"],"discord":"","keyLink":"","owner":{"_id":"67eaccbe3fe756ef637cbb32","username":"zZub","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67eaccbe3fe756ef637cbb32","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:00:24.538Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68adb2796aa51a06ce05a8d0","editBy":{"_id":"67eaccbe3fe756ef637cbb32","username":"zZub","status":"offline","id":"67eaccbe3fe756ef637cbb32"},"message":"Create script","createdAt":"2025-08-26T13:11:21.587Z"}],"comments":[{"_id":"68aee6a56aa51a06ce257d5a","commentBy":{"_id":"68aee645d1f45cb114350922","username":"makarohkin6","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-08-27T11:04:37.096Z","lastActive":"2025-09-20T19:27:06.126Z","status":"offline","id":"68aee645d1f45cb114350922","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"I'm a ju