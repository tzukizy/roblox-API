{"slug":"Outcome-Memories-v0.1-no-jump-cd-50348","_id":"68adb2796aa51a06ce05a8ce","title":"no jump cd","game":{"_id":"688659520c85a3749fe1ba9d","gameId":14608970270,"name":"(ANNIVERSARY) Outcome Memories v0.2","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14608970270},"features":"no jump cooldown, thats it","tags":["Outcome memories"],"script":"local Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal lp = Players.LocalPlayer\n\ntask.spawn(function()\n    while task.wait(0.1) do\n        pcall(function()\n            StarterGui:SetCore(\"JumpButtonEnabled\", true)\n            StarterGui:SetCore(\"JumpButtonVisible\", true)\n        end)\n    end\nend)\n\nlocal function setupChar(char)\n    local hum = char:WaitForChild(\"Humanoid\")\n\n    RunService.RenderStepped:Connect(function()\n        if hum then\n            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)\n            hum.AutoJumpEnabled = false\n        end\n    end)\nend\n\nif lp.Character then\n    setupChar(lp.Character)\nend\nlp.CharacterAdded:Connect(setupChar)","owner":{"_id":"67eaccbe3fe756ef637cbb32","username":"zZub","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"67eaccbe3fe756ef637cbb32","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":9616,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/5b1761bcdeb3c602dfc6f0813f03f5a6b9e4c191f06a9a2de02c18e21c934641.webp","original":"https://scriptblox.com/images/sb/rbx-9a0a25a37c96bd3d7cf8fc72f850f1