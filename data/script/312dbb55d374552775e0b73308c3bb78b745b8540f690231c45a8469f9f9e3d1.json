{"slug":"Universal-Script-Simple-Legit-Wall-Hop-Script-37261","_id":"680a43ee219af807bf0ed45f","title":"Simple Legit Wall Hop Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1745503214548.jpg","placeId":0},"features":"Makes you wall hop on any wall (also works on air) ENUM KEYBIND H","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\tif input.KeyCode == Enum.KeyCode.H then --change if needed\n\t\t\n\t\thrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(50), 0)\n\t\t\n\t\thumanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n\t\t\n\t\ttask.wait(0.1)\n\n\t\thrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-50), 0)\n\tend\nend)\n","owner":{"_id":"673342b80a7f2396e663623f","username":"HilosHAX","verified":false,"profilePicture":"/images/photo/673342b80a7f2396e663623f-1780680805400.png","status":"offline","id":"673342b80a7f2396e663623f","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":36433,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1745503214548.jpg","likeCount":1,"dislikeCount":1,"createdAt":"2025-04-24T14:00:14.593Z","editBy":{"_id":"673342b80a7f2396e663623f","username":"HilosHAX","status":"offline","id":"673342b80a7f2396e663623f"},"executes":593,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"680a43ee219af807bf0ed461","editBy":{"_id":"673342b80a7f2396e663623f","username":"HilosHAX","status":"offline","id":"673342b80a7f2396e663623f"},"message":"Create script","crea