{"slug":"Universal-Script-Simple-Legit-Wall-Hop-Script-37261","_id":"680a43ee219af807bf0ed45f","title":"Simple Legit Wall Hop Script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Makes you wall hop on any wall (also works on air) ENUM KEYBIND H","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\tif input.KeyCode == Enum.KeyCode.H then --change if needed\n\t\t\n\t\thrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(50), 0)\n\t\t\n\t\thumanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n\t\t\n\t\ttask.wait(0.1)\n\n\t\thrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-50), 0)\n\tend\nend)\n","owner":{"_id":"673342b80a7f2396e663623f","username":"HilosHAX","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0eb64174a9b3f1c34f95e6088fc339fb3a14e187b2223cc2813c9bc1d9adcee5.webp","original":"https://scriptblox.com/images/photo/673342b80a7f2396e663623f-1780680805400.png"},"status":"offline","id":"673342b80a7f2396e663623f","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/0eb64174a9b3f1c34f95e6088fc339fb3a14e187b2223cc2813c9bc1d9adcee5.webp","original":"https://scriptblox.com/images/photo/673342b80a7f2396e663623f-1780680805400.png"}},"verified":false,"views":36481,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/d84691