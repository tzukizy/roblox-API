ur = TempColour\nelse\nColour = Color3.fromRGB(255,255,255)\ntable.insert(Args, TempColour)\nend\nlocal CandidParts = {}\nfor _, Element in next, ClientLog:GetChildren() do\nlocal Name = Element.Name\nif Name:match(\"%d+\") then\ntable.insert(CandidParts, tonumber(Element.Name))\nend\nend\n   local Expecting = GetHighest(CandidParts)\n   Expecting = Expecting and (Expecting + 1) or (2)\n   print(unpack(Args))\nlocal ExpectedPart = ClientLog:WaitForChild(Expecting)\n   local MessagePart = ExpectedPart:FindFirstChild(\"msg\")\n   if MessagePart then\n       MessagePart.TextColor3 = Colour\n   end\nend\n\n-- Script Made by Unordinary\nfor i,v in pairs(game:GetService(\"ReplicatedStorage\").PlayerInfo:GetDescendants()) do\n    if v.Name == \"1\" or v.Name == \"2\" or v.Name == \"3\" then\n        CPrint(v.Value, Color3.fromRGB(0,255,109))\n        wait()\n    end\nend","features":"You need to open console to see it\n\nCredits to this guy: https://v3rmillion.net/showthread.php?tid=1161936#likepid8195425","tags":[],"discord":"","keyLink":"","owner":{"_id":"62250be2a476a5e7b34f7377","username":"Singularity","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a4877c894c4b1384a624ac56c98ce63e15637e0a01e80903cfe93f7a1c1ec333.webp","original":"https://scriptblox.com/images/photo/62250be2a476a5e7b34f7377-1691188283071.png"},"status":"offline","id":"62250be2a476a5e7b34f7377","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/a4877c894c4b1384a624ac56c98ce63e15637e0a01e80903cfe93f7a1c1ec333.webp","original":"https://scriptblox.com/images/photo/62250be2a476a5e7b34f7377-1691188283071.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:16:59.543Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e6e9","editBy":{"_id":"622