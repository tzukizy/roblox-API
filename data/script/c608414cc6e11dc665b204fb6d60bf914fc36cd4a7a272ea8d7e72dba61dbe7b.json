General\n        if chatChannel then\n            chatChannel:SendAsync(message)\n        else\n            warn(\"Default chat channel (RBXGeneral) not found!\")\n        end\n    else\n        warn(\"TextChatService is not available!\")\n    end\nend\n\n-- Example: Send a chat message\nsendChatMessage(\"-gh 63690008 62234425 301818806 376527115 48474313 62724852 2309346267 451220849 48474294\")\nsendChatMessage(\"credits to: roiprizer, Mokiros and XKxngSupremeX\")\n\nwait(3)\n\nsendChatMessage(\"-net\")\n\nloadstring(game:HttpGet('https://pastebin.com/raw/P0q5PQRp'))()\n\n--[[controls\nX - a laser?\nF - a spawn a ritual\nT - taunt \nR - start run \nY - for stop running]]\n\n","features":"works for green basplate\n\n\nP.S. im sorry for not crediting the authors before","tags":["keyless","FE"],"discord":"","keyLink":"","owner":{"_id":"67855408b8d42dcf8d7ba94b","username":"E_d_i_t_o_r_","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67855408b8d42dcf8d7ba94b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:05:32.766Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d9e6","editBy":{"_id":"67855408b8d42dcf8d7ba94b","username":"E_d_i_t_o_r_","status":"offline","id":"67855408b8d42dcf8d7ba94b"},"message":"Create script","createdAt":"2025-02-17T16:28:18.685Z"},{"_id":"67e5e1e7b360710ec3c54e44","editBy":{"_id":"67855408b8d42dcf8d7ba94b","username":"E_d_i_t_o_r_","status":"offline","id":"67855408b8d42dcf8d7ba94b"},"message":"Update script","createdAt":"2025-03-27T23:07:43.967Z"}],"comments":[{"_id":"697bd96c1a5b23101312d027","commentBy":{"_id":"6979163f0d28d6d14f05