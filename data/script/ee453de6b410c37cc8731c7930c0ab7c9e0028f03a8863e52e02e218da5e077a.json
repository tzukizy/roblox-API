7), Enum.KeyCode.LeftShift) \n\nlocal Test = Window:CreateTab(\"main\")\nlocal Test2 = Test:CreateSector(\"Section\",\"left\")\n\n\n\n\n\nTest2:AddToggle(\"auto collect\",false,function(state)\ngetgenv().collect = state\ncoroutine.wrap(function()\n    while wait() do\n        if getgenv().collect == true then\n            pcall(function()\n                for _,v in pairs(game:GetService(\"Workspace\").Money:GetDescendants()) do\nif v:IsA(\"TouchTransmitter\") then\nfiretouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v.Parent, 0) --0 is touch\nwait()\nfiretouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v.Parent, 1) -- 1 is untouch\nend\nend\n            end)\n        end\n        end\n        end)()\n        \nend)\n\nTest2:AddToggle(\"auto click duck\",false,function(state)\ngetgenv().click = state\nwhile getgenv().click do\nwait()\nfarm()\n        \nend\nend)","features":"eas","tags":[],"discord":"","keyLink":"","owner":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"650555c42df0a158d6d95c24","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:30:31.854Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bcbe","editBy":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","status":"offline","id":"650555c42df0a158d6d95c24"},"message":"Create script","createdAt":"2023-09-22T03:47:32.033Z"},{"_id":"67e5e1e4b360710ec3c4fa5a","editBy":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","status":"offline","id":"650555c42df0a158d6d95c24"},"message":"Update script