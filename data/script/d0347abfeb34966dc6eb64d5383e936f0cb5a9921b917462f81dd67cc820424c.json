kspace\"))\n\nfor _, Child in pairs(workspace:GetChildren()) do\n    if Child:IsA(\"BasePart\") then\n        local TI = Child:FindFirstChildOfClass(\"TouchTransmitter\")\n        if TI then\n            firetouchinterest(Hrp, Child, 0) \n            task.wait(0.05)\n            firetouchinterest(Hrp, Child, 1) \n        end\n    end\nend\n","features":"Finds all the touch interest parents and goes inside and fires them bihs","tags":[],"discord":"","keyLink":"","owner":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","verified":false,"profilePicture":{"url":"https://media.kocakz.me/44e63c7ae30cf5ca3528cd1f80a7d748897e993ab91eb3c8d74ebd8b9fdd375d.webp","original":"https://scriptblox.com/images/photo/68a0282b9b3b9b33fdf65bd7-1755326601503.png"},"status":"offline","id":"68a0282b9b3b9b33fdf65bd7","profile":{"url":"https://media.kocakz.me/44e63c7ae30cf5ca3528cd1f80a7d748897e993ab91eb3c8d74ebd8b9fdd375d.webp","original":"https://scriptblox.com/images/photo/68a0282b9b3b9b33fdf65bd7-1755326601503.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:54:35.412Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e57a4ccc090563b0a2087e","editBy":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","status":"offline","id":"68a0282b9b3b9b33fdf65bd7"},"message":"Create script","createdAt":"2025-10-07T20:38:36.981Z"},{"_id":"68e6a2f23c0368ee6290aec8","editBy":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","status":"offline","id":"68a0282b9b3b9b33fdf65bd7"},"message":"Update script","createdAt":"2025-10-08T17:44:18.048Z"}],"comments":[{"_id":"68e57cee39260d0283c1df05","commentBy":{"_id":"67aa6a035180152e172ad126","username":"L0stVeil","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/d1983b1b25323e97cb0d1221ecb275c4157442cb