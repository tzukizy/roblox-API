{"slug":"Universal-Script-Fire-all-touch-interests-57081","_id":"68e57a4ccc090563b0a2087c","title":"Fire all touch interests","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1759869516965.jpg","placeId":0},"features":"Finds all the touch interest parents and goes inside and fires them bihs","tags":[],"script":"local cloneref = cloneref or function(v) return v end\nlocal Players = cloneref(game:FindService(\"Players\") or game:GetService(\"Players\"))\nlocal Plr = cloneref(Players.LocalPlayer)\nlocal Char = cloneref(Plr.Character) or Plr.CharacterAdded:Wait()\nlocal Hum = cloneref(Char:FindFirstChild(\"Humanoid\")) or Char:WaitForChild(\"Humanoid\")\nlocal Hrp = cloneref(Char:FindFirstChild(\"HumanoidRootPart\")) or Char:WaitForChild(\"HumanoidRootPart\")\nlocal workspace = cloneref(game:FindService(\"Workspace\") or game:GetService(\"Workspace\"))\n\nfor _, Child in pairs(workspace:GetChildren()) do\n    if Child:IsA(\"BasePart\") then\n        local TI = Child:FindFirstChildOfClass(\"TouchTransmitter\")\n        if TI then\n            firetouchinterest(Hrp, Child, 0) \n            task.wait(0.05)\n            firetouchinterest(Hrp, Child, 1) \n        end\n    end\nend\n","owner":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","verified":false,"profilePicture":"/images/photo/68a0282b9b3b9b33fdf65bd7-1755326601503.png","status":"offline","id":"68a0282b9b3b9b33fdf65bd7"},"verified":false,"views":113011,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1759869516965.jpg","likeCount":1,"dislikeCount":2,"createdAt":"2025-10-07T20:38:36.977Z","editBy":{"_id":"68a0282b9b3b9b33fdf65bd7","username":"WaylonTheEvident","status":"offline","id":"68a0282b9b3b9b33fdf65bd7"},"executes":308,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e57a4ccc090563b0a2087e","editBy":{"_id":"68a0282b9b3b9b33fdf65bd7",