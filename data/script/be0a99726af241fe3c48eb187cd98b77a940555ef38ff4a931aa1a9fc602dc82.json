{"slug":"Universal-Script-Flashlight-script-3970","_id":"62c8ef3f5407a361d671e6c9","title":"Flashlight script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/6646856-1657335615747.jpg","placeId":0},"features":"F to turn on the flashlight","tags":[],"script":"local mouse = game.Players.LocalPlayer:GetMouse()\nfunction Light()\n    player = game.Players.LocalPlayer\n    playerChar = player.Character\n    playerLight = playerChar.Torso:FindFirstChild(\"Light\")\n    if playerLight then\n        playerLight:Destroy()\n    else\n        light = Instance.new(\"SurfaceLight\",playerChar:FindFirstChild(\"Torso\"))\n        light.Name = \"Light\"\n        light.Range = 11 -- Change to distance ofthe Light.\n        light.Brightness = 11 -- Change to how much.\n        light.Shadows = false -- Change it to True/False.\n\n        \n        local play = Instance.new(\"Sound\",playerChar:FindFirstChild(\"Head\"))\n        play.SoundId = \"http://www.roblox.com/asset/?id=198914875\"\n        play:Play()\n        \n    end\nend\nmouse.KeyDown:connect(function(key)\nkey = key:lower()\nif key == \"f\" then\n    Light()\nend\nend)","owner":{"_id":"621a227e0b6f2cdab1034050","username":"justanormaldude","verified":false,"profilePicture":"/images/photo/621a227e0b6f2cdab1034050-1657304445142.jpg","status":"offline","id":"621a227e0b6f2cdab1034050","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":11630,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2022-07-09T03:00:15.778Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/6646856-1657335615747.jpg","executes":171,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e67a","editBy":{"_id":"621a227e0b6f2cdab1034050","username":"justanormaldude","status":"offline","id":"621a227e0b6f2cdab1034050"},"message":"Create script","createdAt":"2025-03-