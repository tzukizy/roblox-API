] Coin Delay\n[+] Crate AutoFarm\n[+] Crate Selection\n--[ Settings ]--\n[+] Copy Discord Server\n[+] Owner Copy Username\n[+] Version [v1.1]\n* This script is mine, I hope to add more features by tmr and release a v1.2","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/vwSaraa/Scripts/main/Murder%20Mystery%202%20v4.lua\"))()","owner":{"_id":"631ad6820526459cecc34ced","username":"sara_","verified":true,"profilePicture":"/images/photo/631ad6820526459cecc34ced-1662703343234.png","status":"offline","id":"631ad6820526459cecc34ced","topMilestone":{"key":"creator.views","tier":1000000}},"verified":true,"views":1364889,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-09-18T18:40:07.534Z","dislikeCount":3,"likeCount":13,"image":"https://t5.rbxcdn.com/b90d3c82e146a650eb0e52a8873d4993","executes":321,"keyless":false,"milestones":[{"key":"script.views","tier":1000000,"value":1364849,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e1cd","editBy":{"_id":"631ad6820526459cecc34ced","username":"sara_","status":"offline","id":"631ad6820526459cecc34ced"},"message":"Create script","createdAt":"2025-03-27T23:10:22.736Z"}],"comments":[{"_id":"632767265ff1d45038038a40","commentBy":{"_id":"632586f7d3c397dd348ff401","username":"context","verified":false,"role":"user","profilePicture":"/images/photo/632586f7d3c397dd348ff401-1663403888914.jpg","createdAt":"2022-09-17T08:36:07.166Z","lastActive":"2022-09-20T02:17:00.835Z","status":"offline","id":"632586f7d3c397dd348ff401"},"text":"great script 😈😈","createdAt":"2022-09-18T18:44:54.156Z","edited":true,"dislikeCount":0,"likeCount":3,"liked":false,"disliked":false},{"_id":"632768305ff1d450380390e3","commentBy":{"_id":"62dfaeb6a190000aea41b604","username":"cropw","verified":true,"role":"user","profilePicture":"/images/photo/62dfaeb6a190000aea41b604-1693503828858.png","createdAt":"