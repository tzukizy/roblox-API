ox\")\nb.Parent = a\nb.Size = UDim2.new(0.25,0,0.25,0)\nb.Position = UDim2.new(0.67,0,0.15,0)\nlocal c = Instance.new(\"TextButton\")\nc.Text = \"send\"\nc.Parent = b\nc.Size = UDim2.new(0.1,0,0.25,0)\nc.Position = UDim2.new(0,0,-0.25,0)\na.ResetOnSpawn = false\nb.ClearTextOnFocus = false\nb.MultiLine = true\nb.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\nb.PlaceholderText = \"To chat click here or press - key\"\nb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)\nb.TextEditable = true\nb.TextWrapped = true\n\n\n\n\n\n\n\n\nif game:GetService(\"ReplicatedStorage\").Remotes.chat then\n    if game:GetService(\"Players\").Th3Hqck3rsBoy or game:GetService(\"Players\").n1c3_kidd then\n        b.Text = \"yo the script owner is here which is \"..game:GetService(\"Players\").Th3Hqck3rsBoy.DisplayName or game:GetService(\"Players\").n1c3_kidd.DisplayName\n    else\n        b.Text = \"\"\n    end\n    local button = game:GetService(\"Players\").LocalPlayer.PlayerGui.BUBBLECHAT.TextBox.TextButton\n    local textbox = button.Parent\n        button.Activated:Connect(function()\n        game:GetService(\"ReplicatedStorage\").Remotes.chat:FireServer(textbox.Text)\n    end)\nelse\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.TextEditable = false\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    task.wait(1)\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\n    b.Text = \"the remoteevent needed cant be found, either this script got patched or youre in the wrong game\"\nend","features":"lets you chat with bubblechat\npeople cant report you because its bubblechat\neveryone can see ur bubble chat","tags":["bubblechat"],"discord":"","keyLink":"","owner":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8798e784fe2be2f4c75995fb53379e6d00badb4bff0db94d36a963fc3388976a.webp","original":"https://scriptblox.com/images/photo/685d45da2206934a9cdfd06c-1756559314331.png"},"status":"offline","id":"685d45da2206934a9cdfd06c","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/8798e784fe2be2f4c75995fb53379e6d00badb4bff0db94d36a963fc3388976a.webp","original":"https://scriptblox.com/images/photo/685d45da2206934a9cdfd06c-175655931433