{"slug":"Aybars36733's-Place-God-mode-open-source-credits-to-original-creators-192685","_id":"69d3525ee52e8dc73f44a061","title":"God mode open source credits to original creators","game":{"_id":"69d3525ee52e8dc73f44a05c","gameId":13292415174,"name":"Aybars36733's Place","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13292415174},"features":"God mode \nYou don't die to anything \nHunger \nIncluded \nBut don't be dumb because \nVolcano can still kill you\nThis is 4 99 nights \nI hope you like it","tags":[],"script":"-- ==========================================\n-- project god mode 99 nights in the forest ðŸ«‚\n-- ==========================================\n\ngetgenv().godmode = true\nlocal rs = game:GetService(\"ReplicatedStorage\")\n\nlocal function god()\n      local events = rs:FindFirstChild(\"RemoteEvents\")\n      if not events then\n            return\n      end\n\n      local dmg = events:FindFirstChild(\"DamagePlayer\")\n      if not dmg then\n            return\n      end\n\n      local ok = pcall(function()\n            dmg:FireServer(-)\n      end)\n\n      if not ok then\n            warn(\"Godmode failed to fire\")\n      end\nend\n\ntask.spawn(function()\n      while task.wait(0) do\n            if getgenv().godmode then\n                  god()\n            end\n      end\nend)","owner":{"_id":"69c76d2aea145b0e94937d6e","username":"Galaxy7657y3","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"lvl":5,"status":"offline","id":"69c76d2aea145b0e94937d6e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":1375,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/0fef73de87f9801ddc32b3c88bbceb9e28b2935