{"slug":"Aybars36733's-Place-God-mode-open-source-credits-to-original-creators-192685","_id":"69d3525ee52e8dc73f44a061","title":"God mode open source credits to original creators","game":{"_id":"69d3525ee52e8dc73f44a05c","gameId":13292415174,"name":"Aybars36733's Place","imageUrl":"https://tr.rbxcdn.com/180DAY-dde6e11e92c0fe4e2179eb39843d0ec4/480/270/GameIcon7/Png/noFilter","placeId":13292415174},"features":"God mode \nYou don't die to anything \nHunger \nIncluded \nBut don't be dumb because \nVolcano can still kill you\nThis is 4 99 nights \nI hope you like it","tags":[],"script":"-- ==========================================\n-- project god mode 99 nights in the forest ðŸ«‚\n-- ==========================================\n\ngetgenv().godmode = true\nlocal rs = game:GetService(\"ReplicatedStorage\")\n\nlocal function god()\n      local events = rs:FindFirstChild(\"RemoteEvents\")\n      if not events then\n            return\n      end\n\n      local dmg = events:FindFirstChild(\"DamagePlayer\")\n      if not dmg then\n            return\n      end\n\n      local ok = pcall(function()\n            dmg:FireServer(-)\n      end)\n\n      if not ok then\n            warn(\"Godmode failed to fire\")\n      end\nend\n\ntask.spawn(function()\n      while task.wait(0) do\n            if getgenv().godmode then\n                  god()\n            end\n      end\nend)","owner":{"_id":"69c76d2aea145b0e94937d6e","username":"Galaxy7657y3","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69c76d2aea145b0e94937d6e","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1368,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/13292415174-1775456862248.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2026-04-06T06:27:42.263Z","keyLink":"","executes":59,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d3525ee52e8dc73f4