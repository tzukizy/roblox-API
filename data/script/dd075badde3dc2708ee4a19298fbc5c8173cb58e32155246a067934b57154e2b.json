\")\n      if not events then\n            return\n      end\n\n      local dmg = events:FindFirstChild(\"DamagePlayer\")\n      if not dmg then\n            return\n      end\n\n      local ok = pcall(function()\n            dmg:FireServer(-)\n      end)\n\n      if not ok then\n            warn(\"Godmode failed to fire\")\n      end\nend\n\ntask.spawn(function()\n      while task.wait(0) do\n            if getgenv().godmode then\n                  god()\n            end\n      end\nend)","features":"God mode \nYou don't die to anything \nHunger \nIncluded \nBut don't be dumb because \nVolcano can still kill you\nThis is 4 99 nights \nI hope you like it","tags":[],"discord":"","keyLink":"","owner":{"_id":"69c76d2aea145b0e94937d6e","username":"Galaxy7657y3","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":5,"status":"offline","id":"69c76d2aea145b0e94937d6e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:32:39.545Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d3525ee52e8dc73f44a064","editBy":{"_id":"69c76d2aea145b0e94937d6e","username":"Galaxy7657y3","status":"offline","id":"69c76d2aea145b0e94937d6e"},"message":"Create script","createdAt":"2026-04-06T06:27:42.267Z"}],"comments":[{"_id":"6a56e7c0dd1db69a28681378","commentBy":{"_id":"69e396c328f7f0fb81d2842d","username":"Tester666","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/78747b31e394e5273435818e391ebeb93a8782a6c4bed5a4769e91eadb55f749.webp","original":"https://scriptblox.com/images/photo/69e396c328f7f0fb81d2842d-1776522993760.jpg"},"lastActive":"2026-09-02T03:40:40.021Z","createdAt":"2026-04-18T14:35:4