{"_id":"6505d0662df0a158d6e1f51f","title":"Noclip","game":{"_id":"67e5e1ffb360710ec3c78cb3","gameId":13604847321,"name":"Geometry Blox (1 Million Visits)","imageUrl":{"url":"https://media.kocakz.me/4dce159ab34f8f081361a4e1fab96515358a88729c79a2a991de22c8c6a29c48.webp","original":"https://tr.rbxcdn.com/180DAY-72cff594f74235b1723da3bf4ebd3f78/150/150/Image/Png/noFilter"},"slug":"13604847321-geometry-blox","path":"/game/13604847321-geometry-blox","thumbnail":{"url":"https://media.kocakz.me/4dce159ab34f8f081361a4e1fab96515358a88729c79a2a991de22c8c6a29c48.webp","original":"https://tr.rbxcdn.com/180DAY-72cff594f74235b1723da3bf4ebd3f78/150/150/Image/Png/noFilter"},"placeId":13604847321},"slug":"Geometry-Blox-(1-Million-Visits)-Noclip-7864","verified":false,"key":false,"keyless":false,"views":13960,"executes":20,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d16d6a39cc3b66a95619b184e1ac7d1be0e6c6ccc314a56b05ab74b95adf52ab.webp","original":"https://scriptblox.com/images/sb/13604847321-1694879846854.webp","scriptblox":"https://scriptblox.com/images/script/13604847321-1694879846854.webp"},"thumbnail":{"url":"https://media.kocakz.me/d16d6a39cc3b66a95619b184e1ac7d1be0e6c6ccc314a56b05ab74b95adf52ab.webp","original":"https://scriptblox.com/images/sb/13604847321-1694879846854.webp","scriptblox":"https://scriptblox.com/images/script/13604847321-1694879846854.webp"},"likeCount":1,"dislikeCount":0,"createdAt":"2023-09-16T15:57:26.975Z","updatedAt":"2023-09-16T15:57:26.975Z","lastBump":"2023-09-16T15:57:26.975Z","script":"--// Variables \\\\--\n\nlocal loadedLevels = game:GetService(\"Workspace\"):WaitForChild(\"LoadedLevels\")\nlocal deadlyParts = game:GetService(\"Players\").LocalPlayer:WaitForChild(\"PlayerGui\"):WaitForChild(\"LoadLevel\"):WaitForChild(\"EditorParts\"):WaitForChild(\"Deadly\")\n\n--// Hooking Death Function \\\\--\n\nfor k, v in next, getgc() do\n    if type(v) == \"function\" and getinfo(v).name == \"Kill\" then\n        hookfunction(v, function(...) return end)\n        break;\n    end\nend\n\n--// Disabling Spike Colliders \\\\--\n\nlocal function noclipObject(v)\n    if v.Name == \"Collider\" and deadlyParts:FindFirstChild(v.Parent.Name) then\n        v.CanCollide = false\n    end\nend\n\nloadedLevels.DescendantAdded:Connect(noclipObject)\n\nfor _, v in next, loadedLevels:GetDescendants() do\n    noclipObject(v)\nend\n\n-- Script by DylanIsAKing#2402 ;)","features":"Basically Godmode\n\nOpen Source because why not","tags":[],"discord":"","keyLink":"","owner":{"_id":"64f4dfdc6786279fe51994f1","username":"Spook","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5f61649a5b48b48fd35fe20e76d340f9c553acd4e684800f42f602f25aad3ef6.webp","original":"https://scriptblox.com/images/photo/64f4dfdc6786279fe51994f1-1737390825895.png"},"status":"offline","id":"64f4dfdc6786279fe51994f1","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/5f61649a5b48b48fd35fe20e76d340f9c553acd4e684800f42f602f25aad3ef6.webp","original":"https://scriptblox.com/images/photo/64f4dfdc6786279fe51994f1-1737390825895.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:19:07.266Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f9fe","editBy":{"_id":"64f4dfdc6786279fe51994f1","username":"Spook","status":"offline","id":"64f4dfdc6786279fe51994f1"},"message":"Create script","createdAt":"2025-03-27T04:16:03.734Z"}],"comments":[]}