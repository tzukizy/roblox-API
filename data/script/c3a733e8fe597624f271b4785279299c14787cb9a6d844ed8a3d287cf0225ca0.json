l character = player.Character or player.CharacterAdded:Wait()\n\t\tinvisible = not invisible\n\t\tsetTransparency(character, invisible and 1 or 0)\n\tend\nend)\n\nplayer.CharacterAdded:Connect(function(character)\n\tif invisible then\n\t\tsetTransparency(character, 1)\n\tend\nend)\n\n","features":"Press the 'G' key to turn on/off","tags":[],"discord":"","keyLink":"","owner":{"_id":"68780558fa70fb03dd4c4735","username":"Virage","verified":false,"profilePicture":{"url":"https://media.kocakz.me/52ba5c2cd1e0de4b0061e50f0c45396d52b475dd054a31de3ba438d991b03e4b.webp","original":"https://scriptblox.com/images/photo/68780558fa70fb03dd4c4735-1753386413779.png"},"status":"offline","id":"68780558fa70fb03dd4c4735","profile":{"url":"https://media.kocakz.me/52ba5c2cd1e0de4b0061e50f0c45396d52b475dd054a31de3ba438d991b03e4b.webp","original":"https://scriptblox.com/images/photo/68780558fa70fb03dd4c4735-1753386413779.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:45:10.064Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68847ef8f7b21c53053f4cca","editBy":{"_id":"68780558fa70fb03dd4c4735","username":"Virage","status":"offline","id":"68780558fa70fb03dd4c4735"},"message":"Create script","createdAt":"2025-07-26T07:08:40.519Z"}],"comments":[{"_id":"68847f063da5eb0faf42c8a7","commentBy":{"_id":"68780558fa70fb03dd4c4735","username":"Virage","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/52ba5c2cd1e0de4b0061e50f0c45396d52b475dd054a31de3ba438d991b03e4b.webp","original":"https://scriptblox.com/images/photo/68780558fa70fb03dd4c4735-1753386413779.png"},"createdAt":"2025-07-16T20:02:32.091Z","lastActive":"2025-09-02T11:19:25.940Z","status":"offline","id":"68780558fa70fb03dd4c4735","profile":{"url":"https://media.kocakz.me/52ba5c2cd1e0de4b0061e50f0c45396d52b475dd054a31d