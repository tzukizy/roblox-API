alPlayer:DistanceFromCharacter(location)< 50 or getfenv().auto == false\n car.PrimaryPart.Velocity = Vector3.new(0,0,0)\n end\n end)","features":"AutoFarm\n\nAntiAfk","tags":["AutoFarm"],"discord":"","keyLink":"","owner":{"_id":"66527b5cee42b162f5d6d8b3","username":"DarrenWatkinsJr","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b7902b943ac57a2977a417b9c1de86b048fcb970139efcbd902c9dd4c29f3cdf.webp","original":"https://scriptblox.com/images/photo/66527b5cee42b162f5d6d8b3-1721450665642.jpg"},"status":"offline","id":"66527b5cee42b162f5d6d8b3","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/b7902b943ac57a2977a417b9c1de86b048fcb970139efcbd902c9dd4c29f3cdf.webp","original":"https://scriptblox.com/images/photo/66527b5cee42b162f5d6d8b3-1721450665642.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:59:12.430Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50f81","editBy":{"_id":"66527b5cee42b162f5d6d8b3","username":"DarrenWatkinsJr","status":"offline","id":"66527b5cee42b162f5d6d8b3"},"message":"Create script","createdAt":"2025-03-27T23:01:07.049Z"}],"comments":[{"_id":"67397348637d11656150041c","commentBy":{"_id":"6722f297db0708a6cf00e043","username":"jamallincoln69","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-10-31T02:59:35.383Z","lastActive":"2025-01-30T04:41:08.089Z","status":"offline","id":"6722f297db0708a6cf00e043","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"very good script","createdAt":"2024-11-17T04:38:32.644Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"67951653e5580