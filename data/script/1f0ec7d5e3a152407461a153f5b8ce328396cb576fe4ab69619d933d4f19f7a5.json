)\nlocal noclip = false\n\nLocalPlayer.CharacterAdded:Connect(function(char)\n    Character = char\nend)\n\nlocal function onStepped()\n    if noclip and Character then\n        for _, part in pairs(Character:GetDescendants()) do\n            if part:IsA(\"BasePart\") then\n                part.CanCollide = false\n            end\n        end\n    end\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if not gameProcessed and input.KeyCode == Enum.KeyCode.U then\n        noclip = not noclip\n        if noclip then\n            print(\"Noclip ON – free noclip source code because I was too lazy to add it onto the GUI (I forgot)\")\n        else\n            print(\"Noclip OFF\")\n        end\n    end\nend)\n\nRunService.Stepped:Connect(onStepped)","features":"introducing a week of hard work, blood, sweat, and tears, over 1150 lines of code, we introduce our newest dead rails script - SoleHub\n\n join our discord pls - https://discord.gg/KM5gjVqW (for keyless scripts)\ntp to end\ntp to vampire caslte\ntp to fort (tp to fort is a bit slower)\ntp to tesla lab\naimlock\ncam lock aimbot\nesp\nno spread for guns\ninstant reload\nfps boost\nfull bright\nbecome faster \nautopickup moneybag, bonds,ammo, and guns\ntp to train\nno cooldown proximity\nnoclip","tags":["deadrails","keyless"],"discord":"","keyLink":"","owner":{"_id":"672d6c43581b531274708bdf","username":"egoo","verified":false,"profilePicture":{"url":"https://media.kocakz.me/7da9ba3fdd346d4c1c8f55758f8fa7ea832fc5fa66d4a7e97ded0bbce541eea7.webp","original":"https://scriptblox.com/images/photo/672d6c43581b531274708bdf-1752529683191.png"},"status":"offline","id":"672d6c43581b531274708bdf","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/7da9ba3fdd346d4c1c8f55758f8fa7ea832fc5fa66d4a7e97ded0bbce541eea7.webp","original":"https://scriptblox.com/images/photo/672d6c43581b531274708bdf-1752529683191.png"}},"reviewed":null,"liked":false,"disliked":false,"cs