{"slug":"Universal-Script-friend-request-sender-105750","_id":"698777e112004551b6c6dc68","title":"friend request sender","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1770485729551.png","placeId":0},"features":"so basicly it sends friend requests to anyone in your server, and auto accepts incoming friend requests","tags":["roblox","friend requests","roblox friend requests","connection","friend sender"],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function sendFriendRequest(player)\n    if player ~= LocalPlayer then\n        pcall(function()\n            LocalPlayer:RequestFriendship(player)\n        end)\n    end\nend\n\nlocal function autoAcceptFriendRequests()\n    while true do\n        wait(5)\n        local success, friendRequests = pcall(function()\n            return LocalPlayer:GetFriendRequestsAsync()\n        end)\n        if success and friendRequests then\n            for _, request in pairs(friendRequests) do\n                pcall(function()\n                    LocalPlayer:RequestFriendship(request)\n                end)\n                wait(1)\n            end\n        end\n    end\nend\n\nfor _, player in pairs(Players:GetPlayers()) do\n    sendFriendRequest(player)\n    wait(2)\nend\n\nspawn(autoAcceptFriendRequests)\n\nPlayers.PlayerAdded:Connect(function(player)\n    wait(2)\n    sendFriendRequest(player)\nend)","owner":{"_id":"69074ecd8f33fa751510e9b4","username":"67_gods","verified":false,"profilePicture":"/images/photo/69074ecd8f33fa751510e9b4-1762086655747.png","status":"offline","id":"69074ecd8f33fa751510e9b4","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1277,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1770485729551.png","likeCount":3,"dislikeCount":0,"createdAt":"2026-02-07T17:35:29.562Z","editBy":{"_id":"69074ecd8f33fa751510e9b4",