{"_id":"6906202bf5b28ce284401040","title":"Create Part On Click","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/d9c97b2b3f38bef66f0c83b4253356fad267fcae9efe49e9e39b8e54815f3cc2.webp","original":"https://scriptblox.com/images/sb/0-1762009131307.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/d9c97b2b3f38bef66f0c83b4253356fad267fcae9efe49e9e39b8e54815f3cc2.webp","original":"https://scriptblox.com/images/sb/0-1762009131307.png"},"placeId":0},"slug":"Universal-Script-Create-Part-On-Click-62182","verified":false,"key":false,"keyless":false,"views":3526,"executes":47,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ccb7eb91edc5414d53c0335b9d88dfa116afc7aa06b3372054c2302249fb8b21.webp","original":"https://scriptblox.com/images/sb/0-1762009131307.png","scriptblox":"https://scriptblox.com/images/script/0-1762009131307.png"},"thumbnail":{"url":"https://media.kocakz.me/ccb7eb91edc5414d53c0335b9d88dfa116afc7aa06b3372054c2302249fb8b21.webp","original":"https://scriptblox.com/images/sb/0-1762009131307.png","scriptblox":"https://scriptblox.com/images/script/0-1762009131307.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-01T14:58:51.331Z","updatedAt":"2025-11-01T14:58:51.331Z","lastBump":"2025-11-01T14:58:51.331Z","script":"-- LocalScript in StarterPlayerScripts (Mobile/PC Compatible)\n \nlocal Player = game.Players.LocalPlayer\nlocal Mouse = Player:GetMouse()\nlocal UIS = game:GetService(\"UserInputService\")\nlocal Workspace = game:GetService(\"Workspace\")\n \n-- Part constants\nlocal SIZE = Vector3.new(5, 0.5, 5) -- 0.5 studs flat\nlocal BLACK = Color3.new(0, 0, 0)\n \nlocal function onClick(input, GPE)\n    -- Check for left click OR touch input, and ensure no UI blocking (GPE)\n    local isPrimaryAction = (input.UserInputType == Enum.UserInputType.MouseButton1) or \n    (input.UserInputType == Enum.UserInputType.Touch and input.UserInputState == Enum.UserInputState.Begin)\n    \n    if isPrimaryAction and not GPE then\n        \n        -- Check if the mouse/touch is pointing at a physical object (not the sky)\n        local target = Mouse.Target\n        if target then\n            local p = Instance.new(\"Part\")\n            p.Size = SIZE\n            p.Color = BLACK\n            p.Anchored = true\n            \n            -- Place the part centered on the click spot, offset half its thickness up\n            local pos = Mouse.Hit.Position + Vector3.new(0, SIZE.Y / 2, 0)\n            p.CFrame = CFrame.new(pos)\n            \n            p.Parent = Workspace\n        end\n    end\nend\n \nUIS.InputBegan:Connect(onClick)\n","features":"Creates a black part when you click on something.","tags":[],"discord":"","keyLink":"","owner":{"_id":"68f39137b72f339c468f5007","username":"greenapple1812","verified":false,"profilePicture":{"url":"https://media.kocakz.me/1f9261beee9df9523985350b599470123e9b6b246cba312026038d26f6bffcd3.webp","original":"https://scriptblox.com/images/photo/68f39137b72f339c468f5007-1762344796017.png"},"status":"offline","id":"68f39137b72f339c468f5007","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/1f9261beee9df9523985350b599470123e9b6b246cba312026038d26f6bffcd3.webp","original":"https://scriptblox.com/images/photo/68f39137b72f339c468f5007-1762344796017.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:34:27.457Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6906202bf5b28ce284401042","editBy":{"_id":"68f39137b72f339c468f5007","username":"greenapple1812","status":"offline","id":"68f39137b72f339c468f5007"},"message":"Loaded (4/4)","createdAt":"2025-11-01T14:58:5