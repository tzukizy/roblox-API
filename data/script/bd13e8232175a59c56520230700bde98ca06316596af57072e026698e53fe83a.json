{"_id":"62c5920f5a3943b2e21f7b8b","title":"InfJump","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-InfJump-3893","verified":false,"key":false,"keyless":false,"views":7464,"executes":162,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/7228848-1657115151347.jpg","scriptblox":"https://scriptblox.com/images/script/7228848-1657115151347.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/7228848-1657115151347.jpg","scriptblox":"https://scriptblox.com/images/script/7228848-1657115151347.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2022-07-06T13:45:51.372Z","updatedAt":"2022-07-06T13:45:51.372Z","lastBump":"2022-07-06T13:45:51.372Z","script":"local Player = game:GetService'Players'.LocalPlayer;\nlocal UIS = game:GetService'UserInputService';\n\n_G.JumpHeight = 50;\n\nfunction Action(Object, Function) if Object ~= nil then Function(Object); end end\n\nUIS.InputBegan:connect(function(UserInput)\n    if UserInput.UserInputType == Enum.UserInputType.Keyboard and UserInput.KeyCode == Enum.KeyCode.Space then\n        Action(Player.Character.Humanoid, function(self)\n            if self:GetState() == Enum.HumanoidStateType.Jumping or self:GetState() == Enum.HumanoidStateType.Freefall then\n                Action(self.Parent.HumanoidRootPart, function(self)\n                    self.Velocity = Vector3.new(0, _G.JumpHeight, 0);\n                end)\n            end\n        end)\n    end\nend)","features":"Infinity Jump","tags":[],"discord":"","keyLink":"","owner":{"_id":"6252104977caab0665a045fd","username":"Kosma","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/6252104977caab0665a045fd-1659904080385.jpg"},"status":"offline","id":"6252104977caab0665a045fd","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/6252104977caab0665a045fd-1659904080385.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:33:12.442Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f200","editBy":{"_id":"6252104977caab0665a045fd","username":"Kosma","status":"offline","id":"6252104977caab0665a045fd"},"message":"Create script","createdAt":"2025-03-27T21:10:50.905Z"}],"comments":[]}