{"_id":"68b61cefa7a68826f54a3feb","title":"Snake Avatar","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"slug":"Universal-Script-Snake-Avatar-51248","verified":false,"key":false,"keyless":false,"views":16279,"executes":56,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2ad016de6fd17245876ce857cc9942c455b41df17fc012105ec12bf613d967d3.webp","original":"https://scriptblox.com/images/sb/0-1756765423226.png","scriptblox":"https://scriptblox.com/images/script/0-1756765423226.png"},"thumbnail":{"url":"https://media.kocakz.me/2ad016de6fd17245876ce857cc9942c455b41df17fc012105ec12bf613d967d3.webp","original":"https://scriptblox.com/images/sb/0-1756765423226.png","scriptblox":"https://scriptblox.com/images/script/0-1756765423226.png"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-09-01T22:23:43.250Z","updatedAt":"2025-09-01T22:23:43.250Z","lastBump":"2025-09-01T22:23:43.250Z","script":"-- Snake Morph Script (LocalScript for Roblox Studio use)\n-- Put this inside StarterPlayer > StarterPlayerScripts\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal runService = game:GetService(\"RunService\")\n\n-- Hide normal limbs\nfor _, part in ipairs(char:GetChildren()) do\n\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\tpart.Transparency = 1\n\tend\nend\n\n-- Make snake body parts\nlocal snakeParts = {}\nlocal length = 10 -- how many segments\nlocal segmentSize = 2\n\nfor i = 1, length do\n\tlocal seg = Instance.new(\"Part\")\n\tseg.Size = Vector3.new(2, 2, 2)\n\tseg.Shape = Enum.PartType.Ball\n\tseg.Material = Enum.Material.SmoothPlastic\n\tseg.Color = Color3.fromRGB(0, 255, 0) -- green snake\n\tseg.Anchored = false\n\tseg.CanCollide = false\n\tseg.Parent = workspace\n\ttable.insert(snakeParts, seg)\nend\n\n-- Follow effect\nlocal positions = {}\n\nrunService.RenderStepped:Connect(function()\n\tlocal hrp = char:FindFirstChild(\"HumanoidRootPart\")\n\tif not hrp then return end\n\t\n\t-- Record positions\n\ttable.insert(positions, 1, hrp.Position)\n\tif #positions > length * 5 then\n\t\ttable.remove(positions)\n\tend\n\t\n\t-- Move snake segments\n\tfor i, seg in ipairs(snakeParts) do\n\t\tlocal index = i * 5\n\t\tif positions[index] then\n\t\t\tseg.CFrame = CFrame.new(positions[index])\n\t\tend\n\tend\nend)\n","features":"This script makes you a snake in any roblox game (r6 and r15 compatible)\nAI MADE CLIENTSIDE","tags":[],"discord":"","keyLink":"","owner":{"_id":"6830ac14aef6b0af6370dc4f","username":"c00lscripter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3be4cd79b76f9b0df5f8e426005020a4509e7ede5f3e34fc91e2bb3f652f661a.webp","original":"https://scriptblox.com/images/photo/6830ac14aef6b0af6370dc4f-1751743320183.png"},"status":"offline","id":"6830ac14aef6b0af6370dc4f","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/3be4cd79b76f9b0df5f8e426005020a4509e7ede5f3e34fc91e2bb3f652f661a.webp","original":"https://scriptblox.com/images/photo/6830ac14aef6b0af6370dc4f-1751743320183.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:46:38.689Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b61cefa7a68826f54a3fed","editBy":{"_id":"6830ac14aef6b0af6370dc4f","username":"c00lscripter","status":"offline","id":"6830ac14aef6b0af6370dc4f"},"message":"Create script","createdAt":"2025-09-01T22:23:43.253Z"}],"comments":[{"_id":"68b61df10d9cd9148b677395",