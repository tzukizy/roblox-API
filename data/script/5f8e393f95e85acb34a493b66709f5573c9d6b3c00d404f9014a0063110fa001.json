{"slug":"Universal-Script-RemoteEventAndFunctionLogger-14340","_id":"6672407302625ee345483691","title":"RemoteEventAndFunctionLogger","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"I only made this because remote spy doesn't work on Solara executor\n\njoin my discord you bad bleep\nhttps://discord.gg/nWbqsUDcQx\nhttps://discord.gg/nWbqsUDcQx\n\nPrints remote events\nprints remote functions","tags":["Universal","Remote Spy"],"script":"local function printArguments(...)\n    local args = {...}\n    print(\"┌── Arguments ────────────────────────────\")\n    for i, arg in ipairs(args) do\n        print(string.format(\"│ Argument %d: %s\", i, tostring(arg)))\n    end\n    print(\"└──────────────────────────────────────────\")\nend\n\nlocal function printRemoteCall(remoteType, remoteName, printFunc)\n    printFunc(\"╔═════════════════════════════════════════╗\")\n    printFunc(string.format(\"║ %s fired: %s\", remoteType, remoteName))\n    printFunc(\"╚═════════════════════════════════════════╝\")\nend\n\nlocal function wrapRemote(remote)\n    if remote:IsA(\"RemoteEvent\") then\n        remote.OnClientEvent:Connect(function(...)\n            printRemoteCall(\"RemoteEvent\", remote.Name, warn)\n            printArguments(...)\n        end)\n    elseif remote:IsA(\"RemoteFunction\") then\n        remote.OnClientInvoke = function(...)\n            printRemoteCall(\"RemoteFunction\", remote.Name, error)\n            printArguments(...)\n        end\n    end\nend\n\nlocal function wrapRemotesInFolder(folder)\n    for _, obj in ipairs(folder:GetDescendants()) do\n        if obj:IsA(\"RemoteEvent\") or obj:IsA(\"RemoteFunction\") then\n            wrapRemote(obj)\n        end\n    end\n    folder.DescendantAdded:Connect(function(descendant)\n        if descendant:IsA(\"RemoteEvent\") or descendant:IsA(\"RemoteFunction\") then\n            wrapRemote(descendant)\n        end\n    end)\nend\n\nwrapRemotesInFolder(game.ReplicatedStorage)\nwrapRemotesInFolder(game.StarterGui)\nwrapRemotesInFolder(game.StarterPack)\nwrapRemotesInFolder(game.StarterPlayer)\n\ngame.ReplicatedStorage.DescendantAdded:Connect(function(descendant)\n    if descendant:IsA(\"RemoteEvent\") or descendant:IsA(\"RemoteFunction\") then\n        wrapRemote(descendant)\n    end\nend)\n\ngame.StarterGui.DescendantAdded:Connect(function(descendant)\n    if descendant:IsA(\"RemoteEvent\") or descendant:IsA(\"RemoteFunction\") then\n        wrapRemote(descendant)\n    end\nend)\n\ngame.StarterPack.DescendantAdded:Connect(function(descendant)\n    if descendant:IsA(\"RemoteEvent\") or descendant:IsA(\"RemoteFunction\") then\n        wrapRemote(descendant)\n    end\nend)\n\ngame.StarterPlayer.DescendantAdded:Connect(function(descendant)\n    if descendant:IsA(\"RemoteEvent\") or descendant:IsA(\"RemoteFunction\") then\n        wrapRemote(descendant)\n    end\nend)\n","owner":{"_id":"64caa76229c6e48e1e6517b2","username":"Aura","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/aa4daef6f4804a6fe8345abbeb3e121228200fe1535229158ec1e64d0f5b4ff8.webp","original":"https://scriptblox.com/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png"},"status":"offline","id":"64caa76229c6e48e1e6517b2","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/aa4daef6f4804a6fe8345abbeb3e121228200fe1535229158ec1e64d0f5b4ff8.webp","original":"https://scriptblox.com/images/photo/64caa76229c6e48e1e6517b2-1755132982289.png"}},"verified":false,"keyLink":"","views":23862,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-06-19T02:20:35.597Z","dislikeCount":3,"likeCount":3,"image":{"url":"https://cdn.kocakz.me/images/36b9e9549e1acdcbfc29d89602548f4839a568bae305bda18478a7366556efa9.webp",