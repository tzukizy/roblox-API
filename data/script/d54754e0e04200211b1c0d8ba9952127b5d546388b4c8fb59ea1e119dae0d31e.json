{"_id":"6734033c73e4c1810abd4477","title":"OPENSOURCE silent aim and wallbang","game":{"_id":"67e5e1ffb360710ec3c7834c","gameId":16261605398,"name":"Airsoft Battles","imageUrl":{"url":"https://media.kocakz.me/d671c9a4d32504d69815013b45386db7bbd5a44cbd4b682c5c47dcf9899a72a0.webp","original":"https://tr.rbxcdn.com/180DAY-704ac49e2129f50ca709751588cdd45b/150/150/Image/Png/noFilter"},"slug":"16261605398-airsoft-battles","path":"/game/16261605398-airsoft-battles","thumbnail":{"url":"https://media.kocakz.me/d671c9a4d32504d69815013b45386db7bbd5a44cbd4b682c5c47dcf9899a72a0.webp","original":"https://tr.rbxcdn.com/180DAY-704ac49e2129f50ca709751588cdd45b/150/150/Image/Png/noFilter"},"placeId":16261605398},"slug":"Airsoft-Battles-OPENSOURCE-silent-aim-and-wallbang-22195","verified":false,"key":false,"keyless":false,"views":22491,"executes":1020,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-c3ffc57678d9b2d1cf90f4630da2f735/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-c3ffc57678d9b2d1cf90f4630da2f735/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-c3ffc57678d9b2d1cf90f4630da2f735/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-c3ffc57678d9b2d1cf90f4630da2f735/500/280/Image/Jpeg/noFilter"},"likeCount":2,"dislikeCount":1,"createdAt":"2024-11-13T01:39:08.530Z","updatedAt":"2024-11-13T01:39:08.530Z","lastBump":"2024-11-13T01:39:08.530Z","script":"--// Made by samet.exe on discord\n--// Will not work for solara\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\");\nlocal Players = game:GetService(\"Players\");\nlocal RunService = game:GetService(\"RunService\");\nlocal Workspace = game:GetService(\"Workspace\");\nlocal UserInputService = game:GetService(\"UserInputService\");\n\nlocal LocalPlayer = Players.LocalPlayer;\nlocal Camera = Workspace.CurrentCamera;\n\nlocal Modules = {}; do\n    Modules.Shoot = require(ReplicatedStorage:FindFirstChild(\"Modules\"):FindFirstChild(\"Projectile\"):FindFirstChild(\"ShootModule\"));\nend;\nlocal Closest;\n\nlocal GetClosestPlayer = function(Radius)\n    local ClosestDistance = Radius or math.huge;\n    local Player = nil;\n\n    for Index, Value in Players:GetPlayers() do\n        if not (Value == LocalPlayer) then\n            local Character = Value.Character;\n            local HumanoidRootPart = Character and Character:FindFirstChild(\"HumanoidRootPart\");\n\n            if not HumanoidRootPart then continue; end;\n            if Value:GetAttribute(\"Team\") == LocalPlayer:GetAttribute(\"Team\") then continue; end; -- stupid team check but thats what the game uses \n\n            local Position, Visible = Camera:WorldToViewportPoint(HumanoidRootPart.Position);\n            local Distance = (Vector2.new(Position.X, Position.Y) - UserInputService:GetMouseLocation()).Magnitude;\n\n            if not Visible then continue end;\n\n            if Distance < ClosestDistance then\n                ClosestDistance = Distance;\n                Player = Value;\n            end;\n        end;\n    end;\n\n    return Player;\nend;\n\nRunService.Heartbeat:Connect(function()\n    Closest = GetClosestPlayer();\nend);\n\nlocal Old; Old = hookfunction(Modules.Shoot.fire, function(Arguement1, Origin, Direction, ...)\n    if (Closest) then\n        local BonePosition = Closest.Character.Head.Position;\n        Origin = BonePosition + Vector3.new(0, 0.05, 0); -- fake wallkbang\n        Direction = CFrame.new(Origin, BonePosition).LookVector.Unit * (BonePosition - Origin).Magnitude;\n    end;\n    \n    return Old(Arguement1, Origin, Direction, ...)\nend);","features":"silent aim + wallbang (somewhat)","tags":["silent aim","open source","opensrc","opensource","silentaim"],"discord":"","keyLink":"","owner":{"_id":"65e878118649bee11545f64d","username":"sametexe","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2185fb968caadafc79e132fef3c5c8109f1b021cd0acf8a836a1184c82c2585c.webp","original":"https://scriptblox.com/images/photo/65e878118649bee11545f64d-1729269485662.jpg"},"status":"offline","id":"65e878118649bee11545f64d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/2185fb968caadafc79e132fef3c5c8109f1b021cd0acf8a836a1184c82c2585c.webp","original":"https://scriptblox.com/images/photo/65e878118649bee11545f64d-1729269485662.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:08:39.881Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52f80","editBy":{"_id":"65e878118649bee11545f64d","username":"sametexe","status":"offline","id":"65e878118649bee11545f64d"},"message":"Create script","createdAt":"2025-03-27T22:38:59.781Z"}],"comments":[{"_id":"6734089427a93d92f284214b","commentBy":{"_id":"66d366afde53e6feb7744f0d","username":"SimpleScripter","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b1edabcdbe2a2ada1c2a223a9fa307764fb515293aa9709fc6ddf6ed8fd6df1d.webp","original":"https://scriptblox.com/images/photo/66d366afde53e6feb7744f0d-1738454305630.png"},"createdAt":"2024-08-31T18:53:35.332Z","lastActive":"2025-05-06T00:56:12.553Z","status":"offline","id":"66d366afde53e6feb7744f0d","profile":{"url":"https://media.kocakz.me/b1edabcdbe2a2ada1c2a223a9fa307764fb515293aa9709fc6ddf6ed8fd6df1d.webp","original":"https://scriptblox.com/images/photo/66d366afde53e6feb7744f0d-1738454305630.png"}},"text":"Very good keep I up","createdAt":"2024-11-13T02:01:56.357Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"6734095e1995dbf6bba31bf3","commentBy":{"_id":"66d366afde53e6feb7744f0d","username":"S