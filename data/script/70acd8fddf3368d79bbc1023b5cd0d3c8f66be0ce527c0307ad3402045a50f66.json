eConfig\")\n   if config then\n   US.InputBegan:Connect(function(k,n)\n     if not n and k.KeyCode == Enum.KeyCode.W then\n       config:SetAttribute(\"Engine\",700)\n       config:SetAttribute(\"Turbo\",5000)\n     end\nend)\nUS.InputEnded:Connect(function(k,n)\n   if not n and k.KeyCode == Enum.KeyCode.W then\n       config:SetAttribute(\"Engine\",1) \n       config:SetAttribute(\"Turbo\",10)\n       config:SetAttribute(\"Brakes\",0.3)\n       config:SetAttribute(\"Drivetrain\",\"AWD\")\n     end\nend)\nend\nelse\nwarn(\"no car\")\nend\n\nprint(\"hello console - water_hax\")","features":"THIS SCRIPT IS WORKING ON KEYBOARD ONLY BUT YOU CAN MODIFY IT BY MAKING IT MOBILE LIKE AUTOMATIC BUT THE MAX SPEED WILL MAKE THE CAR DRIVE ITSELF !\n\n-- made by water_hax idk this already got found","tags":["CAR","SPEED","admin","OP SCRIPT","ESP"],"discord":"","keyLink":"","owner":{"_id":"671e1eb515909d3457e7e6d6","username":"water_hax","verified":false,"profilePicture":{"url":"https://media.kocakz.me/87632460dcacb45e58f5d75063f7bdf4a59c1375b08ca8a4e1344f38d277b630.webp","original":"https://scriptblox.com/images/photo/671e1eb515909d3457e7e6d6-1730027301478.png"},"status":"offline","id":"671e1eb515909d3457e7e6d6","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/87632460dcacb45e58f5d75063f7bdf4a59c1375b08ca8a4e1344f38d277b630.webp","original":"https://scriptblox.com/images/photo/671e1eb515909d3457e7e6d6-1730027301478.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:59:13.162Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6822240bd63a761dc94a9390","editBy":{"_id":"671e1eb515909d3457e7e6d6","username":"water_hax","status":"offline","id":"671e1eb515909d3457e7e6d6"},"message":"Create script","createdAt":"2025-05-12T16:38:35.044Z"}],"comments":[{"_i