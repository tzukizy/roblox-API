{"_id":"6970b5d949109d805c1af0c6","title":"Chat with anyone","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/b3ae4c64faaa649b7791353f109a8c515e750827790480a017dabac8daa79e6f.webp","original":"https://scriptblox.com/images/sb/0-1768994265744.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/b3ae4c64faaa649b7791353f109a8c515e750827790480a017dabac8daa79e6f.webp","original":"https://scriptblox.com/images/sb/0-1768994265744.jpg"},"placeId":0},"slug":"Universal-Script-Chat-with-anyone-88784","verified":false,"key":false,"keyless":false,"views":1102,"executes":939,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f455d195ca9672676d5e5dd1266a0d2e24229e5887ab3ffdec22768a4a86c637.webp","original":"https://scriptblox.com/images/sb/0-1768994265744.jpg","scriptblox":"https://scriptblox.com/images/script/0-1768994265744.jpg"},"thumbnail":{"url":"https://media.kocakz.me/f455d195ca9672676d5e5dd1266a0d2e24229e5887ab3ffdec22768a4a86c637.webp","original":"https://scriptblox.com/images/sb/0-1768994265744.jpg","scriptblox":"https://scriptblox.com/images/script/0-1768994265744.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-01-21T11:17:45.766Z","updatedAt":"2026-01-21T11:17:45.766Z","lastBump":"2026-01-21T11:17:45.766Z","script":"-- ConsoleChat by joyful_pizzapartyl(changed name)\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- valid commands (lowercase)\nlocal commands = {\n\t[\"/e consolectrl\"] = true,\n\t[\"/e consctrl\"] = true,\n\t[\"/e cc\"] = true,\n}\n\nplayer.Chatted:Connect(function(msg)\n\tlocal lower = string.lower(msg)\n\n\tfor cmd in pairs(commands) do\n\t\tif lower:sub(1, #cmd) == cmd then\n\t\t\tlocal content = msg:sub(#cmd + 2) -- text after command + space\n\n\t\t\tif content ~= \"\" then\n\t\t\t\tprint(\"> CC by \" .. player.Name .. \": \" .. content)\n\t\t\telse\n\t\t\t\tprint(\"> CC by \" .. player.Name .. \": (empty message)\")\n\t\t\tend\n\n\t\t\tbreak\n\t\tend\n\tend\nend)\n","features":"(picture is NOT the screenshot for the script.)\nSo\nIf you type\n\"/e ConsoleCtrl\" or\n\"/e ConsCtrl\" or\n\"/e CC\"\nYou can talk in console.\nLike\n\"/e CC hi\"","tags":[],"discord":"","keyLink":"","owner":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b7ba4c2307eabe526ae7e7a21def90beed9500b02d5e89229f1e5157ec38eff6.webp","original":"https://scriptblox.com/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg"},"status":"offline","id":"69336be27540101a4ec9c8cd","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/b7ba4c2307eabe526ae7e7a21def90beed9500b02d5e89229f1e5157ec38eff6.webp","original":"https://scriptblox.com/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:42:47.738Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6970b5d949109d805c1af0c9","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"message":"Create script","createdAt":"2026-01-21T11:17:45.771Z"}],"comments":[{"_id":"6970b6140b5bcb10d7656f9e","commentBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b7ba4c2307eabe526ae7e7a21def90beed9500b02d5e89229f1e5157ec38eff6.webp","original":"https://scriptblox.com/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg"},"lastActive":"2026-03-08T00:35:50.412Z","createdAt":"2025-12-05T23:33:54.390Z","status":"offline","id":"69336be2754010