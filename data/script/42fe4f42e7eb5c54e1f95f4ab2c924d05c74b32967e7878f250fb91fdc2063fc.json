{"slug":"Universal-Script-Chat-with-anyone-88784","_id":"6970b5d949109d805c1af0c6","title":"Chat with anyone","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1768994265744.jpg","placeId":0},"features":"(picture is NOT the screenshot for the script.)\nSo\nIf you type\n\"/e ConsoleCtrl\" or\n\"/e ConsCtrl\" or\n\"/e CC\"\nYou can talk in console.\nLike\n\"/e CC hi\"","tags":[],"script":"-- ConsoleChat by joyful_pizzapartyl(changed name)\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- valid commands (lowercase)\nlocal commands = {\n\t[\"/e consolectrl\"] = true,\n\t[\"/e consctrl\"] = true,\n\t[\"/e cc\"] = true,\n}\n\nplayer.Chatted:Connect(function(msg)\n\tlocal lower = string.lower(msg)\n\n\tfor cmd in pairs(commands) do\n\t\tif lower:sub(1, #cmd) == cmd then\n\t\t\tlocal content = msg:sub(#cmd + 2) -- text after command + space\n\n\t\t\tif content ~= \"\" then\n\t\t\t\tprint(\"> CC by \" .. player.Name .. \": \" .. content)\n\t\t\telse\n\t\t\t\tprint(\"> CC by \" .. player.Name .. \": (empty message)\")\n\t\t\tend\n\n\t\t\tbreak\n\t\tend\n\tend\nend)\n","owner":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","verified":false,"profilePicture":"/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg","status":"offline","id":"69336be27540101a4ec9c8cd","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":1080,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1768994265744.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2026-01-21T11:17:45.766Z","executes":879,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6970b5d949109d805c1af0c9","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"message":"Create script","createdAt":"2026-01-21T11:17:45.771Z"}],"co