{"_id":"6655334722e965624fdc545b","title":"Proximity AutoAim Script","game":{"_id":"67e5e1ffb360710ec3c77d21","gameId":6961824067,"name":"Fling Things and People","imageUrl":{"url":"https://media.kocakz.me/3a8897da8f7354085eec2a25324f9f340421a2f5a735618005d8f3bd6884fe0d.webp","original":"https://tr.rbxcdn.com/180DAY-298897e01eeb244af09a923c7c0cdbcc/150/150/Image/Png/noFilter"},"slug":"6961824067-fling-things-and-people","path":"/game/6961824067-fling-things-and-people","thumbnail":{"url":"https://media.kocakz.me/3a8897da8f7354085eec2a25324f9f340421a2f5a735618005d8f3bd6884fe0d.webp","original":"https://tr.rbxcdn.com/180DAY-298897e01eeb244af09a923c7c0cdbcc/150/150/Image/Png/noFilter"},"placeId":6961824067},"slug":"Fling-Things-and-People-Proximity-AutoAim-Script-13519","verified":false,"key":false,"keyless":false,"views":45390,"executes":2852,"scriptType":"paid","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/cc8fcff7b35fef35dd64bb4387bfb068/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/cc8fcff7b35fef35dd64bb4387bfb068/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/cc8fcff7b35fef35dd64bb4387bfb068/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/cc8fcff7b35fef35dd64bb4387bfb068/500/280/Image/Jpeg"},"likeCount":4,"dislikeCount":1,"createdAt":"2024-05-28T01:28:39.761Z","updatedAt":"2024-05-28T01:28:39.761Z","lastBump":"2024-05-28T01:28:39.761Z","script":"game:GetService(\"StarterGui\"):SetCore(\"SendNotification\", {Title = \"Loaded\", Text = \"press Q to auto aim\"})\n\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Camera = workspace.CurrentCamera\n\n-- Settings\nlocal Settings = {\n    BindKey = \"Q\" -- Custom Key\n}\n\nlocal isClicking = false\n\nlocal function getClosestPlayer()\n    local closestPlayer = nil\n    local shortestDistance = math.huge\n\n    for _, player in pairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local distance = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).magnitude\n            if distance < shortestDistance then\n                closestPlayer = player\n                shortestDistance = distance\n            end\n        end\n    end\n\n    return closestPlayer\nend\n\nlocal function aimAt(target)\n    if target and target.Character and target.Character:FindFirstChild(\"HumanoidRootPart\") then\n        local targetPosition = target.Character.HumanoidRootPart.Position\n        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPosition)\n        \n        if not isClicking then\n            isClicking = true\n            mouse1click()\n            isClicking = false\n        end\n    end\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if input.KeyCode == Enum.KeyCode[Settings.BindKey:upper()] and not gameProcessed then\n        local closestPlayer = getClosestPlayer()\n        aimAt(closestPlayer)\n    end\nend)","features":"Proximity aim for roblox universal made by chatgpt \n\nEvery time you press the Q (or custom)  the camera will automatically redirect to the nearest player and click","tags":["aim","autoaim","universal","aimbot","autoaimbot"],"discord":"","keyLink":"","owner":{"_id":"64cbdfae6940caf3b3cf5c35","username":"Fkbamp","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d7fc861cf2e3b2a09d4fc89697c615463028e5dbf99d6fe2a26f55b9c5372615.webp","original":"https://scriptblox.com/images/photo/64cbdfae6940caf3b3cf5c35-1694922627247.jpeg"},"status":"offline","id":"64cbdfae6940caf3b3cf5c35","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https:/