orm.XBoxOne \n        elseif method == \"IsTenFootInterface\" then\n            return true \n        elseif method == \"GetPlatformName\" then\n            return \"XboxOne\" \n        end\n    end\n    \n    return oldNamecall(self, ...)\nend)\n\n\noldIndex = hookmetamethod(game, \"__index\", function(tbl, idx)\n    \n    if tostring(getcallingscript()) ~= \"ControlModule\" and tbl == UserInputService then\n        if idx == \"TouchEnabled\" then\n            return false \n        elseif idx == \"MouseEnabled\" then\n            return false \n        elseif idx == \"KeyboardEnabled\" then\n            return false \n        elseif idx == \"GamepadEnabled\" then\n            return true \n        elseif idx == \"ControllerEnabled\" then\n            return true \n        end\n    end\n    \n    return oldIndex(tbl, idx)\nend)\n\n\nprint(\"[Platform Spoofer] Successfully hooked platform and input methods to emulate Xbox One.\") ","features":"spoofs your device to controller","tags":[],"discord":"","keyLink":"","owner":{"_id":"6804f837cd40f6a1ad031a9d","username":"i1231931","verified":false,"profilePicture":{"url":"https://media.kocakz.me/006861f24dd3d922885356277f52520b527322213fb09c7c5286fa431f46dfae.webp","original":"https://scriptblox.com/images/photo/6804f837cd40f6a1ad031a9d-1775759283220.png"},"status":"offline","id":"6804f837cd40f6a1ad031a9d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/006861f24dd3d922885356277f52520b527322213fb09c7c5286fa431f46dfae.webp","original":"https://scriptblox.com/images/photo/6804f837cd40f6a1ad031a9d-1775759283220.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:54:04.783Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68320b54c236ccc4ac25ac4f","editBy":{"_id":"6804f837cd40f6a1ad031a9d","use