{"_id":"6ad9303ec5f6dfaa55978efb","title":"LEXA AGE CHAT","game":{"_id":"67e5e1ffb360710ec3c77d10","gameId":4924922222,"name":"Brookhaven 🏡RP","imageUrl":{"url":"https://media.kocakz.me/8e5c1e1f2a589a0dbfcebd1a5d681057dfb33c2bff512a108794887c0d9ade03.webp","original":"https://tr.rbxcdn.com/180DAY-577f3f78d1f056c80db7d2a54c8d384d/150/150/Image/Png/noFilter"},"slug":"4924922222-brookhaven-rp","path":"/game/4924922222-brookhaven-rp","thumbnail":{"url":"https://media.kocakz.me/8e5c1e1f2a589a0dbfcebd1a5d681057dfb33c2bff512a108794887c0d9ade03.webp","original":"https://tr.rbxcdn.com/180DAY-577f3f78d1f056c80db7d2a54c8d384d/150/150/Image/Png/noFilter"},"placeId":4924922222},"slug":"Brookhaven-RP-LEXA-AGE-CHAT-232921","verified":false,"key":false,"keyless":false,"views":688,"executes":64,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f408573c8e05028147c82a0cb9e5a757e03b5b0c34d513a8c784e0ab9fc522d9.webp","original":"https://scriptblox.com/images/sb/4924922222-1792618558288.jpg","scriptblox":"https://scriptblox.com/images/script/4924922222-1792618558288.jpg"},"thumbnail":{"url":"https://media.kocakz.me/f408573c8e05028147c82a0cb9e5a757e03b5b0c34d513a8c784e0ab9fc522d9.webp","original":"https://scriptblox.com/images/sb/4924922222-1792618558288.jpg","scriptblox":"https://scriptblox.com/images/script/4924922222-1792618558288.jpg"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-10-21T21:35:58.402Z","updatedAt":"2026-10-21T21:35:58.402Z","lastBump":"2026-10-21T21:35:58.402Z","script":"-- LEXA CHAT SYSTEM WITH OWNER & MEMBER TAGS\nlocal OWNER_NAME = \"RIOT_4444\" -- آپ کا روبلوکس یوزر نیم\n\n-- اصلی اسکرپٹ حاصل کرنا\nlocal rawUrl = \"https://gist.githubusercontent.com/falconxyash97/3a712aea8d093e88118a3c78f6d689a7/raw/beeaf4920039e16f86a566a964415ac7eed922d5/RINKAZE%2520CHAT%2520NEW.lua\"\nlocal rawSource = game:HttpGet(rawUrl)\n\n-- نام کو LEXA CHAT میں تبدیل کرنا\nrawSource = string.gsub(rawSource, \"RINKAZE CHAT SYSTEM\", \"LEXA CHAT\")\nrawSource = string.gsub(rawSource, \"RINKAZE CHAT\", \"LEXA CHAT\")\nrawSource = string.gsub(rawSource, \"RINKAZE\", \"LEXA\")\n\n-- اصلی اسکرپٹ چلانا\nlocal runScript, err = loadstring(rawSource)\nif runScript then\n    runScript()\nelse\n    warn(\"اسکرپٹ لوڈ کرنے میں مسئلہ ہوا: \" .. tostring(err))\nend\n\n-- آنر اور ممبر ٹیگ سیٹ کرنے کے لیے لوپ\ntask.spawn(function()\n    local Players = game:GetService(\"Players\")\n    local LocalPlayer = Players.LocalPlayer\n    \n    while task.wait(0.3) do\n        local targets = {game:GetService(\"CoreGui\"), LocalPlayer:WaitForChild(\"PlayerGui\")}\n        for _, parent in ipairs(targets) do\n            for _, obj in pairs(parent:GetDescendants()) do\n                if obj:IsA(\"TextLabel\") or obj:IsA(\"TextButton\") then\n                    -- نام کی تبدیلی\n                    if obj.Text:find(\"RINKAZE\") then\n                        obj.Text = obj.Text:gsub(\"RINKAZE\", \"LEXA\")\n                    end\n                    \n                    -- آپ کو OWNER اور باقی سب کو MEMBER بنانا\n                    if obj.Text:find(\"%[MEMBER%]\") or obj.Text:find(\"%[OWNER%]\") then\n                        if obj.Text:find(OWNER_NAME) or obj.Text:find(LocalPlayer.Name) then\n                            obj.Text = obj.Text:gsub(\"%[MEMBER%]\", \"[OWNER]\")\n                        else\n                            obj.Text = obj.Text:gsub(\"%[OWNER%]\", \"[MEMBER]\")\n                        end\n                    end\n                end\n            end\n        end\n    end\nend)","features":"LEXA AGE CHAT\nLEXA GOD\nNO TAGS","tags":["Brookhaven script"],"discord":"","keyLink":"","owner":{"_id":"6ac0dd58bfa5149295c2aad9","username":"Meboy961","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":5,"status":"offline","id":"6ac0dd58bfa5149295c2aad9","topMilestone":{"key":"creator.first_script","tier":1},"profil