{"_id":"697a5d5a92a4802284e8b645","title":"Auto hole in one","game":{"_id":"697a5d5a92a4802284e8b642","gameId":84956402848349,"name":"Realistic Golf ⛳","imageUrl":{"url":"https://media.kocakz.me/1948d9efa60cb0b1a894e9728e08a804cadba7126eaaa2764e00d68202c1e842.webp","original":"https://tr.rbxcdn.com/180DAY-431817d8eedcf1a37da67d633d0d9ebc/150/150/Image/Png/noFilter"},"slug":"84956402848349-realistic-golf","path":"/game/84956402848349-realistic-golf","thumbnail":{"url":"https://media.kocakz.me/1948d9efa60cb0b1a894e9728e08a804cadba7126eaaa2764e00d68202c1e842.webp","original":"https://tr.rbxcdn.com/180DAY-431817d8eedcf1a37da67d633d0d9ebc/150/150/Image/Png/noFilter"},"placeId":84956402848349},"slug":"Realistic-Golf-Auto-hole-in-one-94528","verified":false,"key":false,"keyless":false,"views":11208,"executes":2598,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c06c80f61f74e5e161bfbf7d0aa69f1df0ae3071df2514be4c7b18aee4ebaff3.webp","original":"https://scriptblox.com/images/sb/rbx-148c035fbc5f6add237733b26d6078cc-46ff2918df44.png","scriptblox":"https://scriptblox.com/images/script/rbx-148c035fbc5f6add237733b26d6078cc-46ff2918df44.png"},"thumbnail":{"url":"https://media.kocakz.me/c06c80f61f74e5e161bfbf7d0aa69f1df0ae3071df2514be4c7b18aee4ebaff3.webp","original":"https://scriptblox.com/images/sb/rbx-148c035fbc5f6add237733b26d6078cc-46ff2918df44.png","scriptblox":"https://scriptblox.com/images/script/rbx-148c035fbc5f6add237733b26d6078cc-46ff2918df44.png"},"likeCount":3,"dislikeCount":5,"createdAt":"2026-01-28T19:02:50.638Z","updatedAt":"2026-01-28T19:02:50.638Z","lastBump":"2026-01-28T19:02:50.638Z","script":"-- // Credit : DownInDaNang\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal GetCupLocation = ReplicatedStorage:WaitForChild(\"Functions\"):WaitForChild(\"GetCupLocationFunction\")\nlocal TargetCupPos: Vector3? = nil\n\nlocal function UpdateHoleLocation(): ()\n    local CurrentHole: number = LocalPlayer:WaitForChild(\"leaderstats\"):WaitForChild(\"Hole\").Value\n    local HoleString: string = string.format(\"%03d\", CurrentHole)\n    local CourseModel: any = workspace:FindFirstChild(\"9HoleCourse\")\n    \n    local CupPos: any, CupData: any = GetCupLocation:InvokeServer(HoleString, CourseModel and CourseModel.Name or nil)\n    if typeof(CupPos) == \"Vector3\" then\n        TargetCupPos = CupPos\n    end\nend\n\nLocalPlayer:WaitForChild(\"leaderstats\"):WaitForChild(\"Hole\").Changed:Connect(UpdateHoleLocation)\ntask.spawn(UpdateHoleLocation)\n\nlocal OldNewIndex: any\nOldNewIndex = hookmetamethod(game, \"__newindex\", function(Self: any, Index: string, Value: any): any\n    if not checkcaller() and (Index == \"AssemblyLinearVelocity\" or Index == \"Velocity\") and Self:IsA(\"BasePart\") and Self.Name:find(\"Ball\") then\n        if TargetCupPos then\n            local DeltaPos: Vector3 = (TargetCupPos - Self.Position)\n            local HorizontalDist: number = Vector3.new(DeltaPos.X, 0, DeltaPos.Z).Magnitude\n            \n            if HorizontalDist > 0.5 then\n                local TimeToTarget: number = math.clamp(HorizontalDist / 30, 0.4, 1.2)\n                local Gravity: number = 35.037 -- grav\n                \n                local AimVelocity: Vector3 = Vector3.new(\n                    DeltaPos.X / TimeToTarget,\n                    (DeltaPos.Y + 0.5 * Gravity * TimeToTarget^2) / TimeToTarget,\n                    DeltaPos.Z / TimeToTarget\n                )\n                \n                return OldNewIndex(Self, Index, AimVelocity)\n            end\n        end\n    end\n    return OldNewIndex(Self, Index, Value)\nend)","features":"Script is not mine btw.\n\nCredit : DownInDaNang\n\nAuto makes ball go to hole","tags":[],"discord":"","keyLink":"","owner":{"_id":"684c18e4df5a1e39162d8036","username":"JAMEEEEES","verified":false,"profile