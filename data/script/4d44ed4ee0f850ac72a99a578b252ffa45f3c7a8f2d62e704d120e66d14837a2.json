{"slug":"Noob-Army-Tycoon-BEST-OP-CASH-FARM-12M-AN-HOUR-UNDETECTED-KEYLESS-OPEN-SOURCE-56235","_id":"68dfe5bb2d2cab8e37340d61","title":"BEST OP CASH FARM 12M AN HOUR UNDETECTED KEYLESS OPEN SOURCE","game":{"_id":"68dfe5bb2d2cab8e37340d5e","gameId":6610021055,"name":"Noob Army Tycoon ⚔️(New noobs)","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":6610021055},"features":"Made by @kylosilly","tags":["op","Noob Army Tycoon","Noob Army Tycoon Semi Inf Cash","Noob Army Tycoon Script"],"script":"-- made by @kylosilly on discord [dm/add me if any issues]\nlocal character = game:GetService(\"Players\").LocalPlayer.Character\n\nlocal map = game:GetService(\"Workspace\").Map\nlocal treasures = map.Treasures\nlocal obby_land = map.ObbyLand\n\ngetgenv().settings = {\n    -- main setting\n    auto_farm = true, -- false to turn off\n    -- misc setting\n    farm_treasures = true -- collects all chest around map if true\n}\n\nfunction get_time()\n    return os.date(\"%X\")\nend\n\nif (settings.auto_farm) then\n    repeat\n        local teleporters = obby_land.Teleporters\n        local finish = obby_land.Finish\n        if (#teleporters:GetChildren() == 0) or (#finish:GetChildren() == 0) then\n            rconsoleprint(\"[Auto Farm] Teleporter or finish folder is empty. Attempting to fix. \"..get_time()..\"\\n\")\n            character:SetPrimaryPartCFrame(CFrame.new(obby_land.Model:GetPivot().Position))\n            rconsoleprint(\"[Auto Farm] Empty folders fixed. \"..get_time()..\"\\n\")\n            task.wait(2)\n        end\n        local final_obby_teleporter = teleporters[\"11\"]\n        local final_obby_finish = finish[\"11\"]\n        character:SetPrimaryPartCFrame(CFrame.new(final_obby_teleporter.Position))\n        rconsoleprint(\"[Auto Farm] Starting last obby. \"..get_time()..\"\\n\")\n        task.wait(.5)\n        fireproximityprompt(final_obby_teleporter.ProximityPrompt)\n        task.wait(5)\n        character:SetPrimaryPartCFrame(CFrame.new(final_obby_finish.Position))\n        rconsoleprint(\"[Auto Farm] Teleported to the end. \"..get_time()..\"\\n\")\n        task.wait(.5)\n        fireproximityprompt(final_obby_finish.ProximityPrompt)\n        rconsoleprint(\"[Auto Farm] Claimed 20k. \"..get_time()..\"\\n\")\n        task.wait(.5)\n        if (#treasures:GetChildren() < 3) then\n            continue\n        end\n        rconsoleprint(\"[Auto Farm] Collecting treasures. \"..get_time()..\"\\n\")\n        for _, v in treasures:GetChildren() do\n            local prompt = v:FindFirstChildWhichIsA(\"ProximityPrompt\")\n            if (not prompt) then\n                continue\n            end\n            character:SetPrimaryPartCFrame(CFrame.new(v.Position + Vector3.new(0, 20, 0)))\n            task.wait(.5)\n            fireproximityprompt(prompt)\n        end\n    until (not settings.auto_farm)\n    rconsoledestroy()\nend","owner":{"_id":"68c54d7e0985bed96e33514b","username":"CatBoyy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/91cc1b7e6cb57e82c46a1d70783107012e27ef6f960522852ee487d37bc849f8.webp","original":"https://scriptblox.com/images/photo/68c54d7e0985bed96e33514b-1757760986018.png"},"status":"offline","id":"68c54d7e0985bed96e33514b","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/91cc1b7e6cb57e82c46a1d70783107012e27ef6f960522852ee487d37bc849f8.webp","original":"https://scriptblox.com/images/photo/68c54d7e0985bed96e33514b-1757760986018.png"}},"verified":false,"views":9686,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6c1f78df5a0acc340eb49d389a8b96f209fdb18fa18600cf3fca5fb692cda21c.webp","original":"https://scriptblox.com/images/sb/6610021055-1759505882545.png","scriptblox":"https://scriptblox.com/images/script/6610021055-1759505882545.png"},"like