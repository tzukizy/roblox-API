{"_id":"690e8eed33ba21894f72a01e","title":"speed 75 use for auto kill lord vetus","game":{"_id":"67e5e1ffb360710ec3c78716","gameId":12483414252,"name":"Skill Based Boss Fights","imageUrl":{"url":"https://media.kocakz.me/069db71cfa066cd858e5c5d3703fa271876c3f8e927424e18f418c82dcb80880.webp","original":"https://tr.rbxcdn.com/180DAY-c92819cde906a369f0c73eeaed1f8fc2/150/150/Image/Png/noFilter"},"slug":"12483414252-skill-based-boss-fights","path":"/game/12483414252-skill-based-boss-fights","thumbnail":{"url":"https://media.kocakz.me/069db71cfa066cd858e5c5d3703fa271876c3f8e927424e18f418c82dcb80880.webp","original":"https://tr.rbxcdn.com/180DAY-c92819cde906a369f0c73eeaed1f8fc2/150/150/Image/Png/noFilter"},"placeId":12483414252},"slug":"Skill-Based-Boss-Fights-speed-75-use-for-auto-kill-lord-vetus-64201","verified":false,"key":false,"keyless":false,"views":4057,"executes":39,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/8cfc2d83697eeb65cbcb7bba6bb63441fc2c59bb4668fff5198d09cd00fb33b3.webp","original":"https://scriptblox.com/images/sb/rbx-f9e9bd9ee5dbf01f2b701368352c83d1-742316f04bd6.png","scriptblox":"https://scriptblox.com/images/script/rbx-f9e9bd9ee5dbf01f2b701368352c83d1-742316f04bd6.png"},"thumbnail":{"url":"https://media.kocakz.me/8cfc2d83697eeb65cbcb7bba6bb63441fc2c59bb4668fff5198d09cd00fb33b3.webp","original":"https://scriptblox.com/images/sb/rbx-f9e9bd9ee5dbf01f2b701368352c83d1-742316f04bd6.png","scriptblox":"https://scriptblox.com/images/script/rbx-f9e9bd9ee5dbf01f2b701368352c83d1-742316f04bd6.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-11-08T00:29:33.433Z","updatedAt":"2025-11-08T00:29:33.433Z","lastBump":"2025-11-08T00:29:33.433Z","script":"-- LocalScript（放在 StarterPlayerScripts）\n\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n-- 核心函数：把速度设为 100\nlocal function setSpeed(character)\n    local humanoid = character:WaitForChild(\"Humanoid\", 5)\n    if humanoid then\n        humanoid.WalkSpeed = 100\n    end\nend\n\n-- 第一次角色生成时设置\nif player.Character then\n    setSpeed(player.Character)\nend\n\n-- 每次重生都重新设置\nplayer.CharacterAdded:Connect(setSpeed)\n\n-- （可选）防止其他脚本或系统重置速度\n-- 每 0.5 秒强制一次（防被游戏机制改回去）\nspawn(function()\n    while true do\n        wait(0.5)\n        if player.Character and player.Character:FindFirstChild(\"Humanoid\") then\n            player.Character.Humanoid.WalkSpeed = 100\n        end\n    end\nend)","features":"speed 75 (i got sentry) , my roblox user name is : SS198_YTM34(SS198_YT got ban) , this speed not is gui :)","tags":["speed"],"discord":"","keyLink":"","owner":{"_id":"6886f9abfa2f83b2ca476803","username":"SS198_YT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a3b5de1248ad569acd108f1a20632016c75b9e3cae14b6a608aaa1c92236045b.webp","original":"https://scriptblox.com/images/photo/6886f9abfa2f83b2ca476803-1778983188379.png"},"status":"offline","id":"6886f9abfa2f83b2ca476803","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/a3b5de1248ad569acd108f1a20632016c75b9e3cae14b6a608aaa1c92236045b.webp","original":"https://scriptblox.com/images/photo/6886f9abfa2f83b2ca476803-1778983188379.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:54:49.249Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"690e8eed33ba21894f72a020","editBy":{"_id":"6886f9abfa2f83b2ca476803","username":"SS198_YT","status":"offline","id":"6886f9abfa2f83b2ca476803"},"message":"Create script","createdAt":"2025-11-08T00:29:33.438Z"}],"comments":[{"_id":"690e8f0e2a21bd15138c7061","commentBy":{"_id":"6886f9abfa2f83b2ca476803","username":"SS198_YT","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/a3b5de1248ad569acd108f1a206