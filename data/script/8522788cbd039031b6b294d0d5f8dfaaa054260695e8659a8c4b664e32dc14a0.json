{"_id":"67b89a5496adb82e905cec60","title":"OP Gui","game":{"_id":"67e5e1ffb360710ec3c787ec","gameId":76148928963494,"name":"[💕] Shoot the Murderer","imageUrl":{"url":"https://media.kocakz.me/32ebf68bcb702779a247ccea16774ad9e5deec8f207e72c417ab60773c1030d9.webp","original":"https://tr.rbxcdn.com/180DAY-f6043861322a8b3942a4ea0f56e98a0e/150/150/Image/Png/noFilter"},"slug":"76148928963494-shoot-the-murderer","path":"/game/76148928963494-shoot-the-murderer","thumbnail":{"url":"https://media.kocakz.me/32ebf68bcb702779a247ccea16774ad9e5deec8f207e72c417ab60773c1030d9.webp","original":"https://tr.rbxcdn.com/180DAY-f6043861322a8b3942a4ea0f56e98a0e/150/150/Image/Png/noFilter"},"placeId":76148928963494},"slug":"Shoot-the-Murderer-OP-Gui-29914","verified":false,"key":false,"keyless":false,"views":9501,"executes":50,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-1202a30ff4e6470c1e7c13d5d7f00c83/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-1202a30ff4e6470c1e7c13d5d7f00c83/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-1202a30ff4e6470c1e7c13d5d7f00c83/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-1202a30ff4e6470c1e7c13d5d7f00c83/500/280/Image/Jpeg/noFilter"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-02-21T15:23:00.070Z","updatedAt":"2025-02-21T15:23:00.070Z","lastBump":"2025-02-21T15:23:00.070Z","script":"local Player = game.Players.LocalPlayer\nlocal MarketplaceService = game:GetService(\"MarketplaceService\")\n\nlocal Fluent = loadstring(game:HttpGet(\"https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua\"))()\nlocal Window = Fluent:CreateWindow({\n\tTitle = \"Shoot the murderer\",\n\tSubTitle = \"by Bjarnos\",\n\tTabWidth = 160,\n\tSize = UDim2.fromOffset(580, 460),\n\tAcrylic = true,\n\tTheme = \"Dark\",\n\tMinimizeKey = Enum.KeyCode.LeftControl\n})\n\nlocal Tabs = {\n\tMain = Window:AddTab({Title = \"Main\", Icon = \"\"}),\n\tDevproducts = Window:AddTab({Title = \"Devproducts\", Icon = \"\"}),\n}\n\nWindow:SelectTab(\"Main\")\nTabs.Main:AddButton({\n\tTitle = \"Become murderer\",\n\tDescription = \"(next round)\",\n\tCallback = function()\n\t\tfor i = 1, 50 do\n\t\t\tMarketplaceService:SignalPromptProductPurchaseFinished(Player.UserId, 2651043006, true)\n\t\tend\n\tend\n})\n\nTabs.Main:AddButton({\n\tTitle = \"Get gems\",\n\tDescription = \"200k good enough?\",\n\tCallback = function()\n\t\tfor i = 1, 10 do\n\t\t\tMarketplaceService:SignalPromptProductPurchaseFinished(Player.UserId, 2656221386, true)\n\t\tend\n\tend\n})\n\nTabs.Main:AddButton({\n\tTitle = \"Get heart coins [event]\",\n\tDescription = \"1 million should be good enough...\",\n\tCallback = function()\n\t\tfor i = 1, 5 do\n\t\t\tMarketplaceService:SignalPromptProductPurchaseFinished(Player.UserId, 2688756812, true)\n\t\tend\n\tend\n})\n\nTabs.Main:AddButton({\n\tTitle = \"Get wheel spins\",\n\tDescription = \"100 O-o\",\n\tCallback = function()\n\t\tfor i = 1, 20 do\n\t\t\tMarketplaceService:SignalPromptProductPurchaseFinished(Player.UserId, 7352530914, true)\n\t\tend\n\tend\n})\n\nlocal blacklist = {2651043006, \"Gems\", \"Level\", \"Heart\", \"Wheel\"}\nlocal products = {}\n\nlocal developerProducts = MarketplaceService:GetDeveloperProductsAsync()\nfor _, developerProduct in ipairs(developerProducts:GetCurrentPage()) do\n\tlocal allow = true\n\tfor _, i in pairs(blacklist) do\n\t\tif typeof(i) == \"number\" then\n\t\t\tif developerProduct.ProductId == i then allow = false end\n\t\telse\n\t\t\tif string.find(developerProduct.Name, i) then allow = false end\n\t\tend\n\tend\n\n\tif allow then\n\t\ttable.insert(products, developerProduct)\n\tend\nend\n\nTabs.Devproducts:AddButton({\n\tTitle = \"GET ALL\",\n\tDescription = \"for lazy people\",\n\tCallback = function()\n\t\tfor _, product in pairs(products) do\n\t\t\tMarketplaceService:SignalPromptProductPurchaseFinished(Player.UserId, product.ProductId, true)\n\t\tend\n\tend\n})\n\nfor _, product in pairs(products) do\n\tTabs.Devproducts:AddButton({\n\t\tTitle = product.Name,\n\t\tDescription = product.PriceInRobux .. \"R\",\n\t\tCallback = function()\n\t\t\tMarketplaceService:SignalPromptProductPurchaseFinished(Player.UserId, product.ProductId, true)\n\t\tend\n\t})\nend","features":"- Become murderer next round\n- Inf gems\n- Inf heart coins [event]\n- Inf wheel spins\n- ALL EXCLUSIVE GUNS!!!","tags":["op","gui","exclusive","devproduct","robux"],"discord":"","keyLink":"","owner":{"_id":"66d0d014f86ef01518b30362","username":"Bjarnos","verified":false,"profilePicture":{"url":"https://media.kocakz.me/94fafa67ea5bd36f7ff91e42c4fa9748511e6c0b3ad3332c951a7607d1fd6157.webp","original":"https://scriptblox.com/images/photo/66d0d014f86ef01518b30362-1724960871449.jpg"},"status":"offline","id":"66d0d014f86ef01518b30362","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/94fafa67ea5bd36f7ff91e42c4fa9748511e6c0b3ad3332c951a7607d1fd6157.webp","original":"https://scriptblox.com/images/photo/66d0d014f86ef01518b30362-1724960871449.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:05:19.021Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c55043","editBy":{"_id":"66d0d014f86ef01518b30362","username":"Bjarnos","status":"offline","id":"66d0d014f86ef01518b30362"},"message":"Create script","createdAt":"2025-03-27T21:23:28.827Z"}],"comments":[{"_id":"67b8b4e91ec2c16a13302d19","commentBy":{"_id":"67b39bdfa663ee63cb3f2395","username":"ggholka4","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/a532812bd56d0e9e67991d5ca753ae