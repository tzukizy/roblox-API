{"slug":"Survive-LAVA-for-Brainrots!-delete-lava-112467","_id":"69935bc4473764a076cae8a5","title":"delete lava","game":{"_id":"697fb7e97a49917a819320b1","gameId":119987266683883,"name":"Survive LAVA for Brainrots!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":119987266683883},"features":"its deletes lava","tags":[],"script":"-- Define the names of the folders you want to remove\nlocal targetNames = {\n    \"Lavas\",\n    \"ObbyLavas\",\n    \"UnusedLavas\"\n}\n\n-- Function to check if a name is in our target list\nlocal function isTarget(name)\n    for _, target in ipairs(targetNames) do\n        if name == target then\n            return true\n        end\n    end\n    return false\nend\n\n-- Counter to track how many folders were deleted\nlocal deletedCount = 0\n\n-- Scan the entire Workspace\n-- We use GetDescendants() to find folders even if they are inside other models/folders\nfor _, object in pairs(workspace:GetDescendants()) do\n    if object:IsA(\"Folder\") and isTarget(object.Name) then\n        -- Print to output so you know what is being removed\n        print(\"Deleting folder: \" .. object:GetFullName())\n        \n        object:Destroy()\n        deletedCount = deletedCount + 1\n    end\nend\n\nprint(\"------------------------------------------------\")\nprint(\"Operation Complete. Total folders deleted: \" .. deletedCount)\nprint(\"------------------------------------------------\")","owner":{"_id":"69836e9b3b83f72307692550","username":"boberdobermamix","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"69836e9b3b83f72307692550","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":572,"scriptType":"free","isUniversal":false,"isPatched":false,