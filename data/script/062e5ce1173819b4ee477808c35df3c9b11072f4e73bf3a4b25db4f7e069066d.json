dleAnim)\nlocal walkTrack = hum:LoadAnimation(walkAnim)\nlocal jumpTrack = hum:LoadAnimation(jumpAnim)\n\nlocal function play(anim)\n    idleTrack:Stop()\n    walkTrack:Stop()\n    jumpTrack:Stop()\n    anim:Play()\nend\n\nplay(idleTrack)\n\nhum.Running:Connect(function(speed)\n    if hum:GetState() == Enum.HumanoidStateType.Jumping or hum:GetState() == Enum.HumanoidStateType.Freefall then\n        return\n    end\n    if speed > 0 then\n        play(walkTrack)\n    else\n        play(idleTrack)\n    end\nend)\n\nhum.Jumping:Connect(function()\n    play(jumpTrack)\nend)\n\nhum.StateChanged:Connect(function(_, newState)\n    if newState == Enum.HumanoidStateType.Landed then\n        if hum.MoveDirection.Magnitude > 0 then\n            play(walkTrack)\n        else\n            play(idleTrack)\n        end\n    end\nend)\n","features":"aura","tags":[],"discord":"","keyLink":"","owner":{"_id":"67fdd61fc294b5b147de6f8d","username":"MELZ_HUB","verified":false,"profilePicture":{"url":"https://media.kocakz.me/475021777a4cf54db7f170865d56635c4921e7b398a0efcd88062f5f90a5839c.webp","original":"https://scriptblox.com/images/photo/67fdd61fc294b5b147de6f8d-1767079043670.png"},"status":"offline","id":"67fdd61fc294b5b147de6f8d","profile":{"url":"https://media.kocakz.me/475021777a4cf54db7f170865d56635c4921e7b398a0efcd88062f5f90a5839c.webp","original":"https://scriptblox.com/images/photo/67fdd61fc294b5b147de6f8d-1767079043670.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:34:10.164Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6965ad9c242dea933c692efd","editBy":{"_id":"67fdd61fc294b5b147de6f8d","username":"MELZ_HUB","status":"offline","id":"67fdd61fc294b5b147de6f8d"},"message":"Create script","createdAt":"2026-01-13T02:27:40.613Z"}],"comments":[{"_id":"69780efc7b4426d379252bb2","commen