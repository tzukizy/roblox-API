{"_id":"6ab7ff26d4c9cd7a927d2f0e","title":"NightVision (ALL GAMES!)","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/861be1aa61ce9cd19c3f38215ecfb601b6b676d9830ee09ac2e9e215ff863cff.webp","original":"https://scriptblox.com/images/sb/0-1790443302451.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/861be1aa61ce9cd19c3f38215ecfb601b6b676d9830ee09ac2e9e215ff863cff.webp","original":"https://scriptblox.com/images/sb/0-1790443302451.png"},"placeId":0},"slug":"Universal-Script-NightVision-(ALL-GAMES!)-229991","verified":false,"key":false,"keyless":false,"views":789,"executes":4992,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/21d8163b21f6d60f0d3269a226e7cd57675d047f3563d0f551d4464a8326d6f2.webp","original":"https://scriptblox.com/images/sb/0-1790443302451.png","scriptblox":"https://scriptblox.com/images/script/0-1790443302451.png"},"thumbnail":{"url":"https://media.kocakz.me/21d8163b21f6d60f0d3269a226e7cd57675d047f3563d0f551d4464a8326d6f2.webp","original":"https://scriptblox.com/images/sb/0-1790443302451.png","scriptblox":"https://scriptblox.com/images/script/0-1790443302451.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-09-26T17:21:42.499Z","updatedAt":"2026-09-26T17:21:42.499Z","lastBump":"2026-09-26T17:21:42.499Z","script":"local Lighting = game:GetService(\"Lighting\")\n\n-- Impostazioni\nlocal ORARIO_NOTTE_INIZIO = 18 -- Dalle 18:00 (tramonto)\nlocal ORARIO_NOTTE_FINE = 6   -- Fino alle 06:00 (alba)\n\n-- Salva i colori ambientali originali del gioco\nlocal defaultAmbient = Lighting.Ambient\nlocal defaultOutdoor = Lighting.OutdoorAmbient\n\n-- Colore per la visione notturna (Bianco luminoso/chiaro)\nlocal nightVisionColor = Color3.fromRGB(255, 255, 255)\n\nlocal function aggiornaVisioneNotturna()\n    local tempo = Lighting.ClockTime\n    \n    -- Controlla se l'orario attuale è notturno\n    if tempo >= ORARIO_NOTTE_INIZIO or tempo < ORARIO_NOTTE_FINE then\n        -- Attiva la visione notturna\n        Lighting.Ambient = nightVisionColor\n        Lighting.OutdoorAmbient = nightVisionColor\n    else\n        -- Ripristina l'illuminazione originale del gioco\n        Lighting.Ambient = defaultAmbient\n        Lighting.OutdoorAmbient = defaultOutdoor\n    end\nend\n\n-- Rileva il cambio di orario in tempo reale\nLighting:GetPropertyChangedSignal(\"ClockTime\"):Connect(aggiornaVisioneNotturna)\n\n-- Esegui subito un controllo al momento dell'esecuzione\naggiornaVisioneNotturna()","features":"when it's midnight or nighttime directly, the script applies a night vision effect","tags":[],"discord":"","keyLink":"","owner":{"_id":"69d0e6cd6d8c5e233f3ecc85","username":"Diego72974913","verified":false,"profilePicture":{"url":"https://media.kocakz.me/22467209929ce633662fa3c62521c20860a52e8a2110a16ca0a12d65f0744bfa.webp","original":"https://scriptblox.com/images/photo/69d0e6cd6d8c5e233f3ecc85-1790613170528.jpeg"},"status":"offline","id":"69d0e6cd6d8c5e233f3ecc85","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/22467209929ce633662fa3c62521c20860a52e8a2110a16ca0a12d65f0744bfa.webp","original":"https://scriptblox.com/images/photo/69d0e6cd6d8c5e233f3ecc85-1790613170528.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T21:39:56.074Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6ab7ff26d4c9cd7a927d2f10","editBy":{"_id":"69d0e6cd6d8c5e233f3ecc85","username":"Diego72974913","status":"offline","id":"69d0e6cd6d8c5e233f3ecc85"},"message":"Create script","createdAt":"2026-09-26T17:21:42.501Z"}],"comments":[{"_id":"6ab83a56db9633922bffa2c8","commentBy":{"_id":"666dba6eb68e80a6c3ce56f9","username