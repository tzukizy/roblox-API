{"slug":"Universal-Script-Print-Current-Speed-45733","_id":"687e298938053ccced5d0987","title":"Print Current Speed","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":0},"features":"Maybe Helpful when making a script.","tags":["Grow a Garden","Forsaken","Speed","Print"],"script":"local player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal lastPosition = rootPart.Position\n\nwhile true do\n    wait(0.5)\n    local currentPosition = rootPart.Position\n    local distance = (currentPosition - lastPosition).Magnitude\n    local speed = distance / 0.5\n\n    if speed > 0 then\n        print(\"Current Speed: \" .. math.floor(speed))\n    end\n\n    lastPosition = currentPosition\nend","owner":{"_id":"6770e9d05213f1918bcc81cf","username":"ScripterCoder","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/de9c829cded539a151f617c26f6bd0b8e2c6f693d493573daf5c05d5fb0a6c48.webp","original":"https://scriptblox.com/images/photo/6770e9d05213f1918bcc81cf-1735453216660.png"},"status":"offline","id":"6770e9d05213f1918bcc81cf","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/de9c829cded539a151f617c26f6bd0b8e2c6f693d493573daf5c05d5fb0a6c48.webp","original":"https://scriptblox.com/images/photo/6770e9d05213f1918bcc81cf-1735453216660.png"}},"verified":false,"views":11891,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/05bc12dd1dfc1e255d63abeb4edefc2296d8fa6cbadfbd425e1d9602be8d3280.webp","original":"https://scriptblox.com/images/sb/0-1753098633026.png","scriptblox":"https://scriptblox.com/images/script/0-1753098633026.png"},"likeCount":