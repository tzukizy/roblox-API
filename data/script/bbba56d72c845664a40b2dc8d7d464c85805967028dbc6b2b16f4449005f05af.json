{"slug":"Slime-Incremental:-Revived-Auto-Collector-242255","_id":"6a512b168fddf2c57938f104","title":"Auto Collector","game":{"_id":"6a512b168fddf2c57938f103","gameId":132184009107357,"name":"Slime Incremental: Revived","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":132184009107357},"features":"for stop: reset\nmode: snake","tags":["vhs"],"script":"local step = 0.5\n\nlocal rs = game.RunService.RenderStepped\nlocal hrp = game.Players.LocalPlayer.Character.HumanoidRootPart\nlocal b = workspace.World.Map.MainBase\nlocal range = workspace.Collector.Size.Z\nlocal n = b.Size.X / range\nlocal s = range*n*-1/2\nlocal offset = Vector3.new(b.Position.X,0,b.Position.Z)\nwhile task.wait() do\n    for x=0.5,n,step do \n        for z=0.5,n,step do\n            hrp.CFrame = CFrame.new(s+(x*range),3,s+(z*range)) + offset\n            rs:wait()\n        end\n    end\nend\n","owner":{"_id":"66b9f4ca2fb4155fd40add65","username":"VHCK","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/d0edfeac08f938c79017d90334749732b736cf0325b29470d481486b0c28c44f.webp","original":"https://scriptblox.com/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg"},"status":"offline","id":"66b9f4ca2fb4155fd40add65","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/d0edfeac08f938c79017d90334749732b736cf0325b29470d481486b0c28c44f.webp","original":"https://scriptblox.com/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg"}},"verified":false,"views":1529,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/77aa7d3764122fffbe4849fe139ca15f7f99f51aa5e242aefd56db6e04eccc1b.webp","original":"https://scriptblox.com/images/sb/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png","scriptblox":"https://scriptblox.com/images/script/rbx-3f1f59e74c5cc2f3