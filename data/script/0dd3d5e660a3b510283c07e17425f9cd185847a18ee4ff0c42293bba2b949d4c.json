{"slug":"Prison-Life-Skin-guns-18273","_id":"66e505182ca83d896d1f7b96","title":"Skin guns","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":155615604},"features":"Script","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal backpack = player:FindFirstChildOfClass(\"Backpack\") or player:WaitForChild(\"Backpack\")\n\n-- List of guns you want to apply the rainbow color to\nlocal gunsToRainbow = {\"AK-47\", \"M4A1\", \"Remington 870\", \"M9\"}\n\n-- Function to change the color of a gun to a rainbow pattern\nlocal function applyRainbowColor(gun)\n    local hue = 0\n    while gun and gun.Parent do\n        hue = (hue + 0.01) % 1 -- Increase hue slightly each time for rainbow effect\n        local rainbowColor = Color3.fromHSV(hue, 1, 1) -- Create a color based on HSV\n\n        -- Apply the color to all parts of the gun\n        for _, part in ipairs(gun:GetDescendants()) do\n            if part:IsA(\"BasePart\") then\n                part.Color = rainbowColor -- Apply rainbow color\n            end\n        end\n        \n        wait(0.1) -- Delay to make the effect visible\n    end\nend\n\n-- Function to apply the rainbow effect to guns in the player's inventory\nlocal function enableRainbowGuns()\n    for _, gunName in ipairs(gunsToRainbow) do\n        local gun = backpack:FindFirstChild(gunName) or player.Character:FindFirstChild(gunName)\n        \n        if gun then\n            -- Start applying the rainbow effect to the gun\n            spawn(function() applyRainbowColor(gun) end)\n        else\n            print(gunName .. \" is not found in your inventory.\")\n        end\n    end\nend\n\n-- Run the function to apply rainbow color to guns\nenableRainbowGuns()","owner":{"_id":"6623187e5177c415565cf256","username":"Tbao","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ec1fc7ed08080e0710608a8cc6f302c50bde2e78eafa1d0079764a3ec38d69c6.webp","original":"https://scriptblox.com/images/photo/6623187e5177c415565cf256-1730210753112.jpg"},"status":"offline","id":"6623187e5177c415565cf256","leaderboard":{"tag":null},"topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/ec1fc7ed08080e0710608a8cc6f302c50bde2e78eafa1d0079764a3ec38d69c6.webp","original":"https://scriptblox.com/images/photo/6623187e5177c415565cf256-1730210753112.jpg"}},"verified":false,"keyLink":"","views":32228,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-09-14T03:38:00.864Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://media.kocakz.me/6be4d0a4ce92de51e8080a0e2b88abf1c8f0acf4020973c337d48cac8a7e5bf2.webp","original":"https://scriptblox.com/images/sb/155615604-1726285080807.png","scriptblox":"https://scriptblox.com/images/script/155615604-1726285080807.png"},"executes":47,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:15:47.916Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/6be4d0a4ce92de51e8080a0e2b88abf1c8f0acf4020973c337d48cac8a7e5bf2.webp","original":"https://scriptblox.com/images/sb/155615604-1726285080807.png","scriptblox":"https://scriptblox.com/images/script/155615604-1726285080807.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c520fb","editBy":{"_id":"6623187e5177c415565cf256","username":"Tbao","status":"offline","id":"6623187e5177c415565cf256"},"message":"Create script","createdAt":"2025-03-26T20:53:59.233Z"}],"comments":[{"_id":"66e51a8789821a8d1cd09ca0","commentBy":{"_id":"66db084f9305e61b135fc778","username":"Kagasad","verified":false,"role":"user","profilePicture":{"url":"https://medi