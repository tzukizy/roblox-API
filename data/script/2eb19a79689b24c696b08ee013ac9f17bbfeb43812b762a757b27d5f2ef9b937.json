{"_id":"64ed27449905b4f3e494f120","title":"Bypass reach Aura","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/f4859c068f842cf7ae5af079480fc8dc633f3d59ae6df265d16fa0e8f612f242.webp","original":"https://scriptblox.com/images/sb/8839807-1693263684800.webp"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/f4859c068f842cf7ae5af079480fc8dc633f3d59ae6df265d16fa0e8f612f242.webp","original":"https://scriptblox.com/images/sb/8839807-1693263684800.webp"},"placeId":0},"slug":"Universal-Script-Bypass-reach-Aura-7448","verified":false,"key":false,"keyless":false,"views":32261,"executes":524,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/eaf543bc43b46437180e9cf85edd2143e52ad60fa993f16f2bfa9f6002f66320.webp","original":"https://scriptblox.com/images/sb/8839807-1693263684800.webp","scriptblox":"https://scriptblox.com/images/script/8839807-1693263684800.webp"},"thumbnail":{"url":"https://media.kocakz.me/eaf543bc43b46437180e9cf85edd2143e52ad60fa993f16f2bfa9f6002f66320.webp","original":"https://scriptblox.com/images/sb/8839807-1693263684800.webp","scriptblox":"https://scriptblox.com/images/script/8839807-1693263684800.webp"},"likeCount":8,"dislikeCount":4,"createdAt":"2023-08-28T23:01:24.869Z","updatedAt":"2023-08-28T23:01:24.869Z","lastBump":"2023-08-28T23:01:24.869Z","script":"-- Created by  MrOrmsman\n-- Bypass reach aura\n\n-- Define the player\nlocal player = game.Players.LocalPlayer\n\n-- Create the reach aura function\nlocal function createReachAura()\n    -- Create a part to represent the aura\n    local auraPart = Instance.new(\"Part\")\n    auraPart.Name = \"ReachAura\"\n    auraPart.Size = Vector3.new(10, 10, 10)\n    auraPart.Transparency = 0.5\n    auraPart.BrickColor = BrickColor.new(\"Bright red\")\n    auraPart.Anchored = true\n    auraPart.CanCollide = false\n    auraPart.Parent = workspace\n\n    -- Create a proximity prompt to activate the aura\n    local proximityPrompt = Instance.new(\"ProximityPrompt\")\n    proximityPrompt.Name = \"ReachAuraPrompt\"\n    proximityPrompt.ActionText = \"Activate Reach Aura\"\n    proximityPrompt.Parent = auraPart\n\n    -- Define the function to activate the aura\n    local function activateAura()\n        -- Set the player's reach to a high value\n        player.Character.Humanoid.MaxHealth = math.huge\n        player.Character.Humanoid.WalkSpeed = 100\n        player.Character.Humanoid.JumpPower = 100\n        player.Character.Humanoid.HipHeight = 100\n        player.Character.Humanoid.AutoRotate = true\n        player.Character.Humanoid.AutoRotateSpeed = 100\n    end\n\n    -- Connect the proximity prompt to the activateAura function\n    proximityPrompt.Triggered:Connect(activateAura)\nend\n\n-- Call the createReachAura function to create the aura\ncreateReachAura()\n","features":"This is a STFO script, its a bypass reach aura script that I made, It should work for mobile also but if it doesn’t just let me know and Ill fix it, also its universal.","tags":[],"discord":"","keyLink":"","owner":{"_id":"64eb7a6412cc76f69e098cfc","username":"MrOrmsman","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9eb4865d8e78584a4405e354219a1b3248e156426251fc5362110d5d32e6fe88.webp","original":"https://scriptblox.com/images/photo/64eb7a6412cc76f69e098cfc-1693154231895.jpeg"},"status":"offline","id":"64eb7a6412cc76f69e098cfc","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/9eb4865d8e78584a4405e354219a1b3248e156426251fc5362110d5d32e6fe88.webp","original":"https://scriptblox.com/images/photo/64eb7a6412cc76f69e098cfc-1693154231895.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:19:18