{"slug":"Fling-Things-and-People-Modified-Script-to-fling-Working-80545","_id":"6955c91594fc9ca97642626c","title":"Modified Script to fling (KEYLESS)","game":{"_id":"67e5e1ffb360710ec3c77d21","gameId":6961824067,"name":"Fling Things and People","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":6961824067},"features":"Just A Toggle Button","tags":[],"script":"local Workspace = game:GetService(\"Workspace\")\nlocal Debris = game:GetService(\"Debris\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal strength = 470\nlocal fling = false\n\n-- Create toggle button\nlocal ScreenGui = Instance.new(\"ScreenGui\")\nScreenGui.Parent = game.Players.LocalPlayer.PlayerGui\nlocal ToggleButton = Instance.new(\"TextButton\")\nToggleButton.Size = UDim2.new(0, 110, 0.04, 25)\nToggleButton.Position = UDim2.new(0.5, -60, 0.14, -15) -- Centered\nToggleButton.Text = \"Fling: OFF\"\nToggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Red when OFF\nToggleButton.Parent = ScreenGui\n\nToggleButton.MouseButton1Click:Connect(function()\n    fling = not fling\n    ToggleButton.Text = fling and \"Fling: ON\" or \"Fling: OFF\"\n    ToggleButton.BackgroundColor3 = fling and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0) -- Green when ON, Red when OFF\nend)\n\n-- Original script\nWorkspace.ChildAdded:Connect(function(model)\n    if model.Name == \"GrabParts\" then\n        local partInfo = model:FindFirstChild(\"GrabPart\")\n        if not partInfo then return end\n        local weld = partInfo:FindFirstChild(\"WeldConstraint\")\n        if not weld or not weld.Part1 then return end\n        local part = weld.Part1\n        local velocity = Instance.new(\"BodyVelocity\")\n        velocity.Parent = part\n        model:GetPropertyChangedSignal(\"Parent\"):Connect(function()\n            if not model.Parent then\n                if fling then\n                    velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)\n                    velocity.Velocity = Workspace.CurrentCamera.CFrame.LookVector * strength\n                else\n                    velocity.MaxForce = Vector3.zero\n                end\n                Debris:AddItem(velocity, 1)\n            end\n        end)\n    end\nend)\n","owner":{"_id":"694100247e26aa60fbcec48e","username":"NEWSCRIPTCREATOR","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"694100247e26aa60fbcec48e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":8416,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/0ae06cbee98cc228b736f914d7ff5b12ccd9a2aa574836d8a15af6667f9f572f.webp","original":"https://scriptblox.com/images/sb/rbx-9ceb24935041a588b60d214884597291-4ae73e844ce1.png","scriptblox":"https://scriptblox.com/images/script/rbx-9ceb24935041a588b60d214884597291-4ae73e844ce1.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-01-01T01:08:37.112Z","keyLink":"","executes":3170,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:23:24.791Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/0ae06cbee98cc228b736f914d7ff5b12ccd9a2aa574836d8a15af6667f9f572f.webp","original":"https://scriptblox.com/images/sb/rbx-9ceb24935041a588b60d214884597291-4ae73e844ce1.png","scriptblox":"https://scriptblox.com/images/script/rbx-9ceb24935041a588b60d214884597291-4ae73e844ce1.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6955c91594fc9ca97642626f","editBy":{"_id":"694100247e26aa60fbcec48e","username":"NEWSCRIPTCREATOR","status":"offline","id":"694100247e26aa60fbcec48e"},"message":"Create 