{"slug":"Universal-Script-Luarmor-like-loading-ig-18152","_id":"66e1ac58876ad57d7a36c658","title":"Luarmor like loading ig","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"Using my \"Change output color module\" you can achieve a similar loading like Luarmor.\n\nNow note that this is only a fake loading with just repeats 50 times and takes the interger times 2 to minimize the loading symbol and make it clean.\n\nHow to use it?\n\nModules.LoadingBar(\"Your watermark\",\"Color of choice from the color table that will be changed into once the loading is completed\",wait time between every symbol, your symbol of choice)","tags":[],"script":"local Modules = {\n    Colors =  {\n        [\"Green\"] = \"0,255,0\", \n        [\"Cyan\"] = \"33, 161, 163\",\n        [\"White\"] = \"255,255,255\",\n\t\t[\"Pink\"] = \"255, 102, 153\",\n    },\n    Services = {\n        RunService = game:GetService(\"RunService\"),\n        CoreGui = game:GetService(\"CoreGui\")\n    }\n}\n\nModules.ChangeColor = function() \n    local Loop;\n    Loop = Modules.Services.RunService.Heartbeat:Connect(function()\n        local success,err = pcall(function()\n            for index,label in pairs(Modules.Services.CoreGui:FindFirstChild(\"DevConsoleMaster\"):GetDescendants()) do \n                if label:IsA(\"TextLabel\") then \n                    label.RichText = true \n                end \n            end \n        end)\n\n        if not success then \n            warn(`A error occured {err}`)\n            Loop:Disconnect()\n        end \n    end)\nend\n\nModules.LoadingBar = function(watermark,color, delay,loadingsymbol)\n    delay = delay or 0.1 \n\n    local Text = watermark..tostring(math.random(500,20000))\n\n    print(Text)\n\n    local loadingLabel = nil\n    local progress = \"\"\n\n    repeat task.wait()\n        for index,label in pairs(Modules.Services.CoreGui:FindFirstChild(\"DevConsoleMaster\"):GetDescendants()) do \n             if label:IsA(\"TextLabel\") and string.find(label.Text:lower(),Text:lower()) then \n                loadingLabel = label \n\t\t\t\tbreak\n            end \n        end \n    until loadingLabel\n\n    local start = os.time()\n\n    for i = 1, 50 do\n        progress = progress .. loadingsymbol\n        loadingLabel.Text = string.format(\"<font color='rgb(%s)' size='15'>[%s] [%d%% loaded] %s</font>\", Modules.Colors[\"White\"],watermark, i*2, progress)\n        task.wait(delay)\n    end\n\n    loadingLabel.Text = string.format(\"<font color='rgb(%s)' size='15'>[%s] Successfully loaded in %ds</font>\", Modules.Colors[color],watermark, os.time() - start)\nend\n\nModules.ChangeColor()\n\nModules.LoadingBar(\"Your watermark\",\"Green\", 0.001,\"#\")","owner":{"_id":"621948ecb61fc7cb55b28136","username":"Verified","verified":true,"profilePicture":{"url":"https://media.kocakz.me/58e1821d776058c4a51a117e899765afbe964c8a57de229da841a40d75801dd2.webp","original":"https://scriptblox.com/images/photo/621948ecb61fc7cb55b28136-1726054933516.png"},"status":"offline","id":"621948ecb61fc7cb55b28136","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/58e1821d776058c4a51a117e899765afbe964c8a57de229da841a40d75801dd2.webp","original":"https://scriptblox.com/images/photo/621948ecb61fc7cb55b28136-1726054933516.png"}},"verified":false,"keyLink":"","views":74872,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","createdAt":"2024-09-11T14:42:32.056Z","dislikeCount":0,"likeCount":3,"image":{"url":"https://media.kocakz.me/69bdb4328e68b8198aa543a9979dd12a5afba2f5477dc21d37d9e9d3b8cabeff.webp","original":"https://scriptblox.com/images/sb/8891031-1726065751986.png","scriptblox":"https://scriptblox.com/images/script/8891031-1726065751986.png"},"executes":51,"keyless":false,"lik