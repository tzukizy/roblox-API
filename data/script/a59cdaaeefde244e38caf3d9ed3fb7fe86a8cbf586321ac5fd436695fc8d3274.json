cal input = game:GetService(\"VirtualInputManager\")\n                input:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n                task.wait(0.1)\n                input:SendMouseButtonEvent(0, 0, 0, false, game, 0)\n            end\n        end\n    end\n    running = false\nend\n\nlocal function monitor()\n    gui:GetPropertyChangedSignal(\"Enabled\"):Connect(function()\n        if gui.Enabled then\n            autoClicking = true\n            if not running then\n                task.spawn(click)\n            end\n        else\n            autoClicking = false\n        end\n    end)\nend\n\nmonitor()\n","features":"just an autocrack only pc","tags":["crack it","aut","autfarm","autofarm","farm"],"discord":"","keyLink":"","owner":{"_id":"66f57fd5d56dd8085a8b51e3","username":"Zous","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff435566a18.webp","original":"https://scriptblox.com/images/photo/66f57fd5d56dd8085a8b51e3-1729628668273.png"},"status":"offline","id":"66f57fd5d56dd8085a8b51e3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff435566a18.webp","original":"https://scriptblox.com/images/photo/66f57fd5d56dd8085a8b51e3-1729628668273.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:15:13.155Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53e41","editBy":{"_id":"66f57fd5d56dd8085a8b51e3","username":"Zous","status":"offline","id":"66f57fd5d56dd8085a8b51e3"},"message":"Create script","createdAt":"2025-03-27T21:17:52.770Z"}],"comments":[{"_id":"6776928321958b1e79ed2171","commentBy":{"_id":"677690609fda94125e3f81bc","username":"BARCODE69","verified":false,"role":"user","profilePictu