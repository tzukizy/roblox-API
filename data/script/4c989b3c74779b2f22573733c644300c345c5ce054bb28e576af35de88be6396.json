tom Saturation\n+ Saturation Density Slider\n+ Skybox Changer\n+ Skybox Dropdown\n+ Body Modifier\n+ Material Dropdown\n+ Material Color\n\nESP\n+ Vault ESP\n+ Max Highlights Slider\n+ Use Custom Fill Color\n\nBugfixes/Changes\nESP is now separated into a tab box for players and instances, you can have settings for players and for instances.\nAll visuals related things are now in a completely separate tab for organization\nAnti-Fail Generator should no longer cause any issues (thanks @Zero )\nAuto Perfect Skill Check should be fully fixed","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/TexRBLX/Roblox-stuff/refs/heads/main/violence-district/script.lua\"))()","owner":{"_id":"61db2722891d6640f94a0446","username":"TexRBLX","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"61db2722891d6640f94a0446","leaderboard":{"tag":null},"topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":1734388,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-c86cb629cd700ae866c80a4cb34ac437-68b7bd1316ab.png","likeCount":22,"dislikeCount":11,"createdAt":"2025-09-07T21:32:20.659Z","keyLink":"","executes":4828,"keyless":false,"milestones":[{"key":"script.views","tier":1000000,"value":1732624,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68bdf9e421179b3d37b0b3ec","editBy":{"_id":"61db2722891d6640f94a0446","username":"TexRBLX","status":"offline","id":"61db2722891d6640f94a0446"},"message":"Create script","createdAt":"2025-09-07T21:32:20.664Z"}],"comments":[{"_id":"68be1ac3b327a7225b28a903","commentBy":{"_id":"622675c0a476a5e7b39c3f20","username":"Onzabirr","verified":false,"role":"user","profilePicture":"/images/photo/622675c0a476a5e7b39c3f20-1697601454929.PNG","createdAt":"2022-03-07T21:14:40.043Z","lastActive":"2026-10-07T21:33:19.005Z","status":"offline","id":"622675c0a476a5e7b39c3f