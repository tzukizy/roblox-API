{"slug":"generic-roleplay-gaem.-DEMOCRACY-Opscripts-Annoy-people-and-troll-68012","_id":"691ecdb3bcbe6fda56f3b1aa","title":"Opscripts Annoy people and troll","game":{"_id":"67e5e1ffb360710ec3c7853f","gameId":4598019433,"name":"generic roleplay gaem.","imageUrl":"/images/sb/rbx-948c5286bcc855c76a6ee962cd0c4686-504c319ef40d.png","placeId":4598019433},"features":"Remove ac - removes a ac\nAnnoy all near - In beta, sometimes bugs. Fixes soon\nMore soon","tags":["annoy","gng","genericrpgame","funny","troll"],"script":"local Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua\"))()\nlocal Window = Library.CreateLib(\"OpScripts - Generic Roleplay Game\", \"DarkTheme\")\nlocal Tab = Window:NewTab(\"Main\")\nlocal Section = Tab:NewSection(\"Main\")\n\nSection:NewButton(\"Remove Ac\", \"Removes a ac\", function()\n    local lp = game.Players.LocalPlayer\n    local ch = lp.Character or lp.CharacterAdded:Wait()\n    local ac1 = ch:WaitForChild(\"Slow\", 1)\n    if ac1 then\n        ac1:Destroy()\n    end\nend)\n\nlocal at = false\nSection:NewToggle(\"Annoy all near\", \"Annoys all near u\", function(state)\n    at = state\n    if state then\n        task.spawn(function()\n            local lp = game.Players.LocalPlayer\n            while at do\n                local ch = lp.Character or lp.CharacterAdded:Wait()\n                local Head = ch:WaitForChild(\"Head\")\n                local ServerSoundEvent = ch:WaitForChild(\"ServerSoundEvent\")\n\n                for _, sound in pairs(Head:GetChildren()) do\n                    if sound:IsA(\"Sound\") then\n                        ServerSoundEvent:FireServer(sound, \"Play\")\n                    end\n                end\n\n                task.wait(0.01)\n\n\t\t\t\tif not ch.Parent then\n                    lp.CharacterAdded:Wait()\n                end\n            end\n        end)\n    end\nend)\n","owner":{"_id":"683aa0380f380c18ee525781","username":"scripter132","veri