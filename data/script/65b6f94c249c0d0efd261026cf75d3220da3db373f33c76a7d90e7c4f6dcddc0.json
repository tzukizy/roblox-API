{"_id":"6829af1298835820e6f39d00","title":"ServerHop","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/2a7ff5a87b7a27f08d8d9d36d40b5ec4cd758a99277fcb78539ddd2e6e25b263.webp","original":"https://scriptblox.com/images/sb/0-1747562258664.png"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/2a7ff5a87b7a27f08d8d9d36d40b5ec4cd758a99277fcb78539ddd2e6e25b263.webp","original":"https://scriptblox.com/images/sb/0-1747562258664.png"},"placeId":0},"slug":"Universal-Script-ServerHop-40200","verified":true,"key":false,"keyless":false,"views":43690,"executes":1316,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/fb96a1e19546aa9a05bdb7d9e74315ee0c393b0dcb5afdce88d99cb3dc70d3b3.webp","original":"https://scriptblox.com/images/sb/0-1747562258664.png","scriptblox":"https://scriptblox.com/images/script/0-1747562258664.png"},"thumbnail":{"url":"https://media.kocakz.me/fb96a1e19546aa9a05bdb7d9e74315ee0c393b0dcb5afdce88d99cb3dc70d3b3.webp","original":"https://scriptblox.com/images/sb/0-1747562258664.png","scriptblox":"https://scriptblox.com/images/script/0-1747562258664.png"},"likeCount":0,"dislikeCount":25,"createdAt":"2025-05-18T09:57:38.706Z","updatedAt":"2025-05-18T09:57:38.706Z","lastBump":"2025-05-18T09:57:38.706Z","script":"local IGNORE_FILE = \"ServerHop.txt\"\nlocal HOUR = 3600\n\nlocal Module = {}\n\nlocal HttpService, TeleportService = game:GetService\"HttpService\", game:GetService\"TeleportService\"\n\nlocal function GET()\n    if not isfile(IGNORE_FILE) then return {} end\n    local list = {}\n    local now = os.time()\n    for _, line in next, readfile(IGNORE_FILE):split(\"\\n\") do\n        local pmo, ts = line:match(\"([^|]+)|?(%d*)\")\n        ts = tonumber(ts) or 0\n        if now - ts < HOUR then list[pmo] = ts end\n    end\n    return list\nend\n\nlocal function Update(List)\n    local sybau = {}\n    for ts, pmo in next, List do\n        table.insert(sybau, ts .. \"|\" .. pmo)\n    end\n    writefile(IGNORE_FILE, table.concat(sybau, \"\\n\"))\nend\n\nlocal IgnoredServers = GET()\n\nfunction Module:GetServers(Sort)\n    Sort = Sort or { ping = true, fps = false, asc = false }\n    \n    local cursor = \"\"\n    while true do\n        local success, result = pcall(function()\n            return HttpService:JSONDecode(game:HttpGet(`https://games.roblox.com/v1/games/{game.PlaceId}/servers/Public?limit=100&sortOrder={(Sort.asc and \"Asc\" or \"Desc\")}&excludeFullGames=true&cursor={cursor}`))\n        end)\n        \n        if not success or not result or not result.data then error(\"server error (not success or no result or no data)\") end\n\n        local ServersList = result.data\n\n        table.sort(ServersList, function(a, b)\n            if Sort.ping and Sort.fps then\n                return a.ping == b.ping and a.fps > b.fps or a.ping < b.ping\n            elseif Sort.ping then\n                return a.ping < b.ping\n            elseif Sort.fps then\n                return a.fps > b.fps\n            end\n        end)\n\n        for _, Server in next, ServersList do\n            if not IgnoredServers[Server.id] then\n                IgnoredServers[Server.id] = os.time()\n                Update(IgnoredServers)\n\n                return TeleportService:TeleportToPlaceInstance(game.PlaceId, Server.id, game:GetService(\"Players\").LocalPlayer)\n            end\n        end\n\n        assert(result.nextPageCursor, \"No server found.\")\n\n        cursor = result.nextPageCursor\n    end\nend\n\nreturn Module","features":"Optimized & Customizable universal server hop!\n\nThis script lets you choose the server you wanna server hop to, For example:\nHighest FPS, Lowest Ping, Lowest Players, ...\n\nI don't think I will be updating this any time soon, Feel free to fork it or remake or use publicly.","tags":["serverhop","free","optimized"],"discord":"https://discord.gg/aqfudJEEeE","keyLink":"","owner":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"profilePicture":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"},"status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13469173}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:58:37.268Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6829af1298835820e6f39d02","editBy":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","status":"offline","id":"64cb81f82512701e9a163c00"},"message":"Create script","createdAt":"2025-05-18T09:57:38.708Z"}],"comments":[{"_id":"6829b0b00b330be0e069dd81","commentBy":{"_id":"663647799f6b1fc4e47adf51","username":"ZERETET","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/8c00a5d88cfda1116c43d97eb78062b7947cd4f3f479d0a34a81258f79e053ac.webp","original":"https://scriptblox.com/images/photo/663647799f6b1fc4e47adf51-1748065294571.jpg"},"createdAt":"2024-05-04T14:34:33.204Z","lastActive":"2026-09-10T00:44:04.046Z","status":"offline","id":"663647799f6b1fc4e47adf51","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/8c00a5d88cfda1116c43d97eb78062b7947cd4f3f479d0a34a81258f79e053ac.webp","original":"https://scriptblox.com/images/photo/663647799f6b1fc4e47adf51-1748065294571