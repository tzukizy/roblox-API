rrentLine,\n  ['Source'] = Source,\n  ['name'] = tostring(name),\n  ['numparams'] = tonumber(numparams),\n  ['is_vararg'] = isvrg and 1 or 0,\n  ['short_src'] = tostring(Source:sub(1, 60))\n  }\nend\nreturn dbg","features":"Adds 2 missing functions from level 2 / 3 executors (debug.getinfo, getcallingscript)\nThis is super basic.","tags":[],"discord":"","keyLink":"","owner":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","verified":true,"profilePicture":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"},"status":"offline","id":"64cb81f82512701e9a163c00","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"views","value":13469934}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/57b01f7cde61e97952d99b0bb7515e77aecd38d63bc30d2bb88ae64dcb16358f.webp","original":"https://scriptblox.com/images/photo/64cb81f82512701e9a163c00-1699804719964.gif"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:11:59.030Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50b98","editBy":{"_id":"64cb81f82512701e9a163c00","username":"vxsty","status":"offline","id":"64cb81f82512701e9a163c00"},"message":"Create script","createdAt":"2025-03-27T22:51:55.613Z"}],"comments":[{"_id":"66312c14ecc5cf277a57ecbe","commentBy":{"_id":"66312bf197010bfcb230d6e2","username":"shenzeuliyle","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/64fe4958b74e5d46947fb3ee4b9954218a247ebb018a2e3765cc7d4d78367bcb.webp","original":"https://scriptblox.com/images/photo/66312bf197010bfcb230d6e2-1719227128762.jpg"},"createdAt":"2024-04-30T17:35:45.415Z","lastActive":"2024-07-10T13