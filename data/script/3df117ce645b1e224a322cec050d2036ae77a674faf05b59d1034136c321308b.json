{"_id":"69b4840dd7650ff13189e5e6","title":"AIMBOT OPEN SOURSE","game":{"_id":"67e5e1ffb360710ec3c77d59","gameId":17625359962,"name":"[🎃] RIVALS","imageUrl":{"url":"https://media.kocakz.me/c63f148d9f47d6f6e8544ab6423e581017e150ada16e8954529cdfbe5e45467f.webp","original":"https://tr.rbxcdn.com/180DAY-b2b718b190726ac0e498f3fd3afc30d9/150/150/Image/Png/noFilter"},"slug":"17625359962-rivals","path":"/game/17625359962-rivals","thumbnail":{"url":"https://media.kocakz.me/c63f148d9f47d6f6e8544ab6423e581017e150ada16e8954529cdfbe5e45467f.webp","original":"https://tr.rbxcdn.com/180DAY-b2b718b190726ac0e498f3fd3afc30d9/150/150/Image/Png/noFilter"},"placeId":17625359962},"slug":"RIVALS-AIMBOT-OPEN-SOURSE-138736","verified":false,"key":false,"keyless":false,"views":5291,"executes":14746,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/93a9c62386edf2841ca903a39088f8959c9f7c9e2c09ff65e5a03acf5e52fe75.webp","original":"https://scriptblox.com/images/sb/17625359962-1773437965563.png","scriptblox":"https://scriptblox.com/images/script/17625359962-1773437965563.png"},"thumbnail":{"url":"https://media.kocakz.me/93a9c62386edf2841ca903a39088f8959c9f7c9e2c09ff65e5a03acf5e52fe75.webp","original":"https://scriptblox.com/images/sb/17625359962-1773437965563.png","scriptblox":"https://scriptblox.com/images/script/17625359962-1773437965563.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-13T21:39:25.582Z","updatedAt":"2026-03-13T21:39:25.582Z","lastBump":"2026-03-13T21:39:25.582Z","script":"\n-- We update scripts everyday make sure to join\n-- Join the discord https://discord.gg/9RPtJvHVGz\nlocal plrs = game:GetService(\"Players\")\nlocal rs = game:GetService(\"RunService\")\nlocal uis = game:GetService(\"UserInputService\")\nlocal lp = plrs.LocalPlayer\nlocal cam = workspace.CurrentCamera\n\n\n-- config\ngetgenv().Aimbot = true\ngetgenv().Smoothness = 1\ngetgenv().FOV = 600\n\n\n-- fov circle setup\nlocal circle = Drawing.new(\"Circle\")\ncircle.Thickness = 2\ncircle.Visible = true\ncircle.Color = Color3.fromRGB(255, 50, 50)\ncircle.Transparency = 0.5\n\n\nlocal function get_target()\n    local target = nil\n    local dist = getgenv().FOV\n    local mouse = uis:GetMouseLocation()\n\n\n    for _, v in pairs(plrs:GetPlayers()) do\n        -- make sure they aren't us and they are actually alive\n        if v ~= lp and v.Character and v.Character:FindFirstChild(\"Humanoid\") and v.Character.Humanoid.Health > 0 then\n            \n            -- check for head hitboxes first, then normal head\n            local part = v.Character:FindFirstChild(\"HeadHB\") or v.Character:FindFirstChild(\"Head\") or v.Character:FindFirstChild(\"UpperTorso\")\n            \n            if part then\n                local pos, on_screen = cam:WorldToViewportPoint(part.Position)\n                \n                if on_screen then\n                    local mag = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude\n                    \n                    if mag < dist then\n                        dist = mag\n                        target = part\n                    end\n                end\n            end\n        end\n    end\n    return target\nend\n\n\n-- main loop\nrs.RenderStepped:Connect(function()\n    circle.Visible = getgenv().Aimbot\n    circle.Radius = getgenv().FOV\n    circle.Position = uis:GetMouseLocation()\n\n\n    -- checking for right click hold\n    if uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and getgenv().Aimbot then -- change MouseButton2 to anything else if you don't want to lock with holding right click\n        local target = get_target()\n        \n        if target then\n            local pos, _ = cam:WorldToViewportPoint(target.Position)\n            local mouse_loc = uis:GetMouseLocation()\n            \n            -- calculate relative movement\n            local x = (pos.X - mouse_loc.X) * getgenv().Smoothness\n            local y = (pos.Y - mouse_loc.Y) * getgenv().Smoothness\n            \n            -- move mouse\n            if mousemoverel then\n                mousemoverel(x, y)\n            end\n        end\n    end\nend)\n\n\n-- Made by Dmonds tweaked by InterGalactic\n","features":"Aimbot and WALLS","tags":["rivals","undetected","hub","rivals keyless","keyless"],"discord":"https://discord.gg/9RPtJvHVGz","keyLink":"","owner":{"_id":"699e38b5f7f7fbed06ad476c","username":"Z3USISBAK","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"699e38b5f7f7fbed06ad476c","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:06:52.780Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69b4840dd7650ff13189e5e9","editBy":{"_id":"699e38b5f7f7fbed06ad476c","username":"Z3USISBAK","status":"offline","id":"699e38b5f7f7fbed06ad476c"},"message":"Create script","createdAt":"2026-03-13T21:39:25.584Z"}],"comments":[{"_id":"69b5407f88a9c0cf642ef466","commentBy":{"_id":"690fc8fdebc71de43501895d","username":"kaisertechs","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/519f983a16b415ebfe6ebd101a5fc44aa6d8727d135f66350c9167be488d8769.webp","original":"https://scriptblox.com/images/photo/690fc8fdebc71de43501895d-1762642311791.png"},"lastActive":"2026-03-22T14:09:46.648Z","createdAt":"2025-11-08T22:49:33.906Z","status":"offline","id":"690fc8fdebc71de43501895d","profile":{"url":"https://media.kocakz.me/519f983a16b415ebfe6ebd101a5fc44aa6d8727d135f66350c9167be488d8769.webp","original":"https://scriptblox.com/images/photo/690fc8fdebc71de43501895d-1762642311791.png"}},"text":"it works so good i appreciate it!","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"20