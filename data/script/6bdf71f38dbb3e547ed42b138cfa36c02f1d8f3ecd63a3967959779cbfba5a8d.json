e,\n    LoadingSubtitle = \".gg/renderintents\",\n    Discord = {\n       Enabled = false,\n       Invite = \"renderintents\",\n       RememberJoins = true\n    }\n})\n\nlocal tycoon\nfor i,v in pairs(workspace:GetDescendants()) do\n    if v.Name == \"Owner\" and v:IsA(\"StringValue\") and v.Value == game.Players.LocalPlayer.Name then\n        tycoon = v.Parent\n\t\tRayfield:Notify({\n\t\t\tTitle = \"We have located your tycoon.\",\n\t\t\tContent = \"You can now use Infinite money and autobutton.\",\n\t\t\tDuration = 5,\n\t\t\tImage = \"rewind\",\n\t\t })\n\t\tbreak\n    end\nend\nlocal fastbreak = false\nlocal maintab = Window:CreateTab(\"Main\", 13350832775)\nlocal Button = maintab:CreateButton({\n\tName = \"Infinite Money\",\n\tCallback = function()\n\t\tlocal suc, res = pcall(function()\n\t\t\treturn tycoon.Bought.CollectATM.CollectStep\n\t\tend)\n\t\tif not suc then\n\t\t\tRayfield:Notify({\n\t\t\t\tTitle = \"Infinite Money\",\n\t\t\t\tContent = \"You need to have the ATM unlocked.\",\n\t\t\t\tDuration = 2.5,\n\t\t\t\tImage = \"axe\",\n\t\t\t })\n\t\t\treturn\n\t\tend\n\t\tgame:GetService(\"ReplicatedStorage\"):WaitForChild(\"CollectItem\"):FireServer(5e14, tycoon.Bought.CollectATM)\n\t\tfiretouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, tycoon.Bought.CollectATM.CollectStep, 0)\n\t\ttask.wait(0.02)\n\t\tfiretouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, tycoon.Bought.CollectATM.CollectStep, 1)\n\t\tRayfield:Notify({\n\t\t\tTitle = \"Infinite Money\",\n\t\t\tContent = \"Given money.\",\n\t\t\tDuration = 2.5,\n\t\t\tImage = \"axe\",\n\t\t })\n\tend,\n })\nlocal autoButton = maintab:CreateToggle({\n    Name = \"Auto Button\",\n    CurrentValue = false,\n    Flag = \"autoButton\",\n    Callback = function(state)\n        autoButton = state\n        if autoButton then\n            task.spawn(function()\n                while autoButton do\n                    for i,v in pairs(tycoon.Buttons:GetChildren()) do\n\t\t\t\t\t\tif v.Name == \"Button\" then\n\t\t\t\t\t\t\tfiretouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v, 0)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\ttask.wait(0.4)\n                end\n            end)\n        end\n    end\n})","features":"-Infinite money (you need to get the ATM, which is free)\n-Autobuy buttons","tags":["OP","Infinite","money","Autobuy","Rayfield"],"discord":"","keyLink":"","owner":{"_id":"622169daab4b208e46f37c86","username":"relevant","verified":false,"profilePicture":{"url":"https://media.kocakz.me/158c956ebcff886da32c6426962518612a1de6fab96a7840a7537c618606c212.webp","original":"https://scriptblox.com/images/photo/622169daab4b208e46f37c86-1693311171897.png"},"status":"offline","id":"622169daab4b208e46f37c86","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/158c956ebcff886da32c6426962518612a1de6fab96a7840a7537c618606c212.webp","original":"https://scriptblox.com/images/photo/622169daab4b208e46f37c86-1693311171897.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:07:21.552Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53d45","editBy":{"_id":"622169daab4b208e46f37c86","username":"relevant","status":"offline","id":"622169daab4b208e46f37c86"},"message":"Create script","createdAt":"2025-03-27T20:56:02.441Z"}],"comments":[{"_id":"677268dfd9463bc8cce31cae","commentBy":{"_id":"676d3124021ed1a13f252ae4","username":"Maska","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-12-26T10:34:12.711Z","lastActive":"2025-07-23T14:18:09.523Z","status":"offline","id":"676d3124021ed1a13f252ae4","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"why the Autobuy buttons not working?","c