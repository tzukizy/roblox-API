:HttpGet(\"https://raw.githubusercontent.com/Pixeluted/adoniscries/main/Source.lua\",true))() -- can replaced with any namecall bypasser\n    print(\"Bypassed Namecall Detection\")\n    local old; old = hookmetamethod(game, \"__namecall\", function(self, ...)\n        local args = {...}\n        local method = getnamecallmethod()\n        if method == \"FireServer\" and self.Name == \"Asynchronous\" then\n            if args[1] == \"HurtSelf\" then\n                args[3] = 0.001 -- dosent fully remove damage\n            elseif args[1] == \"CharHit\" then\n                args[4] = \"Humanoid\"\n            end\n            return old(self, unpack(args))\n        end\n        return old(self, ...)\n    end)\nelse\n    game:GetService(\"Players\").LocalPlayer:Kick(\"Exploit not supported!\")\nend","features":"Yes","tags":["Semi God Mode","God Mode","RECODE something evil will happen","something evil will happen","Delta"],"discord":"","keyLink":"","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:01:15.542Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68496e572ebe6c6ee9c4a90e","editBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","status":"offline","id":