{"_id":"6978e3a7c00de87f03bc0e92","title":"auto start in DB","game":{"_id":"67e5e1ffb360710ec3c77d92","gameId":15002061926,"name":"[UPD] Death Ball","imageUrl":{"url":"https://media.kocakz.me/c971893b367614f77a1562f4585f25f7a9b4f1d4597df6122c6aa3ea447e1a4d.webp","original":"https://tr.rbxcdn.com/180DAY-7c9478c13cac3874f35f736d5db1f2b7/150/150/Image/Png/noFilter"},"slug":"15002061926-death-ball","path":"/game/15002061926-death-ball","thumbnail":{"url":"https://media.kocakz.me/c971893b367614f77a1562f4585f25f7a9b4f1d4597df6122c6aa3ea447e1a4d.webp","original":"https://tr.rbxcdn.com/180DAY-7c9478c13cac3874f35f736d5db1f2b7/150/150/Image/Png/noFilter"},"placeId":15002061926},"slug":"Death-Ball-auto-start-in-DB-93744","verified":false,"key":false,"keyless":false,"views":2131,"executes":1089,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d2310d5beed46080e5e3771c5687aa36118174d3cf4846089576b149e262f468.webp","original":"https://scriptblox.com/images/sb/15002061926-1769530279843.jpg","scriptblox":"https://scriptblox.com/images/script/15002061926-1769530279843.jpg"},"thumbnail":{"url":"https://media.kocakz.me/d2310d5beed46080e5e3771c5687aa36118174d3cf4846089576b149e262f468.webp","original":"https://scriptblox.com/images/sb/15002061926-1769530279843.jpg","scriptblox":"https://scriptblox.com/images/script/15002061926-1769530279843.jpg"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-27T16:11:19.857Z","updatedAt":"2026-01-27T16:11:19.857Z","lastBump":"2026-01-27T16:11:19.857Z","script":"repeat task.wait() until game:IsLoaded()\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\nlocal PlayerGui = player:WaitForChild(\"PlayerGui\")\n\n-- ===== CONFIG =====\nlocal ZONE_POS = Vector3.new(569.09, 284.59, -779.90)\nlocal Y_OFFSET = 3\nlocal CHECK_INTERVAL = 0.8\nlocal INTERMISSION_DELAY = 1.2\nlocal POST_JOIN_COOLDOWN = 6 -- ⛔ khóa TP sau khi vào trận\n-- ==================\n\nlocal lastJoinTime = 0\n\nlocal function getHRP()\n    local char = player.Character or player.CharacterAdded:Wait()\n    return char:WaitForChild(\"HumanoidRootPart\")\nend\n\nlocal function distToZone()\n    return (getHRP().Position - ZONE_POS).Magnitude\nend\n\nlocal function nearZone()\n    return distToZone() < 10\nend\n\nlocal function inArena()\n    -- arena luôn ở RẤT XA zone\n    return distToZone() > 80\nend\n\nlocal function tpToZone()\n    local hrp = getHRP()\n\n    hrp.CFrame = CFrame.new(ZONE_POS + Vector3.new(0, Y_OFFSET, 0))\n    hrp.Anchored = true\n    RunService.Heartbeat:Wait()\n    RunService.Heartbeat:Wait()\n    hrp.Anchored = false\nend\n\n-- check intermission\nlocal function isIntermission()\n    for _, v in ipairs(PlayerGui:GetDescendants()) do\n        if v:IsA(\"TextLabel\") then\n            if string.find(string.upper(v.Text), \"INTERMISSION\") then\n                return true\n            end\n        end\n    end\n    return false\nend\n\n-- phát hiện server vừa TP bạn vào trận\nlocal lastPos = nil\nRunService.Heartbeat:Connect(function()\n    local hrp = getHRP()\n    if lastPos then\n        if (hrp.Position - lastPos).Magnitude > 60 then\n            lastJoinTime = os.clock()\n        end\n    end\n    lastPos = hrp.Position\nend)\n\n-- ===== LOOP CHÍNH =====\ntask.spawn(function()\n    while true do\n        task.wait(CHECK_INTERVAL)\n\n        -- 🚫 nếu đang ở arena thì cấm TP\n        if inArena() then\n            continue\n        end\n\n        -- 🚫 vừa mới vào trận thì cấm TP\n        if os.clock() - lastJoinTime < POST_JOIN_COOLDOWN then\n            continue\n        end\n\n        -- ✅ chỉ TP khi intermission + không ở zone\n        if isIntermission() and not nearZone() then\n            task.wait(INTERMISSION_DELAY)\n            pcall(tpToZone)\n        end\n    end\nend)","features":"auto start in DB","tags":["autostart","deathball","auto","start"],"discord":"","keyLink":"","owner":{"_id":"6952b36a53ead0ca9a7119fb","username":"nhathung","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c3e19df4a657b62d4d12097683e8584150228f0cad53248135e9de747cf01d5e.webp","original":"https://scriptblox.com/images/photo/6952b36a53ead0ca9a7119fb-1769530073304.jpg"},"status":"offline","id":"6952b36a53ead0ca9a7119fb","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/c3e19df4a657b62d4d12097683e8584150228f0cad53248135e9de747cf01d5e.webp","original":"https://scriptblox.com/images/photo/6952b36a53ead0ca9a7119fb-1769530073304.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:45:58.717Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6978e3a7c00de87f03bc0e95","editBy":{"_id":"6952b36a53ead0ca9a7119fb","username":"nhathung","status":"offline","id":"6952b36a53ead0ca9a7119fb"},"message":"Create script","createdAt":"2026-01-27T16:11:19.860Z"}],"comments":[{"_id":"697954a5b582b0f185008cb5","commentBy":{"_id":"694363b25e6c74e9c18ec83e","username":"itsnakashima11","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-02-23T19:39:06.932Z","createdAt":"2025-12-18T02:15:14.579Z","status":"offline","id":"694363b25e6c74e9c18ec83e","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"tested on a new account, got banned in 2 minutes lul","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-28T00:13:25.077Z","liked":false,"disliked":false},{"_id":"6979a8d3424ae5ab0fe8c53b","commentBy":{"_id":"6952b36a53ead0ca9a7119fb","username":"nhathung","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/c3e19df4a657b62d4d12097683e8584150228f0cad53248135e9