{"slug":"Universal-Script-Get-placeid-script-98430","_id":"697f61c2cd5127bc1ca8681c","title":"Get placeid script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1769955778649.jpg","placeId":0},"features":"Does\nJust does\nDoes/does/refs/heads/main/It_Just_Gets_Placeid_And_Generates_Teleportservice_Script","tags":[],"script":"--[[\nNeeds executor that supports:\n- Setclipboard\n- TeleportService(turn off delta's teleport blocking thing)\n That's all, for script development.\n]]--\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal LocalPlayer = Players.LocalPlayer\n\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"PlaceScriptGUI\"\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 400, 0, 150)\nframe.Position = UDim2.new(0.5, -200, 0.5, -75)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.BorderSizePixel = 0\nframe.Parent = screenGui\n\n\nlocal textbox = Instance.new(\"TextBox\")\ntextbox.Size = UDim2.new(1, -20, 0, 80)\ntextbox.Position = UDim2.new(0, 10, 0, 10)\ntextbox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\ntextbox.TextColor3 = Color3.fromRGB(255, 255, 255)\ntextbox.TextWrapped = true\ntextbox.MultiLine = true\ntextbox.ClearTextOnFocus = false\ntextbox.Font = Enum.Font.Code\ntextbox.TextSize = 18\ntextbox.Parent = frame\n\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 100, 0, 40)\nbutton.Position = UDim2.new(0.5, -50, 1, -50)\nbutton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Text = \"Copy\"\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextSize = 20\nbutton.Parent = frame\n\n\nlocal placeId = game.PlaceId\nlocal teleportScript = [[\nlocal TeleportService = game:GetService(\"TeleportService\")\nTeleportService:Teleport(]] .. placeId .. [[)\n]]\n\ntextbox.Text = teleportScript\n\n\nbutton.MouseButton1Click:Connect(function()\n    if setclipboard then\n        setclipboard(textbox.Text)\n    else\n        \n        print(\"ur executor sucks doesnt even support setclipboard\")\n    end\nend)\n","owner":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","verified":false,"profilePicture":"/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg","status":"offline","id":"69336be27540101a4ec9c8cd","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":715,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1769955778649.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2026-02-01T14:22:58.669Z","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"keyLink":"","executes":115,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"697f61c2cd5127bc1ca8681f","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"message":"Create script","createdAt":"2026-02-01T14:22:58.671Z"},{"_id":"697f622961e0064352ba6c2c","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"message":"Update script","createdAt":"2026-02-01T14:24:41.500Z"}],"comments":[{"_id":"697f61d787d3cdd14ef21d30","commentBy":{"_id":"696ec64905a2e087b9116891","username":"prrimesamuraiv","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-02-01T14:43:55.526Z","createdAt":"2026-01-20T00:03:21.158Z","status":"offline","id":"696ec64905a2e087b9116891"},"text":"sjjd","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-01T14:23:19.596Z","liked":false,"disliked":false},{"_i