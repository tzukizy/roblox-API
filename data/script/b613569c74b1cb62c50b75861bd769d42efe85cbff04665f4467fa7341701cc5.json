{"_id":"697f61c2cd5127bc1ca8681c","title":"Get placeid script","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/4057452a9944dea9192a57ed1c0ae9fd392bc745045e6f1c646984c118557a6b.webp","original":"https://scriptblox.com/images/sb/0-1769955778649.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/4057452a9944dea9192a57ed1c0ae9fd392bc745045e6f1c646984c118557a6b.webp","original":"https://scriptblox.com/images/sb/0-1769955778649.jpg"},"placeId":0},"slug":"Universal-Script-Get-placeid-script-98430","verified":false,"key":false,"keyless":false,"views":758,"executes":131,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ee195202ab6737e6572616bc08d6af7ec79098b7600d67c38ced2b3b0267b13f.webp","original":"https://scriptblox.com/images/sb/0-1769955778649.jpg","scriptblox":"https://scriptblox.com/images/script/0-1769955778649.jpg"},"thumbnail":{"url":"https://media.kocakz.me/ee195202ab6737e6572616bc08d6af7ec79098b7600d67c38ced2b3b0267b13f.webp","original":"https://scriptblox.com/images/sb/0-1769955778649.jpg","scriptblox":"https://scriptblox.com/images/script/0-1769955778649.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-01T14:22:58.669Z","updatedAt":"2026-02-01T14:22:58.669Z","lastBump":"2026-02-01T14:22:58.669Z","script":"--[[\nNeeds executor that supports:\n- Setclipboard\n- TeleportService(turn off delta's teleport blocking thing)\n That's all, for script development.\n]]--\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal LocalPlayer = Players.LocalPlayer\n\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"PlaceScriptGUI\"\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 400, 0, 150)\nframe.Position = UDim2.new(0.5, -200, 0.5, -75)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.BorderSizePixel = 0\nframe.Parent = screenGui\n\n\nlocal textbox = Instance.new(\"TextBox\")\ntextbox.Size = UDim2.new(1, -20, 0, 80)\ntextbox.Position = UDim2.new(0, 10, 0, 10)\ntextbox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\ntextbox.TextColor3 = Color3.fromRGB(255, 255, 255)\ntextbox.TextWrapped = true\ntextbox.MultiLine = true\ntextbox.ClearTextOnFocus = false\ntextbox.Font = Enum.Font.Code\ntextbox.TextSize = 18\ntextbox.Parent = frame\n\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 100, 0, 40)\nbutton.Position = UDim2.new(0.5, -50, 1, -50)\nbutton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Text = \"Copy\"\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextSize = 20\nbutton.Parent = frame\n\n\nlocal placeId = game.PlaceId\nlocal teleportScript = [[\nlocal TeleportService = game:GetService(\"TeleportService\")\nTeleportService:Teleport(]] .. placeId .. [[)\n]]\n\ntextbox.Text = teleportScript\n\n\nbutton.MouseButton1Click:Connect(function()\n    if setclipboard then\n        setclipboard(textbox.Text)\n    else\n        \n        print(\"ur executor sucks doesnt even support setclipboard\")\n    end\nend)\n","features":"Does\nJust does\nDoes/does/refs/heads/main/It_Just_Gets_Placeid_And_Generates_Teleportservice_Script","tags":[],"discord":"","keyLink":"","owner":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b7ba4c2307eabe526ae7e7a21def90beed9500b02d5e89229f1e5157ec38eff6.webp","original":"https://scriptblox.com/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg"},"status":"offline","id":"69336be27540101a4ec9c8cd","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/b7ba4c2307eabe526ae7e7a21def90beed9500b02d5e89229f1e5157ec38eff6.webp","original":"https://scriptblox.com/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:41:47.449Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"697f61c2cd5127bc1ca8681f","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"message":"Create script","createdAt":"2026-02-01T14:22:58.671Z"},{"_id":"697f622961e0064352ba6c2c","editBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","status":"offline","id":"69336be27540101a4ec9c8cd"},"message":"Update script","createdAt":"2026-02-01T14:24:41.500Z"}],"comments":[{"_id":"697f61d787d3cdd14ef21d30","commentBy":{"_id":"696ec64905a2e087b9116891","username":"prrimesamuraiv","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-02-01T14:43:55.526Z","createdAt":"2026-01-20T00:03:21.158Z","status":"offline","id":"696ec64905a2e087b9116891","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"sjjd","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-01T14:23:19.596Z","liked":false,"disliked":false},{"_id":"697f623a92a480228443e7c2","commentBy":{"_id":"69336be27540101a4ec9c8cd","username":"Joyful_PizzaPartyl","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b7ba4c2307eabe526ae7e7a21def90beed9500b02d5e89229f1e5157ec38eff6.webp","original":"https://scriptblox.com/images/photo/69336be27540101a4ec9c8cd-1768566278406.jpg"},"lastActive":"2026-03-08T00:35:50.412Z","createdAt":"2025-12-05T23:33:54.390Z","status":"offline","id":"69336be27540101a4ec9c8cd","topMilestone":{"key":"crea