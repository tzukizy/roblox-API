{"slug":"Universal-Script-Macro-Com-69511","_id":"6923d9395c3203f28b703787","title":"Macro Com","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1763957049476.jpg","placeId":0},"features":"COM!","tags":[],"script":"-- Get the Players service\nlocal Players = game:GetService(\"Players\")\n\n-- Get the player\nlocal player = Players.LocalPlayer\n\n-- Get the character\nlocal character = player.Character\n\n-- Check if the character exists\nif character then\n    -- Get the Right Arm\n    local rightArm = character:FindFirstChild(\"Right Arm\") or character:FindFirstChild(\"RightUpperArm\")\n\n    -- Check if the Right Arm exists\n    if rightArm then\n        -- Make the Right Arm very heavy\n        rightArm.CustomPhysicalProperties = PhysicalProperties.new(15, 0.3, 0.3, 1, 0.3)\n    end\nend\n","owner":{"_id":"6916cf4ebba96d4a653be8b0","username":"keiisacutie5","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6916cf4ebba96d4a653be8b0","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":553,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1763957049476.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2025-11-24T04:04:09.493Z","executes":59,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6923d9395c3203f28b703789","editBy":{"_id":"6916cf4ebba96d4a653be8b0","username":"keiisacutie5","status":"offline","id":"6916cf4ebba96d4a653be8b0"},"message":"Create script","createdAt":"2025-11-24T04:04:09.495Z"}],"comments":[{"_id":"692426d3d9c234e8f9f30f76","commentBy":{"_id":"68e0bb6aa45243d60e79a25f","username":"Idkmanijustdontknow","verified":false,"role":"user","profilePicture":"/images/photo/68e0bb6aa45243d60e79a25f-1759558758510.png","createdAt":"2025-10-04T06:15:06.372Z","lastActive":"2026-09-23T16:57:18.764Z","status":"offline","id":"68e0bb6aa45243d6