{"_id":"6826b3747662247f3c814f2a","title":"Clone","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/e599dea3e3fbf5903f383908b1d13e97aa59274f8e03d74e21305c8b746dcf81.webp","original":"https://scriptblox.com/images/sb/0-1747366772310.jpg"},"slug":"universal","path":"/game/universal","thumbnail":{"url":"https://media.kocakz.me/e599dea3e3fbf5903f383908b1d13e97aa59274f8e03d74e21305c8b746dcf81.webp","original":"https://scriptblox.com/images/sb/0-1747366772310.jpg"},"placeId":0},"slug":"Universal-Script-Clone-39886","verified":false,"key":false,"keyless":false,"views":10354,"executes":540,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/3037972895315181ec98abd8e04359721090a8ac944c0bba6974bc95eeefcf19.webp","original":"https://scriptblox.com/images/sb/0-1747366772310.jpg","scriptblox":"https://scriptblox.com/images/script/0-1747366772310.jpg"},"thumbnail":{"url":"https://media.kocakz.me/3037972895315181ec98abd8e04359721090a8ac944c0bba6974bc95eeefcf19.webp","original":"https://scriptblox.com/images/sb/0-1747366772310.jpg","scriptblox":"https://scriptblox.com/images/script/0-1747366772310.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-05-16T03:39:32.373Z","updatedAt":"2025-05-16T03:39:32.373Z","lastBump":"2025-05-16T03:39:32.373Z","script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\n-- Create RemoteEvents for chatting and switching\nlocal cloneChat = Instance.new(\"RemoteEvent\", ReplicatedStorage)\ncloneChat.Name = \"CloneChat\"\n\nlocal switchClone = Instance.new(\"RemoteEvent\", ReplicatedStorage)\nswitchClone.Name = \"SwitchClone\"\n\n-- Store clone info per player\nlocal playerClones = {}\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function(character)\n\t\twait(1)\n\n\t\t-- Clone character\n\t\tlocal clone = character:Clone()\n\t\tclone.Name = player.Name .. \"_Clone\"\n\t\tclone.Parent = workspace\n\n\t\t-- Make parts non-collidable\n\t\tfor _, part in ipairs(clone:GetDescendants()) do\n\t\t\tif part:IsA(\"BasePart\") then\n\t\t\t\tpart.Anchored = true\n\t\t\t\tpart.CanCollide = false\n\t\t\tend\n\t\tend\n\n\t\t-- Add chat label to clone's head\n\t\tlocal cloneHead = clone:FindFirstChild(\"Head\")\n\t\tlocal label\n\t\tif cloneHead then\n\t\t\tlocal gui = Instance.new(\"BillboardGui\", cloneHead)\n\t\t\tgui.Size = UDim2.new(0, 200, 0, 50)\n\t\t\tgui.StudsOffset = Vector3.new(0, 2, 0)\n\t\t\tgui.AlwaysOnTop = true\n\n\t\t\tlabel = Instance.new(\"TextLabel\", gui)\n\t\t\tlabel.Size = UDim2.new(1, 0, 1, 0)\n\t\t\tlabel.BackgroundTransparency = 1\n\t\t\tlabel.TextColor3 = Color3.new(1, 1, 1)\n\t\t\tlabel.TextScaled = true\n\t\t\tlabel.Text = \"\"\n\t\tend\n\n\t\tplayerClones[player] = {\n\t\t\tclone = clone,\n\t\t\toriginal = character,\n\t\t\tchatLabel = label\n\t\t}\n\tend)\nend)\n\n-- Handle clone chatting\ncloneChat.OnServerEvent:Connect(function(player, message)\n\tlocal info = playerClones[player]\n\tif info and info.chatLabel then\n\t\tinfo.chatLabel.Text = message\n\tend\nend)\n\n-- Handle switching character to clone\nswitchClone.OnServerEvent:Connect(function(player)\n\tlocal info = playerClones[player]\n\tif info and info.clone then\n\t\tplayer.Character = info.clone\n\tend\nend)\n\n-- Optional: reset back to original on death or leave\nPlayers.PlayerRemoving:Connect(function(player)\n\tplayerClones[player] = nil\nend)","features":"Clone","tags":["Clone"],"discord":"","keyLink":"","owner":{"_id":"681852ed3d0cbea73e9ca4bc","username":"ryannesumera","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"681852ed3d0cbea73e9ca4bc","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:02:56.611Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6826b3747662247f3c814f2c","editBy":{"_id":"681852ed3d0cbea73e9ca4bc","username":"ryannesumera","status":"offline","id":"681852ed3d0cbea73e9ca4bc"},"message":"Create script","createdAt":"2025-05-16T03:39:32.375Z"}],"comments":[{"_id":"686fdf56b307cc93ad5029b0","commentBy":{"_id":"67dea0a89a7e999f57399bfc","username":"titovvladislav623","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-03-22T11:36:08.850Z","lastActive":"2026-09-03T14:54:52.513Z","status":"offline","id":"67dea0a89a7e999f57399bfc","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"FE?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-10T15:42:14.416Z","liked":false,"disliked":false},{"_id":"69970f134bfacc34695c56dd","commentBy":{"_id":"68bcd87eb61fb790ff62f27e","username":"xxdd666","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/65b7acc93dd7ac0d192d9b8cd9b059d2cc1a7128b8658b063f58a5f7eb735960.webp","original":"https://scriptblox.com/images/photo/68bcd87eb61fb790ff62f27e-1757206699194.png"},"createdAt":"2025-09-07T00:57:34.589Z","lastActive":"2026-06-12T11:45:42.100Z","status":"offline","id":"68bcd87eb61fb790ff62f27e","profile":{"url":"https://media.kocakz.me/65b7acc93dd7ac0d192d9b8cd9b059d2cc1a7128b8658b063f58a5f7eb735960.webp","original":"https://scriptblox.com/images/photo/68bcd87eb61fb790ff62f27e-1757206699194.png"}},"text":"maybe is FE","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-02-19T13:24:35.508Z","liked":false,"disliked":false},{"_id":"699f49e192785be798bdf45f","commentBy":{"_id":"699de63296d3