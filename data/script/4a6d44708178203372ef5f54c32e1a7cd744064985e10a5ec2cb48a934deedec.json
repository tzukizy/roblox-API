bj.Name == \"Projectile\"\n        or obj.Name == \"Fireball\"\n        or obj.Name == \"Iceball\"\n        or obj.Name == \"Table\"\n        or obj.Name == \"RAIGTable\"\n        or obj.Name == \"Pellet\"\n        or obj.Name == \"Soccerball\"\n        or obj.Name == \"BigRocket\"\n        or obj.Name == \"Rocket\"\n        or obj.Name == \"Basketball\"\n        or obj.Name == \"Molotov\"\n        or obj.Name == \"Grenade\"\n        or obj.Name == \"Cesusbomb\"\n        or obj.Name == \"Cesuspot\"\n        or obj.Name == \"LilCesuspot\"\n        or obj.Name == \"Banana\"\n        or obj.Name == \"Pie\"\n        or obj.Name == \"Brew\"\n        or obj.Name == \"Goala\"\n        or obj.Name == \"Cola\"\n        or obj.Name == \"FireTeapot\"\n        or obj.Name == \"Teapot\"\nend\n\nlocal function applyToObject(obj)\n    if isProjectile(obj) then\n        if obj:IsA(\"Model\") then\n            for _, d in ipairs(obj:GetDescendants()) do\n                makeBigger(d)\n            end\n        else\n            makeBigger(obj)\n        end\n    end\nend\n\n-- handle existing objects\nfor _, obj in ipairs(workspace:GetDescendants()) do\n    applyToObject(obj)\nend\n\n-- handle new ones\nworkspace.DescendantAdded:Connect(function(obj)\n    task.wait() -- ensures properties are ready\n    applyToObject(obj)\nend)","features":"Can customized size and name","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a2dae8b59774a9796ab054a","username":"Robloxker","verified":false,"profilePicture":{"url":"https://media.kocakz.me/124bf763a0a837ecd76f1310f983f367d8bc76212fb64ef951ba31794c45710f.webp","original":"https://scriptblox.com/images/photo/6a2dae8b59774a9796ab054a-1788034448386.png"},"status":"offline","id":"6a2dae8b59774a9796ab054a","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/124bf763a0a837ecd76f1310f983f367d8bc76212fb64ef951ba31794c45710f.webp","original":"https://scriptblox.com/images/photo/6a2dae8b59774a9796ab054a-178