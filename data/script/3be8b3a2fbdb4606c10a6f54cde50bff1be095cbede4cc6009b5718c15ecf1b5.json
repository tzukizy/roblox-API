{"slug":"Universal-Script-chat-anti-ban-and-tag-detection-130075","_id":"69aaa02f43eb3299c51e0043","title":"chat anti ban and tag detection","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":0},"features":"execute this in Any Text Chat Service supported game to avoid chat bans upon report","tags":["Anti ban","TextChatService"],"script":"\nif not game:IsLoaded() then\n    game.Loaded:Wait()\nend\nlocal a = (cloneref and cloneref(game:GetService(\"Players\"))) or game:GetService(\"Players\")\nlocal b = (cloneref and cloneref(game:GetService(\"TextChatService\"))) or game:GetService(\"TextChatService\")\nlocal c = (cloneref and cloneref(game:GetService(\"Chat\"))) or game:GetService(\"Chat\")\nlocal d = (cloneref and cloneref(game:GetService(\"CoreGui\"))) or game:GetService(\"CoreGui\")\nlocal e = a.LocalPlayer\nlocal function f()\n    local g = d:FindFirstChild(\"ExperienceChat\")\n    if g then\n        local h = g:FindFirstChild(\"appLayout\")\n        local i = h and h:FindFirstChild(\"chatInputBar\")\n        local j = i and i:FindFirstChild(\"Background\")\n        local k = j and j:FindFirstChild(\"Container\")\n        local l = k and k.TextContainer:FindFirstChild(\"TextBoxContainer\")\n        if l then return l:FindFirstChild(\"TextBox\") end\n    end\n    local m = e:WaitForChild(\"PlayerGui\"):FindFirstChild(\"Chat\")\n    local n = m and m:FindFirstChild(\"Frame\")\n    local o = n and n:FindFirstChild(\"ChatBar\")\n    return o and o:FindFirstChild(\"TextBox\")\nend\nlocal function p(q)\n    local r\n    local s = pcall(function() r = c:FilterStringForBroadcast(q, e) end)\n    return not s or r ~= q\nend\nlocal function t(u)\n    pcall(function() b.TextChannels.RBXGeneral:SendAsync(u) end)\nend\nlocal v = f()\nif v then\n    v.FocusLost:Connect(function(w)\n        if w and v.Text ~= \"\" then\n            local x = v.Text\n            v.Text = \"\"\n            if p(x) then\n                chat(x)\n            else\n                t(x)\n            end\n        end\n    end)\nend\n","owner":{"_id":"69847aa77caac93f6831155e","username":"Mask_real","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"69847aa77caac93f6831155e","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":2085,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/f3edd9b7000e2e757956100350a14c36b84f898c1aa1ef4248cb7eab3ca4f5cc.webp","original":"https://scriptblox.com/images/sb/0-1772789807690.png","scriptblox":"https://scriptblox.com/images/script/0-1772789807690.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-06T09:36:47.701Z","executes":273,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:06:00.143Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"thumbnail":{"url":"https://media.kocakz.me/f3edd9b7000e2e757956100350a14c36b84f898c1aa1ef4248cb7eab3ca4f5cc.webp","original":"https://scriptblox.com/images/sb/0-1772789807690.png","scriptblox":"https://scriptblox.com/images/script/0-1772789807690.png"},"changelog":[{"_id":"69aaa02f43eb3299c51e0046","editBy":{"_id":"69847aa77caac93f6831155e","username":"Mask_real","status":"offline","id":"69847aa77caac93f6831155e"},"message":"Create script","createdAt":"2026-03-06T09:36:47.703Z"}],"comments":[{"_id":"69aab1a61f9615074162fc29","commentBy":{"_id":"69a214d211afc6c1a5012c53","username":"R02R","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-03-27T06:38:44.943Z","createdAt":"2