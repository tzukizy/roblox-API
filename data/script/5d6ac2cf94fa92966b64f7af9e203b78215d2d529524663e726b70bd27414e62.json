ude from transparency\"] = {\n    --[[ example:\n    [\"HumanoidRootPart\"] = true,\n    [\"Left Arm\"] = true\n    ]]\n}\n(function() if getgenv then return getgenv() else return _G end end)().fling = nil\nlocal finished = false\n\ntask.spawn(function()\n        \n     loadstring(game:HttpGet(\"https://gist.githubusercontent.com/lolidkwhy678/1f92d0894e3304be9882126819d54a6d/raw/bd10c958192386ea7db0f8711c865f6fb7faf8c1/CA%2520testing\"))()\nloadstring(game:HttpGet(\"https://gist.githubusercontent.com/lolidkwhy678/8789dcee674b733f339fc9376e512287/raw/0faff48438c6091deb3b3672a430cdfb07417111\"))()\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/gObl00x/My-Scripts/refs/heads/main/Epik%20R6%20Dancezz.lua\"))()\nend)\n\nrepeat task.wait() until finished","owner":{"_id":"67405fa537cbc833320cbbb4","username":"sutartthebacon","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/4b123b21635a8795cae4c3422fc3ab6fc1eb9f09245283695ffcf446816d2c7a.webp","original":"https://scriptblox.com/images/photo/67405fa537cbc833320cbbb4-1759671904424.png"},"status":"offline","id":"67405fa537cbc833320cbbb4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/4b123b21635a8795cae4c3422fc3ab6fc1eb9f09245283695ffcf446816d2c7a.webp","original":"https://scriptblox.com/images/photo/67405fa537cbc833320cbbb4-1759671904424.png"}},"verified":false,"views":8492,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/358e54bcad8d35536caab60682ca5b5f4dcafa73ccc6b7d94f47fb0307a349c6.webp","original":"https://scriptblox.com/images/sb/0-1762450739605.jpg","scriptblox":"https://scriptblox.com/images/script/0-1762450739605.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-06T17:38:59.635Z","executes":454,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":fal