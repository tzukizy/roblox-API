{"slug":"Operation-One-Recoil-modifier-and-Fast-reload-82821","_id":"695e66ff3593559f369f9cc5","title":"Recoil modifier and Fast reload","game":{"_id":"68b85f546ae0b7235eeb4e63","gameId":72920620366355,"name":"[SEASON 3] Operation One","imageUrl":"/images/sb/rbx-041fe8eb0bda4800463411dff7a790d4-93f76ff2e17f.png","placeId":72920620366355},"features":"Uhh reload faster and change how much recoil you have","tags":[],"script":"--// made by chaddestdog and voltara\nlocal RecoilAmt = 50; --// this is the percentage of recoil you want, 100% = full recoil, 0% = no recoil\nlocal FastReload = true;\n\nrun_on_actor(getactors()[1], string.gsub([==[\n    local TweenInfoNew; TweenInfoNew = hookfunction(TweenInfo.new, newcclosure(function(...)\n        if (debug.info(4, 'n') == \"reload_begin\" and typeof(getstack(4, 6)) == \"number\" and FastReload) then\n            setstack(4, 6, (getstack(4, 6) / 1.1));\n        elseif (debug.info(3, 'n') == \"recoil_function\") then\n            setstack(3, 5, (getstack(3, 5) * RecoilAmt));\n            setstack(3, 6, (getstack(3, 6) * RecoilAmt));\n        end;\n        return TweenInfoNew(...);\n    end));\n]==], \"%w+\", {[\"RecoilAmt\"] = RecoilAmt / 100, [\"FastReload\"] = FastReload}));\n","owner":{"_id":"68e7132c9cdba9aed08ebd95","username":"Voltara","verified":false,"profilePicture":"/images/photo/68e7132c9cdba9aed08ebd95-1767794779523.png","status":"offline","id":"68e7132c9cdba9aed08ebd95","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":1836,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-0705c28a69627a5e527514b9c2022581-fb39aefb5256.png","likeCount":3,"dislikeCount":1,"createdAt":"2026-01-07T14:00:31.691Z","executes":126,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"695e66ff3593559f369f9cc8","editBy":{"_id":"68e7132c9cdba9aed08ebd95","username":"Voltara","status":"offline","id":"68e7132c9cdba9ae