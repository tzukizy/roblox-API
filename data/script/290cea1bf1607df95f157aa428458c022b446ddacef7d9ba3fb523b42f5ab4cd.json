{"slug":"Operation-One-Recoil-modifier-and-Fast-reload-82821","_id":"695e66ff3593559f369f9cc5","title":"Recoil modifier and Fast reload","game":{"_id":"68b85f546ae0b7235eeb4e63","gameId":72920620366355,"name":"[ZOMBIES] Operation One","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":72920620366355},"features":"Uhh reload faster and change how much recoil you have","tags":[],"script":"--// made by chaddestdog and voltara\nlocal RecoilAmt = 50; --// this is the percentage of recoil you want, 100% = full recoil, 0% = no recoil\nlocal FastReload = true;\n\nrun_on_actor(getactors()[1], string.gsub([==[\n    local TweenInfoNew; TweenInfoNew = hookfunction(TweenInfo.new, newcclosure(function(...)\n        if (debug.info(4, 'n') == \"reload_begin\" and typeof(getstack(4, 6)) == \"number\" and FastReload) then\n            setstack(4, 6, (getstack(4, 6) / 1.1));\n        elseif (debug.info(3, 'n') == \"recoil_function\") then\n            setstack(3, 5, (getstack(3, 5) * RecoilAmt));\n            setstack(3, 6, (getstack(3, 6) * RecoilAmt));\n        end;\n        return TweenInfoNew(...);\n    end));\n]==], \"%w+\", {[\"RecoilAmt\"] = RecoilAmt / 100, [\"FastReload\"] = FastReload}));\n","owner":{"_id":"68e7132c9cdba9aed08ebd95","username":"Voltara","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/64be2f28f044a39cd08d8f7da804820acef73d7905286e900415f5d4dd447cd0.webp","original":"https://scriptblox.com/images/photo/68e7132c9cdba9aed08ebd95-1767794779523.png"},"status":"offline","id":"68e7132c9cdba9aed08ebd95","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/64be2f28f044a39cd08d8f7da804820acef73d7905286e900415f5d4dd447cd0.webp","original":"https://scriptblox.com/images/photo/68e7132c9cdba9aed08ebd95-1767794779523.png"}},"verified":false,"views":1847,"scriptType":"free","isUniversal":false,