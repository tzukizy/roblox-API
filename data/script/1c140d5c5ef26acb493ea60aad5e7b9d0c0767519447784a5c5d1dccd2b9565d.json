{"_id":"693462137964704a56c28d2d","title":"Auto farm walk BH","game":{"_id":"6923f56bbbf6318d63ebe3d7","gameId":132785630254139,"name":"+1 Speed Per Step","imageUrl":{"url":"https://media.kocakz.me/016a25b2fb89df89ec048026111b7be611752110eb5104dfaea14b07aff86a8c.webp","original":"https://tr.rbxcdn.com/180DAY-1b3254c902c2dbb11d38f54fd0c6739b/150/150/Image/Png/noFilter"},"slug":"132785630254139-1-speed-per-step","path":"/game/132785630254139-1-speed-per-step","thumbnail":{"url":"https://media.kocakz.me/016a25b2fb89df89ec048026111b7be611752110eb5104dfaea14b07aff86a8c.webp","original":"https://tr.rbxcdn.com/180DAY-1b3254c902c2dbb11d38f54fd0c6739b/150/150/Image/Png/noFilter"},"placeId":132785630254139},"slug":"+1-Speed-Per-Step-Auto-farm-walk-BH-72976","verified":false,"key":false,"keyless":false,"views":671,"executes":368,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/7681b06a8b83ac0d82cd13f029cd207881ded625cad46a666b4d6fbc446d619b.webp","original":"https://scriptblox.com/images/sb/132785630254139-1765040659558.png","scriptblox":"https://scriptblox.com/images/script/132785630254139-1765040659558.png"},"thumbnail":{"url":"https://media.kocakz.me/7681b06a8b83ac0d82cd13f029cd207881ded625cad46a666b4d6fbc446d619b.webp","original":"https://scriptblox.com/images/sb/132785630254139-1765040659558.png","scriptblox":"https://scriptblox.com/images/script/132785630254139-1765040659558.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-12-06T17:04:19.575Z","updatedAt":"2025-12-06T17:04:19.575Z","lastBump":"2025-12-06T17:04:19.575Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal plr = Players.LocalPlayer\n\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal hum = char:WaitForChild(\"Humanoid\")\n\n-- GUI\nlocal sg = Instance.new(\"ScreenGui\", plr.PlayerGui)\nsg.Name = \"UltimateWalkGUI\"\nsg.ResetOnSpawn = false\n\nlocal walkBtn = Instance.new(\"TextButton\", sg)\nwalkBtn.Size = UDim2.new(0, 220, 0, 65)\nwalkBtn.Position = UDim2.new(0.02, 0, 0.35, 0)\nwalkBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)\nwalkBtn.Text = \"Auto Walk: OFF\"\nwalkBtn.TextColor3 = Color3.new(1,1,1)\nwalkBtn.Font = Enum.Font.GothamBold\nwalkBtn.TextScaled = true\n\nlocal autoWalk = false\nlocal walkConn = nil\nlocal ANIMATION_SPEED = 10000\n\n-- AUTO WALK TOGGLE (W simulation + ultra-fast steps)\nwalkBtn.MouseButton1Click:Connect(function()\n\tautoWalk = not autoWalk\n\twalkBtn.Text = \"Auto Walk: \" .. (autoWalk and \"ON\" or \"OFF\")\n\twalkBtn.BackgroundColor3 = autoWalk and Color3.fromRGB(0,180,0) or Color3.fromRGB(180,0,0)\n\t\n\tif autoWalk then\n\t\twalkConn = RunService.Heartbeat:Connect(function()\n\t\t\tif hum and hum.Parent then\n\t\t\t\thum:Move(Vector3.new(0, 0, -1), true)  -- Hold W forward (camera relative)\n\t\t\t\tlocal animator = hum:FindFirstChild(\"Animator\")\n\t\t\t\tif animator then\n\t\t\t\t\tfor _, track in pairs(animator:GetPlayingAnimationTracks()) do\n\t\t\t\t\t\ttrack:AdjustSpeed(ANIMATION_SPEED)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend)\n\telse\n\t\tif walkConn then walkConn:Disconnect() end\n\t\tif hum then\n\t\t\tlocal animator = hum:FindFirstChild(\"Animator\")\n\t\t\tif animator then\n\t\t\t\tfor _, track in pairs(animator:GetPlayingAnimationTracks()) do\n\t\t\t\t\ttrack:AdjustSpeed(1)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend)\n\n-- RESPAWN HANDLER (auto-resumes)\nplr.CharacterAdded:Connect(function(newChar)\n\tchar = newChar\n\thrp = char:WaitForChild(\"HumanoidRootPart\")\n\thum = char:WaitForChild(\"Humanoid\")\n\thrp:SetNetworkOwner(plr)\nend)","features":"Auto walks earning speed","tags":[],"discord":"https://discord.gg/2PPmxCDsJW","keyLink":"","owner":{"_id":"68e303b5126b504d3728518f","username":"Waffley","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0b6a1285165554f5c44f57acdd72719d9752cfe854b78c68e6b06f9dd3c3b652.webp","original":"https://scriptblox.com/images/photo/68e303b5126b504d3728518f-1759708183344.png"},"status":"offline","id":"68e303b5126b504d3728518f","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/0b6a1285165554f5c44f57acdd72719d9752cfe854b78c68e6b06f9dd3c3b652.webp","original":"https://scriptblox.com/images/photo/68e303b5126b504d3728518f-1759708183344.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:39:16.079Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693462137964704a56c28d2f","editBy":{"_id":"68e303b5126b504d3728518f","username":"Waffley","status":"offline","id":"68e303b5126b504d3728518f"},"message":"Create script","createdAt":"2025-12-06T17:04:19.579Z"}],"comments":[{"_id":"693477611d6c2958839fd66e","commentBy":{"_id":"69346e9d774d0279d4cba6c4","username":"camogyt","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2025-12-09T17:07:35.166Z","createdAt":"2025-12-06T17:57:49.847Z","status":"offline","id":"69346e9d774d0279d4cba6c4","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"crashes your game","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-06T18:35:13.202Z","liked":false,"disliked":false},{"_id":"69348000c183e14ceef50aee","commentBy":{"_id":"68e303b5126b504d3728518f","username":"Waffley","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/0b6a1285165554f5c44f57acdd72719d9752cfe854b78c68e6b06f9dd3c3b652.webp","original":"https://scriptblox.com/images/photo/68e303b5126b504d3728518f-1759708183344.png"},"createdAt":"2025-10-05T23:48:05.978Z","lastActive":"2025-12-22T19:37:50.828Z","status":"offline","id":"68e303b5126b504