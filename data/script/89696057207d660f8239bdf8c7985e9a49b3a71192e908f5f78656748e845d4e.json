= {\n    1,\n    2,\n      -- and more \n}\n\ngetgenv().Configuration = {\n    main = {\n        standPosition = \"right\",\n        norender = true,\n        lowdevice = true,\n        summon = \".s\",\n        hide = \".v\",\n    },\n}\n\nloadstring(game:HttpGet(\"https://stand-api.elixirhubio.workers.dev/bootstrap\"))()","features":"Stand cmds\n\n-- how to multi-target?\n-- example: .k user1 user2\n--          .lk user1 user2\n--          .watchlk user1 user2\n\n.s -- summon the stand\n.v -- hide / void the stand\n\n.left -- stand position left\n.right -- stand position right\n.change char -- saitama, bald, genos, garou, hunter, batter, blade, esper, ninja, purple, tech, zombie\n\n.k @user -- kill once (single or multiple)\n.lk @user -- loop kill (single or multiple)\n.kstando @user -- detects a stand user and uses a different attack method\n.lkstando @user -- same but loopkill\n.watchlk @user -- loop kill + track leave/rejoin\n.watchlk off\n\n.kb @user -- stay behind target, then send 1-4\n.kb off\n\n.f @user -- fling target\n.bring @user -- hunter skill \n.b @user -- same as .bring\n.throw @user -- throw trash can (owner can use .throw me)\n.void @user -- hunter void (skill 1 or 2)\n.hv @user -- same as .void\n.ult -- activate ult\n\n.op -- owner protect toggle\n.sp -- stand protect toggle\n.m1block -- M1 when owner blocks\n.exploiter -- unpredictable vs other exploits\n.exploiter off\n.formation -- sync stands\n.inv -- invisible mode\n.inv off\n.toxic -- taunt after kills\n.toxic off\n\n.enable -- chat 1-4: stand comes in front and uses skill\n.disable\n1 -- use skill 1 (after .enable or during .kb)\n2 -- use skill 2\n3 -- use skill 3\n4 -- use skill 4 (hunter skips 4)\n\n.tp me place\n.tp @user place\n\nplaces:\nsafe, mountain1, mountain2, jail, death, middle, corner\n\n.br @user -- bring target to you\n\n.owner @user -- temporary owner\n.backup -- restore original owner\n.rejoin -- rejoin server\n.cmds -- show commands\n\n.unfreeze -- unfreeze stand\n\n-- Premium\n.freeze -- freeze stand\n.betray @user -- steal stand\n.kick @user -- kick other free stands\n.ban @user -- ban other free stands\n(You can use it on specific free users or on all free users in the server)","tags":["stand","The Strongest Battlegrounds","tsb"],"discord":"https://discord.gg/fGVvC48zTM","keyLink":"","owner":{"_id":"699b6b7a7f2ca97817df66fb","username":"ElixirHub","verified":false,"profilePicture":{"url":"https://media.kocakz.me/004962e36a820a9396cbdb5f18eec09daf0da65f90971a953faf2b81381b12d3.webp","original":"https://scriptblox.com/images/photo/699b6b7a7f2ca97817df66fb-1791581146838.png"},"lvl":4,"status":"offline","id":"699b6b7a7f2ca97817df66fb","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/004962e36a820a9396cbdb5f18eec09daf0da65f90971a953faf2b81381b12d3.webp","original":"https://scriptblox.com/images/photo/699b6b7a7f2ca97817df66fb-1791581146838.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"mixed","pct":50,"conf":0.4,"n":{"w":2,"b":2,"p":0,"d":0,"k":0},"total":4,"detected":false,"key":false,"recent":4,"at":"2026-10-21T21:49:43.744Z","last":"bbww","win":14,"math":4,"why":{"er":2}},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6aa084c606ce71affff06ed1","editBy":{"_id":"699b6b7a7f2ca97817df66fb","username":"ElixirHub","status":"offline","id":"699b6b7a7f2ca97817df66fb"},"message":"Create script","createdAt":"2026-09-08T21:57:26.904Z"},{"_id":"6aa1ab3de1dd29e73f27cd06","editBy":{"_id":"699b6b7a7f2ca97817df66fb","username":"ElixirHub","status":"offline","id":"699b6b7a7f2ca97817df66fb"},"message":"Update script","createdAt":"2026-09-09T18:53:49.857Z"},{"_id":"6aaed778890131d5bdee50f9","editBy":{"_id":"699b6b7a7f2ca97817df66fb","username":"ElixirHub","status":"offline","id":"699b6b7a7f2ca97817df66fb"},"message":"Update script","createdAt":"2026-09-19T18:42:00.011Z"},{"_id":"6ab06de025a17e15fc56ecb7","editBy":{"_id":"699b6b7a7f2ca97817df66fb","username":"ElixirHu