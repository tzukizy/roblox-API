] or \"\\27[37m\"\n\n    rconsoleprint(\"[\")\n    rconsoleprint(c .. \"KEY\" .. \"\\27[0m\")\n    rconsoleprint(\"]\")\nend\n\nfunction info(color)\n    rconsoleprint(\"[\")\n    rconsoleprint(\"\\27[96m\" .. \"INFO\" .. \"\\27[0m\")\n    rconsoleprint(\"]\")\nend\n\nfunction getversion()\n    local ver = readfile(\"version.txt\")\n    local t = {}\n\n    for part in ver:gmatch(\"[^%.]+\") do\n        table.insert(t, part)\n    end\n\n    while #t < 3 do\n        table.insert(t, \"0\")\n    end\n\n    return (\"v%s.%s.%s\"):format(t[1], t[2], t[3]):lower()\nend\n\nfunction checkingkey()\n    key(\"GREEN\")\n    rconsoleprint(\" Please enter your key: \")\n    local input = rconsoleinput()\n    key(\"GREEN\")\n    rconsoleprint(\" Checking key. (this might take some time..)\\n\")\n    if input == \"key\" --[[ or input == get(\"getkey.php\"):split('value=\"')[2]:split('\" placeholder')[1] ]] then -- very hacky method lol\n        wait(1.14)\n        key(\"GREEN\")\n        rconsoleprint(\" Correct key!\\n\")\n        wait(0.16)\n        rconsoledestroy()\n    else\n        wait(1.14)\n        key(\"RED\")\n        rconsoleprint(\" Incorrect key!\\n\")\n        checkingkey()\n    end\nend\nfunction inject()\n    rconsolename(\"krnl \"..getversion())\n    rconsoleclear()\n    info()\n    rconsoleprint(\" Checking version.\\n\")\n    task.wait(0.7)\n    info()\n    rconsoleprint(\" Waiting for dependencies.\\n\")\n    info()\n    rconsoleprint(\" Scanning.\\n\")\n    task.wait(1)\n    key(\"GREEN\")\n    rconsoleprint(\" Please get a key here: https://<INSERT_URL>\\n\")\n    checkingkey()\nend\ninject()","features":"Recreated & Fixed Key System Checker (Fan recreation) By (blocksstudiobeta.exe) In Discord (this me user)\nI Fixed Krnl Console Key Checker Example: https://app.archbee.com/public/2Jp4SDaAD4P1COFfx1p_t/87uSDAjEE49Nsks3dR_O1, my original Script: https://rscripts.net/script/fixed-krnl-console-recreation-2022open-source-potassium-gNbq","tags":[],"discord":"","k