{"slug":"UPD-THE-WRAITH:-SURVIVAL-collector-read-the-desc-for-guide-115208","_id":"69995a05f0045c3983f7e394","title":"collector read the desc for guide","game":{"_id":"689e70e2706e45ad4ddd53db","gameId":118511908531842,"name":"[UPD] THE WRAITH: SURVIVAL","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":118511908531842},"features":"f1 to go to a exotic gift f2 to teleport to a random scrap (there is really useful tech where if u spam it on gsr or despair or bloodborne he wont catch you) f3 to collect all of the wood in the map f4 to get an orb\n\nyou get notified EVERY time when something rare spawns","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal StarterGui = game:GetService(\"StarterGui\")\n\nlocal player = Players.LocalPlayer\n\nlocal Storage = workspace:WaitForChild(\"Storage\")\nlocal Map = Storage:WaitForChild(\"Map\")\nlocal Scraps = Map:WaitForChild(\"Scraps\")\n\nlocal function notify(t, x)\n    pcall(function()\n        StarterGui:SetCore(\"SendNotification\", {\n            Title = t,\n            Text = x,\n            Duration = 4\n        })\n    end)\nend\n\nlocal function tp(cf)\n    local c = player.Character or player.CharacterAdded:Wait()\n    local r = c:FindFirstChild(\"HumanoidRootPart\")\n    if r then r.CFrame = cf end\nend\n\nlocal LatestGift = nil\n\nlocal function detectGift(o)\n    if o.Name == \"Exotic Gift\" then\n        LatestGift = o\n        notify(\"exotic gift\", \"one spawned\")\n    end\nend\n\nfor _, v in ipairs(Scraps:GetChildren()) do\n    detectGift(v)\nend\n\nScraps.ChildAdded:Connect(detectGift)\n\nlocal function detectOrb(o)\n    if string.find(string.lower(o.Name), \"orb\") then\n        notify(\"orb\", o.Name .. \" showed up\")\n    end\nend\n\nfor _, v in ipairs(Scraps:GetChildren()) do\n    detectOrb(v)\nend\n\nScraps.ChildAdded:Connect(detectOrb)\n\nUserInputService.InputBegan:Connect(function(i, gp)\n    if gp then return end\n\n    if i.KeyCode == Enum.KeyCode.F1 then\n        if LatestGift and LatestGift:IsDescendantOf(workspace) then\n            if LatestGift:IsA(\"Model\") then\n                tp(LatestGift:GetPivot())\n            elseif LatestGift:IsA(\"BasePart\") then\n                tp(LatestGift.CFrame)\n            end\n        else\n            notify(\"nothing\", \"no exotic gift\")\n        end\n    end\n\n    if i.KeyCode == Enum.KeyCode.F2 then\n        local items = Scraps:GetChildren()\n        if #items == 0 then\n            notify(\"empty\", \"scraps has nothing\")\n            return\n        end\n        local t = items[math.random(1, #items)]\n        if t:IsA(\"Model\") then\n            tp(t:GetPivot())\n        elseif t:IsA(\"BasePart\") then\n            tp(t.CFrame)\n        end\n        notify(\"teleported\", t.Name)\n    end\n\n    if i.KeyCode == Enum.KeyCode.F3 then\n        local c = player.Character or player.CharacterAdded:Wait()\n        local r = c:FindFirstChild(\"HumanoidRootPart\")\n        if not r then return end\n        local original = r.CFrame\n        for _, item in ipairs(Scraps:GetChildren()) do\n            if string.lower(item.Name) == \"wood\" then\n                if item:IsA(\"Model\") then\n                    tp(item:GetPivot())\n                elseif item:IsA(\"BasePart\") then\n                    tp(item.CFrame)\n                end\n                task.wait(0.15)\n            end\n        end\n        tp(original)\n        notify(\"done\", \"wood collected\")\n    end\n\n    if i.KeyCode == Enum.KeyCode.F4 then\n        local orbs = {}\n        for _, item in ipairs(Scraps:GetChildren()) do\n            if string.find(string.lower(item.Name), \"orb\") then\n                table.insert(orbs, item)\n            end\n        end\n        if #orbs == 0 then\n            notify(\"none\", \"no orbs in scraps\")\n            return\n        end\n        local t = orbs[math.random(1, #orbs)]\n        if t:IsA(\"Model\") then\n            tp(t:GetPivot())\n        elseif t:IsA(\"BasePart\") then\n            tp(t.CFrame)\n        end\n        notify(\"teleported\", t.Name)\n    end\nend)","owner":{"_id":"6741a6c10ae55dd49e7b26b7","username":"funnyburger","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/37c1297db405918893303ac0f05b4be93e3aff5d7aa4bd183fdcceebac72de74.webp","original":"https://scriptblox.com/images/photo/6741a6c10ae55dd49e7b26b7-1761572411900.png"},"lvl":6,"status":"offline","id":"6741a6c10ae55dd49e7b26b7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/37c1297db405918893303ac0f05b4be93e3aff5d7aa4bd183fdcceebac72de74.webp","original":"https://scriptblox.com/images/photo/6741a6c10ae55dd49e7b26b7-1761572411900.png"}},"verified":false,"views":1791,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/cf6f7ff6f58dd911048213fce397eb2599b940ab9a4ec68899790ac6717ef4ad.webp","original":"https://scriptblox.com/images/sb/rbx-58ff6f9f4c4069ef6f0bf133711595b2-aeb7e31015f6.png","scriptblox":"https://scriptblox.com/images/script/rbx-58ff6f9f4c4069ef6f0bf133711595b2-aeb7e31015f6.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2026-02-21T07:08:53.429Z","executes":226,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:31:24.919Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/cf6f7ff6f58dd911048213fce397eb2599b940ab9a4ec68899790ac6717ef4ad.webp","original":"https://scriptblox.com/images/sb/rbx-58ff6f9f4c4069ef6f0bf133711595b2-aeb7e31015f6.png","scriptblox":"https://scriptblox.com/images/script/rbx-58ff6f9f4c4069ef6f0bf133711595b2-aeb7e31015f6.png"},"isHub":false,"supportedGames":[],