{"_id":"69f77f9c6ce7e0dca5d2000c","title":"Simple Chams I Open Source","game":{"_id":"68a10eb28843cab44a2a117d","gameId":12144402492,"name":"[0.25.3] Deadline","imageUrl":{"url":"https://media.kocakz.me/542b41bc2b481aa4d58fed2c00d58443691cb3a8e6d514660c3b562c274156ae.webp","original":"https://tr.rbxcdn.com/180DAY-9432f4ba49dc475bb40bf80f50609289/150/150/Image/Png/noFilter"},"slug":"12144402492-deadline","path":"/game/12144402492-deadline","thumbnail":{"url":"https://media.kocakz.me/542b41bc2b481aa4d58fed2c00d58443691cb3a8e6d514660c3b562c274156ae.webp","original":"https://tr.rbxcdn.com/180DAY-9432f4ba49dc475bb40bf80f50609289/150/150/Image/Png/noFilter"},"placeId":12144402492},"slug":"0.25.2-Deadline-Simple-Chams-I-Open-Source-211521","verified":false,"key":false,"keyless":false,"views":2607,"executes":1992,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/dc3cfe2dfbbf7cf9759449566b59f8728d78894141d57f3813364bfbcb9ba3e1.webp","original":"https://scriptblox.com/images/sb/12144402492-1777827740714.webp","scriptblox":"https://scriptblox.com/images/script/12144402492-1777827740714.webp"},"thumbnail":{"url":"https://media.kocakz.me/dc3cfe2dfbbf7cf9759449566b59f8728d78894141d57f3813364bfbcb9ba3e1.webp","original":"https://scriptblox.com/images/sb/12144402492-1777827740714.webp","scriptblox":"https://scriptblox.com/images/script/12144402492-1777827740714.webp"},"likeCount":0,"dislikeCount":1,"createdAt":"2026-05-03T17:02:20.749Z","updatedAt":"2026-05-03T17:02:20.749Z","lastBump":"2026-05-03T17:02:20.749Z","script":"local Workspace = game:GetService(\"Workspace\")\nlocal Characters = Workspace.characters\nlocal Ragdolls = Workspace.ignore.ragdolls\n\nlocal Highlights = {}\n\nfunction IsValidModel(Model)\n\tif not Model or not Model:IsA(\"Model\") then return false end\n\tif Model.Name == \"StarterCharacter\" then return false end\n\treturn true\nend\n\nfunction CreateChams(Model)\n\tif not IsValidModel(Model) then return end\n\tif Highlights[Model] then return end\n\n\tlocal Highlight = Instance.new(\"Highlight\")\n\tHighlight.Parent = gethui()\n\tHighlight.Adornee = Model\n\tHighlight.Name = \"\\0\"\n\n\tHighlights[Model] = Highlight\nend\n\nfunction RemoveChams(Model)\n\tlocal Highlight = Highlights[Model]\n\tif Highlight then\n\t\tHighlight:Destroy()\n\t\tHighlights[Model] = nil\n\tend\nend\n\nfor _, Object in ipairs(Characters:GetChildren()) do\n\tCreateChams(Object)\nend\n\nCharacters.ChildAdded:Connect(function(Object)\n\tCreateChams(Object)\nend)\n\nRagdolls.ChildAdded:Connect(function(Object)\n\tRemoveChams(Object)\nend)\n\nCharacters.ChildRemoved:Connect(function(Object)\n\tRemoveChams(Object)\nend)","features":"Open source chams for learners or skidders for deadline","tags":[],"discord":"","keyLink":"","owner":{"_id":"67395ae3125cd21dd0ba54d0","username":"fract","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c00751bb362c96552ad0580b723874ca3d7ff20a987833f4539555312d6ed0d7.webp","original":"https://scriptblox.com/images/photo/67395ae3125cd21dd0ba54d0-1772604680855.png"},"status":"offline","id":"67395ae3125cd21dd0ba54d0","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/c00751bb362c96552ad0580b723874ca3d7ff20a987833f4539555312d6ed0d7.webp","original":"https://scriptblox.com/images/photo/67395ae3125cd21dd0ba54d0-1772604680855.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:38:12.986Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69f77f9c6ce7e0dca5d2000f","editBy":{"_id":"67395ae3125cd21dd0ba54d0","username":"fract","status":"offline","id":"67395ae3125cd21dd0ba54d0"},"message":"Create script","createdAt":"2026-05-03T17:02:20.755Z"},{"_id":"69f789b3f5ea05631d7bf84d","editBy":{"_id"