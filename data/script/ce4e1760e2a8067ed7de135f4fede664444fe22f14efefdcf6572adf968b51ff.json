{"slug":"0.25.2-Deadline-Simple-Chams-I-Open-Source-211521","_id":"69f77f9c6ce7e0dca5d2000c","title":"Simple Chams I Open Source","game":{"_id":"68a10eb28843cab44a2a117d","gameId":12144402492,"name":"[0.25.3] Deadline","imageUrl":"/images/sb/rbx-de653ca3cd0679fcae6a7465945d1089-9011a6456f40.png","placeId":12144402492},"features":"Open source chams for learners or skidders for deadline","tags":[],"script":"local Workspace = game:GetService(\"Workspace\")\nlocal Characters = Workspace.characters\nlocal Ragdolls = Workspace.ignore.ragdolls\n\nlocal Highlights = {}\n\nfunction IsValidModel(Model)\n\tif not Model or not Model:IsA(\"Model\") then return false end\n\tif Model.Name == \"StarterCharacter\" then return false end\n\treturn true\nend\n\nfunction CreateChams(Model)\n\tif not IsValidModel(Model) then return end\n\tif Highlights[Model] then return end\n\n\tlocal Highlight = Instance.new(\"Highlight\")\n\tHighlight.Parent = gethui()\n\tHighlight.Adornee = Model\n\tHighlight.Name = \"\\0\"\n\n\tHighlights[Model] = Highlight\nend\n\nfunction RemoveChams(Model)\n\tlocal Highlight = Highlights[Model]\n\tif Highlight then\n\t\tHighlight:Destroy()\n\t\tHighlights[Model] = nil\n\tend\nend\n\nfor _, Object in ipairs(Characters:GetChildren()) do\n\tCreateChams(Object)\nend\n\nCharacters.ChildAdded:Connect(function(Object)\n\tCreateChams(Object)\nend)\n\nRagdolls.ChildAdded:Connect(function(Object)\n\tRemoveChams(Object)\nend)\n\nCharacters.ChildRemoved:Connect(function(Object)\n\tRemoveChams(Object)\nend)","owner":{"_id":"67395ae3125cd21dd0ba54d0","username":"fract","verified":false,"profilePicture":"/images/photo/67395ae3125cd21dd0ba54d0-1772604680855.png","status":"offline","id":"67395ae3125cd21dd0ba54d0","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2546,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/12144402492-1777827740714.webp","likeCount":0,"dislikeCount":1,"createdAt":"2026-05-0