       end\n    end)\nend\n\n-- Optimization: This keeps your FPS stable while the server struggles\nsettings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.Disabled","owner":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"profilePicture":"/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg","status":"offline","id":"687eba7419599ad33f38a3db","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1934,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-93de01344a1bd15730a0f48b34824862-f2063f6b3278.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-04-08T23:17:06.191Z","editBy":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","status":"offline","id":"687eba7419599ad33f38a3db"},"keyLink":"","executes":771,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d6e1f297c9ecc39971fc91","editBy":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","status":"offline","id":"687eba7419599ad33f38a3db"},"message":"Create script","createdAt":"2026-04-08T23:17:06.195Z"},{"_id":"69d6e52e0c79678cdca47804","editBy":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","status":"offline","id":"687eba7419599ad33f38a3db"},"message":"Update script","createdAt":"2026-04-08T23:30:54.406Z"}],"comments":[{"_id":"69d6e2efd7556cb4a15b77c0","commentBy":{"_id":"69d6e2aff15269b3e5d7446e","username":"Siloappreciatesyou","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-04-18T15:48:03.205Z","createdAt":"2026-04-08T23:20:15.202Z","status":"offline","id":"69d6e2aff15269b3e5d7446e"},"text":"who even use volt?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-08T23:21:19.357Z","liked":false,"disliked":false},{"_id":"69d6e2f9d5125d1e696d6267","commentBy":{"_id":"69d6e2aff15269b3e5d7446e","username":"Siloappreciatesyou","verified":false,"role":"