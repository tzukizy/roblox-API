{"slug":"Prison-Life-Get-Weapon-from-anywhere-13573","_id":"66570059639bc4f0037d65ad","title":"Get Weapon from anywhere","game":{"_id":"67e5e1ffb360710ec3c77d3e","gameId":155615604,"name":"Prison Life","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":155615604},"features":"Gets a weapon from anywhere.","tags":["prison life"],"script":"--[[\nI originally found this btw LOL\nI used to do ITEMPICKUP with the name since I thought it checked on ServerItemHandler, but it doesn't so that's useless now.\n--]]\nlocal ITEM_NAME = \"M4A1\"\nlocal ItemHandler = workspace.Remote:WaitForChild(\"ItemHandler\")\nlocal Position = game:GetService(\"Players\").LocalPlayer.Character:GetPivot()\n\nItemHandler:InvokeServer({ Position = Position, Parent = workspace.Prison_ITEMS:FindFirstChild(ITEM_NAME, true)})","owner":{"_id":"6580c63d3fc06414559a757c","username":"dalloc2","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/618c50141cab6629e24c5f941b9f00122fa81589e812d34d590d2eeedd580c5e.webp","original":"https://scriptblox.com/images/photo/6580c63d3fc06414559a757c-1716977346948.png"},"status":"offline","id":"6580c63d3fc06414559a757c","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/618c50141cab6629e24c5f941b9f00122fa81589e812d34d590d2eeedd580c5e.webp","original":"https://scriptblox.com/images/photo/6580c63d3fc06414559a757c-1716977346948.png"}},"verified":false,"keyLink":"","views":19807,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-05-29T10:15:53.048Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/3d24e517aeb9a371c620094a452c2190/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/3d24e517aeb9a371c620094a452c2190/500/280/Image/Jpeg"},"executes":16,"keyless":false,"