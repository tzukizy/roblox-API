{"_id":"697f2640ab4b5f14a0803a27","title":"Simple infinite mag","game":{"_id":"67e5e1ffb360710ec3c788cf","gameId":6788434697,"name":"AniPhobia","imageUrl":{"url":"https://media.kocakz.me/7088453cdab9ea9eacf731ab9e6feef5a5cac6b0469801f983de9d17c94aeb3f.webp","original":"https://tr.rbxcdn.com/180DAY-3f2d298cf383a99d3bbc7e745dabea75/150/150/Image/Png/noFilter"},"slug":"6788434697-aniphobia","path":"/game/6788434697-aniphobia","thumbnail":{"url":"https://media.kocakz.me/7088453cdab9ea9eacf731ab9e6feef5a5cac6b0469801f983de9d17c94aeb3f.webp","original":"https://tr.rbxcdn.com/180DAY-3f2d298cf383a99d3bbc7e745dabea75/150/150/Image/Png/noFilter"},"placeId":6788434697},"slug":"AniPhobia-Simple-infinite-mag-98285","verified":false,"key":false,"keyless":false,"views":1199,"executes":260,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/c556d5f840023024ee08262c5abc7ab5c5d6555b8d9ba72bcbae36bf17f57b10.webp","original":"https://scriptblox.com/images/sb/6788434697-1769940544101.png","scriptblox":"https://scriptblox.com/images/script/6788434697-1769940544101.png"},"thumbnail":{"url":"https://media.kocakz.me/c556d5f840023024ee08262c5abc7ab5c5d6555b8d9ba72bcbae36bf17f57b10.webp","original":"https://scriptblox.com/images/sb/6788434697-1769940544101.png","scriptblox":"https://scriptblox.com/images/script/6788434697-1769940544101.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-02-01T10:09:04.114Z","updatedAt":"2026-02-01T10:09:04.114Z","lastBump":"2026-02-01T10:09:04.114Z","script":"-- infinite mag pls dont skid\n-- set getgenv().InfiniteMag = false before exec if u want it off\n\ngetgenv().InfiniteMag = true\n\nlocal magSize = 100      -- can be 10, 50, 999 or whatever, loop will keep forcing it anyway\nlocal plsWait = 0.1      -- dont touch this, controls how fast mag refreshes\n\nlocal plrs = game:GetService(\"Players\")\nlocal lp = plrs.LocalPlayer\n\nlocal function forceMag(gunClient)\n    if not gunClient then return end\n\n    local magTbl\n\n    for _,v in pairs(getgc(true)) do\n        if typeof(v) == \"function\" then\n            local fenv = getfenv(v)\n            if fenv and fenv.script == gunClient then\n                local info = debug.getinfo(v)\n                if info and info.name == \"OnSwitching\" then\n                    local up = debug.getupvalue(v, 6) -- yes its 6, dont ask\n                    if type(up) == \"table\" and up.Mag ~= nil then\n                        magTbl = up\n                        break\n                    end\n                end\n            end\n        end\n    end\n    if magTbl then\n        task.spawn(function()\n            while true do\n                task.wait(plsWait)\n                if getgenv().InfiniteMag then\n                    magTbl.Mag = magSize\n                end\n            end\n        end)\n    end\nend\n\nlocal function onChar(char)\n    for _,c in ipairs(char:GetChildren()) do\n        local gc = c:FindFirstChild(\"GunClient\")\n        if gc then\n            forceMag(gc)\n        end\n    end\n\n    char.ChildAdded:Connect(function(c)\n        task.wait(0.1) -- roblox moment\n        local gc = c:FindFirstChild(\"GunClient\")\n        if gc then\n            forceMag(gc)\n        end\n    end)\nend\n\nif lp.Character then\n    onChar(lp.Character)\nend\n\nlp.CharacterAdded:Connect(onChar)\n","features":"Infinite mag (that's it)","tags":[],"discord":"https://discord.gg/D6CumQUJBD","keyLink":"","owner":{"_id":"696ecc1b53b2145f89f3bbcc","username":"alexpear","verified":false,"profilePicture":{"url":"https://media.kocakz.me/57976909aa76418121243b45c6781f7eafde1e90760b5d0c0e230ad7761503a2.webp","original":"https://scriptblox.com/images/photo/696ecc1b53b2145f89f3bbcc-1768868912094.png"},"status":"offline","id":"696ecc1b53b2145f89f3bbcc","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/57976909aa76418121243b45c6781f7eafde1e90760b5d0c0e230ad7761503a2.webp","original":"https://scriptblox.com/images/photo/696ecc1b53b2145f89f3bbcc-1768868912094.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:41:49.167Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"697f2640ab4b5f14a0803a2a","editBy":{"_id":"696ecc1b53b2145f89f3bbcc","username":"alexpear","status":"offline","id":"696ecc1b53b2145f89f3bbcc"},"message":"Create script","createdAt":"2026-02-01T10:09:04.115Z"}],"comments":[{"_id":"699c944dad9577e0315f2d9e","commentBy":{"_id":"66a29cf78843f7185e743e95","username":"speed2024","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/9d31a34ace32e67e6d012812a20905b83d40c2c44931866616221ec4773c2c75.webp","original":"https://scriptblox.com/images/photo/66a29cf78843f7185e743e95-1757873032540.jpg"},"createdAt":"2024-07-25T18:44:07.771Z","lastActive":"2026-04-25T06:39:39.790Z","status":"offline","id":"66a29cf78843f7185e743e95","profile":{"url":"https://media.kocakz.me/9d31a34ace32e67e6d012812a20905b83d40c2c44931866616221ec4773c2c75.webp","original":"https://scriptblox.com/images/photo/66a29cf78843f7185e743e95-1757873032540.jpg"}},"text":"very simple but works","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-02-23T17:54:21.098Z","liked":false,"disliked":false},{"_id":"69a3179396d3ccea108f1abe","commentBy":{"_id":"696ecc1b53b2145f89f3bbcc","username":"alexpear","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/57976909aa76418121243b45c6781f7eafde1e90760b5d0c0e230ad7761503a2.webp","original":"https://scriptblox.com/images/photo/696ecc1b53b2145f89f3bbcc-1768868912094.png"},"lastActive":"2026-05-15T11:57:35.663Z","createdAt":"2026-01-20T00:28:11.076Z","status":"offline","id":"696ecc1b53b2145f89f3bbcc","topMilestone":{"key":"creator.executions","tier