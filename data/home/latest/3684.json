5, 255)\nTextLabel.TextScaled = true\nTextLabel.TextSize = 14.000\nTextLabel.TextWrapped = true\n\nTextButton.Parent = Frame\nTextButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)\nTextButton.BackgroundTransparency = 3.000\nTextButton.Position = UDim2.new(0.928774953, 0, 0.669354856, 0)\nTextButton.Size = UDim2.new(0, 42, 0, 41)\nTextButton.Font = Enum.Font.SourceSans\nTextButton.Text = \"Close\"\nTextButton.TextColor3 = Color3.fromRGB(255, 0, 0)\nTextButton.TextScaled = true\nTextButton.TextSize = 50.000\nTextButton.TextWrapped = true\nTextButton.MouseButton1Down:connect(function()\n\tFrame.Visible = false\nend)\n\n\n\n\nend","owner":{"_id":"61c7dd9c0dbd0306154c41ac","username":"ZayWashed","verified":false,"profilePicture":"/images/photo/61c7dd9c0dbd0306154c41ac-1640525858588.png","status":"offline","id":"61c7dd9c0dbd0306154c41ac","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":35303,"scriptType":"free","isUniversal":false,"createdAt":"2021-12-26T13:48:28.156Z","visibility":"public","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/3e3e0965eb7e49be94c1fef81144c726/500/280/Image/Jpeg","executes":38,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4dec5","editBy":{"_id":"61c7dd9c0dbd0306154c41ac","username":"ZayWashed","status":"offline","id":"61c7dd9c0dbd0306154c41ac"},"message":"Create script","createdAt":"2025-03-27T13:31:43.768Z"}],"comments":[]},{"slug":"Artic-GUI_133","_id":"61c8718008d92e4bf15981c9","title":"Artic GUI","game":{"_id":"67e5e1ffb360710ec3c77ddb","gameId":2788229376,"name":"[RANKED] Da Hood","imageUrl":"/images/sb/rbx-655a8b7fc990b48f595db9bcfd7ea70b-5b6a0ca4b78b.png","placeId":2788229376},"features":"Features:\nSilent Aim or Aimbot\nAutoFarm ATM, Shoe Store, etc..\nCashDropper\nFree Animations\nAutoBuy for weapons or food","tags":[],"script":"loadstring(game:HttpGetAsync(\"https://raw.githubusercontent.com/PolarWasHere/Arctic