b8b60f61a10ca1fd4","commentBy":{"_id":"67682bb179306dededc0ddf4","username":"Nabula","verified":false,"role":"user","profilePicture":"/images/photo/67682bb179306dededc0ddf4-1738868231430.jpg","createdAt":"2024-12-22T15:09:37.866Z","lastActive":"2026-09-09T09:58:54.862Z","status":"offline","id":"67682bb179306dededc0ddf4","topMilestone":{"key":"creator.executions","tier":10000}},"text":"I don't know what to put the picture as so yeah","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-04-05T18:27:55.205Z","liked":false,"disliked":false}]},{"slug":"NOW-Blue-Lock:-Rivals-Op-script-for-new-update-34285","_id":"67f1743ba4833d6785aa4a3a","title":"Op script for new update","game":{"_id":"67e5e1ffb360710ec3c77d1a","gameId":18668065416,"name":"[NIKO 👁️] Blue Lock: Rivals","imageUrl":"/images/sb/rbx-d3badd2fb676c817355951c5fa8525a6-dd7c815e45a7.png","placeId":18668065416},"features":"Has basically everything u need getting updated later today for the new gamemode support","tags":[],"script":"\nloadstring(game:HttpGet(\"https://raw.githubusercontent.com/SkibidiCen/MainMenu/main/Code\"))()","owner":{"_id":"67718d44b85517e4b515d4f1","username":"Ov3rT1p","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"67718d44b85517e4b515d4f1","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":6423,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"https://tr.rbxcdn.com/180DAY-4816192006b1575ba5c22ee1b9f51aa0/500/280/Image/Jpeg/noFilter","likeCount":0,"dislikeCount":0,"createdAt":"2025-04-05T18:19:39.960Z","executes":2,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f1743ba4833d6785aa4a3c","editBy":{"_id":"67718d44b85517e4b515d4f1","username":"Ov3rT1p","status":"offline","id":"67718d44b85517e4b515d4f1"},"message":"Create script","createdAt":"2025-04-05T18:19:39.964Z"}],"comments":[]},{"slug":"Universal-Script-Universal-Crosshair-Script-34284","_id":"67f173a774d9156226b80c92","title":"Universal Crosshair","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1743877031027.jpg","placeId":0},"features":"- adjustable gap, color, thickness, and size.","tags":[],"script":"local settings = {\n    -- Visual Settings\n    color = Color3.fromRGB(255, 255, 255),  -- Crosshair color (White)\n    thickness = 1,                          -- Line thickness (pixels)\n    length = 5,                             -- Length of each line (pixels)\n    gap = 2,                                -- Center gap (pixels)\n    opacity = 1,                            -- Transparency (0-1)\n    dot = false,                            -- Enable center dot\n    dot_size = 2,                           -- Dot size (pixels)\n    \n    -- Positioning\n    x_offset = 0,                           -- Horizontal adjustment\n    y_offset = 0,                           -- Vertical adjustment\n    recenter = true                         -- Auto-adjust on screen resize\n}\n\n-- Services\nlocal cam = workspace.CurrentCamera or workspace:FindFirstChildOfClass(\"Camera\")\nlocal Players = game:GetService(\"Players\")\nlocal Player = Players.LocalPlayer\n\n-- Crosshair objects\nlocal crosshair = {\n    top = nil,\n    bottom = nil,\n    left = nil,\n    right = nil,\n    dot = nil,\n    connections = {}\n}\n\n-- Cleanup function (prevents memory leaks)\nlocal function cleanup()\n    for _, part in pairs(crosshair) do\n        if typeof(part) == \"Drawing\" then\n            part:Remove()\n        elseif typeof(part) == \"RBXScriptConnection\" then\n            part:Disconnect()\n        end\n    end\n    crosshair = {\n        top = nil,\n        bottom = nil,\n        left = nil,\n        right = nil,\n        dot = nil,\n        connections = {}\n    }\nend\n\n-- Create a new drawing object\nlocal function createLine()\n    return Drawing.new(\"Line\")\nend\n\n-- Initialize crosshair\nlocal function initCrosshair()\n    cleanup()\n    \n    -- Create crosshair parts\n    crosshair.top = createLine()\n    crosshair.bottom = createLine()\n    crosshair.left = createLine()\n    crosshair.right = createLine()\n    \n    if settings.dot then\n        crosshair.dot = Drawing.new(\"Circle\")\n        crosshair.dot.Thickness = 1\n        crosshair.dot.Filled = true\n        crosshair.dot.Color = settings.color\n        crosshair.dot.Transparency = settings.opacity\n        crosshair.dot.Visible = true\n    end\n    \n    -- Apply common properties\n    for _, part in pairs({crosshair.top, crosshair.bottom, crosshair.left, crosshair.right}) do\n        part.Thickness = settings.thickness\n        part.Color = settings.color\n        part.Transparency = settings.opacity\n        part.Visible = true\n    end\n    \n    -- Auto-recenter on screen resize\n    if settings.recenter then\n        table.insert(crosshair.connections, cam:GetPropertyChangedSignal(\"ViewportSize\"):Connect(function()\n            updateCrosshair() -- Refresh position on resize\n        end))\n    end\nend\n\n-- Update crosshair position (static, no scaling)\nlocal function updateCrosshair()\n    local centerX = (cam.ViewportSize.X / 2) + settings.x_offset\n    local centerY = (cam.ViewportSize.Y / 2) + settings.y_offset\n    \n    -- Top line\n    crosshair.top.From = Vector2.new(centerX, centerY - settings.gap)\n    crosshair.top.To = Vector2.new(centerX, centerY - settings.gap - settings.length)\n    \n    -- Bottom line\n    crosshair.bottom.From = Vector2.new(centerX, centerY + settings.gap)\n    crosshair.bottom.To = Vector2.new(centerX, centerY + settings.gap + settings.length)\n    \n    -- Left line\n    crosshair.left.From = Vector2.new(centerX - settings.gap, centerY)\n    crosshair.left.To = Vector2.new(centerX - settings.gap - settings.length, centerY)\n    \n    -- Right line\n    crosshair.right.From = Vector2.new(centerX + settings.gap, centerY)\n    crosshair.right.To = Vector2.new(centerX + settings.gap + settings.length, centerY)\n    \n    -- Center dot\n    if crosshair.dot then\n        crosshair.dot.Position = Vector2.new(centerX, centerY)\n        crosshair.dot.Radius = settings.dot_size\n    end\nend\n\n-- Initialize\ninitCrosshair()\nupdateCrosshair()\n\n-- Cleanup on player leave\ntable.insert(crosshair.connections, Player.CharacterRemoving:Connect(cleanup))\ntable.insert(crosshair.connections, game:BindToClose(cleanup))","owner":{"_id":"67e8043dca1972fe23ccb8b8","username":"Yas_ys","verified":false,"profilePicture":"/images/photo/67e8043dca1972fe23ccb8b8-1746484091377.png","status":"offline","id":"67e8043dca1972fe23ccb8b8","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":4914,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1743877031027.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2025-04-05T18:17:11.126Z","executes":685,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f173a774d9156226b80c94","editBy":{"_id":"67e8043dca1972fe23ccb8b8","username":"Yas_ys","status":"offline","id":"67e8043dca1972fe23ccb8b8"},"message":"Create script","createdAt":"2025-04-05T18:17:11.133Z"}],"comments":[]},{"slug":"Anime-Kingdom-Simulator-RELEASE-OMG-Hub-34278","_id":"67f168b474d9156226b62011","title":"OMG Hub","game":{"_id":"67efd066eae368262788a781","gameId":17334984034,"name":"Anime Kingdom Simulator [UPD 13.5 + SUMMER]","imageUrl":"/images/sb/rbx-d530e353e2049795d0ff549a2185954a-f011ef35eeee.png","placeId":17334984034},"features":"Farm+Raid+OpenStar","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Omgshit/Scripts/main/MainLoader.lua\"))()","owner":{"_id":"654f3db0f11ec59dfbde9ea4","username":"OmgHub","verified":false,"profilePicture":"/images/photo/654f3db0f11ec59dfbde9ea4-1699692097161.jpeg","status":"offline","id":"654f3db0f11ec59dfbde9ea4"},"verified":false,"d