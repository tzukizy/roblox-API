r:FindFirstChildOfClass('Humanoid').RootPart\n    start()\nend)\n\nlplr.CharacterRemoving:Connect(function()\n    heartbeatConnection:Disconnect()\nend)\n\nstart()","owner":{"_id":"66f75b84bad6558f11b01148","username":"sampangmatthew","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66f75b84bad6558f11b01148","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":11437,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1744418254788.jpg","likeCount":3,"dislikeCount":0,"createdAt":"2025-04-12T00:37:34.857Z","executes":1352,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f9b5ce482f224a484b8531","editBy":{"_id":"66f75b84bad6558f11b01148","username":"sampangmatthew","status":"offline","id":"66f75b84bad6558f11b01148"},"message":"Create script","createdAt":"2025-04-12T00:37:34.859Z"}],"comments":[{"_id":"694e9aa2426a0c4abcadebcf","commentBy":{"_id":"68305e2f51e1bfc46b124575","username":"I6996I","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-05-23T11:38:23.620Z","lastActive":"2026-05-22T23:26:36.823Z","status":"offline","id":"68305e2f51e1bfc46b124575"},"text":"it makes ur root part glitch a lot, only fly fixing it","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-26T14:24:34.057Z","liked":false,"disliked":false},{"_id":"6a20d9bbd75a2dbeed18a4aa","commentBy":{"_id":"698415984bfacc34691f50a7","username":"gadgeting","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-06-14T03:54:55.559Z","createdAt":"2026-02-05T03:59:20.141Z","status":"offline","id":"698415984bfacc34691f50a7"},"text":"make an option to turn it on and off, because once I use it i cant turn it off and now the game can't teleport me anywhere anymore","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-04T01:49:47.008Z","liked":