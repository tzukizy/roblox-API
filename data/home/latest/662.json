")\nlocal finisherSection = finisherTab:NewSection(\"All Finishers\")\n\n-- Counters Tab\nlocal counterTab = window:NewTab(\"Counters\")\nlocal counterSection = counterTab:NewSection(\"All Counters\")\n\nfor _, charFolder in pairs(characters:GetChildren()) do\n    local remotes = charFolder:FindFirstChild(\"Remotes\")\n    if remotes then\n        for _, remote in pairs(remotes:GetChildren()) do\n            local nameLower = remote.Name:lower()\n            local charName = charFolder.Name\n            local moveName = remote.Name\n\n            if string.find(nameLower, \"finisher\") then\n                print(\"✅ Finisher: \" .. charName .. \" → \" .. moveName)\n                finisherSection:NewButton(charName .. \" - \" .. moveName, \"Use \" .. moveName, function()\n                    local r = remotes:FindFirstChild(moveName)\n                    if r then\n                        r:FireServer(player)\n                        print(\"✅ Fired: \" .. charName .. \" - \" .. moveName)\n                    end\n                end)\n            elseif string.find(nameLower, \"counter\") then\n                print(\"✅ Counter: \" .. charName .. \" → \" .. moveName)\n                counterSection:NewButton(charName .. \" - \" .. moveName, \"Use \" .. moveName, function()\n                    local r = remotes:FindFirstChild(moveName)\n                    if r then\n                        r:FireServer(player)\n                        print(\"✅ Fired: \" .. charName .. \" - \" .. moveName)\n                    end\n                end)\n            end\n        end\n    end\nend\n","owner":{"_id":"69d1978a161a9ca399bb0182","username":"IPOSTSCRIPTSUWANT","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69d1978a161a9ca399bb0182","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1850,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/8657766101-17763