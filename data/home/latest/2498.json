{"page":2498,"totalPages":3690,"count":20,"scripts":[{"slug":"Universal-Script-Complex-server-34966","_id":"67f73e247db44d43864bf271","title":"Complex server","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1744256548350.jpg","placeId":0},"features":"Features >\n\nBypass Key's / Links\nGive-aways all Months / days\nDrops all days\nKeyless Scrtips\nDownload Exploits\netc...\n\nJOIN NOW","tags":[],"script":"https://discord.gg/be8mP3QR5w","owner":{"_id":"67d3c7eb3b03aeef4fc1a649","username":"kelvinhos1204","verified":false,"profilePicture":"/images/photo/67d3c7eb3b03aeef4fc1a649-1744254981564.jpg","status":"offline","id":"67d3c7eb3b03aeef4fc1a649","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord.gg/be8mP3QR5w","views":991,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1744256548350.jpg","likeCount":0,"dislikeCount":1,"createdAt":"2025-04-10T03:42:28.400Z","executes":47,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f73e247db44d43864bf273","editBy":{"_id":"67d3c7eb3b03aeef4fc1a649","username":"kelvinhos1204","status":"offline","id":"67d3c7eb3b03aeef4fc1a649"},"message":"Create script","createdAt":"2025-04-10T03:42:28.404Z"}],"comments":[{"_id":"67f74936f913ab2c0e1a5644","commentBy":{"_id":"67f09c9c8b60f61a10a34e7c","username":"Script_legacy","verified":false,"role":"user","profilePicture":"/images/photo/67f09c9c8b60f61a10a34e7c-1747144265800.jpg","createdAt":"2025-04-05T02:59:40.522Z","lastActive":"2025-05-16T13:16:46.566Z","status":"offline","id":"67f09c9c8b60f61a10a34e7c","topMilestone":{"key":"creator.executions","tier":10000}},"text":"nice hair thumbnail","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-04-10T04:29:42.081Z","liked":false,"disliked":false}]},{"slug":"Universal-Script-Camlock-for-npc-and-bot-34964","_id":"67f73cc420cdf8a5f75d9dce","title":"Camlock for npc and bot","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1744256196838.png","placeId":0},"features":"Camlock for npc & bot universal\n\nIt will not work on player only bot and npc and it's laggy I don't know how to fix it\n\nPlease sub to my yt \nhttps://youtube.com/@carlll_54321?si=TxsYG84iBlqLDY9X","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\nlocal RunService = game:GetService(\"RunService\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal UIS = game:GetService(\"UserInputService\")\n\n-- Notification\nStarterGui:SetCore(\"SendNotification\", {\n    Title = \"Camlock ON\",\n    Text = \"Locking camera to NPC's Neck\",\n    Duration = 3\n})\n\n-- GUI\nlocal screenGui = Instance.new(\"ScreenGui\", game:GetService(\"CoreGui\"))\nscreenGui.Name = \"Camlock_GUI\"\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Name = \"CamlockToggle\"\nbutton.Size = UDim2.new(0, 150, 0, 50)\nbutton.Position = UDim2.new(1, -155, 0.1, -25)  -- Button positioned at the top-right corner\nbutton.BackgroundColor3 = Color3.new(0, 0, 0)\nbutton.TextColor3 = Color3.new(1, 1, 1)\nbutton.Text = \"ᴄᴀᴍʟᴏᴄᴋ: ᴏɴ\"\nbutton.Font = Enum.Font.SourceSans\nbutton.TextScaled = true\nbutton.TextSize = 30\nbutton.Parent = screenGui\n\nlocal corner = Instance.new(\"UICorner\", button)\ncorner.CornerRadius = UDim.new(0, 12)\n\n-- Variables for dragging\nlocal dragging = false\nlocal dragInput, dragStart, startPos\n\n-- Function to update the position of the button while dragging\nlocal function update(input)\n    local delta = input.Position - dragStart\n    local newPosition = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\n    -- Smoothly updating button position\n    button.Position = newPosition\nend\n\n-- Detect mouse button down\nbutton.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 then\n        dragging = true\n        dragStart = input.Position\n        startPos = button.Position\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\n-- Detect mouse movement and update button position\nbutton.InputChanged:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseMovement then\n        dragInput = input\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputChanged:Connect(function(input)\n    if dragging and input == dragInput then\n        update(input)\n    end\nend)\n\n-- Find closest NPC and lock onto their neck\nlocal function getClosestNPC()\n    local closest, shortestDist = nil, math.huge\n    for _, obj in ipairs(workspace:GetDescendants()) do\n        if obj:IsA(\"Model\") and obj ~= player.Character then\n            local hum = obj:FindFirstChildWhichIsA(\"Humanoid\")\n            local neck = obj:FindFirstChild(\"Neck\") or obj:FindFirstChild(\"Head\")\n            if hum and neck and hum.Health > 0 then\n                -- Ensure it's not a player\n                local isPlayer = false\n                for _, plr in ipairs(Players:GetPlayers()) do\n                    if plr.Character == obj then\n                        isPlayer = true\n                        break\n                    end\n                end\n\n                if not isPlayer then\n                    local dist = (neck.Position - camera.CFrame.Position).Magnitude\n                    if dist < shortestDist then\n                        shortestDist = dist\n                        closest = neck\n                    end\n                end\n            end\n        end\n    end\n    return closest\nend\n\n-- Camlock Logic\nlocal camlockEnabled = false\nlocal camlockLoop\n\nbutton.MouseButton1Click:Connect(function()\n    camlockEnabled = not camlockEnabled\n    button.Text = camlockEnabled and \"ᴄᴀᴍʟᴏᴄᴋ: ᴏɴ\" or \"ᴄᴀᴍʟᴏᴄᴋ: ᴏғғ\"\n\n    if camlockEnabled then\n        camlockLoop = RunService.RenderStepped:Connect(function()\n            local target = getClosestNPC()\n            if target then\n                camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)\n            end\n        end)\n    else\n        if camlockLoop then camlockLoop:Disconnect() end\n    end\nend)","owner":{"_id":"67df9e1f73dfe8a58f593f3a","username":"Unknown_person","verified":false,"profilePicture":"/images/photo/67df9e1f73dfe8a58f593f3a-1742708372517.jpg","status":"offline","id":"67df9e1f73dfe8a58f593f3a","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":7607,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1744256196838.png","likeCount":2,"dislikeCount":1,"createdAt":"2025-04-10T03:36:36.899Z","executes":99,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f73cc420cdf8a5f75d9dd0","editBy":{"_id":"67df9e1f73dfe8a58f593f3a","username":"Unknown_person","status":"offline","id":"67df9e1f73dfe8a58f593f3a"},"message":"Create script","createdAt":"2025-04-10T03:36:36.903Z"}],"comments":[]},{"slug":"GODLY-Anime-Last-Stand-als-macro-fixed-finally-34958","_id":"67f722149d58a75a22df6d1a","title":"als macro fixed finally","game":{"_id":"67e5e1ffb360710ec3c77e89","gameId":12886143095,"name":"[⏳W3 + ❤️ EVENT] Anime Last Stand","imageUrl":"/images/sb/rbx-7c8b6e9ea5ece773cccb1ad14691ee10-93538a0e93e2.png","placeId":12886143095},"features":"Tons of Auto play features and macro recorder","tags":["Macro Recorder"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/alan11ago/Hub/refs/heads/main/ImpHub.lua\"))()","owner":{"_id":"66c90e1aa14b7e5491866176","username":"Data0292","verified":false,"profilePicture":"/images/user-default.webp","status