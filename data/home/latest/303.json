(\"RunService\")\nlocal lp = players.LocalPlayer\n\nif getgenv().AutoSwingConnection then\n    getgenv().AutoSwingConnection:Disconnect()\n    getgenv().AutoSwingConnection = nil\nend\n\nlocal function fetchRemote()\n    local pGui = lp:FindFirstChild(\"PlayerGui\")\n    local mGui = pGui and pGui:FindFirstChild(\"MainGui\")\n    if not mGui then return nil end\n\n    for _, v in ipairs(mGui:GetChildren()) do\n        if v:IsA(\"RemoteEvent\") and v.Name:match(\"^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$\") then\n            return v\n        end\n    end\n    return nil\nend\n\nlocal targetRemote = fetchRemote()\nlocal seq = 0\n\nif getgenv().AutoSwing then\n    getgenv().AutoSwingConnection = runService.RenderStepped:Connect(function()\n        if not getgenv().AutoSwing then\n            if getgenv().AutoSwingConnection then\n                getgenv().AutoSwingConnection:Disconnect()\n                getgenv().AutoSwingConnection = nil\n            end\n            return\n        end\n\n        if not targetRemote or not targetRemote.Parent then\n            targetRemote = fetchRemote()\n        end\n\n        if targetRemote then\n            local ok = pcall(targetRemote.FireServer, targetRemote, \"SwordSlash\", seq)\n            if ok then\n                seq = seq + 1\n            end\n        end\n    end)\nend","owner":{"_id":"62ca68a7f1c6420928ab0af1","username":"White","verified":false,"profilePicture":"/images/photo/62ca68a7f1c6420928ab0af1-1784978435435.png","status":"offline","id":"62ca68a7f1c6420928ab0af1","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":196,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/4225025295-1784978630104.webp","likeCount":0,"dislikeCount":0,"createdAt":"2026-07-25T11:23:50.134Z","executes":10254,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":10001,"at":"2026-10-03T10:30:04.675Z