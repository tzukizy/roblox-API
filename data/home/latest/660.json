ookfunction = function(func, rep)\n\tfor i,v in pairs(getfenv()) do\n\t\tif v == func then\n\t\t\tgetfenv()[i] = rep\n\t\tend\n\tend\nend\ngetgenv().hookmetamethod = function(func, rep)\n\tfor i,v in pairs(getgenv()) do\n\t\tif v == func then\n\t\t\tgetgenv()[i] = rep\n\t\tend\n\tend\nend","owner":{"_id":"69714e57c2959559a8ed3fc7","username":"dolteddown","verified":false,"profilePicture":"/images/photo/69714e57c2959559a8ed3fc7-1784136994139.png","status":"offline","id":"69714e57c2959559a8ed3fc7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":495,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1776351004418.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-04-16T14:50:04.439Z","keyLink":"","editBy":{"_id":"69714e57c2959559a8ed3fc7","username":"dolteddown","status":"offline","id":"69714e57c2959559a8ed3fc7"},"executes":44,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69e0f71c346b998a00fc889e","editBy":{"_id":"69714e57c2959559a8ed3fc7","username":"dolteddown","status":"offline","id":"69714e57c2959559a8ed3fc7"},"message":"Create script","createdAt":"2026-04-16T14:50:04.445Z"},{"_id":"69e385b2ff9a6bc5508b7288","editBy":{"_id":"69714e57c2959559a8ed3fc7","username":"dolteddown","status":"offline","id":"69714e57c2959559a8ed3fc7"},"message":"Update script","createdAt":"2026-04-18T13:22:58.427Z"}],"comments":[{"_id":"6a04440178585d6eecc1ff8c","commentBy":{"_id":"67b5f12dfba1afb5d0075ae5","username":"IQUITEXPLOITING","verified":false,"role":"user","profilePicture":"/images/photo/67b5f12dfba1afb5d0075ae5-1791140253056.png","createdAt":"2025-02-19T14:56:45.131Z","lastActive":"2026-10-04T18:57:33.040Z","status":"offline","id":"67b5f12dfba1afb5d0075ae5","topMilestone":{"key":"creator.scripts","tier":5}},"text":"what are those pictures bro.","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-13T09:27:29.134Z","liked":false,"dis