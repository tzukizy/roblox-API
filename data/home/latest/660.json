err = pcall(setfenv, 1, Env);\n\tassert(ok, \"[-] setfenv(1, Env) failed: \" .. tostring(err));\n\n\tlocal recheck = getfenv(1);\n\tassert(rawget(recheck, \"__Xeno\") == xeno, \"[-] Post-setfenv __Xeno mismatch\");\n\tassert(rawget(recheck, \"Shared\") == Shared, \"[-] Post-setfenv Shared mismatch\");\n\n\tsetfenv(1, setmetatable(Env, {\n\t\t__index = function(_, k)\n\t\t\tlocal v = rawget(Env, k) or rawget(Shared, k);\n\t\t\tassert(v ~= nil, \"[-] Blocked access to nil global: \" .. tostring(k));\n\t\t\treturn v;\n\t\tend;\n\t\t__newindex = function(_, k, v)\n\t\t\trawset(Env, k, v);\n\t\t\trawset(Shared, k, v);\n\t\tend;\n\t}));\n\nend)]])","owner":{"_id":"67ae2e9be92c0d196f509fac","username":"ThatBoySai","verified":false,"profilePicture":"/images/photo/67ae2e9be92c0d196f509fac-1739468554758.jpg","status":"offline","id":"67ae2e9be92c0d196f509fac"},"verified":false,"views":2281,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1776350897987.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-04-16T14:48:18.024Z","executes":273,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69e0f6b27a2724a0056dc71f","editBy":{"_id":"67ae2e9be92c0d196f509fac","username":"ThatBoySai","status":"offline","id":"67ae2e9be92c0d196f509fac"},"message":"Create script","createdAt":"2026-04-16T14:48:18.031Z"}],"comments":[{"_id":"69e8355828ee2d6ff2874478","commentBy":{"_id":"69d08c9516e15a8c068c63d0","username":"raknetlol","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-09-15T00:51:39.422Z","createdAt":"2026-04-04T03:59:17.991Z","status":"offline","id":"69d08c9516e15a8c068c63d0","topMilestone":{"key":"creator.first_script","tier":1}},"text":"prob a logger","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-22T02:41:28.659Z","liked":false,"disliked":false}]}]}