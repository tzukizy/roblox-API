{"page":483,"totalPages":3690,"count":20,"scripts":[{"slug":"UPDATE-Slap-Battles-*-slap-menu-238179","_id":"6a35a1a0365ad7190805127a","title":"* slap menu","game":{"_id":"67e5e1ffb360710ec3c77dd2","gameId":6403373529,"name":"[UPDATE🏴‍☠️] Slap Battles👏","imageUrl":"/images/sb/rbx-76fedd397e6cb8051ba34ec7fd008737-01d145d931b9.png","placeId":6403373529},"features":"A simple open source script for Slap Battles\nDo whatever you want with it, skid it, use it, whatever\n\nProbably wont get updated, all it is is basic stuff like anti slap. Made as a \"fuck you\" to the dev as an og player\n\nif anyone cares enough to send me an hd image of the menu i'd appreciate it, im too lazy to use it","tags":["op","open source","free","slap battles","* slap"],"script":"local lib = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/laagginq/ui-libraries/main/shit-lib/src.lua\"))()\nlocal win = lib:Create(\"Dick slap\",\"Slap Battles\")\n\n-- tabs\nlocal mainmenu = win:tab(\"Main menu\",true)\nlocal charactercat = win:tab(\"Character\",false)\nlocal world = win:tab(\"World\",false)\nlocal debug = win:tab(\"Debug shit\",false)\n--\n\nlocal localplayer = game.Players.LocalPlayer\nlocal character = localplayer.Character\nlocal rootpart = character.HumanoidRootPart\nlocal RunService = game:GetService(\"RunService\")\n\n-- Variables used in ui\nlocal antihit = false\nlocal slapaura = false\nlocal antifall = nil\n--\n\n-- idk if making it all in one loop is good or bad for performance\nRunService.Heartbeat:Connect(function(idk)\n\n    local character = localplayer.Character\n    local rootpart = character.HumanoidRootPart\n\n    ragdolled = character.Ragdolled.value\n    --anti slap\n    if ragdolled and antihit then\n        rootpart.Anchored = true\n        rootpart.Velocity = Vector3.new(0, 0, 0)\n    else\n        rootpart.Anchored = false\n    end\n    --\nend)\n--\n\nmainmenu:label(\"This is meant to be a showcase of Slap Batlles dogshit anti-cheat\")\nmainmenu:label(\"Made by 8zwj on discord\")\nmainmenu:label(\"Enjoy the script!\")\n\ndebug:label(\"TestLabel\")\n\ndebug:button(\"Print local position\",function()\n    print(rootpart.CFrame)\nend)\n\ndebug:button(\"Test Button\",function()\n    print(\"Button Pressed\")\nend)\n\ndebug:toggle(\"Test Toggle2\",false,function(v)\n    print(v)   \nend)\n\ndebug:input(\"Message\",\"Type Here...\",true,function(v)\n    print(v)    \nend)\n\ncharactercat:toggle(\"Anti knockback V1\",false,function(v)\n    antihit = v\nend)\n\ncharactercat:toggle(\"Hide nametag\",false,function(v)\nlocal character = localplayer.Character\n    if v then\n        character.Head.Nametag.Labels.TopLabel.Text = \"Hidden by Dick Slap V0.67\"\n    else\n        character.Head.Nametag.Labels.TopLabel.Text = character.Name\n    end\nend)\n\nworld:toggle(\"Anti void\",false,function(v)\n    if v == true then\n        local part = Instance.new(\"Part\", workspace)\n        part.Transparency = 0.5\n        part.Anchored = true\n        part.Size = Vector3.new(350, 1.0, 350)\n        part.CFrame = CFrame.new(Vector3.new(0, -12, 0))\n        antifall = part\n    end\n    if v == false then\n        antifall:Destroy()\n    end\nend)","owner":{"_id":"6a241b6105d6212ed6adb847","username":"SomeRandomBadCoder","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6a241b6105d6212ed6adb847","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":3796,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/6403373529-1781899680155.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-06-19T20:08:00.168Z","executes":3424,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a35a1a0365ad7190805127c","editBy":{"_id":"6a241b6105d6212ed6adb847","username":"SomeRandomBadCoder","status":"offline","id":"6a241b6105d6212ed6adb847"},"message":"Create script","createdAt":"2026-06-19T20:08:00.170Z"}]