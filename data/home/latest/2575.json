al Script 📌","imageUrl":"/images/sb/1323685-1742304906240.png","placeId":0},"features":"Bd","tags":[],"script":"local player = game:GetService(\"Players\").LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\n-- Executa o c00lgui 1 segundo antes\ntask.spawn(function()\n    task.wait(1)\n    loadstring(game:HttpGet(\"https://rawscripts.net/raw/Contest!-RetroStudio-as230-10918\"))()\nend)\n\n-- Aguarda o culgui ser adicionado ao PlayerGui\nlocal gui\nrepeat\n    task.wait(0.1)\n    gui = playerGui:FindFirstChild(\"hmm\")\nuntil gui and gui:IsA(\"ScreenGui\")\n\ngui.ResetOnSpawn = false -- Impede que desapareça ao morrer\n\n-- Tornar o Frame dentro do culgui movível\nlocal frame = gui:FindFirstChildWhichIsA(\"Frame\")\n\nif frame then\n    local dragging\n    local dragStart\n    local startPos\n\n    local function onInputBegan(input)\n        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n            dragging = true\n            dragStart = input.Position\n            startPos = frame.Position\n\n            input.Changed:Connect(function()\n                if input.UserInputState == Enum.UserInputState.End then\n                    dragging = false\n                end\n            end)\n        end\n    end\n\n    local function onInputChanged(input)\n        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then\n            local delta = input.Position - dragStart\n            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\n        end\n    end\n\n    frame.InputBegan:Connect(onInputBegan)\n    frame.InputChanged:Connect(onInputChanged)\nend","owner":{"_id":"6741d1abd65cce691b5c71c8","username":"GoodRc7","verified":false,"profilePicture":"/images/photo/6741d1abd65cce691b5c71c8-1777398836350.jpg","status":"offline","id":"6741d1abd65cce