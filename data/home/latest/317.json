huge\n\n\tfor _, mobFolder in mobFolders do\n\t\tfor _, enemy in mobFolder:GetChildren() do\n\t\t\tlocal humanoid = enemy:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tlocal enemyRootPart = enemy:FindFirstChild(\"HumanoidRootPart\")\n\n\t\t\tif humanoid\n\t\t\t\tand humanoid.Health > 0\n\t\t\t\tand enemyRootPart\n\t\t\t\tand enemyRootPart:IsA(\"BasePart\")\n\t\t\tthen\n\t\t\t\tlocal distance = (enemyRootPart.Position - playerRootPart.Position).Magnitude\n\n\t\t\t\tif distance < closestDistance then\n\t\t\t\t\tclosestDistance = distance\n\t\t\t\t\tclosestEnemy = enemy\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tcurrentTarget = closestEnemy\n\n\tif currentTarget then\n\t\tdealDamageRemote:FireServer({ buffer.fromstring(currentTarget.Name) })\n\tend\nend)\n","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":159,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-2b13d11e39a1dbd953073f0ad469220d-09e572f07cf3.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-07-22T10:56:42.800Z","executes":1270,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a60a1eae2c317a7b7a4db85","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2026-07-22T10:56:42.805Z"}],"comments":[]},{"slug":"Amber-Alert-Kaiden-hub-244801","_id":"6a609ff7a3bee6f2fcaa8fdb","title":"Kaiden hub","game":{"_id":"698e1f569cc5132d607c8990","gameId":108730407897379,"name":"Amber Alert","imageUrl":"/images/sb/rbx-b69e9aecc5b84470e56106818579bbb9-766e2fdd68e3.png","placeId":108730407897379},"features":"KAIDEN HUB\nDISCORD https://discord.gg/Kf5CFXxNtC\nST