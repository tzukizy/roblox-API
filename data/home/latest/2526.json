emote\")\n            return rollhook(self, unpack(args))\n        end\n        return rollhook(self, ...)\n    end)\nend\n","owner":{"_id":"67e29805a0d9b412a40b92b0","username":"gehehbrub","verified":false,"profilePicture":"/images/photo/67e29805a0d9b412a40b92b0-1743649432612.jpg","status":"offline","id":"67e29805a0d9b412a40b92b0","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"discord":"https://discord.gg/getswift","views":13314,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"https://tr.rbxcdn.com/180DAY-edcb15cac77f5028ee21eff83f6b0101/500/280/Image/Jpeg/noFilter","likeCount":2,"dislikeCount":3,"createdAt":"2025-04-03T03:01:45.341Z","executes":142,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67edfa197bb36e6a4fb631c8","editBy":{"_id":"67e29805a0d9b412a40b92b0","username":"gehehbrub","status":"offline","id":"67e29805a0d9b412a40b92b0"},"message":"Create script","createdAt":"2025-04-03T03:01:45.344Z"}],"comments":[{"_id":"67ee30b57854dd133f94b0db","commentBy":{"_id":"66e294dec213bb7678acb60d","username":"ProjectScripter200","verified":false,"role":"user","profilePicture":"/images/photo/66e294dec213bb7678acb60d-1726126084062.png","createdAt":"2024-09-12T07:14:38.113Z","lastActive":"2026-08-02T05:41:51.927Z","status":"offline","id":"66e294dec213bb7678acb60d","topMilestone":{"key":"creator.scripts","tier":10}},"text":"Good","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-04-03T06:54:45.035Z","liked":false,"disliked":false}]},{"slug":"SpongeBob-Tower-Defense-UPD-13-fixed-macro-finally-33953","_id":"67edf755c1fa57029ac9a7bc","title":"fixed macro finally","game":{"_id":"67e5e1ffb360710ec3c77e35","gameId":123662243100680,"name":"SpongeBob Tower Defense🍍","imageUrl":"/images/sb/rbx-c3a62fcdf7e0a60cd52456d65f267689-a4f2377cf484.png","placeId":123662243100680},"features":"Alot of features such macro, auto play and etc","tags":["Imp Hub","Macro 