ttps://discord.gg/Pu3RVpdYgd\nlocal Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()\n\nlocal Window = Rayfield:CreateWindow({\n   Name = \"Make and Sell Weapons\",\n   Icon = 0, -- Icon in Topbar. Can use Lucide Icons (string) or Roblox Image (number). 0 to use no icon (default).\n   LoadingTitle = \"loading the script\",\n   LoadingSubtitle = \"by d a r k n e s s\",\n   Theme = \"Default\", -- Check https://docs.sirius.menu/rayfield/configuration/themes\n\n   DisableRayfieldPrompts = false,\n   DisableBuildWarnings = false, -- Prevents Rayfield from warning when the script has a version mismatch with the interface\n\n   ConfigurationSaving = {\n      Enabled = true,\n      FolderName = nil, -- Create a custom folder for your hub/game\n      FileName = \"Big Hub\"\n   },\n\n   Discord = {\n      Enabled = false, -- Prompt the user to join your Discord server if their executor supports it\n      Invite = \"noinvitelink\", -- The Discord invite code, do not include discord.gg/. E.g. discord.gg/ ABCD would be ABCD\n      RememberJoins = true -- Set this to false to make them join the discord every time they load it up\n   },\n\n   KeySystem = false, -- Set this to true to use our key system\n   KeySettings = {\n      Title = \"Untitled\",\n      Subtitle = \"Key System\",\n      Note = \"No method of obtaining the key is provided\", -- Use this to tell the user how to get a key\n      FileName = \"Key\", -- It is recommended to use something unique as other scripts using Rayfield may overwrite your key file\n      SaveKey = true, -- The user's key will be saved, but if you change the key, they will be unable to use your script\n      GrabKeyFromSite = false, -- If this is true, set Key below to the RAW site you would like Rayfield to get the key from\n      Key = {\"Hello\"} -- List of keys that will be accepted by the system, can be RAW file links (pastebin, github etc) or simple strings (\"hello\",\"key22\")\n   }\n})\nlocal MainTab = Window:CreateTab(\"Infinite stuff\", nil) -- Title, Image\n\nlocal Button = MainTab:CreateButton({\n   Name = \"Inf Materials\",\n   Callback = function()\n   local args = {\n    [1] = 99999999999999999999999999999999999999\n}\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Event\"):WaitForChild(\"Train\"):FireServer(unpack(args))\n\n   end,\n})\n\nlocal Button = MainTab:CreateButton({\n   Name = \"Inf Weapons\",\n   Callback = function()\n   local args = {\n    [1] = \"Stick\",\n    [2] = 99999999999999999999999999999999999999\n}\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Event\"):WaitForChild(\"CraftWeapon\"):FireServer(unpack(args))\n\n   end,\n})\n\nlocal Button = MainTab:CreateButton({\n   Name = \"Inf Money\",\n   Callback = function()\nlocal args = {\n    [1] = 99999999999999999999999999999999999999,\n    [2] = 1\n}\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Event\"):WaitForChild(\"SellWeapon\"):FireServer(unpack(args))\n\n   end,\n})\n\nlocal CoolTab = Window:CreateTab(\"Swords n stuff\", nil) -- Title, Image\n\nlocal Button = CoolTab:CreateButton({\n   Name = \"Best Sword\",\n   Callback = function()\nlocal args = {\n    [1] = \"Nebula\",\n    [2] = 0\n}\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Event\"):WaitForChild(\"BuyPower\"):FireServer(unpack(args))\n\n   end,\n})\n\nlocal MiscTab = Window:CreateTab(\"Misc\", nil) -- Title, Image\n\nlocal Button = MiscTab:CreateButton({\n   Name = \"MADE BY D A R K N E S S (SOOOOO SIGMA)\",\n   Callback = function()\n   -- The function that takes place when the button is pressed\n   end,\n})\n","owner":{"_id":"6734fcdc10c2e371e4698123","username":"unknownscripts","verified":false,"profilePicture":"/images/photo/6734fcdc10c2e371e4698123-1736715059397.png","status":"offline","id":"6734fcdc10c2e371e4698123"},"verified":false,"keyLink":"","views":2530,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-19T14:58:43.619Z","dislikeCoun