w(0, 240, 0, 140)\nframe.Position = UDim2.new(0.4, 0, 0.4, 0)\nframe.BackgroundColor3 = Color3.fromRGB(18,18,18)\nframe.Active = true\nframe.Draggable = true\n\n-- Rounded corners\nInstance.new(\"UICorner\", frame).CornerRadius = UDim.new(0, 12)\n\n-- Outline\nlocal stroke = Instance.new(\"UIStroke\", frame)\nstroke.Color = Color3.fromRGB(60,60,60)\nstroke.Thickness = 1.5\n\n-- Title\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1, 0, 0, 35)\ntitle.Text = \"Made by _OpenSource_\"\ntitle.BackgroundTransparency = 1\ntitle.TextColor3 = Color3.fromRGB(200,200,200)\ntitle.Font = Enum.Font.GothamBold\ntitle.TextSize = 14\n\n-- Button\nlocal button = Instance.new(\"TextButton\", frame)\nbutton.Size = UDim2.new(1, -20, 0, 50)\nbutton.Position = UDim2.new(0, 10, 0, 60)\nbutton.Text = \"Inf Speed: OFF\"\nbutton.BackgroundColor3 = Color3.fromRGB(30,30,30)\nbutton.TextColor3 = Color3.new(1,1,1)\nbutton.Font = Enum.Font.GothamSemibold\nbutton.TextSize = 16\n\nInstance.new(\"UICorner\", button).CornerRadius = UDim.new(0, 10)\n\nlocal btnStroke = Instance.new(\"UIStroke\", button)\nbtnStroke.Color = Color3.fromRGB(70,70,70)\n\n--// Vars\nlocal enabled = false\nlocal speed = 9e9\nlocal connection\n\n--// TPWalk\nlocal function startTPWalk()\n\tconnection = RunService.RenderStepped:Connect(function()\n\t\tif humanoid.MoveDirection.Magnitude > 0 then\n\t\t\troot.CFrame = root.CFrame + (humanoid.MoveDirection * speed)\n\t\tend\n\tend)\nend\n\nlocal function stopTPWalk()\n\tif connection then\n\t\tconnection:Disconnect()\n\t\tconnection = nil\n\tend\nend\n\n--// Toggle\nbutton.MouseButton1Click:Connect(function()\n\tenabled = not enabled\n\t\n\tif enabled then\n\t\tbutton.Text = \"Inf Speed: ON\"\n\t\tbutton.BackgroundColor3 = Color3.fromRGB(0,170,127)\n\t\tstartTPWalk()\n\telse\n\t\tbutton.Text = \"Inf Speed: OFF\"\n\t\tbutton.BackgroundColor3 = Color3.fromRGB(30,30,30)\n\t\tstopTPWalk()\n\tend\nend)\n\n--// Respawn Fix\nplayer.CharacterAdded:Connect(function()\n\tchar, humanoid, root = getChar()\n\tif enabled then\n\t\tstartTPWalk()\n\tend\nend)","owner":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","verified":false,"profilePicture":"/images/photo/67cbc14c6e7623d225a5710a-1773700040553.jpg","status":"offline","id":"67cbc14c6e7623d225a5710a","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":928,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-d72912cf9bac36b4083025b0b8db3ff2-15fa2ebc2255.png","likeCount":2,"dislikeCount":0,"createdAt":"2026-03-22T19:40:02.092Z","executes":633,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c04592a15e82ee43d95c99","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status":"offline","id":"67cbc14c6e7623d225a5710a"},"message":"Create script","createdAt":"2026-03-22T19:40:02.102Z"}],"comments":[]},{"slug":"Battle-Cat-Training-Battle-Kitty-Training-136334","_id":"69b8f5d91526fb78b4ff8ac5","title":"Battle Kitty Training","game":{"_id":"695e5f043593559f369f0a5e","gameId":131084656246311,"name":"Battle Cat Training🐾","imageUrl":"/images/sb/rbx-d72912cf9bac36b4083025b0b8db3ff2-15fa2ebc2255.png","placeId":131084656246311},"features":"Auto Train Best Area(Infinite Stats)\nAuto Rebirth\nInfinite Spins","tags":["Battle Cat Training"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/gumanba/Scripts/main/BattleCatTraining\"))()","owner":{"_id":"695b667d8dddd1f8e43c7e6c","username":"HerbalLemonade","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"695b667d8dddd1f8e43c7e6c","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":857,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-d72912cf9bac36b4083025b0b8db3ff2-15fa2ebc2255.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-03-17T06:34:01.019Z","k