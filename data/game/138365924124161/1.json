":"2026-02-03T04:21:36.673Z","status":"offline","id":"698177d04bfacc3469fd4dc4","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/306f20462c40057b78208f2029771a43c7e85ade11562aeddc45bbd76c965e73.webp","original":"https://scriptblox.com/images/photo/698177d04bfacc3469fd4dc4-1770092650538.png"}},"text":"nevermind i did it","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-25T05:58:06.986Z","liked":false,"disliked":false}]},{"_id":"67efecdddaffc15eda33c465","title":"Backroom Drift Autofarm (OPEN SOURCE)","game":{"_id":"67e5e1ffb360710ec3c78144","gameId":138365924124161,"name":"Backrooms Drift [🛟]","imageUrl":{"url":"https://media.kocakz.me/9ab6a3315183004c4a5277d7ee469acb379e1c71e213bbff0172381fb146c2fc.webp","original":"https://tr.rbxcdn.com/180DAY-82d8259c924f97429e6c088326eae7dd/150/150/Image/Png/noFilter"},"slug":"138365924124161-backrooms-drift","path":"/game/138365924124161-backrooms-drift","thumbnail":{"url":"https://media.kocakz.me/9ab6a3315183004c4a5277d7ee469acb379e1c71e213bbff0172381fb146c2fc.webp","original":"https://tr.rbxcdn.com/180DAY-82d8259c924f97429e6c088326eae7dd/150/150/Image/Png/noFilter"},"placeId":138365924124161},"slug":"Backrooms-Drift-Backroom-Drift-34108","verified":false,"key":false,"keyless":false,"views":9900,"executes":454,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-5b70a687ed6de376d6723b3e1dcf2158/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-5b70a687ed6de376d6723b3e1dcf2158/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-5b70a687ed6de376d6723b3e1dcf2158/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-5b70a687ed6de376d6723b3e1dcf2158/500/280/Image/Jpeg/noFilter"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-04-04T14:29:49.101Z","updatedAt":"2025-04-04T14:29:49.101Z","lastBump":"2025-04-04T14:29:49.101Z","script":"-- The script teleports only when you get into the car and run the script, to stop the script just get out of the car\n-- Get the current player\nlocal player = game.Players.LocalPlayer\n\n-- Check that the player exists\nif player then\n    -- Get the player ID\n    local playerID = player.UserId\n\n - Function for finding the player's car by ID via the PlayerId attribute\n    function findPlayerCarByID(playerID)\n        for _, car in pairs(game.Workspace.Cars:GetChildren()) do\n            if car:IsA(\"Model\") and car:GetAttribute(\"PlayerId\") then\n                local ownerID = car:GetAttribute(\"PlayerId\")\n                if ownerID == playerID then\n                    return car\n                end\n            end\n        end\n        return nil\n    end\n\n- Find the player's car\n    local playerCar = findPlayerCarByID(playerID)\n\n    if playerCar then\n        -- Set the PrimaryPart of the car if it is not done in the game\n        playerCar.PrimaryPart = playerCar:FindFirstChild(\"Chassis\")\n\n        -- Function for teleporting the car by coordinates\n        function teleportCarToPosition(targetCFrame)\n            if playerCar and playerCar.PrimaryPart then\n                playerCar:SetPrimaryPartCFrame(targetCFrame)\n            end\n        end\n\n        -- Function for teleporting to each coin\n        function teleportToCoins()\n            -- Find the folder with coins\n            local coinsFolder = game.Workspace.CoinsSetup.CoinsFolder\n\n            -- Loop through all the coins in the folder\n            for _, coin in ipairs(coinsFolder:GetChildren()) do\n               -- Check if the object has a CFrame (it should be a coin)\n                if coin:IsA(\"BasePart\") then\n                   -- Get the current coordinates of the coin\n                    local coinPosition = coin.Position\n\n                    -- Add 5 units to the height (y-coordinate)\n                    local newPosition = Vector3.new(coinPosition.X, coinPosition.Y + 1, coinPosition.Z)\n\n                    -- Teleport the car to the new position\n                    teleportCarToPosition(CFrame.new(newPosition))\n\n                    wait(0.2) -- A small delay between teleports\n                end\n            end\n        end\n\n        -- The main function that will be repeated when all coins are processed\n        while true do\n            -- Teleport to the coins\n            teleportToCoins()\n        end\n    end\nend","features":"You MUST spawn a car first ,then you excecute the script\nSo how this scripts works ,is when you excecute it,it will start teleporting the car,which you re sitting and teleporting to different places in map to get the points.\n\nTIP: USE THE PRIVATE SERVER TO  AUTOFARM SO YOU WON'T BE CAUGHT.\n\nWARNING: I AM NOT RESPONSIBLE FOR YOU GETTING BANNED!!!\n\nCredit: Stitch20130 on github","tags":[],"discord":"","keyLink":"","owner":{"_id":"67dbbb614f3217284c3d00a7","username":"CreepyPyscho","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67dbbb614f3217284c3d00a7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:10:05.014Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67efecdddaffc15eda33c467","editBy":{"_id":"67dbbb614f3217284c3d00a7","username":"CreepyPyscho","status":"offline","id":"67dbbb614f3217284c3d00a7"},"message":"Backroom Drift Autofarm Script","createdAt":"2025-04-04T14:29:49.104Z"},{"_id":"67efeec5fe214fe6301fe892","editBy":{"_id":"67dbbb614f3217284c3d00a7","u