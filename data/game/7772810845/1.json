a705df257534de845aff5eaa3cc9b0ff0cb5c39e.webp","original":"https://scriptblox.com/images/sb/7772810845-1786549496397.webp","scriptblox":"https://scriptblox.com/images/script/7772810845-1786549496397.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-08-12T15:44:56.431Z","keyLink":"","executes":4767,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T00:48:12.065Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/7922104e44bea399fd77e847a705df257534de845aff5eaa3cc9b0ff0cb5c39e.webp","original":"https://scriptblox.com/images/sb/7772810845-1786549496397.webp","scriptblox":"https://scriptblox.com/images/script/7772810845-1786549496397.webp"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a7c94f8410bb70b34e29777","editBy":{"_id":"69514c778cf31e083b206ec1","username":"INFINR0R","status":"offline","id":"69514c778cf31e083b206ec1"},"message":"Create script","createdAt":"2026-08-12T15:44:56.435Z"}],"comments":[]},{"slug":"2X-POINTS-The-Presentation-Experience-Anti-Sit-221444","_id":"6a11c19267eac9dfe24c0e67","title":"Anti Sit","game":{"_id":"67e5e1ffb360710ec3c784bd","gameId":7772810845,"name":"[2X POINTS] The Presentation Experience","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":7772810845},"features":"lets you get out of your chair in the presentation experience","tags":["free","xeno","bypass"],"script":"\nlocal TARGET_WALKSPEED = 16\nlocal TARGET_JUMPPOWER = 50\n\nlocal lastDeathPosition = nil\nlocal isTeleporting = false\n\nlocal player = game:GetService(\"Players\").LocalPlayer\nlocal RunService = game:GetService(\"RunService\")\n\n-- Function to handle character setup\nlocal function onCharacterAdded(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n    local rootPart = character:WaitForChild(\"HumanoidRootPart\")\n    \n    humanoid.UseJumpPower = true\n    \n    if lastDeathPosition and isTeleporting then\n        task.wait(0.1)\n        rootPart.CFrame = CFrame.new(lastDeathPosition)\n        isTeleporting = false\n    end\n    \n    humanoid.Died:Connect(function()\n        if rootPart then\n            lastDeathPosition = rootPart.Position\n            isTeleporting = true\n        end\n    end)\n    \n    -- Connects directly to the engine's frame render steps to continuously force values\n    \n    local connection1\n    local connection2\n    \n    connection1 = RunService.Heartbeat:Connect(function()\n        if character:IsDescendantOf(game) and humanoid.Health > 0 then\n            humanoid.WalkSpeed = TARGET_WALKSPEED\n            humanoid.JumpPower = TARGET_JUMPPOWER\n        else\n            connection1:Disconnect()\n        end\n    end)\n\n    connection2 = RunService.PreSimulation:Connect(function()\n        if character:IsDescendantOf(game) and humanoid.Health > 0 then\n            humanoid.WalkSpeed = TARGET_WALKSPEED\n            humanoid.JumpPower = TARGET_JUMPPOWER\n        else\n            connection2:Disconnect()\n        end\n    end)\nend\n\n-- Connect to characters\nif player.Character then\n    task.spawn(onCharacterAdded, player.Character)\nend\nplayer.CharacterAdded:Connect(onCharacterAdded)\n\n-- Initial reset\nif player.Character and player.Character:FindFirstChild(\"Humanoid\") then\n    player.Character.Humanoid.Health = 0\nend","owner":{"_id":"69feb39598745f0ca0a03455","username":"509clint_dev","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/d0dfbf2b9c9423c6faea25758c4a713a4f7380fbe9754bc380a436ad3ac53c5d.webp","original":"https://scriptblox.com/images/photo/69feb39598745f0ca0a03455-1778299852917.png"},"status":"offline","id":"69feb39598745f0ca0a03455","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/d0dfbf2b9c9423c6fa