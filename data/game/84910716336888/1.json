{"id":84910716336888,"name":"[JOBS] Oxford Response","desc":"📍 Oxford Roleplay is an experience based in Oxford, England, UK. \n\n💼 Become Police, Ambulance, Highways, Criminal, Firefighter, Taxi or Delivery driver!\n\n🗺️ Explore the English countryside or explore the busy city of Oxford. Meet new friends and experience an authentic British RP experience!\n\n❓ If you need help, make sure to check out our in-experience tutorials menu!\n\n🔨 Developed by Oxford Team and Contributors\n(Formerly known as Oxford Response)","path":"/game/84910716336888-oxford-response","slug":"84910716336888-oxford-response","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"playing":63,"visitor":7623297,"verified":false,"updatedAt":"2025-10-24T17:56:54.620Z","creator":{"name":"Oxford Team","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Update-Oxford-Response-Infinite-Fuel-60508","_id":"68fbbde605404d7d6a721076","title":"Infinite Fuel [UPDATED]","game":{"_id":"68fbbde605404d7d6a721073","gameId":84910716336888,"name":"[JOBS] Oxford Response","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":84910716336888},"features":"UPDATED ON 11/22\n\nJOIN THE GAME, SPAWN THE VEHICLE, EXECUTE THE SCRIPT","tags":[],"script":"function modifyCurrentVehicleFuel(action)\n    local player = game.Players.LocalPlayer\n    local character = player.Character\n    \n    if not character then\n        return false\n    end\n    \n    local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    if not humanoid or not humanoid.SeatPart then\n        return false\n    end\n    \n    local vehicle = humanoid.SeatPart:FindFirstAncestorOfClass(\"Model\")\n    if not vehicle then\n        return false\n    end\n    \n    if action == \"infinite\" then\n        if vehicle:FindFirstChild(\"States\") then\n            local states = vehicle.States\n            if states:FindFirstChild(\"Fuel\") and states.Fuel:IsA(\"NumberValue\") then\n                states.Fuel.Value = math.huge\n                return true\n            end\n        end\n    elseif action == \"remove\" then\n        if vehicle:FindFirstChild(\"Fuel\") then\n            vehicle.Fuel:Destroy()\n            return true\n        end\n    end\n    \n    return false\nend\n\n\nmodifyCurrentVehicleFuel(\"infinite\")  \nmodifyCurrentVehicleFuel(\"remove\")   ","owner":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","verified":false,"profilePicture":{"url":"https://media.kocakz.me/64f1b3fc65386d1cf7e69bee45e07a492c47c0f499ac7d51bc7da9f3c60b0f76.webp","original":"https://scriptblox.com/images/photo/65f05c0f67f2033080cb423d-1782059529971.jpg"},"status":"offline","id":"65f05c0f67f2033080cb423d","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/64f1b3fc65386d1cf7e69bee45e07a492c47c0f499ac7d51bc7da9f3c60b0f76.webp","original":"https://scriptblox.com/images/photo/65f05c0f67f2033080cb423d-1782059529971.jpg"}},"verified":false,"discord":"https://discord.gg/amB9GCbYDj","views":2921,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/9646528ba9477e36e3887c6e88f126336e9eea269c4e022ac4042bd032ace492.webp","original":"https://scriptblox.com/images/sb/84910716336888-1763831432937.webp","scriptblox":"https://scriptblox.com/images/script/84910716336888-1763831432937.webp"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-10-24T17:56:54.621Z","keyLink":"","editBy":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","status":"offline","id":"65f05c0f67f2033080cb423d"},"executes":122,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:10:58.631Z","last":"","win