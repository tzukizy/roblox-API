{"id":89072926726733,"name":"[🌎] Cross the Road for Brainrot🚗","desc":"Welcome to Cross the Road for Brainrot! 🚗\n\nRun fast and grab Brainrots! 🏃\nAvoid cars when they come! 🚗\nStay alive and collect many Brainrots! ⚡\nUpgrade your base to unlock more slots and place extra Brainrots! 🏗️\nUpgrade your Brainrots to get more money! 💸\n\nYour Brainrots earn cash OFFLINE! 💤\n\nLike the game and join the group for FREE RARE BRAINROT! 👍\n\nFounder: @XXsuperninjaXXop","path":"/game/89072926726733-cross-the-road-for-brainrot","slug":"89072926726733-cross-the-road-for-brainrot","thumbnail":{"url":"https://media.kocakz.me/b836e8948f0a379f635e562c5e01a7d91f4e861a0650057d4ac5ec2521270af1.webp","original":"https://tr.rbxcdn.com/180DAY-758c279be3391319acc7e2667efcb2a1/150/150/Image/Png/noFilter"},"playing":43,"visitor":32539151,"verified":false,"updatedAt":"2026-07-10T14:53:07.876Z","creator":{"name":"Mondials","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"6a510753a2cddf12b9ba6387","title":"Open Source Auto Farm","game":{"_id":"69bd518588a9c0cf64db4144","gameId":89072926726733,"name":"[🌎] Cross the Road for Brainrot🚗","imageUrl":{"url":"https://media.kocakz.me/b836e8948f0a379f635e562c5e01a7d91f4e861a0650057d4ac5ec2521270af1.webp","original":"https://tr.rbxcdn.com/180DAY-758c279be3391319acc7e2667efcb2a1/150/150/Image/Png/noFilter"},"slug":"89072926726733-cross-the-road-for-brainrot","path":"/game/89072926726733-cross-the-road-for-brainrot","thumbnail":{"url":"https://media.kocakz.me/b836e8948f0a379f635e562c5e01a7d91f4e861a0650057d4ac5ec2521270af1.webp","original":"https://tr.rbxcdn.com/180DAY-758c279be3391319acc7e2667efcb2a1/150/150/Image/Png/noFilter"},"placeId":89072926726733},"slug":"Cross-the-Road-for-Brainrot-Open-Source-Auto-Farm-242219","verified":false,"key":false,"keyless":false,"views":1421,"executes":94,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/ec7179c6b1c17a2a9d780c282d7b65b1b88b92356666d69e318725be8c4edaf7.webp","original":"https://scriptblox.com/images/sb/rbx-6b9d905da96ab3ce005e2c237f3c1401-c21ba625591c.png","scriptblox":"https://scriptblox.com/images/script/rbx-6b9d905da96ab3ce005e2c237f3c1401-c21ba625591c.png"},"thumbnail":{"url":"https://media.kocakz.me/ec7179c6b1c17a2a9d780c282d7b65b1b88b92356666d69e318725be8c4edaf7.webp","original":"https://scriptblox.com/images/sb/rbx-6b9d905da96ab3ce005e2c237f3c1401-c21ba625591c.png","scriptblox":"https://scriptblox.com/images/script/rbx-6b9d905da96ab3ce005e2c237f3c1401-c21ba625591c.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-10T14:53:07.877Z","updatedAt":"2026-07-10T14:53:07.877Z","lastBump":"2026-07-10T14:53:07.877Z","script":"local player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal rootPart = char:WaitForChild(\"HumanoidRootPart\")\nlocal VirtualInputManager = game:GetService(\"VirtualInputManager\")\n\nlocal SpawnerFolder = workspace:WaitForChild(\"ItemSpawners\")\n-- Define priority (Add more names here if needed)\nlocal RarityPriority = {\"Celestial\", \"Secret\", \"Mythical\", \"Legendary\", \"Epic\", \"Rare\", \"Common\"}\n\nlocal function pressE()\n    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)\n    task.wait(0.1)\n    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)\nend\n\nwhile true do\n    local baseCFrame = workspace.Plot_Blo3g.Floor1.PlotStand:GetChildren()[5].CFrame\n\n    -- Loop through the priority list to grab the best ones first\n    for _, rarityName in ipairs(RarityPriority) do\n        local rarityFolder = SpawnerFolder:FindFirstChild(rarityName)\n        \n        if rarityFolder then\n            for _, itemModel in pairs(rarityFolder:GetChildren()) do\n                if itemModel:IsA(\"Model\") then\n                    local target = itemModel.PrimaryPart or itemModel:FindFirstChildWhichIsA(\"BasePart\")\n                    \n                    if target then\n                        -- Teleport to brainrot\n                        rootPart.CFrame = target.CFrame + Vector3.new(0, 5, 0)\n                        task.wait(0.5)\n                        \n                        -- Claim it\n                        pressE()\n                        task.wait(0.5)\n                        \n                        -- Back to base\n                        rootPart.CFrame = baseCFrame\n                        task.wait(0.5)\n                    end\n                end\n            end\n        end\n    end\n    task.wait(1) -- Wait a second before starting the next full sweep\nend","features":"Brainrot games are really vulnerable so yea","tags":[],"discord":"","keyLink":"","owner":{"_id":"69da60492b4a2ad15b57f1e7","username":"cccsz","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ab531a879fae8c1432e64c33b1ec9ef72215bbaf1505efc1b72977147f8c69d9.webp","original":"https://scriptblox.com/images/photo/69da60492b4a2ad15b57f1e7-1777375646827.jpg"},"status":"offline","id":"69da60492b4a2ad15b57f1e7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/ab531a879fae8c1432e64c33b1ec9ef72215bbaf1505efc1b72977147f8c69d9.webp","original":"https://scriptblox.com/images/photo/69da60492b4a2ad15b57f1e7-1777375646827.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:36:18.516Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a510753a2cddf12b9ba6389","editBy":{"_id":"69da60492b4a2ad15b57f1e7","username":"cccsz","status":"offline","id":"69da60492b4a2ad15b57f1e7"},"message":"Create script","createdAt":"2026-07-10T14:53:07.881Z"}],"comments":[{"_id":"6a513f6409d0b5c78488a79f","commentBy"