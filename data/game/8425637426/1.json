\"HumanoidRootPart\")\n\nlocal TARGET_POSITION = Vector3.new(-655, 31, 1157)\n\nlocal function pressF()\n    local VIM = game:GetService(\"VirtualInputManager\")\n    VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)\n    task.wait(0.1)\n    VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)\nend\n\nlocal function run()\n    local originalCFrame = humanoidRootPart.CFrame\n\n    humanoidRootPart.CFrame = CFrame.new(TARGET_POSITION)\n\n    task.wait(0.2)\n    pressF()\n\n    task.wait(0.3)\n    humanoidRootPart.CFrame = originalCFrame\nend\n\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n    if input.KeyCode == Enum.KeyCode.F then\n        run()\n    end\nend)\n","features":"Snowball! (you get snowball by pressing \"F\" key then u tp back to where you were)","tags":[],"discord":"","keyLink":"","owner":{"_id":"69a9c6e5dfe464b9183a5919","username":"Tubiu","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a33a609672673992f7aa39f433c4e66331fdb655b7498fabc27058844c4da7db.webp","original":"https://scriptblox.com/images/photo/69a9c6e5dfe464b9183a5919-1773951697213.jpg"},"status":"offline","id":"69a9c6e5dfe464b9183a5919","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/a33a609672673992f7aa39f433c4e66331fdb655b7498fabc27058844c4da7db.webp","original":"https://scriptblox.com/images/photo/69a9c6e5dfe464b9183a5919-1773951697213.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:25:36.091Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69bc55d4ec95ce09d1673139","editBy":{"_id":"69a9c6e5dfe464b9183a5919","username":"Tubiu","status":"offline","id":"69a9c6e5dfe464b9183a5919"},"message":"Create script","createdAt":"2026-03-19T20:00:20.998Z"}],"comments":[{"_id":"69cf7