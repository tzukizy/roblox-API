{"id":72881059853962,"name":"🧲 Magnet Fishing [Alpha]","desc":"⚠️ This game is in alpha so please report bugs. Lots more content coming soon!\n\nWelcome to Magnet Fishing!\n\n🔹 Fish for rare and limited treasures!\n🔹 Improve your magnets and rods to increase your luck\n🔹 Travel to different locations filled with quests, special items, and events!\n🔹 Use your finds to decorate your home and make it your collector's paradise!\n🔹 Use potions to enhance your luck and increase your chances of pulling up shiny or ultra-rare items!\n\nLeave a like if you enjoyed it! ","path":"/game/72881059853962-magnet-fishing","slug":"72881059853962-magnet-fishing","thumbnail":{"url":"https://media.kocakz.me/4fdf78e1f8534aa025803a302de6cd9382b5feb68bd9f79cfe69de08b4f7d758.webp","original":"https://tr.rbxcdn.com/180DAY-35799bd3de240b97156748c25c23aaca/150/150/Image/Png/noFilter"},"playing":2,"visitor":33480217,"verified":false,"updatedAt":"2025-03-27T11:23:28.741Z","creator":{"name":"Magnet Fishing","type":"Group"},"script":{"count":4,"freeCount":4,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"67e53530355683b49ff8a32f","title":"Auto Sink , Huge Sink , Sell","game":{"_id":"67e5e1ffb360710ec3c77d35","gameId":72881059853962,"name":"🧲 Magnet Fishing [Alpha]","imageUrl":{"url":"https://media.kocakz.me/4fdf78e1f8534aa025803a302de6cd9382b5feb68bd9f79cfe69de08b4f7d758.webp","original":"https://tr.rbxcdn.com/180DAY-35799bd3de240b97156748c25c23aaca/150/150/Image/Png/noFilter"},"slug":"72881059853962-magnet-fishing","path":"/game/72881059853962-magnet-fishing","thumbnail":{"url":"https://media.kocakz.me/4fdf78e1f8534aa025803a302de6cd9382b5feb68bd9f79cfe69de08b4f7d758.webp","original":"https://tr.rbxcdn.com/180DAY-35799bd3de240b97156748c25c23aaca/150/150/Image/Png/noFilter"},"placeId":72881059853962},"slug":"Magnet-Fishing-Alpha-Auto-sink-33429","verified":false,"key":false,"keyless":false,"views":9888,"executes":2601,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-612a283b5d5989d7cf5adc3488285afa/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-612a283b5d5989d7cf5adc3488285afa/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-612a283b5d5989d7cf5adc3488285afa/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-612a283b5d5989d7cf5adc3488285afa/500/280/Image/Jpeg/noFilter"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-03-27T11:23:28.741Z","updatedAt":"2025-03-27T11:23:28.741Z","lastBump":"2025-03-27T11:23:28.741Z","script":"local VirtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal player = game:GetService(\"Players\").LocalPlayer\nlocal magnetDropper = player.PlayerGui:WaitForChild(\"MagnetDropper\")\nlocal mainFrame = magnetDropper:WaitForChild(\"Main\")\nlocal replicatedStorage = game:GetService(\"ReplicatedStorage\")\n\ntask.spawn(function()\n    while true do\n        replicatedStorage.Events.Recycle.SellAllItems:InvokeServer()\n        task.wait(1)\n    end\nend)\n\nlocal function clickMagnetFrame(magnetFrame)\n    for _, button in ipairs(magnetFrame:GetDescendants()) do\n        if button:IsA(\"TextButton\") or button:IsA(\"ImageButton\") then\n            local absPos = button.AbsolutePosition\n            local absSize = button.AbsoluteSize\n            local clickPos = absPos + (absSize / 2)\n            VirtualInputManager:SendMouseButtonEvent(clickPos.X, clickPos.Y, 0, true, game, 0)\n            VirtualInputManager:SendMouseButtonEvent(clickPos.X, clickPos.Y, 0, false, game, 0)\n            break\n        end\n    end\nend\n\nmainFrame.ChildAdded:Connect(function(child)\n    if child.Name == \"MagnetFrame\" then\n        clickMagnetFrame(child)\n    end\nend)\n\nlocal magnetFrame = mainFrame:FindFirstChild(\"MagnetFrame\")\nif magnetFrame then\n    clickMagnetFrame(magnetFrame)\nend\n\nwhile true do\n    local magnetFrame = magnetDropper:FindFirstChild(\"Main\") and magnetDropper.Main:FindFirstChild(\"MagnetFrame\")\n    if magnetFrame then\n        magnetFrame.Size = UDim2.new(2, 200, 2, 100)\n        magnetFrame.Position = UDim2.new(0.5, 50, 0.48, -50)\n    end\n    wait(0.1)\nend\n","features":"auto clicks sink \nHuge sink\nauto sell\nMade by: ChatGPT","tags":["MagnetDropper","Magnet Fishing","Auto click","Auto sell"],"discord":"","keyLink":"","owner":{"_id":"677a91b08b3310d4b7ffec95","username":"1qu09x","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"677a91b08b3310d4b7ffec95","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:00:23.393Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4ddf5","editBy":{"_id":"677a91b08b3310d4b7ffec95","username":"1qu09x","status":"offline","id":"677a91b08b3310d4b7ffec95"},"message":"Create script","createdAt":"2025-03-27T11:27:35.345Z"},{"_id":"67e5e1e3b360710ec3c4ddf6","editBy":{"_id":"677a91b08b3310d4b7ffec95","username":"1qu09x","status":"offline","id":"677a91b08b3310d4b7ffec95"},"message":"Update script","createdAt":"2025-03-27T17:52:34.383Z"},{"_id":"67e5e1e7b360710ec3c56089","editBy":{"_id":"677a91b08b3310d4b7ffec95","username":"1qu09x","status":"offline","id":"677a91b08b3310d4b7ffec95"},"message":"Update script","createdAt":"2025-03-27T23:12:57.371Z"}],"comments":[{"_id":"67e576d639f9d74f690a8fc1","commentBy":{"_id":"63303d169cd17a2ff7f7c74b","username":"AnonymousEmber","verified":false,"role":"user","profilePicture":{"url":"