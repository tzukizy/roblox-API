ions() end","owner":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","verified":false,"profilePicture":"/images/photo/66586c9dd2eb807842220c4b-1718738198099.png","status":"offline","id":"66586c9dd2eb807842220c4b","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"keyLink":"","views":38531,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-22T19:27:08.266Z","dislikeCount":0,"likeCount":0,"image":"https://tr.rbxcdn.com/709ae51beb23d47fdb496d8afb574139/500/280/Image/Jpeg","executes":42,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c847","editBy":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","status":"offline","id":"66586c9dd2eb807842220c4b"},"message":"Create script","createdAt":"2024-07-22T19:37:44.661Z"},{"_id":"67e5e1e3b360710ec3c4c848","editBy":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","status":"offline","id":"66586c9dd2eb807842220c4b"},"message":"Update script","createdAt":"2024-07-22T19:40:40.767Z"},{"_id":"67e5e1e3b360710ec3c4c849","editBy":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","status":"offline","id":"66586c9dd2eb807842220c4b"},"message":"Update script","createdAt":"2024-07-22T19:43:09.925Z"},{"_id":"67e5e1e3b360710ec3c4c84a","editBy":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","status":"offline","id":"66586c9dd2eb807842220c4b"},"message":"Update script","createdAt":"2024-07-22T20:09:14.624Z"},{"_id":"67e5e1e3b360710ec3c4c84b","editBy":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","status":"offline","id":"66586c9dd2eb807842220c4b"},"message":"Update script","createdAt":"2024-07-23T19:13:17.272Z"},{"_id":"67e5e1e5b360710ec3c5172f","editBy":{"_id":"66586c9dd2eb807842220c4b","username":"KyloSillyReal","status":"offline","id":"66586c9dd2eb807842220c4b"},"message":"Update script","createdAt":"2025-03-27T11:36:03.396Z"}],"