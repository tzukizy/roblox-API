hild(\"RE\"):WaitForChild(\"Customize\")\n\n-- UI Setup\nlocal sg = Instance.new(\"ScreenGui\", gui)\nsg.Name = \"LuckySpinUI\"\nsg.ResetOnSpawn = false\n\nlocal frm = Instance.new(\"Frame\")\nfrm.Size = UDim2.new(0, 260, 0, 160)\nfrm.Position = UDim2.new(0, 30, 0, 30)\nfrm.BackgroundColor3 = Color3.fromRGB(25, 25, 30)\nfrm.BackgroundTransparency = 0.1\nfrm.BorderSizePixel = 0\nfrm.Parent = sg\nfrm.Active = true\nfrm.Draggable = true\n\nlocal shadow = Instance.new(\"ImageLabel\", frm)\nshadow.AnchorPoint = Vector2.new(0.5, 0.5)\nshadow.Position = UDim2.new(0.5, 0, 0.5, 4)\nshadow.Size = UDim2.new(1, 20, 1, 20)\nshadow.BackgroundTransparency = 1\nshadow.Image = \"rbxassetid://1316045217\"\nshadow.ImageColor3 = Color3.fromRGB(0, 0, 0)\nshadow.ImageTransparency = 0.85\nshadow.ScaleType = Enum.ScaleType.Slice\nshadow.SliceCenter = Rect.new(10, 10, 118, 118)\nshadow.ZIndex = -1\n\nlocal corner = Instance.new(\"UICorner\", frm)\ncorner.CornerRadius = UDim.new(0, 14)\n\n-- Style label\nlocal lbl = Instance.new(\"TextLabel\", frm)\nlbl.Size = UDim2.new(1, -40, 0, 30)\nlbl.Position = UDim2.new(0, 20, 0, 16)\nlbl.BackgroundTransparency = 1\nlbl.TextColor3 = Color3.fromRGB(255, 255, 255)\nlbl.Font = Enum.Font.FredokaOne\nlbl.TextScaled = true\nlbl.Text = \"Style: ...\"\n\n-- Spin button\nlocal btn = Instance.new(\"TextButton\", frm)\nbtn.Size = UDim2.new(1, -60, 0, 38)\nbtn.Position = UDim2.new(0, 30, 0, 62)\nbtn.Text = \"Lucky (Ready)\"\nbtn.Font = Enum.Font.GothamBold\nbtn.TextScaled = true\nbtn.TextColor3 = Color3.new(1, 1, 1)\nbtn.BackgroundColor3 = Color3.fromRGB(0, 180, 255)\nbtn.AutoButtonColor = false\n\nlocal btnCorner = Instance.new(\"UICorner\", btn)\nbtnCorner.CornerRadius = UDim.new(0, 10)\n\nbtn.MouseEnter:Connect(function()\n\tbtn.BackgroundColor3 = Color3.fromRGB(0, 150, 230)\nend)\nbtn.MouseLeave:Connect(function()\n\tbtn.BackgroundColor3 = Color3.fromRGB(0, 180, 255)\nend)\n\n-- Credit label\nlocal credit = Instance.new(\"TextLabel\", frm)\ncredit.Size = UDim2.new(1, 0, 0, 20)\ncredit.Position = UDim2.new(0, 0, 1, -26)\ncredit.BackgroundTransparency = 1\ncredit.TextColor3 = Color3.fromRGB(160, 160, 160)\ncredit.Text = \"Made by Kenny\"\ncredit.Font = Enum.Font.GothamSemibold\ncredit.TextScaled = true\n\n-- Helper functions\nlocal function getStyle()\n\treturn style.Value\nend\n\nlocal function updateLabel()\n\tlbl.Text = \"Style: \" .. getStyle()\n\treturn getStyle()\nend\n\nlocal function lucky()\n\tbtn.Text = \"Lucky (Running...)\"\n\tlocal ok = false\n\n\t-- Fast forced spin\n\tfor _ = 1, 15 do\n\t\tspin:FireServer(true)\n\t\ttask.wait(0.1)\n\t\tlocal s = getStyle()\n\t\tfor _, t in ipairs(targets) do\n\t\t\tif s == t then ok = true break end\n\t\tend\n\t\tif ok then break end\n\tend\n\n\t-- Normal spins\n\tif not ok then\n\t\tfor _ = 1, 4 do\n\t\t\tspin:FireServer(false)\n\t\t\ttask.wait(0.1)\n\t\t\tlocal s = getStyle()\n\t\t\tfor _, t in ipairs(targets) do\n\t\t\t\tif s == t then ok = true break end\n\t\t\tend\n\t\t\tif ok then break end\n\t\tend\n\tend\n\n\tif ok then\n\t\tbtn.Text = \"Lucky (Success)\"\n\t\ttask.wait(1)\n\t\tupdateLabel()\n\t\treturn\n\tend\n\n\troll:FireServer(\"Emotes\", \"Default\", \"2\\255\")\n\ttask.wait(1.2)\n\n\tif #Players:GetPlayers() <= 1 then\n\t\tp:Kick(\"\\nRejoining...\")\n\t\ttask.wait()\n\t\tTeleportService:Teleport(pid, p)\n\telse\n\t\tTeleportService:TeleportToPlaceInstance(pid, jid, p)\n\tend\nend\n\n-- Connect button and update loop\nbtn.MouseButton1Click:Connect(function()\n\ttask.spawn(lucky)\nend)\n\nstyle.Changed:Connect(updateLabel)\nupdateLabel()dateLabel()","owner":{"_id":"67fa7b865945679f97b7041b","username":"kenny240613","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"67fa7b865945679f97b7041b","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":4526,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/18668065416-1745248664057.png","likeCount":1,"dislike