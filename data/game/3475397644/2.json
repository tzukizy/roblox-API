:"https://tr.rbxcdn.com/726aadec90c69bc44553d54fd3e9e666/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/726aadec90c69bc44553d54fd3e9e666/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/726aadec90c69bc44553d54fd3e9e666/500/280/Image/Jpeg"},"likeCount":2,"dislikeCount":0,"createdAt":"2022-08-26T15:42:04.969Z","updatedAt":"2022-08-26T15:42:04.969Z","lastBump":"2022-08-26T15:42:04.969Z","script":"local TweenService = game:GetService(\"TweenService\")\n\nfunction tweento(part, pos, speed, reverse, thing)\n    local veloset = true\n    local Speed = speed\n    function GetTime(Distance, Speed)\n        local Time = Distance / Speed\n        return Time\n    end\n    if not reverse then reverse = false end\n\n    local NewPoint = pos\n    local Distance = (part.Position - pos.Position).magnitude\n    local Time = GetTime(Distance, Speed)\n            \n    local TweenInfo = TweenInfo.new(Time, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, reverse, 0)\n    local t = TweenService:Create(part, TweenInfo, {CFrame = pos})\n    t:Play()\n    coroutine.wrap(function()\n        repeat\n            part.Velocity = Vector3.new(0,0,0)\n            task.wait()\n        until veloset == false\n    end)()\n    thing = true\n    if thing == true then\n        t.Completed:Wait()\n        veloset = false\n    end\nend\n\nwhile true do wait()\n    for i,v in pairs(workspace.Interactions.Nodes.Harvest.Solstice.ActiveNodes:GetDescendants()) do\n        if v.Name == \"Solstice2022\" and v:FindFirstChild(\"SolsticeEggBox\") then\n            iv = v\n        end\n        if iv and iv:FindFirstChild(\"SolsticeEggBox\") then\n            tweento(game.Players.LocalPlayer.Character.HumanoidRootPart, iv.SolsticeEggBox.CFrame * CFrame.new(0,2,0), 200, false, true)\n            iv.StateRemote:InvokeServer(true)\n            wait(0.5)\n            for i = 0,4 do\n                iv.BoostRemote:InvokeServer(true, \"Solstice\" .. i)\n                wait(0.15)\n            end\n            wait(0.8)\n        end\n    end\nend\n","features":"auto collect egg box (solstice)","tags":[],"discord":"","keyLink":"","owner":{"_id":"625c870e6db0e41ac329324f","username":"eixotic07","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"625c870e6db0e41ac329324f","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:13:13.457Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f417","editBy":{"_id":"625c870e6db0e41ac329324f","username":"eixotic07","status":"offline","id":"625c870e6db0e41ac329324f"},"message":"Create script","createdAt":"2025-03-26T15:19:36.064Z"}],"comments":[{"_id":"6308f7e557f13cf6bb50cc2c","commentBy":{"_id":"628f46c25dc60d198cfc21ae","username":"smalldickbigdreams","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-05-26T09:22:10.094Z","lastActive":"2022-10-11T16:34:07.102Z","status":"offline","id":"628f46c25dc60d198cfc21ae","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"works but when theres a lot of eggs it doesnt collect them all","createdAt":"2022-08-26T16:42:13.074Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"63091b17023cd19cae82f730","commentBy":{"_id":"63068024716b5c4f32a915c1","username":"exshyy","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-08-24T19:46:44.840Z","lastActive":"2022-10-09T08:45:22.726Z","status":"offline","id":"63068024716b5c4f32a915c1"