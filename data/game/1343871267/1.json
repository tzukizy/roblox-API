rage\").RemoteEvents.CharacterFunctions.Jumpscares\n\t\t\twhile annoying do\n\t\t\t\tfor _, event in pairs(eventsFolder:GetChildren()) do\n\t\t\t\t\tif event:IsA(\"RemoteEvent\") then\n\t\t\t\t\t\tevent:FireServer()\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\tend\nend)\n","features":"Remove ac - removes the horrible ac\nGive shovel - gives a shovel\nAnnoy all near - annoys people near you","tags":["ss","troll","annoy","op","annoying"],"discord":"","keyLink":"","owner":{"_id":"683aa0380f380c18ee525781","username":"scripter132","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"683aa0380f380c18ee525781","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:49:55.865Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"690ea7dc526dad7219adb00e","editBy":{"_id":"683aa0380f380c18ee525781","username":"scripter132","status":"offline","id":"683aa0380f380c18ee525781"},"message":"Create script","createdAt":"2025-11-08T02:15:56.582Z"}],"comments":[{"_id":"690eafc471c563608d2442be","commentBy":{"_id":"67f180ffeae3682627cc40c8","username":"IAmSteve","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/00632e69987bf33df6767b11756b08827c871184eeb11a280d5585e9b798a7fe.webp","original":"https://scriptblox.com/images/photo/67f180ffeae3682627cc40c8-1753668339108.png"},"createdAt":"2025-04-05T19:14:07.695Z","lastActive":"2026-09-01T17:04:13.488Z","status":"offline","id":"67f180ffeae3682627cc40c8","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/00632e69987bf33df6767b11756b08827c871184eeb11a280d5585e9b798a7