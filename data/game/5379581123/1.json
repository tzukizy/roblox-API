1)\n                    end\n                end\n            end\n        end\n    end\nend)","owner":{"_id":"630be6b7a9946ba07d7f46ec","username":"vexxx","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/630be6b7a9946ba07d7f46ec-1662407784253.jpeg"},"status":"offline","id":"630be6b7a9946ba07d7f46ec","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/630be6b7a9946ba07d7f46ec-1662407784253.jpeg"}},"verified":false,"views":19481,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-09-05T20:18:43.898Z","dislikeCount":1,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/5379581123-1662409123870.jpg","scriptblox":"https://scriptblox.com/images/script/5379581123-1662409123870.jpg"},"executes":123,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:35:51.434Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/5379581123-1662409123870.jpg","scriptblox":"https://scriptblox.com/images/script/5379581123-1662409123870.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e199","editBy":{"_id":"630be6b7a9946ba07d7f46ec","username":"vexxx","status":"offline","id":"630be6b7a9946ba07d7f46ec"},"message":"Create script","createdAt":"2025-03-27T18:44:33.433Z"}],"comments":[{"_id":"63165b1b5ff1d45038b0e4de","commentBy":{"_id":"62eb269d023cd19cae08fb9a","username":"Novaz","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/c952087f34f8e8972fadfc72455d28da51010169b1e8f0ce59304fb6022a0771.webp","original":"https://scr