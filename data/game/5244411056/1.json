unt":1,"dislikeCount":0,"createdAt":"2026-05-15T15:44:00.063Z","liked":false,"disliked":false},{"_id":"6aa079d4f468febb1dd0ac73","commentBy":{"_id":"696131be7006284592152fc9","username":"Ph8ntom","verified":false,"role":"user","profilePicture":"/images/photo/696131be7006284592152fc9-1773776208314.jpg","lastActive":"2026-10-09T20:45:20.440Z","createdAt":"2026-01-09T16:50:06.080Z","status":"offline","id":"696131be7006284592152fc9","topMilestone":{"key":"creator.chart_topper","tier":1}},"text":"I though this game is fully dead already, but anyways tuff script😎","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-08T21:10:44.271Z","liked":false,"disliked":false}]},{"slug":"Bloxy-Bingo-Auto-Marker-6393","_id":"6340585cbce220b8df87d793","title":"Auto Marker","game":{"_id":"67e5e1ffb360710ec3c7808c","gameId":5244411056,"name":"Bloxy Bingo","imageUrl":"/images/sb/rbx-b627f3933117ec3d70dc15bde082fafe-1d50c1b4c32e.png","placeId":5244411056},"features":"Auto marks numbers as they are called in the bingo game","tags":["Bingo"],"script":"local SubContainer = game:GetService(\"Players\").LocalPlayer.PlayerGui.Bingo.StaticDisplayArea.Cards.PlayerArea.Cards.Container.SubContainer\n\nfunction firebutton(button)\n    if button ~= nil then\n       for i,signal in pairs(getconnections(button.MouseButton1Click)) do\n           signal:Fire()\n       end\n       for i,signal in pairs(getconnections(button.MouseButton1Down)) do\n           signal:Fire()\n       end\n       for i,signal in pairs(getconnections(button.Activated)) do\n           signal:Fire()\n       end\n    end\nend\n\nwhile wait() do\n   local Cards\n   \n   if SubContainer:FindFirstChild(\"Blocks\") then\n       Cards = SubContainer.Blocks.Block\n   else\n       Cards = SubContainer.VerticalScroll.Cards\n   end\n   \n   local BingoButton = SubContainer.Buttons.ClaimButton\n   \n   if Cards ~= nil and BingoButton ~= nil then\n       for _, card in pairs(Cards:GetChildren()) do\n           if card:IsA(\"Frame\") then\n               if card ~= nil and card:FindFirstChild(\"Content\") ~= nil and card:FindFirstChild(\"Content\"):FindFirstChild(\"Numbers\") ~= nil then\n                   for _, button in pairs(card.Content.Numbers:GetChildren()) do\n                       firebutton(button)\n                       wait()\n                   end\n                   \n                   if card ~= nil and card:FindFirstChild(\"ToGo\") ~= nil then\n                       if card.ToGo.ToGoText.Text == \"BINGO!\" then\n                           firebutton(BingoButton)\n                       end\n                   end\n               end\n           end\n       end\n   end\nend","owner":{"_id":"63180340ef24d8729e85e538","username":"zoltcn","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"63180340ef24d8729e85e538","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":28278,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-10-07T16:48:28.442Z","dislikeCount":1,"likeCount":3,"image":"https://tr.rbxcdn.com/f4fefade6a97ed671d4a8403b05ef004/500/280/Image/Jpeg","executes":2605,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e85f","editBy":{"_id":"63180340ef24d8729e85e538","username":"zoltcn","status":"offline","id":"63180340ef24d8729e85e538"},"message":"Create script","createdAt":"2025-03-27T23:06:17.352Z"}],"comments":[{"_id":"6340c632bce220b8df8b05f4","commentBy":{"_id":"63097dd5a9946ba07d732697","username":"kooggy","verified":false,"role":"user","profilePicture":"/images/photo/63097dd5a9946ba07d732697-1661566665118.png","createdAt":"2022-08-27T02:13:41.394Z","lastActive":"2022-10-08T18:54:40.654Z","status":"offline","id":"63097dd5a9946ba07d732697"},"text":"GREAST SCRIPT THANKS again for help lol!! thanks toyou i pro am scripting!!@@ also sunken is cool very so cool my best friend forever!! :blushing_emoji:","createdAt":"2022-10-08T00:37:06.294Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false}]}]}