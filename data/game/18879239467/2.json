LY ONCE OR ELSE)","tags":[],"script":"local settings = {repeatamount = 260, exceptions = {\"SayMessageRequest\",\"Fire\",\"Reload\"}}\n\nlocal mt = getrawmetatable(game)\nlocal old = mt.__namecall\nsetreadonly(mt, false)\n\nmt.__namecall = function(uh, ...)\n  local args = {...}\n  local method = getnamecallmethod()\n  for i,o in next, settings.exceptions do\n      if uh.Name == o then\n          return old(uh, ...)\n      end\n  end\n  if method == \"FireServer\" or method == \"InvokeServer\" then\n      for i = 1,settings.repeatamount do\n          old(uh, ...)\n      end\n  end\n  return old(uh, ...)\nend\n\nsetreadonly(mt, true)","owner":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66f9390af09d1c76dda29bd7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":12102,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-a4bdb0a196615ff7b44170f32b83048c-0413b59f0a95.png","likeCount":2,"dislikeCount":2,"createdAt":"2025-04-19T11:48:56.778Z","executes":323,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68038da825c6ac3553245641","editBy":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","status":"offline","id":"66f9390af09d1c76dda29bd7"},"message":"Create script","createdAt":"2025-04-19T11:48:56.782Z"}],"comments":[{"_id":"68038e7fe658a8af48f7459d","commentBy":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-09-29T11:24:58.796Z","lastActive":"2026-04-15T05:52:16.475Z","status":"offline","id":"66f9390af09d1c76dda29bd7","topMilestone":{"key":"creator.scripts","tier":5}},"text":"its pretty much universal","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-04-19T11:52:31.169Z","liked":false,"disliked