romRGB(0, 200, 100)\nAutoFarmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nAutoFarmBtn.Text = \"Автофарм: OFF\"\nAutoFarmBtn.Font = Enum.Font.GothamBold\nAutoFarmBtn.TextSize = 18\nAutoFarmBtn.Parent = Frame\n\n-- === Логика автофарма ===\nlocal autofarm = false\n\nAutoFarmBtn.MouseButton1Click:Connect(function()\n    autofarm = not autofarm\n    AutoFarmBtn.Text = \"Автофарм: \" .. (autofarm and \"ON\" or \"OFF\")\n\n    while autofarm do\n        local char = LocalPlayer.Character\n        if char and char:FindFirstChild(\"HumanoidRootPart\") then\n            -- телепортируем вверх, чтобы падать\n            char.HumanoidRootPart.CFrame = CFrame.new(0, 200, 0)\n        end\n        task.wait(3) -- пауза между падениями (можешь менять)\n    end\nend)","owner":{"_id":"66019170144fe26dc8384fd7","username":"brawlpas2016","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"66019170144fe26dc8384fd7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":5074,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8e95a6539a6a60a005c3af4aec0a44ba553414d975a7bcdb3be956e79759359d.webp","original":"https://scriptblox.com/images/sb/7002808196-1759055234900.jpg","scriptblox":"https://scriptblox.com/images/script/7002808196-1759055234900.jpg"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-09-28T10:27:14.930Z","executes":109,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:45:57.584Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/8e95a6539a6a60a005c3af4aec0a44ba553414d975a7bcdb3be956e79759359d.webp","original":"https://scriptblox.com/images/s