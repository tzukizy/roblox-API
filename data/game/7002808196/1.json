rmBtn.Text = \"Автофарм: OFF\"\nAutoFarmBtn.Font = Enum.Font.GothamBold\nAutoFarmBtn.TextSize = 18\nAutoFarmBtn.Parent = Frame\n\n-- === Логика автофарма ===\nlocal autofarm = false\n\nAutoFarmBtn.MouseButton1Click:Connect(function()\n    autofarm = not autofarm\n    AutoFarmBtn.Text = \"Автофарм: \" .. (autofarm and \"ON\" or \"OFF\")\n\n    while autofarm do\n        local char = LocalPlayer.Character\n        if char and char:FindFirstChild(\"HumanoidRootPart\") then\n            -- телепортируем вверх, чтобы падать\n            char.HumanoidRootPart.CFrame = CFrame.new(0, 200, 0)\n        end\n        task.wait(3) -- пауза между падениями (можешь менять)\n    end\nend)","owner":{"_id":"66019170144fe26dc8384fd7","username":"brawlpas2016","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66019170144fe26dc8384fd7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":5068,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/7002808196-1759055234900.jpg","likeCount":0,"dislikeCount":1,"createdAt":"2025-09-28T10:27:14.930Z","executes":105,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d90d822eb4bb191d4bd635","editBy":{"_id":"66019170144fe26dc8384fd7","username":"brawlpas2016","status":"offline","id":"66019170144fe26dc8384fd7"},"message":"Create script","createdAt":"2025-09-28T10:27:14.935Z"}],"comments":[{"_id":"68d90dbf974b1f424a328db4","commentBy":{"_id":"66019170144fe26dc8384fd7","username":"brawlpas2016","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-03-25T15:00:00.495Z","lastActive":"2026-07-09T08:33:02.871Z","status":"offline","id":"66019170144fe26dc8384fd7","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Im creator and im use this","edited":false,"likeCount":1,"dislikeCount":1,"createdAt":"2025-09-28T10:28:15.752Z","liked":false,"dis