{"id":9058310544,"name":"Blast Zone","desc":"An explosive fighting game with bombs, portals, jump pads, rocket-powered hammers, speed rails, flinging, and more!\n\nChat commands:\nSay \"rtv\" to vote for maps\nSay \"listmaps\" to list available maps\nSay \"loadmap Crossroads\" to change the map (private server admin only)\n\nNotes: \nStats do not save in private servers, but you can still earn currency and rewards.\nPlayers caught using exploits will be banned!\n\nCredits:\nThumbnail by @gyoziski","path":"/game/9058310544-blast-zone","slug":"9058310544-blast-zone","thumbnail":["https://tr.rbxcdn.com/180DAY-c660eba2795475d9c1ef854a000dd979/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-500fc7f021f7751489d3c2d16d1f663c/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":1193,"visitor":101892781,"verified":false,"updatedAt":"2026-04-27T22:59:12.035Z","creator":{"name":"Blast Zone Team","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Blast-Zone-C00lgui-208052","_id":"69efea4001f9f23ed6229072","title":"C00lgui","game":{"_id":"68788fefbf24f84fa7e21961","gameId":9058310544,"name":"Blast Zone","imageUrl":"/images/sb/rbx-500fc7f021f7751489d3c2d16d1f663c-b70502595199.png","placeId":9058310544},"features":"It's S00 g00d","tags":["Clgyi"],"script":"local player = game.Players.LocalPlayer\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal humanoid = char:WaitForChild(\"Humanoid\")\n\n-- Criar GUI\nlocal gui = script.Parent\n\n-- Botão Speed\nlocal speedButton = Instance.new(\"TextButton\")\nspeedButton.Size = UDim2.new(0, 150, 0, 40)\nspeedButton.Position = UDim2.new(0, 10, 0, 10)\nspeedButton.Text = \"Speed x2\"\nspeedButton.Parent = gui\n\nspeedButton.MouseButton1Click:Connect(function()\n\thumanoid.WalkSpeed = 32\nend)\n\n-- Botão Jump\nlocal jumpButton = Instance.new(\"TextButton\")\njumpButton.Size = UDim2.new(0, 150, 0, 40)\njumpButton.Position = UDim2.new(0, 10, 0, 60)\njumpButton.Text = \"Super Jump\"\njumpButton.Parent = gui\n\njumpButton.MouseButton1Click:Connect(function()\n\thumanoid.JumpPower = 100\nend)\n\n-- Botão Reset\nlocal resetButton = Instance.new(\"TextButton\")\nresetButton.Size = UDim2.new(0, 150, 0, 40)\nresetButton.Position = UDim2.new(0, 10, 0, 110)\nresetButton.Text = \"Reset\"\nresetButton.Parent = gui\n\nresetButton.MouseButton1Click:Connect(function()\n\thumanoid.Health = 0\nend)\n\n-- Botão Normal\nlocal normalButton = Instance.new(\"TextButton\")\nnormalButton.Size = UDim2.new(0, 150, 0, 40)\nnormalButton.Position = UDim2.new(0, 10, 0, 160)\nnormalButton.Text = \"Normal\"\nnormalButton.Parent = gui\n\nnormalButton.MouseButton1Click:Connect(function()\n\thumanoid.WalkSpeed = 16\n\thumanoid.JumpPower = 50\nend)","owner":{"_id":"69cd381c840e6002e66f82d2","username":"nicolaslopes2072","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69cd381c840e6002e66f82d2","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2697,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-500fc7f021f7751489d3c2d16d1f663c-b70502595199.png","likeCount":0,"dislikeCount":2,"createdAt":"2026-04-27T22:59:12.040Z","executes":3133,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69efea4001f9f23ed6229075","editBy":{"_id":"69cd381c840e6002e66f82d2","username":"nicolaslopes2072","status":"offline","id":"69cd381c840e6002e66f82d2"},"message":"Create script","createdAt":"2026-04-27T22:59:12.044Z"}],"comments":[]},{"slug":"Blast-Zone-Blast-zone-cool-script-45180","_id":"68788fefbf24f84fa7e21969","title":"cool script","game":{"_id":"68788fefbf24f84fa7e21961","gameId":9058310544,"name":"Blast Zone","imageUrl":"/images/sb/rbx-500fc7f021f7751489d3c2d16d1f663c-b70502595199.png","placeId":9058310544},"features":"Aimbot, fly, noclip, and more","tags":[],"script":