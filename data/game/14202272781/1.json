 .. \"_Cloned\"\n        c.Parent = fz\n        c.Transparency = 0.6\n    end\nend)\n\ngame.Workspace.DescendantAdded:Connect(function(v)\n    if v.Parent and v.Parent.Name == \"DemoBuild\" and v.Name:lower() == \"block\" then \n        for _, m in pairs(fz:GetChildren()) do \n            if m.Name:match(\"_Cloned\") then \n                m:Destroy() \n            end\n        end\n    end\nend)","owner":{"_id":"657ac61c2160a262f41a04c7","username":"Averageguy","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"657ac61c2160a262f41a04c7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":9425,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-24T16:25:12.978Z","dislikeCount":1,"likeCount":4,"image":"https://tr.rbxcdn.com/5633e5c04588ae64ca464a6cff709084/500/280/Image/Jpeg","executes":238,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c51216","editBy":{"_id":"657ac61c2160a262f41a04c7","username":"Averageguy","status":"offline","id":"657ac61c2160a262f41a04c7"},"message":"Create script","createdAt":"2025-03-27T15:42:11.165Z"}],"comments":[{"_id":"6681a6a79a519d35e372e0a3","commentBy":{"_id":"6626f6200d15d5289b6b3a8d","username":"romane09so","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-04-22T23:43:28.819Z","lastActive":"2024-06-30T18:41:04.032Z","status":"offline","id":"6626f6200d15d5289b6b3a8d"},"text":"No funciona","createdAt":"2024-06-30T18:40:39.464Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"691e16d37eba817c5a420024","commentBy":{"_id":"68f4ade2009efecaa616abc3","username":"VeryNetlyyy","verified":false,"role":"user","profilePicture":"/images/photo/68f4ade2009efecaa616abc3-1789844717735.jpg","createdAt":"2025-10-19T09:22:42.223Z","lastActive":"2026-10-09T22:00:09.024Z","status":"online","id":"68f4a