ent = fz\n        c.Transparency = 0.6\n    end\nend)\n\ngame.Workspace.DescendantAdded:Connect(function(v)\n    if v.Parent and v.Parent.Name == \"DemoBuild\" and v.Name:lower() == \"block\" then \n        for _, m in pairs(fz:GetChildren()) do \n            if m.Name:match(\"_Cloned\") then \n                m:Destroy() \n            end\n        end\n    end\nend)","features":"So you don't have to memorise the build.","tags":[],"discord":"","keyLink":"","owner":{"_id":"657ac61c2160a262f41a04c7","username":"Averageguy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"657ac61c2160a262f41a04c7","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:09:22.504Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c51216","editBy":{"_id":"657ac61c2160a262f41a04c7","username":"Averageguy","status":"offline","id":"657ac61c2160a262f41a04c7"},"message":"Create script","createdAt":"2025-03-27T15:42:11.165Z"}],"comments":[{"_id":"6681a6a79a519d35e372e0a3","commentBy":{"_id":"6626f6200d15d5289b6b3a8d","username":"romane09so","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-04-22T23:43:28.819Z","lastActive":"2024-06-30T18:41:04.032Z","status":"offline","id":"6626f6200d15d5289b6b3a8d","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"No funciona","createdAt":"2024-06-30T18:40:39.464Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"691e16d37eba817c5a420024","commentBy":{"_id":"68f4ade2009efecaa616abc3","username":"VeryNetlyyy","verified":false,"role":