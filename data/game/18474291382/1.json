ubtitle = \"Auto Green + Auto Dunk\",\n    ConfigurationSaving = {Enabled = true, FolderName = \"Nexual\", FileName = \"AssistConfigs\"}\n})\n\nlocal Tab = Window:CreateTab(\"Main\", 4483362458)\n\n-- AUTO GREEN\nTab:CreateToggle({\n    Name = \"Auto Green\",\n    CurrentValue = false,\n    Callback = function(Value)\n        AutoGreen = Value\n    end\n})\n\nTab:CreateSlider({\n    Name = \"Green Release Timing (s)\",\n    Range = {0.1, 1},\n    Increment = 0.01,\n    Suffix = \"s\",\n    CurrentValue = 0.25,\n    Callback = function(Value)\n        GreenRelease = Value\n    end\n})\n\n-- AUTO DUNK\nTab:CreateToggle({\n    Name = \"Auto Dunk\",\n    CurrentValue = false,\n    Callback = function(Value)\n        AutoDunk = Value\n    end\n})\n\nTab:CreateSlider({\n    Name = \"Dunk Release Timing (s)\",\n    Range = {0.1, 1},\n    Increment = 0.01,\n    Suffix = \"s\",\n    CurrentValue = 0.25,\n    Callback = function(Value)\n        DunkRelease = Value\n    end\n})\n\n-- HOOK REMOTES (for mobile)\nlocal mt = getrawmetatable(game)\nlocal old = mt.__namecall\nsetreadonly(mt, false)\nmt.__namecall = newcclosure(function(self, ...)\n    local args = {...}\n    local method = getnamecallmethod()\n\n    if self == Action and method == \"FireServer\" and args[1] and type(args[1]) == \"table\" then\n        local tbl = args[1]\n\n        -- AUTO GREEN\n        if tbl.Type == \"Shoot\" and tbl.Shoot == true and AutoGreen then\n            task.delay(GreenRelease, function()\n                Action:FireServer({Shoot = false, Type = \"Shoot\"})\n            end)\n        end\n\n        -- AUTO DUNK (mobile)\n        if tbl.Action == \"Jump\" and tbl.Jump == true and AutoDunk then\n            task.delay(DunkRelease, function()\n                Action:FireServer({Action = \"Jump\", Jump = false})\n            end)\n        end\n    end\n\n    return old(self, ...)\nend)\nsetreadonly(mt, true)\n\n-- AUTO DUNK (PC spacebar)\nUserInputService.InputBegan:Connect(function(input, gpe)\n    if gpe then return end\n    if not AutoDunk then return end\n\n    if input.KeyCode == Enum.KeyCode.Space then\n        task.delay(DunkRelease, function()\n            if AutoDunk then\n                Action:FireServer({Action = \"Jump\", Jump = false})\n            end\n        end)\n    end\nend)\n\nRayfield:Notify({\n    Title=\"Nexual Loaded\",\n    Content=\"Auto Green + Auto Dunk ready (PC + Mobile)\",\n    Duration=5\n})\n\nprint(\"[NEXUAL] Auto Green + Auto Dunk hooked to actual remotes (PC + Mobile)\")","owner":{"_id":"6940586c53e4ff1d2475c5ca","username":"Lebronjameskdhhf","verified":false,"profilePicture":"/images/photo/6940586c53e4ff1d2475c5ca-1770828371438.jpeg","status":"offline","id":"6940586c53e4ff1d2475c5ca","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":5062,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-9919d26bb110170b574eec34ce2ba249-1e9145ec723a.png","likeCount":0,"dislikeCount":1,"createdAt":"2026-02-06T18:52:16.418Z","executes":38,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69863860e96ccd2956ac084b","editBy":{"_id":"6940586c53e4ff1d2475c5ca","username":"Lebronjameskdhhf","status":"offline","id":"6940586c53e4ff1d2475c5ca"},"message":"Create script","createdAt":"2026-02-06T18:52:16.422Z"}],"comments":[]}]}