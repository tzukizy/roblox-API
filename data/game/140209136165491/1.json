t(stage, \"PlayerAttack\") then\n\t\tcontinue\n\tend\n\tlocal instance_manager = getupvalue(stage.PlayerAttack, 1)\n\tobject_list = getupvalue(instance_manager.FindObject, 1)\n\tlp_object = object_list[local_player]\nend\n\nlocal function load_url<A..., R...>(url: string): (A...) -> R...\n\tlocal Callback, Error = loadstring(game:HttpGet(url))\n\tif Error then\n\t\treturn error(Error, 2)\n\tend\n\treturn (Callback :: any) :: (A...) -> R...\nend\nlocal empty_callback = function() end\n\nlocal library: AnkaUi = load_url(\"https://raw.githubusercontent.com/nfpw/XXSCRIPT/refs/heads/main/Library/Module.lua\")()\ngetgenv()[LIBRARY_ID] = library\nlocal window = library:CreateWindow({\n\tWindowName = `Public Main {GAME_NAME} v{SCRIPT_VERSION}`,\n}, gethui())\n\nlocal main_tab = window:CreateTab(\"main\")\nlocal main_section = main_tab:CreateSection(\"main\")\nlocal stage = main_section:CreateDropdown(\n\t\"stage\",\n\t(function()\n\t\tlocal out = workspace.Stage:GetChildren()\n\t\tfor k, v in out do\n\t\t\tout[k] = v.Name\n\t\tend\n\t\treturn out\n\tend)(),\n\tempty_callback,\n\tworkspace.Stage:GetChildren()[1].Name\n)\nlocal auto_farm = main_section:CreateToggle(\"auto farm\", false, empty_callback)\nlocal auto_farm_thread = task.spawn(function()\n\twhile task.wait() do\n\t\tif not auto_farm:GetState() then\n\t\t\tcontinue\n\t\tend\n\t\tlocal original = local_player.Character:GetPivot()\n\t\tfor _, monster in workspace.Stage[stage:GetOption()].monster:GetChildren() do\n\t\t\tlocal monster_object = object_list[monster]\n\t\t\tif not monster_object then\n\t\t\t\tcontinue\n\t\t\tend\n\t\t\tlocal_player.Character:PivotTo(monster:GetPivot())\n\t\t\tlp_object.sync_cmp:Add(\"player_attack_monster\", {\n\t\t\t\t[\"player_guid\"] = lp_object.guid,\n\t\t\t\t[\"monster_guid\"] = monster_object.guid,\n\t\t\t\t[\"stage_id\"] = tonumber(stage:GetOption():gsub(\"stage\", \"\"), 10),\n\t\t\t})\n\t\t\ttask.wait()\n\t\tend\n\t\tlocal_player.Character:PivotTo(original)\n\tend\nend)\nmain_section:CreateButton(\"unload script\", function()\n\tlibrary:Destroy()\nend)\n\nlocal old = library.Destroy\nlibrary.Destroy = function(...)\n\ttask.cancel(auto_farm_thread)\n\treturn old(...)\nend\n\nif not lp_object then\n\treturn window:Notify(\"Script patched\", \"failed to get LocalPlayer data\")\nend\n","owner":{"_id":"683adb39a348d24efdeeca5a","username":"pubmain","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/8e995f1eb8b45521488a7d24742cbd91e82806dc02e35f96fcc40d79231f15c2.webp","original":"https://scriptblox.com/images/photo/683adb39a348d24efdeeca5a-1748687765375.jpg"},"status":"offline","id":"683adb39a348d24efdeeca5a","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/8e995f1eb8b45521488a7d24742cbd91e82806dc02e35f96fcc40d79231f15c2.webp","original":"https://scriptblox.com/images/photo/683adb39a348d24efdeeca5a-1748687765375.jpg"}},"verified":false,"views":3327,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/40300e22c6f50f71ff5f90f814a006a42d842459894cd1af66dfe2d02f10e35c.webp","original":"https://scriptblox.com/images/sb/140209136165491-1763299369548.png","scriptblox":"https://scriptblox.com/images/script/140209136165491-1763299369548.png"},"likeCount":1,"dislikeCount":3,"createdAt":"2025-11-16T13:22:49.562Z","editBy":{"_id":"683adb39a348d24efdeeca5a","username":"pubmain","status":"offline","id":"683adb39a348d24efdeeca5a"},"keyLink":"","executes":154,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:45:07.660Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/40300e22c6f50f71ff5f90f814a006a42d842459894cd1af66dfe2d02f10e35c.webp","original":"https://scriptblox.com/images/sb/140209136165491-1763299369548.png","scriptblox":"https://scriptblox.com/images/script/14020913