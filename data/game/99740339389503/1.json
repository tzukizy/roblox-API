Title = \"Like the script\",\n   Content = \"Like the script, At some point it will stop working.\",\n   Duration = 6.5,\n   Image = 4483362458,\n})\n\nTab:CreateButton({\n\tName = \"God mode\",\n\tCallback = function()\n\t\tlocal AbilityEvents = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"AbilityEvents\")\n\t\tlocal remote = AbilityEvents:WaitForChild(\"LastBreathUsed\")\n\n\t\tlocal duration = 5       \n\t\tlocal interval = 0.3     \n\n\t\tlocal startTime = tick()\n\n\t\twhile tick() - startTime < duration do\n\t\t\tremote:FireServer()\n\t\t\ttask.wait(interval)\n\t\tend\n\tend\n})\n\n\nlocal Button = Tab:CreateButton({\n   Name = \"Night vision ability\",\n   Callback = function()\n   game:GetService(\"ReplicatedStorage\"):WaitForChild(\"AbilityEvents\"):WaitForChild(\"NightVisionUsed\"):FireServer()\n   end,\n})\n\nTab:CreateButton({\n\tName = \"Ultra Mechanic\",\n\tCallback = function()\n\t\tgame:GetService(\"ReplicatedStorage\")\n\t\t\t:WaitForChild(\"AbilityEvents\")\n\t\t\t:WaitForChild(\"UltraMechanicUsed\")\n\t\t\t:FireServer()\n\tend\n})\n\nTab:CreateButton({\n\tName = \"Safety First\",\n\tCallback = function()\n\t\tgame:GetService(\"ReplicatedStorage\")\n\t\t\t:WaitForChild(\"AbilityEvents\")\n\t\t\t:WaitForChild(\"SafetyFirstUsed\")\n\t\t\t:FireServer()\n\tend\n})\n","owner":{"_id":"64cebe599638414075458aed","username":"Normalplayer","verified":false,"profilePicture":{"url":"https://media.kocakz.me/37fb9e73a78687bef8b406a433a6968c3d456ecf0e8c5b161b66d39183f8aa15.webp","original":"https://scriptblox.com/images/photo/64cebe599638414075458aed-1776523365901.png"},"status":"offline","id":"64cebe599638414075458aed","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/37fb9e73a78687bef8b406a433a6968c3d456ecf0e8c5b161b66d39183f8aa15.webp","original":"https://scriptblox.com/images/photo/64cebe599638414075458aed-1776523365901.png"}},"verified":false,"views":1157,"scriptType":"free","isUniversal":false,"isPatched":