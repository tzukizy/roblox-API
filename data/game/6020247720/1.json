hoveTool\"):FireServer(unpack(args))\n        end\n    end\n\n    for i,v in pairs(workspace:GetChildren()) do\n        if v.Name == \"R15Rig\" and v:FindFirstChild(\"Head\") and v ~= game.Players.LocalPlayer then\n            local args = {\n                [1] = v:FindFirstChild(\"Head\"),\n                [2] = Vector3.new(9e9, -9e9, -0.9533988237380981)\n            }\n\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RemoteEvents\"):WaitForChild(\"ShoveTool\"):FireServer(unpack(args))\n        end\n    end\nend","owner":{"_id":"622169daab4b208e46f37c86","username":"relevant","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/158c956ebcff886da32c6426962518612a1de6fab96a7840a7537c618606c212.webp","original":"https://scriptblox.com/images/photo/622169daab4b208e46f37c86-1693311171897.png"},"status":"offline","id":"622169daab4b208e46f37c86","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/158c956ebcff886da32c6426962518612a1de6fab96a7840a7537c618606c212.webp","original":"https://scriptblox.com/images/photo/622169daab4b208e46f37c86-1693311171897.png"}},"verified":false,"keyLink":"","views":89736,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-29T04:30:52.421Z","dislikeCount":1,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/915642c10ef9198abe876df2e63f90c2/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/915642c10ef9198abe876df2e63f90c2/500/280/Image/Jpeg"},"executes":634,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T04:42:54.452Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/915642c10ef9198abe876df2e63f90c2/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn