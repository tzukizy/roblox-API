{"id":16518256559,"name":"Mega Obby Fun","desc":"Welcome to Mega Obby Fun!\n\nCall your friends and have fun in more than 200 stages of Easy Obby!\n\n🏆 Winner: Magic Carpet as a gift in the last stage.\n\nUpdates:\nWe will constantly add new stages.\nLike and favorite the game for updates!\n\nLike Mega Obby Fun 👍\nFavorite Mega Obby Fun ⭐\n\nFollow: @Gargula85\nJoin our group: https://www.roblox.com/groups/33479457\n\nTags: obby, easy obby, fun obby, mega obby, parkour, parkour obby, obstacle course, jump, jumping, rainbow, lava, stairs, noob, easy, fun, long obby","path":"/game/16518256559-mega-obby-fun","slug":"16518256559-mega-obby-fun","thumbnail":{"url":"https://media.kocakz.me/bba8f4521f7a504ef172dfcecc23e9cee52764a0c49ab431f487c994aba2e097.webp","original":"https://tr.rbxcdn.com/180DAY-b09d728b7ac7b57860c2aca1923543ec/150/150/Image/Png/noFilter"},"playing":1218,"visitor":148061321,"verified":false,"updatedAt":"2026-10-21T12:33:42.555Z","creator":{"name":"ManiaGames","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"6ad481eaab979ac3282724d0","title":"peppa pig gui","game":{"_id":"68774afdade34a8471a273d3","gameId":16518256559,"name":"Mega Obby Fun","imageUrl":{"url":"https://media.kocakz.me/bba8f4521f7a504ef172dfcecc23e9cee52764a0c49ab431f487c994aba2e097.webp","original":"https://tr.rbxcdn.com/180DAY-b09d728b7ac7b57860c2aca1923543ec/150/150/Image/Png/noFilter"},"slug":"16518256559-mega-obby-fun","path":"/game/16518256559-mega-obby-fun","thumbnail":{"url":"https://media.kocakz.me/bba8f4521f7a504ef172dfcecc23e9cee52764a0c49ab431f487c994aba2e097.webp","original":"https://tr.rbxcdn.com/180DAY-b09d728b7ac7b57860c2aca1923543ec/150/150/Image/Png/noFilter"},"placeId":16518256559},"slug":"Mega-Obby-Fun-peppa-pig-gui-232236","verified":false,"key":false,"keyless":false,"views":1417,"executes":299,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/5f756c49c1f9eae95cdc0926220132eaf8735d2441941021540394f8a4c6d3c2.webp","original":"https://scriptblox.com/images/sb/16518256559-1792311786966.jpg","scriptblox":"https://scriptblox.com/images/script/16518256559-1792311786966.jpg"},"thumbnail":{"url":"https://media.kocakz.me/5f756c49c1f9eae95cdc0926220132eaf8735d2441941021540394f8a4c6d3c2.webp","original":"https://scriptblox.com/images/sb/16518256559-1792311786966.jpg","scriptblox":"https://scriptblox.com/images/script/16518256559-1792311786966.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-18T08:23:07.028Z","updatedAt":"2026-10-18T08:23:07.028Z","lastBump":"2026-10-18T08:23:07.028Z","script":"```lua\n-- PEPPA PIG  | BLACK & PINK\n-- LocalScript: StarterPlayerScripts\n-- GUI DEMO XD\n\nlocal Players = game:GetService(\"Players\")\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\nlocal old = playerGui:FindFirstChild(\"PeppaPigRC7\")\nif old then\n    old:Destroy()\nend\n\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"PeppaPig\"\ngui.ResetOnSpawn = false\ngui.Parent = playerGui\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.fromOffset(270, 240)\nframe.Position = UDim2.new(0, 25, 0.3, 0)\nframe.BackgroundColor3 = Color3.fromRGB(12, 12, 16)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Draggable = true\nframe.Parent = gui\n\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = UDim.new(0, 14)\ncorner.Parent = frame\n\nlocal stroke = Instance.new(\"UIStroke\")\nstroke.Color = Color3.fromRGB(255, 40, 160)\nstroke.Thickness = 2\nstroke.Parent = frame\n\nlocal title = Instance.new(\"TextLabel\")\ntitle.Size = UDim2.new(1, 0, 0, 48)\ntitle.BackgroundColor3 = Color3.fromRGB(255, 30, 145)\ntitle.Text = \"🐷 PEPPA PIG gui\"\ntitle.TextColor3 = Color3.new(1, 1, 1)\ntitle.TextSize = 21\ntitle.Font = Enum.Font.GothamBold\ntitle.Parent = frame\n\nlocal function makeButton(text, y)\n    local button = Instance.new(\"TextButton\")\n    button.Size = UDim2.new(1, -30, 0, 42)\n    button.Position = UDim2.new(0, 15, 0, y)\n    button.BackgroundColor3 = Color3.fromRGB(35, 25, 38)\n    button.TextColor3 = Color3.fromRGB(255, 90, 190)\n    button.Text = text\n    button.TextSize = 16\n    button.Font = Enum.Font.GothamBold\n    button.Parent = frame\n\n    local c = Instance.new(\"UICorner\")\n    c.CornerRadius = UDim.new(0, 9)\n    c.Parent = button\n\n    return button\nend\n\nlocal speedButton = makeButton(\"SPEED: OFF\", 62)\nlocal jumpButton = makeButton(\"JUMP: OFF\", 112)\nlocal hideButton = makeButton(\"HIDE GUI [F1]\", 162)\n\nlocal speedOn = false\nlocal jumpOn = false\n\nlocal function getHumanoid()\n    local character = player.Character\n    return character and character:FindFirstChildOfClass(\"Humanoid\")\nend\n\nlocal function updateCharacter()\n    local humanoid = getHumanoid()\n    if not humanoid then return end\n\n    humanoid.WalkSpeed = speedOn and 32 or 16\n    humanoid.UseJumpPower = true\n    humanoid.JumpPower = jumpOn and 100 or 50\nend\n\nspeedButton.MouseButton1Click:Connect(function()\n    speedOn = not speedOn\n    speedButton.Text = speedOn and \"SPEED: ON\" or \"SPEED: OFF\"\n    updateCharacter()\nend)\n\njumpButton.MouseButton1Click:Connect(function()\n    jumpOn = not jumpOn\n    jumpButton.Text = jumpOn and \"JUMP: ON\" or \"JUMP: OFF\"\n    updateCharacter()\nend)\n\nhideButton.MouseButton1Click:Connect(function()\n    frame.Visible = false\nend)\n\nUIS.InputBegan:Connect(function(input, processed)\n    if processed then return end\n\n    if input.KeyCode == Enum.KeyCode.F1 then\n        frame.Visible = not frame.Visible\n    end\nend)\n\nplayer.CharacterAdded:Connect(function()\n    task.wait(1)\n    updateCharacter()\nend)\n\nprint(\"PEPPA PIG RC7 GUI DEMO XD loaded!\")\n```","features":"l am pig","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a9c