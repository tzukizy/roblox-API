r in ipairs(Players:GetPlayers()) do\n            if player ~= LocalPlayer then\n                local args = {\n                    player.Name,\n                    \"Button3\",\n                    \"0\"\n                }\n                Remote:FireServer(unpack(args))\n                wait(0.1)\n            end\n        end\n        wait(0.5)\n    end\nend)\n\nspawn(function()\n    while true do\n        for _, player in ipairs(Players:GetPlayers()) do\n            if player ~= LocalPlayer then\n                local character = player.Character\n                if character and character:FindFirstChild(\"Humanoid\") then\n                    character.Humanoid.Health = 0\n                end\n            end\n        end\n        wait(0.2)\n    end\nend)","owner":{"_id":"66f75b84bad6558f11b01148","username":"sampangmatthew","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66f75b84bad6558f11b01148","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":10552,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/e9e791c463bd421a684441b49c4c85d87331a15512c9fd523b1483064816b4ef.webp","original":"https://scriptblox.com/images/sb/rbx-8799d22c59ef22e7190075f9a3c4c5d7-75bf5d67077a.png","scriptblox":"https://scriptblox.com/images/script/rbx-8799d22c59ef22e7190075f9a3c4c5d7-75bf5d67077a.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-07-16T22:56:01.512Z","executes":144,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:11:27.208Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/e9e791c463bd421a684441b49c4c85d87331a15512c9fd523b1483064816b4ef.webp","orig