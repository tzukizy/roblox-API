\" .. (isEnabled and \"ON\" or \"OFF\")\n\n      toggleFunction(isEnabled)\n\n      if isEnabled and customCode then\n\n          customCode()\n\n      end\n\n  end\n\n  button.MouseButton1Click:Connect(toggleButton)\n\nend\n\ncreateToggleButton(\"Toggle Damage Size\", function(isEnabled)\n\n  if isEnabled then\n\n      game.Workspace.Pit.Damage.Size = Vector3.new(42, 2000, 2000)\n\n  else\n\n      game.Workspace.Pit.Damage.Size = Vector3.new(0, 0, 0)\n\n  end\n\nend)\n\ncreateToggleButton(\"Toggle Touch\", function(isEnabled)\n\n  for i, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do\n\n      if v:IsA(\"BasePart\") then\n\n          v.CanCollide = not isEnabled\n\n          v.CanTouch = not isEnabled\n\n      end\n\n  end\n\nend)\n\ncreateToggleButton(\"Remove Ragdoll\", function(isEnabled)\n\n  if isEnabled then\n\n      local LocalPlayer = game.Players.LocalPlayer\n\n      if LocalPlayer.Character:FindFirstChild(\"ragdollValue\") then\n\n          LocalPlayer.Character.ragdollValue:Destroy()\n\n      end\n\n  end\n\nend)\n\ncreateToggleButton(\"Boost Touch Detector Size\", function(isEnabled)\n\n  local touchDetector = game:GetService(\"Workspace\").Map.Cool.Boosts.Jump.touchDetector\n\n  touchDetector.Size = isEnabled and Vector3.new(4000, 4000, 4000) or Vector3.new(1, 1, 1)\n\nend)\n\nlocal function toggleSpeedScript(isEnabled)\n\n  local touchDetector = game:GetService(\"Workspace\").Map.Cool.Boosts.Speed.touchDetector\n\n  touchDetector.Size = isEnabled and Vector3.new(2000, 2000, 2000) or Vector3.new(1, 1, 1)\n\nend\n\ncreateToggleButton(\"Speed\", toggleSpeedScript)\n\nlocal button6 = Instance.new(\"TextButton\")\n\nbutton6.Text = \"Grapple Length: OFF\"\n\nbutton6.Size = UDim2.new(0, 180, 0, buttonHeight)\n\nbutton6.Position = UDim2.new(0, 10, 0, yOffset)\n\nbutton6.Parent = frame\n\nlocal executingGrapple = false\n\nbutton6.MouseButton1Click:Connect(function()\n\n  executingGrapple = not executingGrapple\n\n  button6.Text = \"Grapple Length: \" .. (executingGrapple and \"ON\" or \"OFF\")\n\nend)\n\nspawn(function()\n\n  while true do\n\n      wait(0.05)\n\n      if executingGrapple then\n\n          local args = {\n\n              [1] = -1\n\n          }\n\n          game:GetService(\"ReplicatedStorage\").Events.Remote.Client.changeRopeLength:FireServer(unpack(args))\n\n      end\n\n  end\n\nend)","owner":{"_id":"672fbb6a4d7236280c4910b0","username":"rufysa*","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"672fbb6a4d7236280c4910b0","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":12776,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-11-26T08:53:05.905Z","dislikeCount":1,"likeCount":1,"image":"https://tr.rbxcdn.com/180DAY-2aa705c0abd164649fcfa0069d484664/500/280/Image/Jpeg/noFilter","executes":1309,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53304","editBy":{"_id":"672fbb6a4d7236280c4910b0","username":"rufysa*","status":"offline","id":"672fbb6a4d7236280c4910b0"},"message":"Create script","createdAt":"2025-03-27T22:07:43.654Z"}],"comments":[{"_id":"687bf92c0c18b23a6b588f36","commentBy":{"_id":"687bf8f45199264958f7f031","username":"tay9tat","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-07-19T19:58:44.200Z","lastActive":"2025-12-24T03:15:00.665Z","status":"offline","id":"687bf8f45199264958f7f031"},"text":"Where do I paste the script","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-19T19:59:40.223Z","liked":false,"disliked":false},{"_id":"687fcc23633da5bfe1ff5651","commentBy":{"_id":"687f871d4641cda629827f69","username":"areeshamazari7","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-07-22T12:42:05.598Z","lastActive":"2025-07-22T19:25:53.710Z","status":"offline","id":"687f871d4641cda