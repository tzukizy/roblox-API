nd rawget(v, \"RateOfFire\") then\n     rawset(v, \"RateOfFire\", 0)\n end\n end\n\n for i,v in pairs(getgc(true)) do\n if type(v) == \"table\" and rawget(v, \"ReloadTime\") then\n     rawset(v, \"ReloadTime\", 0)\n end\n end\n\n for i,v in pairs(getgc(true)) do\n if type(v) == \"table\" and rawget(v, \"Damage\") then\n     rawset(v, \"Damage\", 999)\n end\n end","owner":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","verified":false,"profilePicture":"/images/photo/64ecc9401fb9a1bf9dc1410b-1694315248499.png","status":"offline","id":"64ecc9401fb9a1bf9dc1410b","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":17993,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2023-09-06T20:24:09.312Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/13288631750-1694031849234.webp","executes":7,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f917","editBy":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","status":"offline","id":"64ecc9401fb9a1bf9dc1410b"},"message":"Create script","createdAt":"2025-03-27T15:49:22.414Z"}],"comments":[{"_id":"66630b985e8c51052fc0f613","commentBy":{"_id":"6319e692794c856c1b021f03","username":"Gamer_blox","verified":false,"role":"user","profilePicture":"/images/photo/6319e692794c856c1b021f03-1707568760260.png","createdAt":"2022-09-08T12:56:50.040Z","lastActive":"2026-10-09T16:30:43.086Z","status":"offline","id":"6319e692794c856c1b021f03"},"text":"Game \"script\" OUTDATED.","createdAt":"2024-06-07T13:31:04.105Z","edited":true,"likeCount":1,"liked":false,"disliked":false}]},{"slug":"The-Battle-Bricks:-RGB-Expand-Hitboxes-7444","_id":"64ed16ce557cf18cf7630894","title":"Expand Hitboxes","game":{"_id":"67e5e1ffb360710ec3c78107","gameId":13288631750,"name":"The Battle Bricks: RGB","imageUrl":"/images/sb/rbx-c4c87847126f3d4e4d585b460dd09088-7972212a281c.png","placeId":13288631750},"features":"expands enemy npc's heads hitboxes\n\nedited script","tags":[],"script":"local npcs\nwhile task.wait() do\n  npcs = workspace.NPCFolders.EnemyFolder\n  for _,v in next, npcs:GetChildren() do\n    if not v:FindFirstChild(\"Head\") then continue end\n    v.Head.Size = Vector3.new(40,40,40)\n    v.Head.Material = \"Neon\"\n    v.Head.BrickColor = BrickColor.new(\"Really blue\")\n    v.Head.Transparency = 0.7\n    v.Head.CanCollide = false\n  end\nend","owner":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","verified":false,"profilePicture":"/images/photo/64ecc9401fb9a1bf9dc1410b-1694315248499.png","status":"offline","id":"64ecc9401fb9a1bf9dc1410b","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":25523,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-08-28T21:51:10.416Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/13288631750-1693259470326.webp","executes":22,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f846","editBy":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","status":"offline","id":"64ecc9401fb9a1bf9dc1410b"},"message":"Create script","createdAt":"2025-03-27T23:04:53.222Z"}],"comments":[{"_id":"66630bac29a50abe2bc977e7","commentBy":{"_id":"6319e692794c856c1b021f03","username":"Gamer_blox","verified":false,"role":"user","profilePicture":"/images/photo/6319e692794c856c1b021f03-1707568760260.png","createdAt":"2022-09-08T12:56:50.040Z","lastActive":"2026-10-09T16:30:43.086Z","status":"offline","id":"6319e692794c856c1b021f03"},"text":"Game \"script\" OUTDATED.","createdAt":"2024-06-07T13:31:24.763Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"695634b4ef5a9b718f40667a","commentBy":{"_id":"67cb16c58d1dcd8fd94a0e15","username":"McTeaMick","verified":false,"role":"user","profilePicture":"/images/photo/67cb16c58d1dcd8fd94a0e15-1766039081791.jpg","createdAt":"2025-03-