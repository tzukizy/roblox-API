{"id":133679065471783,"name":"[💜BETA Release💜] MonsterVerze","desc":"","path":"/game/133679065471783-beta-release-monsterverze","slug":"133679065471783-beta-release-monsterverze","thumbnail":["https://tr.rbxcdn.com/180DAY-b3d2c67eb67b7ceb24162016757221e8/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-86e9f5095d6593990f97506afa0627e9/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":200,"visitor":0,"verified":false,"updatedAt":"2025-11-14T11:02:49.503Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"BETA-Release-MonsterVerze-Ghoulars-Collector-64801","_id":"6911e3e9ddfeb8fba8488823","title":"Ghoulars Collector","game":{"_id":"6911e3e9ddfeb8fba8488820","gameId":133679065471783,"name":"[💜BETA Release💜] MonsterVerze","imageUrl":"/images/sb/rbx-86e9f5095d6593990f97506afa0627e9-9488b8e0b2f7.png","placeId":133679065471783},"features":"auto-farm ghoulars lol","tags":["roblox","monsterverze","monsterhigh","farm","autofarm"],"script":"--// Ghoular AutoFarm\n\nlocal player = game.Players.LocalPlayer\nlocal ghoularsFolder = workspace:WaitForChild(\"Ghoulars\"):WaitForChild(\"Assets\")\n\n--// Helper: Get HumanoidRootPart\nlocal function getRoot()\n\tlocal character = player.Character or player.CharacterAdded:Wait()\n\treturn character:WaitForChild(\"HumanoidRootPart\", 5)\nend\n\n--// Simulate a fast touch (TouchInterest)\nlocal function fastTouch(root, part)\n\tif not (root and part and part:IsA(\"BasePart\")) then return end\n\ttask.spawn(function()\n\t\tfiretouchinterest(root, part, 0)\n\t\ttask.wait(0.01) -- ultra-fast touch delay\n\t\tfiretouchinterest(root, part, 1)\n\tend)\nend\n\n--// Collect all TouchInterest parts in a Ghoular\nlocal function collectGhoular(ghoular)\n\tlocal root = getRoot()\n\tif ghoular:IsA(\"Model\") then\n\t\tfor _, obj in ipairs(ghoular:GetDescendants()) do\n\t\t\tif obj:IsA(\"BasePart\") and obj:FindFirstChildOfClass(\"TouchTransmitter\") then\n\t\t\t\tfastTouch(root, obj)\n\t\t\tend\n\t\tend\n\telseif ghoular:IsA(\"BasePart\") and ghoular:FindFirstChildOfClass(\"TouchTransmitter\") then\n\t\tfastTouch(root, ghoular)\n\tend\nend\n\n--// Collect all existing Ghoulars\nlocal function collectAllGhoulars()\n\tfor _, ghoular in ipairs(ghoularsFolder:GetChildren()) do\n\t\ttask.spawn(function()\n\t\t\tcollectGhoular(ghoular)\n\t\tend)\n\tend\nend\n\n--// Instant collection when new Ghoular appears\nghoularsFolder.ChildAdded:Connect(function(newGhoular)\n\ttask.wait(0.05)\n\tcollectGhoular(newGhoular)\nend)\n\n--// Recollect after respawn\nplayer.CharacterAdded:Connect(function()\n\ttask.wait(0.5)\n\tcollectAllGhoulars()\nend)\n\n--// Continuous super-fast loop\ntask.spawn(function()\n\twhile task.wait(0.5) do -- adjust lower for even faster scans (0.2 = max speed)\n\t\tpcall(collectAllGhoulars)\n\tend\nend)\n\n--// Initial run\ncollectAllGhoulars()","owner":{"_id":"690678dd92e25d05e3fee98a","username":"evangelicboyisagun","verified":false,"profilePicture":"/images/photo/690678dd92e25d05e3fee98a-1762780323091.jpg","status":"offline","id":"690678dd92e25d05e3fee98a","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1656,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/133679065471783-1762780137257.jpg","likeCount":3,"dislikeCount":0,"createdAt":"2025-11-10T13:08:57.281Z","editBy":{"_id":"690678dd92e25d05e3fee98a","username":"evangelicboyisagun","status":"offline","id":"690678dd92e25d05e3fee98a"},"keyLink":"","executes":227,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6911e3e9ddfeb8fba8488825","editBy":{"_id":"690678dd92e25d05e3fee98a","username":"evangelicboyisagun","status":"offline","id":"690678dd92e25d05e3fee98a"},"message":"Create script","createdAt":"2025-11-10T13:08:57.285Z"},{"_id":"69170c59843f8af811b19e55","editBy":{"_id":"690678dd92e2