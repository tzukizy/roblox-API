{"id":13377921607,"name":"اكاديمية لوسيفر العسكرية ||تحديث الشتاء","desc":"","path":"/game/13377921607-game","slug":"13377921607-game","thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"playing":0,"visitor":0,"verified":false,"updatedAt":"2025-12-24T10:25:45.276Z","creator":{"name":"Roblox","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"akadymyh-lwsyfr-alaskryh-ororthdyth-alshtaa-Coin-farm-77871","_id":"694bbfa953ead0ca9afe0468","title":"Coin farm","game":{"_id":"67e5e1ffb360710ec3c784ce","gameId":13377921607,"name":"اكاديمية لوسيفر العسكرية ||تحديث الشتاء","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13377921607},"features":"Auto coin farm","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal mouse = player:GetMouse()\nlocal uis = game:GetService(\"UserInputService\")\nlocal tweenService = game:GetService(\"TweenService\")\nlocal runService = game:GetService(\"RunService\")\nlocal workspace = game:GetService(\"Workspace\")\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\nscreenGui.ResetOnSpawn = false\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 300, 0, 150)\nframe.Position = UDim2.new(0.3, 0, 0.3, 0)\nframe.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nframe.BackgroundTransparency = 0.4\nframe.Parent = screenGui\nframe.Active = true\nframe.Draggable = true\n\nlocal frameCorner = Instance.new(\"UICorner\")\nframeCorner.CornerRadius = UDim.new(0, 10)\nframeCorner.Parent = frame\n\nlocal frameStroke = Instance.new(\"UIStroke\")\nframeStroke.Color = Color3.fromRGB(255, 255, 0)\nframeStroke.Thickness = 2\nframeStroke.Parent = frame\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 200, 0, 50)\nbutton.Position = UDim2.new(0.5, -100, 0.3, 0)\nbutton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Text = \"Auto Coin Farm : Off\"\nbutton.TextScaled = false\nbutton.TextSize = 15\nbutton.Parent = frame\n\nlocal buttonCorner = Instance.new(\"UICorner\")\nbuttonCorner.CornerRadius = UDim.new(0, 8)\nbuttonCorner.Parent = button\n\nlocal autoCoin = false\n\nlocal function teleportToCash()\n    if autoCoin then\n        for _, obj in pairs(workspace:GetDescendants()) do\n            if obj:IsA(\"MeshPart\") and obj.Name == \"Cash\" then\n                player.Character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 5, 0)\n                task.wait(0.1)\n            end\n        end\n    end\nend\n\nbutton.MouseButton1Click:Connect(function()\n    autoCoin = not autoCoin\n    button.Text = \"Auto Coin Farm : \" .. (autoCoin and \"On\" or \"Off\")\n    if autoCoin then\n        spawn(function()\n            while autoCoin do\n                teleportToCash()\n                task.wait(0.5)\n            end\n        end)\n    end\nend)\n\nlocal label = Instance.new(\"TextLabel\")\nlabel.Size = UDim2.new(1, 0, 0, 30)\nlabel.Position = UDim2.new(0, 0, 0.8, 0)\nlabel.BackgroundTransparency = 1\nlabel.Text = \"Made by : Nahwinreals\"\nlabel.Font = Enum.Font.SourceSansBold\nlabel.TextSize = 18\nlabel.TextScaled = false\nlabel.Parent = frame\n\nrunService.RenderStepped:Connect(function()\n    local hsv = tick() % 5 / 5\n    label.TextColor3 = Color3.fromHSV(hsv, 1, 1)\nend)","owner":{"_id":"692857857c94f7b697a008ed","username":"Brothers","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"692857857c94f7b697a008ed","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":351,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"u