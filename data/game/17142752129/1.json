script":"local player = game.Players.LocalPlayer\nlocal gui = player:WaitForChild(\"PlayerGui\"):WaitForChild(\"BarMiniGame\")\nlocal bar = gui:WaitForChild(\"Main\"):WaitForChild(\"BarBg\")\nlocal green = bar:WaitForChild(\"Green\")\nlocal slider = bar:WaitForChild(\"Slider\")\nlocal autoClicking = false\nlocal running = false\n\nlocal function click()\n    running = true\n    while autoClicking do\n        task.wait(0.007)\n        if slider and green then\n            local sliderPos = slider.AbsolutePosition\n            local greenPos = green.AbsolutePosition\n            local greenSize = green.AbsoluteSize\n            if sliderPos.X >= greenPos.X and sliderPos.X <= (greenPos.X + greenSize.X) then\n                local input = game:GetService(\"VirtualInputManager\")\n                if game:GetService(\"UserInputService\").TouchEnabled then\n                    input:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n                    task.wait(0.09)\n                    input:SendMouseButtonEvent(0, 0, 0, false, game, 0)\n                else\n                    input:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n                    task.wait(0.09)\n                    input:SendMouseButtonEvent(0, 0, 0, false, game, 0)\n                end\n            end\n        end\n    end\n    running = false\nend\n\nlocal function monitor()\n    gui:GetPropertyChangedSignal(\"Enabled\"):Connect(function()\n        if gui.Enabled then\n            autoClicking = true\n            if not running then\n                task.spawn(click)\n            end\n        else\n            autoClicking = false\n        end\n    end)\nend\n\nmonitor()\n","features":"V2 version is smoother and better and works on Pc & Mobiles","tags":["auto","Crack it","crack it","autofarm"],"discord":"","keyLink":"","owner":{"_id":"66f57fd5d56dd8085a8b51e3","username":"Zous","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff4355