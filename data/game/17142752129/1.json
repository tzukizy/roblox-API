dn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-34747f37dbb938e04ed91a26cd018d8d/500/280/Image/Jpeg/noFilter"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-01-02T13:14:26.630Z","updatedAt":"2025-01-02T13:14:26.630Z","lastBump":"2025-01-02T13:14:26.630Z","script":"-- By Zous\nlocal player = game.Players.LocalPlayer\nlocal gui = player:WaitForChild(\"PlayerGui\"):WaitForChild(\"BarMiniGame\")\nlocal bar = gui:WaitForChild(\"Main\"):WaitForChild(\"BarBg\")\nlocal green = bar:WaitForChild(\"Green\")\nlocal slider = bar:WaitForChild(\"Slider\")\nlocal autoClicking = false\nlocal running = false\n\nlocal function click()\n    running = true\n    while autoClicking do\n        task.wait(0.02)\n        if slider and green then\n            local sliderPos = slider.AbsolutePosition\n            local greenPos = green.AbsolutePosition\n            local greenSize = green.AbsoluteSize\n            if sliderPos.X >= greenPos.X and sliderPos.X <= (greenPos.X + greenSize.X) then\n                local input = game:GetService(\"VirtualInputManager\")\n                input:SendMouseButtonEvent(0, 0, 0, true, game, 0)\n                task.wait(0.1)\n                input:SendMouseButtonEvent(0, 0, 0, false, game, 0)\n            end\n        end\n    end\n    running = false\nend\n\nlocal function monitor()\n    gui:GetPropertyChangedSignal(\"Enabled\"):Connect(function()\n        if gui.Enabled then\n            autoClicking = true\n            if not running then\n                task.spawn(click)\n            end\n        else\n            autoClicking = false\n        end\n    end)\nend\n\nmonitor()\n","features":"just an autocrack only pc","tags":["crack it","aut","autfarm","autofarm","farm"],"discord":"","keyLink":"","owner":{"_id":"66f57fd5d56dd8085a8b51e3","username":"Zous","verified":false,"profilePicture":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff435566a18.webp","original":"https://scriptblox.com/images/photo/66f57fd5d56dd8085a8b51e3-1729628668273.png"},"status":"offline","id":"66f57fd5d56dd8085a8b51e3","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/dbcac38703760be28ec508d17b7962f10072d1e5ac09f2175a079ff435566a18.webp","original":"https://scriptblox.com/images/photo/66f57fd5d56dd8085a8b51e3-1729628668273.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:10:36.133Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53e41","editBy":{"_id":"66f57fd5d56dd8085a8b51e3","username":"Zous","status":"offline","id":"66f57fd5d56dd8085a8b51e3"},"message":"Create script","createdAt":"2025-03-27T21:17:52.770Z"}],"comments":[{"_id":"6776928321958b1e79ed2171","commentBy":{"_id":"677690609fda94125e3f81bc","username":"BARCODE69","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/ec4925dc327a650f217aa25ca3a7354974fee8297db8dd7a30ddf8d9d4b1fc46.webp","original":"https://scriptblox.com/images/photo/677690609fda94125e3f81bc-1735823660333.jpg"},"createdAt":"2025-01-02T13:10:56.531Z","lastActive":"2025-01-29T07:14:26.692Z","status":"offline","id":"677690609fda94125e3f81bc","profile":{"url":"https://media.kocakz.me/ec4925dc327a650f217aa25ca3a7354974fee8297db8dd7a30ddf8d9d4b1fc46.webp","original":"https://scriptblox.com/images/photo/677690609fda94125e3f81bc-1735823660333.jpg"}},"text":"thankyou","createdAt":"2025-01-02T13:20:03.995Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_