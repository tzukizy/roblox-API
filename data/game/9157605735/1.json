8804513 10) (:music 6888804513 1)\n:music SOUNDID VOLUME PITCH – Plays Plays the music with the given soundid, volume, and pitch (:music 6888804513 1 0.1) (:music 6888804513 1 10)\n:whitelist PLAYERNAME – Whitelists the matching player, and lets them use commands like kick and kill on anyone but you. (:whitelist Aidez) (:whitelist Aid) (:whitelist others) (:whitelist all)\n:unwhitelist PLAYERNAME – Unwhitelists the matching player. (:unwhitelist Aidez) (:unwhitelist Aid) (:unwhitelist others) (:unwhitelist all)\n:whitelisted – Prints a list of players who are whitelisted\n!! PRESS ‘ TO TYPE IN COMMAND BAR !!","tags":["loop kill","silentaim","op gui","cmds"],"script":"loadstring(game:HttpGet(('https://raw.githubusercontent.com/Aidez/MiscGunTest_X/main/command_script'),true))()","owner":{"_id":"6257e5f13f2fda76fed0169b","username":"ziroponto","verified":false,"profilePicture":"/images/photo/6257e5f13f2fda76fed0169b-1665795395801.jpg","status":"offline","id":"6257e5f13f2fda76fed0169b","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":100}},"verified":false,"views":37739,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-08-20T05:50:07.071Z","dislikeCount":6,"likeCount":2,"image":"https://tr.rbxcdn.com/194637162aa653899ebeca22200b0717/500/280/Image/Jpeg","executes":174,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f404","editBy":{"_id":"6257e5f13f2fda76fed0169b","username":"ziroponto","status":"offline","id":"6257e5f13f2fda76fed0169b"},"message":"Create script","createdAt":"2025-03-27T22:59:39.983Z"}],"comments":[{"_id":"63010226a9946ba07d53186f","commentBy":{"_id":"62e8184b4d67a59b7e1ae874","username":"kjay0207","verified":false,"role":"user","profilePicture":"/images/user-default.png","createdAt":"2022-08-01T18:15:39.467Z","lastActive":"2022-09-06T15:18:47.758Z","status":"offline","id":"62e8184b4d67a59b7e1ae874"},"text":"ju