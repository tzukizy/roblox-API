"liked":false,"disliked":false}]},{"_id":"678bbdb5df4c184cc3009916","title":"Auto Mine Ores","game":{"_id":"67e5e1ffb360710ec3c77f45","gameId":116434053579571,"name":"[TESTING] Mining GO! ⛏️","imageUrl":{"url":"https://media.kocakz.me/adff10c40681353726a99d59486f51b0dc072c1c53bea0f6ab80f3f7f1a97554.webp","original":"https://tr.rbxcdn.com/180DAY-6926c0a149b67eb8beaa35e1f0880a62/150/150/Image/Png/noFilter"},"slug":"116434053579571-mining-go","path":"/game/116434053579571-mining-go","thumbnail":{"url":"https://media.kocakz.me/adff10c40681353726a99d59486f51b0dc072c1c53bea0f6ab80f3f7f1a97554.webp","original":"https://tr.rbxcdn.com/180DAY-6926c0a149b67eb8beaa35e1f0880a62/150/150/Image/Png/noFilter"},"placeId":116434053579571},"slug":"TESTING-Mining-GO!-Auto-Mine-Ores-27073","verified":false,"key":false,"keyless":false,"views":5024,"executes":44,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/f7de2acf45b4914f3429195818d69191852c8ea1fccc23ffdff405b25333f690.webp","original":"https://scriptblox.com/images/sb/116434053579571-1737211317918.png","scriptblox":"https://scriptblox.com/images/script/116434053579571-1737211317918.png"},"thumbnail":{"url":"https://media.kocakz.me/f7de2acf45b4914f3429195818d69191852c8ea1fccc23ffdff405b25333f690.webp","original":"https://scriptblox.com/images/sb/116434053579571-1737211317918.png","scriptblox":"https://scriptblox.com/images/script/116434053579571-1737211317918.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-01-18T14:41:57.960Z","updatedAt":"2025-01-18T14:41:57.960Z","lastBump":"2025-01-18T14:41:57.960Z","script":"-- Hawk tuah\n_G.MiningEnabled = true\n\nwhile _G.MiningEnabled do\n    local oresFolder = game.Workspace:FindFirstChild(\"Ores\")\n    local player = game.Players.LocalPlayer\n    local closestOre = nil\n    local shortestDistance = math.huge\n\n    if oresFolder then\n        for _, object in pairs(oresFolder:GetChildren()) do\n            if object:IsA(\"Model\") then\n                local basePart = object:FindFirstChild(\"Base\")\n                if basePart then\n                    local existingHighlight = object:FindFirstChildOfClass(\"Highlight\")\n                    if not existingHighlight then\n                        local highlight = Instance.new(\"Highlight\")\n                        highlight.Parent = object\n                        highlight.Adornee = object\n                        highlight.FillColor = Color3.fromRGB(30, 129, 176)\n                        highlight.FillTransparency = 0.5\n                    end\n                end\n            end\n        end\n\n        for _, object in pairs(oresFolder:GetChildren()) do\n            if object:IsA(\"Model\") then\n                local basePart = object:FindFirstChild(\"Base\")\n                if basePart then\n                    local distance = (player.Character.HumanoidRootPart.Position - basePart.Position).Magnitude\n                    if distance < shortestDistance then\n                        closestOre = object\n                        shortestDistance = distance\n                    end\n                end\n            end\n        end\n\n        if closestOre then\n            local closestHighlight = closestOre:FindFirstChildOfClass(\"Highlight\")\n            if closestHighlight then\n                closestHighlight.FillColor = Color3.fromRGB(30, 176, 30)\n            else\n                closestHighlight = Instance.new(\"Highlight\")\n                closestHighlight.Parent = closestOre\n                closestHighlight.Adornee = closestOre\n                closestHighlight.FillColor = Color3.fromRGB(30, 176, 30)\n                closestHighlight.FillTransparency = 0.5\n            end\n\n            local oreTip = closestOre:FindFirstChildOfClass(\"BillboardGui\")\n            if oreTip then\n                if oreTip.Name == \"OreTip\" then\n                    local args1 = { [1] = \"Mining_Start\"}\n                    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"_Binder_Event\"):FireServer(unpack(args1))\n\n                    task.wait(0.5)\n                    local args2 = { [1] = \"Mining_MineOre\", [2] = closestOre.Name, [3] = 0.7, [4] = true}\n                    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"_Binder_Event\"):FireServer(unpack(args2))\n\n                elseif oreTip.Name == \"OreTipGiant\" then\n                    local args3 = { [1] = \"Mining_Start\"}\n                    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"_Binder_Event\"):FireServer(unpack(args3))\n\n                    task.wait(0.5)\n                    local args4 = { [1] = \"Mining_MineOreP\", [2] = closestOre.Name, [3] = 0.7, [4] = false}\n                    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"_Binder_Event\"):FireServer(unpack(args4))\n                end\n            end\n            closestHighlight:Destroy()\n        else\n            warn(\"no ores found\")\n        end\n    end\n\n    task.wait(0.01)\nend","features":"a simple auto mine, should work with no problems at all (ONLY TESTED ON AWP.gg)\n\nFeatures:\n- Auto Mine Ores (giant ores might be broken idk)\n- Simple Ore ESP\n\nif u wanna disable this just execute this: (ore esp doesnt go away until u break all of the ores)\n_G.MiningEnabled = false \n\nto enable back just execute the script below, also u still have to walk up to the ores to actually mine them, too lazy to make it walk up to the ores","tags":["auto farm","mining go","free auto farm","auto mine","ore esp"],"discord":"","keyLink":"","owner":{"_id":"65ff44ab54244f33e1488ed5","username":"realbilly","verified":false,"profilePicture":{"url":"https://media.kocakz.me/423490cdced350f69fb167968828d1d08a505329d184c6eb312a3c46055fd64b.webp","original":"https://scriptblox.com/images/photo/65ff44ab54244f33e1488ed5-1711228130308.png"},"status":"offline","id":"65ff44ab54244f33e1488ed5","topMilestone":{"key"