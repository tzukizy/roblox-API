 for i=1,Thread do\n        task.spawn(function()\n            while task.wait(delay) do\n                gun.Parent = Player.Backpack\n                Player.Backpack[banner].RemoteEvent:FireServer()\n            end\n        end)\n    end\nend","owner":{"_id":"693c68452127f38390da99ac","username":"arsyny1x","verified":false,"profilePicture":"/images/photo/693c68452127f38390da99ac-1766821682714.png","status":"offline","id":"693c68452127f38390da99ac","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1786,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-950188b49d05c39dd398fe965faa1dc7-66b789bf1d36.png","likeCount":1,"dislikeCount":1,"createdAt":"2025-12-20T06:22:59.445Z","editBy":{"_id":"693c68452127f38390da99ac","username":"arsyny1x","status":"offline","id":"693c68452127f38390da99ac"},"keyLink":"","executes":1934,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"694640c30d904aa5d1390fc9","editBy":{"_id":"693c68452127f38390da99ac","username":"arsyny1x","status":"offline","id":"693c68452127f38390da99ac"},"message":"Create script","createdAt":"2025-12-20T06:22:59.447Z"},{"_id":"69464adf49abd0da146e3b11","editBy":{"_id":"693c68452127f38390da99ac","username":"arsyny1x","status":"offline","id":"693c68452127f38390da99ac"},"message":"fix performace for mobile user","createdAt":"2025-12-20T07:06:07.765Z"},{"_id":"69467cd366df14f48311408b","editBy":{"_id":"693c68452127f38390da99ac","username":"arsyny1x","status":"offline","id":"693c68452127f38390da99ac"},"message":"Update script","createdAt":"2025-12-20T10:39:15.679Z"},{"_id":"694693e7cfad1856c5fe6b99","editBy":{"_id":"693c68452127f38390da99ac","username":"arsyny1x","status":"offline","id":"693c68452127f38390da99ac"},"message":"Update script","createdAt":"2025-12-20T12:17:43.003Z"}],"comments":[{"_id":"6aad1e53a2ce65d3e30f570b","commentBy":{"_id":"6aabce5d0fedff80a9d80380","username":"phea