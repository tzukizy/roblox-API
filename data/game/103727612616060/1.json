{"id":103727612616060,"name":"🇦🇺Better Country?!🇺🇸","desc":"Silly little game i made for fun, don't take it too seriously. - I am unsure what to add next, please feel free to suggest things in feedback.\n\n🇧🇷🇺🇸🇨🇦 Welcome to Better Country! 🇦🇺🇰🇷🇨🇳\n\n⭐👍 LIKE and FAVORITE the game for new updates! 👍⭐\n\n🎮🌎 Game Rules\n⭐️🌍Choose 1 Country that has been selected!\n🗡️🌏Fight for your country choice with weapons!\n🏆🌐Successfully defend your country choice and bring the country a win for your team!\n\n⚠️ Better country is not intended to be political or represent real life conflicts in any way, it is intended to be a geography game. ⚠️\n\nInspired by better music, better movie and better kpop!\n\nTags 🏷️ \n--\nAustralia, Russia, France, Spain, United States, America, Italy, Turkey, Mexico, United Kingdom, Germany, Japan, Indonesia, Greece, New Zealand, Israel, Korea, Iran, Iraq, Mexico\n--\nPick A Flag, Pick a Side, Quiz, Fight, Sword, Battle, Red vs Blue, better kpop","path":"/game/103727612616060-better-country","slug":"103727612616060-better-country","thumbnail":{"url":"https://media.kocakz.me/02275a7b04581a989e83779a4901f858a317ad52e2e2b9e031bb3d6be2c8c42d.webp","original":"https://tr.rbxcdn.com/180DAY-b0e123b287589e3bc22a56148e503f0c/150/150/Image/Png/noFilter"},"playing":6,"visitor":9054886,"verified":false,"updatedAt":"2024-12-23T06:31:41.715Z","creator":{"name":"MajorGalah","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"676903cd13bf69140fc1989c","title":"KILL AURA","game":{"_id":"67e5e1ffb360710ec3c7876e","gameId":103727612616060,"name":"🇦🇺Better Country?!🇺🇸","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"103727612616060-better-country","path":"/game/103727612616060-better-country","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":103727612616060},"slug":"Better-Country!-KILL-AURA-25034","verified":false,"key":false,"keyless":false,"views":8662,"executes":57,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-2ca1739d480ca80a1b144011588f8b28/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-2ca1739d480ca80a1b144011588f8b28/500/280/Image/Jpeg/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-2ca1739d480ca80a1b144011588f8b28/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-2ca1739d480ca80a1b144011588f8b28/500/280/Image/Jpeg/noFilter"},"likeCount":3,"dislikeCount":0,"createdAt":"2024-12-23T06:31:41.715Z","updatedAt":"2024-12-23T06:31:41.715Z","lastBump":"2024-12-23T06:31:41.715Z","script":"local cloneref = cloneref or function(obj) return obj end\nlocal Players = cloneref(game:GetService(\"Players\"))\nlocal lp = cloneref(Players.LocalPlayer)\n\nlocal function getchar(plr)\n    return (plr or lp).Character\nend\nlocal function gethumanoid(plr)\n    local char = plr and plr:IsA(\"Model\") and plr or getchar(plr)\n    return (char and char:FindFirstChildWhichIsA(\"Humanoid\")),char\nend\nlocal function GetHumanoids()\n    local Humanoids = {}\n    for i,v in Players:GetPlayers() do\n        local Humanoid,char = gethumanoid(v)\n        if char and Humanoid then\n            Humanoids[char] = Humanoid\n        end\n    end\n    return Humanoids\nend\n\nwhile task.wait() do\n    for _, v in GetHumanoids() do\n        repeat task.wait() until v\n        if v ~= lp then\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"SwordEvent\"):FireServer(\"Damage\",v)\n        end\n    end\nend","features":"kill aura","tags":["kill aura","FE","kill"],"discord":"","keyLink":"","owner":{"_id":"64d74e5160ae83e54e4b1d4e","username":"barcon","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9d4a4a35ebf2a