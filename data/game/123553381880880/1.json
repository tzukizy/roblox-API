{"id":123553381880880,"name":"[🐰] KABOOM!","desc":"Fast-paced explosive combat.\nEliminate opponents to earn points and secure fragments for progression.\n\n🎯 SCORING SYSTEM\n- Elimination: 2 Points\n- Headshot: 3 Points\n- Assist: 1 Point\n- 10 Points = 1 Fragment\n\n📱COMPATIBILITY\n- Full support for PC, Mobile, and Console.\n\nCreated by Stey Games\n\n@Alecstey - Lead Programming & Game Design\n@JustG4h - Lead Visuals, Environment & Game Design\n\n🛠️ V1.0.8 - Expect frequent updates.","path":"/game/123553381880880-kaboom","slug":"123553381880880-kaboom","thumbnail":{"url":"https://media.kocakz.me/69ca91cdd4c8eb6b523a944e18ef35594096648ddad2a8834b82de4d8abc89c3.webp","original":"https://tr.rbxcdn.com/180DAY-961d08b0f6e6111a22c46a35c546cc81/150/150/Image/Png/noFilter"},"playing":15,"visitor":12175598,"verified":false,"updatedAt":"2026-03-29T22:28:53.070Z","creator":{"name":"Ka Boom!","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"69c9a7a51cc83da184241555","title":"Inf secondary","game":{"_id":"69badc55d990362ce2065be9","gameId":123553381880880,"name":"[🐰] KABOOM!","imageUrl":{"url":"https://media.kocakz.me/a609be9c77a472593963eda1053f88b75c9539b15d37947707609d741128dd36.webp","original":"https://scriptblox.com/images/sb/rbx-940b5557648fd5d14961fd98d001d791-3b2c4ee1d38b.png"},"slug":"123553381880880-kaboom","path":"/game/123553381880880-kaboom","thumbnail":{"url":"https://media.kocakz.me/a609be9c77a472593963eda1053f88b75c9539b15d37947707609d741128dd36.webp","original":"https://scriptblox.com/images/sb/rbx-940b5557648fd5d14961fd98d001d791-3b2c4ee1d38b.png"},"placeId":123553381880880},"slug":"KABOOM!-Inf-secondary-165530","verified":false,"key":false,"keyless":false,"views":2121,"executes":294,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/961567a8313cf4699e3ec21384a48fd483df653f35bacd2d88309526e997b42d.webp","original":"https://scriptblox.com/images/sb/rbx-c8804365b04faf24582045f89f07a955-a6b985022829.png","scriptblox":"https://scriptblox.com/images/script/rbx-c8804365b04faf24582045f89f07a955-a6b985022829.png"},"thumbnail":{"url":"https://media.kocakz.me/961567a8313cf4699e3ec21384a48fd483df653f35bacd2d88309526e997b42d.webp","original":"https://scriptblox.com/images/sb/rbx-c8804365b04faf24582045f89f07a955-a6b985022829.png","scriptblox":"https://scriptblox.com/images/script/rbx-c8804365b04faf24582045f89f07a955-a6b985022829.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-03-29T22:28:53.072Z","updatedAt":"2026-03-29T22:28:53.072Z","lastBump":"2026-03-29T22:28:53.072Z","script":"--[[\n    RPG Exploit - Security Testing\n    Target: RPG Explosive Weapon\n]]\n\nlocal function findAndModifyRPG()\n    -- Modify config table\n    for _, value in pairs(getgc(true)) do\n        if type(value) == \"table\" then\n            -- Find RPG config by matching structure\n            if rawget(value, \"Type\") == \"Explosive\" \n            and rawget(value, \"ClipSize\") == 1 \n            and rawget(value, \"ReserveAmmo\") == 20 \n            and rawget(value, \"Weight\") == 1.1 then\n                \n                local cooldowns = rawget(value, \"Cooldowns\")\n                local recoil = rawget(value, \"Recoil\")\n                \n                if cooldowns and recoil then\n                    -- Infinite ammo\n                    rawset(value, \"Ammo\", 9e9)\n                    rawset(value, \"ClipSize\", 9e9)\n                    rawset(value, \"ReserveAmmo\", 9e9)\n                    \n                    -- No cooldowns\n                    rawset(cooldowns, \"Reload\", 0)\n                    rawset(cooldowns, \"Fire\", 0)\n                    \n                    -- No recoil\n                    rawset(recoil, \"Intensity\", 0)\n                    rawset(recoil, \"Duration\", 0)\n                    \n                    print(\"[RPG] Config modified successfully\")\n                end\n            end\n            \n            -- Find RPG instance by matching weapon meta\n            local meta = rawget(value, \"_weaponMeta\")\n            if meta and meta.Name == \"RPG\" and meta.Class == \"Explosives\" then\n                local tool = rawget(value, \"_tool\")\n                \n                if tool then\n                    -- Infinite ammo on tool\n                    tool:SetAttribute(\"Ammo\", 9e9)\n                    tool:SetAttribute(\"ClipSize\", 9e9)\n                    tool:SetAttribute(\"ReserveAmmo\", 9e9)\n                    \n                    print(\"[RPG] Instance modified successfully\")\n                end\n            end\n            \n            -- Find and bypass cooldown manager\n            if rawget(value, \"GetAction\") and rawget(value, \"AddAction\") and rawget(value, \"Cleanup\") then\n                rawset(value, \"GetAction\", function()\n                    return nil\n                end)\n                \n                print(\"[RPG] Cooldown bypass active\")\n            end\n        end\n    end\nend\n\nfindAndModifyRPG()","features":"Excu Pull out he nades or tennis balls best to use with auto clicker","tags":[],"discord":"","keyLink":"","owner":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"profilePicture":{"url":"https://media.kocakz.me/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"},"lvl":12,"status":"offline","id":"687eba7419599ad33f38a3db","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,