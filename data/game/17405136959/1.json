toolsFound = true\n                    break\n                end\n            end\n        end\n    end\n\n    if not toolsFound then\n        print(\"None of the specified tools were found.\")\n    end\nend\n\nlocal function onCharacterAdded(character)\n    character:WaitForChild(\"Humanoid\").Died:Connect(function()\n        getTools()\n    end)\nend\n\nplayer.CharacterAdded:Connect(onCharacterAdded)\nif player.Character then\n    onCharacterAdded(player.Character)\nend\n\ngetTools()\n","owner":{"_id":"65cb70dbcd3cb06a42609d02","username":"Stellar","verified":false,"profilePicture":{"url":"https://media.kocakz.me/03ac3e9ff65ca04ba740aa6e1dc74fcb335d9c5de55268990ef315133bccf3af.webp","original":"https://scriptblox.com/images/photo/65cb70dbcd3cb06a42609d02-1739549425429.png"},"status":"offline","id":"65cb70dbcd3cb06a42609d02","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/03ac3e9ff65ca04ba740aa6e1dc74fcb335d9c5de55268990ef315133bccf3af.webp","original":"https://scriptblox.com/images/photo/65cb70dbcd3cb06a42609d02-1739549425429.png"}},"verified":false,"keyLink":"","views":132438,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-21T17:59:35.631Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://media.kocakz.me/8827e7b3419e573fcb9a990ce0d463934d05e22d83085604c280a5f5420b5931.webp","original":"https://scriptblox.com/images/sb/17405136959-1721584775577.png","scriptblox":"https://scriptblox.com/images/script/17405136959-1721584775577.png"},"executes":163,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":1,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-18T02:19:35.301Z","last":"b","win":14,"math":3,"why":{"pa":1}},"thumbnail":{"url":"https://media.kocakz.me/8827e7b3419e573fcb9a990ce0d463934d05e22d83085604c280a5f5420b5931.webp","original":"https://scriptblox.com/images/sb/174