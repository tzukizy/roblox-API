ox.com/images/script/rbx-165e30d1052e744a0be3641bf5a9c823-50dc23d4959d.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-09-11T10:16:58.968Z","updatedAt":"2025-09-11T10:16:58.968Z","lastBump":"2025-09-11T10:16:58.968Z","script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal GodMode = false\nlocal KillAll = false\nlocal Library = loadstring(game:HttpGet((\"https://raw.githubusercontent.com/theneutral0ne/wally-modified/refs/heads/main/wally-modified.lua\")))()\nlocal Window = Library:CreateWindow('Credit: Neutral')\nWindow:Toggle(\"God Mode\", {}, function(value)\n    GodMode = value\nend)\nWindow:Toggle(\"Kill All\", {}, function(value)\n    KillAll = value\n    if KillAll then\n        for _,v in workspace:GetChildren() do\n            if v:GetAttribute(\"State\") and v:FindFirstChild(\"Humanoid\") and v.Humanoid.Health > 0 then\n                ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RF/Damage\"]:InvokeServer(v,v.Humanoid.Health)\n            end\n        end\n    end\nend)\n\nCharacter.Humanoid.HealthChanged:Connect(function()\n    if GodMode then\n        ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RE/Damage\"]:FireServer(Character,-1)\n    end\nend)\n\nLocalPlayer.CharacterAdded:Connect(function(Character)\n    Character.Humanoid.HealthChanged:Connect(function()\n        if GodMode then\n            ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RE/Damage\"]:FireServer(Character,-1)\n        end\n    end)\nend)\n\nworkspace.ChildAdded:Connect(function(Child)\n    task.wait(1)\n    if KillAll and Child:GetAttribute(\"State\") and Child:FindFirstChild(\"Humanoid\") and Child.Humanoid.Health > 0 then\n        ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RF/Damage\"]:InvokeServer(Child,Child.Humanoid.Health)\n    end\nend)","features":"God Mode\nKill All","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:59:17.930Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c2a19aa756eaef5f7117ae","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2025-09-11T10:16:58.971Z"}],"comments":[{"_id":"68c51f07236287b31c4ab8d2","commentBy":{"_id":"67d019326e7623d225104c67","username":"ScriptTrol","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/fc0e3d77de52980d33052d7de32deb64f0efec4e508ee2855e86f015bde835c1.webp","original":"https://scriptblox.com/images/photo/67d019326e7623d225104c67-1784127246698.png"},"createdAt":"2025-03-11T11:06:26.253Z","lastActive":"2026-10-15T11:35:09.970Z","lvl":17,"status":"offline","id":"67d019326e7623d225104c67","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/fc0e3d77de52980d33052d7de32deb64f0efec4e508ee2855e86f015bde835c1.we