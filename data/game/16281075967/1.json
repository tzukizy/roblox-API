\n            end\n        end\n    end\nend)\n\nCharacter.Humanoid.HealthChanged:Connect(function()\n    if GodMode then\n        ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RE/Damage\"]:FireServer(Character,-1)\n    end\nend)\n\nLocalPlayer.CharacterAdded:Connect(function(Character)\n    Character.Humanoid.HealthChanged:Connect(function()\n        if GodMode then\n            ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RE/Damage\"]:FireServer(Character,-1)\n        end\n    end)\nend)\n\nworkspace.ChildAdded:Connect(function(Child)\n    task.wait(1)\n    if KillAll and Child:GetAttribute(\"State\") and Child:FindFirstChild(\"Humanoid\") and Child.Humanoid.Health > 0 then\n        ReplicatedStorage.Packages[\"_Index\"][\"sleitnick_net@0.1.0\"][\"net\"][\"RF/Damage\"]:InvokeServer(Child,Child.Humanoid.Health)\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":3957,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-165e30d1052e744a0be3641bf5a9c823-50dc23d4959d.png","likeCount":3,"dislikeCount":0,"createdAt":"2025-09-11T10:16:58.968Z","executes":263,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c2a19aa756eaef5f7117ae","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2025-09-11T10:16:58.971Z"}],"comments":[{"_id":"68c51f07236287b31c4ab8d2","commentBy":{"_id":"67d019326e7623d225104c67","username":"ScriptTrol","verified":false,"role":"user","profilePicture":"/images/photo/67d019326e7623d225104c67-1784127246698.png","created