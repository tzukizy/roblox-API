{"id":0,"name":"Universal Scripts","desc":"Universal Roblox scripts, admin command panels, and game-agnostic utilities engineered to work across any Roblox experience.","path":"/game/universal","slug":"universal","thumbnail":["/brand/kocakz-logo.png"],"playing":0,"visitor":0,"verified":true,"updatedAt":"2026-09-29T15:33:41.020Z","creator":{"name":"Universal / Community","type":"Community"},"script":{"count":25128,"freeCount":25128,"keyCount":1,"verifiedCount":299},"page":901,"next":902,"total":1257,"scripts":[{"slug":"Universal-Script-SAJAD-34535","_id":"67f351ee9695f884e69b64f6","title":"SAJAD","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1743999470106.jpg","placeId":0},"features":"استخدمو","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Sadfffaj/-/refs/heads/main/Protected_3892383472327512.txt\"))()","owner":{"_id":"678bfb50df4c184cc3082904","username":"RemixHUB","verified":false,"profilePicture":"/images/photo/678bfb50df4c184cc3082904-1746869242931.jpg","status":"offline","id":"678bfb50df4c184cc3082904","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":536,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1743999470106.jpg","likeCount":1,"dislikeCount":1,"createdAt":"2025-04-07T04:17:50.162Z","executes":7,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f351ee9695f884e69b64f8","editBy":{"_id":"678bfb50df4c184cc3082904","username":"RemixHUB","status":"offline","id":"678bfb50df4c184cc3082904"},"message":"Create script","createdAt":"2025-04-07T04:17:50.168Z"}],"comments":[]},{"slug":"Universal-Script-Ryukehub-Poop-gui-NEW-34514","_id":"67f32fca4671b518706920b5","title":"Ryukehub Poop gui NEW","game":{"_id":"67e5e1ffb360710ec3c77d0f","gameId":0,"name":"Universal Script 📌","imageUrl":"/images/sb/0-1743990730586.png","placeId":0},"features":"Hehe boii you can troll others","tags":[],"script":"local Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua\"))()\nlocal Window = Library.CreateLib(\"Dito's Poop GUI\", \"Neon\")\n\nlocal TrollTab = Window:NewTab(\"Troll\")\nlocal TrollSection = TrollTab:NewSection(\"Troll Tools\")\n\n-- Throw Poop\nTrollSection:NewButton(\"Throw Poop\", \"Throws a legendary poop\", function()\n    local poop = Instance.new(\"Part\", workspace)\n    poop.Size = Vector3.new(2,2,2)\n    poop.Position = game.Players.LocalPlayer.Character.Head.Position + Vector3.new(0,5,0)\n    poop.BrickColor = BrickColor.new(\"Brown\")\n    poop.Shape = Enum.PartType.Ball\n    poop.Name = \"POOP\"\n\n    local sound = Instance.new(\"Sound\", poop)\n    sound.SoundId = \"rbxassetid://138186576\"\n    sound:Play()\n\n    poop.Touched:Connect(function(hit)\n        if hit.Parent:FindFirstChild(\"Humanoid\") then\n            hit.Parent.Humanoid:TakeDamage(5)\n        end\n    end)\nend)\n\n-- Fart Bomb\nTrollSection:NewButton(\"Fart Bomb\", \"BOOOOM!\", function()\n    local bomb = Instance.new(\"Part\", workspace)\n    bomb.Size = Vector3.new(2, 2, 2)\n    bomb.Position = game.Players.LocalPlayer.Character.Head.Position + Vector3.new(0, 5, 0)\n    bomb.BrickColor = BrickColor.new(\"Bright green\")\n    bomb.Shape = Enum.PartType.Ball\n    bomb.Name = \"FartBomb\"\n\n    local sound = Instance.new(\"Sound\", bomb)\n    sound.SoundId = \"rbxassetid://138186576\"\n    sound:Play()\n\n    wait(2)\n    local explosion = Instance.new(\"Explosion\", workspace)\n    explosion.Position = bomb.Position\n    explosion.BlastRadius = 10\n    explosion.BlastPressure = 50000\n\n    bomb:Destroy()\nend)\n\n-- Poop Rain\nTrollSection:NewButton(\"Poop Rain\", \"Make it rain... poop\", function()\n    for i = 1, 20 do\n        local poop = Instance.new(\"Part\", workspace)\n        poop.Size = Vector3.new(2, 2, 2)\n        poop.Position = Vector3.new(math.random(-50, 50), 100, math.random(-50, 50))\n        poop.BrickColor = BrickColor.new(\"Brown\")\n        poop.Shape = Enum.PartType.Ball\n        poop.Anchored = false\n        poop.Name = \"RainPoop\"\n        poop.Material = Enum.Material.SmoothPlastic\n        wait(0.1)\n    end\nend)\n\n-- Slap Hand\nTrollSection:NewButton(\"Slap Hand\", \"Random slap attack\", function()\n    for _, plr in pairs(game.Players:GetPlayers()) do\n        if plr ~= game.Players.LocalPlayer and plr.Character then\n            local hand = Instance.new(\"Part\", workspace)\n            hand.Size = Vector3.new(4, 1, 4)\n            hand.Position = plr.Character.Head.Position + Vector3.new(0, 5, 0)\n            hand.BrickColor = BrickColor.new(\"Really red\")\n            hand.Anchored = false\n            hand.Name = \"SlapHand\"\n            hand.Material = Enum.Material.SmoothPlastic\n\n            local sound = Instance.new(\"Sound\", hand)\n            sound.SoundId = \"rbxassetid://623514604\"\n            sound:Play()\n\n            hand.Touched:Connect(function(hit)\n                if hit.Parent:FindFirstChild(\"Humanoid\") then\n                    hit.Parent.Humanoid:TakeDamage(10)\n                end\n            end)\n        end\n    end\nend)","owner":{"_id":"67b0ae369816ebf0d393d3fc","username":"ditostudio7","verified":false,"profilePicture":"/images/photo/67b0ae369816ebf0d393d3fc-1743866557105.png","status":"offline","id":"67b0ae369816ebf0d393d3fc","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":5171,"scriptType":"free","isUniversal":true,"isPatched":false,"visibility":"public","image":"/images/sb/0-1743990730586.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-04-07T01:52:10.648Z","executes":127,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f32fca4671b518706920b8","editBy":{"_id":"67b0ae369816ebf0d393d3fc","username":"ditostudio7","status":"offline","id":"67b0ae369816ebf0d393d3fc"},"mes