08aff820cfc257051ec9977e8f043a9.webp","original":"https://scriptblox.com/images/sb/rbx-1d7de109d01134dd4466e61e5e0f0813-7f4bd5d5ee7d.png","scriptblox":"https://scriptblox.com/images/script/rbx-1d7de109d01134dd4466e61e5e0f0813-7f4bd5d5ee7d.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-09-16T05:07:51.401Z","updatedAt":"2025-09-16T05:07:51.401Z","lastBump":"2025-09-16T05:07:51.401Z","script":"-- Services\nlocal Players = game:GetService(\"Players\")\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal workspace = game:GetService(\"Workspace\")\nlocal LocalPlayer = Players.LocalPlayer\n\n-- Find dash table in memory\nlocal Dash\nfor i,v in pairs(getgc(true)) do\n    if type(v) == \"table\" and rawget(v, \"CharacterDashAsync\") then\n        Dash = v\n        break\n    end\nend\n\nif not Dash then\n    warn(\"Dash table not found!\")\n    return\nend\n\n-- Track character\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\n-- Function to get dash direction based on camera\nlocal function getDashDirection()\n    local cam = workspace.CurrentCamera\n    local moveDir = Humanoid.MoveDirection\n    local frontDot = math.round(moveDir:Dot(cam.CFrame.LookVector))\n    local rightDot = math.round(moveDir:Dot(cam.CFrame.RightVector))\n\n    if frontDot == 0 then\n        return rightDot > 0 and \"Right\" or (rightDot < 0 and \"Left\" or \"Front\")\n    else\n        return frontDot > 0 and \"Front\" or \"Back\"\n    end\nend\n\n-- Dash with no cooldown\nlocal function DashNoCooldown()\n    if Character.Parent and Humanoid.Health > 0 then\n        Dash.CharacterDashAsync(Character, getDashDirection())\n    end\nend\n\n-- Bind Q key\nContextActionService:BindAction(\"Dash\", function(_, inputState)\n    if inputState == Enum.UserInputState.Begin then\n        DashNoCooldown()\n    end\nend, true, Enum.KeyCode.Q)\n\n-- Update character on respawn\nLocalPlayer.CharacterAdded:Connect(function(char)\n    Character = char\n    Humanoid = Character:WaitForChild(\"Humanoid\")\nend)","features":"Free For Anyone To Edit Made With Advanced Ai Exploit Tool","tags":[],"discord":"","keyLink":"","owner":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"profilePicture":{"url":"https://media.kocakz.me/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"},"lvl":12,"status":"offline","id":"687eba7419599ad33f38a3db","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:54:39.452Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c8f0a73b6983605f0d26dd","editBy":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","status":"offline","id":"687eba7419599ad33f38a3db"},"message":"Create script","createdAt":"2025-09-16T05:07:51.406Z"}],"comments":[]},{"_id":"674b7388bfa0b425c0ba634e","title":"Auto Farm and more","game":{"_id":"67e5e1ffb360710ec3c78079","gameId":17083240635,"name":"Slayer Online [⚔️INFINITY CASTLE!]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"17083240635-slayer-online","path":"/game/17083240635-slayer-online","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":17083240635},"slug":"Slayer-Online-UPDATE-2-Auto-Farm-and-more-23458","verified":false,"key":false,"keyless":false,"views":12740,"executes":28,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnliste