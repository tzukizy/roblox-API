"/images/user-default.webp","createdAt":"2024-06-04T05:48:06.943Z","lastActive":"2026-07-13T10:02:02.562Z","status":"offline","id":"665eaa9629396e9e282854f9","topMilestone":{"key":"creator.first_script","tier":1}},"text":"yea im not waiting 60 mins js send the script","createdAt":"2025-01-25T06:04:59.664Z","edited":true,"likeCount":1,"liked":false,"disliked":false}]},{"slug":"Giant-Simulator-CLASSIC-Auto-farm-15450","_id":"668d56297c4285de089df074","title":"Auto farm","game":{"_id":"67e5e1ffb360710ec3c788f5","gameId":12645083079,"name":"Giant Simulator: REBORN","imageUrl":"/images/sb/rbx-3bf2e99af64cebfc2bc7b4496a13e00c-21ab0a002084.png","placeId":12645083079},"features":"> Toggled auto farm","tags":["Autofarm","Free","Open source"],"script":"_G.autofarm = true -- toggle\n_G.tpspeed = 0.7 -- everything under 0.7 is detected by anti-cheat\n\nlocal ts = game:GetService(\"TweenService\")\nlocal player = game.Players.LocalPlayer\n\nif _G.autofarm then\n    game.StarterGui:SetCore(\"SendNotification\", {\n        Title = \"Autofarm\",\n        Text = \"Autofarm has been enabled\",\n        Duration = 0.5\n    })\nelse\n    game.StarterGui:SetCore(\"SendNotification\", {\n        Title = \"Autofarm\",\n        Text = \"Autofarm has been disabled\",\n        Duration = 0.5\n    })\nend\n\nwhile _G.autofarm do\n    for _, v in pairs(workspace.Scene.ResourceNodes1:GetChildren()) do\n        if not _G.autofarm then break end\n        if v:IsA(\"Part\") and v:FindFirstChild(\"Prefab\") then\n            local tween = ts:Create(\n                player.Character.HumanoidRootPart,\n                TweenInfo.new(_G.tpspeed),\n                {CFrame = v.CFrame}\n            )\n            tween:Play()\n            tween.Completed:Connect(function()\n               if v.NodeType.Value == 1 then \n                game.StarterGui:SetCore(\"SendNotification\", {\n                    Title = \"Autofarm\",\n                    Text = \"Exp orb collected\",\n                    Duration = 0.1\n                })\n                elseif v.NodeType.Value == 2 then\n                game.StarterGui:SetCore(\"SendNotification\", {\n                    Title = \"Autofarm\",\n                    Text = \"Coin orb collected\",\n                    Duration = 0.1\n                })\n                else\n                    game.StarterGui:SetCore(\"SendNotification\", {\n                    Title = \"Autofarm\",\n                    Text = \"Speed Orb collected\",\n                    Duration = 0.1\n                })\n               end\n            end)\n            tween.Completed:Wait()\n        end\n    end\n    wait(0.1)\nend\n","owner":{"_id":"66312bf197010bfcb230d6e2","username":"shenzeuliyle","verified":false,"profilePicture":"/images/photo/66312bf197010bfcb230d6e2-1719227128762.jpg","status":"offline","id":"66312bf197010bfcb230d6e2","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":21075,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-07-09T15:24:25.724Z","dislikeCount":0,"likeCount":3,"image":"/images/sb/12645083079-1720538665689.png","executes":67,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c5151f","editBy":{"_id":"66312bf197010bfcb230d6e2","username":"shenzeuliyle","status":"offline","id":"66312bf197010bfcb230d6e2"},"message":"Create script","createdAt":"2025-03-27T20:37:26.313Z"}],"comments":[{"_id":"668d5b0eba25a9637b2d372c","commentBy":{"_id":"66846bd3f558bc1ce655bc54","username":"killerkanhai861","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-07-02T21:06:27.824Z","lastActive":"2024-12-14T17:12:08.269Z","status":"offline","id":"66846bd3f558bc1ce655bc54"},"text":"Could you create another script for the game cuz autofarm kinda boring ngl","createdAt":"2024-07-09T15:45:18.588Z","edited":true,"likeCount":1,"liked":false,"dislike