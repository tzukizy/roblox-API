Y do\n        for x = 0, maxX do\n            self:CreateStroke(x, y, part, surface)\n        end\n    end\nend","owner":{"_id":"62c97e03f1c6420928a7472d","username":"68856432","verified":false,"profilePicture":"/images/photo/62c97e03f1c6420928a7472d-1783714142308.jpg","status":"offline","id":"62c97e03f1c6420928a7472d","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1583,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-36c46930a0f31fd11e4eb1d15ec28ab6-38a9dfacc10f.png","likeCount":2,"dislikeCount":3,"createdAt":"2026-02-20T08:30:29.606Z","executes":80,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69981ba590304674334c12e2","editBy":{"_id":"62c97e03f1c6420928a7472d","username":"68856432","status":"offline","id":"62c97e03f1c6420928a7472d"},"message":"Create script","createdAt":"2026-02-20T08:30:29.609Z"}],"comments":[{"_id":"69982f0635b3ff3fb245a17e","commentBy":{"_id":"69746d297b4426d379dd2ca2","username":"Nyiru","verified":false,"role":"user","profilePicture":"/images/photo/69746d297b4426d379dd2ca2-1776233582366.jpg","lastActive":"2026-06-06T17:33:40.907Z","createdAt":"2026-01-24T06:56:41.682Z","status":"offline","id":"69746d297b4426d379dd2ca2"},"text":"not working","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-20T09:53:10.378Z","liked":false,"disliked":false},{"_id":"69983016ebbf6df38e284cf6","commentBy":{"_id":"680e3c5872b175908435aea7","username":"blep","verified":false,"role":"user","profilePicture":"/images/photo/680e3c5872b175908435aea7-1758971255439.png","createdAt":"2025-04-27T14:16:56.307Z","lastActive":"2026-10-09T14:13:45.448Z","status":"offline","id":"680e3c5872b175908435aea7","topMilestone":{"key":"creator.scripts","tier":5}},"text":"yo how'd you script this with your brain","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-20T09:57:42.632Z","liked":false,"disliked":false},{"_id"