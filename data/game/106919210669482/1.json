,"lastActive":"2026-04-08T13:44:26.740Z","status":"offline","id":"68b2ee553264977725657335","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"@MrpickIe Exactly, going for mythicals is the best option.","parent":{"_id":"68bd375e923a88ee9e9283ca","commentBy":{"_id":"67bd2af297d44a562292ca90","username":"MrpickIe","profilePicture":"/images/photo/67bd2af297d44a562292ca90-1740450595539.jpg","status":"offline","id":"67bd2af297d44a562292ca90"},"text":"Very op script but make sure to not get directly to the very very op chests cuz the game seems to have sum kinda a restriction that makes U not able to open those chests"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-07T17:13:29.131Z","liked":false,"disliked":false},{"_id":"68c0f31f1f39445cbf822dbf","commentBy":{"_id":"68c0f2a3d26f8956928ef72c","username":"ikhwan03","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-09-10T03:38:11.104Z","lastActive":"2025-09-10T03:44:49.380Z","status":"offline","id":"68c0f2a3d26f8956928ef72c","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"i reached final stage but having bug it shows im using clapper with 5k energy...pls fix this bug","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-10T03:40:15.072Z","liked":false,"disliked":false}]},{"_id":"68b3c9f862e4ad607b764a40","title":"Auto Collect Mythicalbox","game":{"_id":"68b3c9f762e4ad607b764a3d","gameId":106919210669482,"name":"[UPD 👒] Chop Crop 🌾","imageUrl":{"url":"https://media.kocakz.me/32ff32aebe68546387cd6ee00ec7dfdd8cc66bdb7efad15d417ec5c4b67169d0.webp","original":"https://scriptblox.com/images/sb/rbx-b243f463cbf7b6ba3f3d4f3279bffb47-54939d8f84ac.png"},"slug":"106919210669482-chop-crop","path":"/game/106919210669482-chop-crop","thumbnail":{"url":"https://media.kocakz.me/32ff32aebe68546387cd6ee00ec7dfdd8cc66bdb7efad15d417ec5c4b67169d0.webp","original":"https://scriptblox.com/images/sb/rbx-b243f463cbf7b6ba3f3d4f3279bffb47-54939d8f84ac.png"},"placeId":106919210669482},"slug":"NEW-Chop-Crop-Auto-Collect-Mythicalbox-50888","verified":false,"key":false,"keyless":false,"views":4636,"executes":9,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/07ee139bfc81ee8a07c4ac04df873f925a9cdb71e4a98b74444555fc89c00ca3.webp","original":"https://scriptblox.com/images/sb/106919210669482-1756613112002.webp","scriptblox":"https://scriptblox.com/images/script/106919210669482-1756613112002.webp"},"thumbnail":{"url":"https://media.kocakz.me/07ee139bfc81ee8a07c4ac04df873f925a9cdb71e4a98b74444555fc89c00ca3.webp","original":"https://scriptblox.com/images/sb/106919210669482-1756613112002.webp","scriptblox":"https://scriptblox.com/images/script/106919210669482-1756613112002.webp"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-31T04:05:12.032Z","updatedAt":"2025-08-31T04:05:12.032Z","lastBump":"2025-08-31T04:05:12.032Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal BOX_FOLDER = workspace:WaitForChild(\"BoxFolder\")\nlocal BOX_NAME = \"MythicalBox\"\n\nlocal SAFE_HEIGHT = 5      -- safe above floor to avoid clipping\nlocal TELEPORT_STEP = 2    -- distance in front of box to prevent camera black\n\n-- Get character and HumanoidRootPart\nlocal function getCharacterData()\n    local char = player.Character or player.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n    return char, hrp\nend\n\n-- Find BasePart in Model or BasePart itself\nlocal function findBasePart(obj)\n    if obj:IsA(\"BasePart\") then return obj end\n    if obj:IsA(\"Model\") then\n        return obj.PrimaryPart or obj:FindFirstChildWhichIsA(\"BasePart\")\n    end\n    return nil\nend\n\n-- Fire all ProximityPrompts in a box\nlocal function activatePrompts(obj)\n    for _, p in ipairs(obj:GetDescendants()) do\n        if p:IsA(\"ProximityPrompt\") then\n            fireproximityprompt(p)\n        end\n    end\nend\n\n-- Get safe teleport position slightly in front of the box\nlocal function getSafePosition(part)\n    local frontDir = part.CFrame.LookVector\n    local origin = part.Position + Vector3.new(0, part.Size.Y/2 + SAFE_HEIGHT, 0)\n    local safePos = origin - frontDir * TELEPORT_STEP\n\n    local ray = Ray.new(safePos, Vector3.new(0, -20, 0))\n    local hit, hitPos = workspace:FindPartOnRay(ray)\n    if hit then\n        return Vector3.new(safePos.X, hitPos.Y + SAFE_HEIGHT, safePos.Z)\n    else\n        return safePos\n    end\nend\n\n-- Blink character over each box in a batch\nlocal function collectAllBoxes()\n    local char, hrp = getCharacterData()\n    if not hrp then return end\n\n    local boxes = {}\n    for _, obj in ipairs(BOX_FOLDER:GetDescendants()) do\n        if obj.Name == BOX_NAME and obj.Parent then\n            table.insert(boxes, obj)\n        end\n    end\n\n    -- Sort by distance\n    table.sort(boxes, function(a,b)\n        local pa = findBasePart(a)\n        local pb = findBasePart(b)\n        if not pa or not pb then return false end\n        return (hrp.Position - pa.Position).Magnitude < (hrp.Position - pb.Position).Magnitude\n    end)\n\n    -- Teleport character to each box quickly\n    for _, box in ipairs(boxes) do\n        local part = findBasePart(box)\n        if part then\n            local safePos = getSafePosition(part)\n            hrp.CFrame = CFrame.new(safePos)\n            activatePrompts(box)\n        end\n    end\nend\n\n-- Loop constantly to collect all boxes\ntask.spawn(function()\n    while true do\n        collectAllBoxes()\n        task.wait(0.05) -- small wait to prevent freeze\n    end\nend)\n\n-- React instantly to new boxes\nBOX_FOLDER.DescendantAdded:Connect(function(obj)\n    if obj.Name == BOX_NAME then\n        task.wait(0.01)\n        local char, hrp = getCharacterData()\n        if hrp then\n            local part = findBasePart(obj)\n            if part then\n                hrp.CFrame = CFrame.new(getSafePosition(part))\n                activatePrompts(obj)\n            end\n        end\n    end\nend)\n\n-- Handle respawn\nplayer.CharacterAdded:Connect(function(char)\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\nend)\n","features":"yes its made by chatgpt but it work so","tags":[],"discord":"","keyLink":"","owner":{"_id":"6787eb0c001adb2104a35b56","username":"kwaesway32","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6787eb0c001adb2104a35b56","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:44:40.022Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b3c9f862e4ad607b764a42","editBy":{"_id":"6787eb0c001adb2104a35b56","username":"kwaesway32","status":"offline","id":"6787eb0c001adb2104a35b56"},"message":"Create script","createdAt":"2025-08-31T04:05:12.035Z"}],"comments":[{"_id":"68bdbbc751305721f8502e08","commentBy":{"_id":"68b7b4d9d1b253eb41a63332","username":"ramskins088","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-09-03T03:24:09.414Z","lastActive":"2025-12-05T18:00:06.797Z","status":"offline","id":"68b7b4d9d1b253eb41a63332","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Bro this is nice script! Maybe you can also try prison pump thanks!","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-07T17:07:19.658Z","liked":false,"disliked":false}]}]}