 Points","game":{"_id":"67e5e1ffb360710ec3c78758","gameId":13468284385,"name":"Color Chairs","imageUrl":"/images/sb/rbx-6e535e7e7734ac30194ab2beab9110e2-cb118517d161.png","placeId":13468284385},"features":"The scripts gives you an unlimited amount of points, very op! 🤑🤯","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/ExploiterGuy/Aqua-Hub/refs/heads/main/Color%20Chairs%20%5BINVITE%5D.txt\"))()","owner":{"_id":"66dda033e0049fc7fd101b79","username":"ExploitFin","verified":false,"profilePicture":"/images/photo/66dda033e0049fc7fd101b79-1740237801447.jpg","status":"offline","id":"66dda033e0049fc7fd101b79","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"keyLink":"https://discord.gg/2DURT7qY","views":14631,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-11-17T15:49:06.161Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/180DAY-1d6b7fcb948f5b724bfa4dd90e49f232/500/280/Image/Jpeg/noFilter","executes":20,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d102","editBy":{"_id":"66dda033e0049fc7fd101b79","username":"ExploitFin","status":"offline","id":"66dda033e0049fc7fd101b79"},"message":"Create script","createdAt":"2024-11-20T11:02:05.380Z"},{"_id":"67e5e1e6b360710ec3c530af","editBy":{"_id":"66dda033e0049fc7fd101b79","username":"ExploitFin","status":"offline","id":"66dda033e0049fc7fd101b79"},"message":"Update script","createdAt":"2025-03-27T15:57:22.080Z"}],"comments":[]},{"slug":"Color-Chairs-Overpowered-20394","_id":"670f6f70f1a77b537de24264","title":"Overpowered","game":{"_id":"67e5e1ffb360710ec3c78758","gameId":13468284385,"name":"Color Chairs","imageUrl":"/images/sb/rbx-6e535e7e7734ac30194ab2beab9110e2-cb118517d161.png","placeId":13468284385},"features":"Coins input, Obtain all Trails, and Auto sit.","tags":[],"script":"-- Made by KevinMitnickHKR (Credit when using)\n\nlocal DrRayLibrary = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/AZYsGithub/DrRay-UI-Library/main/DrRay.lua\"))()\nlocal window = DrRayLibrary:Load(\"Color Chairs - Free - 🪑\", \"Default\")\n\nlocal tab = DrRayLibrary.newTab(\"Main\", \"ImageIdHere\")\n\nlocal coins = 69\nlocal autosit = false\n\ntab.newInput(\"Coins\", \"Set The Amount Of Desired Value\", function(inputCoins)\n    coins = tonumber(inputCoins)\n    game:GetService(\"ReplicatedStorage\").EggHatchingRemotes.HatchServer:InvokeServer(\"Mythic Egg\", -coins)\nend)\n\ntab.newToggle(\"Auto Sit\", \"Toggle\", false, function(autositToggle)\n    autosit = autositToggle\n    while autosit do\n        wait(0.1)\n\n        for _, chair in ipairs(workspace:WaitForChild(\"Chairs\"):GetChildren()) do\n            if chair:IsA(\"Model\") and chair:FindFirstChild(\"Seat\") and chair.Seat.Occupant == nil then\n                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = chair:GetPrimaryPartCFrame() * CFrame.new(0, 3, 0)\n                wait(2)\n                break\n            end\n        end\n    end\nend)\n\ntab.newButton(\"Obtain Trails\", \"Obtain All Trails\", function()\n    game:GetService(\"ReplicatedStorage\").GiveAllTrails:FireServer()\nend)","owner":{"_id":"66606c90fdf16ad325df6a55","username":"kevinmitnickhkr","verified":false,"profilePicture":"/images/photo/66606c90fdf16ad325df6a55-1725335963650.jpg","status":"offline","id":"66606c90fdf16ad325df6a55","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"keyLink":"","views":13007,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-10-16T07:46:56.025Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/13468284385-1729064815972.png","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52883","editBy":{"_id":"66606c90fdf16ad325df6a55","username":"kevinmitnickhkr","status":"offline","id":"66606