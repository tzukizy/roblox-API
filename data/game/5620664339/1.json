l / Eat food\n\nL Key: Toggle super run\n- Key: Lower super run speed\n+ Key: Increase super run speed\n\n\n!! PRESS ' TO TYPE IN COMMAND BAR !!","tags":[],"discord":"","keyLink":"","owner":{"_id":"62ae4b019b0bb90fc26d9c45","username":"ImAnSkid","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"62ae4b019b0bb90fc26d9c45","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T03:26:38.730Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e93d","editBy":{"_id":"62ae4b019b0bb90fc26d9c45","username":"ImAnSkid","status":"offline","id":"62ae4b019b0bb90fc26d9c45"},"message":"Create script","createdAt":"2025-03-27T22:19:38.258Z"}],"comments":[{"_id":"6301e8d8774d59be4f58f92f","commentBy":{"_id":"62fe393bebde93fd5e24fd57","username":"ThrillSeeker","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-08-18T13:06:03.631Z","lastActive":"2022-08-29T17:32:12.475Z","status":"offline","id":"62fe393bebde93fd5e24fd57","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"vouch","createdAt":"2022-08-21T08:12:08.455Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"6302cca36aee4e6eff120d2a","commentBy":{"_id":"6301704857f13cf6bb343d29","username":"cdnAshton","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2022-08-20T23:37:44.778Z","lastActive":"2022-09-22T00:58:29.378Z","status":"offline","id":"6301704857f13cf6bb343d29","profile":{"url":"https://media.kocakz.me/no-profile.webp","original