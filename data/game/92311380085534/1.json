{"id":92311380085534,"name":"HERO TOWER","desc":"In this \"Troll Tower\" Like game you will be able to TRANSFORM into a total of 13 HERO CHARACTERS with DIFFERENT ABILITIES! (more to come on next updates!)\n\n- Use the Hero Characters to troll other players🥱😂\n- Complete the tower to unlock new Hero Characters!\n- Troll even more people!","path":"/game/92311380085534-hero-tower","slug":"92311380085534-hero-tower","thumbnail":{"url":"https://cdn.kocakz.me/images/1847b17d15d0d28c89cb0aee763ee548be9a584eb8f9dfc6616ea5131d64fe96.webp","original":"https://tr.rbxcdn.com/180DAY-57f6353a25561073068bf7bab8963fd8/150/150/Image/Png/noFilter"},"playing":108,"visitor":49188981,"verified":false,"updatedAt":"2025-10-21T23:16:26.979Z","creator":{"name":"Hero Brawl","type":"Group"},"script":{"count":3,"freeCount":3,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"HERO-TOWER-AUTO-WIN-TOWERS-SLAP-59933","_id":"68f8144a989922ec53bbcfa8","title":"AUTO WIN TOWERS SLAP","game":{"_id":"6862c3cde1763d2301f56bc6","gameId":92311380085534,"name":"HERO TOWER","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":92311380085534},"features":"KD Teleport & Auto Collect GUI\nThis script provides a fully movable and interactive menu, with the ability to hide or show the GUI, creating a clean and ergonomic interface.\n\nMain Features:\n\t•\tInstant teleportation to coordinates X: -191.3, Y: 600.6, Z: 46.6 with a simple click.\n\t•\tMovable and hideable GUI to fit your gameplay style.\n\t•\tAuto-collect part: when a player touches the designated part, they automatically receive +1 point or credit.\n\t•\tProfessional and clean design, perfect for Delta Executor iOS and all Roblox games.\n\t•\tStable and secure: tested to work without bugs on player characters.","tags":[],"script":"-- KD Teleport GUI\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal PlayerGui = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n-- Création du ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"KDTPGui\"\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = PlayerGui\n\n-- Frame principal (déplaçable)\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 200, 0, 50)\nframe.Position = UDim2.new(0, 50, 0, 100)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 40)\nframe.BorderSizePixel = 0\nframe.Parent = screenGui\nframe.Active = true\nframe.Draggable = true\n\n-- Titre\nlocal title = Instance.new(\"TextLabel\")\ntitle.Size = UDim2.new(1, -10, 0, 20)\ntitle.Position = UDim2.new(0, 5, 0, 5)\ntitle.BackgroundTransparency = 1\ntitle.Text = \"KD TP GUI\"\ntitle.TextColor3 = Color3.fromRGB(255, 255, 255)\ntitle.Font = Enum.Font.SourceSansBold\ntitle.TextScaled = true\ntitle.Parent = frame\n\n-- Bouton pour TP\nlocal tpButton = Instance.new(\"TextButton\")\ntpButton.Size = UDim2.new(0, 180, 0, 25)\ntpButton.Position = UDim2.new(0, 10, 0, 25)\ntpButton.Text = \"TP aux coordonnées TP\"\ntpButton.BackgroundColor3 = Color3.fromRGB(70, 130, 180)\ntpButton.TextColor3 = Color3.fromRGB(255, 255, 255)\ntpButton.Font = Enum.Font.SourceSansBold\ntpButton.TextSize = 16\ntpButton.Parent = frame\n\n-- Fonction de TP\ntpButton.MouseButton1Click:Connect(function()\n\tlocal char = LocalPlayer.Character\n\tif char and char:FindFirstChild(\"HumanoidRootPart\") then\n\t\tchar.HumanoidRootPart.CFrame = CFrame.new(-191.3, 600.6, 46.6)\n\tend\nend)\n\n-- Bouton Masquer / Afficher le GUI\nlocal toggleButton = Instance.new(\"TextButton\")\ntoggleButton.Size = UDim2.new(0, 25, 0, 25)\ntoggleButton.Position = UDim2.new(1, -30, 0, 5)\ntoggleButton.Text = \"-\"\ntoggleButton.BackgroundColor3 = Color3.fromRGB(180, 70, 70)\ntoggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\ntoggleButton.Font = Enum.Font.SourceSansBold\ntoggleButton.TextSize = 18\ntoggleButton.Parent = frame\n\ntoggleButton.MouseButton1Click:Connect(function()\n\tframe.Visible = not frame.Visible\nend)","owner":{"_id":"687a4395f9c81d63df0f01b6","username":"diasteo111","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b07fb396d30ab25c55ecb120cbc8f78fed7585b7610aba8e0ff92afa9c7b3f6e.webp","original":"https://scriptblox.com/images/photo/687a4395f9c81d63df0f01b6-1752843346030.png"},"status":"offline","id":"687a4395f9c81d63df0f01b6","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/b07fb396d30ab25c55ecb120cbc8f78fed7585b7610aba8e0ff92afa9c7b3f6e.webp","original":"https://scriptblox.com/images/photo/687a4395f9c81d63df0f01b6-1752843346030.png"}},"verified":false,"views":3240,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8601b17a1cac38c0eb42f745ff19c1dcda3e486b17a60d551d460c5809aa4fc9.webp","original":"https://scriptblox.com/images/sb/92311380085534-1761088586967.jpg","scriptblox":"https://scriptblox.com/images/script/92311380085534-1761088586967.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-21T23:16:26.981Z","executes":319,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:47:43.664Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/8601b17a1cac38c0eb42f745ff19c1dcda3e486b17a60d551d460c5809aa4fc9.webp","original":"https://scriptblox.com/images/sb/92311380085534-1761088586967.jpg","scriptblox":"https://scriptblox.com/images/script/92311380085534-1761088586967.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68f8144a989922ec53bbcfaa","editBy":{"_id":"687a4395f9c81d63df0f01b6","username":"diasteo111","status":"offline","id":"687a4395f9c81d63df0f01b6"},"message":"Create script","createdAt":"2025-10-21T23:16:26.991Z"}],"comments":[]},{"slug":"HERO-TOWER-AUTO-WIN-KEYLESS-44816","_id":"