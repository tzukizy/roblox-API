"views":1432,"executes":104,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-d2e2ca73291f8bbc83dc29dfacac7fc3-ec36ad6abd77.png","scriptblox":"https://scriptblox.com/images/script/rbx-d2e2ca73291f8bbc83dc29dfacac7fc3-ec36ad6abd77.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-d2e2ca73291f8bbc83dc29dfacac7fc3-ec36ad6abd77.png","scriptblox":"https://scriptblox.com/images/script/rbx-d2e2ca73291f8bbc83dc29dfacac7fc3-ec36ad6abd77.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-27T11:35:01.484Z","updatedAt":"2025-12-27T11:35:01.484Z","lastBump":"2025-12-27T11:35:01.484Z","script":"local manipEnabled = true -- change the true to a false if you want normal silent aim\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlocal Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Camera = workspace.CurrentCamera\nlocal lp = Players.LocalPlayer\n\nlocal function lookvector(from, to)\n    return (to - from).Unit\nend\n\nlocal function target()\n    local screenSize = Camera.ViewportSize\n    local screenCenter = Vector2.new(screenSize.X / 2, screenSize.Y / 2)\n\n    local closestPlayer = nil\n    local closestDistance = math.huge\n\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= lp then\n            local character = player.Character\n            if character then\n                local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n                local rootPart = character:FindFirstChild(\"Head\")\n\n                if humanoid and rootPart and humanoid.Health > 0 then\n                    local pos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)\n                    if onScreen then\n                        local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude\n                        if distance < closestDistance then\n                            closestDistance = distance\n                            closestHead = rootPart\n                        end\n                    end\n                end\n            end\n        end\n    end\n\n    return closestHead.Position\nend\n\nlocal gc = getgc(true)\n\nfor _,v in pairs(gc) do\n    if typeof(v) ~= 'function' then continue end\n    \n    if debug.getinfo(v).name == 'isLimbGibbed' then\n        print(\"disabling gib negatives\")\n        local old; old = hookfunction(v, function()\n            return false\n        end)\n    end\nend\n\nlocal i = 0\n\nfor _,v in pairs(gc) do\n    if typeof(v) ~= \"table\" then continue end\n    \n    if rawget(v, \"applyRecoil\") then -- new one each time u respawn, need to reapply on respawn\n        local old; old = hookfunction(v.applyRecoil, function()\n            return -- remove camera recoil\n        end)\n        continue\n    end\n    \n    if rawget(v, \"fire\") and typeof(v.fire) == 'function' then\n        local info = debug.getinfo(v.fire)\n        if info.source:find(\"projectiles\") ~= nil then\n            local old; old = hookfunction(v.fire, function(...)\n                local args = {...}\n                \n                if args[2] == true then -- other player shot\n                    return old(...)\n                end\n                \n                local target = target()\n                local newpos = lp.Character.Head.Position\n                \n                -- the below works lol\n                if not manipEnabled then\n                    args[1][\"origin\"] = game.Players.LocalPlayer.Character.Head.Position --+ Vector3.new(0,20,0)\n                else\n                    newpos = target + Vector3.new(0, 1, 0)\n                    args[1][\"origin\"] = newpos\n                end\n                \n                for i,dir in pairs(args[1][\"directions\"]) do\n                    args[1][\"directions\"][i] = lookvector(newpos, target)\n                end\n                \n                return old(unpack(args))\n            end)\n        end\n    end\nend","features":"IMPORTANT: change the manipEnabled variable at the top to false for normal silent aim\n\nmade this in like 20 minutes because i was bored, likely wont be maintained\nworks on any gun, as well as grenade launchers, not grenades though\nshoot people through walls, or just normal silent aim. shotguns are laser beams.\n\nthere IS a no camera recoil, im just too lazy to reapply it after each respawn so it only works after the first execute :)","tags":[],"discord":"","keyLink":"","owner":{"_id":"66815d386934aca1cd18c781","username":"vaultt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/179e091eff63b1e630a3e3ed3ed7cc666e998c67ce311b1a46ff70278fa7dbd7.webp","original":"https://scriptblox.com/images/photo/66815d386934aca1cd18c781-1720710422505.jpg"},"status":"offline","id":"66815d386934aca1cd18c781","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/179e091eff63b1e630a3e3ed3ed7cc666e998c67ce311b1a46ff70278fa7dbd7.webp","original":"https://scriptblox.com/images/photo/66815d386934aca1cd18c781-1720710422505.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:45:25.923Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"694fc46539aa8f1614044efa","editBy":{"_id":"66815d386934aca1cd18c781","username":"vaultt","status":"offline","id":"66815d386934aca1cd18c781"},"message":"Create script","createdAt":"2025-12-27T11:35:01.487Z"}],"comments":[{"_id":"694fd10c4c1dd77782481510","commentBy":{"_id":"69356282f002b181ca9167ba","username":"KILOman","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/d17091bd857318db35c63a2e7e90