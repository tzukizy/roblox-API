n({\n    Name = \"Destory Script\",\n    Callback = function()\n       Rayfield:Destroy()\n    end,\n })\n\n local Slider = MainTab:CreateSlider({\n    Name = \"WalkSpeed\",\n    Range = {0, 300},\n    Increment = 1,\n    Suffix = \"Speed\",\n    CurrentValue = 16,\n    Flag = \"Slider1\", -- A flag is the identifier for the configuration file, make sure every element has a different flag if you're using configuration saving to ensure no overlaps\n    Callback = function(Value)\n   game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = (Value)\n    end,\n })\n\n\n--Dm if having trouble: toocoldmarcus :discord user.\n","owner":{"_id":"65072a5f500f1710b6f53be6","username":"sxth","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9ab6c3838aa704eff7c14e1f4fbca85b6319b06b3f5cbf63c079be74053572d3.webp","original":"https://scriptblox.com/images/photo/65072a5f500f1710b6f53be6-1694973887904.jpg"},"status":"offline","id":"65072a5f500f1710b6f53be6","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/9ab6c3838aa704eff7c14e1f4fbca85b6319b06b3f5cbf63c079be74053572d3.webp","original":"https://scriptblox.com/images/photo/65072a5f500f1710b6f53be6-1694973887904.jpg"}},"verified":false,"keyLink":"","views":16134,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-09-17T16:39:28.150Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://media.kocakz.me/ba4c4e1cb4e30f37694c24cd677171678dc2b91d7f69264b6486130c39377ced.webp","original":"https://scriptblox.com/images/sb/11166344460-1694968768072.webp","scriptblox":"https://scriptblox.com/images/script/11166344460-1694968768072.webp"},"executes":54,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:17:28.641Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/ba4c4e1cb