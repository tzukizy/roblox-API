{"id":120135584963579,"name":"Don’t Steal the Bobo 🐻","desc":"Welcome to Don’t Steal the Bobo! 🐻\n\nHow to Play:\n• Sneak up and steal Bobos while they sleep😴\n• RUN when they wake up and chase you!🏃\n• Take them home and collect tons of cash💸\n• Upgrade your characters to earn even more🔥\n• Expand your plot to unlock extra slots🏗️\n• Trade & gift Bobos with friends to grow together!🎁\n• Complete your Index to unlock cash boosts & base colors!📖\n• But be careful... a sleeping Bobo can WAKE at any second!🤫\n\nRemember, your Bobos earn cash even while you're offline!⏰","path":"/game/120135584963579-don-t-steal-the-bobo","slug":"120135584963579-don-t-steal-the-bobo","thumbnail":{"url":"https://cdn.kocakz.me/images/872fa5c45212f1972c562f778c231fd3573938f92b160cff7ec6614139134d78.webp","original":"https://tr.rbxcdn.com/180DAY-50b81eff9c70eb076bc5fca296a4a0c1/150/150/Image/Png/noFilter"},"playing":2626,"visitor":469274377,"verified":false,"updatedAt":"2026-02-26T03:17:09.080Z","creator":{"name":"lol games..","type":"Group"},"script":{"count":9,"freeCount":9,"keyCount":6,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Don't-Steal-the-Bobo-amythist-hub-122257","_id":"699fbb354425537fed5f8d42","title":"amythist hub","game":{"_id":"68eb44ba371c64acc41f440a","gameId":120135584963579,"name":"Don’t Steal the Bobo 🐻","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":120135584963579},"features":"best autofarm by far also auto upgrade and claim and anti afk","tags":[],"script":"loadstring(game:HttpGet(\"https://pastes.io/raw/amethyst-h\",true))()","owner":{"_id":"6924327505d2cd3e1446256d","username":"wrizzguy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"6924327505d2cd3e1446256d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://