ps://scriptblox.com/images/script/rbx-551f7fc7cae656c60fe5f8ec4b479827-3d4a4879df68.png"},"thumbnail":{"url":"https://media.kocakz.me/3a65069b37a6ed5dccdd0dec67a7ff54e5139c6bf26b740a9ba4ab51fe2db9a6.webp","original":"https://scriptblox.com/images/sb/rbx-551f7fc7cae656c60fe5f8ec4b479827-3d4a4879df68.png","scriptblox":"https://scriptblox.com/images/script/rbx-551f7fc7cae656c60fe5f8ec4b479827-3d4a4879df68.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-08T16:35:05.365Z","updatedAt":"2026-01-08T16:35:05.365Z","lastBump":"2026-01-08T16:35:05.365Z","script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/Finilando/script/refs/heads/main/Guess%20the%20Meme%20or%20Die\"))()","features":"Auto picker","tags":[],"discord":"","keyLink":"","owner":{"_id":"6953b2797b2ab0c392cd01e8","username":"Elijah0822","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6953b2797b2ab0c392cd01e8","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:47:53.117Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"695fdcb9427c207c883e8c5a","editBy":{"_id":"6953b2797b2ab0c392cd01e8","username":"Elijah0822","status":"offline","id":"6953b2797b2ab0c392cd01e8"},"message":"Create script","createdAt":"2026-01-08T16:35:05.370Z"}],"comments":[]},{"_id":"68ed51585fd6a888345f93f1","title":"Auto Guesser","game":{"_id":"68ed51585fd6a888345f93ee","gameId":101365980107547,"name":"[UPD] Guess the Meme or Die 🔊","imageUrl":{"url":"https://media.kocakz.me/944ac39fd94c9c6f7feb2b6e242beb58b9caae8d2044747aa8b681c6f099e411.webp","original":"https://tr.rbxcdn.com/180DAY-cfe774cfd05c668629aae551337b693c/150/150/Image/Png/noFilter"},"slug":"101365980107547-guess-the-meme-or-die","path":"/game/101365980107547-guess-the-meme-or-die","thumbnail":{"url":"https://media.kocakz.me/944ac39fd94c9c6f7feb2b6e242beb58b9caae8d2044747aa8b681c6f099e411.webp","original":"https://tr.rbxcdn.com/180DAY-cfe774cfd05c668629aae551337b693c/150/150/Image/Png/noFilter"},"placeId":101365980107547},"slug":"UPD-Guess-the-Meme-or-Die-Guess-the-Meme-or-Die-Auto-Guesser-58296","verified":false,"key":false,"keyless":false,"views":9231,"executes":444,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/27a8b2b9bff1a8defc1f259eda293be102875b3753b800cdd75762356c1a56e3.webp","original":"https://scriptblox.com/images/sb/rbx-38164fba3248b772ffb48ed9737d53e8-9cd2375dc22f.png","scriptblox":"https://scriptblox.com/images/script/rbx-38164fba3248b772ffb48ed9737d53e8-9cd2375dc22f.png"},"thumbnail":{"url":"https://media.kocakz.me/27a8b2b9bff1a8defc1f259eda293be102875b3753b800cdd75762356c1a56e3.webp","original":"https://scriptblox.com/images/sb/rbx-38164fba3248b772ffb48ed9737d53e8-9cd2375dc22f.png","scriptblox":"https://scriptblox.com/images/script/rbx-38164fba3248b772ffb48ed9737d53e8-9cd2375dc22f.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-13T19:22:00.283Z","updatedAt":"2025-10-13T19:22:00.283Z","lastBump":"2025-10-13T19:22:00.283Z","script":"local ReplicatedStorage = game:GetService('ReplicatedStorage')\nlocal VirtualInputManager = game:GetService('VirtualInputManager')\n\nlocal StartQuestionEvent = ReplicatedStorage.Events:WaitForChild('StartQuestion')\nlocal QuestionDataEvent = ReplicatedStorage.Events:WaitForChild('QuestionData')\n\nlocal allRounds = {}\nlocal currentRound = nil\n\n---->>> CONFIG <<<----\n\n--[[\n    Speed Translations: \n\n    [\"SUPER FAST ANSWER!\"] = < 1.5,\n    [\"SPEEDY ANSWER!\"] = < 3\n\n--]]\n\nlocal waitTime = 1.4\n\n---->>>>>><<<<<<----\n\n\nlocal function PressKey(keyNumber)\n    local keyMap = {\n        [1] = Enum.KeyCode.One,\n        [2] = Enum.KeyCode.Two,\n        [3] = Enum.KeyCode.Three,\n        [4] = Enum.KeyCode.Four,\n    }\n\n    local keyCode = keyMap[keyNumber]\n    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)\n    task.wait(0.05)\n    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)\nend\n\n-->> Capture QuestionData info for all rounds\n\n--[[\n    For some reason when a round starts, they send you:\n\n    - Current Round #\n    - Round Type (Vote, Song)\n    - Options in the form of IDs (37, 48, 63, 92)\n    - SongNum in the form of an ID. [Ex. 48]\n\n    + Data for future rounds (upwards of 20 rounds)\n    + SongNum is always the correct song choice\n--]]\n\nQuestionDataEvent.OnClientEvent:Connect(function(roundsTable)\n    for _, roundData in ipairs(roundsTable) do\n        allRounds[roundData.Round] = roundData\n    end\nend)\n\n-->> Listen for when a new round starts\nStartQuestionEvent.OnClientEvent:Connect(function(data)\n    if not data or not data.RoundNumber then\n        return\n    end\n\n    local roundNumber = data.RoundNumber\n    local roundInfo = allRounds[roundNumber]\n    if not roundInfo then\n        warn('⚠️ No data found for round', roundNumber)\n        return\n    end\n\n    -->> Determine the correct option and button index\n    if roundInfo.RoundType == 'Song' then\n        local correctSongNum = roundInfo.SongNum\n\n        -->> They put this in the UI's localscript for some reason\n        local correctIndex = table.find(roundInfo.Options, correctSongNum)\n\n        if correctIndex then\n            --[[\n                The correctIndex is a number (1-4) which represents your four buttons.\n                I just get that number by using table.find with the same args they used in\n                the localscript. \"LocalPlayer.PlayerGui.QuestionGUI.GameClient\"\n\n                \"if table.find(v154.Options, v154.ArtistNum or v154.SongNum) == u47 then\"\n            --]]\n\n            -->> Since there's no event or anything to submit your selection I just fake a key press.\n            task.wait(waitTime)\n            PressKey(correctIndex)\n        else\n            warn('⚠️ Could not find SongNum in options for this round.')\n        end\n    elseif roundInfo.RoundType == 'Vote' then\n        -->> Voting rounds don't have a correct answer but voting \n        -->> will always give you some extra height for some reason\n        task.wait(6)\n        PressKey(1)\n    else\n        warn('⚠️ Unknown round type:', roundInfo.RoundType)\n    end\nend)\n\nprint(\"✅ [Auto Guesser] Initialized\")\n","features":"Auto Guess\nConfigurable guess speed","tags":[],"discord":"","keyLink":"","owner":{"_id":"68dfcd5192f92a0f8af44026","username":"PhlompfTheRealOne","verified":false,"profilePicture":{"url":"https://media.kocakz.me/19a302a9321a339b42ff50f08c29aff781ad985ad35fc2571388e3a3e662bd66.webp","original":"https://scriptblox.com/images/photo/68dfcd5192f92a0f8af44026-1760383447532.png"},"status":"offline","id":"68dfcd5192f92a0f8af44026","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/19a302a9321a339b42ff50f08c29aff781ad985ad35fc2571388e3a3e662bd66.webp","original":"https://scriptblox.com/images/photo/68dfcd5192f92a0f8af44026-1760383447532.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-20T02:57:05.751Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68ed51585fd6a888345f93f3","editBy":{"_id":"68dfcd5192f92a0f8af44026","username":"PhlompfTheRealOne","status":"offline","id":"68dfcd5192f92a0f8af44026"},"message":"Create script","createdAt":"2025-10-13T19:22:00.289Z"}],"comments":[{"_id":"6911af53af4e0ba385c858ae","commentBy":{"_id":"6911906d5bc8ec28974ccab6","username":"hello12345hahalol","verified":false,"role":"user","