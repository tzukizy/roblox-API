cal targetCFrame\n        if target:IsA(\"Model\") then\n            if not target.PrimaryPart then\n                target.PrimaryPart = target:FindFirstChildWhichIsA(\"BasePart\")\n            end\n            targetCFrame = target.PrimaryPart and target.PrimaryPart.CFrame\n        elseif target:IsA(\"BasePart\") then\n            targetCFrame = target.CFrame\n        end\n\n        if targetCFrame then\n            hrp.CFrame = targetCFrame\n        end\n\n        task.wait(0.5)\n    end\nend\n\n-- Listen for respawns (CharacterAdded) and restart teleportation\nplayer.CharacterAdded:Connect(function()\n    teleportToObjective()\nend)\n\n-- Initial teleportation for when the player first joins\nteleportToObjective()\n","owner":{"_id":"663d6650d0f41df927071006","username":"Trash_scriptr","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"663d6650d0f41df927071006","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":6381,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-03c5c1bc6900d6f960ccfce02d036002-d8c8eb28ce09.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-06-22T20:08:04.445Z","executes":19,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"685862a46160c66656288c43","editBy":{"_id":"663d6650d0f41df927071006","username":"Trash_scriptr","status":"offline","id":"663d6650d0f41df927071006"},"message":"Create script","createdAt":"2025-06-22T20:08:04.449Z"}],"comments":[{"_id":"6858b31bbb2d617bd65f8998","commentBy":{"_id":"6826132d7662247f3c6ebdf4","username":"Memphis","verified":false,"role":"user","profilePicture":"/images/photo/6826132d7662247f3c6ebdf4-1752072211935.jpg","createdAt":"2025-05-15T16:15:41.278Z","lastActive":"2025-08-24T20:13:50.661Z","status":"offline","id":"6826132d7662247f3c6ebdf4","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Cool, make inf coins if possibl