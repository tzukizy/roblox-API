":{"_id":"68b0ec497fed70a08e75f7d3","username":"ALTERRATIC","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/81238b1a39f47f1b248acb5d15b62400a617fc48bb0c40b196f1d8954b8332e0.webp","original":"https://scriptblox.com/images/photo/68b0ec497fed70a08e75f7d3-1759643184572.png"},"createdAt":"2025-08-28T23:54:49.802Z","lastActive":"2026-10-04T03:57:16.946Z","status":"offline","id":"68b0ec497fed70a08e75f7d3","profile":{"url":"https://media.kocakz.me/81238b1a39f47f1b248acb5d15b62400a617fc48bb0c40b196f1d8954b8332e0.webp","original":"https://scriptblox.com/images/photo/68b0ec497fed70a08e75f7d3-1759643184572.png"}},"text":"okay so auto save doesnt work, thank you for wasting my time","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-30T05:01:04.304Z","liked":false,"disliked":false}]},{"slug":"KAISER-Azure-Latch-OPEN-SOURCE-GOAL-DISABLE-COLLISION-31177","_id":"67cbe08ad62c26b77fa36589","title":"OPEN SOURCE Disable goal collisions","game":{"_id":"67e5e1ffb360710ec3c77d27","gameId":94647229517154,"name":"[⚙️QOL😈] Azure Latch","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":94647229517154},"features":"Just DISABLE COLLISION, have fun","tags":["DISABLE COLLISION","Azure Latch"],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\n\n \nlocal function CollisionDisabler(enable)\n    pcall(function()\n        local MapFolder = workspace:WaitForChild(\"map\")\n        local GkBarriar = MapFolder:FindFirstChild(\"gkbarriar\")\n        local AGoal = MapFolder:FindFirstChild(\"Agoal\")\n        local BGoal = MapFolder:FindFirstChild(\"Bgoal\")\n\n         \n        if GkBarriar then\n            local ABarriar = GkBarriar:FindFirstChild(\"A\")\n            local BBarriar = GkBarriar:FindFirstChild(\"B\")\n            \n            if ABarriar then\n                ABarriar.CanCollide = not enable\n                ABarriar.Transparency = enable and 0.8 or 0\n            end\n            \n            if BBarriar then\n                BBarriar.CanCollide = not enable\n                BBarriar.Transparency = enable and 0.8 or 0\n            end\n        end\n\n         \n        if AGoal then\n            AGoal.CanCollide = not enable\n            AGoal.Transparency = enable and 0.5 or 0\n        end\n        \n        if BGoal then\n            BGoal.CanCollide = not enable\n            BGoal.Transparency = enable and 0.5 or 0\n        end\n    end)\nend\n\n \nlocal collisionConnection\nlocal function AutoRefreshCollision()\n    if collisionConnection then\n        collisionConnection:Disconnect()\n    end\n    \n    collisionConnection = workspace.ChildAdded:Connect(function(child)\n        if child.Name == \"map\" then\n            task.wait(1)  \n            CollisionDisabler(_G.DISABLE_COLLISION)\n        end\n    end)\nend\n\n\nlocal function CreateControlGUI()\n    local gui = Instance.new(\"ScreenGui\")\n    gui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n    local button = Instance.new(\"TextButton\")\n    button.Size = UDim2.new(0, 200, 0, 40)\n    button.Position = UDim2.new(0.5, -100, 0, 10)\n    button.Text = \"DISABLE COLLISION: OFF\"\n    button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)\n    button.TextColor3 = Color3.new(1, 1, 1)\n    \n    button.MouseButton1Click:Connect(function()\n        _G.DISABLE_COLLISION = not _G.DISABLE_COLLISION\n        button.Text = \"DISABLE COLLISION: \" .. (_G.DISABLE_COLLISION and \"ON\" or \"OFF\")\n        CollisionDisabler(_G.DISABLE_COLLISION)\n        AutoRefreshCollision()\n    end)\n    \n    button.Parent = gui\nend\n\n \nCreateControlGUI()\nAutoRefreshCollision()\nCollisionDisabler(_G.DISABLE_COLLISION or false)","owner":{"_id":"65c37a706ff06855a5162e4b","username":"broooo","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"65c37a706ff06855a5162e4b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":22187,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-03-08T06:15:38.519Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://media.kocakz.me/84894af15142e93d37be8160afe1e7b16586ff46e3843fc9a5c534e9e2b6fa08.webp","original":"https://scriptblox.com/images/sb/94647229517154-1741414538423.png","scriptblox":"https://scriptblox.com/images/script/94647229517154-1741414538423.png"},"executes":45,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:16:14.237Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/84894af15142e93d37be8160afe1e7b16586ff46e3843fc9a5c534e9e2b6fa08.webp","original":"https://scriptblox.com/images/sb/94647229517154-1741414538423.png","scriptblox":"https://scriptblox.com/images/script/94647229517154-1741414538423.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c55682","editBy":{"_id":"65c37a706ff06855a5162e4b","username":"broooo","status":"offline","id":"65c37a706ff06855a5162e4b"},"message":"Create script","createdAt":"2025-03-27T23:11:06.747Z"}],"comments":[{"_id":"67cc4409684d361b60677949","commentBy":{"_id":"674a4c438ed7d3ef9eed35e3","username":"hanniganadam6","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-11-29T23:20:35.587Z","lastActive":"2026-04-02T16:00:51.958Z","status":"offline","id":"674a4c438ed7d3ef9eed35e3","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"What does this do?","createdAt":"2025-03-08T13:20:09.762Z","ed