{"id":11919433298,"name":"[x99.9 STATS] Button Bobux Simulator","desc":"Hello! Welcome to Button Bobux Simulator, the goal is to get as much Bobux as possible and get on the leaderboards! Push buttons to buy stats to get more and more BOBUX!\r\nThis game is not an incremental, but a button simulator!\n\r\nJoin the Community Server for the change log!\r\n\r\nNOTE: YOU CANNOT GET REAL ROBUX FROM THIS GAME!","path":"/game/11919433298-button-bobux-simulator","slug":"11919433298-button-bobux-simulator","thumbnail":{"url":"https://media.kocakz.me/10c430c2eebda3546a44025c57f11efb9c8fc547e805910790ed053baa2e9269.webp","original":"https://tr.rbxcdn.com/180DAY-dc38050cfe499b9bb5136c5e0a08c247/150/150/Image/Png/noFilter"},"playing":0,"visitor":2330193,"verified":false,"updatedAt":"2025-01-26T14:00:19.950Z","creator":{"name":"RoBase","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"x99.9-STATS-Button-Bobux-Simulator-Hello-27651","_id":"67963ff36eca977d712cc110","title":"Hello","game":{"_id":"67e5e1ffb360710ec3c785b4","gameId":11919433298,"name":"[x99.9 STATS] Button Bobux Simulator","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":11919433298},"features":"Auto answers","tags":[],"script":"--// Settings \\\\--\nlocal MessageDelay = {2, 5} -- between 2 and 5 seconds\n\n--// Services \\\\--\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\n\n--// Variables \\\\--\nlocal SayMessage = ReplicatedStorage:WaitForChild(\"DefaultChatSystemChatEvents\"):WaitForChild(\"SayMessageRequest\")\nlocal Leaderboards = Workspace:WaitForChild(\"Leaderboards\")\n\n--// Auto Questions \\\\--\nReplicatedStorage:WaitForChild(\"RemoteEvents\"):WaitForChild(\"SendCustomMessage\").OnClientEvent:Connect(function(a)\n    warn(a)\n    local Random = math.random(MessageDelay[1]*10, MessageDelay[2]*10)/10\n    task.wait(Random)\n    if string.find(a, \"Question\") then\n        if string.find(a, \"top 1 player\") then\n            a = string.split(a, \"in the \")[2]\n            a = string.split(a, \" leaderboard\")[1]\n            local LB = a == \"Donations\" and \"RobuxSpent\" or a\n            local List = Leaderboards[\"GlobalLB_\" .. LB].GlobalLBGui.List\n            while #List:GetChildren() < 30 do\n                task.wait(0.1)\n            end\n            for _, V in next, List:GetChildren() do\n                if V:IsA(\"Frame\") and V.Rank.Text == \"#1\" then\n                    SayMessage:FireServer(V.PlrName.Text, \"All\")\n                    task.wait()\n                    Players:Chat(V.PlrName.Text)\n                    break\n                end\n            end\n        elseif string.find(a, \"= ?\") then\n            a = string.split(a, \">: \")[2]\n            a = string.split(a, \" =\")[1]\n            a = \"return \" .. a\n            local Answer = loadstring(a)()\n            SayMessage:FireServer(Answer, \"All\")\n            task.wait()\n            Players:Chat(Answer)\n        end\n    end\nend)","owner":{"_id":"66baf21261c225fd5f40a22f","username":"Testing_scripts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/ebaa6582b51ba44b0f4e1a0b27261f67b27a0eb07175c25e8d6f8bc343d8703b.webp","original":"https://scriptblox.com/images/photo/66baf21261c225fd5f40a22f-1749977107618.jpg"},"status":"offline","id":"66baf21261c225fd5f40a22f","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/ebaa6582b51ba44b0f4e1a0b27261f67b27a0eb07175c25e8d6f8bc343d8703b.webp","original":"https://scriptblox.com/images/photo/66baf21261c225fd5f40a22f-1749977107618.jpg"}},"verified":false,"keyLink":"","views":3329,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025