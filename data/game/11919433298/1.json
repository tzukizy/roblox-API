     while #List:GetChildren() < 30 do\n                task.wait(0.1)\n            end\n            for _, V in next, List:GetChildren() do\n                if V:IsA(\"Frame\") and V.Rank.Text == \"#1\" then\n                    SayMessage:FireServer(V.PlrName.Text, \"All\")\n                    task.wait()\n                    Players:Chat(V.PlrName.Text)\n                    break\n                end\n            end\n        elseif string.find(a, \"= ?\") then\n            a = string.split(a, \">: \")[2]\n            a = string.split(a, \" =\")[1]\n            a = \"return \" .. a\n            local Answer = loadstring(a)()\n            SayMessage:FireServer(Answer, \"All\")\n            task.wait()\n            Players:Chat(Answer)\n        end\n    end\nend)","owner":{"_id":"66baf21261c225fd5f40a22f","username":"Testing_scripts","verified":false,"profilePicture":"/images/photo/66baf21261c225fd5f40a22f-1749977107618.jpg","status":"offline","id":"66baf21261c225fd5f40a22f","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":3322,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-26T14:00:19.950Z","dislikeCount":3,"likeCount":1,"image":"/images/sb/11919433298-1737900019766.png","executes":56,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54654","editBy":{"_id":"66baf21261c225fd5f40a22f","username":"Testing_scripts","status":"offline","id":"66baf21261c225fd5f40a22f"},"message":"Create script","createdAt":"2025-03-27T22:18:41.612Z"}],"comments":[{"_id":"67964673ab0c9689446ddc04","commentBy":{"_id":"66baf21261c225fd5f40a22f","username":"Testing_scripts","verified":false,"role":"user","profilePicture":"/images/photo/66baf21261c225fd5f40a22f-1749977107618.jpg","createdAt":"2024-08-13T05:41:38.615Z","lastActive":"2026-05-03T16:35:03.936Z","status":"offline","id":"66baf21261c225fd5f40a22f","topMilestone":{"