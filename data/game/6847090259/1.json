n    ar = state\nend)\n\nSection:NewToggle(\"Auto gem collector\", \"Collects gems automatically\", function(state)\n    agc = state\nend)\n\nSection:NewToggle(\"Auto candy collector\", \"Collects candies automatically\", function(state)\n    abg = state\nend)\n\n\nlp.CharacterAdded:Connect(function(character)\n    hrp = character:WaitForChild('HumanoidRootPart')\nend)\n\nwhile wait() do\n    if ar then\n\t    ur:FireServer(chr)\n    end\n    if agc then\n        for _, v in pairs(workspace:GetChildren()) do\n            if v.Name == 'Gem' then\n                v.Position = hrp.Position\n            end\n        end\n    end\n\tif abg then\n\t\tfor _, v in pairs(workspace:GetChildren()) do\n\t\t\tif v.Name == 'Candy' then\n\t\t\t\tv.Position = hrp.Position\n\t\t\tend\n\t\tend\n\tend\nend","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":"/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg","status":"offline","id":"64cde94eedb1b218a6931bfe"},"verified":false,"keyLink":"","views":36777,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-10T13:49:08.680Z","dislikeCount":0,"likeCount":4,"image":"https://tr.rbxcdn.com/7a020aeee88ded1d7b5100293ddf0afd/500/280/Image/Jpeg","executes":1985,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c4be","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Create script","createdAt":"2024-06-27T06:29:52.353Z"},{"_id":"67e5e1e3b360710ec3c4c4bf","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Update script","createdAt":"2024-06-27T06:30:43.081Z"},{"_id":"67e5e1e3b360710ec3c4c4c0","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":