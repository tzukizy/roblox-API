))()\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal mouse = player:GetMouse()\nlocal bp = player.Backpack\nlocal chr = player.Character\nif chr:FindFirstChild(\"Balloon Gun\") then\n    balloonGunRemote = chr:FindFirstChild(\"Balloon Gun\").RemoteEvent\nelseif bp:FindFirstChild(\"Balloon Gun\") then\n    bp:FindFirstChild(\"Balloon Gun\").Parent = chr\n    balloonGunRemote = chr:FindFirstChild(\"Balloon Gun\").RemoteEvent\nelse\n    warn('NO BALLOON GUN FOUND!!!')\n    return\nend\nlocal balloonGunRemote = player.Character:WaitForChild(\"Balloon Gun\").RemoteEvent\nlocal Window = Library.CreateLib(\"Balloon spammer\", \"DarkTheme\")\nlocal Tab = Window:NewTab(\"Main\")\nlocal Section = Tab:NewSection(\"Main\")\nlocal hrp, selectBtn\nlocal spamming = false\n\nselectBtn = Section:NewButton(\"Select object\", \"Selects object to spam\", function()\n    selectBtn:UpdateButton(\"Now select object and press ctrl to enter...\")\n    hrp = nil\n    local conn = UserInputService.InputBegan:Connect(function(input, processed)\n        if processed then return end\n\n        if input.KeyCode == Enum.KeyCode.LeftControl then\n            local targetPart = mouse.Target\n            if targetPart and targetPart.Parent then\n                if targetPart.Parent:FindFirstChild(\"HumanoidRootPart\") then\n                    hrp = targetPart.Parent:FindFirstChild(\"HumanoidRootPart\") --better\n                else\n                    hrp = targetPart\n                end\n            end\n        end\n    end)\n\n    while hrp == nil do\n        wait(0.1)\n    end\n    conn:Disconnect()\n    selectBtn:UpdateButton('Select object')\nend)\n\nSection:NewToggle(\"Spam\", \"Spams the object\", function(state)\n    spamming = state\nend)\n\nwhile task.wait() do\n    if hrp and hrp.Parent and spamming then\n        if balloonGunRemote == nil or balloonGunRemote.Parent == nil then\n            bp:FindFirstChild(\"Balloon Gun\").Parent = chr\n            balloonGunRemote = chr:FindFirstChild(\"Balloon Gun\").RemoteEvent\n        end\n        balloonGunRemote:FireServer(hrp.Position, hrp)\n    end\nend","features":"You can use this script if you have a balloon gun for Robux.","tags":["bulked up","balloon","balloon gun","robux","bruh"],"discord":"","keyLink":"","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"},"status":"offline","id":"64cde94eedb1b218a6931bfe","profile":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T18:03:02.206Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53aa5","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Create script","createdAt":"2025-03-27T21:49:55.505Z"}],"comments":[]},{"_id":"666704541bbcb5e73cdac35a","title":"Good GUI","game":{"_id":"67e5e1ffb360710ec3c77f7b","gameId":6847090259,"name":"Bulked Up","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"6847090259-bulked-up","path":"/game/6847090259-bulked-up","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":6847090259},"slug":"Bulked-Up-GUI-13986","verified":false,"key":false,"keyless":false,"views":36848,"executes":3281,"scriptType":"free","isUniversal":false,"isPatched":false,"visibil