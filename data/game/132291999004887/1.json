ages/script/rbx-7589c97fc500975d46def0a2c40e8ff1-b4fc722dcb28.png"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-04-25T17:09:41.868Z","updatedAt":"2025-04-25T17:09:41.868Z","lastBump":"2025-04-25T17:09:41.868Z","script":"local active = workspace:WaitForChild(\"activeBlocks\")\nlocal names = {}\n\nwhile task.wait() do\n    for _, v in ipairs(active:GetChildren()) do\n        local name = v.Name\n\n        if names[name] then\n            local block1 = names[name]\n            local block2 = v\n\n            if block1:FindFirstChildWhichIsA(\"BasePart\") and block2:FindFirstChildWhichIsA(\"BasePart\") then\n                block2:FindFirstChildWhichIsA(\"BasePart\").CFrame = block1:FindFirstChildWhichIsA(\"BasePart\").CFrame\n            end\n        else\n            names[name] = v\n        end\n    end\nend","features":"Auto merges blocks for you","tags":[],"discord":"","keyLink":"","owner":{"_id":"677755b5b19eb392c8c9aff6","username":"icmp","verified":false,"profilePicture":{"url":"https://media.kocakz.me/acdfc37a6e5daf15d84e66737d54e96d8802078e688860335bce7630d1fcc561.webp","original":"https://scriptblox.com/images/photo/677755b5b19eb392c8c9aff6-1735874028176.jpg"},"status":"offline","id":"677755b5b19eb392c8c9aff6","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/acdfc37a6e5daf15d84e66737d54e96d8802078e688860335bce7630d1fcc561.webp","original":"https://scriptblox.com/images/photo/677755b5b19eb392c8c9aff6-1735874028176.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:01:36.330Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"680bc1d572b1759084bef9bb","editBy":{"_id":"677755b5b19eb392c8c9aff6","username":"icmp","status":"offline","id":"677755b5b19eb392c8c9aff6"},"message":"Create script","createdAt":"2025-04-25T17:09:41.871Z