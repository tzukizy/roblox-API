{"id":13028445510,"name":"[📹CAMERA] Shoot Wall Simulator","desc":"Welcome to Shoot Wall Simulator ! 🚨 NEW UPDATE EVERY WEEK ENDS\n\n👍Like For Updates! \n🏋️ Train for Shoot \n🔫 Break Through Walls! \n🏆 Collect Pets, Wins & More! \n\n\nJoin The GROUP for secret REWARDS: https://www.roblox.com/groups/17363744/Toptier-Production\n\n🌟Join The Dizzy Server For OP Codes! \n\n⭐Premium Benefits: +20% Boost🔫 & +10% Speed👟 \n\n✨Follow us morldev for Codes! ","path":"/game/13028445510-shoot-wall-simulator","slug":"13028445510-shoot-wall-simulator","thumbnail":{"url":"https://media.kocakz.me/caaf4938daf3deb6d90f90d9ace8283faddd658237c57eaaa16cfc5a02a2739c.webp","original":"https://tr.rbxcdn.com/180DAY-d62e9b02e2220f6a9e26870a24d6b7c1/150/150/Image/Png/noFilter"},"playing":5,"visitor":79625644,"verified":false,"updatedAt":"2023-09-06T07:49:35.568Z","creator":{"name":"Toptier Production","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"FREE-LIMITED-Shoot-Wall-Simulator-Auto-Rebirth-7620","_id":"64f82f0f6786279fe528d9ba","title":"Sim AutoRebirth","game":{"_id":"67e5e1ffb360710ec3c7864b","gameId":13028445510,"name":"[📹CAMERA] Shoot Wall Simulator","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":13028445510},"features":"it is auto rebirth it only goes up to Trillion cus idk what is after that if u want to add to it yourself go ahead but make sure that the value for the number is correct \n\ne.g. B = Billion = 1,000,000,000","tags":["rebirth","shoot wall simulator","shoot wall","simulator"],"script":"-- Function to process the value and perform the comparison\nlocal function processValue(value)\n    -- Split the string at \"/\"\n    local parts = {}\n    for part in string.gmatch(value, \"[^/]+\") do\n        table.insert(parts, part)\n    end\n\n    -- Remove \" Ammo\" from the second variable\n    parts[2] = string.gsub(parts[2], \" Ammo\", \"\")\n\n    -- Extract the number and letter(s)\n    local num1, letter1 = string.match(parts[1], \"([%d.]+)([MBT]?)\")\n    local num2, letter2 = string.match(parts[2], \"([%d.]+)([MBT]?)\")\n\n    -- Function to convert the letter to a multiplier\n    local function getMultiplier(letter)\n        if letter == \"M\" then\n            return 1000000\n        elseif letter == \"B\" then\n            return 1000000000\n        elseif letter == \"T\" then\n            return 1000000000000\n        else\n            return 1 -- Default to 1 if no valid letter is found\n        end\n    end\n\n    -- Convert the numbers\n    num1 = tonumber(num1) * getMultiplier(letter1)\n    num2 = tonumber(num2) * getMultiplier(letter2)\n\n    -- Compare the two numbers\n    if num1 >= num2 then\n        print(\"\\nNumber one is equal to or greater than number two\")\n        print(\"num1:\"..num1..\"| num2:\"..num2)\n        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"RebirthSystem\"):WaitForChild(\"Remotes\"):WaitForChild(\"Rebirth\"):FireServer()\n    else\n        print(\"\\n\tNumber one is smaller than number two\")\n        print(\"n1:\"..num1..\"| n2:\"..num2)\n    end\nend\n\nwhile true do\nlocal value = game.Players.LocalPlayer.PlayerGui.MainUI.Frames.Rebirth.RebirthFrame.AmmoProgress.AmmoText.Text\n\nprocessValue(value)\nwait(5)\nend","owner":{"_id":"62363fee7c4c1ead8ed6c8e0","username":"Rhysical","verified":false,"profilePicture":{"url":"https://media.kocakz.me/131ca362c4c81da997fefe4ab607892a0ba93f4d396829272aafe3b2d7f71220.webp","original":"https://scriptblox.com/images/photo/62363fee7c4c1ead8ed6c8e0-1694108031251.png"},"status":"offline","id":"62363fee7c4c1ead8ed6c8e0","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/131ca362c4c81da997fefe4ab607892a0ba93f4d396829272aafe3b2d7f71220.webp","original":"https://scriptblox.com/images/photo/62363fee7c4c1ead8ed6c8e0-16941