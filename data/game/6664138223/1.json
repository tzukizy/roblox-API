alue in pairs( game:GetService(\"Players\"):GetChildren() ) do\n\t\t\t\t\tcoroutine.wrap(check)(value)\n\t\t\t\tend\n\t\t\t\twait(1)\n\t\t\tend\n\t\tend\n\telse\n\t\tprint(\"Toggle Off\")\n\tend\nend)\n\nSection:NewButton(\"Infinite Rage Mode\", \"ButtonInfo\", function()\n\tlocal plr = game:GetService(\"Players\").LocalPlayer\n\tplr:SetAttribute(\"RageMode\", true)\n\tprint(\"Clicked\")\nend)","owner":{"_id":"62ba0409f5f20be73ec8629e","username":"quilll457","verified":false,"profilePicture":"/images/photo/62ba0409f5f20be73ec8629e-1656395554973.png","status":"offline","id":"62ba0409f5f20be73ec8629e"},"verified":false,"views":7192,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-07-13T15:00:25.340Z","dislikeCount":1,"likeCount":2,"image":"https://tr.rbxcdn.com/4cf39bdcd0fbcb2bf69d9bedb1f4af8c/500/280/Image/Jpeg","executes":112,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e8d9","editBy":{"_id":"62ba0409f5f20be73ec8629e","username":"quilll457","status":"offline","id":"62ba0409f5f20be73ec8629e"},"message":"Create script","createdAt":"2025-03-27T21:30:56.338Z"}],"comments":[{"_id":"62cef4a85407a361d68aca99","commentBy":{"_id":"626cff4e77cb0f8bfbcdd137","username":"ckzw","verified":false,"role":"user","profilePicture":"/images/photo/626cff4e77cb0f8bfbcdd137-1714378452498.jpg","createdAt":"2022-04-30T09:20:14.326Z","lastActive":"2025-08-14T20:29:18.480Z","status":"offline","id":"626cff4e77cb0f8bfbcdd137","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Is it possible, to add inf rage in other games that have this type of event. Like transfur outbreak?","createdAt":"2022-07-13T16:36:56.176Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"62cf260cffcb2894befe30f8","commentBy":{"_id":"62cc3b9e1b3e9b019e186f14","username":"stonifam","verified":false,"role":"user","profilePicture":"/images/photo/62cc3b9e1b3e9b019e186f1