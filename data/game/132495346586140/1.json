e\nlocal loopConnection\n\n-- Function to toggle the loop\nlocal function toggleLoop()\n    isToggled = not isToggled\n    if isToggled then\n        -- Start the loop\n        loopConnection = game:GetService(\"RunService\").Heartbeat:Connect(function()\n            TrainRemote:FireServer()\n            wait(0.1) -- Adjusts the activation rate\n        end)\n    else\n        -- Stop the loop\n        if loopConnection then\n            loopConnection:Disconnect()\n            loopConnection = nil\n        end\n    end\nend\n\n-- Listen for the T key press\nUserInputService.InputBegan:Connect(function(input, isProcessed)\n    if not isProcessed and input.KeyCode == Enum.KeyCode.T then\n        toggleLoop()\n    end\nend)\n","owner":{"_id":"62c2ba1d1b5c9eb83fcd5c71","username":"Dev10","verified":false,"profilePicture":"/images/photo/62c2ba1d1b5c9eb83fcd5c71-1729474592003.jpg","status":"offline","id":"62c2ba1d1b5c9eb83fcd5c71","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":8150,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-12-06T21:33:12.582Z","dislikeCount":4,"likeCount":0,"image":"https://tr.rbxcdn.com/180DAY-a528a8ee898d39d42e50cf1b034b4a79/500/280/Image/Jpeg/noFilter","executes":289,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53611","editBy":{"_id":"62c2ba1d1b5c9eb83fcd5c71","username":"Dev10","status":"offline","id":"62c2ba1d1b5c9eb83fcd5c71"},"message":"Create script","createdAt":"2025-03-27T20:03:29.069Z"}],"comments":[{"_id":"675384cbab3917973b150c16","commentBy":{"_id":"6673c9d41b7cbb952505e50b","username":"Pandaz","verified":false,"role":"user","profilePicture":"/images/photo/6673c9d41b7cbb952505e50b-1733316153061.png","createdAt":"2024-06-20T06:19:00.864Z","lastActive":"2025-01-01T09:40:26.612Z","status":"offline","id":"6673c9d41b7cbb952505e50b"},"text":"Doesnt work on Delta","create