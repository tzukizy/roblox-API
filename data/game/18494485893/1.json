{"id":18494485893,"name":"A Silent Town","desc":"","path":"/game/18494485893-a-silent-town","slug":"18494485893-a-silent-town","thumbnail":["https://tr.rbxcdn.com/180DAY-ce56133c0c84063b6a8f6eec7bc71b92/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-695de657d8ab17c1bd860a72895b9134/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":0,"visitor":0,"verified":false,"updatedAt":"2026-08-22T02:38:45.559Z","creator":{"name":"Roblox","type":"User"},"script":{"count":3,"freeCount":3,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"A-Silent-Town-Auto-money-collect-224894","_id":"6a890bb5b74b4a5de6cd7df8","title":"Auto money collect","game":{"_id":"67e5e1ffb360710ec3c78776","gameId":18494485893,"name":"A Silent Town","imageUrl":"/images/sb/rbx-695de657d8ab17c1bd860a72895b9134-11c90eb5ab8c.png","placeId":18494485893},"features":"Auto money set getgenv false to stop","tags":[],"script":"getgenv().AutoMoney = true -- Set to false to stop\n\ntask.spawn(function()\n    local Players = game:GetService(\"Players\")\n    local LocalPlayer = Players.LocalPlayer\n    \n    while getgenv().AutoMoney do\n        local character = LocalPlayer.Character\n        local hrp = character and character:FindFirstChild(\"HumanoidRootPart\")\n        \n        if hrp and workspace:FindFirstChild(\"Map\") then\n            for _, item in ipairs(workspace.Map:GetDescendants()) do\n                if not getgenv().AutoMoney then break end\n                \n                if item.Name == \"Money\" then\n                    -- Teleport to the item\n                    if item:IsA(\"BasePart\") then\n                        hrp.CFrame = item.CFrame\n                    elseif item:IsA(\"Model\") and item.PrimaryPart then\n                        hrp.CFrame = item.PrimaryPart.CFrame\n                    end\n                    \n                    task.wait(0.1)\n                    \n                    -- Trigger ProximityPrompts 3 times\n                    local prompt = item:FindFirstChildOfClass(\"ProximityPrompt\") or item:FindFirstChildWhichIsA(\"ProximityPrompt\", true)\n                    if prompt then\n                        for i = 1, 3 do\n                            if not getgenv().AutoMoney then break end\n                            fireproximityprompt(prompt)\n                            task.wait(0.1)\n                        end\n                    end\n                end\n            end\n        end\n        task.wait(1)\n    end\nend)\n","owner":{"_id":"69106c1c98f91b7881f965e3","username":"Royalthess","verified":false,"profilePicture":"/images/photo/69106c1c98f91b7881f965e3-1765010515140.jpg","status":"offline","id":"69106c1c98f91b7881f965e3","topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":85,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-695de657d8ab17c1bd860a72895b9134-11c90eb5ab8c.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-08-22T02:38:45.560Z","executes":321,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a890bb5b74b4a5de6cd7dfa","editBy":{"_id":"69106c1c98f91b7881f965e3","username":"Royalthess","status":"offline","id":"69106c1c98f91b7881f965e3"},"message":"Create script","createdAt":"2026-08-22T02:38:45.564Z"}],"comments":[]},{"slug":"A-Silent-Town-Call-Raid-Command-220644","_id":"6a1079c02180718774dab39d","title":"Call Raid Command","game":{"_id":"67e5e1ffb360710ec3c78776","gameId":18494485893,"name":"A Silent Town","imageUrl":"/images/sb/rbx-695de657d8ab17c1bd860a72895b9134-11c90eb5ab8c.png","placeId":18494485893},"features":"When you say /CallRaid it makes a 1+e120 range sound that Brings/Attracts Listeners to your Location","tags":["Script","Troll","Exploit","Command","Roblox"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/MKdoyu34/Scripts/refs/heads/main/CallRaid-CMD\"))()","owner":{"_id":"69bf