{"id":8365905206,"name":"untitled tag game [beta]","desc":"A work in progress game of Tag with advanced movement including climbing, sliding, rolling, vaulting, swinging, and more! Currently, there are 13+ unique gamemodes, 12+ maps, and more! \n\nClick to tag C to slide \nC when landing to roll \nSpace at an edge to climb \nSpace when colliding with a \nSwingBar to swing \n\nWe are currently in development of a full remaster with loads more content and polish. You can access the early version of this in the lobby! \nPlease join our Communications Server to provide feedback as we read all of it and it helps us a ton!","path":"/game/8365905206-untitled-tag-game","slug":"8365905206-untitled-tag-game","thumbnail":{"url":"https://cdn.kocakz.me/images/51e8fc406bb9c247077ae654d87fb1cc4847ac17d54aa5a5d5d82feac09e97ef.webp","original":"https://tr.rbxcdn.com/180DAY-04cd806dcdf26d400b3fb4671772bce2/150/150/Image/Png/noFilter"},"playing":10,"visitor":72551171,"verified":false,"updatedAt":"2022-03-26T15:24:43.055Z","creator":{"name":"_create","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"untitled-tag-game-beta-Script-(Auto-Collect-Coin)-1471","_id":"623f303b0e95a7f871f01b59","title":"Script  (Auto Collect Coin)","game":{"_id":"67e5e1ffb360710ec3c78675","gameId":8365905206,"name":"untitled tag game [beta]","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":8365905206},"features":"Auto Collects Coin","tags":[],"script":"getgenv().enabled = true\n\n\n\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n\n   if getgenv().enabled == true then\n\n       for _, v in pairs(game.Workspace:WaitForChild(\"Coins\"):GetChildren()) do\n\n           local hrp = game.Players.LocalPlayer.Character:WaitForChild(\"HumanoidRootPart\")\n\n           local hum = hrp.Parent:WaitForChild(\"Humanoid\")\n\n           if hum.Health > 0 then\n\n               hrp.CFrame = v.Coin.CFrame\n\n               hum.Jump = true\n\n               repeat\n\n               hrp.CFrame = v.Coin.CFrame\n\n               hum.Jump = true\n\n               wait(0.01)\n\n               until v == nil or v.Parent == nil\n\n           end\n\n       end\n\n   end\n\nend)","owner":{"_id":"623dfd9091ddac7098ea5200","username":"daws","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/3f5b0998b584f22c3c47b2ea16b92d551d320ebbe95466ef5cab202bdf24f817.webp","original":"https://scriptblox.com/images/photo/623dfd9091ddac7098ea5200-1731515888226.jpg"},"status":"offline","id":"623dfd9091ddac7098ea5200","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/3f5b0998b584f22c3c47b2ea16b92d551d320ebbe95466ef5cab202bdf24f817.webp","original":"https://scriptblox.com/images/photo/623dfd9091ddac7098ea5200-1731515888226.jpg"}},"verified":false,"views":12652,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-03-26T15:24:43.055Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/8365905206-1648308283043.jpg","scriptblox":"https://scriptblox.com/images/script/8365905206-1648308283043.jpg"},"executes":44,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:25:10.537Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/8365905206-1648308283043.jpg","scriptblox":"https://scriptblox.com/images/script/8365905206-1648308283043.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4eef1","editBy":{"_id":"623dfd9091ddac7098ea5200","username":"daws","st