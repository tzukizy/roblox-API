{"id":1466995005,"name":"RAGDOLL UNIVERSE ","desc":"","path":"/game/1466995005-ragdoll-universe","slug":"1466995005-ragdoll-universe","thumbnail":["https://tr.rbxcdn.com/180DAY-1024471736a694cc73773fe88ed35836/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-344047b917079d406c8ecc4ec6ec6941/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":24,"visitor":0,"verified":false,"updatedAt":"2025-12-11T20:40:49.427Z","creator":{"name":"Roblox","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"RAGDOLL-UNIVERSE-Simple-GunMods-Open-Sourced-74274","_id":"693b2c5153e4ff1d2428a5fa","title":"Simple GunMods Open Sourced","game":{"_id":"67e5e1ffb360710ec3c788ff","gameId":1466995005,"name":"RAGDOLL UNIVERSE ","imageUrl":"/images/sb/rbx-344047b917079d406c8ecc4ec6ec6941-77869ca3eff1.png","placeId":1466995005},"features":"Open Sourced Gun Mods\nChange the values to wtv u want\nno credits needed/no rights over the script","tags":["Open Sourced","Gun Mods","Free","Keyless"],"script":"getgenv().GodMode = true\nlocal player = game:GetService(\"Players\").LocalPlayer\n\nlocal function modify(tool)\n    if tool:IsA(\"Tool\") and tool:FindFirstChild(\"Configuration\") then\n        local cfg = tool.Configuration\n        pcall(function()\n            if cfg:FindFirstChild(\"RecoilSpread\") then cfg.RecoilSpread.Value = 0 end\n            if cfg:FindFirstChild(\"Recoil\") then cfg.Recoil.Value = 0 end\n            if cfg:FindFirstChild(\"Spread\") then cfg.Spread.Value = 0 end\n            if cfg:FindFirstChild(\"SpreadAim\") then cfg.SpreadAim.Value = 0 end\n            if cfg:FindFirstChild(\"Automatic\") then cfg.Automatic.Value = true end\n            if cfg:FindFirstChild(\"BulletSpeed\") then cfg.BulletSpeed.Value = 99999 end\n            if cfg:FindFirstChild(\"Knockback\") then cfg.Knockback.Value = 0 end\n            if cfg:FindFirstChild(\"EquipTime\") then cfg.EquipTime.Value = 0 end\n            \n            if cfg:FindFirstChild(\"BulletGravity\") then\n                cfg.BulletGravity.Value = Vector3.new(0, 0, 0)\n            end\n        end)\n    end\nend\n\nspawn(function()\n    while getgenv().GodMode do\n        for _, tool in player.Backpack:GetChildren() do modify(tool) end\n        \n        if player.Character then\n            for _, tool in player.Character:GetChildren() do modify(tool) end\n        end\n        \n        task.wait(0.05)\n    end\nend)","owner":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"profilePicture":"/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png","status":"offline","id":"66c63d08f2b2900a0fcb7b0a","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":1198,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-344047b917079d406c8ecc4ec6ec6941-77869ca3eff1.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-12-11T20:40:49.428Z","keyLink":"","executes":90,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"693b2c5153e4ff1d2428a5fc","editBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","status":"offline","id":"66c63d08f2b2900a0fcb7b0a"},"message":"Create script","createdAt":"2025-12-11T20:40:49.430Z"}],"comments":[{"_id":"693d3ecdd77d82777cf2d885","commentBy":{"_id":"68e9cc9d3f406b2d0311c593","username":"Demarion","verified":false,"role":"user","profilePicture":"/images/photo/68e9cc9d3f406b2d0311c593-1760152832153.png","createdAt":"2025-10-11T03:18:53.453Z","lastActive":"2026-09-29T05:41:02.719Z","status":"offline","id":"68e9cc9d3f406b2d0311c593"},"text":"Don’t work","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-13T10:24:13.081Z","liked":false,"disliked":false},{"_id":"693f0341f002b181ca165692","commentBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"role":"user","profilePicture":"/ima