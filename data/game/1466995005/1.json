{"id":1466995005,"name":"RAGDOLL UNIVERSE ","desc":"A movement shooter with ragdoll physics. \n\n💰 JOIN THE LSPLASH GROUP TO GET 25% MORE COINS!\n😎 Get Premium to get 50% extra coins and an exclusive pattern and material!\n( Coin bonus does not apply when buying with Robux )\n\n⭐ PRIVATE SERVERS are set in MAYHEM and come with a SERVER CONSOLE; press ~ or type /c in the chat to open it up! You can spawn items, vehicles, crates, and force gamemodes / modifiers / maps (some of which are unused and exclusive to VIP Servers!)","path":"/game/1466995005-ragdoll-universe","slug":"1466995005-ragdoll-universe","thumbnail":{"url":"https://media.kocakz.me/db74c94884c38421f6b1128a5a7aacdb41e48eb5b2d690fddcf9922b2d72c867.webp","original":"https://tr.rbxcdn.com/180DAY-1024471736a694cc73773fe88ed35836/150/150/Image/Png/noFilter"},"playing":15,"visitor":50473973,"verified":false,"updatedAt":"2025-12-11T20:40:49.427Z","creator":{"name":"LSPLASH","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"693b2c5153e4ff1d2428a5fa","title":"Simple GunMods Open Sourced","game":{"_id":"67e5e1ffb360710ec3c788ff","gameId":1466995005,"name":"RAGDOLL UNIVERSE ","imageUrl":{"url":"https://media.kocakz.me/db74c94884c38421f6b1128a5a7aacdb41e48eb5b2d690fddcf9922b2d72c867.webp","original":"https://tr.rbxcdn.com/180DAY-1024471736a694cc73773fe88ed35836/150/150/Image/Png/noFilter"},"slug":"1466995005-ragdoll-universe","path":"/game/1466995005-ragdoll-universe","thumbnail":{"url":"https://media.kocakz.me/db74c94884c38421f6b1128a5a7aacdb41e48eb5b2d690fddcf9922b2d72c867.webp","original":"https://tr.rbxcdn.com/180DAY-1024471736a694cc73773fe88ed35836/150/150/Image/Png/noFilter"},"placeId":1466995005},"slug":"RAGDOLL-UNIVERSE-Simple-GunMods-Open-Sourced-74274","verified":false,"key":false,"keyless":false,"views":1218,"executes":121,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/068e1dd5d9ffe13abc1d64e642e50729248619e2ead6e17809cdcd0e86cd7e4e.webp","original":"https://scriptblox.com/images/sb/rbx-344047b917079d406c8ecc4ec6ec6941-77869ca3eff1.png","scriptblox":"https://scriptblox.com/images/script/rbx-344047b917079d406c8ecc4ec6ec6941-77869ca3eff1.png"},"thumbnail":{"url":"https://media.kocakz.me/068e1dd5d9ffe13abc1d64e642e50729248619e2ead6e17809cdcd0e86cd7e4e.webp","original":"https://scriptblox.com/images/sb/rbx-344047b917079d406c8ecc4ec6ec6941-77869ca3eff1.png","scriptblox":"https://scriptblox.com/images/script/rbx-344047b917079d406c8ecc4ec6ec6941-77869ca3eff1.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-12-11T20:40:49.428Z","updatedAt":"2025-12-11T20:40:49.428Z","lastBump":"2025-12-11T20:40:49.428Z","script":"getgenv().GodMode = true\nlocal player = game:GetService(\"Players\").LocalPlayer\n\nlocal function modify(tool)\n    if tool:IsA(\"Tool\") and tool:FindFirstChild(\"Configuration\") then\n        local cfg = tool.Configuration\n        pcall(function()\n            if cfg:FindFirstChild(\"RecoilSpread\") then cfg.RecoilSpread.Value = 0 end\n            if cfg:FindFirstChild(\"Recoil\") then cfg.Recoil.Value = 0 end\n            if cfg:FindFirstChild(\"Spread\") then cfg.Spread.Value = 0 end\n            if cfg:FindFirstChild(\"SpreadAim\") then cfg.SpreadAim.Value = 0 end\n            if cfg:FindFirstChild(\"Automatic\") then cfg.Automatic.Value = true end\n            if cfg:FindFirstChild(\"BulletSpeed\") then cfg.BulletSpeed.Value = 99999 end\n            if cfg:FindFirstChild(\"Knockback\") then cfg.Knockback.Value = 0 end\n            if cfg:FindFirstChild(\"EquipTime\") then cfg.EquipTime.Value = 0 end\n            \n            if cfg:FindFirstChild(\"BulletGravity\") then\n                cfg.BulletGravity.Value = Vector3.new(0, 0, 0)\n            end\n        end)\n    end\nend\n\nspawn(function()\n    while getgenv().GodMode do\n        for _, tool in player.Backpack:GetChildren() do modify(tool) end\n        \n        if player.Character then\n            for _, tool in player.Character:GetChildren() do modify(tool) end\n        end\n        \n        task.wait(0.05)\n    end\nend)","features":"Open Sourced Gun Mods\nChange the values to wtv u want\nno credits needed/no rights over the script","tags":["Open Sourced","Gun Mods","Free","Keyless"],"discord":"","keyLink":"","owner":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c7e7f0518d9a6fa042e7459ceef6258d16aacc0baea47017f8db17047ac34be7.webp","original":"https://scriptblox.com/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png"},"status":"offline","id":"66c63d08f2b2900a0fcb7b0a","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/c7e7f0518d9a6fa042e7459ceef6258d16aacc0baea47017f8db17047ac34be7.webp","original":"https://scriptblox.com/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:38:42.782Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693b2c5153e4ff1d2428a5fc","editBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","status":"offline","id":"66c63d08f2b2900a0fcb7b0a"},"message":"Create script","createdAt":"2025-12-11T20:40:49.430Z"}],"comments":[{"_id":"693d3ecdd77d82777cf2d885","commentBy":{"_id":"68e9cc9d3f406b2d0311c593","username":"Demarion","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/a1b9fbd9532deae61e2df99a64ef512c56809eab43e92698cd2bc4ab8a919138.webp","original":"https://scriptblox.com/images/photo/68e9cc9d3f406b2d0311c593-1760152832153.png"},"createdAt":"2025-10-11T03:18:53.453Z","lastActive":"2026-09-29T05:41:02.719Z","status":"offline","id":"68e9cc