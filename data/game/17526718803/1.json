         if checkpoint then\n                local primarypart=checkpoint:WaitForChild(\"Primary\")\n                local green=true\n                if primarypart.Color~=Color3.fromRGB(49,147,0) then\n                    green=false\n                end\n                if not green then\n                    root.CFrame=primarypart.CFrame\n                    primarypart.Touched:Wait()\n                end\n                index+=1\n            elseif index>0 then\n                break\n            end\n        end\n    end)\nend\n\ngetgenv().Win()","features":"Enjoy.\n\nVideo: youtube.com/watch?v=cgSKwnv3dDs\nRepo where the script will always update: github.com/bob448/bobs_scripts/","tags":[],"discord":"","keyLink":"","owner":{"_id":"6611b26ca06ccd6247afda17","username":"bobmichealson8","verified":false,"profilePicture":{"url":"https://media.kocakz.me/3635be1367c168d198a4d07dd32c64c5a691f53f90622d839978dad480c330df.webp","original":"https://scriptblox.com/images/photo/6611b26ca06ccd6247afda17-1713016747844.png"},"status":"offline","id":"6611b26ca06ccd6247afda17","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/3635be1367c168d198a4d07dd32c64c5a691f53f90622d839978dad480c330df.webp","original":"https://scriptblox.com/images/photo/6611b26ca06ccd6247afda17-1713016747844.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T03:11:06.952Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c6ff","editBy":{"_id":"6611b26ca06ccd6247afda17","username":"bobmichealson8","status":"offline","id":"6611b26ca06ccd6247afda17"},"message":"Create script","createdAt":"2024-07-08T15:55:50.169Z"},{"_id":"67e5e1e5b360710ec3c514e7","editBy":{"_id":"6611b26ca06ccd6247afda17","username":"bobmichealson8","status":"offline","id":"6611b26ca06c