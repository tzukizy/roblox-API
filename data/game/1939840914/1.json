)!\nHow to use:\n1. Get REAL F3X/btools (by real I mean not from inf yield or smth)\n2. Run the script. (DONT EQUIP F3X/BTOOLS)\n\nHow to find someone's VIP server?\nFind a random public server with news smth like VIP on Greenland/Moscow.\n\nHow to get F3X/btools?\nYou can't get it by any script, so you can use social engineering(kinda).\nSo you need to join the server as early as possible, then try to wait. Usually, the admin will give btools to everyone. Also, you can try to spam to chat(if chat is active) and/or broadcast news.\nThis technique works the best on kids and Russians(maybe). But this technique is universal.\n\nA message with \"IT DOES SMTH!\" means that the script is still working. If the delay between these messages is long, that means that the server processes the previous clone request.","tags":["lag","sabotage","OP","vip","nations roleplay"],"script":"local ScreenGui = Instance.new(\"ScreenGui\")\nlocal Frame = Instance.new(\"Frame\")\nlocal UICorner = Instance.new(\"UICorner\")\nlocal Close = Instance.new(\"TextButton\")\nlocal UICorner_2 = Instance.new(\"UICorner\")\nlocal RPS = Instance.new(\"TextLabel\")\nlocal Toggle = Instance.new(\"TextButton\")\nlocal UICorner_3 = Instance.new(\"UICorner\")\nlocal sg = game:GetService(\"StarterGui\")\n\nlocal enabled = false\nlocal running = true\n\nlocal SyncAPI = game:GetService('Players').LocalPlayer.Backpack['Building Tools'].SyncAPI.ServerEndpoint\n\nScreenGui.Parent = game:GetService('CoreGui').RobloxGui\nScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\n\nFrame.Parent = ScreenGui\nFrame.Active = true\nFrame.BackgroundColor3 = Color3.new(0, 0, 0)\nFrame.BackgroundTransparency = 0.25\nFrame.BorderColor3 = Color3.new(0, 0, 0)\nFrame.BorderSizePixel = 0\nFrame.Draggable = true\nFrame.Position = UDim2.new(0.40953958, 0, 0.273504198, 0)\nFrame.Size = UDim2.new(0.150560141, 0, 0.189316183, 0)\n\nUICorner.Parent = Frame\nUICorner.CornerRadius = UDim.new(0.100000001, 0)\n\nClose.Name = \"Close\"\nClose.Parent = Frame\nClose.BackgroundColor3 = Color3.new(1, 0, 0.0156863)\nClose.BorderColor3 = Color3.new(0, 0, 0)\nClose.BorderSizePixel = 0\nClose.Position = UDim2.new(0.718272984, 0, 0.0902931318, 0)\nClose.Size = UDim2.new(0.239449263, 0, 0.354711175, 0)\nClose.Font = Enum.Font.FredokaOne\nClose.Text = \"X\"\nClose.TextColor3 = Color3.new(1, 1, 1)\nClose.TextScaled = true\nClose.TextSize = 14\nClose.TextWrapped = true\n\nUICorner_2.Parent = Close\nUICorner_2.CornerRadius = UDim.new(0.5, 0)\n\nRPS.Name = \"RPS\"\nRPS.Parent = Frame\nRPS.BackgroundColor3 = Color3.new(1, 1, 1)\nRPS.BackgroundTransparency = 1\nRPS.BorderColor3 = Color3.new(0, 0, 0)\nRPS.BorderSizePixel = 0\nRPS.Position = UDim2.new(0, 0, 0.0790067911, 0)\nRPS.Size = UDim2.new(0.650175989, 0, 0.354711026, 0)\nRPS.Font = Enum.Font.FredokaOne\nRPS.Text = \"Lagger\"\nRPS.TextColor3 = Color3.new(1, 1, 1)\nRPS.TextScaled = true\nRPS.TextSize = 14\nRPS.TextWrapped = true\n\nToggle.Name = \"Toggle\"\nToggle.Parent = Frame\nToggle.BackgroundColor3 = Color3.new(1, 0, 0)\nToggle.BorderColor3 = Color3.new(0, 0, 0)\nToggle.BorderSizePixel = 0\nToggle.Position = UDim2.new(0.0317084529, 0, 0.604799509, 0)\nToggle.Size = UDim2.new(0.931298375, 0, 0.327231526, 0)\nToggle.Font = Enum.Font.FredokaOne\nToggle.Text = \"Disabled\"\nToggle.TextColor3 = Color3.new(1, 1, 1)\nToggle.TextScaled = true\nToggle.TextSize = 14\nToggle.TextWrapped = true\n\nUICorner_3.Parent = Toggle\nUICorner_3.CornerRadius = UDim.new(0.200000003, 0)\n\nClose.Activated:Connect(function() \n    ScreenGui:Destroy()\n    running = false\nend)\n\nToggle.Activated:Connect(function()\n    enabled = not enabled\n    if enabled then\n        Toggle.Text = 'Enabled'\n        Toggle.BackgroundColor3 = Color3.new(0,1,0)\n    else\n        Toggle.Text = 'Disabled'\n        Toggle.BackgroundColor3 = Color3.new(1,0,0)\n    end\nend)\n\nwhile running do\n    if enabled then\n        sg:SetCore(\"SendNotification\",{\n            Title = \"Messgae\",\n            Text = \"IT DOES SMTH!\",\n            Icon = \"rbxassetid://14529775287\"\n        })\n        SyncAPI:InvokeServer('Clone', {workspace.Map}, workspace.Map)\n    else\n        wait()\n    end\nend","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":"/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg","status":"offline","id":"64cde94eedb1b218a6931bfe"},"verified":false,"keyLink":"","views":27352,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-16T18:31:21.931Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/180DAY-398feee90fd8a4386c3bd5728b5174d2/500/280/Image/Jpeg/noFilter","executes":229,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d9df","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Create script","createdAt":"2025-02-16T20:22:00.466Z"},{"_id":"67e5e1e3b360710ec3c4d9e0","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Update script","createdAt":"2025-02-17T14:47:37.740Z"},{"_id":"67e5e1e7b360710ec3c54e37","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","status":"offline","id":"64cde94eedb1b218a6931bfe"},"message":"Update script","createdAt":"2025-03-27T22:59:25.421Z"}],"comments":[{"_id":"67b5495ce464eec7e06f86e8","commentBy":{"_id":"6760f50a5c16f6c213dff61a","username":"ejpogitot","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-12-17T03:50:34.039Z","lastActive":"2025-05-30T09:36:43.296Z","status":"offline","id":"6760f50a5c16f6c213dff61a"},"text":"what does this script do","createdAt":"2025-02-19T03:00:44.953Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"67b54968ea6658689895007c","commentBy":{"_id":"6760f50a5c16f6c213dff