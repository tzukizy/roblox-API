a94a6a3f7b1c6a8-671e3b6de0ad.png","scriptblox":"https://scriptblox.com/images/script/rbx-67309f4fa9cf800eea94a6a3f7b1c6a8-671e3b6de0ad.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-05-16T11:08:09.271Z","updatedAt":"2025-05-16T11:08:09.271Z","lastBump":"2025-05-16T11:08:09.271Z","script":"local lp = game.Players.LocalPlayer\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"CarDeleterUI\"\nscreenGui.Parent = game.CoreGui\n\nlocal toggleButton = Instance.new(\"TextButton\")\ntoggleButton.Size = UDim2.new(0, 150, 0, 50)\ntoggleButton.Position = UDim2.new(0, 20, 0, 20)\ntoggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)\ntoggleButton.TextColor3 = Color3.new(1, 1, 1)\ntoggleButton.Font = Enum.Font.SourceSansBold\ntoggleButton.TextSize = 22\ntoggleButton.Text = \"Delete Cars: OFF\"\ntoggleButton.Parent = screenGui\n\nlocal deleting = false\n\ntoggleButton.MouseButton1Click:Connect(function()\n    deleting = not deleting\n    toggleButton.Text = deleting and \"Delete Cars: ON\" or \"Delete Cars: OFF\"\n\n    if deleting then\n        task.spawn(function()\n            while deleting do\n                local cars = {}\n                for _, v in pairs(workspace:GetDescendants()) do\n                    if v:IsA(\"Model\") and v.Name:lower():find(\"car\") and not v.Name:lower():find(lp.Name:lower()) then\n                        table.insert(cars, v)\n                    end\n                end\n\n                if #cars > 0 then\n                    local target = cars[math.random(1, #cars)]\n                    game.ReplicatedStorage.DeleteCar:FireServer(target)\n                end\n\n                task.wait()\n            end\n        end)\n    end\nend)\n","features":"Works On Almost All Of Their Games","tags":[],"discord":"","keyLink":"","owner":{"_id":"68018b0008d1fe2f7909aa84","username":"exserdashdev","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8a5dd5d7fad3d14c67042a887da7e8d1097162f72a4c302b92b339b2a38e