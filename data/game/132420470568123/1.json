{"id":132420470568123,"name":"Stair Battles!","desc":"⚒️ Welcome to Stair Battles!\nA game where you battle and build for the trophy!\n\n🧱 Build your stairs before your enemy does!\n💥 Shoot your enemies and their stairs with different RPGs!\n💪 Upgrade and buy different weapons to become stronger!\n🏆 The first one to reach the trophy wins!\n\n🥸 Inspired by Bridge Builders & Bridge Battles\n\n👍 Like and favorite the game!\n📱 Supports Desktop, Mobile and all other platforms!","path":"/game/132420470568123-stair-battles","slug":"132420470568123-stair-battles","thumbnail":{"url":"https://media.kocakz.me/9ee30483c32b8fa62a2c7d1e676e53bdea3fc507d702aaa5d86aaceab922e041.webp","original":"https://tr.rbxcdn.com/180DAY-edc2712199d72f96234f10a53b2ee32d/150/150/Image/Png/noFilter"},"playing":0,"visitor":1970878,"verified":false,"updatedAt":"2025-09-16T20:59:32.437Z","creator":{"name":"RUSH! STUDIOS","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":1},"page":1,"next":null,"total":1,"scripts":[{"slug":"Stair-Battles!-Auto-Stairs-NO-GUI-53632","_id":"68c9cfb4abb70cac98387e47","title":"Auto Stairs NO GUI","game":{"_id":"68c9cfb4abb70cac98387e44","gameId":132420470568123,"name":"Stair Battles!","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":132420470568123},"features":"Automatically builds the stairs for ONE ROUND.\n\nRecommended to execute during a round not before but it will still work.","tags":["auto","stairs","op","hub","fun"],"script":"\nlocal Config = {\n    [\"FastWin\"] = false, -- Win Faster but slower stairs?\n    --[\"AutoLoop\"] = false, -- DOES NOT WORK\n}\n\nlocal RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal Functional = workspace.FunctionalFolder\n\nlocal function getRandAngles()\n    local x = math.rad(math.random(-180, 180))\n    local y = math.rad(math.random(-180, 180))\n    local z = math.rad(math.random(-180, 180))\n    return CFrame.Angles(x, y, z)\nend\n\nlocal function getCharacter()\n    return LocalPlayer.Character or (LocalPlayer.CharacterAdded:wait() and LocalPlayer.Character)\nend\n\nlocal function getTeam()\n    return getCharacter().Parent.Name:gsub(\" Team\", '')\nend\n\nlocal function getBase()\n    local baseName = getTeam() .. \"Base\"\n    return Functional:FindFirstChild(baseName)\nend\n\nlocal function getBlockGiver()\n    local Base = getBase()\n    local BlockGivers = Functional:WaitForChild(\"BlockGivers\"):GetChildren()\n    local StartStairPos = Base.StartStair.Position\n\n    local Closest = math.huge\n    local Best = nil\n    for i, BlockGiver in pairs(BlockGivers) do\n        local DistanceFromStair = (BlockGiver.Position - StartStairPos).Magnitude\n        if DistanceFromStair < Closest then\n            Closest = DistanceFromStair\n            Best = BlockGiver\n        end\n    end\n    return Best\nend\nwhile task.wait() do\n    if Config.AutoLoop == true then\n        print(\"Started with Auto Loop\")\n    end\n    repeat task.wait()\n    until getBase()\n    print(\"AUTO WIN | MATCH STARTED\", getTeam())\n\n    local PlacePreview = Functional.PlacePreview\n    local Character = getCharacter()\n    local RootPart = Character.HumanoidRootPart\n    local Humanoid = Character.Humanoid\n    Humanoid.EvaluateStateMachine = false\n\n    while task.wait() and getBase() and RootPart do\n        print(\"Looping..\")\n        local BlockGiver = getBlockGiver()\n        if BlockGiver then\n            -- Teleport to the block giver (upside down)\n            repeat\n                RootPart.CFrame = CFrame.new(BlockGiver.Position) * getRandAngles()\n                task.wait()\n                RootPart.CFrame = CFrame.new(BlockGiver.Position + Vector3.new(0, 500, 0)) * getRandAngles()\n                task.wait()\n            until Character:FindFirstChild(\"BlocksTool\")\n            local BestBlock = PlacePreview:FindFirstChildOfClass(\"Part\")\n            repeat\n                if not BestBlock then\n                    BestBlock = PlacePreview:FindFirstChildOfClass(\"Part\")\n                    continue\n                end\n                RootPart.CFrame = CFrame.new(BestBlock.Position) * getRandAngles()\n                task.wait()\n            until Character:FindFirstChild(\"BlocksTool\")\n        end\n        if Config.FastWin == true then\n            local WinTouchPart = Functional:FindFirstChild(\"WinTouchPart\", true)\n            task.wait()\n            if RootPart and getBase() then\n                getCharacter():WaitForChild(\"HumanoidRootPart\").CFrame = WinTouchPart.CFrame * getRandAngles()\n                task.wait()\n            end\n        end\n    end\n    print(\"AUTO WIN | MATCH COMPLETE\")\n    if Config.AutoLoop == false then\n        break\n    end\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11035507}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"verified":true,"views":82601,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/30149616337f9ffd5e18f5387f6a3d19590c78663e3c310f6d442d86cded1744.webp","original":"https://scriptblox.com/images/sb/rbx-f7f2018c1386fc3408041bcf19ef0b97-7c2f63dd8369.png","scriptblox":"https://scriptblox.com/images/script/rbx-f7f2018c1386fc3408041bcf19ef0b97-7c2f63dd8369.png"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-09-16T20:59:32.438Z","executes":18,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:11:56.544Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/30149616337f9ffd5e18f5387f6a3d19590c78663e3c310f6d442d86cded1744.webp","original":"https://scriptblox.com/images/sb/rbx-f7f2018c1386fc3408041bcf19ef0b97-7c2f63dd8369.png","scriptblox":"https://scriptblox.com/images/script/rbx-f7f2018c1386fc3408041bcf19ef0b97-7c2f63dd8369.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c9cfb4abb70cac98387e49","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-09-16T20:59:32.441Z"}],"comments":[{"_id":"68c9d61d4e8ae86fddf5434e","commentBy":{"_id":"68c0212614548da8fe873ab9","username":"SyrexGenesis","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/e2d54051e9f9fe06c83f39efe260106b1ba3c46a919b7edfcbdce4b4c6ebcc24.webp","original":"https://scriptblox.com/images/photo/68c0212614548da8fe873ab9-1757941704674.png"},"createdAt":"2025-09-09T12:44:22.090Z","lastActive":"2025-10-21T00:23:01.534Z","status":"offline","id":"68c0212614548da8fe873ab9","profile":{"url":"https://media.kocakz.me/e2d54051e9f9fe06c83f39efe260106b1ba3c46a919b7edfcbdce4b4c6ebcc24.webp","original":"https://scriptblox.com/images/photo/68c0212614548da8fe873ab9-1757941704674.png"}},"text":"Thanks but is buggy sometimes it doesn't works when a part of the stairs is gone","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-16T21:26:53.568Z","liked":false,"disliked":false},{"_id":"68c9fad492713e0e5846db95","commentBy":{"_id":"68af86038decc0a67744ca92","username":"Odetari","verifi