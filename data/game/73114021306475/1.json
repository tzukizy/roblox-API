{"id":73114021306475,"name":"[AURE BASE] Brainrot Ascension","desc":"🔥Become more powerful to obtain better Brainrots!\n💥Stay in your plot to gain aura from you Brainrots!\n🔁 Keep Rebirthing to gain multipliers!\n\n👑Can you be the biggest mogger to obtain the best Brainrots?\n\n","path":"/game/73114021306475-aure-base-brainrot-ascension","slug":"73114021306475-aure-base-brainrot-ascension","thumbnail":["https://tr.rbxcdn.com/180DAY-421f3b98ead45da8425563dd3becbf2e/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-88e326928db92c892e52957c612e001a/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":24,"visitor":4972985,"verified":false,"updatedAt":"2026-04-12T13:37:53.999Z","creator":{"name":"Barely Floating","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"AURE-BASE-Brainrot-Ascension-go-to-spawn-and-go-to-end-open-source-265184","_id":"69dba0313ffa1ec82744999e","title":"go to spawn and go to end open source","game":{"_id":"69dba0313ffa1ec82744999a","gameId":73114021306475,"name":"[AURE BASE] Brainrot Ascension","imageUrl":"/images/sb/rbx-88e326928db92c892e52957c612e001a-c2414b5a85f5.png","placeId":73114021306475},"features":"features:\ngo to spawn\ngo to end\nthats all. im too lazy to make auto best rarity","tags":["open source"],"script":"local Xeno = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/itay299/RobloxScripts/refs/heads/main/Scripts/!MyLibrary\"))()\n\nlocal UI = Xeno:Create(\"Brainrot Ascension\", \"BrainrotAscension\")\nUI:BindToggle(\"Semicolon\")\n\nlocal player = game.Players.LocalPlayer\n\nlocal function tpTo(pos)\n    local char = player.Character or player.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n    hrp.CFrame = CFrame.new(pos)\nend\n\n-- Buttons\nUI:Button(\"Go to Spawn\", function()\n    tpTo(Vector3.new(-26, 1, 536.60))\nend)\n\nUI:Button(\"Go to End\", function()\n    tpTo(Vector3.new(3754, 1.25, 586.68))\nend)","owner":{"_id":"680a5b1e8fe2d5b198d0fd34","username":"becausewhyy","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"680a5b1e8fe2d5b198d0fd34","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":762,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/73114021306475-1776001073957.png","likeCount":2,"dislikeCount":1,"createdAt":"2026-04-12T13:37:54.001Z","executes":48,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dba0323ffa1ec8274499a1","editBy":{"_id":"680a5b1e8fe2d5b198d0fd34","username":"becausewhyy","status":"offline","id":"680a5b1e8fe2d5b198d0fd34"},"message":"Create script","createdAt":"2026-04-12T13:37:54.007Z"}],"comments":[{"_id":"69de90cda5e73966d777b309","commentBy":{"_id":"69d048100d3ab5dd8ab97faf","username":"GGNoob","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-05-01T17:49:45.662Z","createdAt":"2026-04-03T23:06:56.175Z","status":"offline","id":"69d048100d3ab5dd8ab97faf"},"text":"bIG W","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-14T19:09:01.780Z","liked":false,"disliked":false},{"_id":"69de915e124dddd5613eb231","commentBy":{"_id":"69d048100d3ab5dd8ab97faf","username":"GGNoob","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-05-01T17:49:45.662Z","createdAt":"2026-04-03T23:06:56.175Z","status":"offline","id":"69d048100d3ab5dd8ab97faf"},"text":"Fix this new update please","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-14T19:11:26.651Z","liked":false,"disliked":false}]}]}