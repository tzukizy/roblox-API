d\nend\n\ntask.spawn(function() while true do fireRemote(\"obtener\") task.wait(0.1) end end)\ntask.spawn(function() while true do fireRemote(\"quitar\") task.wait(0.1) end end)\nend)","owner":{"_id":"6692851fb404251a8498af78","username":"sillzchibi","verified":false,"profilePicture":"/images/photo/6692851fb404251a8498af78-1720878905872.jpg","status":"offline","id":"6692851fb404251a8498af78","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":9209,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-08731139b4e7ff402819665d95d37f7a-4e23ed1a03d6.png","likeCount":1,"dislikeCount":2,"createdAt":"2025-05-11T10:44:58.897Z","editBy":{"_id":"6692851fb404251a8498af78","username":"sillzchibi","status":"offline","id":"6692851fb404251a8498af78"},"keyLink":"","executes":927,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68207faaf8062e8f48525e2f","editBy":{"_id":"6692851fb404251a8498af78","username":"sillzchibi","status":"offline","id":"6692851fb404251a8498af78"},"message":"Create script","createdAt":"2025-05-11T10:44:58.899Z"},{"_id":"682a4ef275c7a3014536034f","editBy":{"_id":"6692851fb404251a8498af78","username":"sillzchibi","status":"offline","id":"6692851fb404251a8498af78"},"message":"Update script","createdAt":"2025-05-18T21:19:46.883Z"},{"_id":"6838c01e6c763332352e8b32","editBy":{"_id":"6692851fb404251a8498af78","username":"sillzchibi","status":"offline","id":"6692851fb404251a8498af78"},"message":"Update script","createdAt":"2025-05-29T20:14:22.195Z"},{"_id":"6919aaa900deefa59f672cd4","editBy":{"_id":"6692851fb404251a8498af78","username":"sillzchibi","status":"offline","id":"6692851fb404251a8498af78"},"message":"Fixed retarted code","createdAt":"2025-11-16T10:42:49.274Z"}],"comments":[{"_id":"68208b9cd63a761dc9093c8d","commentBy":{"_id":"66627bdf1da3a4ecc9929f3f","username":"Ang3l","verified":false,"role":"user","profilePicture":"/images/