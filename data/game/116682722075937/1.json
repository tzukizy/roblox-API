-Kill-All-41912","verified":false,"key":false,"keyless":false,"views":20862,"executes":3501,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-7924ea31f9e3509bf26851e228c0418c-25f8d74d1e43.png","scriptblox":"https://scriptblox.com/images/script/rbx-7924ea31f9e3509bf26851e228c0418c-25f8d74d1e43.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-7924ea31f9e3509bf26851e228c0418c-25f8d74d1e43.png","scriptblox":"https://scriptblox.com/images/script/rbx-7924ea31f9e3509bf26851e228c0418c-25f8d74d1e43.png"},"likeCount":6,"dislikeCount":2,"createdAt":"2025-06-08T16:01:15.054Z","updatedAt":"2025-06-08T16:01:15.054Z","lastBump":"2025-06-08T16:01:15.054Z","script":"local players = game:GetService(\"Players\")\n\nlocal local_player = players.LocalPlayer\n\ngetgenv().settings = {\n    swing_aura = true,\n    max_distance = 9e9\n}\n\nif settings.swing_aura then\n    repeat\n        local targets = {}\n        for _, v in next, players:GetPlayers() do\n            if v ~= local_player and local_player.Character and v.Character and v.Character:FindFirstChild(\"Humanoid\") and v.Character.Humanoid.Health > 0 and (v.Character:GetPivot().Position - local_player.Character:GetPivot().Position).Magnitude < settings.max_distance then\n                table.insert(targets, v.Character)\n            end\n        end\n\n        for _, v2 in next, targets do\n            local tool = local_player.Character and local_player.Character:FindFirstChildOfClass(\"Tool\")\n            if tool and tool:FindFirstChild(\"Handle\") and v2:FindFirstChildWhichIsA(\"BasePart\") then\n                tool:FindFirstChild(\"Use\"):FireServer()\n                firetouchinterest(tool.Handle, v2:FindFirstChildWhichIsA(\"BasePart\"), 0)\n                firetouchinterest(tool.Handle, v2:FindFirstChildWhichIsA(\"BasePart\"), 1)\n                task.wait()\n            end\n        end\n        task.wait()\n    until not settings.swing_aura\nend","features":"Made by @kylosilly\nMUST HOLD SWORD TO KILL ALL","tags":["Player Battle Tycoon","kill all","kill aura","script","troll"],"discord":"","keyLink":"","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:56:28.962Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6845b3cb887257f460408774","editBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","status":"offline","id":"677be435ea4516cd66668ea7"},"message":"Create script","createdAt":"2025-06-08T16:01:15.056Z"}],"comments":[{"_id":"684dbf7ba348d24efdfd1ff2","commentBy":{"_id":"684db7d4059a9781e0227f1e","username":"lovevenezi","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2025-06-14T17:56:36.017Z","lastActive":"2025-06-29T09:14:35.619Z","status":"offline","id":"684db7d4059a9781e0227f1e","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"lmao the emulator i use crashes from using this, had to manually lower the max distance to like 500","edited":fal