on! Thank you for the note!","parent":{"_id":"69cfd4d197c9ecc399d879a2","commentBy":{"_id":"69cfd40916e15a8c067d2107","username":"vftvgf0","profilePicture":"/images/user-default.webp","status":"offline","id":"69cfd40916e15a8c067d2107"},"text":"@FullStackRacks good script but the auto collect does not work and erm can u add like auto diamonds l"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-03T21:59:00.181Z","liked":false,"disliked":false}]},{"slug":"2-Player-Battle-Tycoon-Kill-All-41912","_id":"6845b3cb887257f460408772","title":"Kill All","game":{"_id":"6845b3cb887257f46040876f","gameId":116682722075937,"name":"2 Player Battle Tycoon","imageUrl":"/images/sb/rbx-7924ea31f9e3509bf26851e228c0418c-25f8d74d1e43.png","placeId":116682722075937},"features":"Made by @kylosilly\nMUST HOLD SWORD TO KILL ALL","tags":["Player Battle Tycoon","kill all","kill aura","script","troll"],"script":"local players = game:GetService(\"Players\")\n\nlocal local_player = players.LocalPlayer\n\ngetgenv().settings = {\n    swing_aura = true,\n    max_distance = 9e9\n}\n\nif settings.swing_aura then\n    repeat\n        local targets = {}\n        for _, v in next, players:GetPlayers() do\n            if v ~= local_player and local_player.Character and v.Character and v.Character:FindFirstChild(\"Humanoid\") and v.Character.Humanoid.Health > 0 and (v.Character:GetPivot().Position - local_player.Character:GetPivot().Position).Magnitude < settings.max_distance then\n                table.insert(targets, v.Character)\n            end\n        end\n\n        for _, v2 in next, targets do\n            local tool = local_player.Character and local_player.Character:FindFirstChildOfClass(\"Tool\")\n            if tool and tool:FindFirstChild(\"Handle\") and v2:FindFirstChildWhichIsA(\"BasePart\") then\n                tool:FindFirstChild(\"Use\"):FireServer()\n                firetouchinterest(tool.Handle, v2:FindFirstChildWhichIsA(\"BasePart\"), 0)\n                firetouchinterest(tool.Handle, v2:FindFirstChildWhichIsA(\"BasePart\"), 1)\n                task.wait()\n            end\n        end\n        task.wait()\n    until not settings.swing_aura\nend","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":"/images/photo/677be435ea4516cd66668ea7-1749212341564.png","status":"offline","id":"677be435ea4516cd66668ea7","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":20772,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-7924ea31f9e3509bf26851e228c0418c-25f8d74d1e43.png","likeCount":6,"dislikeCount":2,"createdAt":"2025-06-08T16:01:15.054Z","executes":3344,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6845b3cb887257f460408774","editBy":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","status":"offline","id":"677be435ea4516cd66668ea7"},"message":"Create script","createdAt":"2025-06-08T16:01:15.056Z"}],"comments":[{"_id":"684dbf7ba348d24efdfd1ff2","commentBy":{"_id":"684db7d4059a9781e0227f1e","username":"lovevenezi","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-06-14T17:56:36.017Z","lastActive":"2025-06-29T09:14:35.619Z","status":"offline","id":"684db7d4059a9781e0227f1e"},"text":"lmao the emulator i use crashes from using this, had to manually lower the max distance to like 500","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-06-14T18:29:15.635Z","liked":false,"disliked":false}]}]}