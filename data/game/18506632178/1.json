n)\n        print(\"Teleported to: \" .. tostring(teleportPosition))\n    else\n        warn(\"Character or HumanoidRootPart not found!\")\n    end\nend\n\n-- Toggle for Auto Teleport\nTab:AddToggle({\n    Name = \"Auto Teleport\",\n    Default = false,\n    Callback = function(state)\n        autoTeleportEnabled = state\n        print(\"Auto Teleport is \" .. (state and \"enabled\" or \"disabled\"))\n\n        -- Start auto-teleport if enabled\n        while autoTeleportEnabled do\n            teleportPlayer()\n            wait(1)  -- Teleport interval (1 second)\n        end\n    end\n})\n\n-- Add a button for manual teleport\nTab:AddButton({\n    Name = \"Teleport\",\n    Callback = function()\n        teleportPlayer()\n    end    \n})\n\n-- Initialize the UI\nOrionLib:Init()","owner":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","verified":false,"profilePicture":"/images/photo/6570eb9b5d75332ca0540983-1738547621153.png","status":"offline","id":"6570eb9b5d75332ca0540983","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"keyLink":"","views":118561,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-08-16T15:59:39.388Z","dislikeCount":1,"likeCount":3,"image":"https://tr.rbxcdn.com/c8768638cd7d1b8aa997d2e46572561e/500/280/Image/Jpeg","executes":2,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4c9fe","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","status":"offline","id":"6570eb9b5d75332ca0540983"},"message":"Create script","createdAt":"2024-08-17T03:25:00.851Z"},{"_id":"67e5e1e3b360710ec3c4c9ff","editBy":{"_id":"6570eb9b5d75332ca0540983","username":"AdorbsxVibesPr3ppy","status":"offline","id":"6570eb9b5d75332ca0540983"},"message":"Update script","createdAt":"2024-08-17T03:34:35.509Z"},{"_id":"67e5e1e3b360710ec3c4ca00","editBy":{"_id":"6570eb9b5d75332ca0