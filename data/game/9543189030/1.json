, v in pairs(char:GetDescendants()) do\n                if v:IsA(\"BasePart\") and v.CanCollide == true then\n                    v.CanCollide = false\n                end\n            end\n        end\n    end)\nend\n\nlocal function disableNoclip()\n    if noclipConn then\n        noclipConn:Disconnect()\n        noclipConn = nil\n    end\nend\n\nlocal function tp(pos)\n    local char = game.Players.LocalPlayer.Character\n    if char and char:FindFirstChild(\"HumanoidRootPart\") then\n        char:MoveTo(pos.Position + Vector3.new(0, 3, 0))\n    end\nend\n\nwindow:Toggle(\"Out Find Cans!\", false, function(state)\n    running = state\n    if running then\n        enableNoclip()\n        while running do\n            local cansFolder = workspace:FindFirstChild(\"Cans\") or workspace:FindFirstChild(\"CanLocations\") or workspace:FindFirstChild(\"Collectibles\")\n            if cansFolder then\n                for _, can in pairs(cansFolder:GetDescendants()) do\n                    if not running then break end\n                    if can:IsA(\"BasePart\") or can:IsA(\"Model\") then\n                        local player = game.Players.LocalPlayer\n                        local alreadyFound = false\n\n                      \n                        if player:FindFirstChild(\"PlayerScripts\") and player.PlayerScripts:FindFirstChild(\"FoundCans\") then\n                            if player.PlayerScripts.FoundCans:FindFirstChild(can.Name) then\n                                alreadyFound = true\n                            end\n                        end\n\n                        if not alreadyFound then\n                            local target = can:IsA(\"Model\") and can:FindFirstChildWhichIsA(\"BasePart\") or can\n                            if target then\n                                tp(target)\n                                wait(0.8)\n                            end\n                        end\n                    end\n                end\n            end\n            wait(3)\n        end\n        disableNoclip()\n    else\n        disableNoclip()\n    end\nend)","features":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\n\nFeature \n\n• Out find All Cans ( RLPVT )\n• While finding Out Inable Noclip ( Helps to Get all )\n\nUi liblary used ( G2GUI Liblary )( Made By me ! )\n\nDon't forget leave a like or Follow 😄","tags":["Find the Cans","Out find Cana","Out find cans","GGUI LIBLARY","Helper script"],"discord":"","keyLink":"","owner":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d37dc0cd827a226c8e89ef84a9232ddb4a5c5847d9cb0f0bdb0643915a73f7aa.webp","original":"https://scriptblox.com/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg"},"status":"offline","id":"6870b2fb95671adabe1b7905","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/d37dc0cd827a226c8e89ef84a9232ddb4a5c5847d9cb0f0bdb0643915a73f7aa.webp","original":"https://scriptblox.com/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:44:45.754Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"688e9182bf96efad2b4fd189","editBy":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","status":"offline","id":"6870b2fb95671adabe1b7905"},"message":"Create script","createdAt":"2025-08-02T22:30:26.827Z"}],"comments":[]},{"_id":"6749ca6360c60244a8e172f0","title":"F1nd All,  Infinite Money [OP!]","game":{"_id":"67e5e1ffb360710ec3c78bc0","gameId":9543189030,"name":"[120] Find The Cans","imageUrl":{"url":"https://media.kocakz.me/42308651aecfe32ae5a31a9056e750c186e7a3e57ed1d9d42e3e41b64b75b076.webp","original":"https://tr.rbxcdn.com/180DAY-2c9fd8da4a2f7c420