-06T22:26:50.157Z","liked":false,"disliked":false}]},{"slug":"PARRY!!-Auto-parry-71658","_id":"692d1a873b5564d64b76aa11","title":"Auto parry","game":{"_id":"67e5e1ffb360710ec3c77f38","gameId":77783763309884,"name":"PARRY!!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":77783763309884},"features":"- auto parry","tags":["Open source","Parry","Parrygame","Keyless"],"script":"local Players = game:GetService(\"Players\")\n\nlocal function setParry(p: Player)\n\n    p:SetAttribute(\"ParryActiveTime\", 10)\n\nend\n\nPlayers.PlayerAdded:Connect(function(p: Player)\n\n    setParry(p)\n\nend)\n\ndo\n\n    local list = Players:GetPlayers() :: {Player}\n\n    for i = 1, #list do\n\n        local p = list[i]\n        setParry(p)\n\n    end\n\nend\n\ntask.spawn(function()\n\n    while true do\n\n        local list = Players:GetPlayers() :: {Player}\n\n        for i = 1, #list do\n\n            local p = list[i]\n            setParry(p)\n\n        end\n\n        task.wait(0.001)\n\n    end\n\nend)\n","owner":{"_id":"690240f159187a591116ad9d","username":"scv8","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9731f7a2d1dce5b704a84b928beba1945f9895b0f775c6a9946c1f631cb4ed7a.webp","original":"https://scriptblox.com/images/photo/690240f159187a591116ad9d-1761755472061.jpg"},"status":"offline","id":"690240f159187a591116ad9d","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/9731f7a2d1dce5b704a84b928beba1945f9895b0f775c6a9946c1f631cb4ed7a.webp","original":"https://scriptblox.com/images/photo/690240f159187a591116ad9d-1761755472061.jpg"}},"verified":false,"views":1141,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8fcf1f099736f8fc552028e9cff2dc868a7f29b9bbacb8ac3db62a73bae59636.webp","original":"https://scriptblox.com/ima