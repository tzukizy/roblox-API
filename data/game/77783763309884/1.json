"createdAt":"2025-12-13T07:16:36.017Z","status":"offline","id":"693d12d4d77d82777cf0686f","profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"text":"Are you dumb?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-30T10:15:51.649Z","liked":false,"disliked":false}]},{"slug":"PARRY!!-Auto-Parry-72246","_id":"6930837310f5ce754192c8ec","title":"Auto Parry","game":{"_id":"67e5e1ffb360710ec3c77f38","gameId":77783763309884,"name":"PARRY!!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":77783763309884},"features":"Auto parry with a % chance (value is 0-1)(default at 85%) of auto parrying customizable within script, also a hotkey to turn the auto parry on/off, key is set as G, changeable within script.","tags":[],"script":"--========================================================--\n--  Handles the G-key toggle\n--========================================================--\n\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n\nlocal toggle = Instance.new(\"BoolValue\")\ntoggle.Name = \"ParryHelperToggle\"\ntoggle.Value = true     -- Script starts ON\ntoggle.Parent = player\n\nUserInputService.InputBegan:Connect(function(input, gp)\n    if gp then return end\n    if input.KeyCode == Enum.KeyCode.G then\n        toggle.Value = not toggle.Value\n        print(\"Parry Script:\", toggle.Value and \"ON\" or \"OFF\")\n    end\nend)\n\n\n--========================================================--\n--========================================================--\n\nlocal Players = game:GetService(\"Players\")\n\n-- Chance to auto-parry (0.0 = 0%, 1.0 = 100%)\nlocal AUTO_PARRY_CHANCE = 0.85 -- change this to customize\n\nPlayers.PlayerAdded:Connect(function(p)\n    p:SetAttribute(\"ParryActiveTime\", 10)\nend)\n\nfor _, p in ipairs(Players:GetPlayers()) do\n    p:SetAttribute(\"ParryActiveTime\", 10)\nend\n\ntask.spawn(function()\n    while true do\n        for _, p in ipairs(Players:GetPlayers()) do\n            local toggle = p:FindFirstChild(\"ParryHelperToggle\")\n            if toggle and toggle.Value == true then\n                -- Random chance check\n                if math.random() <= AUTO_PARRY_CHANCE then\n                    p:SetAttribute(\"ParryActiveTime\", 10)\n                else\n                    p:SetAttribute(\"ParryActiveTime\", 0)\n                end\n            end\n        end\n        task.wait(0.001)\n    end\nend)\n","owner":{"_id":"69092d7c99da269bfd72d0f2","username":"Minakaze","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"69092d7c99da269bfd72d0f2","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":16761,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8b59aafc73df8aa2757930ff8f5c5255c6d92fb22aa23ea05a94f0672f2d0f51.webp","original":"https://scriptblox.com/images/sb/77783763309884-1764787059882.png","scriptblox":"https://scriptblox.com/images/script/77783763309884-1764787059882.png"},"likeCount":6,"dislikeCount":0,"createdAt":"2025-12-03T18:37:39.899Z","executes":957,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T02:36:02.446Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/8b59aafc73df8aa2757930ff8f5c5255c6d92fb22aa23ea05a94f0672f2d0f51.webp","original":"https://scriptblox.com/images/sb/77783763309884-1764787059882.png","scriptblox":"https://scriptblox.com/images/script/77783763309884-1764787059882.png"},"isHub":false,"supportedGame