","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-07-18T10:20:29.187Z","liked":false,"disliked":false},{"_id":"6a5bad2b40b75f2e3dba40e4","commentBy":{"_id":"69d428f136f343ac6478e270","username":"greenscorp","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/cf904fc89989d0951e04fed7a4a1f59f91927f68d3f018080382fa390e94f048.webp","original":"https://scriptblox.com/images/photo/69d428f136f343ac6478e270-1784495445157.png"},"lastActive":"2026-10-10T18:49:11.828Z","createdAt":"2026-04-06T21:43:13.983Z","status":"offline","id":"69d428f136f343ac6478e270","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/cf904fc89989d0951e04fed7a4a1f59f91927f68d3f018080382fa390e94f048.webp","original":"https://scriptblox.com/images/photo/69d428f136f343ac6478e270-1784495445157.png"}},"text":"💪 thanks man","parent":{"_id":"6a5b536d2062591f16b61f86","commentBy":{"_id":"67bd2af297d44a562292ca90","username":"MrpickIe","profilePicture":"/images/photo/67bd2af297d44a562292ca90-1740450595539.jpg","status":"offline","id":"67bd2af297d44a562292ca90"},"text":"good man"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-18T16:43:23.309Z","liked":false,"disliked":false}]},{"_id":"6906ea060b88c79b09c985d3","title":"Hit Counter","game":{"_id":"687bff39296885fe891e637c","gameId":76485985167649,"name":"[DUELS] Advanced Ragdoll Fighting","imageUrl":{"url":"https://media.kocakz.me/ffa79e7b1ef5e33002f285739a79707e2e74efa02f26d0d3dd027a628f6aca67.webp","original":"https://scriptblox.com/images/sb/rbx-c555b81ba9a476e5d0671dc72a5c72d1-11451b670efb.png"},"slug":"76485985167649-advanced-ragdoll-fighting","path":"/game/76485985167649-advanced-ragdoll-fighting","thumbnail":{"url":"https://media.kocakz.me/ffa79e7b1ef5e33002f285739a79707e2e74efa02f26d0d3dd027a628f6aca67.webp","original":"https://scriptblox.com/images/sb/rbx-c555b81ba9a476e5d0671dc72a5c72d1-11451b670efb.png"},"placeId":76485985167649},"slug":"DUELS-Advanced-Ragdoll-Fighting-Hit-Counter-62310","verified":false,"key":false,"keyless":false,"views":6996,"executes":122,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/0e5141882e04be8581a282bc639020a545920c9509efed47ac399062ff9b43c5.webp","original":"https://scriptblox.com/images/sb/76485985167649-1762060806392.webp","scriptblox":"https://scriptblox.com/images/script/76485985167649-1762060806392.webp"},"thumbnail":{"url":"https://media.kocakz.me/0e5141882e04be8581a282bc639020a545920c9509efed47ac399062ff9b43c5.webp","original":"https://scriptblox.com/images/sb/76485985167649-1762060806392.webp","scriptblox":"https://scriptblox.com/images/script/76485985167649-1762060806392.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-11-02T05:20:06.420Z","updatedAt":"2025-11-02T05:20:06.420Z","lastBump":"2025-11-02T05:20:06.420Z","script":"-- do by OpacityB on github (posted by fulinuas on scriptblox) for advanced ragdoll fighting roblox game\n\n-- [DISCLAIMER]\n-- this script not make ur game is power up or bad for other player\n-- just visual script that counts ur hits every 5 seconds\n-- please not cheat for bad targets\n-- tutorial: you can change id of sound\n-- forlasttime its a setting where you can change time from last hit default 5\n\nlocal cfg = {\n\tSoundId = \"rbxassetid://9062373867\",\n\tSoundVolume = 3,\n\tforlasttime = 5,\n\tdebugmode = false,\n\tremoveit = false, -- if you wanna close the script and remove gui\n\tscrguiname = \"CountHits\" -- useful if game detects that gui name [the gui will be recreated if the name from the past is the same] [and don't use the same names as in the player gui you have]\n}\n\nlocal lastcounter = nil\n\nlocal doone = 0\n\nlocal ofalltime = 0\n\nlocal maxdo = 0\n\nlocal twsrvc = game:GetService(\"TweenService\")\n\nif game.Players.LocalPlayer.PlayerGui:FindFirstChild(cfg.scrguiname) then\n\tgame.Players.LocalPlayer.PlayerGui:FindFirstChild(cfg.scrguiname):Remove()\nend\n\nif cfg.removeit then return end\n\nlocal scrgui = Instance.new(\"ScreenGui\")\nscrgui.ResetOnSpawn = false\nscrgui.IgnoreGuiInset = true\nscrgui.Name = cfg.scrguiname\nscrgui.Parent = game.Players.LocalPlayer.PlayerGui\n\nlocal normalsize = UDim2.new(0.092, 0, 0.046, 0)\n\nfunction dosound()\n\tlocal sound = Instance.new(\"Sound\")\n\tsound.SoundId = cfg.SoundId\n\tsound.Parent = scrgui\n\tsound.PlaybackSpeed = 1+math.clamp((doone/20), 0, 0.5)\n\tsound.Volume = cfg.SoundVolume\n\tsound:Play()\n\tsound.Ended:Connect(function()\n\t\tsound:Remove()\n\tend)\nend\n\nfunction dobutton()\n\tlocal button = Instance.new(\"TextButton\")\n\tbutton.Position = UDim2.new(0.5, 0, 0.588, 0)\n\tbutton.Size = normalsize\n\tbutton.AnchorPoint = Vector2.new(0.5,0.5)\n\tbutton.TextColor3 = Color3.fromRGB(255,0,0)\n\tbutton.Font = Enum.Font.RobotoMono\n\tbutton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\n\tbutton.TextScaled = true\n\tbutton.BackgroundTransparency = 0.5\n\tlocal uicorner = Instance.new(\"UICorner\", button)\n\tuicorner.CornerRadius = UDim.new(0.3, 0)\n\treturn button\nend\n\nlocal button1 = dobutton()\nbutton1.Position = UDim2.new(0.448, 0, 0.023, 0)\nbutton1.Size = UDim2.new(0.092, 0, 0.046, 0)\nbutton1.Name = \"Undelete\"\t\nbutton1.Parent = scrgui\nbutton1.Text = maxdo\nlocal button2 = dobutton()\nbutton2.Position = UDim2.new(0.546, 0, 0.023, 0)\nbutton2.Size = UDim2.new(0.092, 0, 0.046, 0)\nbutton2.TextColor3 = Color3.fromRGB(0, 68, 255)\nbutton2.Name = \"Undelete\"\t\nbutton2.Parent = scrgui\nbutton2.Text = ofalltime\n\nfunction docounter()\n\tdoone += 1\n\tofalltime += 1\n\tif maxdo < doone then\n\t\tmaxdo = doone\n\tend\n\tbutton1.Text = maxdo\n\tbutton2.Text = ofalltime\n\tfor i,v in pairs(scrgui:GetChildren()) do\n\t\tif v.Name ~= \"Undelete\" then\n\t\t\tv:Remove()\n\t\tend\n\tend\n\tif lastcounter ~= nil then\n\t\ttask.cancel(lastcounter)\n\tend\n\tlocal button = dobutton()\n\tbutton.Rotation = math.random(-20, 20)\n\tbutton.Text = doone\n\tbutton.TextTransparency = 1\n\tbutton.Size = button.Size + UDim2.new(0.1,0,0.1,0)\n\tbutton.Parent = scrgui\n\tdosound()\n\ttwsrvc:Create(button, TweenInfo.new(0.3), {Size = normalsize, TextTransparency = 0, Rotation = 0}):Play()\n\tlastcounter = task.delay(cfg.forlasttime, function()\n\t\tdoone = 0\n\t\tlastcounter = nil\n\t\ttwsrvc:Create(button, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextTransparency = 1}):Play()\n\t\twait(0.2)\n\t\tbutton:Remove()\n\tend)\nend\nif not cfg.debugmode then\n\tgame.ReplicatedStorage.Remotes.LastCombat.OnClientEvent:Connect(function()\n\t\tdocounter()\n\tend)\nend\n\nspawn(function()\n\twhile wait(1) do\n\t\tif scrgui.Parent == nil then\n\t\t\tscript:Remove()\n\t\tend\n\tend\nend)\n\nif cfg.debugmode then\n\twhile wait(0.5) do\n\t\tdocounter()\n\tend\nend","features":"ITS A VISUAL SCRIPT DO NOT FOR BAD PURPOSES","tags":[],"discord":"","keyLink":"","owner":{"_id":"67fbb054b995d7900d72e121","username":"fulinuas","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67fbb054b995d7900d72e121","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:34:17.518Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6906ea060b88c79b09c985d5","editBy":{"_id":"67fbb054b995d7900d72e121","username":"fulinuas","status":"offline","id":"67fbb054b995d7900d72e121"},"message":"Create script","createdAt":"2025-11-02T05:20:06.427Z"},{"_id":"6906eee816a5eeb3ccb4984f","editBy":{"_id":"67fbb054b995d7900d72e121","username":"fulinuas","status":"offline","id":"67fbb054b995d7900d72e121"},"message":"Update script","createdAt":"2025-11-02T05:40:56.672Z"}],"commen