 Username\n\nUse Player.DisplayName not Player.Name.\nNameToBase(TargetName) -> Target's Base Model Object","tags":[],"script":"local function NameToBase(TargetName)\n\tlocal Bases = workspace.Map.Bases:GetChildren()\n\tfor i, Base in pairs(Bases) do\n\t\tlocal Interactables = Base.Interactables\n\t\tlocal Sign = Interactables.Sign\n\t\tlocal SignText = Sign:FindFirstChild(\"TextLabel\", true).Text\n\t\tlocal OwnerName = string.match(SignText, \"(.*)'s\")\n\t\tif OwnerName == TargetName then\n\t\t\treturn Base\n\t\tend\n\tend\nend\n-- Example Usage\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal MyBase = NameToBase(LocalPlayer.DisplayName)\nif MyBase then\n\tLocalPlayer.Character.PrimaryPart.CFrame = MyBase.SpawnPart.CFrame\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11027083}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://cdn.kocakz.me/images/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"verified":true,"views":103132,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/677f9841cf6fdfbcfe48b01c4d89bb7d805c984866e088f390c7b90fe6880510.webp","original":"https://scriptblox.com/images/sb/rbx-2915c41702093b0da32c076628b6ad8a-059716bc07c2.png","scriptblox":"https://scriptblox.com/images/script/rbx-2915c41702093b0da32c076628b6ad8a-059716bc07c2.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2025-08-23T02:25:47.044Z","editBy":{"_id":