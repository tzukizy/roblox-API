{"id":132732553183665,"name":"[UPDATE] Hanma Battlegrounds","desc":"","path":"/game/132732553183665-update-hanma-battlegrounds","slug":"132732553183665-update-hanma-battlegrounds","thumbnail":["https://tr.rbxcdn.com/180DAY-8c2874f610e992cb3525c52495a4c680/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-9e1b46f8d8cdbe2cc524437218d19a76/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":27,"visitor":0,"verified":false,"updatedAt":"2026-04-08T01:30:02.954Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"UPDATE-Hanma-Battlegrounds-NO-DASH-COOLDOWN-HANMA-BG-193839","_id":"69d5af9a362501347b4d3dff","title":"NO DASH COOLDOWN HANMA BG","game":{"_id":"69d5af9a362501347b4d3dfc","gameId":132732553183665,"name":"[UPDATE] Hanma Battlegrounds","imageUrl":"/images/sb/rbx-9e1b46f8d8cdbe2cc524437218d19a76-2ce917bd37f0.png","placeId":132732553183665},"features":"NO DASH COOLDOWN\n\n\nps made with volt","tags":[],"script":"-- NO DASH COOLDOWN (CharacterServer Client Bypass)\n-- Targets the \"G2.cfolder\" cooldown system\n\nlocal LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n\n-- 1. Immediate Cleanup Loop\n-- This deletes cooldown folders the moment they appear\ntask.spawn(function()\n    while task.wait() do\n        if Character then\n            local side = Character:FindFirstChild(\"SideCooldown\")\n            local main = Character:FindFirstChild(\"MainCooldown\")\n            \n            if side then side:Destroy() end\n            if main then main:Destroy() end\n        end\n    end\nend)\n\n-- 2. The \"NoDash\" Attribute Bypass\n-- The script checks for a \"NoDash\" attribute before starting. We force it to false.\nCharacter:SetAttribute(\"NoDash\", false)\nCharacter:GetAttributeChangedSignal(\"NoDash\"):Connect(function()\n    Character:SetAttribute(\"NoDash\", false)\nend)\n\n-- 3. Humanoid State Fix\n-- The script disables dashing if the Humanoid is in certain states. \n-- This keeps the state clean.\nlocal humanoid = Character:FindFirstChildOfClass(\"Humanoid\")\nif humanoid then\n    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)\n    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)\nend\n\nprint(\"Infinite Dash Active: Cooldown Folders Suppressed.\")","owner":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"profilePicture":"/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg","status":"offline","id":"687eba7419599ad33f38a3db","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1112,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-9e1b46f8d8cdbe2cc524437218d19a76-2ce917bd37f0.png","likeCount":1,"dislikeCount":1,"createdAt":"2026-04-08T01:30:02.956Z","executes":216,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d5af9a362501347b4d3e02","editBy":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","status":"offline","id":"687eba7419599ad33f38a3db"},"message":"Create script","createdAt":"2026-04-08T01:30:02.960Z"}],"comments":[{"_id":"69d67e0cc5616c48d5f6c04a","commentBy":{"_id":"69d67d66ebac61a49fa76d6a","username":"imagineexploiting_","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-05-04T15:22:23.372Z","createdAt":"2026-04-08T16:08:06.935Z","status":"offline","id":"69d67d66ebac61a49fa76d6a"},"text":"hi i patched it 😂😂😂😂 thanks","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-08T16:10:52.586Z","liked":false,"disliked":false},{"_id":"69d6df51e52e8dc73f917b13","commentBy":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"role":"user","profilePicture":"/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg","createdAt":"