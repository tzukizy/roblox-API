ost xd","createdAt":"2024-04-04T17:13:10.110Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"660f27b3d685fc579f4909ce","commentBy":{"_id":"6343eb93bc30ce3275586d17","username":"Netflix","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"createdAt":"2022-10-10T09:53:23.509Z","lastActive":"2026-08-15T22:48:32.141Z","status":"offline","id":"6343eb93bc30ce3275586d17","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"text":"ah yes thats better, does it work with the new remote haze3mn made tho? @Pryxo","createdAt":"2024-04-04T22:20:35.667Z","edited":true,"likeCount":1,"liked":false,"disliked":false}]},{"slug":"player-rng-(testing)-Auto-Roll-and-delete-11938","_id":"660cce702403d0a2cda5e2cf","title":"Auto Roll and delete","game":{"_id":"67e5e1ffb360710ec3c77f31","gameId":16953799253,"name":"player rng 🎲 (testing)","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":16953799253},"features":"auto rolls character and auto deletes the character if it is not a Mythic (highest rarity i think)","tags":["auto","farm","script","roll"],"script":"getgenv().autodelete = true -- set to false if you dont want to auto delete\ngetgenv().autoopen = true -- set to false if you dont want to auto open\ntask.spawn(function()\n    while true do wait()\n        if not getgenv().autodelete then\n            break\n        end\n        for i,v in pairs(game:GetService(\"Players\").LocalPlayer.PlayerGui.ScreenGui.Inventory.ScrollingFrame:GetChildren()) do\n            if v.Name == \"PlayerCard\" then\n                for i,v in pairs(v:GetChildren()) do\n                    if v.Name == \"Rarity\" and v.Text ~= \"Mythic\" then\n                        local lol = v.Parent.Info.Id.Text\n                        local hi = string.sub(lol, 2)\n                        local num = tonumber(hi)\n                        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"DeleteCard\"):FireServer(num)\n                        \n                        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"GetInventory\"):InvokeServer()\n                        \n                    end\n                end\n            end\n        end\n    end\nend)\ntask.spawn(function()\n    while true do wait()\n        if not getgenv().autoopen then\n            break\n        end\n        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"OpenPack\"):InvokeServer()\n    end\nend)","owner":{"_id":"65cab8a936298c448d25553e","username":"yofriendfromschool1","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/57fb4c2fb1ae584c3d119930eeb8e5b68213b1018624bab4f9ac1e5df8a64b88.webp","original":"https://scriptblox.com/images/photo/65cab8a936298c448d25553e-1710155357737.png"},"status":"offline","id":"65cab8a936298c448d25553e","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/57fb4c2fb1ae584c3d119930eeb8e5b68213b1018624bab4f9ac1e5df8a64b88.webp","original":"https://scriptblox.com/images/photo/65cab8a936298c448d25553e-1710155357737.png"}},"verified":false,"keyLink":"","views":12244,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-04-03T03:35:12.382Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/38109d0f45ee498a63187540a59372ece82d7601f366fbdc23a65e9411972ee3.webp","original":"https://scriptblox.com/images/sb/16953799253-1712115312341.webp","scriptblox":"https://scriptblox.com/images/script/16953799253-1712115312341.webp"},"executes":11,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":