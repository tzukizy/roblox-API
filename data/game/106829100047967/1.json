art\")\n                if hrp then\n                    hrp.AssemblyLinearVelocity = Vector3.zero\n                    hrp.CFrame = CFrame.new(pos + Vector3.new(0, offsetY, 0))\n                end\n            end\n        end\n        task.wait(delayTP)\n    end\nend)\n\nbotao.MouseButton1Click:Connect(function()\n    ativo = not ativo\n    botao.Text = ativo and \"ON\" or \"OFF\"\n    botao.BackgroundColor3 = ativo and Color3.fromRGB(0,170,0) or Color3.fromRGB(170,0,0)\nend)\n\nloadstring(game:HttpGet(\"https://pastebin.com/raw/3UF7Y1dF\"))()","owner":{"_id":"690fbe3a34128879dd39fe97","username":"afk0830","verified":false,"profilePicture":"/images/photo/690fbe3a34128879dd39fe97-1776480597223.png","status":"offline","id":"690fbe3a34128879dd39fe97","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":836,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/106829100047967-1775478435247.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-04-06T12:27:15.261Z","executes":140,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d3a6a3829ee6854846cf1a","editBy":{"_id":"690fbe3a34128879dd39fe97","username":"afk0830","status":"offline","id":"690fbe3a34128879dd39fe97"},"message":"Create script","createdAt":"2026-04-06T12:27:15.263Z"}],"comments":[]},{"slug":"+1-IQ-Every-Step-auto-level-up-and-clear-walls-186360","_id":"69d1e8fc16e15a8c06aa7099","title":"auto level up and clear walls","game":{"_id":"69ccafab16e15a8c06441d98","gameId":106829100047967,"name":"+1 IQ Every Step  🧠[UPD]","imageUrl":"/images/sb/rbx-f82810d831ebc1db92432c45533986c4-d81ccfbbc19b.png","placeId":106829100047967},"features":"auto level up and clear walls","tags":[],"script":"loadstring(game:HttpGet(\"https://pastebin.com/raw/3UF7Y1dF\"))()","owner":{"_id":"69566f58ef5a9b718f4420dd","username":"mrcow","verified":false,"profilePicture":"/images/user-default.webp","status":"offline