{"id":1997193809,"name":"Backpacking ⛺🐻","desc":"[⛵ Boats Update is Live! Grab your boat, take to the water and explore the world of Backpacking like never before!]\n\nWelcome to Backpacking - an open world camping and roleplay game! \n\nDrive, hike & backpack through immersive scenery and pitch your tent. Enjoy fishing, kayaking, gliding, the wilderness awaits.\n\nBe sure to like the game if you enjoyed for more updates in the future!\n\nDevelopers: Opplo & Simoon68","path":"/game/1997193809-backpacking","slug":"1997193809-backpacking","thumbnail":{"url":"https://cdn.kocakz.me/images/e4a8fae9413c1a8c6b97a2ed92383f80349936a59a153f7e803a938c77f1e133.webp","original":"https://tr.rbxcdn.com/180DAY-612f785f043d247da6c33f562c96aa02/150/150/Image/Png/noFilter"},"playing":242,"visitor":339262082,"verified":false,"updatedAt":"2025-10-13T12:28:09.656Z","creator":{"name":"Abracadabra","type":"Group"},"script":{"count":3,"freeCount":3,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Backpacking-Auto-get-Marshmello-58195","_id":"68ecf059d228e17ce6e8d2e1","title":"Auto get Marshmello","game":{"_id":"67e5e1ffb360710ec3c77fce","gameId":1997193809,"name":"Backpacking ⛺🐻","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":1997193809},"features":"I suggest you be careful and use a private room to avoid being hit by a kick room","tags":[],"script":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\nrepeat task.wait() until not not workspace.Scenery.Chests.ChestObjects == true\n\nlocal ChestObjects = workspace.Scenery.Chests.ChestObjects\n\nlocal _lt\nlocal _ts = game:GetService('TweenService')\nlocal _lp = game.Players.LocalPlayer\nlocal _hr = (_lp.Character or _lp.CharacterAdded:Wait()):FindFirstChild('HumanoidRootPart')\n\nif not not _hr == false then for _ = 1, 5 do task.wait(1) if _ == 5 and not not _hr == false then return end end end\n\nlocal function tweenTo(_CFrame, _Duration, _Player)\n    _lt = _ts:Create(_Player, TweenInfo.new(_Duration, Enum.EasingStyle.Linear), {CFrame = _CFrame})\n    _lt:Play()\n    _lt.Completed:Wait()\n    task.wait(.5)\nend\n\nlocal _nCF = CFrame.new\n\nlocal function RUNN3R()\n    for _, v in next, ChestObjects:GetDescendants() do\n        if v.Name == 'Hitbox' and v.ClassName == 'Part' then\n            _hr.CFrame = _nCF(v.CFrame.X, v.CFrame.Y + 80, v.CFrame.Z)\n            tweenTo(v.CFrame, 6, _hr)\n        end\n    end\n    RUNN3R('#1485')\nend;RUNN3R('#1485') ","owner":{"_id":"68d07fba78bea65d9e7ed4a7","username":"Xpchloe","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f114a3019635971a763fc7d2692f71e25f936d5aa71a279b0a44714f1f0389fc.webp","original":"https://scriptblox.com/images/photo/68d07fba78bea65d9e7ed4a7-1775976722870.png"},"status":"offline","id":"68d07fba78bea65d9e7ed4a7","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/f114a3019635971a763fc7d2692f71e25f936d5aa71a279b0a44714f1f0389fc.webp","original":"https://scriptblox.com/images/photo/68d07fba78bea65d9e7ed4a7-1775976722870.png"}},"verified":false,"views":1722,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/67868198290bda6428531705f3a89ba507d4b5388ae9f5de075a4ede96efda42.webp","original":"https://scriptblox.com/images/sb/1997193809-1760358489631.webp","scriptblox":"https://scriptblox.com/images/script/1997193809-1760358489631.webp"},"likeCount":1,"dislikeCount":1,"createdAt":"2025-10-13T12:28:09.657Z","executes":641,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:48:38.480Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/67868198290bda6428531705f3