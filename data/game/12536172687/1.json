)()\n        \nend)\n\nTest2:AddToggle(\"auto click duck\",false,function(state)\ngetgenv().click = state\nwhile getgenv().click do\nwait()\nfarm()\n        \nend\nend)","owner":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"650555c42df0a158d6d95c24","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":21276,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-09-21T08:39:45.237Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/12536172687-1695285585138.webp","executes":18,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bcbe","editBy":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","status":"offline","id":"650555c42df0a158d6d95c24"},"message":"Create script","createdAt":"2023-09-22T03:47:32.033Z"},{"_id":"67e5e1e4b360710ec3c4fa5a","editBy":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","status":"offline","id":"650555c42df0a158d6d95c24"},"message":"Update script","createdAt":"2025-03-27T12:10:32.013Z"}],"comments":[{"_id":"650cb728996ae3f4b8c03e97","commentBy":{"_id":"62fd7ab36aee4e6efffb4436","username":"pipe","verified":false,"role":"user","profilePicture":"/images/photo/62fd7ab36aee4e6efffb4436-1693440875038.png","createdAt":"2022-08-17T23:33:07.531Z","lastActive":"2024-05-18T00:27:33.805Z","status":"offline","id":"62fd7ab36aee4e6efffb4436","topMilestone":{"key":"creator.first_script","tier":1}},"text":"bro fix ur blacklist system, we can clearly see, put it in a github and obsfucate it.","createdAt":"2023-09-21T21:35:36.302Z","edited":true,"dislikeCount":0,"likeCount":2,"liked":false,"disliked":false},{"_id":"650d0e49996ae3f4b8c3e5aa","commentBy":{"_id":"650555c42df0a158d6d95c24","username":"firstpilot","verified":false,"role":"user","profilePicture":"/images/user-default.webp","created