{"id":270499015,"name":"[CHRISTMAS] Sandhurst Military Academy Roleplay","desc":"","path":"/game/270499015-christmas-sandhurst-military-academy-roleplay","slug":"270499015-christmas-sandhurst-military-academy-roleplay","thumbnail":["https://tr.rbxcdn.com/180DAY-57574a1fd875cfcba39ab4e11608cd16/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-5b8cac5e0c7a8c1f514ab7df4d210c3a/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":18,"visitor":0,"verified":false,"updatedAt":"2026-05-29T03:02:33.462Z","creator":{"name":"Roblox","type":"User"},"script":{"count":4,"freeCount":4,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"CHRISTMAS-Sandhurst-Military-Academy-Roleplay-BRITISH-ARMY-NO-JUMP-COOLDOWN-OPEN-SOURCE-247574","_id":"69db0a08111606159568410e","title":"BRITISH ARMY NO JUMP COOLDOWN OPEN SOURCE","game":{"_id":"67e5e1ffb360710ec3c78540","gameId":270499015,"name":"[CHRISTMAS] Sandhurst Military Academy Roleplay","imageUrl":"/images/sb/rbx-5b8cac5e0c7a8c1f514ab7df4d210c3a-494cfab04e6d.png","placeId":270499015},"features":"Just no jump cooldown change humanoid.JumpPower value for jump height\n\nEnjoy","tags":["opensource","nojumpcooldown","script","britisharmy","militaryroleplay"],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\n\nlocal function setupCharacter(character)\n    local humanoid = character:WaitForChild(\"Humanoid\")\n\n    humanoid.UseJumpPower = true\n    humanoid.JumpPower = 47\n\n    local canJump = true\n\n    humanoid.StateChanged:Connect(function(_, newState)\n        if newState == Enum.HumanoidStateType.Landed\n        or newState == Enum.HumanoidStateType.Running then\n            canJump = true\n        end\n    end)\n\n    UserInputService.JumpRequest:Connect(function()\n        if not humanoid or not humanoid.Parent then return end\n\n        if canJump and humanoid.FloorMaterial ~= Enum.Material.Air then\n            canJump = false\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end)\nend\n\nif player.Character then\n    setupCharacter(player.Character)\nend\n\nplayer.CharacterAdded:Connect(setupCharacter)","owner":{"_id":"69d1413e4dce27dcfffcceb7","username":"widsfujqa","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69d1413e4dce27dcfffcceb7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1340,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/270499015-1775962632182.webp","likeCount":1,"dislikeCount":0,"createdAt":"2026-04-12T02:57:12.229Z","executes":160,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69db0a081116061595684111","editBy":{"_id":"69d1413e4dce27dcfffcceb7","username":"widsfujqa","status":"offline","id":"69d1413e4dce27dcfffcceb7"},"message":"Create script","createdAt":"2026-04-12T02:57:12.235Z"}],"comments":[{"_id":"69db0a37e40517d77300335c","commentBy":{"_id":"69d1413e4dce27dcfffcceb7","username":"widsfujqa","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-05-31T05:24:44.743Z","createdAt":"2026-04-04T16:50:06.948Z","status":"offline","id":"69d1413e4dce27dcfffcceb7","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Lmk what else you want me to do, don't ask for much though because I am a beginner","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-12T02:57:59.704Z","liked":false,"disliked":false}]},{"slug":"Sandhurst-Military-Academy-Roleplay-Experience-HUB-Millitary-21761","_id":"672a321c2fcf8c979d7c9426","title":"Experience HUB  Millitary","game":{"_id":"67e5e1ffb360710ec3c78540","gameId":270499015,"name":"[CHRISTMAS] Sandhurst Military Academy Roleplay","imageUrl":"/images/sb/rbx-5b8cac5e0c7a8c1f514ab7df4d210c3a-494cfab04e6d.png","placeId":2704