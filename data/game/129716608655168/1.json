ney GUI\"\ntitle.BackgroundTransparency = 1\ntitle.TextColor3 = Color3.new(1,1,1)\ntitle.TextScaled = true\n\n--// Credit\nlocal credit = Instance.new(\"TextLabel\", frame)\ncredit.Size = UDim2.new(1, 0, 0, 20)\ncredit.Position = UDim2.new(0, 0, 1, -20)\ncredit.BackgroundTransparency = 1\ncredit.Text = \"Made by _OpenSource_\"\ncredit.TextColor3 = Color3.fromRGB(180,180,180)\ncredit.TextScaled = true\n\n--// State\n_G.InfMoney = false\n\n--// Button\nlocal btn = Instance.new(\"TextButton\", frame)\nbtn.Size = UDim2.new(1, -20, 0, 50)\nbtn.Position = UDim2.new(0, 10, 0, 45)\nbtn.BackgroundColor3 = Color3.fromRGB(40,40,40)\nbtn.TextColor3 = Color3.new(1,1,1)\nbtn.TextScaled = true\nbtn.Text = \"Inf Money [OFF]\"\n\nInstance.new(\"UICorner\", btn)\n\n--// Function\nbtn.MouseButton1Click:Connect(function()\n    _G.InfMoney = not _G.InfMoney\n    btn.Text = \"Inf Money [\"..(_G.InfMoney and \"ON\" or \"OFF\")..\"]\"\n    \n    task.spawn(function()\n        while _G.InfMoney do\n            local args = {\n                -7e999,\n                \"StraightConveyor\",\n                \"Item1\"\n            }\n            game:GetService(\"ReplicatedStorage\")\n                :WaitForChild(\"Events\")\n                :WaitForChild(\"Shop\")\n                :FireServer(unpack(args))\n            \n            task.wait(0.2)\n        end\n    end)\nend)","features":"inf money. follow me to stay update on my new scripts. also comment on my new scripts which game i should make expoilts for","tags":[],"discord":"","keyLink":"","owner":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","verified":false,"profilePicture":{"url":"https://media.kocakz.me/894d822911f4fa841c1b8eabe2761fb69bfc8b297da7b12d3eb46a3e261b5f0d.webp","original":"https://scriptblox.com/images/photo/67cbc14c6e7623d225a5710a-1773700040553.jpg"},"status":"offline","id":"67cbc14c6e7623d225a5710a","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/894d822911f4