{"id":87551614970185,"name":"Seele's Build and Battle","desc":"","path":"/game/87551614970185-seele-s-build-and-battle","slug":"87551614970185-seele-s-build-and-battle","thumbnail":{"url":"https://cdn.kocakz.me/images/ab333d9a4d8451a559e3bba031d807116c298846626cac0e5641730b1bb3efd4.webp","original":"https://tr.rbxcdn.com/180DAY-26de3a6f3be928df6691f27dc32575c9/150/150/GameIcon2/Png/noFilter"},"playing":0,"visitor":0,"verified":false,"updatedAt":"2026-05-04T03:17:58.349Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Seele's-Build-and-Battle-Auto-Activation-command-211733","_id":"69f80fe6870c399f29040230","title":"Auto Activation command","game":{"_id":"69f80fe6870c399f2904022d","gameId":87551614970185,"name":"Seele's Build and Battle","imageUrl":{"url":"https://cdn.kocakz.me/images/2671da7ab038bd0f8cdf43726a3877f7927156f4d4d8e6e90431d30c4c75893c.webp","original":"https://tr.rbxcdn.com/180DAY-99438a69716f3c7a4334b1d1bd26267d/480/270/GameIcon2/Png/noFilter"},"thumbnail":{"url":"https://cdn.kocakz.me/images/2671da7ab038bd0f8cdf43726a3877f7927156f4d4d8e6e90431d30c4c75893c.webp","original":"https://tr.rbxcdn.com/180DAY-99438a69716f3c7a4334b1d1bd26267d/480/270/GameIcon2/Png/noFilter"},"placeId":87551614970185},"features":"Say :Activate in chat to activate assets such as float parts and antigravity parts and others.","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal function findPlateData()\n\tlocal Plates = workspace:WaitForChild(\"Plates\")\n\tfor _, pf in ipairs(Plates:GetChildren()) do\n\t\tif pf:FindFirstChild(\"Owner\") and pf.Owner.Value == LocalPlayer then\n\t\t\treturn pf:FindFirstChild(\"Plate\"), pf:FindFirstChild(\"ActiveParts\")\n\t\tend\n\tend\n\treturn nil, nil\nend\n\nlocal function fireAll()\n\tlocal _, activeParts = findPlateData()\n\tif not activeParts then return end\n\tlocal count = 0\n\tfor _, desc in ipairs(activeParts:GetDescendants()) do\n\t\tif desc:IsA(\"ClickDetector\") then\n\t\t\tpcall(fireclickdetector, desc)\n\t\t\tcount += 1\n\t\tend\n\tend\n\tprint(\"Fired\", count, \"detectors\")\nend\n\nLocalPlayer.Chatted:Connect(function(msg)\n\tif msg:lower() == \":activate\" then\n\t\ttask.spawn(fireAll)\n\tend\nend)\n\nlocal hookOk, hookErr = pcall(function()\n\tlocal oldNamecall\n\toldNamecall = hookmetamethod(game, \"__namecall\", function(self, ...)\n\t\tlocal method = getnamecallmethod()\n\t\tif method == \"FireServer\" and typeof(self) == \"Instance\" and self.Name == \"SayMessageRequest\" then\n\t\t\tlocal args = {...}\n\t\t\tlocal msg = args[1]\n\t\t\tif type(msg) == \"string\" and msg:lower() == \":activate\" then\n\t\t\t\ttask.spawn(fireAll)\n\t\t\tend\n\t\tend\n\t\treturn oldNamecall(self, ...)\n\tend)\nend)\n\nif not hookOk then\n\tprint(\"Namecall hook unavailable, using Chatted only:\", hookErr)\nend\n","owner":{"_id":"676a26da5d80e059ae78f205","username":"browhat_why","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"676a26da5d80e059ae78f205","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":1417,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-99438a69716f3c7a4334b1d1bd26267d/480/270/GameIcon2/Png/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-99438a69716f3c7a4334b1d1bd26267d/480/270/GameIcon2/Png/noFilter"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-05-04T03:17:58.351Z","executes":97,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:16:51.60