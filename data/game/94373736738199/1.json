{"id":94373736738199,"name":"Blocks Troll Tower","desc":"","path":"/game/94373736738199-blocks-troll-tower","slug":"94373736738199-blocks-troll-tower","thumbnail":["https://tr.rbxcdn.com/180DAY-b49a72e82a9bffc7eb5c4fd74b8aced8/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":0,"visitor":0,"verified":false,"updatedAt":"2025-12-20T05:25:08.798Z","creator":{"name":"Roblox","type":"User"},"script":{"count":3,"freeCount":3,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Blocks-Troll-Tower-killaura-open-src-73236","_id":"693574f45f2af709e2d64909","title":"killaura open src","game":{"_id":"68e164ce7b77b21c6ff87d8f","gameId":94373736738199,"name":"Blocks Troll Tower","imageUrl":"/images/sb/rbx-b49a72e82a9bffc7eb5c4fd74b8aced8-b7d790bfac08.png","placeId":94373736738199},"features":"kills people around when you have weapon equipped (flings them far away)","tags":["opensource","killaura"],"script":"-- by Stonifam\nlocal Players = game:GetService('Players')\nlocal Player = Players.LocalPlayer\n\nlocal function distance(a:BasePart, b:BasePart):number\n    return (a.Position - b.Position).Magnitude\nend\n\nlocal function getChar(plr)\n    plr = plr or Player\n    return plr.Character or plr.CharacterAdded:Wait()\nend\n\nlocal function getRoot(plr:Model):BasePart\n    plr = plr or Player\n    return getChar(plr):WaitForChild('HumanoidRootPart', 1)\nend\n\nlocal function get_closest_players()\n    local closest = {}\n    \n    for _,PLAYER in ipairs(Players:GetPlayers()) do\n        if PLAYER ~= Player then\n            local local_root = getRoot()\n            local target_root = getRoot(PLAYER)\n            if local_root and target_root and distance(local_root, target_root) <= 5 then\n                table.insert(closest, PLAYER)\n            end\n        end\n    end\n\n    return closest\nend\n\nlocal function get_equipped_tool_name()\n    local char = getChar()\n    if char then\n        for _,tool:Tool? in ipairs(char:GetChildren()) do\n            if tool:IsA('Tool') then\n                return tool.Name\n            end\n        end\n    end\nend\n\nwhile true do\n    local closest = get_closest_players()\n    for _,plr in ipairs(closest) do\n        task.spawn(function()\n            game:GetService(\"ReplicatedStorage\").Events.Tools.Touched:FireServer(plr, get_equipped_tool_name(), Vector3.new(math.huge, math.huge, math.huge), 7)\n        end)\n    end\n    game:GetService('RunService').RenderStepped:Wait()\nend","owner":{"_id":"6347f30796ada006e9597233","username":"kosoor2","verified":false,"profilePicture":"/images/photo/6347f30796ada006e9597233-1665660677907.png","status":"offline","id":"6347f30796ada006e9597233","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord.com/invite/NGAaby4y4b","views":961,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-b49a72e82a9bffc7eb5c4fd74b8aced8-b7d790bfac08.png","likeCount":3,"dislikeCount":0,"createdAt":"2025-12-07T12:37:08.087Z","executes":9,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"693574f45f2af709e2d6490b","editBy":{"_id":"6347f30796ada006e9597233","username":"kosoor2","status":"offline","id":"6347f30796ada006e9597233"},"message":"Create script","createdAt":"2025-12-07T12:37:08.089Z"}],"comments":[{"_id":"69357561c9a8b50085b21035","commentBy":{"_id":"65bd3d96cd3cb06a42017957","username":"nick7","verified":false,"role":"user","profilePicture":"/images/photo/65bd3d96cd3cb06a42017957-1752567867592.jpg","createdAt":"2024-02-02T19:08:06.007Z","lastActive":"2026-03-06T20:51:19.671Z","status":"offline","id":"65bd3d96cd3cb06a42017957","topMilestone":{"key":"creator.scripts","tier":25}},"text":"w open source","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-07T12:38:57.549Z","liked":false,"disliked":false}]},{"slug":"Blocks-Troll-Tower-free-product-58403","_id":"68ede41fb