nd\nend\n\nwhile true do\n    local closest = get_closest_players()\n    for _,plr in ipairs(closest) do\n        task.spawn(function()\n            game:GetService(\"ReplicatedStorage\").Events.Tools.Touched:FireServer(plr, get_equipped_tool_name(), Vector3.new(math.huge, math.huge, math.huge), 7)\n        end)\n    end\n    game:GetService('RunService').RenderStepped:Wait()\nend","features":"kills people around when you have weapon equipped (flings them far away)","tags":["opensource","killaura"],"discord":"https://discord.com/invite/NGAaby4y4b","keyLink":"","owner":{"_id":"6347f30796ada006e9597233","username":"kosoor2","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6347f30796ada006e9597233","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:47:29.449Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693574f45f2af709e2d6490b","editBy":{"_id":"6347f30796ada006e9597233","username":"kosoor2","status":"offline","id":"6347f30796ada006e9597233"},"message":"Create script","createdAt":"2025-12-07T12:37:08.089Z"}],"comments":[{"_id":"69357561c9a8b50085b21035","commentBy":{"_id":"65bd3d96cd3cb06a42017957","username":"nick7","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/b9581e3635988a8df42266f4778730d3b833ba55b127fef73cd6425d8684b686.webp","original":"https://scriptblox.com/images/photo/65bd3d96cd3cb06a42017957-1752567867592.jpg"},"createdAt":"2024-02-02T19:08:06.007Z","lastActive":"2026-03-06T20:51:19.671Z","status":"offline","id":"65bd3d96cd3cb06a42017957","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/b95