    \"Iron\",\n           \"Gold\",\n           \"Diamonds\",\n           \"Stone\",\n       }\n   \n       for i,v in pairs(minnerai) do\n           workspace.Events.DataStores.uhoh:FireServer(\"mine\",v)\n       end\n   end\n\n   game.RunService.RenderStepped:Wait()\nend","owner":{"_id":"624b82fe917e7bffd3fc73a1","username":"Chig_Bungus","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/624b82fe917e7bffd3fc73a1-1649116403732.png"},"status":"offline","id":"624b82fe917e7bffd3fc73a1","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/624b82fe917e7bffd3fc73a1-1649116403732.png"}},"verified":false,"views":19408,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-06-02T01:01:58.273Z","dislikeCount":0,"likeCount":4,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://t4.rbxcdn.com/3f3ca0899ed8eded43cd8963596f2fc1","scriptblox":"https://t4.rbxcdn.com/3f3ca0899ed8eded43cd8963596f2fc1"},"executes":279,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:34:45.510Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://t4.rbxcdn.com/3f3ca0899ed8eded43cd8963596f2fc1","scriptblox":"https://t4.rbxcdn.com/3f3ca0899ed8eded43cd8963596f2fc1"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e3d0","editBy":{"_id":"624b82fe917e7bffd3fc73a1","username":"Chig_Bungus","status":"offline","id":"624b82fe917e7bffd3fc73a1"},"message":"Create script","createdAt":"2025-03-27T22:39:26.433Z"}],"comments":[{"_id":"629815d4931019338e20d4f0","commentBy":{"_id":"628c5905697665e447a9b69b","username":"mylegianonzaga","verified":false