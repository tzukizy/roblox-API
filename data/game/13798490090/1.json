{"id":13798490090,"name":"Try to OOF 3 🧩 [+25 LEVELS]","desc":"🧩 Welcome to Try to OOF 3!\n\n🚩 Complete various fun and creative puzzles by oof-ing!\n⏳ Speedrun the game and compete with yourself and your friends to get the best time!\n\nThis game is available on all devices except for VR!\nIf you experience any bugs, please let me know in the community server or on the group wall so I can be sure to fix them!\n🛠️ Join the group: https://www.roblox.com/groups/14391993\n\n✨ This game was heavily inspired by Try To Die and Try To Die Dco!","path":"/game/13798490090-try-to-oof-3","slug":"13798490090-try-to-oof-3","thumbnail":{"url":"https://media.kocakz.me/7ceadf30ecdf233ddd34ddf523ace3e0a9de5ee4ab020264ca90e053686f6340.webp","original":"https://tr.rbxcdn.com/180DAY-33f4ab8a69ede336cc3a0549e34361e5/150/150/Image/Png/noFilter"},"playing":9,"visitor":9610267,"verified":false,"updatedAt":"2024-02-23T10:11:03.888Z","creator":{"name":"EmilioEnito","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"_id":"65d86f374dd2de77c6a0f43b","title":"Skip Level","game":{"_id":"67e5e1ffb360710ec3c78cfc","gameId":13798490090,"name":"Try to OOF 3 🧩 [+25 LEVELS]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"13798490090-try-to-oof-3","path":"/game/13798490090-try-to-oof-3","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":13798490090},"slug":"Try-to-OOF-3-+25-LEVELS-Skip-Level-10800","verified":false,"key":false,"keyless":false,"views":7668,"executes":28,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/d69906fccda39f63f2a89a79e7a38d9aec1dd9efe64c0e415ba72c3877ad4e29.webp","original":"https://scriptblox.com/images/sb/13798490090-1708683063842.webp","scriptblox":"https://scriptblox.com/images/script/13798490090-1708683063842.webp"},"thumbnail":{"url":"https://media.kocakz.me/d69906fccda39f63f2a89a79e7a38d9aec1dd9efe64c0e415ba72c3877ad4e29.webp","original":"https://scriptblox.com/images/sb/13798490090-1708683063842.webp","scriptblox":"https://scriptblox.com/images/script/13798490090-1708683063842.webp"},"likeCount":3,"dislikeCount":0,"createdAt":"2024-02-23T10:11:03.888Z","updatedAt":"2024-02-23T10:11:03.888Z","lastBump":"2024-02-23T10:11:03.888Z","script":"-- Get the player\nlocal player = game.Players.LocalPlayer\n\n-- Function to set the player's health to a specific value\nlocal function setPlayerHealth(healthValue)\n    -- Check if the player's character and Humanoid exist\n    if player.Character and player.Character:FindFirstChild(\"Humanoid\") then\n        -- Set the player's health to the specified value\n        player.Character.Humanoid.Health = healthValue\n    end\nend\n\n-- Call the function and pass the desired health value\nsetPlayerHealth(0)\n\n-- Create a notification\nlocal StarterGui = game:GetService(\"StarterGui\")\nStarterGui:SetCore(\"SendNotification\", {\n    Title = \"skip level done✅\",\n    Text = \"Made by indonesiangamer777\",\n    Duration = 7\n})","features":"Some level dosent work","tags":[],"discord":"","keyLink":"","owner":{"_id":"658ae9c32e331ede73264f5b","username":"indonesiangamer777","verified":false,"profilePicture":{"url":"https://media.kocakz.me/042bdf8b98de069d8562c5a071acf80260f7c4b151418a042ec10a6335a265ea.webp","original":"https://scriptblox.com/images/photo/658ae9c32e331ede73264f5b-1703602787274.jpeg"},"status":"offline","id":"658ae9c32e331ede73264f5b","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/042bdf8b98de069d8562c5a071acf80260f7c4b151418a042ec10a6335a265ea.webp","original":"https://scriptblox.com/images/photo/658ae9c32e331ede73264f5b-1703602787274.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false