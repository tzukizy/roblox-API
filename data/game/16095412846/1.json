ps://raw.githubusercontent.com/shlexware/Orion/main/source')))()\n\nfunction firepp()\n\twhile wait() do\n\t\tfor i,v in pairs(game.Workspace:GetDescendants()) do\n\t\t\tif v:IsA(\"ProximityPrompt\") then\n\t\t\t\tgame.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.Parent.CFrame\n\t\t\t\twait(1)\n\t\t\t\tfireproximityprompt(v) \n\t\t\tend \n\t\tend \n\tend\nend\n\n_G.Debug = false\n\nif not _G.Debug then\n    _G.Window = OrionLib:MakeWindow({Name = \"Beat your meat\", HidePremium = false, SaveConfig = true, ConfigFolder = \"OrionTest\"})\nelseif _G.Debug then\n\t_G.Window = OrionLib:MakeWindow({Name = \"DebugMode\", HidePremium = false, SaveConfig = true, ConfigFolder = \"OrionTest\"})\nend\n\nlocal Tab = _G.Window:MakeTab({\n\tName = \"Stats\",\n\tIcon = \"rbxassetid://4483345998\",\n\tPremiumOnly = false\n})\n\nlocal enabled = false\n\nTab:AddToggle({\n\tName = \"Enable/Disable Coin Farm\",\n\tDefault = false,\n\tCallback = function(v)\n\t\tenabled = v\n\tend\n})\n\nwhile wait() do\n\tif enabled then\n\t\tfirepp()\n\tend\nend","features":"Just a basic coin and Ruby Grabber \n\nAutoclicker recommended if auto proximitypromp fails","tags":[],"discord":"","keyLink":"","owner":{"_id":"64d7b4c9d1f4e43bd1409c14","username":"beriberi","verified":true,"profilePicture":{"url":"https://media.kocakz.me/3b55362c37257a8ca0daddd60c8b6e909ab31c0337846a70960ac13aabb07671.webp","original":"https://scriptblox.com/images/photo/64d7b4c9d1f4e43bd1409c14-1782659742120.jpg"},"status":"offline","id":"64d7b4c9d1f4e43bd1409c14","topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/3b55362c37257a8ca0daddd60c8b6e909ab31c0337846a70960ac13aabb07671.webp","original":"https://scriptblox.com/images/photo/64d7b4c9d1f4e43bd1409c14-1782659742120.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T