{"id":134922313437159,"name":"Another Infection Game","desc":"You wake up and... Don't know where you are.\nIn place with no exit, but all you know that its a failed place of some virus spread.\nExplore, fight, socialize, the choice is yours.\n\n📦Tags: Survival, survive, fight, action, roleplay, virus, infection, neko, furry, creature.","path":"/game/134922313437159-another-infection-game","slug":"134922313437159-another-infection-game","thumbnail":{"url":"https://cdn.kocakz.me/images/3785a99a7eb81be938e8dbe25bcbb483c7653844fcaa09e6968efee59c5c3c62.webp","original":"https://tr.rbxcdn.com/180DAY-12c4ad3ea723628da8783fefe7f30102/150/150/Image/Png/noFilter"},"playing":519,"visitor":32305377,"verified":false,"updatedAt":"2025-12-28T09:20:21.139Z","creator":{"name":"NX-T","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"SNOW-Another-Infection-Game-KillAura-Open-Source-79248","_id":"6950f655cccf728a179344c8","title":"KillAura Open Source","game":{"_id":"6950f655cccf728a179344c5","gameId":134922313437159,"name":"Another Infection Game","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":134922313437159},"features":"Kill Aura\n(combat cooldown is now server-side, no more 'Rapid Kill')","tags":["open source","open src","killaura"],"script":"-- @build-failed\n-- killaura\n\nlocal config = { killaura = true, spamsound = false }\n\nlocal getservice, findfirstchild, waitforchild = game.GetService, game.FindFirstChild, game.WaitForChild\nlocal runservice, players, replicatedstorage = getservice(game, \"RunService\"), getservice(game, \"Players\"), getservice(game, \"ReplicatedStorage\")\nlocal localplayer = players.LocalPlayer\n\nlocal folders = {}\nfolders.remoteFunctions, folders.remoteEvents = waitforchild(replicatedstorage, \"Functions\"), waitforchild(replicatedstorage, \"Events\")\n\nlocal events = {}\nevents.OnWeaponHit, events.OnWeaponUse = waitforchild(folders.remoteFunctions, \"OnWeaponHit\"), waitforchild(folders.remoteEvents, \"OnWeaponUse\")\n\nlocal utils = {}\nfunction utils.getClosestTarget()\n    local closestPlayer = nil\n    local closestDistance = math.huge\n\n    for _, player in players:GetPlayers() do\n\n        if not player then continue end\n        local character = player.Character ; if not character then continue end\n        if player.Team == localplayer.Team then continue end\n        local forcefield = findfirstchild(character, \"ForceField\") ; if forcefield then continue end\n\n\n        local localCharacter = localplayer.Character ; if not localCharacter then continue end\n        local targetRootPart = findfirstchild(character, \"HumanoidRootPart\") ; if not targetRootPart then continue end\n        local localRootPart = findfirstchild(localCharacter, \"HumanoidRootPart\") ; if not localRootPart then continue end\n\n        local targetDistance = (targetRootPart.Position - localRootPart.Position).Magnitude\n        if targetDistance >= closestDistance then continue end\n        closestDistance = targetDistance\n        closestPlayer = player\n    end\n\n    return closestPlayer\nend\n\n-------------------- Main Loop --------------------\n\nif getgenv().killauraConn then getgenv().killauraConn:Disconnect() ; getgenv().killauraConn = nil end\n\ngetgenv().killauraConn = runservice.Heartbeat:Connect(function()\n\n    if not (config.killaura or config.spamsound) then return end\n    local target = utils.getClosestTarget() ; if not target then return end\n\n    --! main code !--\n    local character = target.Character ; if not character then return end\n    local tool = localplayer.Character:FindFirstChildOfClass(\"Tool\") ; if not tool then return end\n\n    if config.spamsound then\n        local Handle = tool:WaitForChild(\"Handle\") ; if not Handle then return end\n        local ItemUsedSound = tool:WaitForChild(\"ItemUsedSound\") ; if not ItemUsedSound then return end\n\n        events.OnWeaponUse:FireServer(\"PlaySound\", ItemUsedSound)\n    end\n\n    if config.killaura then\n        local humanoid = findfirstchild(character, \"Humanoid\") ; if not humanoid then return end\n\n        events.OnWeaponHit:InvokeServer(humanoid, tool)\n    end\nend)\n","owner":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"},"lvl":13,"status":"offline","id":"69295f649aebc6b6d35f1e1f","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"}},"verified":false,"views":2061,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-040a537a2266db11ddc5e62b442cacc6-c06bba2238e4.png","scriptblox":"https://scriptblox.com/images/script/rbx-040a537a2266db11ddc5e62b442cacc6-c06bba2238e4.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-28T09:20:21.141Z","editBy":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","status":"offline","id":"69295f649aebc6b6d35f1e1f"},"keyLink":"","executes":1435,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:40:03.323Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-040a537a2266db11ddc5e62b442cacc6-c06bba2238e4.png","scriptblox":"https://scriptblox.com/images/scri