e":{"_id":"68cd156cd7a3db4456a486de","gameId":13497768806,"name":"Taurus Boxing Gym","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13497768806},"features":"Lets troll the admin\nGame name- Taurus Boxing Game\nGo get em","tags":["Kill all"],"script":"local Players = game:GetService(\"Players\")\nlocal RS = game:GetService(\"ReplicatedStorage\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal PlayerGui = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n-- Create ScreenGui\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = PlayerGui\n\n-- Create Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 200, 0, 50)\nbutton.Position = UDim2.new(0.5, -100, 0.8, 0)\nbutton.Text = \"AUTO KILL ALL: OFF\"\nbutton.BackgroundColor3 = Color3.fromRGB(120, 0, 120)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextSize = 20\nbutton.Parent = screenGui\nbutton.ZIndex = 10\n\n-- Toggle state\nlocal running = false\n\n-- Kill loop\nlocal function killAll()\n    while running do\n        for _, player in ipairs(Players:GetPlayers()) do\n            if player.Character and player.Character:FindFirstChild(\"Humanoid\") then\n                local humanoid = player.Character.Humanoid\n                local args = {\n                    [1] = humanoid,\n                    [2] = \"NormalHit\",\n                    [3] = 10000, -- damage\n                    [4] = \"rbxassetid://11873682035\",\n                    [5] = true,\n                    [6] = false,\n                    [7] = \"Uppercut\"\n                }\n                RS.Damage:FireServer(unpack(args))\n            end\n        end\n        task.wait(0.3) -- repeat every 0.3 sec\n    end\nend\n\n-- Button click toggle\nbutton.MouseButton1Click:Connect(function()\n    running = not running\n    if running then\n        button.Text = \"AUTO KILL ALL: ON\"\n        task.spawn(killAll)\n    else\n        button.Text = \"AUTO KILL ALL: OFF\"\n    end\nend)","owner":{"_id":"669f36b7aecc082311d561e7","username":"CanChangeMyName","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"669f36b7aecc082311d561e7","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":7313,"scriptType":"paid","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-039381a04344ff993bfe07fd6ffd1c79-249ee22e21ab.png","scriptblox":"https://scriptblox.com/images/script/rbx-039381a04344ff993bfe07fd6ffd1c79-249ee22e21ab.png"},"likeCount":1,"dislikeCount":3,"createdAt":"2025-09-19T08:33:48.284Z","executes":36,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:03:16.622Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-039381a04344ff993bfe07fd6ffd1c79-249ee22e21ab.png","scriptblox":"https://scriptblox.com/images/script/rbx-039381a04344ff993bfe07fd6ffd1c79-249ee22e21ab.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68cd156cd7a3db4456a486e3","editBy":{"_id":"669f36b7aecc082311d561e7","username":"CanChangeMyName","status":"offline","id":"669f36b7aecc082311d561e7"},"message":"Create script","createdAt":"2025-09-19T08:33:48.286Z"}],"comments":[{"_id":"68cd16d99dca3952fcbe02a7","commentBy":{"_id":"669f36b7aecc082311d561e7","username":"CanChangeMyName","verified":false,"role":"user","profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"createdAt":"2024-07-23T04:51:03.272Z","la