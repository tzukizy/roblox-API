\"TweenService\")\n                            local distance = (hrp.Position - button.Position).Magnitude\n                            local tween = TweenService:Create(\n                                hrp,\n                                TweenInfo.new(distance/100, Enum.EasingStyle.Linear),\n                                {CFrame = button.CFrame + Vector3.new(0,3,0)}\n                            )\n                            tween:Play()\n                            tween.Completed:Wait()\n                        end\n                    end\n                end\n            end\n\n            task.wait(0.1)\n        end\n    end,\n})\n\nMain:CreateLabel(\"By ROGERRR144\")","features":"Auto Farm Script For + 1 Katana Evolution with options including Tween and Teleport (WIP)","tags":[],"discord":"","keyLink":"","owner":{"_id":"690bdf1187c45311ee589dce","username":"Rogeliocool","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"690bdf1187c45311ee589dce","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:32:53.512Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a5e8e128ccea863d0db2d34","editBy":{"_id":"690bdf1187c45311ee589dce","username":"Rogeliocool","status":"offline","id":"690bdf1187c45311ee589dce"},"message":"Create script","createdAt":"2026-07-20T21:07:30.337Z"}],"comments":[]}]}