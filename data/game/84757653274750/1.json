n\nMain:CreateDropdown({\n    Name = \"Farm Mode\",\n    Options = {\"Teleport\", \"Tween\"},\n    CurrentOption = \"Teleport\",\n    Callback = function(Value)\n        Mode = Value\n    end,\n})\n\nMain:CreateToggle({\n    Name = \"Auto Farm\",\n    CurrentValue = false,\n    Callback = function(Value)\n        Farming = Value\n\n        while Farming do\n            local player = game.Players.LocalPlayer\n            local character = player.Character or player.CharacterAdded:Wait()\n            local hrp = character:FindFirstChild(\"HumanoidRootPart\")\n\n            local folder = workspace:FindFirstChild(\"WinCollectors\")\n            if folder then\n                local stage = folder:FindFirstChild(\"Stage25\")\n                if stage then\n                    local button = stage:FindFirstChild(\"Button\")\n\n                    if button and hrp then\n                        if Mode == \"Teleport\" then\n                            hrp.CFrame = button.CFrame + Vector3.new(0,3,0)\n                        else\n                            local TweenService = game:GetService(\"TweenService\")\n                            local distance = (hrp.Position - button.Position).Magnitude\n                            local tween = TweenService:Create(\n                                hrp,\n                                TweenInfo.new(distance/100, Enum.EasingStyle.Linear),\n                                {CFrame = button.CFrame + Vector3.new(0,3,0)}\n                            )\n                            tween:Play()\n                            tween.Completed:Wait()\n                        end\n                    end\n                end\n            end\n\n            task.wait(0.1)\n        end\n    end,\n})\n\nMain:CreateLabel(\"By ROGERRR144\")","owner":{"_id":"690bdf1187c45311ee589dce","username":"Rogeliocool","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"690bdf1187c45311ee589dce","topMilestone":{"key":"cre