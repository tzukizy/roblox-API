l)\n\t_G.crystalizes = bool\n\twhile _G.crystalizes do\n\t\tfor i = 0, 10 do \n\t\t\tgame:GetService(\"ReplicatedStorage\").Events.Currency:FireServer(1, \"Crystalizes\")\n\t\t\tgame:GetService(\"ReplicatedStorage\").Events.Currency:FireServer(1, \"Crystalizes\")\n\t\tend\n\t\twait()\n\tend\nend)","owner":{"_id":"66a150e24d9f5d255bb8fa70","username":"galaxyfounded","verified":false,"profilePicture":"/images/photo/66a150e24d9f5d255bb8fa70-1726809939026.png","status":"offline","id":"66a150e24d9f5d255bb8fa70","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"keyLink":"","views":43640,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-09-20T09:51:37.889Z","dislikeCount":2,"likeCount":0,"image":"https://tr.rbxcdn.com/2340562fda20367400b5cbcfe993a099/500/280/Image/Jpeg","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52254","editBy":{"_id":"66a150e24d9f5d255bb8fa70","username":"galaxyfounded","status":"offline","id":"66a150e24d9f5d255bb8fa70"},"message":"Create script","createdAt":"2025-03-26T22:24:00.254Z"}],"comments":[{"_id":"66ed61fef534b9b186dc1e88","commentBy":{"_id":"64ec64fa4f538af76763524a","username":"xyrevex","verified":false,"role":"user","profilePicture":"/images/photo/64ec64fa4f538af76763524a-1773045289605.png","createdAt":"2023-08-28T09:12:26.920Z","lastActive":"2026-10-10T04:38:19.973Z","status":"offline","id":"64ec64fa4f538af76763524a","topMilestone":{"key":"creator.scripts","tier":10}},"createdAt":"2024-09-20T11:52:30.947Z","edited":true,"text":"broken script","likeCount":1,"liked":false,"disliked":false}]},{"slug":"Block-Incremental-New-OP-Gui-Script-18393","_id":"66e6f61e42210862014f8002","title":"OP Gui Script","game":{"_id":"67e5e1ffb360710ec3c7882c","gameId":18531870609,"name":"Block Incremental [New🔥]","imageUrl":"https://tr.rbxcdn.com/2340562fda20367400b5cbcfe993a099/500/280/Image/Jpeg","placeId"