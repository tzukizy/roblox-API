ocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Root = Character:WaitForChild(\"HumanoidRootPart\")\n\nlocal ActiveCoins = game:GetService(\"Workspace\"):WaitForChild(\"ActiveCoins\")\n\nlocal AutoCoins = false\n\nlocal Rayfield = loadstring(game:HttpGet(\"https://sirius.menu/rayfield\"))()\n\nlocal Window = Rayfield:CreateWindow({\n    Name = \"coin farm\",\n    LoadingTitle = \"coin farm\",\n    LoadingSubtitle = \"by Metal on Scriptblox\"\n})\n\nlocal Tab = Window:CreateTab(\"main\", 4483362458)\n\nTab:CreateToggle({\n    Name = \"auto coins\",\n    CurrentValue = false,\n    Callback = function(Value)\n        AutoCoins = Value\n\n        if AutoCoins then\n            task.spawn(function()\n                while AutoCoins do\n                    for _,coin in pairs(ActiveCoins:GetChildren()) do\n                        if not AutoCoins then break end\n                        if coin:IsA(\"BasePart\") then\n                            local tween = TweenService:Create(\n                                Root,\n                                TweenInfo.new(0.05, Enum.EasingStyle.Linear),\n                                {CFrame = coin.CFrame}\n                            )\n                            tween:Play()\n                            tween.Completed:Wait()\n                        end\n                    end\n                    task.wait()\n                end\n            end)\n        end\n    end\n})","features":"open sourced\nyea","tags":["op","keyless","open source","auto","coins"],"discord":"https://discord.gg/TR3quUFgT6","keyLink":"","owner":{"_id":"684ed1e0f85943d0727e8335","username":"Metal","verified":false,"profilePicture":{"url":"https://media.kocakz.me/79c351bc8bb75435a24d53dbb8bdfa783b35e3a77ce2dd950d4ebbb1daef06c6.webp","original":"https://scriptblox.com/images/photo/684ed1e0f85943d0727e8335-1766591232749.jpg"},"status":"offline","id":"684ed1e0f85943d0727e8335","leaderboard":{"tag":null},"topMilestone":{"