ge":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-9ac606a950c56824c32b0f4be305e8f5-df760ee085db.png","scriptblox":"https://scriptblox.com/images/script/rbx-9ac606a950c56824c32b0f4be305e8f5-df760ee085db.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-9ac606a950c56824c32b0f4be305e8f5-df760ee085db.png","scriptblox":"https://scriptblox.com/images/script/rbx-9ac606a950c56824c32b0f4be305e8f5-df760ee085db.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-07-31T02:28:51.313Z","updatedAt":"2025-07-31T02:28:51.313Z","lastBump":"2025-07-31T02:28:51.313Z","script":"local rs = game:GetService('RunService')\nlocal plr = game:GetService('Players').LocalPlayer\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal root = char:WaitForChild('HumanoidRootPart', 10)\nlocal box = workspace:WaitForChild('BOX1', 10)\nlocal click = box and box:FindFirstChild('ClickDetector')\nlocal job = workspace:WaitForChild('Job', 10)\nlocal valuestats = plr:WaitForChild('Valuestats', 10)\nlocal wallet = valuestats and valuestats:FindFirstChild('Wallet')\nlocal initialValue = wallet and wallet.Value or 0\nlocal currentValue = initialValue\n\nlocal gui = Instance.new('ScreenGui')\ngui.Parent = plr:WaitForChild('PlayerGui', 10)\ngui.Name = 'MoneyTracker'\ngui.ResetOnSpawn = false\n\nlocal frame = Instance.new('Frame')\nframe.Size = UDim2.new(0, 200, 0, 100)\nframe.Position = UDim2.new(0, 10, 0, 10)\nframe.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\nframe.BorderSizePixel = 2\nframe.Parent = gui\n\nlocal totalLabel = Instance.new('TextLabel')\ntotalLabel.Size = UDim2.new(1, 0, 0.5, 0)\ntotalLabel.Position = UDim2.new(0, 0, 0, 0)\ntotalLabel.BackgroundTransparency = 1\ntotalLabel.TextColor3 = Color3.fromRGB(255, 255, 255)\ntotalLabel.Font = Enum.Font.SourceSansBold\ntotalLabel.TextSize = 20\ntotalLabel.Text = 'Total Money: ' .. currentValue\ntotalLabel.Parent = frame\n\nlocal gainedLabel = Instance.new('TextLabel')\ngainedLabel.Size = UDim2.new(1, 0, 0.5, 0)\ngainedLabel.Position = UDim2.new(0, 0, 0.5, 0)\ngainedLabel.BackgroundTransparency = 1\ngainedLabel.TextColor3 = Color3.fromRGB(0, 255, 0)\ngainedLabel.Font = Enum.Font.SourceSansBold\ngainedLabel.TextSize = 20\ngainedLabel.Text = 'Money Gained: 0'\ngainedLabel.Parent = frame\n\nif click and job and root then\n    rs.Heartbeat:Connect(function()\n        pcall(function()\n            fireclickdetector(click)\n            job.CFrame = root.CFrame\n        end)\n    end)\nend\n\nif wallet then\n    wallet.Changed:Connect(function(newValue)\n        currentValue = newValue\n        totalLabel.Text = 'Total Money: ' .. currentValue\n        gainedLabel.Text = 'Money Gained: ' .. (currentValue - initialValue)\n    end)\nend\n","features":"AI made the UI.\n\nFarms the box job fast.\n\nTS games a huge cashgrab holy","tags":["zins","fast","money","autofarm"],"discord":"","keyLink":"","owner":{"_id":"67e899bd1a59c365c57f9964","username":"zins2","verified":false,"profilePicture":{"url":"https://media.kocakz.me/f22744bd974db016bbe913a084e417ba43fed644dc59ebb6709d42f9ab9bfea5.webp","original":"https://scriptblox.com/images/photo/67e899bd1a59c365c57f9964-1743297346131.png"},"status":"offline","id":"67e899bd1a59c365c57f9964","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/f22744bd974db016bbe913a084e417ba43fed644dc59ebb6709d42f9ab9bfea5.webp","original":"https://scriptblox.com/images/photo/67e899bd1a59c365c57f9964-1743297346131.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:44:51.510Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"688ad4e3cc7800b7edf1f8e5","editBy":{"_id":"67e899bd1a59c365c57f9964","username":"zins2","status":"offline","id":"67e899bd1a59c