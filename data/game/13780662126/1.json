it()\n        end\n    end)\nend\n\nlocal library = loadstring(game:HttpGet(('https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/wall%20v3')))()\n\nlocal w = library:CreateWindow(\"Yeet A Plane Simulator\")\n\nlocal b = w:CreateFolder(\"Main\")\n\nb:Toggle(\"Auto Throw (money yes)\", function(val) getgenv().ThrowPlanes = val ThrowPlanes() end)\nb:Toggle(\"Upgrade\", function(val) getgenv().Upgrade = val Upgrade() end)\nb:Toggle(\"Auto Spin\", function(val) getgenv().AutoSpin = val AutoSpin() end)\n","owner":{"_id":"61e34d8ffdaf2f624a217900","username":"dyanmite","verified":false,"profilePicture":{"url":"https://media.kocakz.me/4d35ef7f5d82a6095e08c64076303bf20e1e27291c7075724243b63cf77bfce2.webp","original":"https://scriptblox.com/images/photo/61e34d8ffdaf2f624a217900-1694631953088.jpg"},"status":"offline","id":"61e34d8ffdaf2f624a217900","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/4d35ef7f5d82a6095e08c64076303bf20e1e27291c7075724243b63cf77bfce2.webp","original":"https://scriptblox.com/images/photo/61e34d8ffdaf2f624a217900-1694631953088.jpg"}},"verified":false,"keyLink":"","views":17107,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-10-15T16:32:49.709Z","dislikeCount":3,"likeCount":2,"image":{"url":"https://media.kocakz.me/5b1ce0ac820b1c9205d4bca1ceac9ea296b77a4dde98f209cdc60fd73dd203b8.webp","original":"https://scriptblox.com/images/sb/13780662126-1697387569530.webp","scriptblox":"https://scriptblox.com/images/script/13780662126-1697387569530.webp"},"executes":29,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:17:22.654Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/5b1ce0ac820b1c9205d4bca1ceac9ea296b77a4dde98f209cdc60fd73dd203b8.webp","original":"https://scriptblox.com/imag