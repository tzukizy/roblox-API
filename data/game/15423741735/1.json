{"id":15423741735,"name":"Bladers: Rebirth","desc":"","path":"/game/15423741735-bladers-rebirth","slug":"15423741735-bladers-rebirth","thumbnail":["https://tr.rbxcdn.com/180DAY-9b1133930acb178c813e440d4b796dfe/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-214bf932eab558689d49832731eedf1b/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":60,"visitor":0,"verified":false,"updatedAt":"2025-11-27T19:02:06.895Z","creator":{"name":"Roblox","type":"User"},"script":{"count":6,"freeCount":6,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Bladers:-Rebirth-Auto-Fight-Trainer-70411","_id":"6928a02e25171dff0421d43d","title":"Auto Fight Trainer","game":{"_id":"67e5e1ffb360710ec3c77de0","gameId":15423741735,"name":"Bladers: Rebirth","imageUrl":"/images/sb/rbx-214bf932eab558689d49832731eedf1b-8ad72515c3b9.png","placeId":15423741735},"features":"execute the code, and when you enter a trainer fight it should win for you if the level gap isn't too high","tags":[],"script":"local RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal Beyblades = workspace:WaitForChild(\"Beyblades\")\nlocal Events = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Events\")\n\ngetgenv().target = nil\n\n-- Detect when a new beyblade spawns\nBeyblades.ChildAdded:Connect(function(v)\n    if v:GetAttribute(\"TargetPlayer\") == LocalPlayer.Name then\n        getgenv().target = v\n        print(\"Target acquired:\", v)\n\n        -- Start attack loop if not already running\n        if not getgenv().attackConnection then\n            getgenv().attackConnection = RunService.Heartbeat:Connect(function()\n                if getgenv().target then\n                    print(\"Attack\")\n                    Beyblades:WaitForChild(LocalPlayer.Name).HumanoidRootPart.CFrame = getgenv().target.HumanoidRootPart.CFrame * CFrame.new(0,5,0)\n                    local args = {\n                        getgenv().target,\n                        1,\n                        vector.create(0,0,0),\n                        Beyblades:WaitForChild(LocalPlayer.Name)\n                    }\n\n                    Events.Attack:FireServer(unpack(args))\n                else\n                    -- Stop loop if target is gone\n                    print(\"No target — stopping attack loop.\")\n                    getgenv().attackConnection:Disconnect()\n                    getgenv().attackConnection = nil\n                end\n            end)\n        end\n    end\nend)\n\n-- Detect when current target despawns\nBeyblades.ChildRemoved:Connect(function(v)\n    if getgenv().target == v then\n        print(\"Target removed:\", v)\n        getgenv().target = nil\n    end\nend)\n","owner":{"_id":"67e47e6748d80c8ce3fdf46e","username":"roninpilot1","verified":false,"profilePicture":"/images/photo/67e47e6748d80c8ce3fdf46e-1764449423225.png","status":"offline","id":"67e47e6748d80c8ce3fdf46e","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":2126,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-214bf932eab558689d49832731eedf1b-8ad72515c3b9.png","likeCount":3,"dislikeCount":0,"createdAt":"2025-11-27T19:02:06.897Z","executes":211,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6928a02e25171dff0421d43f","editBy":{"_id":"67e47e6748d80c8ce3fdf46e","username":"roninpilot1","status":"offline","id":"67e47e6748d80c8ce3fdf46e"},"message":"Create script","createdAt":"2025-11-27T19:02:06.901Z"}],"comments":[{"_id":"6928b19ee72e29dfc7f3b4b2","commentBy":{"_id":"6917d86cdbf217d2da1d2cea","username":"Flup_style_01","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-08-10T18:01:57.061Z","createdAt":"2025-11-15T01:33:32.443Z","status":"offline","id":"6917d86cdbf217d2da1d2cea","topMilestone":{"key":"