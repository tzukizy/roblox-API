{"id":128811184,"name":"🌊Dam Tycoon🌊","desc":"Welcome to Dam Tycoon! 🌊\n\nBuild a Dam 🧱 and explore a big map 🌍. Improve you structure 🔨 to generate money 💰, Purchase generators, turbines, machines for water treatment, power lines, play with the force of water 💧.\n\nOpen or Close the dam to make you tycoon work 🔩⚙ and watch the smooth water flowing through the terrain ⛺. Advance in you business to unlock new places 🧭.\n\nUse the gears from you inventory that you bought from the roblox Marketplace with complete freedom to fight other players 🔪, get powers 🔥, transport... .\n\nBuy you own House 🏡 and roleplay 😜\n\n💾 Tycoon Auto Save 💾\nThis tycoon does not have robux buttons! 🚫\n\nThis game allows the use of gears\nHeavy game for mobile ❗\n\nPM me for any suggestion, ideas ...","path":"/game/128811184-dam-tycoon","slug":"128811184-dam-tycoon","thumbnail":{"url":"https://media.kocakz.me/1aeb19a65a81965ce8a6ecc61027f7167ad6f2744a7f164e103b93bbf531f5ac.webp","original":"https://tr.rbxcdn.com/180DAY-8a32baa5cc61dab09d52be572e86a1f4/150/150/Image/Png/noFilter"},"playing":25,"visitor":7757354,"verified":false,"updatedAt":"2026-07-13T16:18:56.856Z","creator":{"name":"david65","type":"User"},"script":{"count":3,"freeCount":3,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Dam-Tycoon-AutoObby-Dosent-work-after-DogeCoin-242910","_id":"6a550ff00a0aee096e615273","title":"AutoObby","game":{"_id":"67e5e1ffb360710ec3c78928","gameId":128811184,"name":"🌊Dam Tycoon🌊","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":128811184},"features":"Tweak the cd values to your preferences","tags":["autofarm"],"script":"local dest = Vector3.new(-91.1948, 966.2369, -885.9586)\nlocal cd = 1.5\n\nlocal Players = game:GetService(\"Players\")\nlocal plyr = Players.LocalPlayer\n\n-- Create ScreenGui\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"TeleportGui\"\ngui.ResetOnSpawn = false\n\n-- Prefer PlayerGui if available\nlocal playerGui = plyr:WaitForChild(\"PlayerGui\", 5)\ngui.Parent = playerGui or game:GetService(\"CoreGui\")\n\n-- Create Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Name = \"TeleportButton\"\nbutton.Size = UDim2.new(0, 150, 0, 40)\nbutton.Position = UDim2.new(0, 20, 0, 20)\nbutton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextSize = 20\nbutton.Text = \"Teleport: OFF\"\nbutton.Parent = gui\n\nlocal teleporting = false\n\nbutton.MouseButton1Click:Connect(function()\n    teleporting = not teleporting\n    button.Text = teleporting and \"Teleport: ON\" or \"Teleport: OFF\"\nend)\n\ntask.spawn(function()\n    while true do\n        if teleporting then\n            local character = plyr.Character or plyr.CharacterAdded:Wait()\n            local root = character:WaitForChild(\"HumanoidRootPart\")\n            root.CFrame = CFrame.new(dest)\n        end\n        task.wait(cd)\n    end\nend)\n","owner":{"_id":"69875b859c6896f97207d16b","username":"anonymousguycuzyes","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d25a1e6a641ecb9b79cacb8d10742fa301745fe602bc57c234b56c360ac84bb0.webp","original":"https://scriptblox.com/images/photo/69875b859c6896f97207d16b-1770479833276.jpg"},"status":"offline","id":"69875b859c6896f97207d16b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/d25a1e6a641ecb9b79cacb8d10742fa301745fe602bc57c234b56c360ac84bb0.webp","original":"https://scriptblox.com/images/photo/69875b859c6896f97207d16b-1770479833276.jpg"}},"verified":false,"views":380,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/0861de98104006df135e75c67749050628fda01baea7bce6354b65274cf61e8b.webp","original":"https://scriptblox.com/images/sb/rbx-a33f28510c5e0b7e9b2e6b47