{"id":117060103703531,"name":"Arcadia Beta","desc":"Welcome to Arcadia! 🏹\n\nCan you beat every floor? Shop for items, complete quests, level up with your friends!\nGuilds coming soon\n\nHow to play:\n(Q) to Equip swords\n(F) to Dash\n\nThis game is in beta testing, join the group to stay updated!","path":"/game/117060103703531-arcadia-beta","slug":"117060103703531-arcadia-beta","thumbnail":{"url":"https://media.kocakz.me/efe8ac714eaf7d768813b44a4529d4fd4118a8063540faa31b992c34c586f674.webp","original":"https://tr.rbxcdn.com/180DAY-014b2c4f68bae9e0cbc7ed9823096942/150/150/Image/Png/noFilter"},"playing":0,"visitor":105079,"verified":false,"updatedAt":"2025-02-24T13:02:55.334Z","creator":{"name":"Berry Games RP","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Arcadia-Beta-attack-aura-30183","_id":"67bc6dff15d53f6220456ed2","title":"attack aura","game":{"_id":"67e5e1ffb360710ec3c78982","gameId":117060103703531,"name":"Arcadia Beta","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":117060103703531},"features":"attacks any enemy nearby as long as you got a sword","tags":[],"script":"local game = game\nlocal players = game:GetService(\"Players\")\nlocal localPlayer = players.LocalPlayer\nlocal character = localPlayer.Character\nlocal runService = game:GetService(\"RunService\")\n\nrunService.RenderStepped:Connect(function()\n    character = localPlayer.Character\n    local target = nil\n    local distance = 100\n    local tool\n    for _,v in character:GetChildren() do\n        if v:FindFirstChild(\"Damage\") then\n            tool = v\n        end\n    end\n    if tool then\n        for _,v in workspace:GetChildren() do\n            if v:FindFirstChild(\"Mob\") and v:FindFirstChild(\"HumanoidRootPart\") and (v.HumanoidRootPart.CFrame.Position - character.HumanoidRootPart.CFrame.Position).Magnitude < distance then\n                distance = (v.HumanoidRootPart.CFrame.Position - character.HumanoidRootPart.CFrame.Position).Magnitude\n                target = v\n            end\n        end\n    end\n    if target then\n        tool.Damage:FireServer(target)\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"keyLink":"","views":3408,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-24T13:02:55.334Z","dislikeCount":0,"likeCount":3,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-dbb451a504dfe2e7e8ec7fa862403963/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-dbb451a504dfe2e7e8ec7fa862403963/500/280/Image/Jpeg/noFilter"},"executes":25,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:13:41.293Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-dbb451a504dfe2e7e8ec7fa862403963/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-dbb451a504dfe2e7e8ec7fa862403963/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c5519d