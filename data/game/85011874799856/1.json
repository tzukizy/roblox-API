{"id":85011874799856,"name":"Ohio Tools ","desc":"","path":"/game/85011874799856-ohio-tools","slug":"85011874799856-ohio-tools","thumbnail":["https://tr.rbxcdn.com/180DAY-352c493aae9377661bdcaf9b3caeacfa/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-e462a167efa0d3bd442bc703f29101b1/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":1353,"visitor":0,"verified":false,"updatedAt":"2026-09-06T01:41:26.543Z","creator":{"name":"Roblox","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Ohio-Tools-hi-226628","_id":"6a9a2c749c0db0df948e4251","title":"must have laser gun","game":{"_id":"697df8af4bfacc3469b90b41","gameId":85011874799856,"name":"Ohio Tools ","imageUrl":"/images/sb/rbx-e462a167efa0d3bd442bc703f29101b1-0ee867800522.png","placeId":85011874799856},"features":"..","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/monyhh057-dotcom/noa/main/ss.lua\"))()\n","owner":{"_id":"69596585cba6a606924a1dfd","username":"Zaxa1000","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"69596585cba6a606924a1dfd","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":884,"executes":5663,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-e462a167efa0d3bd442bc703f29101b1-0ee867800522.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-09-04T02:27:00.207Z","keyLink":"","keyless":false,"reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-12T13:46:09.488Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a9a2c749c0db0df948e4253","editBy":{"_id":"69596585cba6a606924a1dfd","username":"Zaxa1000","status":"offline","id":"69596585cba6a606924a1dfd"},"message":"Create script","createdAt":"2026-09-04T02:27:00.212Z"}],"comments":[]},{"slug":"Ohio-Tools-Disaster-buttons-96534","_id":"697df8af4bfacc3469b90b44","title":"Disaster buttons","game":{"_id":"697df8af4bfacc3469b90b41","gameId":85011874799856,"name":"Ohio Tools ","imageUrl":"/images/sb/rbx-e462a167efa0d3bd442bc703f29101b1-0ee867800522.png","placeId":85011874799856},"features":"The button has 3 disasters the first one is a train the second one is a plane and the third one is cars pretty nice, Also you can use the script when the game is popular or smth you can use it anytime.","tags":["Disasters"],"script":"print(\"Drop GUI running\")\n\n-- SERVICES\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Camera = workspace.CurrentCamera\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\n\n-- REMOTES\nlocal trainRemote = ReplicatedStorage:WaitForChild(\"DropBlock\")\nlocal planeRemote = ReplicatedStorage:WaitForChild(\"PlaneDrop\")\nlocal carRemote = ReplicatedStorage:WaitForChild(\"SpawnCars\")\n\n-- === FIXED GUI CREATION ===\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"DropGui\"\ngui.ResetOnSpawn = false\ngui.IgnoreGuiInset = true\ngui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\ngui.Parent = playerGui\n\n-- === BUTTON CREATOR ===\nlocal function makeButton(textOff, textOn, pos, offCol, onCol)\n\tlocal b = Instance.new(\"TextButton\")\n\tb.Size = UDim2.new(0, 220, 0, 70)\n\tb.Position = pos\n\tb.Text = textOff\n\tb.TextScaled = true\n\tb.BackgroundColor3 = offCol\n\tb.Active = true\n\tb.Draggable = true\n\tb.Parent = gui\n\n\tlocal enabled = false\n\tb.MouseButton1Click:Connect(function()\n\t\tenabled = not enabled\n\t\tb.Text = enabled and textOn or textOff\n\t\tb.BackgroundColor3 = enabled and onCol or offCol\n\tend)\n\n\treturn function() return enabled end\nend\n\n-- === BUTTONS ===\nlocal trainOn = makeButton(\n\t\"🚆 Train OFF\", \"🚆 Train ON\",\n\tUDim2.new(0.02, 0, 0.60, 0),\n\tColor3.fromRGB(255,80,80), Color3.fromRGB(80,255,80)\n)\n\nlocal planeOn = makeButton(\n\t\"✈️ Plane OFF\", \"✈️ Plane ON\",\n\tUDim2.new(0.02, 0, 0.70, 0),\n\tColor3.fromRGB(80,120,255), Color3.fromRGB(80,255,160)\n)\n\nlocal carOn = makeButton(\n\t\"🚗 Cars OFF\", \"🚗 Cars ON\",\n\tUDim2.new(0.02, 0, 0.80, 0),\n\tColor3.fromRGB(180,180,180), Color3.fromRGB(255,255,80)\n)\n\n-- === RAYCAST FROM SCREEN ===\nlocal function getWorldPos(screenPos)\n\tlocal ray = Camera:ViewportPointToRay(screenPos.X, screenPos.Y)\n\tlocal params = RaycastParams.new()\n\tparams.FilterDescendantsInstances = { player.Character }\n\tparams.FilterType = Enum.RaycastFilterType.Blacklist\n\n\tlocal hit = workspace:Raycast(ray.Origin, ray.Direction * 3000, params)\n\treturn hit and hit.Position\nend\n\n-- === INPUT HANDLER (PC + MOBILE) ===\nUserInputService.InputBegan:Connect(function(input, gp)\n\tif gp then return end\n\tif input.UserInputType ~= Enum.UserInputType.Touch\n\tand input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end\n\n\tlocal worldPos = getWorldPos(input.Position)\n\tif not worldPos then return end\n\n\t-- Train\n\tif trainOn() then\n\t\ttrainRemote:FireServer(worldPos)\n\tend\n\n\t-- Plane\n\tif planeOn() then\n\t\tplaneRemote:FireServer(worldPos)\n\tend\n\n\t-- Cars\n\tif carOn() then\n\t\tcarRemote:FireServer(worldPos)\n\tend\nend)","owner":{"_id":"686059bfc09d53c1e594d338","username":"NULL01","verified":false,"profilePicture":"/images/photo/686059bfc09d53c1e594d338-1753226301925.png","status":"offline","id":"686059bfc09d53c1e594d338","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":3389,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/85011874799856-1769863343447.jpg","likeCount":3,"dislikeCount":1,"createdAt":"2026-01-31T12:42:23.463Z","keyLink":"","executes":378,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"697df8af4bfacc3469b90b47","editBy":{"_id":"686059bfc09d53c1e594d338","username":"NULL01","status":"offline","id":"686059bfc09d53c1e594d338"},"message":"Create script","createdAt":"2026-01-31T12:42:23.465Z"}],"comments":[{"_id":"697df93128b1bd57ab9331c6","commentBy":{"_id":"686059bfc09d53c1e594d338","username":"NULL01","verified":false,"role":"user","profilePicture":"/images/photo/686059bfc09d53c1e594d338-1753226301925.png","createdAt":"2025-06-28T21:08:15.541Z","lastActive":"2026-08-18T14:50:43.886Z","status":"offline","id":"686059bfc09d53c1e594d338","topMilestone":{"key":"creator.followers","tier":10}},"text":":p","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-31T12:44:33.644Z","liked":false,"disliked":false},{"_id":"697df9527a49917a816d402d","commentBy":{"_id":"686059bfc09d53c1e594d338","username":"NULL01","verified":false,"role":"user","profilePicture":"/images/photo/686059bfc09d53c1e594d338-1753226301925.png","createdAt":"2025-06-28T21:08:15.541Z","lastActive":"2026-08-18T14:50:43.886Z","status":"offline","id":"686059bfc09d53c1e594d338","topMilestone":{"key":"creator.followers","tier":10}},"text":"I appreciate if you like it but if not it's okay,","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-31T12:45:06.625Z","liked":false,"disliked":false},{"_id":"697df9d23b83f723070b9d7b","commentBy":{"_id":"686059bfc09d53c1e594d338","username":"NULL01","verified":false,"role":"user","profilePicture":"/images/photo/686059bfc09d53c1e594d338-1753226301925.png","createdAt":"2025-06-28T21:08:15.541Z","lastActive":"2026-08-18T14:50:43.886Z","status":"offline","id":"686059bfc09d53c1e594d338","topMilestone":{"key":"creator.followers","tier":10}},"text":"And also I forgot to mention the controls turn on one of them to spawn it but if you turn all of them on you can go chaos mode","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-31T12:47:14.406Z","liked":false,"disliked":false},{"_id":"697df9e328b1bd57ab933fb2","comment