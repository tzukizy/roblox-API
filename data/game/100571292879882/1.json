on getNearestSnowflake()\n\tlocal nearestPos\n\tlocal shortest = math.huge\n\n\tfor _, obj in ipairs(snowFolder:GetDescendants()) do\n\t\tif obj:IsA(\"Attachment\") then\n\t\t\tlocal pos = obj.WorldPosition\n\t\t\tlocal dist = (hrp.Position - pos).Magnitude\n\n\t\t\tif dist < shortest then\n\t\t\t\tshortest = dist\n\t\t\t\tnearestPos = pos\n\t\t\tend\n\t\tend\n\tend\n\n\treturn nearestPos\nend\n\n-- Loop\ntask.spawn(function()\n\twhile task.wait(0.1) do\n\t\tif not hrp or not hrp.Parent then\n\t\t\tcharacter, hrp = getChar()\n\t\tend\n\n\t\tlocal pos = getNearestSnowflake()\n\t\tif pos then\n\t\t\tlocal tween = TweenService:Create(\n\t\t\t\thrp,\n\t\t\t\tTweenInfo.new(FLY_TIME, Enum.EasingStyle.Linear),\n\t\t\t\t{CFrame = CFrame.new(pos + Vector3.new(0, HEIGHT_OFFSET, 0))}\n\t\t\t)\n\t\t\ttween:Play()\n\t\t\ttween.Completed:Wait()\n\t\tend\n\tend\nend)\n","owner":{"_id":"650ea37b6b50b6b3125b13c4","username":"Supra0027","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/87382f567ac3c1c48ff877b4bfc5cbcfe10d1b6723748eed9ae5df5dac478ad9.webp","original":"https://scriptblox.com/images/photo/650ea37b6b50b6b3125b13c4-1743510090743.jpg"},"status":"offline","id":"650ea37b6b50b6b3125b13c4","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/87382f567ac3c1c48ff877b4bfc5cbcfe10d1b6723748eed9ae5df5dac478ad9.webp","original":"https://scriptblox.com/images/photo/650ea37b6b50b6b3125b13c4-1743510090743.jpg"}},"verified":false,"views":2064,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/f58d9ea302f50690fb561c482ca4762fc4ade3e9243d0afa9dbdf857d46a6bf8.webp","original":"https://scriptblox.com/images/sb/100571292879882-1769444744647.png","scriptblox":"https://scriptblox.com/images/script/100571292879882-1769444744647.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-26T16:25:44.666Z","keyLink":"","executes":100,"keyless":false,"liked"