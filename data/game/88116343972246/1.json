al\"\ntitle.TextColor3 = Color3.fromRGB(200, 200, 255)\ntitle.TextSize = 18\ntitle.Font = Enum.Font.GothamBold\ntitle.Parent = frame\n\n-- Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0.6, 0, 0, 40)\nbutton.Position = UDim2.new(0.2, 0, 0.55, 0)\nbutton.Text = \"Fast Steal\"\nbutton.BackgroundColor3 = Color3.fromRGB(80, 0, 120)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.TextSize = 18\nbutton.Font = Enum.Font.GothamBold\nbutton.Parent = frame\n\nlocal btnCorner = Instance.new(\"UICorner\")\nbtnCorner.CornerRadius = UDim.new(0, 12)\nbtnCorner.Parent = button\n\n-- Button Click\nbutton.MouseButton1Click:Connect(function()\n    local char = player.Character or player.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n\n    -- First Teleport\n    hrp.CFrame = CFrame.new(-1, 3, 0)\n\n    -- Wait 0.05s (50 ms)\n    task.wait(0.05)\n\n    -- Second Teleport\n    hrp.CFrame = CFrame.new(1, 3, -25)\nend)","owner":{"_id":"692afdf818d278e50fb9cc74","username":"TrolyScripts","verified":false,"profilePicture":"/images/photo/692afdf818d278e50fb9cc74-1765106810572.jpg","status":"offline","id":"692afdf818d278e50fb9cc74","topMilestone":{"key":"creator.executions","tier":100000}},"verified":false,"views":628,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/88116343972246-1765117683078.jpg","likeCount":0,"dislikeCount":0,"createdAt":"2025-12-07T14:28:03.088Z","executes":345,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69358ef3d9a0d1f6b398598b","editBy":{"_id":"692afdf818d278e50fb9cc74","username":"TrolyScripts","status":"offline","id":"692afdf818d278e50fb9cc74"},"message":"Made By TrolyScripts (@Pur6leTheTroly) Please Follow On Roblox And Subscribe on Youtube! (Not Begging)","createdAt":"2025-12-07T14:28:03.090Z"}],"comments":[{"_id":"69359010224649acf20194b5","commentBy":{"_id":"69358fab062c3834e23a7a6a"