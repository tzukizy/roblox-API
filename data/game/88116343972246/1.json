n1Click:Connect(function()\n    local char = player.Character or player.CharacterAdded:Wait()\n    local hrp = char:WaitForChild(\"HumanoidRootPart\")\n\n    -- First Teleport\n    hrp.CFrame = CFrame.new(-1, 3, 0)\n\n    -- Wait 0.05s (50 ms)\n    task.wait(0.05)\n\n    -- Second Teleport\n    hrp.CFrame = CFrame.new(1, 3, -25)\nend)","features":"Made By TrolyScripts (@Pur6leTheTroly) Please Follow On Roblox And Subscribe on Youtube! (Not Begging)","tags":[],"discord":"","keyLink":"","owner":{"_id":"692afdf818d278e50fb9cc74","username":"TrolyScripts","verified":false,"profilePicture":{"url":"https://media.kocakz.me/641666006fb463a5435bac7cfa6a4d32f91c19af5c1b3fb8cca8f9bd85b6c0c2.webp","original":"https://scriptblox.com/images/photo/692afdf818d278e50fb9cc74-1765106810572.jpg"},"status":"offline","id":"692afdf818d278e50fb9cc74","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/641666006fb463a5435bac7cfa6a4d32f91c19af5c1b3fb8cca8f9bd85b6c0c2.webp","original":"https://scriptblox.com/images/photo/692afdf818d278e50fb9cc74-1765106810572.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:39:00.100Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69358ef3d9a0d1f6b398598b","editBy":{"_id":"692afdf818d278e50fb9cc74","username":"TrolyScripts","status":"offline","id":"692afdf818d278e50fb9cc74"},"message":"Made By TrolyScripts (@Pur6leTheTroly) Please Follow On Roblox And Subscribe on Youtube! (Not Begging)","createdAt":"2025-12-07T14:28:03.090Z"}],"comments":[{"_id":"69359010224649acf20194b5","commentBy":{"_id":"69358fab062c3834e23a7a6a","username":"Alexander62","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/13ac14374a572dc3e65dd2fb2844436aaa7a717ecf115bc86dd4fbd2f70487f2.webp","original":"https://scriptbl