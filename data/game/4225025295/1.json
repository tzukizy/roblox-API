{"id":4225025295,"name":"[SOON] OP NINJA⚡","desc":"⚔️Welcome to OP NINJA\n\nUPDATE 2.2 IS HERE 🎉\n\n🔥 A new way to earn Honor\n\n⚡ Each swing = +1 Power\n⚔️ Train, fight, and become the stronger\n🐉 Join clans and unlock powerful skills\n🗡️ Collect swords, weapons, auras, wings, and upgrades\n👥 Challenge friends and enemies in the arena\n👑 Become the strongest ninja on the server!\n\n💪 No safe zone. Only strength.\n\n🥷 OP Ninja Simulator\nFast training, +1 power progression, ninja battles, sword fighting, clans, auras, mythical weapons, upgrades, martial arts skills, and arena combat for the ultimate OP ninja experience ⚔️🔥\n\n🌎 Max World Level 90\n\n💬 Community Forums now available","path":"/game/4225025295-soon-op-ninja","slug":"4225025295-soon-op-ninja","thumbnail":["https://tr.rbxcdn.com/180DAY-34e215089d927a6000546ca5d06f20c0/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-cf713ab1fecf4a1bb795f762dbd1b0a5/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":109,"visitor":122351540,"verified":false,"updatedAt":"2026-07-25T11:23:50.103Z","creator":{"name":"OP NINJA STUDIOS","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"GIFTING-+1-OP-NINJA-Simple-Auto-Swing-245450","_id":"6a649cc67756bab5bdd9e426","title":"Simple Auto Swing","game":{"_id":"67e5e1ffb360710ec3c77e06","gameId":4225025295,"name":"[SOON] OP NINJA⚡","imageUrl":"/images/sb/rbx-cf713ab1fecf4a1bb795f762dbd1b0a5-d7d47bad7dbd.png","placeId":4225025295},"features":"Auto Swing Enjoy","tags":["nostalgia"],"script":"getgenv().AutoSwing = true\n\nlocal players = game:GetService(\"Players\")\nlocal runService = game:GetService(\"RunService\")\nlocal lp = players.LocalPlayer\n\nif getgenv().AutoSwingConnection then\n    getgenv().AutoSwingConnection:Disconnect()\n    getgenv().AutoSwingConnection = nil\nend\n\nlocal function fetchRemote()\n    local pGui = lp:FindFirstChild(\"PlayerGui\")\n    local mGui = pGui and pGui:FindFirstChild(\"MainGui\")\n    if not mGui then return nil end\n\n    for _, v in ipairs(mGui:GetChildren()) do\n        if v:IsA(\"RemoteEvent\") and v.Name:match(\"^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$\") then\n            return v\n        end\n    end\n    return nil\nend\n\nlocal targetRemote = fetchRemote()\nlocal seq = 0\n\nif getgenv().AutoSwing then\n    getgenv().AutoSwingConnection = runService.RenderStepped:Connect(function()\n        if not getgenv().AutoSwing then\n            if getgenv().AutoSwingConnection then\n                getgenv().AutoSwingConnection:Disconnect()\n                getgenv().AutoSwingConnection = nil\n            end\n            return\n        end\n\n        if not targetRemote or not targetRemote.Parent then\n            targetRemote = fetchRemote()\n        end\n\n        if targetRemote then\n            local ok = pcall(targetRemote.FireServer, targetRemote, \"SwordSlash\", seq)\n            if ok then\n                seq = seq + 1\n            end\n        end\n    end)\nend","owner":{"_id":"62ca68a7f1c6420928ab0af1","username":"White","verified":false,"profilePicture":"/images/photo/62ca68a7f1c6420928ab0af1-1784978435435.png","status":"offline","id":"62ca68a7f1c6420928ab0af1","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":201,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/4225025295-1784978630104.webp","likeCount":0,"dislikeCount":0,"createdAt":"2026-07-25T11:23:50.134Z","executes":10269,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":10001,"at":"2026-10-03T10:30:04.675Z"}],"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a649cc67756bab5bdd9e428","editBy":{"_id":"62ca68a7f1c6420928ab0af1","username":"White","status":"offline","id":"62ca68a7f1c6420928ab0af1"},"message":"B)","createdAt":"2026-07-25T11:23:50.138Z"}],"comments":[]},{"slug":"OP-NINJA-SIMULATOR-Auto-Train-33054","_id":"67e049ccb364629065ee382c","title":"Auto Train","game":{"_id":"67e5e1ffb360710ec3c77e06","gameId":4225025295,"name":"[SOON] OP NINJA⚡","imageUrl":"/images/sb/rbx-cf713ab1fecf4a1bb795f762dbd1b0a5-d7d47bad7dbd.png","placeId":4225025295},"features":"Auto train","tags":["script","auto train","op ninja simulator"],"script":"--TOGGLES\ngetgenv().autotrain = true -- true for on, false for off\n\n--VARIABLES\nlocal player = game:GetService(\"Players\").LocalPlayer\nlocal char = player.Character\nlocal sword = char:FindFirstChildOfClass(\"Tool\")\n\nfunction train()\n\tif sword then\n\t\tsword:Activate()\n\tend\nend\n\nwhile getgenv().autotrain do\n\ttask.wait()\n\ttrain()\n\tif not getgenv().autotrain then\n\t\tbreak\n\tend\nend","owner":{"_id":"677755b5b19eb392c8c9aff6","username":"icmp","verified":false,"profilePicture":"/images/photo/677755b5b19eb392c8c9aff6-1735874028176.jpg","status":"offline","id":"677755b5b19eb392c8c9aff6","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"keyLink":"","views":11308,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-03-23T17:50:04.436Z","dislikeCount":0,"likeCount":3,"image":"https://tr.rbxcdn.com/180DAY-806cd53cc08d3d9eed3084e809cf0c89/500/280/Image/Jpeg/noFilter","executes":7217,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c55e9c","editBy":{"_id":"677755b5b19eb392c8c9aff6","username":"icmp","status":"offline","id":"677755b5b19eb392c8c9aff6"},"message":"Create script","createdAt":"2025-03-27T23:11:09.217Z"}],"comments":[{"_id":"686fdf095c9b7514ee6fe43d","commentBy":{"_id":"678c32ddbef4a15ae736856a","username":"topyimfwp","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-01-18T23:01:49.544Z","lastActive":"2026-01-08T06:32:49.566Z","status":"offline","id":"678c32ddbef4a15ae736856a","topMile