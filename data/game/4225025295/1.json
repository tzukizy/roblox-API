not targetRemote or not targetRemote.Parent then\n            targetRemote = fetchRemote()\n        end\n\n        if targetRemote then\n            local ok = pcall(targetRemote.FireServer, targetRemote, \"SwordSlash\", seq)\n            if ok then\n                seq = seq + 1\n            end\n        end\n    end)\nend","features":"Auto Swing Enjoy","tags":["nostalgia"],"discord":"","keyLink":"","owner":{"_id":"62ca68a7f1c6420928ab0af1","username":"White","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5c6ae34c9cd5aee2ce9874f8b481dda3bd19efe8d874ea592ddb7d84cab75acb.webp","original":"https://scriptblox.com/images/photo/62ca68a7f1c6420928ab0af1-1784978435435.png"},"status":"offline","id":"62ca68a7f1c6420928ab0af1","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/5c6ae34c9cd5aee2ce9874f8b481dda3bd19efe8d874ea592ddb7d84cab75acb.webp","original":"https://scriptblox.com/images/photo/62ca68a7f1c6420928ab0af1-1784978435435.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:28:59.060Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a649cc67756bab5bdd9e428","editBy":{"_id":"62ca68a7f1c6420928ab0af1","username":"White","status":"offline","id":"62ca68a7f1c6420928ab0af1"},"message":"B)","createdAt":"2026-07-25T11:23:50.138Z"}],"comments":[]},{"_id":"67e049ccb364629065ee382c","title":"Auto Train","game":{"_id":"67e5e1ffb360710ec3c77e06","gameId":4225025295,"name":"[SOON] OP NINJA⚡","imageUrl":{"url":"https://media.kocakz.me/c3cd8313eaf2a8e4dddec5618a5d8c94ca808f2fe25cc5dd4adedf1f5de9e338.webp","original":"https://tr.rbxcdn.com/180DAY-34e215089d927a6000546ca5d06f20c0/150/150/Image/Png/noFilter"},"slug":"4225025295-op-ninja","path":"/game/4225025295-op-ninja","thumbnail":{"url":"https://media.kocakz.me/c3cd8313eaf2a8e