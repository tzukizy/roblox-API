{"id":7541029066,"name":"Squid Game with GUNS","desc":"","path":"/game/7541029066-squid-game-with-guns","slug":"7541029066-squid-game-with-guns","thumbnail":["https://tr.rbxcdn.com/180DAY-d2ccd6b073a541842a261e92f65fec82/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-7f4e4fff7df3746b5838479aa12bbc58/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":27,"visitor":0,"verified":false,"updatedAt":"2025-01-18T08:42:51.659Z","creator":{"name":"Roblox","type":"User"},"script":{"count":4,"freeCount":4,"keyCount":0,"verifiedCount":1},"page":1,"next":null,"total":1,"scripts":[{"slug":"Squid-Game-with-GUNS-Kill-All-27041","_id":"678b698bb05b0036d091a400","title":"Kill All","game":{"_id":"67e5e1ffb360710ec3c77f3c","gameId":7541029066,"name":"Squid Game with GUNS","imageUrl":"/images/sb/rbx-7f4e4fff7df3746b5838479aa12bbc58-0a2337c87214.png","placeId":7541029066},"features":"Looking at another site with scripts, I saw the same script that should kill all players in the game, but it had a key system, so I decided to make my own\n\n*in order for the script to work, you need to equip any weapon","tags":["kill all","kill","farm"],"script":"getgenv().killall = true -- false/true\n\nlocal players = game:GetService(\"Players\")\nlocal plr = players.LocalPlayer\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal function kill(gun, player)\n    if\n        gun and player and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") and\n            player.Character:FindFirstChild(\"Humanoid\")\n     then\n        local a = {\n            [1] = gun,\n            [2] = {\n                [\"p\"] = Vector3.new(184.38491821289062, 80.81703186035156, -31.51180648803711),\n                [\"pid\"] = 1,\n                [\"part\"] = player.Character.HumanoidRootPart,\n                [\"d\"] = 1.7668241262435913,\n                [\"maxDist\"] = 1.7155888080596924,\n                [\"h\"] = player.Character.Humanoid,\n                [\"m\"] = Enum.Material.Plastic,\n                [\"n\"] = Vector3.new(-0.845337986946106, 0, 0.5342320203781128),\n                [\"t\"] = 0.44032757240082787,\n                [\"sid\"] = 1\n            }\n        }\n        ReplicatedStorage:WaitForChild(\"WeaponsSystem\"):WaitForChild(\"Network\"):WaitForChild(\"WeaponHit\"):FireServer(\n            unpack(a)\n        )\n    end\nend\n\nwhile getgenv().killall do\n    for _, p in pairs(players:GetPlayers()) do\n        if not getgenv().killall then\n            break\n        end\n        if p ~= plr then\n            local tool = plr.Character:FindFirstChildOfClass(\"Tool\")\n            if tool then\n                kill(tool, p)\n            end\n        end\n    end\n    wait(0.6)\nend","owner":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","verified":true,"profilePicture":"/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png","status":"offline","id":"61f96cc63ede52bf4f7e299d","leaderboard":{"tag":{"kind":"hall","rank":1,"period":"all","metric":"views","value":17465198}},"topMilestone":{"key":"creator.likes","tier":1000}},"verified":true,"keyLink":"","views":122140,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-18T08:42:51.659Z","dislikeCount":0,"likeCount":1,"image":"https://tr.rbxcdn.com/180DAY-0b4555af0c0c83b6b99f7a92606962b5/500/280/Image/Jpeg/noFilter","executes":126,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54330","editBy":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","status":"offline","id":"61f96cc63ede52bf4f7e299d"},"message":"Create script","createdAt":"2025-03-27T23:09:45.077Z"}],"comments":[{"_id":"678b6bcd93709628930cd383","commentBy":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","verified":true,"role":"admin","profilePicture":"/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png","createdAt":"2022-02-01T17:24