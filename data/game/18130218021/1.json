{"id":18130218021,"name":"Hell's Kitchen","desc":"","path":"/game/18130218021-hell-s-kitchen","slug":"18130218021-hell-s-kitchen","thumbnail":["https://tr.rbxcdn.com/180DAY-09ad85a87706f6c98afddb6326187b91/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/150/150/Image/Jpeg/noFilter","/brand/kocakz-logo.png"],"playing":310,"visitor":0,"verified":false,"updatedAt":"2025-04-08T23:53:15.437Z","creator":{"name":"Roblox","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":1,"verifiedCount":1},"page":1,"next":null,"total":1,"scripts":[{"slug":"Hell's-Kitchen-auto-pantry-and-fridge-34796","_id":"67f5b6eb39e310f562bf8755","title":"auto pantry and fridge","game":{"_id":"67e5e1ffb360710ec3c789ac","gameId":18130218021,"name":"Hell's Kitchen","imageUrl":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter","placeId":18130218021},"features":"Execute when pre-service starts or whenever, should auto collect ingredients from pantry and fridge\n\nIf it stops working simply execute it again.\n\nWIP","tags":["auto","hub","full","free","keyless"],"script":"local LocalPlayer = game:GetService(\"Players\").LocalPlayer\nlocal NextSteps = LocalPlayer.PlayerGui.ScreenGui.NextSteps\nlocal Steps = NextSteps.Steps\nlocal CurrentAction = NextSteps.CurrentAction\n\nlocal function GetCurrentTask()\n    if CurrentAction.Value == 0 then return false end\n    return Steps[tostring(CurrentAction.Value)]\nend\n\nwarn(Action)\nlocal function GetIngredients(CurrentTask)\n    local TempIngredients = CurrentTask.Ingredients:GetChildren()\n    local Ingredients = {}\n    for i,v in pairs(TempIngredients) do\n        if v.ClassName ~= \"Frame\" then continue end\n        local Ingred = v.ViewportFrame:FindFirstChildWhichIsA(\"Model\")\n        if v.Name == \"Ingredient\" and Ingred then\n            table.insert(Ingredients, Ingred.Name)\n        end\n    end\n    return Ingredients\nend\nlocal function GatherIngredient(dum, IngredientName)\ntask.spawn(function()\nlocal args = {\n    [1] = IngredientName\n}\n\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"LocalModules\"):WaitForChild(\"LMKitchen\"):WaitForChild(\"ServerRec\"):WaitForChild(\"ObtainFood\"):InvokeServer(unpack(args))\nend)\nend\n\nwhile wait(.1) do\n    local CurrentTask = GetCurrentTask()\n    local Action = CurrentTask.Action.TextLabel.Text\n    warn(Action)\n    if Action == \"Pantry\" or Action == \"Fridge\" then\n        table.foreach(GetIngredients(CurrentTask), GatherIngredient)\n    end\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":"/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png","status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11013154}},"topMilestone":{"key":"creator.views","tier":10000000}},"verified":true,"views":47277,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter","likeCount":0,"dislikeCount":1,"createdAt":"2025-04-08T23:53:15.437Z","executes":112,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67f5b6eb39e310f562bf8757","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Upload Script","createdAt":"2025-04-08T23:53:15.439Z"}],"comments":[{"_id":"680a6943349aff89e6eac7bf","commentBy":{"_id":"6808f2520fdc5ac55958e442","username":"Albert_Quandale_IV","verified":false,"role":"user","profilePicture":"/images/photo/6808f2520fdc5ac55958e442-1748271951311.jpg","createdAt":"2025-04-23T13:59:46.661Z","lastActive":"2026-09-03T16:40:48.263Z","status":"offline","id":"6808f2520fdc5ac55958e442"},"text":"works exept for one food","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-04-24T16:39:31.626Z","liked":false,"disliked":false},{"_id":"68ef99282f9076378a54047c","commentBy":{"_id":"685c4e82d0113c7678e82730","username":"Ju1ceTheRealest","verified":false,"role":"user","profilePicture":"/images/photo/685c4e82d0113c7678e82730-1759253885763.jpg","createdAt":"2025-06-25T19:31:14.127Z","lastActive":"2026-03-01T18:31:00.277Z","status":"offline","id":"685c4e82d0113c7678e82730"},"text":"still working after 6 months","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-10-15T12:52:56.820Z","liked":false,"disliked":false}]},{"slug":"Hell's-Kitchen-Auto-Farm-And-More-26632","_id":"67831f5dd5339b69480c3f9a","title":"Auto Farm And More","game":{"_id":"67e5e1ffb360710ec3c789ac","gameId":18130218021,"name":"Hell's Kitchen","imageUrl":"https://tr.rbxcdn.com/180DAY-2dc54e0c37d27734f4a58abc4df4600f/500/280/Image/Jpeg/noFilter","placeId":18130218021},"features":"- Auto Farm\n- Auto Serv\n- Auto Collect\n- Auto Win\n- More","tags":["hells kitchen"],"script":"loadstring(game:HttpGet(('https://pastefy.app/rncfR1qd/raw'),true))()","owner":{"_id":"66029e60cfe16afcfd18991d","username":"Rio7Rob","verified":false,"profilePicture":"/images/photo/66029e60cfe16afcfd18991d-1711447845750.png","status":"offline","id":"66029e60cfe16afcfd18991d","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":100}},"verified":false,"keyLink":"https://linkvertise.com/1045829/hells-kitchen-8fw4md?o=sharing","views":10058,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-12T01:48:13.411Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/18130218021-1736646493361.png","executes":173,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c5415f","editBy":{"_id":"66029e60cfe16afcfd18991d","username":"Rio7Rob","status":"offline","id":"66029e60cfe16afcfd18991d"},"message":"Create script","createdAt":"2025-03-27T19:52:08.229Z"}],"comments":[]}]}