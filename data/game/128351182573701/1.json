Count":0,"createdAt":"2025-12-21T19:32:24.926Z","liked":false,"disliked":false},{"_id":"6949310d39aa8f16149b88a3","commentBy":{"_id":"69476be206b900e8622d272d","username":"Little_Magnus","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2025-12-24T04:51:41.213Z","createdAt":"2025-12-21T03:39:14.185Z","status":"offline","id":"69476be206b900e8622d272d"},"text":"Btw- I used it before the patch so it still works for me, Does it work for other who used it before the patch too?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-22T11:52:45.212Z","liked":false,"disliked":false},{"_id":"694949a8689845aa751fff0d","commentBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"role":"user","profilePicture":"/images/photo/61dd7bc7891d6640f94ac0e8-1729504559429.gif","createdAt":"2022-01-11T12:44:55.059Z","lastActive":"2026-10-09T23:51:47.587Z","keylessCreator":true,"status":"offline","id":"61dd7bc7891d6640f94ac0e8","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"views","value":20102}},"topMilestone":{"key":"creator.streak","tier":30}},"text":"@Little_Magnus Yup all the data is saved if you used it before they patched it should've saved your stats","parent":{"_id":"6949310d39aa8f16149b88a3","commentBy":{"_id":"69476be206b900e8622d272d","username":"Little_Magnus","profilePicture":"/images/user-default.webp","status":"offline","id":"69476be206b900e8622d272d"},"text":"Btw- I used it before the patch so it still works for me, Does it work for other who used it before the patch too?"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-22T13:37:44.434Z","liked":false,"disliked":false},{"_id":"69499a9c412eaa14db1cb8e3","commentBy":{"_id":"67a2a62cb9da037d346400df","username":"gabrielm","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-02-04T23:43:40.863Z","lastActive":"2026-10-06T04:26:01.814Z","status":"offline","id":"67a2a62cb9da037d346400df","topMilestone":{"key":"account.comments","tier":100}},"text":"works for me all you gotta do is press acending and exclude full servers very easy","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-22T19:23:08.723Z","liked":false,"disliked":false}]},{"slug":"Brainrot-Seas-Auto-hit-nearest-76552","_id":"6946de34afbb1a762c10f6e0","title":"Auto hit nearest","game":{"_id":"6946de34afbb1a762c10f6dd","gameId":128351182573701,"name":"Brainrot Seas","imageUrl":"/images/sb/rbx-895fea486c00b38e2618fafc6800e849-8832898d3bd2.png","placeId":128351182573701},"features":"Use fist or weapon","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal Root = Character:WaitForChild(\"HumanoidRootPart\")\n\nLocalPlayer.CharacterAdded:Connect(function(char)\n\tCharacter = char\n\tRoot = char:WaitForChild(\"HumanoidRootPart\")\nend)\n\nlocal CombatHit = game:GetService(\"ReplicatedStorage\")\n\t:WaitForChild(\"Remotes\")\n\t:WaitForChild(\"Combat\")\n\t:WaitForChild(\"CombatHit\")\n\nlocal AliveFolder = workspace:WaitForChild(\"World\"):WaitForChild(\"Alive\")\n\nlocal RUN = true -- set to false to stop\n\ntask.spawn(function()\n\twhile RUN do\n\t\tlocal nearestTarget = nil\n\t\tlocal shortestDistance = math.huge\n\n\t\tif Root then\n\t\t\tfor _, target in ipairs(AliveFolder:GetChildren()) do\n\t\t\t\tif target:IsA(\"Model\")\n\t\t\t\t\tand target ~= Character\n\t\t\t\t\tand target:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\t\tand target:FindFirstChild(\"Humanoid\")\n\t\t\t\t\tand target.Humanoid.Health > 0 then\n\n\t\t\t\t\tlocal distance = (Root.Position - target.HumanoidRootPart.Position).Magnitude\n\n\t\t\t\t\tif distance < shortestDistance then\n\t\t\t\t\t\tshortestDistance = distance\n\t\t\t\t\t\tnearestTarget = target\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif nearestTarget then\n\t\t\tlocal args = {\n\t\t\t\t{ nearestTarget },\n\t\t\t\t1\n\t\t\t}\n\t\t\tCombatHit:FireServer(unpack(args))\n\t\tend\n\n\t\ttask.wait(0.01)\n\tend\nend)","owner":{"_id":"68690bf82cc4717be88b3c89","username":"raymondgolpeo2","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68690bf82cc4717be88b3c89","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1149,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/128351182573701-1766252084429.webp","likeCount":1,"dislikeCount":0,"createdAt":"2025-12-20T17:34:44.454Z","executes":10,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6946de34afbb1a762c10f6e2","editBy":{"_id":"68690bf82cc4717be88b3c89","username":"raymondgolpeo2","status":"offline","id":"68690bf82cc4717be88b3c89"},"message":"Create script","createdAt":"2025-12-20T17:34:44.458Z"}],"comments":[{"_id":"6946e2c0dc8104653fc7e022","commentBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"role":"user","profilePicture":"/images/photo/61dd7bc7891d6640f94ac0e8-1729504559429.gif","createdAt":"2022-01-11T12:44:55.059Z","lastActive":"2026-10-09T23:51:47.587Z","keylessCreator":true,"status":"offline","id":"61dd7bc7891d6640f94ac0e8","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"views","value":20102}},"topMilestone":{"key":"creator.streak","tier":30}},"text":"Here's some more remotes for you maybe you can make something more interesting\n--Start Dialogue\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.NPC.StartDialogue\nEvent:FireServer(\n    workspace.World.Interactables.NPC[\"Starter Island\"][\"Scared Citizen\"], -- NPC\n    true\n)\n--Get Quest?\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.NPC.SelectOption\nEvent:FireServer(\n    workspace.World.Interactables.NPC[\"Starter Island\"][\"Scared Citizen\"],\n    \"Dialogue/Entry\",\n    \"Callback/TryStartQuest\"\n)\n--Get Quest2?\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.Quest.GetQuestNPC\nEvent:InvokeServer(\n    \"KillAlessios\" -- QuestName\n)\n--Complete Quest?\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.Quest.ConfirmComplete\nEvent:FireServer()\n--Stun\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.Damage.RequestStun\nEvent:FireServer(\n    workspace.World.Alive.Alessio, -- En*y\n    true,\n    1 -- Stun Time?\n)\n--Knockback\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.Damage.RequestKnockbackLook\nEvent:FireServer(\n    workspace.World.Alive:GetChildren()[14], -- En*y\n    100, -- Force?\n    10 -- Time?\n)\n--Custom Knocback into direction?\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.Damage.RequestKnockbackCustom\nEvent:FireServer(\n    workspace.World.Alive.Alessio, -- En*y\n    Vector3.new(6.2467741966248, 25, -59.673927307129), -- Direction\n    0.15 -- Time?\n)\n--Damage\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.Combat.CombatHit\nEvent:FireServer(\n    {\n        workspace.World.Alive.Alessio\n    },\n    1\n)","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-20T17:54:08.130Z","liked":false,"disliked":false},{"_id":"6946e2d89f586c341505319a","commentBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"role":"user","profilePicture":"/images/photo/61dd7bc7891d6640f94ac0e8-1729504559429.gif","createdAt":"2022-01-11T12:44:55.059Z","lastActive":"2026-10-09T23:51:47.587Z","keylessCreator":true,"status":"offline","id":"61dd7bc7891d6640f94ac0e8","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"views","value":20102}},"topMilestone":{"key":"creator.streak","tier":30}},"text":"And also you can fire combathit event on anyone you don't have to be nearby","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-20T17:54:32.162Z","liked":false,"disliked":false},{"_id":"6946e351d7813601c601ed92","commentBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"role":"user","profilePicture":"/images/photo/61dd7bc7891d6640f94ac0e8-1729504559429.gif","createdAt":"2022-01-11T12:44:55.059Z","lastActive":"2026-10-09T23:51:47.587Z","keylessCreator":true,"status":"offline","id":"61dd7bc7891d6640f94ac0e8","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"views","value":20102}},"topMilestone":{"key":"creator.streak","tier":30}},"text":"and also inf stat points\n\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.UI.UIRemoteEvent\nEvent:FireServer(\n    (function(bytes) --[[Type: buffer]]\n        local b = buffer.create(#bytes)\n        for i = 1, #bytes do\n            buffer.writeu8(b, i - 1, bytes[i])\n        end\n        return b\n    end)({ 82, 69, 81, 85, 69, 83, 84, 95, 65, 80, 80, 76, 89, 95, 83, 84, 65, 84, 80, 79, 73, 78, 84 }),\n    \"Strength\",\n    -math.huge\n)\nand afterwards do the same for others to up them","edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-20T17:56:33.013Z","liked":false,"disliked":false},{"_id":"6948a3f55bbd2c07cf2dc0a9","commentBy":{"_id":"69477f4739aa8f161480932b","username":"vlone","verified":false,"role":"user","profilePicture":"/images/photo/69477f4739aa8f161480932b-1766293424438.jpg","lastActive":"2026-02-14T08:20:55.348Z","createdAt":"2025-12-21T05:01:59.812Z","status":"offline","id":"69477f4739aa8f161480932b"},"text":"Love this ngl, super simple and easy yet super effective.","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-22T01:50:45.500Z","liked":false,"disliked":false}]}]}