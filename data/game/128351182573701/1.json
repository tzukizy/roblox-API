"title":"Attack All","game":{"_id":"6946de34afbb1a762c10f6dd","gameId":128351182573701,"name":"Brainrot Seas","imageUrl":"/images/sb/rbx-895fea486c00b38e2618fafc6800e849-8832898d3bd2.png","placeId":128351182573701},"features":"Attacks all entities only works on loaded entities, if you know a workaround that would work on unloaded entities lmk","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal CombatHit = ReplicatedStorage.Remotes.Combat.CombatHit\nsetsimulationradius(math.huge)\n\nlocal KillAlive = function()\n    local targets = {}\n    for _, Alive in pairs(game.Workspace.World.Alive:GetChildren()) do\n        local player = Players:GetPlayerFromCharacter(Alive)\n        if not player then\n            local anyPart = Alive:FindFirstChildOfClass(\"BasePart\") or Alive.PrimaryPart\n            if anyPart then\n                anyPart.AssemblyLinearVelocity = Vector3.new(0,0,0)\n                table.insert(targets, Alive)\n            end\n        end\n    end\n    CombatHit:FireServer(targets, 1)\nend\n\nKillAlive()","owner":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"profilePicture":"/images/photo/61dd7bc7891d6640f94ac0e8-1729504559429.gif","status":"offline","id":"61dd7bc7891d6640f94ac0e8","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"views","value":20102}},"topMilestone":{"key":"creator.streak","tier":30}},"verified":true,"views":2867,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/rbx-9fcb86f99effadff38c5bc4debf7cd7c-cc57b59e047b.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-12-20T18:20:21.447Z","editBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","status":"offline","id":"61dd7bc7891d6640f94ac0e8"},"keyLink":"","executes":16,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6946e8e539aa8f161476f746","edit