144Z","liked":false,"disliked":false},{"_id":"6947d992412eaa14dbfff803","commentBy":{"_id":"64d8db63f2f290504f883c86","username":"CEO_","verified":false,"role":"user","profilePicture":"/images/photo/64d8db63f2f290504f883c86-1694871823245.jpg","createdAt":"2023-08-13T13:32:19.483Z","lastActive":"2026-07-23T19:52:23.635Z","status":"offline","id":"64d8db63f2f290504f883c86"},"text":"patched","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-21T11:27:14.716Z","liked":false,"disliked":false}]},{"slug":"Brainrot-Seas-Change-stats-76561","_id":"6946e5ff40f162cbcf081756","title":"Change stats [Works on old servers]","game":{"_id":"6946de34afbb1a762c10f6dd","gameId":128351182573701,"name":"Brainrot Seas","imageUrl":"/images/sb/rbx-895fea486c00b38e2618fafc6800e849-8832898d3bd2.png","placeId":128351182573701},"features":"Change your stats to desired values\nMake sure to not set value to math.huge as it breaks the stat","tags":[],"script":"local Desired_Values = 999999 -- Amount\nlocal Event = game:GetService(\"ReplicatedStorage\").Remotes.UI.UIRemoteEvent\n    \nlocal ObtainInfPoints = function()\n    Event:FireServer(\n        (function(bytes)\n            local b = buffer.create(#bytes)\n            for i = 1, #bytes do\n                buffer.writeu8(b, i - 1, bytes[i])\n            end\n            return b\n        end)({ 82, 69, 81, 85, 69, 83, 84, 95, 65, 80, 80, 76, 89, 95, 83, 84, 65, 84, 80, 79, 73, 78, 84 }),\n        \"Blade\",\n        -math.huge\n    )\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"StatRefundService\"):WaitForChild(\"FreeRefund\"):FireServer()\nend\nlocal AddPoints = function(Stat,Amount)\n    Event:FireServer(\n        (function(bytes)\n            local b = buffer.create(#bytes)\n            for i = 1, #bytes do\n                buffer.writeu8(b, i - 1, bytes[i])\n            end\n            return b\n        end)({ 82, 69, 81, 85, 69, 83, 84, 95, 65, 80, 80, 76, 89, 95, 83, 84, 65, 84, 80, 79, 73, 78, 84 }),\n        Stat,\n        Amount\n    )\nend\n\nObtainInfPoints()\nAddPoints(\"Strength\",Desired_Values)\nAddPoints(\"Ability\",Desired_Values)\nAddPoints(\"Health\",Desired_Values)\nAddPoints(\"Stamina\",Desired_Values)\nAddPoints(\"Blade\",Desired_Values)","owner":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","verified":true,"profilePicture":"/images/photo/61dd7bc7891d6640f94ac0e8-1729504559429.gif","status":"offline","id":"61dd7bc7891d6640f94ac0e8","leaderboard":{"tag":{"kind":"week","rank":17,"period":"week","metric":"views","value":20102}},"topMilestone":{"key":"creator.streak","tier":30}},"verified":true,"views":1520,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/rbx-9fcb86f99effadff38c5bc4debf7cd7c-cc57b59e047b.png","likeCount":4,"dislikeCount":0,"createdAt":"2025-12-20T18:07:59.085Z","editBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","status":"offline","id":"61dd7bc7891d6640f94ac0e8"},"keyLink":"","executes":9,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6946e5ff40f162cbcf081758","editBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","status":"offline","id":"61dd7bc7891d6640f94ac0e8"},"message":"Create script","createdAt":"2025-12-20T18:07:59.087Z"},{"_id":"6946e64bc7a82e5aa938675f","editBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","status":"offline","id":"61dd7bc7891d6640f94ac0e8"},"message":"Update script","createdAt":"2025-12-20T18:09:15.964Z"},{"_id":"6946eb611be1fb7483b14a71","editBy":{"_id":"61dd7bc7891d6640f94ac0e8","username":"32tq","status":"offline","id":"61dd7bc7891d6640f94ac0e8"},"message":"Update script to not lock out blade stat","createdAt":"2025-12-20T18:30:57.682Z"}],"comments":[{"_id":"6946f4954c1dd77782ba8da9","commentBy":{"_id":"6783fa657a65f62365370bf5","username":"ancisinartur","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-01-12T17