estroy()\nend\nwait(0.3)\n\n\n\n\nfor I = 1,op do\n\nlocal args = {\n\tgame:GetService(\"Players\").LocalPlayer:WaitForChild(\"leaderstats\"):WaitForChild(\"Rebirths\"),\n\tgame:GetService(\"ReplicatedStorage\").CurrentTrack,\n\tgame:GetService(\"ReplicatedStorage\").CurrentTrack\n}\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"Rebirth\"):FireServer(unpack(args))\nend\nwait(op/800)\n\nlocal ts = game:GetService(\"TeleportService\")\nlocal p = game:GetService(\"Players\").LocalPlayer\nts:TeleportToPlaceInstance(game.PlaceId, game.JobId, p)","owner":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"68309d74aef6b0af636efd8a","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":748,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-c8eca189308b6766f693e5068e695fd6-a10a0cf9abde.png","likeCount":2,"dislikeCount":1,"createdAt":"2026-02-11T13:27:07.063Z","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"keyLink":"","executes":7616,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"698c83ab75af53480ccedf89","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"message":"Create script","createdAt":"2026-02-11T13:27:07.066Z"},{"_id":"698c846d1a5b23101322527e","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"message":"Update script","createdAt":"2026-02-11T13:30:21.610Z"},{"_id":"698c85b557052543b7a48e8f","editBy":{"_id":"68309d74aef6b0af636efd8a","username":"uniiphysic","status":"offline","id":"68309d74aef6b0af636efd8a"},"message":"Update script","createdAt":"2026-02-11T13:35:49.874Z"}],"comments":[]},{"slug":"2x-Get-Big-Simulator-Aux-hub-infinite-Strength-Open-Source-48221","_id":"68984c5690c5832103305ed6","title":"Aux hub infinite Strength Open Source","game":{"_id":"68984c5690c5832103305ed0","gameId":13675842775,"name":"[2x💪] Get Big Simulator","imageUrl":"/images/sb/rbx-c8eca189308b6766f693e5068e695fd6-a10a0cf9abde.png","placeId":13675842775},"features":"--[[\n\tWARNING: Heads up! This script has not been verified by ScriptBlox. Use at your own risk!\n]]\n\nFeature!\n\n==== Text box put Strength you want! ====\n\n==== Button Send To get Strength! ===\n\n\nDon't forget leave a like or Follow 🎀","tags":["Aux hub","infinite Strength","Op script","Scriptbloxcom","VantaXock"],"script":"-- Here Script 🎀 \nlocal player = game.Players.LocalPlayer\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Parent = player:WaitForChild(\"PlayerGui\")\ngui.ResetOnSpawn = false\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 150, 0, 100)\nframe.Position = UDim2.new(0.5, -75, 0.5, -50)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Draggable = true\nframe.Parent = gui\n\nlocal title = Instance.new(\"TextLabel\")\ntitle.Size = UDim2.new(1, 0, 0, 25)\ntitle.BackgroundColor3 = Color3.fromRGB(45, 45, 45)\ntitle.Text = \"Aux Hub\"\ntitle.TextColor3 = Color3.fromRGB(255, 255, 255)\ntitle.Font = Enum.Font.GothamBold\ntitle.TextSize = 14\ntitle.Parent = frame\n\nlocal label = Instance.new(\"TextLabel\")\nlabel.Size = UDim2.new(1, -10, 0, 20)\nlabel.Position = UDim2.new(0, 5, 0, 30)\nlabel.BackgroundTransparency = 1\nlabel.Text = \"Put you want Strength!\"\nlabel.TextColor3 = Color3.fromRGB(255, 255, 255)\nlabel.Font = Enum.Font.Gotham\nlabel.TextSize = 12\nlabel.Parent = frame\n\nlocal textbox = Instance.new(\"TextBox\")\ntextbox.Size = UDim2.new(1, -10, 0, 20)\ntextbox.Position = UDim2.new(0, 5, 0, 50)\ntextbox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\ntextbox.Text = \"\"\ntextbox.TextColor3 = Color3.fromRGB(255, 255, 255)\ntextbox.Font = Enum.Font.Gotham\ntextbox.TextSize = 12\ntextbox.PlaceholderText = \"Enter Strength\"\ntextbox.Parent = frame\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(1, -10, 0, 20)\nbutton.Position = UDim2.new(0, 5, 0, 75)\nbutton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)\nbutton.Text = \"Send!\"\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Font = Enum.Font.GothamBold\nbutton.TextSize = 12\nbutton.Parent = frame\n\nbutton.MouseButton1Click:Connect(function()\n\tlocal strengthValue = tonumber(textbox.Text)\n\tif strengthValue then\n\t\tgame:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"UpdateStrength\"):FireServer(strengthValue)\n\tend\nend)\n\nprint(\"O\")\nprint(\"P\")","owner":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","verified":false,"profilePicture":"/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg","status":"offline","id":"6870b2fb95671adabe1b7905","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":105674,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/13675842775-1754811478437.webp","likeCount":8,"dislikeCount":1,"createdAt":"2025-08-10T07:37:58.465Z","executes":432,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68984c5690c5832103305ed8","editBy":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","status":"offline","id":"6870b2fb95671adabe1b7905"},"message":"Create script","createdAt":"2025-08-10T07:37:58.466Z"}],"comments":[{"_id":"68984c8ab2331a784ec6224b","commentBy":{"_id":"6870b2fb95671adabe1b7905","username":"VantaXock","verified":false,"role":"user","profilePicture":"/images/photo/6870b2fb95671adabe1b7905-1759412955517.jpg","createdAt":"2025-07-11T06:45:15.036Z","lastActive":"2026-05-23T04:44:12.401Z","status":"offline","id":"6870b2fb95671adabe1b7905","topMilestone":{"key":"creator.likes","tier":100}},"text":"Don't forge