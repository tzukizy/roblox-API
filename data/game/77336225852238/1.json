mptProductPurchaseFinished(game.Players.LocalPlayer.UserId, 3401108845, true)\n    end,\n})\n\nWindow:AddButton({\n    text = \"Scare All\",\n    flag = \"button\",\n    callback = function()\n        game.MarketplaceService:SignalPromptProductPurchaseFinished(game.Players.LocalPlayer.UserId, 3450911952, true)\n    end,\n})\n\nWindow:AddToggle({\n    text = \"Spam Strength\",\n    flag = \"toggle\",\n    state = false,\n    callback = function(state)\n        _G.Strength = state\n        print(\"Strength: \", state)\n        if state then\n            Strength()\n        end\n    end,\n})\n\nfunction Strength()\n    spawn(function()\n        _G.Strength = true\n        while _G.Strength do\n            wait()\n            pcall(function()\n                game.MarketplaceService:SignalPromptProductPurchaseFinished(game.Players.LocalPlayer.UserId, 3401104590, true)\n                wait()\n            end)\n        end\n    end)\nend\n\nWindow:AddLabel({ text = \"YouTube: Tora IsMe\" })\nLibrary:Init()","owner":{"_id":"66f2a832f104938f6ef096dd","username":"ToraIsMeSource","verified":false,"profilePicture":"/images/photo/66f2a832f104938f6ef096dd-1763989263245.jpg","status":"offline","id":"66f2a832f104938f6ef096dd"},"verified":false,"views":3678,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/77336225852238-1763886734190.jpg","likeCount":4,"dislikeCount":4,"createdAt":"2025-11-23T08:32:14.203Z","keyLink":"","executes":203,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6922c68e38daffe0188d9900","editBy":{"_id":"66f2a832f104938f6ef096dd","username":"ToraIsMeSource","status":"offline","id":"66f2a832f104938f6ef096dd"},"message":"Create script","createdAt":"2025-11-23T08:32:14.206Z"}],"comments":[{"_id":"6922f5ed264ed7f06b3366cf","commentBy":{"_id":"68e080ae924ad4d2eed8c031","username":"tankkk","verified":false,"role":"user","profilePicture":"/images/user-default.webp"