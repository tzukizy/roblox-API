708.webp","original":"https://scriptblox.com/images/photo/69ce57723a3a2289abc740d6-1775130576030.jpeg"}},"text":"USELESS","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-02T11:50:58.505Z","liked":false,"disliked":false}]},{"_id":"69adef3535f7c0d56d0e2336","title":"Kill Aura","game":{"_id":"699a634195668cb1493aa6ff","gameId":109844393857822,"name":"[ARMOR] Kyoeki: The Madness Plague","imageUrl":{"url":"https://media.kocakz.me/d4858710a2941ff468d05d614a44abd14057bbca99675fa981b56d6974131677.webp","original":"https://scriptblox.com/images/sb/rbx-c923acb84b6a30afb9c4d2638810ff80-1cf2a3197904.png"},"slug":"109844393857822-kyoeki-the-madness-plague","path":"/game/109844393857822-kyoeki-the-madness-plague","thumbnail":{"url":"https://media.kocakz.me/d4858710a2941ff468d05d614a44abd14057bbca99675fa981b56d6974131677.webp","original":"https://scriptblox.com/images/sb/rbx-c923acb84b6a30afb9c4d2638810ff80-1cf2a3197904.png"},"placeId":109844393857822},"slug":"UPD-Kyoeki:-The-Madness-Plague-Kill-Aura-133539","verified":false,"key":false,"keyless":false,"views":2695,"executes":81,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6d2905e05dbd301d704b1204c2bdadd1a4570342c30f02694f347098fa10dca1.webp","original":"https://scriptblox.com/images/sb/rbx-c923acb84b6a30afb9c4d2638810ff80-1cf2a3197904.png","scriptblox":"https://scriptblox.com/images/script/rbx-c923acb84b6a30afb9c4d2638810ff80-1cf2a3197904.png"},"thumbnail":{"url":"https://media.kocakz.me/6d2905e05dbd301d704b1204c2bdadd1a4570342c30f02694f347098fa10dca1.webp","original":"https://scriptblox.com/images/sb/rbx-c923acb84b6a30afb9c4d2638810ff80-1cf2a3197904.png","scriptblox":"https://scriptblox.com/images/script/rbx-c923acb84b6a30afb9c4d2638810ff80-1cf2a3197904.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-03-08T21:50:45.377Z","updatedAt":"2026-03-08T21:50:45.377Z","lastBump":"2026-03-08T21:50:45.377Z","script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal Remote = ReplicatedStorage\n    :WaitForChild(\"RemoteEvents\")\n    :WaitForChild(\"Combat\")\n    :WaitForChild(\"HitHumanoid\")\n\nlocal Levels = {\"Low\",\"High\"}\n\nlocal MAX_DISTANCE = 20\nlocal MAX_DISTANCE_SQ = MAX_DISTANCE * MAX_DISTANCE\n\nlocal enemies = {}\n\nlocal function characterReady()\n    local character = LocalPlayer.Character\n    if not character then return false end\n\n    local humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n    local root = character:FindFirstChild(\"HumanoidRootPart\")\n\n    if not humanoid or not root then\n        return false\n    end\n\n    if humanoid.Health <= 0 then\n        return false\n    end\n\n    return true\nend\n\nlocal function getWeapon(character)\n    for _, v in ipairs(character:GetChildren()) do\n        if v:IsA(\"Tool\") then\n            return v\n        end\n    end\nend\n\nlocal function getRoot(model)\n    return model:FindFirstChild(\"HumanoidRootPart\")\n        or model:FindFirstChild(\"UpperTorso\")\n        or model:FindFirstChild(\"Torso\")\n        or model.PrimaryPart\nend\n\nlocal function trackModel(model)\n\n    if Players:GetPlayerFromCharacter(model) then\n        return\n    end\n\n    task.spawn(function()\n\n        local humanoid = model:FindFirstChildOfClass(\"Humanoid\") or model:WaitForChild(\"Humanoid\",2)\n        local root = getRoot(model)\n\n        if not root then\n            root = model:WaitForChild(\"HumanoidRootPart\",2)\n        end\n\n        if humanoid and root then\n            enemies[model] = {\n                humanoid = humanoid,\n                root = root\n            }\n\n            humanoid.HealthChanged:Connect(function(h)\n                if h <= 0 then\n                    enemies[model] = nil\n                end\n            end)\n\n            model.AncestryChanged:Connect(function(_, parent)\n                if not parent then\n                    enemies[model] = nil\n                end\n            end)\n        end\n\n    end)\nend\n\nlocal function scan(container)\n\n    for _, v in ipairs(container:GetDescendants()) do\n        if v:IsA(\"Model\") then\n            trackModel(v)\n        end\n    end\n\n    container.DescendantAdded:Connect(function(obj)\n        if obj:IsA(\"Model\") then\n            trackModel(obj)\n        end\n    end)\nend\n\nscan(workspace)\n\nwhile true do\n    task.wait(0.15)\n\n    if not characterReady() then\n        continue\n    end\n\n    if next(enemies) == nil then\n        continue\n    end\n\n    local Character = LocalPlayer.Character\n    local Root = Character.HumanoidRootPart\n    local Weapon = getWeapon(Character)\n\n    if not Weapon then\n        continue\n    end\n\n    for model,data in pairs(enemies) do\n\n        local humanoid = data.humanoid\n        local enemyRoot = data.root\n\n        if not humanoid or humanoid.Health <= 0 or not enemyRoot then\n            enemies[model] = nil\n            continue\n        end\n\n        local diff = enemyRoot.Position - Root.Position\n\n        if diff:Dot(diff) <= MAX_DISTANCE_SQ then\n            Remote:FireServer(\n                Weapon,\n                humanoid,\n                Levels[math.random(1,2)]\n            )\n        end\n\n    end\nend","features":"Instructions (READ) ;\n1. Spawn in (as in, spawn in, can't believe I add to add a check for this)\n2. Equip your weapon (katana, ...)\n3. DO NOT ATTACK ANYTHING, THIS WILL TRIGGER THEIR SYSTEM.\n4. Just walk around holding your weapon, mobs will fall beneath your domain expansion\n\nIf you get kicked during gameplay - it's completely normal - I have no fucking idea how many hits you're allowed at once and this killaura WILL hit EVERYTHING in a X (MAX_DISTANCE) radius.\n\nTherefore, it is recommended to tweak the little \"task.wait(0.15)\" to something of your liking. (I found it stable around 0.15-0.25 but you might wanna increase it a bit)\n\nUsing the 2nd class (with spear) seems to yield the best result with no kick whatsoever","tags":["killaura","kill all","PP"],"discord":"","keyLink":"","owner":{"_id":"698e81e93384bf4618026322","username":"Rob666","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b5b9de4edf25e302732a4b1f34ad93c9345fb87c99dfc009abe59f4e15e145af.webp","original":"https://scriptblox.com/images/photo/698e81e93384bf4618026322-1776646233535.png"},"status":"offline","id":"698e81e93384bf4618026322","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/b5b9de4edf25e302732a4b1f34ad93c9345fb87c99dfc009abe59f4e15e145af.webp","original":"https://scriptblox.com/images/photo/698e81e93384bf4618026322-1776646233535.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:32:19.326Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69adef3535f7c0d56d0e2339","editBy":{"_id":"698e81e93384bf4618026322","username":"Rob666","status":"offline","id":"698e81e93384bf4618026322"},"message":"Create script","createdAt":"2026-03-08T21:50:45.379Z"},{"_id":"69ae1e8343eb3299c5652044","editBy":{"_id":"698e81e93384bf4618026322","username":"Rob666","status":"offline","id":"698e81e93384bf4618026322"},"message":"Update script","createdAt":"2026-03-09T01:12:35.914Z"},{"_id":"69ae21589994db3519cf23e0","editBy":{"_id":"698e81e93384bf4618026322","username":"Rob666","status":"offline","id":"698e81e93384bf4618026322"},"message":"Update script","createdAt":"2026-03-09T01:24:40.077Z"},{"_id":"69ae226a43eb3299c56560c2","editBy":{"_id":"698e81e93384bf4618026322","username":"Rob666","status":"offline","id":"698e81e93384bf4618026322"},"message":"Update script","createdAt":"2026-03-09T01:29:14.172Z"}],"comments":[{"_id":"69adf1e