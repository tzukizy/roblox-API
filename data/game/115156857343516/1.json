ed":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6936fa19c9a8b50085c801f7","editBy":{"_id":"691786e3547c9637c3cde996","username":"KamScriipts","status":"offline","id":"691786e3547c9637c3cde996"},"message":"Create script","createdAt":"2025-12-08T16:17:29.835Z"}],"comments":[{"_id":"693702b2e4d748bf75b6fecd","commentBy":{"_id":"67dcebeb7657c082792306e5","username":"xdzncx","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-03-21T04:32:43.305Z","lastActive":"2026-03-30T17:27:02.374Z","status":"offline","id":"67dcebeb7657c082792306e5"},"text":"Fix the ui on mobile","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-08T16:54:10.992Z","liked":false,"disliked":false},{"_id":"69371de2009513d5a39f56d5","commentBy":{"_id":"629e8f5b6774222fd111296d","username":"ezekielntakirumana","verified":false,"role":"user","profilePicture":"/images/user-default.png","createdAt":"2022-06-06T23:35:55.064Z","lastActive":"2026-03-31T02:39:23.329Z","status":"offline","id":"629e8f5b6774222fd111296d","topMilestone":{"key":"creator.first_script","tier":1}},"text":"The ui is still in the way","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-08T18:50:10.311Z","liked":false,"disliked":false},{"_id":"6937299c009513d5a39ff64a","commentBy":{"_id":"6932d9b472f0712d7fac5e0c","username":"Ryox","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-03-06T01:03:44.489Z","createdAt":"2025-12-05T13:10:12.681Z","status":"offline","id":"6932d9b472f0712d7fac5e0c"},"text":"You should add inf hunger, but so far, good script!","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-08T19:40:12.906Z","liked":false,"disliked":false},{"_id":"69378b81c9a8b50085cf7255","commentBy":{"_id":"68f1d878c5dba307983bac05","username":"Showcaser","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-10-17T05:47:36.107Z","lastActive":"2026-10-10T01:13:28.291Z","status":"offline","id":"68f1d878c5dba307983bac05"},"text":"Not working on delta fix it pls","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-09T02:37:53.693Z","liked":false,"disliked":false}]},{"slug":"Walk-or-Die-AUTO-WALK-FSB-SCRIPT-72898","_id":"6933f51532e62e631f15fcb3","title":"FSB SCRIPT[Updated]","game":{"_id":"6933f51532e62e631f15fcb0","gameId":115156857343516,"name":"🥾 Walk or Die","imageUrl":"/images/sb/rbx-92c13baca2e6b9012c360d4f001c1883-5b7b470ba01a.png","placeId":115156857343516},"features":"Walk or Die Script\n(Made by Fast_Skullbeats(Me)\n\nWoD Scripts:\n-Auto Walk(Patched becuz the game added the auto walk but still on this script)\n\n\n-Inf Stamina (Gives you a FULL STAMINA)\n\n\n-Script Gui(Working on it)\n\n\n-Inf Hunger(Working on it)\n\n\n-Duplicate Item(Coming soon)\n\n\n-God mode(Coming soon)\n\n\n-Auto Get Item(Coming soon)","tags":[],"script":"--  Don't Forget To Leave a Like\n\n\n\nlocal player = game.Players.LocalPlayer\nlocal UIS = game:GetService(\"UserInputService\")\nlocal RS = game:GetService(\"RunService\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal guiIntro = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\nguiIntro.ResetOnSpawn = false\nguiIntro.IgnoreGuiInset = true\n\nlocal intro = Instance.new(\"TextLabel\", guiIntro)\nintro.Size = UDim2.new(1,0,1,0)\nintro.BackgroundTransparency = 1\nintro.Text = \"This made by FAST_SKULLBEATS\"\nintro.Font = Enum.Font.GothamBlack\nintro.TextColor3 = Color3.fromRGB(255, 0, 0)\nintro.TextStrokeTransparency = 0\nintro.TextScaled = true\nintro.TextTransparency = 1\n\nlocal function playIntro()\n\tlocal fadeIn = TweenService:Create(intro, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {TextTransparency = 0})\n\tfadeIn:Play()\n\n\tintro.Size = UDim2.new(0.7,0,0.7,0)\n\tlocal zoom = TweenService:Create(intro, TweenInfo.new(0.9, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1,0,1,0)})\n\tzoom:Play()\n\n\ttask.wait(4.0)\n\n\tlocal fadeOut = TweenService:Create(intro, TweenInfo.new(0.7, Enum.EasingStyle.Quad), {TextTransparency = 1})\n\tfadeOut:Play()\n\tfadeOut.Completed:Wait()\n\tintro:Destroy()\nend\n\nplayIntro()\n\nlocal char = player.Character or player.CharacterAdded:Wait()\nlocal hum = char:WaitForChild(\"Humanoid\")\nplayer.CharacterAdded:Connect(function(c)\n\tchar = c\n\thum = c:WaitForChild(\"Humanoid\")\nend)\n\nlocal ScreenGui = Instance.new(\"ScreenGui\", player.PlayerGui)\nScreenGui.ResetOnSpawn = false\nScreenGui.Name = \"FAST_SKULL_AUTO_WALK\"\nScreenGui.Enabled = false\n\nlocal toggleBtn = Instance.new(\"TextButton\", ScreenGui)\ntoggleBtn.Size = UDim2.new(0,140,0,50)\ntoggleBtn.Position = UDim2.new(0,10,0.5,-25)\ntoggleBtn.Text = \"AutoWalk: OFF\"\ntoggleBtn.TextScaled = true\ntoggleBtn.BackgroundColor3 = Color3.fromRGB(70,25,25)\ntoggleBtn.TextColor3 = Color3.fromRGB(255,255,255)\ntoggleBtn.BorderSizePixel = 0\n\nlocal autoWalk = false\n\ntoggleBtn.MouseButton1Click:Connect(function()\n\tautoWalk = not autoWalk\n\tif autoWalk then\n\t\ttoggleBtn.BackgroundColor3 = Color3.fromRGB(20,120,20)\n\t\ttoggleBtn.Text = \"AutoWalk: ON\"\n\telse\n\t\ttoggleBtn.BackgroundColor3 = Color3.fromRGB(70,25,25)\n\t\ttoggleBtn.Text = \"AutoWalk: OFF\"\n\tend\nend)\n\ntask.delay(5.5, function()\n\tScreenGui.Enabled = true\nend)\n\nRS.RenderStepped:Connect(function()\n\tif not hum or hum.Health <= 0 then return end\n\tlocal moving = hum.MoveDirection.Magnitude > 0.1\n\tif autoWalk and not moving then\n\t\thum:Move(Vector3.new(0,0,-1), true)\n\tend\nend)\n\nlocal eventbypass\n\neventbypass = hookmetamethod(game, \"__namecall\", function(self, ...)\n    local method = getnamecallmethod()\n    local args = {...}\n\n    if not checkcaller() and self.Name == \"Reliable\" and method == \"FireServer\" and args[1][\"\\f\"][1][1] == true then\n        return \n    end\n    return eventbypass(self, ...)\nend)","owner":{"_id":"6846acae901cfa8ce8224294","username":"Fast_Skullbeats","verified":false,"profilePicture":"/images/photo/6846acae901cfa8ce8224294-1763797735454.jpg","status":"offline","id":"6846acae901cfa8ce8224294","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":3252,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/115156857343516-1765012757853.jpg","likeCount":4,"dislikeCount":0,"createdAt":"2025-12-06T09:19:17.867Z","editBy":{"_id":"6846acae901cfa8ce8224294","username":"Fast_Skullbeats","status":"offline","id":"6846acae901cfa8ce8224294"},"keyLink":"","executes":611,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6933f51532e62e631f15fcb5","editBy":{"_id":"6846acae901cfa8ce8224294","username":"Fast_Skullbeats","status":"offline","id":"6846acae901cfa8ce8224294"},"message":"Create script","createdAt":"2025-12-06T09:19:17.871Z"},{"_id":"69e0aae1a2f230359dd52b24","editBy":{"_id":"6846acae901cfa8ce8224294","username":"Fast_Skullbeats","status":"offline","id":"6846acae901cfa8ce8224294"},"message":"Update script","createdAt":"2026-04-16T09:24:49.742Z"}],"comments":[{"_id":"69341abb3bf99adfdf2e87d5","commentBy":{"_id":"6846acae901cfa8ce8224294","username":"Fast_Skullbeats","verified":false,"role":"user","profilePicture":"/images/photo/6846acae901cfa8ce8224294-1763797735454.jpg","createdAt":"2025-06-09T09:43:10.870Z","lastActive":"2026-06-11T13:34:36.657Z","status":"offline","id":"6846acae901cfa8ce8224294","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Tell me what should i add","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-06T11:59:55.696Z","liked":false,"disliked":false},{"_id":"69344c90d8971c10e482c3d0","commentBy":{"_id":"6932d9b472f0712d7fac5e0c","username":"Ryox","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-03-06T01:03:44.489Z","createdAt":"2025-12-05T13:10:12.681Z","status":"offline","id":"6932d9b472f0712d7