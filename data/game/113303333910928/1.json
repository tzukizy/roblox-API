unction()\n    Library.Unloaded = true\nend)\n\nlocal MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu')\nMenuGroup:AddButton('Unload', function() Library:Unload() end)\nMenuGroup:AddLabel('Menu bind'):AddKeyPicker('MenuKeybind', { Default = 'End', NoUI = true })\n\nLibrary.ToggleKeybind = Options.MenuKeybind\n\nThemeManager:SetLibrary(Library)\nSaveManager:SetLibrary(Library)\nSaveManager:IgnoreThemeSettings()\nSaveManager:SetIgnoreIndexes({ 'MenuKeybind' })\nThemeManager:SetFolder('MyScriptHub')\nSaveManager:SetFolder('MyScriptHub/specific-game')\nSaveManager:BuildConfigSection(Tabs['UI Settings'])\nThemeManager:ApplyToTab(Tabs['UI Settings'])","owner":{"_id":"676c65d7021ed1a13f16255f","username":"elysiumisevil","verified":false,"profilePicture":"/images/photo/676c65d7021ed1a13f16255f-1753382532143.png","status":"offline","id":"676c65d7021ed1a13f16255f","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":3360,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-d6290a1362ee455bdff16476b4e145ed-8db7f31ef6ec.png","likeCount":1,"dislikeCount":1,"createdAt":"2026-02-13T04:22:46.561Z","executes":32,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"698ea716a1ba7bddba83a2b4","editBy":{"_id":"676c65d7021ed1a13f16255f","username":"elysiumisevil","status":"offline","id":"676c65d7021ed1a13f16255f"},"message":"Create script","createdAt":"2026-02-13T04:22:46.564Z"}],"comments":[]},{"slug":"Dive-For-Brainrots!-tora-isme-script-110890","_id":"698e8b3e12004551b6364915","title":"tora isme script","game":{"_id":"698c83da75af53480ccee2be","gameId":113303333910928,"name":"[UPD] Dive For Brainrots!","imageUrl":"/images/sb/rbx-ea1b393a4f0be33b464c6826d397ddfa-56380ee7a73c.png","placeId":113303333910928},"features":".","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/gumanba/Scripts/main/DiveForBrainrots\"))()","owner":{"_id"