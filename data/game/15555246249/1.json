rInputService = game:GetService(\"UserInputService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal targetPos = nil\nlocal function getClosestTarget()\n    local camera = workspace.CurrentCamera\n    local mousePos = UserInputService:GetMouseLocation()\n    local closestDist = math.huge\n    local closestPos = nil\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player == LocalPlayer then continue end\n        local char = player.Character\n        if not char then continue end\n        local head = char:FindFirstChild(\"Head\")\n        if not head then continue end\n        local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)\n        if not onScreen then continue end\n        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude\n        if dist < closestDist then\n            closestDist = dist\n            closestPos = head.Position\n        end\n    end\n    targetPos = closestPos\nend\nlocal oldNamecall\noldNamecall = hookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)\n    local method = getnamecallmethod():lower()\n    if method == \"raycast\" and targetPos and typeof(self) == \"Instance\" and self == workspace then\n        local args = {...}\n        if typeof(args[1]) == \"Vector3\" then\n            local camera = workspace.CurrentCamera\n            args[2] = (targetPos - camera.CFrame.Position).Unit * 500\n            return oldNamecall(self, table.unpack(args))\n        end\n    end\n    return oldNamecall(self, ...)\nend))\nRunService.Heartbeat:Connect(getClosestTarget)","owner":{"_id":"69af5f1c942b0cf7aa3d6a94","username":"phemonazLEX","verified":false,"profilePicture":"/images/photo/69af5f1c942b0cf7aa3d6a94-1774060477809.jpg","status":"offline","id":"69af5f1c942b0cf7aa3d6a94","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":1629,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-391223b421ea6f