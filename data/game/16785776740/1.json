nsBold\nbutton.Parent = frame\nlocal buttonCorner = Instance.new(\"UICorner\")\nbuttonCorner.CornerRadius = UDim.new(0, 12)\nbuttonCorner.Parent = button\nbutton.MouseButton1Click:Connect(function()\n\tlocal inputAmount = tonumber(textbox.Text)\n\tif not inputAmount then return end\n\tlocal calculatedTime = inputAmount * 2\n\tlocal startTime = os.time()\n\tlocal args = {\n\t\t{\n\t\t\taltitude = 0,\n\t\t\tobstaclesBroken = 0,\n\t\t\tstartedTime = startTime,\n\t\t\tdistance = 0,\n\t\t\trewards = 0,\n\t\t\ttimeElapsed = calculatedTime,\n\t\t\treason = \"Run Ended\"\n\t\t}\n\t}\nReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"endRun\"):FireServer(unpack(args))\n\tbutton.Active = false\n\tbutton.Text = \"GENERATING FREE MONEY\"\n\twait(1)\n\tlocal placeId = game.PlaceId\n\tTeleportService:Teleport(placeId, player)\nend)","features":"# Open Source\n() Money Generator\nYou can type in exactly how much you want, and it will do the rest automatically.\n- I WILL NOT BE UPDATING THIS\n\n+ How it works\nThis script doubles the selected input and gives the correct amount of money.\nAutomatically rejoins for you, less of a hassle!\n\nCredits to @AaronS for already havin the arguments public.","tags":[],"discord":"","keyLink":"","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p