ke Pls\", \"DarkTheme\")\n    \n    local MainTab = Window:NewTab(\"Main Stuff\")\n    local MainSection = MainTab:NewSection(\"Free\")\n    \n    MainSection:NewButton(\"Free Helicopter\", \"like pls\", function()\n        game.workspace.Lobby.HeliArea:Destroy()\n    end)\n    \n    MainSection:NewButton(\"TP to finish\", \"like pls\", function()\n        local rootPart = game.Players.LocalPlayer.Character.HumanoidRootPart\n        rootPart.CFrame = workspace.Finish.Chest.CFrame\n    end)\n    \n    MainSection:NewToggle(\"Auto Farm\", \"like pls\", function(state)\n        if state then\n            _G.loop = true\n            while _G.loop == true do wait(0.5)\n                print(\"Toggle on\")\n    \n                local rootPart = game.Players.LocalPlayer.Character.HumanoidRootPart\n                rootPart.CFrame = workspace.Finish.Chest.CFrame wait(2)\n            end\n        else\n            _G.loop = false\n            while _G.loop do wait()\n                print(\"Toggle off\")\n    \n                local rootPart = game.Players.LocalPlayer.Character.HumanoidRootPart\n                rootPart.CFrame = workspace.Finish.Chest.CFrame wait(2)\n            end\n        end\n    end)\n    \n    end","owner":{"_id":"633dbb4cac6777387b080c5e","username":"SebiRedMan","verified":false,"profilePicture":"/images/photo/633dbb4cac6777387b080c5e-1721334307653.png","status":"offline","id":"633dbb4cac6777387b080c5e","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"keyLink":"","views":17983,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-11-16T16:01:36.903Z","dislikeCount":0,"likeCount":4,"image":"https://tr.rbxcdn.com/180DAY-5813b60d39a9c362a01263831b9811ec/500/280/Image/Jpeg/noFilter","executes":3,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c53059","editBy":{"_id":"633dbb4cac6777387b080c5e","username":"SebiRedMan","stat