{"id":120878830587405,"name":"CRASHOUT OBBY","desc":"❗ This obby starts off EASY and gets harder until you CRASHOUT.\n\n📈 Current Stages: 281\n\n✅ All stages are possible, but it gets super hard!\n\n👑 Join the Community and collect COINS to unlock FREE SKIPS!\n\n👎DISLIKE = CRASHOUT\n\n💻/🎮 CONTROLS:\nShift Lock - Shift / LT \nReset Character - R / Y / △","path":"/game/120878830587405-crashout-obby","slug":"120878830587405-crashout-obby","thumbnail":{"url":"https://cdn.kocakz.me/images/6ac1ad50831bbd324af773f281b5a0952a0b0f0e6c7d3084b7dccece8a3a4433.webp","original":"https://tr.rbxcdn.com/180DAY-dfe3140f108261712ad98e90ce972460/150/150/Image/Png/noFilter"},"playing":0,"visitor":14446849,"verified":false,"updatedAt":"2025-06-28T13:38:27.430Z","creator":{"name":"Gameology","type":"Group"},"script":{"count":4,"freeCount":4,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"CRASHOUT-OBBY-Complete-Obby-43297","_id":"685ff053b817f46491178b28","title":"Complete Obby","game":{"_id":"67e5e1ffb360710ec3c78754","gameId":120878830587405,"name":"CRASHOUT OBBY","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":120878830587405},"features":"this script will change your life","tags":["obby"],"script":"local stages = game.Workspace.Stages\nlocal plr = game.Players.LocalPlayer\nlocal leaderstats = plr.leaderstats\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal root = char.HumanoidRootPart\n\n-- getting the highest stage index\nlocal highest = 0\nfor _, v in next, stages:GetChildren() do\n    local i = tonumber(v.Name)\n    if v:IsA(\"SpawnLocation\") and i > highest then\n        highest = i\n    end\nend\n\n-- looping through numbers and simulating a touch on the stage\nfor i = leaderstats.Stage.Value, highest do\n    local stage = stages:FindFirstChild(tostring(i))\n    if stage and stage:IsA(\"SpawnLocation\") then\n        firetouchinterest(stage, root, 1)\n        task.wait(.1)\n        firetouchinterest(stage, root, 0)\n    end\nend","owner":{"_id":"67897cc42ca83ec8485a1373","username":"BSpook","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/0f402ab23125891c2522aed86c79fda0527674e2b516b8959bc7e549adce77f9.webp","original":"https://scriptblox.com/images/photo/67897cc42ca83ec8485a1373-1751115715439.png"},"status":"offline","id":"67897cc42ca83ec8485a1373","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/0f402ab23125891c2522aed86c79fda0527674e2b516b8959bc7e549adce77f9.webp","original":"https://scriptblox.com/images/photo/67897cc42ca83ec8485a1373-1751115715439.png"}},"verified":false,"views":2401,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-8840e8c74e752d577ab54d561298d7e0-38249e707516.png","scriptblox":"https://scriptblox.com/images/script/rbx-8840e8c74e752d577ab54d561298d7e0-38249e707516.png"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-06-28T13:38:27.431Z","executes":118,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:29:00.169Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-8840e8c74e752d577ab54d561298d7e0-38249e707516.png","scriptblox":"https://scriptblox.com/images/script/rbx-8840e8c74e752d577ab54d561298d7e0-38249e707516.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"685ff053b817f46491178b2b","editBy":{"_id":"67897cc42ca83ec8485a1373","username":"BSpook","status":"offline","id":"67897cc42ca83ec8485a1373"},"message":"Create script","createdAt":"2025-06-28T13:38:27.434Z"}],"comments":[]},{"slug":"CRASHOUT-OBBY-Auto-Win-39233","_id":"681de485605aada39a906067","title":"Auto Win","game":{"_id":"67e5e1ffb360710ec3c78754","gameId":120878830587405,"name":"CRASHOUT OBBY","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":120878830587405},"features":"fuck the obby just win!","tags":[],"script":"\nlocal Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal LocalPlayer = Players.LocalPlayer\n\nrepeat task.wait() until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\nlocal Root = LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\")\n\nlocal Stages = Workspace:WaitForChild(\"Stages\", 10)\n\nlocal gui = Instance.new(\"ScreenGui\", game.CoreGui)\ngui.Name = \"RedFoxAutoTP\"\n\nlocal frame = Instance.new(\"Frame\", gui)\nframe.Size = UDim2.new(0, 280, 0, 130)\nframe.Position = UDim2.new(0, 100, 0, 100)\nframe.BackgroundColor3 = Color3.fromRGB(15, 15, 15)\nframe.Active = true\nframe.Draggable = true\nInstance.new(\"UICorner\", frame).CornerRadius = UDim.new(0, 8)\n\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1, 0, 0, 30)\ntitle.Text = \"🦊 RedFox Auto TP\"\ntitle.TextColor3 = Color3.fromRGB(255, 0, 0)\ntitle.Font = Enum.Font.SourceSansBold\ntitle.TextSize = 20\ntitle.BackgroundTransparency = 1\n\nlocal button = Instance.new(\"TextButton\", frame)\nbutton.Size = UDim2.new(0, 240, 0, 40)\nbutton.Position = UDim2.new(0.5, -120, 0, 50)\nbutton.Text = \"Start Teleporting Through All Stages\"\nbutton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)\nbutton.TextColor3 = Color3.new(1, 1, 1)\nbutton.Font = Enum.Font.SourceSans\nbutton.TextSize = 16\nInstance.new(\"UICorner\", button).CornerRadius = UDim.new(0, 6)\n\nbutton.MouseButton1Click:Connect(function()\n\tif not Stages then\n\t\tbutton.Text = \"Stages not found\"\n\t\tbutton.BackgroundColor3 = Color3.fromRGB(120, 0, 0)\n\t\treturn\n\tend\n\n\tbutton.Text = \"Teleporting...\"\n\tbutton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)\n\n\tlocal missed = 0\n\tfor i = 0, 999 do\n\t\tlocal stage = Stages:FindFirstChild(tostring(i))\n\t\tif stage and stage:IsA(\"BasePart\") then\n\t\t\tRoot.CFrame = stage.CFrame + Vector3.new(0, 5, 0)\n\t\t\ttask.wait(1.2)\n\t\t\tmissed = 0\n\t\telse\n\t\t\tmissed += 1\n\t\t\tif missed >= 10 then break end\n\t\tend\n\tend\n\n\tbutton.Text = \"Done!\"\n\tbutton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)\nend)\n","owner":{"_id":"662ac1559aa6e5bf25724818","username":"Redfox","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b2801b01439f60a860d85950ff91bf5b3bc4d0a86c163ce32671a4a27ddbaacc.webp","original":"https://scriptblox.com/images/photo/662ac1559aa6e5bf25724818-1749459876097.png"},"status":"offline","id":"662ac1559aa6e5bf25724818","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/b2801b01439f60a860d85950ff91bf5b3bc4d0a86c163ce32671a4a27ddbaacc.webp","original":"https://scriptblox.com/images/photo/662ac1559aa6e5bf25724818-1749459876097.png"}},"verified":false,"views":3741,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/7b715c52526134aca5af25584aa39f6448e97d87354a0fac513d031404f1c433.webp","original":"https://scriptblox.com/images/sb/120878830587405-1746789509737.png","scriptblox":"https://scriptblox.com/images/script/120878830587405-1746789509737.png"},"likeCount":0,"dislikeCount":1,"createdAt":"2025-05-09T11:18:29.766Z","editBy":{"_id":"662ac1559aa6e5bf25724818","username":"Redfox","status":"offline","id":"662ac1559aa6e5bf25724818"},"discord":"https://discord.com/invite/CCzPKQfe8K","executes":92,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:43:08.577Z"},"thumbnail":{"u