{"id":74779072921656,"name":"🐝 Spelling Bee [🐰 SPRING]","desc":"🔊 Audio must be turned on 🔊\n\nWelcome to Spelling Bee, spell words correctly to progress through grade levels (1st - 12th)! \nDo you have what it takes to graduate?\n\n🎁 Make sure to leave a like and join the group for a reward\n\nThis game may start off easy, but gets very difficult in later stages!\nWord Count: 1000 🐝\n\n🎃 Halloween UPDATE \n- Spooky Decorations\n- Limited-Time Items from the Headless Horseman\n- Halloween-Themed Words\n- Bug Fixes\n\n**Game was designed for my friend, @Faitent, she's terrible at spelling!","path":"/game/74779072921656-spelling-bee","slug":"74779072921656-spelling-bee","thumbnail":{"url":"https://media.kocakz.me/5c6e77f0611ac9ccff4951b8e9359e5b1c4f8149d2e3d4e9c9a131bfd5de9b72.webp","original":"https://tr.rbxcdn.com/180DAY-b8dfaf28bbd92a1e0857f66b8f4dd17d/150/150/Image/Png/noFilter"},"playing":347,"visitor":76709182,"verified":false,"updatedAt":"2026-08-22T17:43:56.602Z","creator":{"name":"NerdZone","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"6a89dfdc71c8fd7d2f8c61cb","title":"Auto Spell","game":{"_id":"6861662cd0113c7678c3e87d","gameId":74779072921656,"name":"🐝 Spelling Bee [🐰 SPRING]","imageUrl":{"url":"https://media.kocakz.me/5c6e77f0611ac9ccff4951b8e9359e5b1c4f8149d2e3d4e9c9a131bfd5de9b72.webp","original":"https://tr.rbxcdn.com/180DAY-b8dfaf28bbd92a1e0857f66b8f4dd17d/150/150/Image/Png/noFilter"},"slug":"74779072921656-spelling-bee","path":"/game/74779072921656-spelling-bee","thumbnail":{"url":"https://media.kocakz.me/5c6e77f0611ac9ccff4951b8e9359e5b1c4f8149d2e3d4e9c9a131bfd5de9b72.webp","original":"https://tr.rbxcdn.com/180DAY-b8dfaf28bbd92a1e0857f66b8f4dd17d/150/150/Image/Png/noFilter"},"placeId":74779072921656},"slug":"Spelling-Bee-SPRING-Auto-Spell-225004","verified":false,"key":false,"keyless":false,"views":603,"executes":9414,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/6bdece1cf04f647c7cbb992f54c37d4eede9ff36ea572b6f52f881fdc4b558b2.webp","original":"https://scriptblox.com/images/sb/rbx-b0aab01b7a74b48ddd8d6bf6bb7dd272-4a2cb08e1a7c.png","scriptblox":"https://scriptblox.com/images/script/rbx-b0aab01b7a74b48ddd8d6bf6bb7dd272-4a2cb08e1a7c.png"},"thumbnail":{"url":"https://media.kocakz.me/6bdece1cf04f647c7cbb992f54c37d4eede9ff36ea572b6f52f881fdc4b558b2.webp","original":"https://scriptblox.com/images/sb/rbx-b0aab01b7a74b48ddd8d6bf6bb7dd272-4a2cb08e1a7c.png","scriptblox":"https://scriptblox.com/images/script/rbx-b0aab01b7a74b48ddd8d6bf6bb7dd272-4a2cb08e1a7c.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-08-22T17:43:56.603Z","updatedAt":"2026-08-22T17:43:56.603Z","lastBump":"2026-08-22T17:43:56.603Z","script":"if game.PlaceId == 74779072921656 then\n    local settings = {\n        AutoGuess = true,\n        AutoSayInChat = true,\n        delay = 0.4\n    }\n\n    local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n    local Players = game:GetService(\"Players\")\n\n    local data = ReplicatedStorage:FindFirstChild(\"Modules\") and ReplicatedStorage.Modules:FindFirstChild(\"Data\")\n\n    local worddata = {}\n\n    if data then\n        for _, v in ipairs(data:GetChildren()) do\n            if v.Name:find(\"WordData\") then\n                table.insert(worddata, v)\n            end\n        end\n    end\n\n    local player = Players.LocalPlayer\n    local playerGui = player and player:FindFirstChild(\"PlayerGui\")\n    local mainGui = playerGui and playerGui:FindFirstChild(\"MainGui\")\n    local answerFrame = mainGui and mainGui:FindFirstChild(\"AnswerFrame\")\n    local scriptables = workspace:FindFirstChild(\"Scriptables\")\n    local mainBoard = scriptables and scriptables:FindFirstChild(\"MainBoard\")\n    local surfaceGui = mainBoard and mainBoard:FindFirstChild(\"SurfaceGui\")\n    local hintLabel = surfaceGui and surfaceGui:FindFirstChild(\"HintLabel\")\n    local nameLabel = surfaceGui and surfaceGui:FindFirstChild(\"NameLabel\")\n    local submissionLabelClient = surfaceGui and surfaceGui:FindFirstChild(\"SubmissionLabelClient\")\n    local function getWord()\n        local sndid = game:GetService(\"Players\").LocalPlayer.PlayerGui:WaitForChild(\"Sound\") and game:GetService(\"Players\").LocalPlayer.PlayerGui:WaitForChild(\"Sound\").SoundId or \"\"\n\n        for _, v in ipairs(worddata) do\n            if not v or not v.Parent then\n                continue\n            end\n\n            local wordModule = require(v)\n\n            if wordModule then\n                for dificulty, difidata in pairs(wordModule) do\n                    for _, wrddata in ipairs(difidata) do\n                        if wrddata.id == sndid then\n                            return wrddata.word\n                        end\n                    end\n                end\n            end\n        end\n    end\n    local function chatWord()\n        local TextChatService = game:GetService(\"TextChatService\")\n\n        local textChannels = TextChatService:WaitForChild(\"TextChannels\")\n        local general = textChannels:WaitForChild(\"RBXGeneral\")\n\n        general:SendAsync(getWord())\n    end\n\n    if answerFrame then\n        answerFrame:GetPropertyChangedSignal(\"Visible\"):Connect(function()\n            if not answerFrame or not answerFrame.Parent  and not settings.AutoGuess then\n                return\n            end\n\n            if answerFrame.Visible then\n                local cur = \"\"\n                local last = \"\"\n                local word = getWord()\n                task.wait(settings.delay)\n                for _, l in ipairs(string.split(word, \"\")) do\n                    cur = cur .. l\n                    task.wait(last == l and 0.05 or math.random(5,30)/100)\n                    last = l\n                    local remotes = ReplicatedStorage:FindFirstChild(\"Remotes\")\n                    local submitAnswer = remotes and remotes:FindFirstChild(\"SubmitAnswer\")\n\n                    if not submitAnswer then\n                        return\n                    end\n\n                    submitAnswer:FireServer(\"Type\", cur)\n                    submissionLabelClient.Text = cur\n                end\n\n                local remotes = ReplicatedStorage:FindFirstChild(\"Remotes\")\n                local submitAnswer = remotes and remotes:FindFirstChild(\"SubmitAnswer\")\n\n                if submitAnswer then\n                    submitAnswer:FireServer(\"Submit\", word)\n                end\n            end\n        end)\n    end\n    if hintLabel and nameLabel then\n        hintLabel:GetPropertyChangedSignal(\"Text\"):Connect(function()\n            if hintLabel.Text:gsub(\"%s+\", \"\") ~= \"\" and settings.AutoSayInChat and (player.Name ~= nameLabel.Text:match(\"^(.-) 's Turn\")) then\n                local word = getWord()\n                local cur = \"\"\n                local last = \"\"\n                task.wait(settings.delay)\n                for _, l in ipairs(string.split(word, \"\")) do\n                    cur = cur .. l\n                    task.wait(last == l and 0.05 or math.random(5,30)/100)\n                    last = l\n                end\n                chatWord()\n            end\n        end)\n    end\n    print(\"started\")\nelse\n    game:GetService(\"Players\").LocalPlayer:Kick(\"Game is not supported by this script.\")\nend","features":"no gui controll, but works.","tags":[],"discord":"","keyLink":"","owner":{"_id":"673c9b299729ef2affd17b4c","username":"opensrcd","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d381f665cf8ab1c874d9ed13be58ca8898f15d2c6e841fe120e716c70b9d2712.webp","original":"https://scriptblox.com/images/photo/673c9b299729ef2affd17b4c-1787421363406.png"},"status":"offline","id":"673c9b299729ef2affd17b4c","topMilestone":{"key":"creator.first_sc