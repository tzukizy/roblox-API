rt\") then return end\n\n\tlocal char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()\n\tlocal root = char:WaitForChild(\"HumanoidRootPart\")\n\n\tlocal origin = root.Position\n\tlocal direction = (target.Position - origin).Unit\n\n\tlocal args = {\n\t\ttarget, \n\t\torigin,\n\t\tdirection\n\t}\n\n\tShootEvent:FireServer(unpack(args))\nend\n\nfor _, mobModel in ipairs(mobsFolder:GetDescendants()) do\n\tif mobModel:IsA(\"Model\") then\n\t\tlocal dragon = mobModel:FindFirstChild(\"Dragon\") or mobModel:FindFirstChild(\"Root\")\n\t\tif dragon and dragon:IsA(\"BasePart\") then\n\t\t\tshootAtTarget(dragon)\n\t\tend\n\tend\nend\n","owner":{"_id":"677a91b08b3310d4b7ffec95","username":"1qu09x","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"677a91b08b3310d4b7ffec95","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":7312,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-037273bbb104fb87809aee1cf7f6b164-14d5002412ed.png","scriptblox":"https://scriptblox.com/images/script/rbx-037273bbb104fb87809aee1cf7f6b164-14d5002412ed.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-06-19T22:27:03.773Z","executes":80,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:31:18.050Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-037273bbb104fb87809aee1cf7f6b164-14d5002412ed.png","scriptblox":"https://scriptblox.com/images/script/rbx-037273bbb104fb87809aee1cf7f6b164-14d5002412ed.png"},"isHub":false,"supportedGames