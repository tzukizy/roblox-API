{"id":13838940298,"name":"Drawings Attack!","desc":"Draw something and it will come to life and attack other drawings.\n\nFollow the group leader, SneezyBadger, for rewards in game!\n\nCodes:\n✅5klikes\n✅doodle\n\n✅ Submit your drawing for drawing of the week","path":"/game/13838940298-drawings-attack","slug":"13838940298-drawings-attack","thumbnail":{"url":"https://cdn.kocakz.me/images/e8d7413b43726d84a6bc2d455b8709e9b4136697090019e1b4223a5b257be3f9.webp","original":"https://tr.rbxcdn.com/180DAY-fccdbe2833715ceaf5f2f58fccac0024/150/150/Image/Png/noFilter"},"playing":12,"visitor":38381341,"verified":false,"updatedAt":"2024-07-29T00:30:54.879Z","creator":{"name":"SneezyBadger Games","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Draw-n'-Spawn!-Auto-collect-paint-buckets-Auto-farm-16281","_id":"66a6e2be9af5d4ccc41ecea8","title":"Auto collect paint buckets Auto farm","game":{"_id":"67e5e1ffb360710ec3c78bc7","gameId":13838940298,"name":"Drawings Attack!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":13838940298},"features":"- Auto collect paint buckets","tags":[],"script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal PaintBuckets = workspace.PaintBuckets\nlocal Remote = ReplicatedStorage.Remotes.CollectPaintCan\n\nlocal function collectPaintCan(amount, index, bucketName)\n    local args = {\n        [1] = amount,\n        [2] = PaintBuckets:FindFirstChild(bucketName)\n    }\n\n    if args[2] then\n        Remote:FireServer(unpack(args))\n    else\n        warn(\"Paint bucket not found: \" .. bucketName)\n    end\nend\n\nlocal maxIterations = 134\n\nfor i = 1, maxIterations do\n\n    local bucketName = tostring(i)\n    local amount = 5 \n\n    collectPaintCan(amount, i, bucketName)\n\n    wait(0.5)\nend","owner":{"_id":"66996f0d1f01bf7b2e0