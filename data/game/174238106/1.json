{"id":174238106,"name":"✈RED VS BLUE PLANE WARS!","desc":"","path":"/game/174238106-red-vs-blue-plane-wars","slug":"174238106-red-vs-blue-plane-wars","thumbnail":["https://tr.rbxcdn.com/180DAY-e37d72a2b301867420b5f77778bced13/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-caa91dde3a3ecc070f9b3e307607ef29/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":1023,"visitor":0,"verified":false,"updatedAt":"2025-09-28T13:32:34.651Z","creator":{"name":"Roblox","type":"User"},"script":{"count":8,"freeCount":8,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"RED-VS-BLUE-PLANE-WARS!-Red-vs-blue-aimbot-rocket-55481","_id":"68d938f21059a9026bace036","title":"Red vs blue aimbot rocket","game":{"_id":"67e5e1ffb360710ec3c77e70","gameId":174238106,"name":"✈RED VS BLUE PLANE WARS!","imageUrl":"/images/sb/rbx-caa91dde3a3ecc070f9b3e307607ef29-7f7aca0a386c.png","placeId":174238106},"features":"It's will check team & auto fire","tags":["Red vs Blue"],"script":"local Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Backpack = LocalPlayer:WaitForChild(\"Backpack\")\nlocal RocketLauncher = Backpack:WaitForChild(\"RocketLauncher\")\nlocal Activation = RocketLauncher:WaitForChild(\"Activation\")\n\nlocal function getClosestEnemy()\n    local closestEnemy, shortestDist = nil, math.huge\n    local myChar = LocalPlayer.Character\n    if not myChar or not myChar:FindFirstChild(\"HumanoidRootPart\") then return nil end\n\n    local myPos = myChar.HumanoidRootPart.Position\n\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Team ~= LocalPlayer.Team then\n            local char = player.Character\n            if char and char:FindFirstChild(\"HumanoidRootPart\") and char:FindFirstChildOfClass(\"Humanoid\").Health > 0 then\n                local dist = (char.HumanoidRootPart.Position - myPos).Magnitude\n                if dist < shortestDist then\n                    shortestDist = dist\n                    closestEnemy = char\n                end\n            end\n        end\n    end\n\n    return closestEnemy\nend\n\nlocal function aimAtEnemy()\n    local enemy = getClosestEnemy()\n    if enemy then\n        Activation:FireServer(\"Aim\", enemy.HumanoidRootPart.Position)\n    end\nend\n\nwhile task.wait(1) do\n    aimAtEnemy()\nend","owner":{"_id":"675c69e1021803dea1db824f","username":"gojohdkaisenkt_alt","verified":false,"profilePicture":"/images/photo/675c69e1021803dea1db824f-1750062339650.png","status":"offline","id":"675c69e1021803dea1db824f","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":5727,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-ae2b3a414856be622e24586f25bd3839-31e804e0fea2.png","likeCount":0,"dislikeCount":2,"createdAt":"2025-09-28T13:32:34.652Z","executes":446,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d938f21059a9026bace038","editBy":{"_id":"675c69e1021803dea1db824f","username":"gojohdkaisenkt_alt","status":"offline","id":"675c69e1021803dea1db824f"},"message":"Create script","createdAt":"2025-09-28T13:32:34.657Z"}],"comments":[{"_id":"68d96c00974b1f424a5162d7","commentBy":{"_id":"670050d90edfa96556919167","username":"Shazam","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-10-04T20:32:25.792Z","lastActive":"2026-09-02T05:07:18.194Z","status":"offline","id":"670050d90edfa96556919167","topMilestone":{"key":"account.years","tier":2}},"text":"Can you make inf money?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-28T17:10:24.457Z","liked":false,"disliked":false},{"_id":"68da56ce681f586dcfa7584d","commentBy":{"_id":"675c69e1021803dea1db824f","username":"gojohdkaisenkt_alt","verified":false,"role":"user","profilePicture":"/images/photo/675c69e1021803dea1db824f-1750062339650.png","createdAt":"2