{"id":163729669,"name":"Escape Jail Obby 2","desc":"Fan of the game? Join here! https://www.roblox.com/communities/2822047\n\nA roblox classic from 2014!\n\nAt last the long-awaited sequel to the roblox classic Escape Jail Obby is finally here! Work your way through 10 all new stages plus the signature Extra Credit Obby! This game supports a custom made hint feature, intricate coin system, and much more! \n\nBuy the official T-Shirt here! \nhttps://www.roblox.com/catalog/168933609/Escape-Jail-Obby-2-Official-T-Shirt\n\nList of game updates here:\nhttps://devforum.roblox.com/t/3007586\n\nv1.0.6","path":"/game/163729669-escape-jail-obby-2","slug":"163729669-escape-jail-obby-2","thumbnail":{"url":"https://media.kocakz.me/5363ec3979e0542ca2a0ee58e512359133a2f800deb1c618274044250a627622.webp","original":"https://tr.rbxcdn.com/180DAY-29a58622d43807fc620fb93e6db1235a/150/150/Image/Png/noFilter"},"playing":0,"visitor":717673,"verified":false,"updatedAt":"2025-08-26T22:47:11.843Z","creator":{"name":"Stormcell","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":1},"page":1,"next":null,"total":1,"scripts":[{"slug":"Escape-Jail-Obby-2-Fast-Coins-Script-50177","_id":"68ae396f8f824dfe93c88c5a","title":"Fast Coins Script","game":{"_id":"68ae396f8f824dfe93c88c57","gameId":163729669,"name":"Escape Jail Obby 2","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":163729669},"features":"Get's you alot of coins, very fast.\n\nHow to use:\nExecute the script.\nIf you don't have an executor this isn't for you.","tags":["coins","fast","auto","script","escape jail obby"],"script":"print(\"Bro\")\nlocal Character = game.Players.LocalPlayer.Character\nlocal hrp = Character.HumanoidRootPart\n\nlocal CoinGiver = workspace.TeleportStuff.CoinGiver\nlocal BackToMoutain = workspace.TeleportStuff:GetChildren()[4].Head\nlocal Coins = (function()\n\tlocal CoinsFound = {}\n\tfor i,v in pairs(workspace.Coins:GetDescendants()) do\n\t\tif v.ClassName == \"Part\" then\n\t\t\ttable.insert(CoinsFound, v)\n\t\tend\n\tend\n\treturn CoinsFound\nend)()\n\n\nlocal function QuickTouch(Part)\n\tfiretouchinterest(hrp, Part, 0)\n\tfiretouchinterest(hrp, Part, 1)\nend\n\nlocal function InstaExtraCredit()\n\tQuickTouch(CoinGiver)\n\tQuickTouch(BackToMoutain)\nend\n\nlocal function CollectAllCoins()\n\tfor i, Coin in pairs(Coins) do\n\t\tQuickTouch(Coin)\n\tend\nend\n\nlocal OldCFrame = hrp.CFrame\nhrp:GetPropertyChangedSignal(\"CFrame\"):Connect(function()\n\tlocal old_hrpPos = OldCFrame.Position\n\tlocal hrpPos = hrp.Position\n\tif (hrpPos - old_hrpPos).Magnitude > hrp.Velocity.Magnitude * 2 then\n\t\thrp.CFrame = OldCFrame\n\t\tprint(\"Corrected Teleport.\")\n\tend\nend)\n\nwhile task.wait() do\n\tOldCFrame = hrp.CFrame\n\tInstaExtraCredit()\n\tCollectAllCoins()\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"},"lvl":23,"status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11035507}},"topMilestone":{"key":"creator.views","tier":10000000},"profile":{"url":"https://media.kocakz.me/98956ce63453a3d326475e182567911881cb1c96f4c90cf0ba0cd6958de8957f.webp","original":"https://scriptblox.com/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png"}},"verified":true,"views":16206,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/6e042a97b3bce2c8b9c747f65bc7ea32f74a44e83f11d91c41585a2fc3a0db48.webp","original":"https://scriptblox.com/images/sb/rbx-f706128a4ee80b2fc8687e209199661f-7419d6d1b335.png","scriptblox":"https://scriptblox.com/images/script/rbx-f706128a4ee80