hen\n            toggle = not toggle\n            if toggle then\n                SendNotification(\"Cheats\", \"True\")\n            else\n                SendNotification(\"Cheats\", \"False\")\n            end\n        end\n    end)\n\n    while run.Stepped:Wait() do\n        if toggle then\n            pcall(function()\n                for i, v in next, players.LocalPlayer.Character:GetChildren() do\n                    if players.LocalPlayer.Character:FindFirstChildOfClass(\"Tool\") then\n                        if v:IsA(\"Part\") then\n                            v.CanTouch = false\n                        end\n                    else\n                        if v:IsA(\"Part\") then\n                            v.CanTouch = true\n                        end\n                    end\n                end\n            end)\n        else\n            pcall(function()\n                for i, v in next, players.LocalPlayer.Character:GetChildren() do\n                    if v:IsA(\"Part\") then\n                        v.CanTouch = true\n                    end\n                end\n            end)\n        end\n    end","features":"Taking less damage with swords.\nWorks in any sword fighting game (Sword fight on the heights type of games)\n\nPress 0 or K to toggle false or true. \n\nWorks with good executors.","tags":[],"discord":"","keyLink":"","owner":{"_id":"67675bd8eaae9d654834e880","username":"voaxics","verified":false,"profilePicture":{"url":"https://media.kocakz.me/52c4b061e70c4ad3b494408421bfb40d76d1263f2e0a64c41f7d3190a06ec2d7.webp","original":"https://scriptblox.com/images/photo/67675bd8eaae9d654834e880-1734827039490.png"},"status":"offline","id":"67675bd8eaae9d654834e880","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/52c4b061e70c4ad3b494408421bfb40d76d1263f2e0a64c41f7d3190a06ec2d7.webp","original":"https://scriptblox.com/images/photo/67675bd8eaae9d654834e880-1734827039490.png"}},"reviewed":null,"liked":