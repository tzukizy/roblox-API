{"id":14835828495,"name":"Dudes Battlegrounds","desc":"Are you the real hero? 🦸‍♂️🦸‍♀️\nA battlegrounds experience.  The game is in Beta, please be patient as we improve and fix bugs! 🐛\n⭐ Please consider liking and favoriting the game for more characters! ⭐\n\n🖥️ Controls\nG - Activate Ultimate \nF - Block\nQ - Dash\nQ (while ragdolled) - Ragdoll cancel/Evasive\nDouble Tap W - Run\nLeft Click - Punch\nB - Emote Wheel\n1,2,3,4 - Character Abilities\n\n✨ CODES: UPD72 | 2MFAVS | 190KLIKES | 2MGROUP \n\nLAGGING? Make a free Private Server! 😀\n📱💻🎮 Supports every platform!\n\n⚠️ CHEATERS WILL BE PERMANENTLY BANNED WITH NO HESITATION, DO NOT CHEAT OR YOU WILL BE BANNED. ⚠️","path":"/game/14835828495-dudes-battlegrounds","slug":"14835828495-dudes-battlegrounds","thumbnail":{"url":"https://cdn.kocakz.me/images/32060ef1aa222d237c6f5d97b8335946b114226aeb827975b09ad2aa101ed172.webp","original":"https://tr.rbxcdn.com/180DAY-c6cad680248fd243abaa4080b635a449/150/150/Image/Png/noFilter"},"playing":1503,"visitor":405503352,"verified":false,"updatedAt":"2025-09-24T08:51:06.103Z","creator":{"name":"Fantastic! Games","type":"Group"},"script":{"count":3,"freeCount":3,"keyCount":2,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Dudes-Battlegrounds-No-Dash-CoolDown-54637","_id":"68d3b0fac949cebea912012f","title":"No Dash CoolDown","game":{"_id":"6890b8496fd52d43f594afb4","gameId":14835828495,"name":"Dudes Battlegrounds","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":14835828495},"features":"side and back dash works made with ai","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal CoreGui = game:GetService(\"CoreGui\")\nlocal lp = Players.LocalPlayer\n\nlocal success, abilitiesModule = pcall(function()\n    return require(ReplicatedStorage:WaitForChild(\"Modules\"):WaitForChild(\"Abilities\"))\nend)\n\nif not success or type(abilitiesModule) ~= \"table\" then\n    warn(\"Failed to load Abilities module\")\n    return\nend\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"NoCooldownGUI\"\nscreenGui.Parent = CoreGui\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 120, 0, 40)\nbutton.Position = UDim2.new(0, 20, 0, 200)\nbutton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)\nbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextSize = 20\nbutton.Text = \"No Cooldown: OFF\"\nbutton.Parent = screenGui\n\nlocal enabled = false\nlocal originalCooldowns = {}\n\nlocal function updateButton()\n    if enabled then\n        button.Text = \"No Cooldown: ON\"\n        button.BackgroundColor3 = Color3.fromRGB(0, 170, 0)\n    else\n        button.Text = \"No Cooldown: OFF\"\n        button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\n    end\nend\n\nbutton.MouseButton1Click:Connect(function()\n    enabled = not enabled\n    updateButton()\n\n    for abilityName, abilityData in pairs(abilitiesModule) do\n        if abilityData.Cooldown then\n            if enabled then\n                originalCooldowns[abilityName] = originalCooldowns[abilityName] or abilityData.Cooldown\n                abilityData.Cooldown = 0\n            else\n                abilityData.Cooldown = originalCooldowns[abilityName] or abilityData.Cooldown\n            end\n        end\n        -- Optional: handle directional cooldowns if they exist\n        for _, dir in pairs({\"F_Cooldown\",\"B_Cooldown\",\"R_Cooldown\",\"L_Cooldown\"}) do\n            if abilityData[dir] then\n                if enabled then\n                    originalCooldowns[abilityName..\"_\"..dir] = originalCooldowns[abilityName..\"_\"..dir] or abilityData[dir]\n                    abilityData[dir] = 0\n                else\n                    abilityData[dir] = originalCooldowns[abilityName..\"_\"..dir] or abilityData[dir]\n                end\n            end\n        end\n    end\n\n    print(enabled and \"No Cooldown Enabled\" or \"No Cooldown Disabled\")\nend)\n\nupdateButton()\nprint(\"No Cooldown Script Loaded. Toggle with GUI button.\")","owner":{"_id":"687eba7419599ad33f38a3db","username":"LiamMozie","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"},"lvl":12,"status":"offline","id":"687eba7419599ad33f38a3db","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/44f0c6313c640b7cb6fa093d686a3873a441bf34b88311292625be0cb62c6bb8.webp","original":"https://scriptblox.com/images/photo/687eba7419599ad33f38a3db-1775597841157.jpg"}},"verified":false,"views":11508,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/8bc7cc423fec7c4817c6e4daec82623012ed022574a023e77344fba72b89d200.webp","original":"https://scriptblox.com/images/sb/rbx-f64f7b89d15359a27318d007b60c0865-5600c5f01b25.png","scriptblox":"https://scriptblox.com/images/script/rbx-f64f7b89d15359a27318d007b60c0865-5600c5f01b25.png"},"likeCount":5,"dislikeCount":2,"createdAt":"2025-09-24T08:51:06.107Z","executes":5033,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:50:36.021Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/8bc7cc423fec7c4817c6e4daec82623012ed022574a023e77344fba72b89d200.webp","original":"https://scriptblox.com/images/sb/rbx-f64f7b89d15359a27318d007b60c0865-5600c5f01b25.png","scriptblox":"https://scriptblox.com/images/script/rbx-f64f7b89d15359a27318d007b60c0865-5600c5f01b25.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d3b0fac949c