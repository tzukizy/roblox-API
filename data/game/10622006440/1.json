 cloneref :broken_heart:\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal AttackRemote = ReplicatedStorage:FindFirstChild(\"Events\"):WaitForChild(\"MeleeAttack\")\nlocal LocalPlayer = Players.LocalPlayer\n\ngetgenv().rapeall = true\ngetgenv().CustomText = \"Silly catbois :3\"\n\nwhile true do\n    if getgenv().rapeall then\n        for i, v in pairs(Players:GetPlayers()) do\n            if v ~= LocalPlayer and LocalPlayer.Character ~= nil and LocalPlayer.Character:FindFirstChild(\"HumanoidRootPart\") ~= nil and v.Character ~= nil and v.Character:FindFirstChild(\"HumanoidRootPart\") ~= nil then\n                local args = {\n                    [1] = {\n                        [\"rayInstance\"] = v.Character.HumanoidRootPart,\n                        [\"rayPosition\"] = v.Character.HumanoidRootPart.Position,\n                        [\"rayMaterial\"] = Enum.Material.Fabric,\n                        [\"rayNormal\"] = Vector3.new(0.5008270740509033, 0.04255622625350952, -0.8645005822181702)\n                    },\n                    [2] = LocalPlayer.Character.HumanoidRootPart,\n                    [3] = Vector3.new(),\n                    [4] = 8,\n                    [5] = {\n                        [\"MainDamage\"] = math.huge,\n                        [\"BackstabDamage\"] = math.huge,\n                        [\"AltDamage\"] = math.huge\n                    },\n                    [6] = 2,\n                    [7] = false,\n                    [8] = getgenv().CustomText\n                }\n\n                AttackRemote:FireServer(unpack(args))\n            end\n            task.wait()\n        end\n    else\n        break\n    end\nend","owner":{"_id":"677be435ea4516cd66668ea7","username":"CatBoy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/4b6fb37706d5f7244291c27fd67e992441678f96672d2dbd77a00b5b52457e79.webp","original":"https://scriptblox.com/images/photo/677be435ea4516cd66668ea7-1749212341564.png"},"status