g":[{"_id":"6a16121dfd482f5837c82e94","editBy":{"_id":"696049e853b2145f89e7bbde","username":"dsczi","status":"offline","id":"696049e853b2145f89e7bbde"},"message":"Create script","createdAt":"2026-05-26T21:35:25.983Z"}],"comments":[]},{"slug":"Drive-the-train-to-the-end-Anti-Train-128400","_id":"69a827021526fb78b4bc3d76","title":"Anti Train","game":{"_id":"681048b961a6eae7facce9a3","gameId":18133095266,"name":"Drive the train to the end ","imageUrl":"/images/sb/rbx-39c43b3844420797f80f0b785ecca885-47d862d68558.png","placeId":18133095266},"features":"Anti Train\n\nThis may cause some lag.\n\nSolara - 🔴\nXeno - 🔴\nVelocity - 🟢\nBunni - 🟢\nPottasium - 🟢\nSeliware - 🟢\nVolt - 🟢","tags":[],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/pafapafa/GameScripts/main/Loader\"))()","owner":{"_id":"694f18bf53d61a5e848d219e","username":"pafapafa","verified":false,"profilePicture":"/images/photo/694f18bf53d61a5e848d219e-1771940926473.png","status":"offline","id":"694f18bf53d61a5e848d219e","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":620,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/18133095266-1772627714437.webp","likeCount":1,"dislikeCount":0,"createdAt":"2026-03-04T12:35:14.457Z","keyLink":"","discord":"https://discord.com/invite/f9QBxHnyDP","executes":281,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a827021526fb78b4bc3d79","editBy":{"_id":"694f18bf53d61a5e848d219e","username":"pafapafa","status":"offline","id":"694f18bf53d61a5e848d219e"},"message":"Create script","createdAt":"2026-03-04T12:35:14.463Z"}],"comments":[]},{"slug":"Drive-the-train-to-the-end-Game-destroyer-38028","_id":"681048ba61a6eae7facce9a8","title":"Game destroyer","game":{"_id":"681048b961a6eae7facce9a3","gameId":18133095266,"name":"Drive the train to the end ","imageUrl":"/images/sb/rbx-39c43b3844420797f80f0b785ecca885-47d862d68558.png","placeId":18133095266},"features":"Open-source, no GUI, available for Windows, iOS, Android, Linux, MacOS, etc. (basically everything).\n\nMade by Nescoroco.\n\nGame: Drive the Train to the End\n\nFeatures (toggle with True/False for On/Off):\n\n- Instant Win\n\n- Free Secret Train\n\n- Teleport to Lobby\n\n- Block the Way (basically makes the game unplayable)","tags":[],"script":"-- Write True or False to activate or deactivate functions\n-- (Every action has a 1 seg cooldown)\nlocal tp1=true -- Win\n\nlocal tp2=false -- Easter Egg Train\n\nlocal spinLock=true -- Block the way\n\nlocal tp3=false -- Lobby\n\n\n\n-- Script core\nlocal p=game.Players.LocalPlayer.Character.HumanoidRootPart hum=game.Players.LocalPlayer.Character:WaitForChild(\"Humanoid\") local function teleport(pos) p.CFrame=CFrame.new(pos) wait(1) end if tp1 then teleport(Vector3.new(361.52,-0.07,162.70)) end if tp2 then teleport(Vector3.new(306.30,34.74,440.58)) end if tp3 then teleport(Vector3.new(195,0.07,24.74)) end loadstring(game:HttpGet('https://paste.myconan.net/572800.txt'))() if spinLock then local rs=game:GetService(\"RunService\") if not workspace:FindFirstChild(\"SpinFlag\") then local f=Instance.new(\"BoolValue\",workspace) f.Name=\"SpinFlag\" rs:BindToRenderStep(\"SpinEffect\",Enum.RenderPriority.Character.Value+1,function() if not f.Parent then return end p.CFrame=CFrame.new(88.58,0.75,108.04)*CFrame.Angles(0,math.rad(tick()*100),0) p.Velocity=Vector3.zero hum.PlatformStand=true end) else workspace.SpinFlag:Destroy() rs:UnbindFromRenderStep(\"SpinEffect\") hum.PlatformStand=false end end","owner":{"_id":"64fa4ed1dca7cf1eecabf3f7","username":"nescoro","verified":false,"profilePicture":"/images/photo/64fa4ed1dca7cf1eecabf3f7-1748462364745.png","status":"offline","id":"64fa4ed1dca7cf1eecabf3f7","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":7153,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/18133095266-1745897657993.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-04-29T03:34:18.061Z","editBy":{"_id":"64fa4ed1dca7cf1eecabf3f7","username":"nescoro","status":"offline","id":"64fa4ed1dca7cf1eecabf3f7"},"executes":419,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"681048ba61a6eae7facce9ac","editBy":{"_id":"64fa4ed1dca7cf1eecabf3f7","username":"nescoro","status":"offline","id":"64fa4ed1dca7cf1eecabf3f7"},"message":"Create script","createdAt":"2025-04-29T03:34:18.066Z"},{"_id":"68111d09a89fd911d9e44303","editBy":{"_id":"64fa4ed1dca7cf1eecabf3f7","username":"nescoro","status":"offline","id":"64fa4ed1dca7cf1eecabf3f7"},"message":"Update script","createdAt":"2025-04-29T18:40:09.606Z"}],"comments":[]}]}