","status":"offline","id":"67c5cecb03f338772cc36dc1","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":291,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-80a42f538380ac6a682cda807f1ee00a-59422aff24f8.png","likeCount":0,"dislikeCount":1,"createdAt":"2026-03-03T16:49:49.969Z","executes":23,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69a7112ded9548b28324abde","editBy":{"_id":"67c5cecb03f338772cc36dc1","username":"gumyivaas2","status":"offline","id":"67c5cecb03f338772cc36dc1"},"message":"Create script","createdAt":"2026-03-03T16:49:49.972Z"}],"comments":[]},{"slug":"Mega-Easy-Obby-825-Stages!-Auto-Play-OPEN-SOURCE-57334","_id":"68e7d0283204274c2ca3cbf3","title":"Auto Play Checkpoint & Prestige","game":{"_id":"67e5e1ffb360710ec3c7803a","gameId":3587619225,"name":"Mega Easy Obby 🌟 825 Stages!","imageUrl":"/images/sb/rbx-98db0267808238d804ba45f10ba96323-a3e849aa9a7d.png","placeId":3587619225},"features":"A headless auto checkpoint and prestige with a 99.9% success rate with auto recovery. Anti-AFK included.\n1 Prestige every 8 minutes and 58.59 seconds.\n1 Checkpoint every 0.65 seconds.\n\n\n\n\n\nMeasured at 240 fps with volcano executor.","tags":["auto","open source","free","keyless","simple"],"script":"local Checkpoints = workspace.Checkpoints\nlocal LocalPlayer = game.Players.LocalPlayer\nlocal Character = LocalPlayer.Character\nlocal RootPart = Character.HumanoidRootPart\nlocal Humanoid = Character.Humanoid\nlocal StageValue = LocalPlayer.leaderstats.Stage\n\nlocal function UpdateVars()\n\trepeat task.wait()\n\t\tCharacter = LocalPlayer.Character\n\t\tRootPart = Character:FindFirstChild(\"HumanoidRootPart\")\n\t\tHumanoid = Character:FindFirstChild(\"Humanoid\")\n\tuntil RootPart and Humanoid\nend\n\n--remove kill parts\nlocal LavaFloors = workspace:FindFirstChild(\"LavaFloors\")\nif LavaFloors then\n\tLavaFloors:Destroy()\nend\n\nlocal function GetStage()\n\treturn StageValue.Value\nend\nlocal function Touch(Part)\n\tUpdateVars()\n\tRootPart.CFrame = Part.CFrame * CFrame.new(0,3,0)\n\tfiretouchinterest(RootPart,Part,0)\n\tfiretouchinterest(RootPart,Part,1)\nend\n\n-- Anti-AFK\nlocal VirtualUser = game:GetService(\"VirtualUser\")\nLocalPlayer.Idled:Connect(function()\n    VirtualUser:CaptureController()\n    VirtualUser:ClickButton2(Vector2.new())\nend)\n\nwhile task.wait() do\n\tlocal CurrentStage = GetStage()\n\tlocal NextStage = CurrentStage + 1\n\tlocal CheckName = tostring(NextStage)\n\tlocal Checkpoint = nil\n\tCheckpoint = Checkpoints:FindFirstChild(CheckName)\n\tif Checkpoint then\n\t\tTouch(Checkpoint)\n\telse\n\t\tgame.ReplicatedStorage.Events.prestige:FireServer()\n\t\tHumanoid:ChangeState(Enum.HumanoidStateType.Dead)\n\tend\nend","owner":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","verified":true,"profilePicture":"/images/photo/61ecdfff4351a4a73af593b8-1714691274203.png","status":"offline","id":"61ecdfff4351a4a73af593b8","leaderboard":{"tag":{"kind":"hall","rank":5,"period":"all","metric":"views","value":11013574}},"topMilestone":{"key":"creator.views","tier":10000000}},"verified":true,"views":20543,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-80a42f538380ac6a682cda807f1ee00a-59422aff24f8.png","likeCount":1,"dislikeCount":3,"createdAt":"2025-10-09T15:09:28.047Z","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"executes":58,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68e7d0283204274c2ca3cbf5","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":"61ecdfff4351a4a73af593b8"},"message":"Create script","createdAt":"2025-10-09T15:09:28.051Z"},{"_id":"68ea97ad84d83d1a7eab640c","editBy":{"_id":"61ecdfff4351a4a73af593b8","username":"Tomato","status":"offline","id":