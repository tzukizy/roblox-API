yer = Players.LocalPlayer\n\n-- REMOTES\nlocal Action = ReplicatedStorage\n    :WaitForChild(\"Remotes\")\n    :WaitForChild(\"Server\")\n    :WaitForChild(\"Action\")\n\n-- LOAD RAYFIELD\nlocal Rayfield = loadstring(game:HttpGet(\"https://sirius.menu/rayfield\"))()\n\n-- STATE\nlocal AutoGreen = false\nlocal GreenRelease = 0.25\n\nlocal AutoDunk = false\nlocal DunkRelease = 0.25\n\n-- WINDOW\nlocal Window = Rayfield:CreateWindow({\n    Name = \"Nexual | Playground Assist\",\n    LoadingTitle = \"Nexual\",\n    LoadingSubtitle = \"Auto Green + Auto Dunk\",\n    ConfigurationSaving = {Enabled = true, FolderName = \"Nexual\", FileName = \"AssistConfigs\"}\n})\n\nlocal Tab = Window:CreateTab(\"Main\", 4483362458)\n\n-- AUTO GREEN\nTab:CreateToggle({\n    Name = \"Auto Green\",\n    CurrentValue = false,\n    Callback = function(Value)\n        AutoGreen = Value\n    end\n})\n\nTab:CreateSlider({\n    Name = \"Green Release Timing (s)\",\n    Range = {0.1, 1},\n    Increment = 0.01,\n    Suffix = \"s\",\n    CurrentValue = 0.25,\n    Callback = function(Value)\n        GreenRelease = Value\n    end\n})\n\n-- AUTO DUNK\nTab:CreateToggle({\n    Name = \"Auto Dunk\",\n    CurrentValue = false,\n    Callback = function(Value)\n        AutoDunk = Value\n    end\n})\n\nTab:CreateSlider({\n    Name = \"Dunk Release Timing (s)\",\n    Range = {0.1, 1},\n    Increment = 0.01,\n    Suffix = \"s\",\n    CurrentValue = 0.25,\n    Callback = function(Value)\n        DunkRelease = Value\n    end\n})\n\n-- LISTEN FOR REMOTE CALLS\nlocal mt = getrawmetatable(game)\nlocal old = mt.__namecall\nsetreadonly(mt, false)\nmt.__namecall = newcclosure(function(self, ...)\n    local args = {...}\n    local method = getnamecallmethod()\n\n    if self == Action and method == \"FireServer\" and args[1] and type(args[1]) == \"table\" then\n        local tbl = args[1]\n\n        -- AUTO GREEN (Shoot)\n        if tbl.Type == \"Shoot\" and tbl.Shoot == true and AutoGreen then\n            task.delay(GreenRelease, function()\n                Action:FireServer({Shoot = false, Type = \"Shoot\"})\n            end)\n        end\n\n        -- AUTO DUNK (Jump)\n        if tbl.Action == \"Jump\" and tbl.Jump == true and AutoDunk then\n            task.delay(DunkRelease, function()\n                Action:FireServer({Action = \"Jump\", Jump = false})\n            end)\n        end\n    end\n\n    return old(self, ...)\nend)\nsetreadonly(mt, true)\n\nRayfield:Notify({\n    Title=\"Nexual Loaded\",\n    Content=\"Auto Green + Auto Dunk ready\",\n    Duration=5\n})\n\nprint(\"[NEXUAL] Auto Green + Auto Dunk hooked to actual remotes\")","owner":{"_id":"6940586c53e4ff1d2475c5ca","username":"Lebronjameskdhhf","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/1a5d84e44a663e457d634b9f2d9fea2ddc5f2ff17dd2725abfd6ebdbb4d01d26.webp","original":"https://scriptblox.com/images/photo/6940586c53e4ff1d2475c5ca-1770828371438.jpeg"},"status":"offline","id":"6940586c53e4ff1d2475c5ca","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/1a5d84e44a663e457d634b9f2d9fea2ddc5f2ff17dd2725abfd6ebdbb4d01d26.webp","original":"https://scriptblox.com/images/photo/6940586c53e4ff1d2475c5ca-1770828371438.jpeg"}},"verified":false,"views":295,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://t0.rbxcdn.com/180DAY-994fed900712b1e05ed1a221490df5e5","scriptblox":"https://t0.rbxcdn.com/180DAY-994fed900712b1e05ed1a221490df5e5"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-06T18:41:06.360Z","executes":15,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:33:53.917Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://t0.rbxcdn.com/180DAY-994fed900