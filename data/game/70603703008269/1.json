{"id":70603703008269,"name":"Escape Experiment","desc":"insanely difficult escape room game (elite ball knowledge required)\n\nDEADBEEF Obby made by Emceptional","path":"/game/70603703008269-escape-experiment","slug":"70603703008269-escape-experiment","thumbnail":{"url":"https://media.kocakz.me/dc070e16a61933d222ef19c13bbe9e02733e53a0f708739f589e59886b78dfe9.webp","original":"https://tr.rbxcdn.com/180DAY-b7fc970aad4077a000e100b501b0421b/150/150/Image/Png/noFilter"},"playing":0,"visitor":76163,"verified":false,"updatedAt":"2026-02-25T11:34:21.638Z","creator":{"name":"Feodoric","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Escape-Experiment-Get-all-Badge-121914","_id":"699ede3db7126e09f31f81ab","title":"Get every Badge","game":{"_id":"699eacc6b0f455c6f0cc8f85","gameId":70603703008269,"name":"Escape Experiment","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":70603703008269},"features":"҉","tags":["Roblox","Escape Experiment","badge"],"script":"local player = game.Players.LocalPlayer\nlocal TeleportService = game:GetService(\"TeleportService\")\n\nlocal Badge1 = Vector3.new(-1940, 168, -91)\nlocal Badge3 = Vector3.new(-284, 193, -800)\n\nlocal Secrets = {\n    Vector3.new(396, -327, -10),\n    Vector3.new(-117, 308, 7),\n    Vector3.new(76, 423, -30),\n    Vector3.new(-10, 1158, -21),\n    Vector3.new(135, 248, -35)\n}\n\nlocal rejoinScript = [[\ntask.wait(0.3)\nlocal player = game.Players.LocalPlayer\nlocal pos = Vector3.new(-1940, 168, -91)\nif player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n    player.Character.HumanoidRootPart.CFrame = CFrame.new(pos)\nend\n]]\n\nif queue_on_teleport then\n    queue_on_teleport(rejoinScript)\nelseif syn and syn.queue_on_teleport then\n    syn.queue_on_teleport(rejoinScript)\nend\n\ngame:GetService(\"RunService\").Stepped:Connect(function()\n    if player.Character then\n        for _, v in pairs(player.Character:GetDescendants()) do\n            if v:IsA(\"BasePart\") then\n                v.CanCollide = false\n            end\n        end\n    end\nend)\n\nlocal function tp(pos)\n    if player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n        player.Character.HumanoidRootPart.CFrame = CFrame.new(pos)\n    end\nend\n\ntp(Badge3)\ntask.wait(1)\n\nfor _, pos in ipairs(Secrets) do\n    tp(pos)\n    task.wait(0.6)\nend\n\ntask.wait(0.3)\n\nTeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)","owner":{"_id":"6839dab1a348d24efdda9dae","username":"5345002","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6839dab1a348d24efdda9dae","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":575,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/6aacb2e814d94349c13b7a049bdf3a40b4f9da9a96fe72438635a63a151c5232.webp","original":"https://scriptblox.com/images/sb/rbx-17816678648fc1cf6820acc04a4ec0a5-64a8fc59cae2.png","scriptblox":"https://scriptblox.com/images/script/rbx-17816678648fc1cf6820acc04a4ec0a5-64a8fc59cae2.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-25T11:34:21.640Z","keyLink":"","executes":26,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:06:12.493Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/6aacb2e814d94349c13b7a049bdf3a40b4f9da9a96fe72438635a63a151c5232.webp","original":"https://scriptblox.com/images/sb/rbx-17816678648fc1cf6820acc04a4ec0a5-64a8fc59cae2.png","scriptblox":"https://script