{"id":94152549783289,"name":"[SKM!] The Urban Line: FreeDrive","desc":"Welcome to the Urban Line: FreeDrive!\nThis game is a branch-off game of the Urban Line Project, where you will get to take part in part of the map!\n\nThe Urban Line Project: FreeDrive features trains and stations from the Hong Kong's Mass Transit Railway (MTR), as of right now, the game operates from Po Lam to North Point and Tiu Keng Leng to Shek Kip Mei. Come and experience being a train operator inside of the network, serve passengers, play announcements, control train doors, everything is under your control!\n\nYou may join a shift through the Server tab in the main menu whenever a shift is ongoing.","path":"/game/94152549783289-the-urban-line-freedrive","slug":"94152549783289-the-urban-line-freedrive","thumbnail":{"url":"https://media.kocakz.me/54e5275433a62452dceb61e3c301a69a6878cc2c43838ad35872fa0f4625f7de.webp","original":"https://tr.rbxcdn.com/180DAY-d7a05706583a963d766b497d6f6d47f7/150/150/Image/Png/noFilter"},"playing":41,"visitor":3325019,"verified":false,"updatedAt":"2026-09-19T05:54:00.007Z","creator":{"name":"Cloud Workshop","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"SKM!-The-Urban-Line:-FreeDrive-INFINITE-MONEY-and-XP-OP-228851","_id":"6aae08d45ab96866958bb172","title":"INFINITE MONEY & XP [OP]","game":{"_id":"6aae08d45ab96866958bb171","gameId":94152549783289,"name":"[SKM!] The Urban Line: FreeDrive","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":94152549783289},"features":"- infinite money\n- infinite xp","tags":[],"script":"loadstring(game:HttpGet('https://pastebin.com/raw/f3J22vpM'))()","owner":{"_id":"62f1d2fb774d59be4f166ca2","username":"Cat_uwu","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":7,"status":"offline","id"