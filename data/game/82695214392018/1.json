.x / workspace.CurrentCamera.ViewportSize.y) * sizey\nLighting.Brightness = 2\nLighting.ClockTime = 14\nLighting.FogEnd = 100000\nLighting.GlobalShadows = false\nLighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)\nwait(1)\npart.CFrame = workspace.CurrentCamera.CFrame + workspace.CurrentCamera.CFrame.LookVector * 10\npart.Size = Vector3.new(sizex, sizey, 2)\nlocal decal = Instance.new(\"Decal\", part)\ndecal.Face = Enum.NormalId.Back\ndecal.Texture = imgID","owner":{"_id":"66f701d0bad6558f11a71e92","username":"kylosillyy","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9dc153d6e0068ce5474e2de37eccc66e4c8dc36434ab6dd5bf7bb3340b9dc6ae.webp","original":"https://scriptblox.com/images/photo/66f701d0bad6558f11a71e92-1727517558527.png"},"status":"offline","id":"66f701d0bad6558f11a71e92","profile":{"url":"https://cdn.kocakz.me/images/9dc153d6e0068ce5474e2de37eccc66e4c8dc36434ab6dd5bf7bb3340b9dc6ae.webp","original":"https://scriptblox.com/images/photo/66f701d0bad6558f11a71e92-1727517558527.png"}},"verified":false,"keyLink":"","views":21508,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-10-26T01:02:19.730Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/885591c2c6c19142e537147df328edfe0f7c65cd576829a4f8421298b5925bc3.webp","original":"https://scriptblox.com/images/sb/82695214392018-1729904539634.png","scriptblox":"https://scriptblox.com/images/script/82695214392018-1729904539634.png"},"executes":324,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T04:30:49.147Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/885591c2c6c19142e537147df328edfe0f7c65cd576829a4f8421298b5925bc3.webp","original":"https://scriptblox.com/images/sb/82695214392018-1729904539634.png","scriptblox":"https://scriptblox.com/images/script/82695214392018-1