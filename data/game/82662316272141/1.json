eBtn(txt, yPos)\n    local b = Instance.new(\"TextButton\", frame)\n    b.Size = UDim2.new(1, -10, 0, 40)\n    b.Position = UDim2.new(0, 5, 0, yPos)\n    b.Text = txt\n    b.BackgroundColor3 = Color3.fromRGB(180, 50, 50)\n    return b\nend\n\nlocal tpBtn = makeBtn(\"TP All: OFF\", 5)\nlocal clickBtn = makeBtn(\"Spam: OFF\", 50)\n\n-- --- SETTINGS ---\nlocal tpActive = false\nlocal spamActive = false\n\n-- --- THE LOGIC ---\n\n-- 1. TELEPORT TO EVERYTHING (Aggressive Search)\ntask.spawn(function()\n    while task.wait(0.1) do\n        if tpActive then\n            local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n            if root then\n                for _, obj in pairs(game.Workspace:GetDescendants()) do\n                    -- This looks for names containing \"Hidden\" or \"Gift\" or \"Coin\"\n                    -- EDIT THESE WORDS to match your game's items\n                    if obj:IsA(\"BasePart\") and (obj.Name:find(\"Hidden\") or obj.Name:find(\"Point\")) then\n                        print(\"Found target: \" .. obj.Name) -- Check F9 console\n                        player.Character:PivotTo(obj.CFrame)\n                        task.wait(0.3) -- Small delay so the game registers you were there\n                    end\n                end\n            end\n        end\n    end\nend)\n\n-- 2. CLICK EVERYTHING NEARBY\ntask.spawn(function()\n    while task.wait() do\n        if spamActive then\n            for _, v in pairs(game.Workspace:GetDescendants()) do\n                -- This targets ANY ClickDetector or ProximityPrompt in the game\n                if v:IsA(\"ClickDetector\") then\n                    fireclickdetector(v)\n                elseif v:IsA(\"ProximityPrompt\") then\n                    fireproximityprompt(v)\n                end\n            end\n        end\n    end\nend)\n\n-- --- BUTTON TOGGLES ---\ntpBtn.MouseButton1Click:Connect(function()\n    tpActive = not tpActive\n    tpBtn.Text = tpActive and \"TP All: ON\" or \"TP All: OFF\"\n    tpBtn.BackgroundColor3 = tpActive and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)\nend)\n\nclickBtn.MouseButton1Click:Connect(function()\n    spamActive = not spamActive\n    clickBtn.Text = spamActive and \"Spam: ON\" or \"Spam: OFF\"\n    clickBtn.BackgroundColor3 = spamActive and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)\nend)","owner":{"_id":"6927a8dbdb1049caeff32285","username":"1ce1cey","verified":false,"profilePicture":"/images/photo/6927a8dbdb1049caeff32285-1767401646460.png","status":"offline","id":"6927a8dbdb1049caeff32285","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":463,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-e8a2862b39627228a891003782f004bd-9ed4fabea547.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-02-03T00:35:42.434Z","executes":35,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"698142de1a5b23101377ab0f","editBy":{"_id":"6927a8dbdb1049caeff32285","username":"1ce1cey","status":"offline","id":"6927a8dbdb1049caeff32285"},"message":"Create script","createdAt":"2026-02-03T00:35:42.435Z"}],"comments":[{"_id":"699ec1302268c1da6f2f2d80","commentBy":{"_id":"69975784f0045c3983d1efa9","username":"Bahlil_Lahadalia","verified":false,"role":"user","profilePicture":"/images/photo/69975784f0045c3983d1efa9-1771526117226.jpg","lastActive":"2026-03-07T07:42:17.960Z","createdAt":"2026-02-19T18:33:40.521Z","status":"offline","id":"69975784f0045c3983d1efa9"},"text":"why u made this?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-25T09:30:24.594Z","liked":false,"disliked":false}]}]}