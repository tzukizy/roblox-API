ocal args = { [1] = 'BridgeLight' }\n        game:GetService('ReplicatedStorage')\n            :WaitForChild('RemoteEvents', 9e9)\n            :WaitForChild('AdminOverrideEvent', 9e9)\n            :FireServer(unpack(args))\n        print('Bridge Light activated')\n    end,\n})\n\n-- Barrier button\nfolder:button({\n    name = 'Barrier',\n    callback = function()\n        local args = { [1] = 'Barrier' }\n        game:GetService('ReplicatedStorage')\n            :WaitForChild('RemoteEvents', 9e9)\n            :WaitForChild('AdminOverrideEvent', 9e9)\n            :FireServer(unpack(args))\n        print('Barrier activated')\n    end,\n})\n\nfolder2:button({\n    name = 'Teleport to End',\n    callback = function()\n        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame =\n            CFrame.new(212.1660614013672, 172.699951171875, -2.9824163913726807)\n    end,\n})\n\nfolder3:button({\n    name = 'Made By UILib',\n    callback = function() end,\n})\n\nfolder3:button({\n    name = 'Take What You Want from this',\n    callback = function() end,\n})\n","owner":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","verified":false,"profilePicture":"/images/photo/68041bdbaf3d8ab50c6cb1a8-1765231278579.jpg","status":"offline","id":"68041bdbaf3d8ab50c6cb1a8","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"discord":"https://discord.gg/QYRBbM4gHp","views":8047,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/8032701413-1757009005856.png","likeCount":3,"dislikeCount":2,"createdAt":"2025-09-04T18:03:25.881Z","editBy":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","status":"offline","id":"68041bdbaf3d8ab50c6cb1a8"},"executes":95,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b9d46df0504c5ab8b78afa","editBy":{"_id":"68041bdbaf3d8ab50c6cb1a8","username":"SouljaWitchSrc","status":"offline","id":"68041bdbaf3d8ab50c6cb1a8