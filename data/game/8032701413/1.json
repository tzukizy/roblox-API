ency = 0\n          if glass:FindFirstChild(\"GlassFall\") and glass:FindFirstChild(\"TouchInterest\")then\n              Instance.new(\"Highlight\", glass).FillColor = Color3.fromRGB(0,255,0)\n          elseif glass:FindFirstChild(\"TouchInterest\") and not glass:FindFirstChild(\"GlassFall\") then\n              Instance.new(\"Highlight\", glass).FillColor = Color3.fromRGB(255,0,0)\n          end\n       end\n    end\nend","owner":{"_id":"669e0c4e230099640a550a15","username":"TOG3","verified":false,"profilePicture":"/images/photo/669e0c4e230099640a550a15-1722342210656.png","status":"offline","id":"669e0c4e230099640a550a15","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":7058,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-e510d7e72d43d4bb27a2269a759a68e8-3dffbd56e8fa.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-07-17T16:46:00.505Z","executes":184,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"687928c89aec2664d8e7d08b","editBy":{"_id":"669e0c4e230099640a550a15","username":"TOG3","status":"offline","id":"669e0c4e230099640a550a15"},"message":"Create script","createdAt":"2025-07-17T16:46:00.508Z"}],"comments":[{"_id":"687946370052336769224dba","commentBy":{"_id":"6745307c03c43cc2b837b788","username":"idi12345asdu1urj2hj","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-11-26T02:20:44.053Z","lastActive":"2025-08-22T14:07:53.200Z","status":"offline","id":"6745307c03c43cc2b837b788"},"text":"gl*","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-07-17T18:51:35.031Z","liked":false,"disliked":false},{"_id":"687a0adfac8ffa135350a613","commentBy":{"_id":"669e0c4e230099640a550a15","username":"TOG3","verified":false,"role":"user","profilePicture":"/images/photo/669e0c4e230099640a550a15-1722342210656.png","createdAt":"2024-07-22T07:37:50.749Z","lastActive":"2025-09-04T13:28:13