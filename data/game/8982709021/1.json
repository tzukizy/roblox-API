tService(\"Players\").LocalPlayer.PlayerGui.MainGui.HUD.PlayerStats.EnergyStatus.Percentage.Text ~= \"100%\" then\n        Remotes[\"Sleep\"]:InvokeServer(HouseThings.Sleep)\n    end\n    if Automatic.Food and game:GetService(\"Players\").LocalPlayer.PlayerGui.MainGui.HUD.PlayerStats.FoodStatus.Percentage.Text ~= \"100%\" then\n        Remotes[\"Food\"]:InvokeServer(\"water\")\n    end\nend)","owner":{"_id":"61fdab304784a7c52f84efd0","username":"Alleexxii","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61fdab304784a7c52f84efd0-1644014449205.jpg"},"status":"offline","id":"61fdab304784a7c52f84efd0","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61fdab304784a7c52f84efd0-1644014449205.jpg"}},"verified":false,"views":5641,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-04-13T10:25:26.605Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/cc9accdabe4b2f13a962a0f4f980f163/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/cc9accdabe4b2f13a962a0f4f980f163/500/280/Image/Jpeg"},"executes":2,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:25:08.400Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/cc9accdabe4b2f13a962a0f4f980f163/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/cc9accdabe4b2f13a962a0f4f980f163/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b309","editBy":{"_id":"61fdab304784a7c52f84efd0","username":"Alleexxii","status":"offline","id":"61fdab304784a7