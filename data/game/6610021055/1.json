on discord [dm/add me if any issues]\nlocal character = game:GetService(\"Players\").LocalPlayer.Character\n\nlocal map = game:GetService(\"Workspace\").Map\nlocal treasures = map.Treasures\nlocal obby_land = map.ObbyLand\n\ngetgenv().settings = {\n    -- main setting\n    auto_farm = true, -- false to turn off\n    -- misc setting\n    farm_treasures = true -- collects all chest around map if true\n}\n\nfunction get_time()\n    return os.date(\"%X\")\nend\n\nif (settings.auto_farm) then\n    repeat\n        local teleporters = obby_land.Teleporters\n        local finish = obby_land.Finish\n        if (#teleporters:GetChildren() == 0) or (#finish:GetChildren() == 0) then\n            rconsoleprint(\"[Auto Farm] Teleporter or finish folder is empty. Attempting to fix. \"..get_time()..\"\\n\")\n            character:SetPrimaryPartCFrame(CFrame.new(obby_land.Model:GetPivot().Position))\n            rconsoleprint(\"[Auto Farm] Empty folders fixed. \"..get_time()..\"\\n\")\n            task.wait(2)\n        end\n        local final_obby_teleporter = teleporters[\"11\"]\n        local final_obby_finish = finish[\"11\"]\n        character:SetPrimaryPartCFrame(CFrame.new(final_obby_teleporter.Position))\n        rconsoleprint(\"[Auto Farm] Starting last obby. \"..get_time()..\"\\n\")\n        task.wait(.5)\n        fireproximityprompt(final_obby_teleporter.ProximityPrompt)\n        task.wait(5)\n        character:SetPrimaryPartCFrame(CFrame.new(final_obby_finish.Position))\n        rconsoleprint(\"[Auto Farm] Teleported to the end. \"..get_time()..\"\\n\")\n        task.wait(.5)\n        fireproximityprompt(final_obby_finish.ProximityPrompt)\n        rconsoleprint(\"[Auto Farm] Claimed 20k. \"..get_time()..\"\\n\")\n        task.wait(.5)\n        if (#treasures:GetChildren() < 3) then\n            continue\n        end\n        rconsoleprint(\"[Auto Farm] Collecting treasures. \"..get_time()..\"\\n\")\n        for _, v in treasures:GetChildren() do\n            local prompt = v:FindFirstChildWhichIsA(\"ProximityPrompt\")\n            if (not prompt) then\n                continue\n            end\n            character:SetPrimaryPartCFrame(CFrame.new(v.Position + Vector3.new(0, 20, 0)))\n            task.wait(.5)\n            fireproximityprompt(prompt)\n        end\n    until (not settings.auto_farm)\n    rconsoledestroy()\nend","owner":{"_id":"68c54d7e0985bed96e33514b","username":"CatBoyy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/91cc1b7e6cb57e82c46a1d70783107012e27ef6f960522852ee487d37bc849f8.webp","original":"https://scriptblox.com/images/photo/68c54d7e0985bed96e33514b-1757760986018.png"},"status":"offline","id":"68c54d7e0985bed96e33514b","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/91cc1b7e6cb57e82c46a1d70783107012e27ef6f960522852ee487d37bc849f8.webp","original":"https://scriptblox.com/images/photo/68c54d7e0985bed96e33514b-1757760986018.png"}},"verified":false,"views":9718,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/6c1f78df5a0acc340eb49d389a8b96f209fdb18fa18600cf3fca5fb692cda21c.webp","original":"https://scriptblox.com/images/sb/6610021055-1759505882545.png","scriptblox":"https://scriptblox.com/images/script/6610021055-1759505882545.png"},"likeCount":2,"dislikeCount":3,"createdAt":"2025-10-03T15:03:23.589Z","editBy":{"_id":"68c54d7e0985bed96e33514b","username":"CatBoyy","status":"offline","id":"68c54d7e0985bed96e33514b"},"executes":1917,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:11:33.355Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/6c1f78df5a0acc340eb49d389a8b96f209fdb18fa18600cf3fca5fb692cda21c.webp","original":"https://scriptblox.com/images/sb/6610021055-1759505882545.png","scriptblox":"https://