edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-01T21:49:54.635Z","liked":false,"disliked":false},{"_id":"6abee5429a03142544c181a8","commentBy":{"_id":"69b5e40ded9548b283e3e579","username":"Mysticall","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-10-12T18:52:14.772Z","createdAt":"2026-03-14T22:41:17.438Z","status":"offline","id":"69b5e40ded9548b283e3e579","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"@PoDs yes","parent":{"_id":"6a4cfbc433cfabd7e5295a09","commentBy":{"_id":"6a4cfb51caecb20cdf8ebc48","username":"PoDs","profilePicture":"/images/user-default.webp","status":"offline","id":"6a4cfb51caecb20cdf8ebc48"},"text":"is this still working?"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-01T22:57:06.420Z","liked":false,"disliked":false},{"_id":"6ac471a9a645fbe948a296be","commentBy":{"_id":"67514d7efa4a7c4b694276f4","username":"JuanchoXD","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/47bdd403d51e2bbfc595f38f323bd61efdc56d56fc9809ead77d326a4315527e.webp","original":"https://scriptblox.com/images/photo/67514d7efa4a7c4b694276f4-1791073403262.jpg"},"createdAt":"2024-12-05T06:51:42.280Z","lastActive":"2026-10-12T21:20:03.008Z","lvl":10,"status":"offline","id":"67514d7efa4a7c4b694276f4","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/47bdd403d51e2bbfc595f38f323bd61efdc56d56fc9809ead77d326a4315527e.webp","original":"https://scriptblox.com/images/photo/67514d7efa4a7c4b694276f4-1791073403262.jpg"}},"text":"W","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-06T03:57:29.263Z","liked":false,"disliked":false}]},{"slug":"Noob-Army-Tycoon-(New-noobs)-noob-army-tycoon-script-by-ai-very-simple-184306","_id":"69d145d0b05476dff085b06c","title":"noob army tycoon script by ai very simple","game":{"_id":"68dfe5bb2d2cab8e37340d5e","gameId":6610021055,"name":"Noob Army Tycoon ⚔️(New noobs)","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":6610021055},"features":"10k/s","tags":[],"script":"local TweenService = game:GetService(\"TweenService\")\nlocal Player = game.Players.LocalPlayer\nlocal pGui = Player:WaitForChild(\"PlayerGui\")\n\n-- Usuwanie starego GUI\nif pGui:FindFirstChild(\"AutoFarmGui\") then pGui.AutoFarmGui:Destroy() end\n\n-- Tworzenie GUI\nlocal sg = Instance.new(\"ScreenGui\", pGui)\nsg.Name = \"AutoFarmGui\"\n\nlocal frame = Instance.new(\"Frame\", sg)\nframe.Size = UDim2.new(0, 200, 0, 100)\nframe.Position = UDim2.new(0.1, 0, 0.5, -50)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.Active = true\nframe.Draggable = true\n\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1, 0, 0, 30)\ntitle.Text = \"Auto-Farm Obby\"\ntitle.TextColor3 = Color3.new(1, 1, 1)\ntitle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\n\nlocal toggleBtn = Instance.new(\"TextButton\", frame)\ntoggleBtn.Size = UDim2.new(0.8, 0, 0.4, 0)\ntoggleBtn.Position = UDim2.new(0.1, 0, 0.45, 0)\ntoggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)\ntoggleBtn.Text = \"OFF\"\ntoggleBtn.TextColor3 = Color3.new(1, 1, 1)\ntoggleBtn.Font = Enum.Font.SourceSansBold\n\nlocal close = Instance.new(\"TextButton\", frame)\nclose.Size = UDim2.new(0, 20, 0, 20)\nclose.Position = UDim2.new(1, -25, 0, 5)\nclose.Text = \"X\"\nclose.BackgroundColor3 = Color3.new(0.6, 0, 0)\nclose.MouseButton1Click:Connect(function() sg:Destroy() end)\n\n-- LOGIKA\nlocal isFarming = false\n\nlocal function FastTeleportAndTrigger(namePart)\n    local char = Player.Character\n    local root = char and char:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return false end\n\n    for _, v in pairs(game:GetDescendants()) do\n        if v:IsA(\"ProximityPrompt\") and (v.Parent.Name:find(namePart) or v.ActionText:find(namePart)) then\n            local targetCFrame = v.Parent.CFrame\n            \n            -- Szybki ruch (Tween)\n            local t = TweenService:Create(root, TweenInfo.new(0.15), {CFrame = targetCFrame})\n            t:Play()\n            t.Completed:Wait()\n            \n            -- Aktywacja\n            v:InputHoldBegin()\n            v:InputHoldEnd()\n            task.wait(0.05)\n            return true\n        end\n    end\n    return false\nend\n\n-- PĘTLA FARMIEANIA\ntask.spawn(function()\n    while true do\n        if isFarming then\n            local char = Player.Character\n            local root = char and char:FindFirstChild(\"HumanoidRootPart\")\n            \n            if root then\n                local startPos = root.CFrame\n                \n                -- Krok 1: Teleport do Obby\n                FastTeleportAndTrigger(\"Teleport to obby 11\")\n                task.wait(0.2)\n                \n                -- Krok 2: Odbiór kasy\n                FastTeleportAndTrigger(\"Claim 20000$\")\n                \n                -- Krok 3: Powrót (opcjonalnie, żeby nie stać w miejscu nagrody)\n                root.CFrame = startPos\n            end\n        end\n        task.wait(0.5) -- Czas między cyklami (zmień na mniejszy dla szybkości)\n    end\nend)\n\n-- Przełącznik\ntoggleBtn.MouseButton1Click:Connect(function()\n    isFarming = not isFarming\n    if isFarming then\n        toggleBtn.Text = \"ON (Farming...)\"\n        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)\n    else\n        toggleBtn.Text = \"OFF\"\n        toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)\n    end\nend)","owner":{"_id":"67e5c97681907078781ff0bd","username":"janicki535","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67e5c97681907078781ff0bd","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.