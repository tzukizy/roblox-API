{"id":74942575319599,"name":"Omnidroids Test","desc":"","path":"/game/74942575319599-omnidroids-test","slug":"74942575319599-omnidroids-test","thumbnail":["https://tr.rbxcdn.com/180DAY-a5bd1ab0bcc051e22ab9a63c96ccfcca/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-bd182c3b5441df4bf51b5960f520fd88/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":181,"visitor":0,"verified":false,"updatedAt":"2025-12-10T12:28:14.924Z","creator":{"name":"Roblox","type":"User"},"script":{"count":5,"freeCount":5,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Omnidroids-Test-GET-ALL-POWERS-MADE-BY-ROBLOX999RONALDO-NEW-UPDATE-73902","_id":"6939621ff002b181cac56798","title":"GET ALL POWERS","game":{"_id":"68eaa00a9c55f8d3c5f0bd8a","gameId":74942575319599,"name":"Omnidroids Test","imageUrl":"/images/sb/rbx-bd182c3b5441df4bf51b5960f520fd88-e82b3002787e.png","placeId":74942575319599},"features":"GET ALL POWERS","tags":["Omnidroids Test","Omnidroid","Omnidroid test","KRONOS","MR INCRDIBLE"],"script":"-- Omnidroids Powers GUI - made by roblox999ronaldo (English and new version)\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\n\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"OmnidroidsPowersGUI\"\ngui.ResetOnSpawn = false\ngui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\")\n\nlocal frame = Instance.new(\"Frame\", gui)\nframe.Size = UDim2.new(0, 300, 0, 280)\nframe.Position = UDim2.new(0.5, -150, 0.5, -140)\nframe.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nframe.Active = true\nframe.Draggable = true\n\nlocal title = Instance.new(\"TextLabel\", frame)\ntitle.Size = UDim2.new(1, 0, 0, 30)\ntitle.Text = \"Omnidroids Powers\"\ntitle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\ntitle.TextColor3 = Color3.fromRGB(255, 255, 255)\ntitle.Font = Enum.Font.GothamBold\ntitle.TextSize = 14\n\n-- Updated coordinates (2025 accurate)\nlocal powers = {\n    {name = \"Gazerbeam\",     position = Vector3.new(-903.55, 35.15, -2493.11)},\n    {name = \"Frozone\",       position = Vector3.new(-296.68, 564.52, -4215.29)},\n    {name = \"Gamma Jack\",    position = Vector3.new(131.10, 60.81, -826.88)},\n    {name = \"Thunderhead\",   position = Vector3.new(1392.57, 52.32, 481.39)},\n    {name = \"Hypershock\",    position = Vector3.new(1693.47, 131.75, -4437.13)}\n}\n\nfor i, power in ipairs(powers) do\n    local btn = Instance.new(\"TextButton\", frame)\n    btn.Size = UDim2.new(0, 280, 0, 40)\n    btn.Position = UDim2.new(0, 10, 0, 30 + (i * 45))\n    btn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)\n    btn.TextColor3 = Color3.fromRGB(255, 255, 255)\n    btn.Font = Enum.Font.GothamBold\n    btn.TextSize = 16\n    btn.Text = power.name\n\n    btn.MouseButton1Click:Connect(function()\n        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n        local hrp = char:WaitForChild(\"HumanoidRootPart\", 5)\n        if hrp then\n            hrp.CFrame = CFrame.new(power.position)\n        end\n    end)\nend","owner":{"_id":"689395cf3b11d3ebd1e7c7a0","username":"OHIOOOO","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"689395cf3b11d3ebd1e7c7a0","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":698,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/74942575319599-1765368351072.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2025-12-10T12:05:51.090Z","keyLink":"","executes":199,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6939621ff002b181cac5679a","editBy":{"_id":"689395cf3b11d3ebd1e7c7a0","username":"OHIOOOO","status":"offline","id":"689395cf3b11d3ebd1e7c7a0"},"message":"Create script","createdAt":"2025-12-10T12:05:51.093Z"}],"comments":[{"_id":"693965758ca0397aaf7bb872","commentBy":{"_id":"65ba13a60b97ce4920fcceb3","username":"TechNick","verified":false,"role":"user","profilePictu