{"id":6159892946,"name":"Aim Trainer","desc":"MAJOR UPDATE AT 30,000 👍\n\n🕹️ Explore and play a variety of modes!\n\n🏆 Compete on the leaderboards with your scores!\n\n🎯 Practice to improve your aim in other games!\n\n📝 Last update:\n- Monthly leaderboards\n- New theme song\n\nDeveloped by Avallachi\n\nTags: mouse aim, finger swipe, precision shooting, target practice, reflex, hand-eye coordination, accuracy improvement, virtual shooting range, reaction time, sniper, FPS trainer, crosshair control","path":"/game/6159892946-aim-trainer","slug":"6159892946-aim-trainer","thumbnail":{"url":"https://media.kocakz.me/c1954cf3a4fed4778ce4ee5d3f29b37521883b03314e7dc2b8008922726fdb6b.webp","original":"https://tr.rbxcdn.com/180DAY-50fab83936e3fc2506f4839f4d96e7e2/150/150/Image/Png/noFilter"},"playing":0,"visitor":6627853,"verified":false,"updatedAt":"2022-10-15T23:12:59.093Z","creator":{"name":"Avallachi","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"_id":"634b3e7bbc30ce32758b0f4b","title":"Autoplayer","game":{"_id":"67e5e1ffb360710ec3c789c5","gameId":6159892946,"name":"Aim Trainer","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"6159892946-aim-trainer","path":"/game/6159892946-aim-trainer","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":6159892946},"slug":"Aim-Trainer-Autoplayer-6515","verified":false,"key":false,"keyless":false,"views":22398,"executes":198,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/bc37d28d7fbba8350c0e20e2982187b1/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/bc37d28d7fbba8350c0e20e2982187b1/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/bc37d28d7fbba8350c0e20e2982187b1/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/bc37d28d7fbba8350c0e20e2982187b1/500/280/Image/Jpeg"},"likeCount":0,"dislikeCount":0,"createdAt":"2022-10-15T23:12:59.093Z","updatedAt":"2022-10-15T23:12:59.093Z","lastBump":"2022-10-15T23:12:59.093Z","script":"-- https://www.roblox.com/games/6159892946/Aim-Trainer\n-- https://github.com/dragonssk/misc-releases/blob/main/aim-trainer-autoplayer.lua\n\nlocal toggle = false\nlocal userInputService = game:GetService('UserInputService')\nlocal local_mouse = game:GetService('Players').LocalPlayer:GetMouse()\n\nworkspace.Effects:Destroy()\n\ngame:GetService('UserInputService').InputBegan:Connect(function(input)\n    if input.KeyCode == Enum.KeyCode.F then\n        toggle = not toggle\n    end\nend)\n\nwhile task.wait() do\n    if #workspace.Targets:GetChildren() ~= 0 and toggle then\n        local target_v3 = workspace.CurrentCamera:WorldToViewportPoint(workspace.Targets:GetChildren()[1].Position)\n        local mouse = userInputService:GetMouseLocation()\n        mousemoverel(-(mouse.X-target_v3.X), -(mouse.Y-target_v3.Y))\n    end\n    if local_mouse.Target.Parent == workspace.Targets then\n        mouse1click()\n    end\nend","features":"How to use\n\nBreak one target\nPress F to toggle on/off\n\nnot made by me","tags":[],"discord":"","keyLink":"","owner":{"_id":"62ee25c0a9946ba07d039692","username":"gore","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62ee25c0a9946ba07d039692-1663941164853.png"},"lvl":19,"status":"offline","id":"62ee25c0a9946ba07d039692","topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/62ee25c0a9946ba07d039692-1663941164853.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T