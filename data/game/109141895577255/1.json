{"id":109141895577255,"name":"My Coding Company","desc":"🏢 Code your business empire from scratch!\n\n👨‍💻 Hire software developers!\n💼 Upgrade your office!\n💻 Buy better computers!\n📈 Invest in the stock market!\n🏬 Unlock new companies!\n🐶 Buy NFTs to multiply your cash flow!\n☄️ Collect meteors and craft Quantum Artifacts!","path":"/game/109141895577255-my-coding-company","slug":"109141895577255-my-coding-company","thumbnail":{"url":"https://media.kocakz.me/6a23d1826e0bd34b0cf4395d4a90c7ee9802af5c2fdbd3018a45f67c7839007b.webp","original":"https://tr.rbxcdn.com/180DAY-a247ff054928446cc0653492369b999a/150/150/Image/Png/noFilter"},"playing":27,"visitor":4654696,"verified":false,"updatedAt":"2026-04-25T07:06:58.511Z","creator":{"name":"RoDark Studios","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"_id":"69ec6812b6b2745971c01348","title":"Auto Complete Coding","game":{"_id":"69ebf680a2eb8a6ef2dcc5ef","gameId":109141895577255,"name":"My Coding Company","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"109141895577255-my-coding-company","path":"/game/109141895577255-my-coding-company","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":109141895577255},"slug":"Coding-Simulator-2-Auto-Complete-Coding-206170","verified":false,"key":false,"keyless":false,"views":4437,"executes":222,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/4c065cef411bb0cdfca181143d4d5e136a428678de64aee70bbaedb34a5a0957.webp","original":"https://scriptblox.com/images/sb/rbx-a375800280f2348334e491d56c055fb6-c39fdf73f857.png","scriptblox":"https://scriptblox.com/images/script/rbx-a375800280f2348334e491d56c055fb6-c39fdf73f857.png"},"thumbnail":{"url":"https://media.kocakz.me/4c065cef411bb0cdfca181143d4d5e136a428678de64aee70bbaedb34a5a0957.webp","original":"https://scriptblox.com/images/sb/rbx-a375800280f2348334e491d56c055fb6-c39fdf73f857.png","scriptblox":"https://scriptblox.com/images/script/rbx-a375800280f2348334e491d56c055fb6-c39fdf73f857.png"},"likeCount":6,"dislikeCount":1,"createdAt":"2026-04-25T07:06:58.519Z","updatedAt":"2026-04-25T07:06:58.519Z","lastBump":"2026-04-25T07:06:58.519Z","script":"local UIS=game:GetService(\"UserInputService\")\nlocal p=game.Players.LocalPlayer\nlocal RS=game:GetService(\"ReplicatedStorage\")\nlocal RunService=game:GetService(\"RunService\")\n\nlocal h=workspace.Interiors.Offices[tostring(p.UserId)].Items.Hardware\nlocal mines=workspace.Interiors.Mines\nlocal fishing=workspace.Map.World1:WaitForChild(\"FishingSpots\")\nlocal meteors=workspace.RunTime:WaitForChild(\"Meteors\")\n\nlocal store=RS.Remotes.Server.Software.Store\nlocal complete=RS.Remotes.Server.CompletePlayerCodingProgram\nlocal bubble=RS.Remotes.Server.PopProgrammingBubble\nlocal ore=RS.Remotes.Server.Mining.UpdateOreHealth\nlocal fish=RS.Remotes.Server.Fishing.ResolveFishingAttempt\n\nlocal gui=Instance.new(\"ScreenGui\")\ngui.ResetOnSpawn=false\ngui.Parent=p:WaitForChild(\"PlayerGui\")\n\nlocal label=Instance.new(\"TextLabel\",gui)\nlabel.Size=UDim2.new(0,160,0,30)\nlabel.Position=UDim2.new(1,-170,1,-40)\nlabel.BackgroundTransparency=1\nlabel.TextScaled=true\nlabel.Font=Enum.Font.SourceSansBold\nlabel.RichText=true\nlabel.TextStrokeTransparency=0\nlabel.TextStrokeColor3=Color3.new(0,0,0)\n\nlocal function setStatus(on)\n    label.Text=\"<font color='rgb(255,255,255)'>[L] Farm:</font> \"..(on and \"<font color='rgb(0,255,0)'>ON</font>\" or \"<font color='rgb(255,0,0)'>OFF</font>\")\nend\n\nlocal run=false\nsetStatus(false)\n\nUIS.InputBegan:Connect(function(i,gp)\n    if gp or i.KeyCode~=Enum.KeyCode.L then return end\n    run=not run\n    setStatus(run)\n\n    if run then\n        task.spawn(function()\n            while run do\n                for _,v in ipairs(h:GetDescendants()) do\n                    if v.Name==\"Pc\" and v:IsA(\"Model\") then\n                        local id=v:GetAttribute(\"Id\")\n                        if id then pcall(store.InvokeServer,store,id) task.wait(.1) end\n                    end\n                end\n\n                pcall(complete.InvokeServer,complete)\n                bubble:FireServer(\"3\")\n\n                for m=1,3 do for a=1,3 do\n                    local area=mines[\"Mine\"..m].OreSpawns[\"Area\"..a]\n                    for s=1,#area:GetChildren() do\n                        ore:InvokeServer(m,a,s)\n                    end\n                end end\n\n                for i=1,#fishing:GetChildren() do\n                    pcall(function() fish:InvokeServer(i,true) end)\n                end\n\n                task.wait(.3)\n            end\n        end)\n\n        task.spawn(function()\n            while run do\n                local root=(p.Character or p.CharacterAdded:Wait()):WaitForChild(\"HumanoidRootPart\")\n                local cf=root.CFrame*CFrame.new(0,0,-6)\n\n                for _,mtr in ipairs(meteors:GetChildren()) do\n                    for _,v in ipairs(mtr:GetDescendants()) do\n                        if v:IsA(\"BasePart\") then\n                            v.Anchored=true\n                            v.AssemblyLinearVelocity=Vector3.zero\n                            v.AssemblyAngularVelocity=Vector3.zero\n                        end\n                    end\n\n                    if mtr:IsA(\"Model\") then\n                        mtr:PivotTo(cf)\n                    else\n                        local bp=mtr:FindFirstChildWhichIsA(\"BasePart\",true)\n                        if bp then bp.CFrame=cf end\n                    end\n\n                    local prompt=mtr:FindFirstChildWhichIsA(\"ProximityPrompt\",true)\n                    if prompt then\n                        prompt.HoldDuration=0\n                        fireproximityprompt(prompt)\n                    end\n                end\n\n                RunService.Heartbeat:Wait()\n            end\n        end)\n    end\nend)","features":"Toggle \"L\" while sitting at the computer.\n\nAuto Upload\nAuto Meteor\nAuto Mining (Unlock Area 3 first)\nAuto Fishing (Unlock Area 4)\nAuto Complete Coding\nAuto Pop Bubble (No Pop, Still Get Diamonds)","tags":["simulator"],"discord":"","keyLink":"","owner":{"_id":"6200f4395afab42209d0bb3e","username":"NOOB","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c30e69bcd0197b1b61f26072a55687a0db31d3ea6394a79ad250d840ac7b0456.webp","original":"https://scriptblox.com/images/photo/6200f4395afab42209d0bb3e-1780959855076.jpg"},"status":"offline","id":"6200f4395afab42209d0bb3e","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/c30e69bcd0197b1b61f26072a55687a0db31d3ea6394a79ad250d840ac7b0456.webp","original":"https://scriptblox.com/images/photo/6200f4395afab42209d0bb3e-1780959855076.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:22:38.430Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69ec6812b6b2745971c0134b","editBy":{"_id":"6200f4395afab42209d0bb3e","username":"NOOB","status":"offline","id":"6200f4395afab42209d0bb3e"},"message":"Upload","createdAt":"2026-04-25T07:06:58.524Z"},{"_id":"69ec98a77397a8686d33cb67","editBy":{"_id":"6200f4395afab42209d0bb3e","username":"NOOB","status":"offline","id":"6200f4395afab42209d0bb3e"},"message":"Update script","createdAt":"2026-04-25T10:34:15.905Z"},{"_id":"69ed712657ae7911aae63e5f","editBy":{"_id":"6200f4395afab42209d0bb3e","username":"NOOB","status":"offline","id":"6200f4395afab42209d0bb3e"},"message":"Added Auto Fish","createdAt":"2026-04-26T01:57:58.563Z"},{"_id":"69ed7de982cfb8973a6f4618","editBy":{"_id":"6200f4395afab42209d0bb3e","username":"NOOB","status":"offline","id":"6200f4395afab42209d0bb3e"},"