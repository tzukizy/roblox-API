CrateofGoods)\n\t\ttask.wait(0.5)\n\tend\nend)\n\n-- Loop 2: continuously teleport to dropoff points\ntask.spawn(function()\n\twhile true do\n\t\tlocal dropOffPositions = GetPackageDropOffPosition:InvokeServer()\n\t\tif typeof(dropOffPositions) == \"table\" then\n\t\t\tfor _, pos in ipairs(dropOffPositions) do\n\t\t\t\tif typeof(pos) == \"Vector3\" then\n\t\t\t\t\trootPart.CFrame = CFrame.new(pos + Vector3.new(0,3,0))\n\t\t\t\t\ttask.wait(0.3)\n\t\t\t\tend\n\t\t\tend\n\t\telseif typeof(dropOffPositions) == \"Vector3\" then\n\t\t\trootPart.CFrame = CFrame.new(dropOffPositions + Vector3.new(0,3,0))\n\t\t\ttask.wait(0.3)\n\t\tend\n\t\ttask.wait(0.5) -- small wait before checking dropoff points again\n\tend\nend)\n","features":"Illegal package autofarm(needs to be enough guards for it to work)","tags":["papersplease","funny","powerfull","autofarm"],"discord":"","keyLink":"","owner":{"_id":"66c518aa80f5ab27c828ac0c","username":"cvvv","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66c518aa80f5ab27c828ac0c","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:01:51.921Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"683b78360b34d320e1bf06ae","editBy":{"_id":"66c518aa80f5ab27c828ac0c","username":"cvvv","status":"offline","id":"66c518aa80f5ab27c828ac0c"},"message":"Create script","createdAt":"2025-05-31T21:44:22.664Z"}],"comments":[{"_id":"683c499d059a9781e038de0b","commentBy":{"_id":"66c518aa80f5ab27c828ac0c","username":"cvvv","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-08-20T22:28:58.303Z","lastActive":"2025-06-10T21:17:46.022Z","status":"offline","id"