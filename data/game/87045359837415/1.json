r set to\", power.Value)\n    end\n\n    if speed then\n        speed.Value = 0 -- Speed = slowdown. \n        print(\"Speed set to\", speed.Value)\n    end\nend\n\nelse\nwarn(\"script is stopped, because wrong game.\")\nend","owner":{"_id":"66ae2822790921c27a22c894","username":"BadScriptsMaker","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b49d3f8dde85b588984d329991790adb4438c3ffe7c50eabb175494a482faaac.webp","original":"https://scriptblox.com/images/photo/66ae2822790921c27a22c894-1752740696621.jpg"},"status":"offline","id":"66ae2822790921c27a22c894","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/b49d3f8dde85b588984d329991790adb4438c3ffe7c50eabb175494a482faaac.webp","original":"https://scriptblox.com/images/photo/66ae2822790921c27a22c894-1752740696621.jpg"}},"verified":false,"views":13478,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6bd3bed85dfd34e8d810cb38ea799a313bad74271d5dbad61f3459ae35708274.webp","original":"https://scriptblox.com/images/sb/rbx-74d6e750208be69e9fc6e0d756486c36-6ac61609f5ec.png","scriptblox":"https://scriptblox.com/images/script/rbx-74d6e750208be69e9fc6e0d756486c36-6ac61609f5ec.png"},"likeCount":9,"dislikeCount":4,"createdAt":"2025-07-05T15:25:06.542Z","editBy":{"_id":"66ae2822790921c27a22c894","username":"BadScriptsMaker","status":"offline","id":"66ae2822790921c27a22c894"},"executes":22,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T03:27:03.390Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/6bd3bed85dfd34e8d810cb38ea799a313bad74271d5dbad61f3459ae35708274.webp","original":"https://scriptblox.com/images/sb/rbx-74d6e750208be69e9fc6e0d756486c36-6ac61609f5ec.png","scriptblox":"https://scriptblox.com/images/script/rbx-74d6e750208be69e9fc6e0d7