Button\")\ntoggleButton.Size = UDim2.fromScale(0.18, 0.08)\ntoggleButton.Position = UDim2.fromScale(0.02, 0.45)\ntoggleButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)\ntoggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\ntoggleButton.TextScaled = true\ntoggleButton.Font = Enum.Font.GothamBold\ntoggleButton.Text = \"Admin\"\ntoggleButton.BorderSizePixel = 0\ntoggleButton.Parent = toggleGui\n\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = UDim.new(0, 16)\ncorner.Parent = toggleButton\n\nlocal isVisible = true\n\nlocal function setVisible(state)\n\tisVisible = state\n\tadminPanel.Enabled = state\n\tfor _, v in ipairs(adminPanel:GetDescendants()) do\n\t\tif v:IsA(\"Frame\")\n\t\tor v:IsA(\"TextLabel\")\n\t\tor v:IsA(\"TextButton\")\n\t\tor v:IsA(\"ImageLabel\")\n\t\tor v:IsA(\"ImageButton\") then\n\t\t\tv.Visible = state\n\t\tend\n\tend\nend\n\ntoggleButton.MouseButton1Click:Connect(function()\n\tsetVisible(not isVisible)\nend)\n\nplayer.CharacterAdded:Connect(function()\n\ttask.wait(0.5)\n\tadminPanel = getAdminPanel()\n\tadminPanel.ResetOnSpawn = false\n\tsetVisible(isVisible)\nend)\n","owner":{"_id":"692ce1a3f5fd79fe89fe928a","username":"Justsomescripter89","verified":false,"profilePicture":"/images/photo/692ce1a3f5fd79fe89fe928a-1766171879302.jpeg","status":"offline","id":"692ce1a3f5fd79fe89fe928a","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1872,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/83151981722999-1766172135891.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2025-12-19T19:22:15.900Z","executes":382,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6945a5e7cfad1856c5f0835d","editBy":{"_id":"692ce1a3f5fd79fe89fe928a","username":"Justsomescripter89","status":"offline","id":"692ce1a3f5fd79fe89fe928a"},"message":"Create script","createdAt":"2025-12-19T19:22:15.903Z"}],"comments":[{"_id":"6945a