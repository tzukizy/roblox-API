islikeCount":0,"createdAt":"2026-07-31T19:05:08.915Z","liked":false,"disliked":false}]},{"slug":"Clean-The-Library-Book-ESP-and-Book-Category-Tracer-239151","_id":"6a3bcb51e23ccd44d1db2795","title":"Book ESP and Book Category Tracer","game":{"_id":"6a269927b2807ec37e183bbc","gameId":109881277752094,"name":"Clean The Library 📖","imageUrl":"/images/sb/rbx-ae81e80c86e680572ba9a5a68811a9b5-6aa844200797.png","placeId":109881277752094},"features":"+ Rainbow Book ESP\n\n+ Book Category Tracer\n\n+ WalkSpeed\n\n+ JumpPower","tags":["Clean The Library","ESP","Tracers","Auto Farm"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/KEV1Npkrl/Clean-The-Library-HUB/refs/heads/main/Clean-The-Library-HUB.lua\"))()","owner":{"_id":"632398815ff1d45038eb2c41","username":"kevinpkrl","verified":false,"profilePicture":"/images/photo/632398815ff1d45038eb2c41-1782303370726.jpeg","status":"offline","id":"632398815ff1d45038eb2c41","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"https://auth.platorelay.com/a?","views":299,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/109881277752094-1782303569928.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-06-24T12:19:29.946Z","executes":237,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a3bcb51e23ccd44d1db2797","editBy":{"_id":"632398815ff1d45038eb2c41","username":"kevinpkrl","status":"offline","id":"632398815ff1d45038eb2c41"},"message":"Create script","createdAt":"2026-06-24T12:19:29.949Z"}],"comments":[]},{"slug":"Clean-The-Library-BOOK-SAVE-Quick-Organization-Open-Source-238858","_id":"6a3a326a9ac65dc655b39dda","title":"Quick Organization Open Source","game":{"_id":"6a269927b2807ec37e183bbc","gameId":109881277752094,"name":"Clean The Library 📖","imageUrl":"/images/sb/rbx-ae81e80c86e680572ba9a5a68811a9b5-6aa844200797.png","placeId":109881277752094},"features":"DO NOT PLACE ANY BOOKS, OR THE SCRIPT WILL STOP/BROKE. LET THE SCRIPT DO EVERYTHING.\n\nmade by real_redz\n\nComplete the game automatically (in about 7 to 15 minutes)\n- The better your ping, the faster it will be\n\nHow to use it?\n\n- Enter a match (solo, professional, duo, trio, squad...)\n- Run the script","tags":["library","opensource"],"script":"--[[\n\tmade by real_redz\n\topensource, anyone can edit the code\n]]\n\nif MAIN_THREAD then --[[task.cancel(MAIN_THREAD)]] return end\nif not game.IsLoaded then game.Loaded:Wait() end\n\nlocal replicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal players = game:GetService(\"Players\")\n\nlocal localPlayer = players.LocalPlayer\n\nlocal libraryGenres = workspace.Library.Genres\nlocal libraryBooks = workspace.Library.Books\n\nlocal exitDoor = workspace.ExitDoor\n\nlocal bookController = require(localPlayer.PlayerScripts.Client.Runtime.BookController)\nlocal enum = require(replicatedStorage.Shared.Utility.Enum)\n\nlocal userLibraryData = bookController.Replica.Data.Players[localPlayer.Name]\n\nlocal BOOKS_SECTION = {}\nlocal BOOKS_GENRES = {}\n\nlocal booksGenres = enum.Genres\n\nlocal function grabBook(book: Instance): (nil)\n\tbookController.Replica:FireServer(\"Grab\", book)\nend\n\nlocal function placeBook(section: Instance, index: number): (nil)\n\tbookController.Replica:FireServer(\"Place\", section, index)\nend\n\nlocal function splitTitleIndex(book: Instance): (string, number)\n\tlocal title, index = book.Name:match(\"^(.-)_(.+)$\")\n\treturn title, index\nend\n\nlocal function getBookSection(genre: string, bookName: string, volumes: number): Instance?\n\tif not BOOKS_SECTION[bookName] then\n\t\tif not BOOKS_GENRES[genre] then\n\t\t\tBOOKS_GENRES[genre] = libraryGenres[genre]:GetChildren()\n\t\tend\n\t\t\n\t\tfor key, section in BOOKS_GENRES[genre] do\n\t\t\tif section:GetAttribute(\"Width\") == volumes then\n\t\t\t\tBOOKS_SECTION[bookName] = table.remove(BOOKS_GENRES[genre], key)\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn BOOKS_SECTION[bookName]\nend\n\nlocal function complete()\n\tif MAIN_THREAD then\n\t\ttask.cancel(MAIN_THREAD)\n\t\tgetgenv().MAIN_THREAD = nil\n\t\ttask.wait()\n\tend\n\t\n\tlocalPlayer.Character:PivotTo(exitDoor.Region.Part.CFrame)\nend\n\nlocal function organizeBooks()\n\tfor genre, books in booksGenres do\n\t\tfor _, data in books do\n\t\t\tlocal volumes = data.VolumeCount or 1\n\t\t\tlocal section = getBookSection(genre, data.Title, volumes)\n\t\t\t\n\t\t\tfor volume = volumes, 1, -1 do\n\t\t\t\tlocal book = libraryBooks:FindFirstChild(`{data.Title}_{volume}`)\n\t\t\t\tif not book or book:GetAttribute(\"Locked\") then continue end\n\t\t\t\t\n\t\t\t\twhile not book:FindFirstChild(\"Attachment\") do\n\t\t\t\t\tlocalPlayer.Character:PivotTo(book.CFrame)\n\t\t\t\t\ttask.wait()\n\t\t\t\t\tgrabBook(book)\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\twhile book:FindFirstChild(\"Attachment\") do\n\t\t\t\t\tlocalPlayer.Character:PivotTo(section:GetPivot())\n\t\t\t\t\ttask.wait()\n\t\t\t\t\tplaceBook(section, volume - 1)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function awake()\n\texitDoor.DoorPart.DoorHighlight:GetAttributeChangedSignal(\"Enabled\"):Once(complete)\n\tgetgenv().MAIN_THREAD = task.spawn(organizeBooks)\nend\n\nawake()","owner":{"_id":"64ca9f2be16cfc5251ebd249","username":"REDz","verified":false,"profilePicture":"/images/photo/64ca9f2be16cfc5251ebd249-1782281217235.jpg","status":"offline","id":"64ca9f2be16cfc5251ebd249","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":1298,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/109881277752094-1782198890859.jpg","likeCount":1,"dislikeCount":1,"createdAt":"2026-06-23T07:14:50.872Z","editBy":{"_id":"64ca9f2be16cfc5251ebd249","username":"REDz","status":"offline","id":"64ca9f2be16cfc5251ebd249"},"keyLink":"","executes":532,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a3a326a9ac65dc655b39ddc","editBy":{"_id":"64ca9f2be16cfc5251ebd249","username":"REDz","status":"offline","id":"64ca9f2be16cfc5251ebd249"},"message":"Create script","createdAt":"2026-06-23T07:14:50.875Z"},{"_id":"6a3b1e68c8c5e8c9c11f6070","editBy":{"_id":"64ca9f2be16cfc5251ebd249","username":"REDz","status":"offline","id":"64ca9f2be16cfc5251ebd249"},"message":"Update script","createdAt":"2026-06-24T00:01:44.634Z"}],"comments":[{"_id":"6a3a6d09e9b28162ce16c3d6","commentBy":{"_id":"686a3b9f4791b26c0b724c43","username":"yasirplays10","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-07-06T09:02:23.917Z","lastActive":"2026-07-31T10:27:29.645Z","status":"offline","id":"686a3b9f4791b26c0b724c43"},"text":"can anyone make a script of game pls donate but infinite by /hottopic where ic an get unlimited rob=ux please","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-23T11:24:57.598Z","liked":false,"disliked":false},{"_id":"6a3ab2d026601aae992be771","commentBy":{"_id":"68be701867ecab61b7266b78","username":"dididididi","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-09-08T05:56:40.440Z","lastActive":"2026-07-24T16:16:45.951Z","status":"offline","id":"68be701867ecab61b7266b78"},"text":"Each one is missing one book","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-23T16:22:40.957Z","liked":false,"disliked":false},{"_id":"6a3ab2eb31fbd3adf3e88cfb","commentBy":{"_id":"68be701867ecab61b7266b78","username":"dididididi","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-09-08T05:56:40.440Z","lastActive":"2026-07-24T16:16:45.951Z","status":"offline","id":"68be701867ecab61b7266b78"},"text":"Your script will make many books disappear","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-23T16:23:07.794Z","liked":false,"disliked":false}]},{"slug":"Clean-The-Library-PRO-MODE-Organize-Book-OS-236252","_id":"6a2db37c727cb732371dbaf4","title":"Organize Book OS (OUTDATED)","game":{"_id":"6a269927b2807ec37e183bbc","gameId":109881277752094,"name":"Clean The Library 📖","imageUrl":"/images/sb/rbx-ae81e80c86e680572ba9a5a68811a9b5-6aa844200797.png","placeId":109881277752094},"features":"organizes books, works as intended","tags":["Open Source","Clean The Library"],"script":"getgenv().Running = true\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal CollectionService = game:GetService(\"CollectionService\")\n\nlocal Loader = require(ReplicatedStorage.Packages.Loader)\nlocal ReplicaController = require(Loader.Shared.Utility.ReplicaController)\nlocal BooksData = require(Loader.Shared.Data.Books)\n\nlocal LibraryReplica = nil\nfor _, r in pairs(ReplicaController._replicas) do\n    if r.Class == \"Library\" then LibraryReplica = r break end\nend\nif not LibraryReplica then\n    ReplicaController.ReplicaOfClassCreated(\"Library\", function(replica) LibraryReplica = replica end)\n    while not LibraryReplica do task.wait() end\nend\n\nlocal Library = Workspace.Library\nlocal BooksFolder = Library.Books\nlocal player = Players.LocalPlayer\n\nplayer.CameraMode = Enum.CameraMode.Classic\nplayer.CameraMinZoomDistance = 20\ntask.spawn(function() task.wait(0.1) player.CameraMinZoomDistance = 0.5 end)\n\nlocal shelfModels = {}\nfor _, shelfModel in ipairs(CollectionService:GetTagged(\"Shelf\")) do\n    shelfModels[shelfModel.Name] = shelfModel\nend\n\nlocal function getShelfAssignedSeries(shelfId)\n    local shelfData = LibraryReplica.Data.Shelves[shelfId]\n    if not shelfData then return nil end\n    for _, placedBook in pairs(shelfData.Books) do\n        local bookName = typeof(placedBook) == \"Instance\" and placedBook.Name or placedBook\n        local seriesName = bookName:match(\"^(.-)_(.+)$\")\n        if seriesName then return seriesName end\n    end\nend\n\nlocal function findShelfForSeries(seriesName, genreName, volumeCount)\n    for shelfId, shelfData in pairs(LibraryReplica.Data.Shelves) do\n        if not shelfData.Completed and shelfData.Category == genreName then\n            local shelfModel = shelfModels[shelfId]\n            if shelfModel and shelfModel:GetAttribute(\"Width\") == volumeCount then\n                if getShelfAssignedSeries(shelfId) == seriesName then return shelfModel end\n            end\n        end\n    end\n    for shelfId, shelfData in pairs(LibraryReplica.Data.Shelves) do\n        if not shelfData.Completed and shelfData.Category == genreName then\n            local shelfModel = shelfModels[shelfId]\n            if shelfModel and shelfModel:GetAttribute(\"Width\") == volumeCount then\n                if not getShelfAssignedSeries(shelfId) and next(shelfData.Books) == nil then return shelfModel end\n            end\n        end\n    end\nend\n\nlocal function teleportTo(obj)\n    local char = player.Character\n    local root = char and char:FindFirstChild(\"HumanoidRootPart\")\n    local part = obj:IsA(\"Model\") and (obj.PrimaryPart or obj:FindFirstChildOfClass(\"BasePart\")) or obj\n    if root and part then\n        root.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0))\n        task.wait(0.05)\n    end\nend\n\ntask.spawn(function()\n    for _, book in ipairs(BooksFolder:GetChildren()) do\n        if not getgenv().Running then break end\n        task.wait(0.02)\n        \n        local seriesName, volumeStr = book.Name:match(\"^(.-)_(.+)$\")\n        local volumeNum = tonumber(volumeStr)\n        if seriesName and volumeNum then\n            local genreName, bookInfo = BooksData.GetCategory(seriesName)\n            if genreName and bookInfo then\n                local shelfModel = findShelfForSeries(seriesName, genreName, bookInfo.VolumeCount)\n                if shelfModel then\n                    local shelfData = LibraryReplica.Data.Shelves[shelfModel.Name]\n                    if not (shelfData and shelfData.Books[tostring(volumeNum)]) then\n                        teleportTo(book)\n                        LibraryReplica:FireServer(\"Grab\", book)\n                        task.wait(0.1)\n                        teleportTo(shelfModel)\n                        LibraryReplica:FireServer(\"Place\", shelfModel, volumeNum - 1)\n                        task.wait(0.4)\n                    end\n                end\n            end\n        end\n    end\n    getgenv().Running = false\nend)","owner":{"_id":"680629a0917771322c0fc292","username":"iayu","verified":false,"profilePicture":"/images/photo/680629a0917771322c0fc292-1776261149015.png","status":"offline","id":"680629a0917771322c0fc292","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":8026,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/109881277752094-1781379964504.webp","likeCount":0,"dislikeCount":2,"createdAt":"2026-06-13T19:46:04.527Z","keyLink":"","discord":"https://discord.gg/Npr4PU96","executes":60,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a2db37c727cb732371dbaf6","editBy":{"_id":"680629a0917771322c0fc292","username":"iayu","status":"offline","id":"680629a0917771322c0fc292"},"message":"Create script","createdAt":"2026-06-13T19:46:04.530Z"}],"comments":[{"_id":"6a3543155ab7d689b3c9353b","commentBy":{"_id":"6a1521878cb34a150012541e","username":"Johnrafaelceaaa","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-10-05T12:47:27.781Z","createdAt":"2026-05-26T04:28:55.586Z","status":"offline","id":"6a1521878cb34a150012541e"},"text":"It doesn't work","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-19T13:24:37.297Z","liked":false,"disliked":false},{"_id":"6a39d5e1880df468c28bfcee","commentBy":{"_id":"6a39d59bb5d8a7c2c09da076","username":"Iambj","verified":false,"role":"