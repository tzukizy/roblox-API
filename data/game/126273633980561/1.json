 them).\nDropdown (select unit), Button (\"Equip Unit\").\nBuy Unit: Buy a unit (owned units only).\nDropdown (select unit), Input (amount), Button (\"Buy Unit\").\nBuy Case: Buy a case (e.g., Box Of Goods).\nDropdown (select case), Input (amount), Button (\"Buy Case\").\nAuto Open Case: Auto-open a number of cases.\nDropdown (select case), Input (amount), Button (\"Open Case\").\nMap Selector: Select a map (e.g., Plains).\nDropdown (select map), Button (\"Select Map\").\nTeleport to Places: Teleport to places (e.g., Inner Ship).\nDropdown (select place), Button (\"Teleport\").\nAuto Farm: Auto-farm in Tutorial Mode (spawns units, upgrades, loops).\nToggle (\"Enable Auto Farm\"); spawns Archer/Gunner/Grappler, speeds up, upgrades, loops after defeating ArmoredSnail.","tags":[],"script":"loadstring(game:HttpGet('https://raw.githubusercontent.com/BrySadW/StudTowerDefense/refs/heads/main/COOLUPD.lua'))()\n","owner":{"_id":"667aaaabd55dbd036e08f914","username":"brainhehehaha","verified":false,"profilePicture":"/images/photo/667aaaabd55dbd036e08f914-1745175371871.png","status":"offline","id":"667aaaabd55dbd036e08f914","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":14416,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/126273633980561-1745767344973.png","likeCount":0,"dislikeCount":3,"createdAt":"2025-04-27T15:22:25.031Z","editBy":{"_id":"667aaaabd55dbd036e08f914","username":"brainhehehaha","status":"offline","id":"667aaaabd55dbd036e08f914"},"executes":9,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"680e4bb161a6eae7fa7f6c1b","editBy":{"_id":"667aaaabd55dbd036e08f914","username":"brainhehehaha","status":"offline","id":"667aaaabd55dbd036e08f914"},"message":"Create script","createdAt":"2025-04-27T15:22:25.039Z"},{"_id":"6810f8e0349aff89e604a632","editBy":{"_id":"667aaaabd55dbd036e08f914","username":"brainhehehaha","status":"offline","id":"