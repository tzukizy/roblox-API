ncy=1\nstatusLabel.Text=\"OFF\"\nstatusLabel.TextColor3=Color3.fromRGB(255,80,80)\nstatusLabel.Font=Enum.Font.GothamBold\nstatusLabel.TextSize=13\n\nlocal credit=Instance.new(\"TextLabel\",frame)\ncredit.Size=UDim2.new(1,0,0,20)\ncredit.Position=UDim2.new(0,0,0.8,0)\ncredit.BackgroundTransparency=1\ncredit.Text=\"Made by DevsVNG\"\ncredit.TextColor3=Color3.fromRGB(200,200,200)\ncredit.Font=Enum.Font.GothamMedium\ncredit.TextSize=14\n\nlocal autoFarm=false\nlocal running=false\n\nlocal function farmLoop()\n\trunning=true\n\twhile autoFarm and task.wait(0.1) do\n\t\tfor _,v in pairs(workspace.Bases[tostring(player:GetAttribute(\"Base\"))].Enemies:GetDescendants()) do\n\t\t\tif v:IsA(\"Humanoid\") then\n\t\t\t\ttask.spawn(function()\n\t\t\t\t\tv.Health=0\n\t\t\t\tend)\n\t\t\tend\n\t\tend\n\n\t\tfor _,v in pairs(workspace:GetChildren()) do\n\t\t\tif (v.Name==\"CashTemp\" or v.Name==\"MaterialTemp\") and v:IsA(\"Part\") then\n\t\t\t\ttask.spawn(function()\n\t\t\t\t\tif player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n\t\t\t\t\t\tv.CFrame=player.Character.HumanoidRootPart.CFrame\n\t\t\t\t\tend\n\t\t\t\tend)\n\t\t\tend\n\t\tend\n\tend\n\trunning=false\nend\n\nlocal function setToggle(state)\n\tautoFarm=state\n\tif state then\n\t\tstatusLabel.Text=\"RUNNING\"\n\t\tstatusLabel.TextColor3=Color3.fromRGB(120,255,120)\n\t\tTweenService:Create(toggleFrame,TweenInfo.new(0.18),{BackgroundColor3=Color3.fromRGB(20,150,20)}):Play()\n\t\tTweenService:Create(toggleCircle,TweenInfo.new(0.18),{Position=UDim2.new(1,-32,0,2)}):Play()\n\t\tif not running then task.spawn(farmLoop) end\n\telse\n\t\tstatusLabel.Text=\"OFF\"\n\t\tstatusLabel.TextColor3=Color3.fromRGB(255,80,80)\n\t\tTweenService:Create(toggleFrame,TweenInfo.new(0.18),{BackgroundColor3=Color3.fromRGB(140,20,20)}):Play()\n\t\tTweenService:Create(toggleCircle,TweenInfo.new(0.18),{Position=UDim2.new(0,2,0,2)}):Play()\n\tend\nend\n\ntoggleFrame.InputBegan:Connect(function(input)\n\tif input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then\n\t\tsetToggle(not autoFarm)\n\tend\nend)\n\nUserInputService.InputBegan:Connect(function(input,gpe)\n\tif gpe then return end\n\tif input.KeyCode==Enum.KeyCode.P then\n\t\tsetToggle(not autoFarm)\n\tend\nend)\n\nsetToggle(false)","owner":{"_id":"6900d2e5d815a69893e1d8f6","username":"DevsVNG","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6900d2e5d815a69893e1d8f6","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":1556,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-42870e1b3f06917fcaadf7e4d7a43bac-8bda7d69de44.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-11-12T12:00:05.878Z","keyLink":"","executes":57,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"691476c60beef78a1261c9bd","editBy":{"_id":"6900d2e5d815a69893e1d8f6","username":"DevsVNG","status":"offline","id":"6900d2e5d815a69893e1d8f6"},"message":"Create script","createdAt":"2025-11-12T12:00:06.059Z"}],"comments":[{"_id":"6914823cb5616b310f0c7307","commentBy":{"_id":"6900d2e5d815a69893e1d8f6","username":"DevsVNG","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-10-28T14:27:49.404Z","lastActive":"2025-11-23T15:15:06.401Z","status":"offline","id":"6900d2e5d815a69893e1d8f6","topMilestone":{"key":"creator.scripts","tier":5}},"text":"@AnonymousAndy bro","parent":null,"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-11-12T12:49:00.572Z","liked":false,"disliked":false},{"_id":"691497895ddeb4a89a2d58ea","commentBy":{"_id":"6914974673802ce1cdf98431","username":"hangedMan","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2025-11-14T18:41:42.270Z","createdAt":"2025-11-12T14:18:46.516Z","status":"offline","id":"6914974673802ce1cdf98431"},"text":"https://www