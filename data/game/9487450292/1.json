ive\")\n                            else\n                                v.Event:FireServer(v.Name..\"Punch\")\n                                v.Event:FireServer(v.Name)\n                            end\n                        end\n                    end\n                end\n            end\n        end)\n    end\nend)\n\nwhile wait(0.2) do\n    for i,v2 in pairs(workspace.Enemy:GetChildren()) do\n        for _,v in pairs(v2:GetChildren()) do\n            if v:FindFirstChild(\"HumanoidRootPart\") and v:FindFirstChild(\"Humanoid\") and v.Humanoid.Health > 0 then\n                game:GetService(\"ReplicatedStorage\").Remote.Skills:FireServer(\"MMExplosion\", 9e18, v.HumanoidRootPart.CFrame)\n                game:GetService(\"ReplicatedStorage\").Remote.Skills:FireServer(\"MExplosion\", 9e18, v.HumanoidRootPart.CFrame)\n                game:GetService(\"ReplicatedStorage\").Remote.Skills:FireServer(\"Explosion\", 9e18, v.HumanoidRootPart.CFrame)\n            end\n        end\n    end\nend","owner":{"_id":"61aa66c310a33c504c75dc2b","username":"Septex","verified":true,"profilePicture":"/images/photo/61aa66c310a33c504c75dc2b-1638557449328.png","status":"offline","id":"61aa66c310a33c504c75dc2b","topMilestone":{"key":"creator.views","tier":1000000}},"verified":true,"views":29328,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2022-05-07T21:00:16.967Z","dislikeCount":0,"likeCount":2,"image":"https://tr.rbxcdn.com/66f059b641db65b73ee02eef12643937/500/280/Image/Jpeg","executes":3,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b4a4","editBy":{"_id":"61aa66c310a33c504c75dc2b","username":"Septex","status":"offline","id":"61aa66c310a33c504c75dc2b"},"message":"Create script","createdAt":"2022-05-07T21:18:29.173Z"},{"_id":"67e5e1e3b360710ec3c4e038","editBy":{"_id":"61aa66c310a33c504c75dc2b","username":"Septex","status":"offline","id":"61aa66c310a33c504c75dc2b"