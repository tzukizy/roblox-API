airs(g()) do\n        local u = t.Character and t.Character:FindFirstChild(\"Right Leg\")\n        if u then e:FireServer(u) end\n    end\n    task.wait(i)\nend\n","features":"punches/kills","tags":[],"discord":"","keyLink":"","owner":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66f9390af09d1c76dda29bd7","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:53:45.668Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"683ad7b0c49eba9c893ebaff","editBy":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","status":"offline","id":"66f9390af09d1c76dda29bd7"},"message":"Create script","createdAt":"2025-05-31T10:19:28.253Z"}],"comments":[]}]}