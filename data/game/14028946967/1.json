gnitude <= f then\n                table.insert(h, j)\n            end\n        end\n    end\n    return h\nend\n\nwhile true do\n    for _, t in pairs(g()) do\n        local u = t.Character and t.Character:FindFirstChild(\"Right Leg\")\n        if u then e:FireServer(u) end\n    end\n    task.wait(i)\nend\n","owner":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"66f9390af09d1c76dda29bd7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":5504,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-301ecad23969cd883c16f492113bf40f-6e9621237781.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-05-31T10:19:28.251Z","executes":39,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"683ad7b0c49eba9c893ebaff","editBy":{"_id":"66f9390af09d1c76dda29bd7","username":"Callmebyyourname466","status":"offline","id":"66f9390af09d1c76dda29bd7"},"message":"Create script","createdAt":"2025-05-31T10:19:28.253Z"}],"comments":[]}]}