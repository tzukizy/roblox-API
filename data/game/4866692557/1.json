N, SOURCE DIDNT SAVE. ---\n\nIts been a while since I posted a script.\n\nAuto Farm Reputation,\nAuto Kill NPCs,\nFling Nearby Players during autofarm,\nTeleport to safe zone when health under amount,\nFling Player Distance.,\nDisable AFK Kick.\n\nAll the auto farm necessities.\n\nEnjoy!\nmade by melon!","tags":["autofarm","melon","age of heroes","melon hub","auto farm"],"script":"loadstring(game:HttpGet(\"https://github.com/OfficiallyMelon/melons_script_hub/raw/main/ageofheroes.lua\"))()","owner":{"_id":"66921a29eb2c315b1fbc34c6","username":"melon","verified":true,"profilePicture":"/images/photo/66921a29eb2c315b1fbc34c6-1720851036957.jpg","status":"offline","id":"66921a29eb2c315b1fbc34c6","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"keyLink":"","views":57273,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-09-20T11:42:15.037Z","dislikeCount":1,"likeCount":1,"image":"https://tr.rbxcdn.com/9ebdc51551aea15cbb6829f45a9d81cf/500/280/Image/Jpeg","executes":8,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c52256","editBy":{"_id":"66921a29eb2c315b1fbc34c6","username":"melon","status":"offline","id":"66921a29eb2c315b1fbc34c6"},"message":"Create script","createdAt":"2025-03-27T22:27:10.030Z"}],"comments":[{"_id":"66ede7331fecfe31db0ab992","commentBy":{"_id":"66cc2ed2be2b7408a61ae201","username":"SyntaxHook","verified":false,"role":"user","profilePicture":"/images/photo/66cc2ed2be2b7408a61ae201-1730922766030.jpeg","createdAt":"2024-08-26T07:29:22.093Z","lastActive":"2024-12-23T21:51:40.967Z","status":"offline","id":"66cc2ed2be2b7408a61ae201","topMilestone":{"key":"creator.first_script","tier":1}},"text":"not work for solara","createdAt":"2024-09-20T21:20:51.293Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"66ee02d157ebd4ae557b69f8","commentBy":{"_id":"66921a29eb2c315b1fbc34c6","username":"melon","verified":true,"role":"user","profilePicture":"/images/photo/66921a29eb2c315b1fbc34c6-1720851036957.jpg","createdAt":"2024-07-13T06:09:45.742Z","lastActive":"2026-05-22T21:02:35.540Z","status":"offline","id":"66921a29eb2c315b1fbc34c6","topMilestone":{"key":"creator.followers","tier":10}},"text":"script is broken atm, it worked fine u*fuscated...","createdAt":"2024-09-20T23:18:41.467Z","edited":true,"likeCount":1,"liked":false,"disliked":false}]},{"slug":"Auto-\"Tank\"-Farm-(FAST-XP)_808","_id":"62116fe4788683a8710700b0","title":"Auto \"Tank\" Farm (FAST XP)","game":{"_id":"67e5e1ffb360710ec3c77ed4","gameId":4866692557,"name":"[3XP] Age of Heroes","imageUrl":"/images/sb/rbx-b80c274cb3d5879bba7516ab6a089958-199b4f82fc64.png","placeId":4866692557},"features":"auto 'tank' farm in aog (tank farming is a method to farming XP)\nhave the noobs have tons of health\nhave the host have tons of strength\n\nidentify the host by putting the username into host table\nidentify the noobs by putting the username into noobs table\n\nthen execute the script on all the alts and leave overnight and stonks\nif u need help, contact me on discord: 'j#6066","tags":["age of heroes","age of heroes tank farm"],"script":"local host = {\"player1\"} -- the one thats killing them\nlocal noobs  = {\"player1\",\"player2\"} -- the ones that are getting killed\nabort = false\nnoclip = true\nlocal players = game.Players\nlocal VirtualUser=game:GetService('VirtualUser')\ngame:GetService('Players').LocalPlayer.Idled:connect(function()\n\n        VirtualUser:CaptureController()\n        VirtualUser:ClickButton2(Vector2.new())\n\nend)\nhideuser = true\nspawn(function()\n    while wait() do\n        if hideuser then\n            pcall(function()\n                game.Players.LocalPlayer.Character.HumanoidRootPart.titleGui.Frame:Destroy()\n            end)\n        end\n    end\nend)\nfunction Invis()\n    pcall(function()\n    local Player = game.Players.LocalPlayer\n    local savepos = Player.Character.HumanoidRootPart.CFrame\n    \n    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-1609.06726, 112.907532, 2415.45264, 0.996510983, -1.88264e-08, 0.0834614709, 1.23878658e-08, 1, 7.76616389e-08, -0.0834614709, -7.63567698e-08, 0.996510983)\n    wait(2)\n    local Clone = game:GetService('Players').LocalPlayer.Character.LowerTorso.Root:Clone()\n    game:GetService('Players').LocalPlayer.Character.LowerTorso.Root:Destroy()\n    Clone.Parent = game:GetService('Players').LocalPlayer.Character.LowerTorso\n    wait(1)\n    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = savepos\n    end)\nend\nInvis()\ngame:GetService('RunService').Stepped:connect(function()\n    pcall(function()\n    if noclip  then\n        if game.Players.LocalPlayer.Character.Humanoid.RigType == Enum.HumanoidRigType.R6 then\n        game.Players.LocalPlayer.Character.Head.CanCollide = false\n        game.Players.LocalPlayer.Character.Torso.CanCollide = false\n        game.Players.LocalPlayer.Character[\"Left Leg\"].CanCollide = false\n        game.Players.LocalPlayer.Character[\"Right Leg\"].CanCollide = false\n        else\n        if game.Players.LocalPlayer.Character.Humanoid.RigType == Enum.HumanoidRigType.R15 then\n        game.Players.LocalPlayer.Character.Head.CanCollide = false\n        game.Players.LocalPlayer.Character.UpperTorso.CanCollide = false\n        game.Players.LocalPlayer.Character.LowerTorso.CanCollide = false\n        game.Players.LocalPlayer.Character.HumanoidRootPart.CanCollide = false\n        end\n        end\n    end\nend)\nend)\n\nwhile wait() do\n    pcall(function()\n    wait()\n    if table.find(noobs, game.Players.LocalPlayer.Name) then\n        while wait() do\n            pcall(function()\n                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-1609.06726, 112.907532, 2415.45264, 0.996510983, -1.88264e-08, 0.0834614709, 1.23878658e-08, 1, 7.76616389e-08, -0.0834614709, -7.63567698e-08, 0.996510983)\n            end)    \n        end\n    else\n        if table.find(host, game.Players.LocalPlayer.Name) then\n            for i,v in pairs(noobs) do\n\n                if players[v] then\n\n                    local player = players[v]\n\n\n                    if not game.Players[v].Character:WaitForChild('ForceField',0.5) then\n                        game.Players[v].Character.DescendantAdded:connect(function(na)\n                            if na.Name == \"ForceField\" then\n                                abort = true\n                            end\n                        end)\n                        repeat\n                            \n                                wait()\n                                if game.Players[v].Character:FindFirstChild('ForceField') then\n                                    abort = true\n                                end\n                                game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = (game.Players[v].Character.HumanoidRootPart.CFrame * CFrame.new(0,0,2))\n                                game:GetService(\"ReplicatedStorage\").Events.Punch:FireServer(0,0.1,1)\n                            \n                        until abort or not game.Players[v].Character:IsDescendantOf(game.Workspace) or not game.Players[v].Character:FindFirstChild('Humanoid') or game.Players[v].Character.Humanoid.Health == 0 or not game.Players[v].Character:FindFirstChild('HumanoidRootPart')\n                        abort = false\n                    end\n                end\n            end\n        end\n    end\nend)\nend","owner":{"_id":"61d4e24b8ae42daa57a6502f","username":"laderite","verified":true,"profilePicture":"/images/photo/61d4e24b8ae42daa57a6502f-1734065252008.png","status":"offline","id":"61d4e24b8ae42daa57a6502f","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"views":18291,"scriptType":"free","isUniversal":false,"isPatched":false,"createdAt":"2022-02-19T22:32:04.198Z","visibility":"public","dislikeC