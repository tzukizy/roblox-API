rstChild(\"hoopParticle\") then\n                    Hoop.playerParticle:Destroy()\n                    Hoop.hoopGui:Destroy()\n                    Hoop.hoopParticle:Destroy()\n                end\n            end\n        end\n    end\nend)\n\nspawn(function()\n    while task.wait(0.01) do\n        if not (Player.Character and Player.Character.HumanoidRootPart) then continue end\n        \n        for _, Orb in pairs(workspace.orbFolder:GetDescendants()) do\n            if Orb.Name:match(\" Orb$\") and Orb:FindFirstChild(\"outerOrb\") then\n                Orb.outerOrb.CFrame = Player.Character.HumanoidRootPart.CFrame\n            elseif Orb.Name == \"Gem\" and Orb:FindFirstChild(\"outerGem\") then\n                Orb.outerGem.CFrame = Player.Character.HumanoidRootPart.CFrame\n            end\n        end\n    end\nend)\n\nspawn(function()\n    while task.wait(0.05) do\n        if Player.Character and Player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            RebirthEvent:FireServer(\"rebirthRequest\")\n        end\n    end\nend)\n\nPlayer.CharacterAdded:Connect(function(Character)\n    repeat task.wait(0.03) until Character:FindFirstChild(\"HumanoidRootPart\")\nend)","features":"gem, orbs, rebirth, invis hoop, anti afk","tags":[],"discord":"","keyLink":"","owner":{"_id":"6840933e343da7b9979f0dd7","username":"pxrson999","verified":false,"profilePicture":{"url":"https://media.kocakz.me/15edb82ed55d6bab306b8bf2eb10db4347545a846fc91f663da5b0304588362a.webp","original":"https://scriptblox.com/images/photo/6840933e343da7b9979f0dd7-1753771894284.jpeg"},"status":"offline","id":"6840933e343da7b9979f0dd7","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/15edb82ed55d6bab306b8bf2eb10db4347545a846fc91f663da5b0304588362a.webp","original":"https://scriptblox.com/images/photo/6840933e343da7b9979f0dd7-1753771894284.jpeg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"