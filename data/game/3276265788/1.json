editBy":{"_id":"68fd9adaf80fa96119c71bff","username":"xitosx225","status":"offline","id":"68fd9adaf80fa96119c71bff"},"message":"Create script","createdAt":"2025-11-25T02:57:23.658Z"}],"comments":[]},{"slug":"Legends-Of-Speed-legends-of-speed-farm-code-51470","_id":"68b79e66f0504c5ab883438a","title":"LOS Farm","game":{"_id":"68b79e66f0504c5ab8834387","gameId":3276265788,"name":"Legends Of Speed ⚡","imageUrl":"/images/sb/rbx-59d17b007b261d64c04a179a18795352-3a92ca490d14.png","placeId":3276265788},"features":"gem, orbs, rebirth, invis hoop, anti afk","tags":[],"script":"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal VirtualUser = game:GetService(\"VirtualUser\")\n\nlocal RebirthEvent = ReplicatedStorage.rEvents.rebirthEvent\nlocal Player = Players.LocalPlayer\n\nspawn(function()\n    repeat task.wait() until Player\n    Player.Idled:Connect(function()\n        VirtualUser:CaptureController()\n        VirtualUser:ClickButton2(Vector2.new())\n    end)\nend)\n\nlocal Hoops = workspace.Hoops:GetChildren()\n\nspawn(function()\n    while task.wait(0.05) do\n        for _, Hoop in pairs(Hoops) do\n            if Hoop.Name == \"Hoop\" and Player.Character and Player.Character.HumanoidRootPart then\n                Hoop.CFrame = Player.Character.HumanoidRootPart.CFrame\n                Hoop.Transparency = 1\n                Hoop.hoopSound.Volume = 0\n                \n                if Hoop:FindFirstChild(\"hoopParticle\") then\n                    Hoop.playerParticle:Destroy()\n                    Hoop.hoopGui:Destroy()\n                    Hoop.hoopParticle:Destroy()\n                end\n            end\n        end\n    end\nend)\n\nspawn(function()\n    while task.wait(0.01) do\n        if not (Player.Character and Player.Character.HumanoidRootPart) then continue end\n        \n        for _, Orb in pairs(workspace.orbFolder:GetDescendants()) do\n            if Orb.Name:match(\" Orb$\") and Orb:FindFirstChild(\"outerOrb\") then\n                Orb.outerOrb.CFrame = Player.Character.HumanoidRootPart.CFrame\n            elseif Orb.Name == \"Gem\" and Orb:FindFirstChild(\"outerGem\") then\n                Orb.outerGem.CFrame = Player.Character.HumanoidRootPart.CFrame\n            end\n        end\n    end\nend)\n\nspawn(function()\n    while task.wait(0.05) do\n        if Player.Character and Player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            RebirthEvent:FireServer(\"rebirthRequest\")\n        end\n    end\nend)\n\nPlayer.CharacterAdded:Connect(function(Character)\n    repeat task.wait(0.03) until Character:FindFirstChild(\"HumanoidRootPart\")\nend)","owner":{"_id":"6840933e343da7b9979f0dd7","username":"pxrson999","verified":false,"profilePicture":"/images/photo/6840933e343da7b9979f0dd7-1753771894284.jpeg","status":"offline","id":"6840933e343da7b9979f0dd7","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":4131,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-17f7012707114a10d5463fc54f2208c2-23c480e10577.png","likeCount":2,"dislikeCount":1,"createdAt":"2025-09-03T01:48:22.154Z","editBy":{"_id":"6840933e343da7b9979f0dd7","username":"pxrson999","status":"offline","id":"6840933e343da7b9979f0dd7"},"keyLink":"","executes":22,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68b79e66f0504c5ab883438c","editBy":{"_id":"6840933e343da7b9979f0dd7","username":"pxrson999","status":"offline","id":"6840933e343da7b9979f0dd7"},"message":"Create script","createdAt":"2025-09-03T01:48:22.156Z"},{"_id":"691ea94a9bfd8055621d457e","editBy":{"_id":"6840933e343da7b9979f0dd7","username":"pxrson999","status":"offline","id":"6840933e343da7b9979f0dd7"},"message":"Update script","createdAt":"2025-11-20T05:38:18.029Z"}],"comments":[{"_id":"68b7a31f77d2a80221ef3c59","commentBy":{"_id":"665349e86da887b06f10d3c5","username":"DavidSRacism","verifie