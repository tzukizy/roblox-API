\n                    closest = angle;\n                end\n            end\n        end\n    end\n    old(self, index, value);\nend);","owner":{"_id":"6696b55845510a88dbaa3fae","username":"cqwe5","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6696b55845510a88dbaa3fae","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":12090,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-20T14:32:05.116Z","dislikeCount":2,"likeCount":3,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-4b14c58449658ef1906f7a0ab155da64/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-4b14c58449658ef1906f7a0ab155da64/500/280/Image/Jpeg/noFilter"},"executes":739,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:16:32.178Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-4b14c58449658ef1906f7a0ab155da64/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-4b14c58449658ef1906f7a0ab155da64/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54fe8","editBy":{"_id":"6696b55845510a88dbaa3fae","username":"cqwe5","status":"offline","id":"6696b55845510a88dbaa3fae"},"message":"Create script","createdAt":"2025-03-27T22:55:31.180Z"}],"comments":[{"_id":"67b74a8c76f320547225139c","commentBy":{"_id":"66e48d5e8476a2b9b10b6349","username":"iserical","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"createdAt":"2024-09-13T19:07:10.123Z","lastActive":"2025-12-13T01:40:42.478Z","status":"offline","