{"id":6172932937,"name":"Energy Assault FPS","desc":"Welcome to Energy Assault, a futuristic first person shooter where energy-based guns have replaced ballistic weapons.\n\n🎯 Eliminate your opponents across multiple game modes, including Team Deathmatch, Capture the Flag, and Gun Game.\n🔫 Level up and earn credits to unlock new guns, attachments, skins, and outfits.\n💥 Fulfil your daily missions and claim unique rewards.\n🏆 Compete on weekly global leaderboards for special prizes.\n🎮 Available on PC, mobile, console, and in VR.","path":"/game/6172932937-energy-assault-fps","slug":"6172932937-energy-assault-fps","thumbnail":{"url":"https://media.kocakz.me/ec98f26e77495072de343cb7e823a2d2957a9f41466f360c74e97ce2c2c7a504.webp","original":"https://tr.rbxcdn.com/180DAY-82d339ee5b645f43507f849396137831/150/150/Image/Png/noFilter"},"playing":160,"visitor":328863478,"verified":false,"updatedAt":"2026-04-22T10:39:15.590Z","creator":{"name":"Typical Games","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Energy-Assault-FPS-energy-*ault-silent-aim-Open-Source-204694","_id":"69e8a5532e3701ce8c5d270e","title":"energy asault silent aim Open Source","game":{"_id":"67e5e1ffb360710ec3c782ba","gameId":6172932937,"name":"Energy Assault FPS","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":6172932937},"features":"silent aim for energy assault open source","tags":[],"script":"local function GetClosest()\n    local closestdist = math.huge\n    local closesttarget = nil\n    local player = game.Players.LocalPlayer\n    local character = player.Character\n    local rootPart = character and character:FindFirstChild(\"HumanoidRootPart\")\n    \n    if not rootPart then return nil end\n    \n    for _, otherPlayer in pairs(game.Players:GetPlayers()) do\n        if otherPlayer ~= player then\n            local otherChar = otherPlayer.Character\n            if otherChar and otherChar:FindFirstChild(\"HumanoidRootPart\") then\n                local otherRoot = otherChar.HumanoidRootPart\n                local distance = (otherRoot.Position - rootPart.Position).Magnitude\n                \n                if distance < closestdist then\n                    closestdist = distance\n                    closesttarget = otherChar\n                end\n            end\n        end\n    end\n    \n    return closesttarget\nend\n\nlocal function hook()\n    local Hooked = false;\n    repeat\n        (function()\n            local Reference;\n            for _, Function in getgc() do\n                if typeof(Function) == \"function\" and debug.info(Function, \"n\") == \"randomunitvector\" then\n                    Reference = Function\n                end\n            end;\n            if Reference then\n                local RandomUnitVector;\n                RandomUnitVector = hookfunction(Reference, function(Spread, Direction)\n                    local Target = GetClosest()\n                    if Target then\n                        local Head = Target:FindFirstChild(\"Head\")\n                        if Head then\n                            local Camera = workspace.CurrentCamera;\n                            return (Head.Position - Camera.CFrame.Position).Unit * 10000\n                        end\n                    end;\n                    return RandomUnitVector(Spread, Direction)\n                end)\n                Hooked = true\n            end\n        end)()\n        if not Hooked then\n            task.wait(1)\n        end\n    until Hooked\nend\n\ngame.Players.LocalPlayer.CharacterAdded:Connect(function(character) -- this check is necessary because the \"gunS\" script only appears when youre alive but i dont think it works\n    task.wait(0.5)\n    hook()\nend)\n\nif game.Players.LocalPlayer.Character then\n    hook()\nend","owner":{"_id":"6807e4f2219af8