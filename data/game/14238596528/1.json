t(0.03)\n    firetouchinterest(root, part, 1)\n    return true\nend\n\nlocal function deleteStoreMenus()\n    local playerGui = LocalPlayer:FindFirstChild(\"PlayerGui\")\n    if not playerGui then return end\n    \n    for _, gui in ipairs(playerGui:GetDescendants()) do\n        if gui.Name == \"StoreMenu\" then\n            gui:Destroy()\n        end\n    end\nend\n\nlocal function autoCollect()\n    local tycoonsFolder = Workspace:FindFirstChild(\"Tycoons\")\n    if not tycoonsFolder then return end\n    \n    local tycoon = tycoonsFolder:FindFirstChild(\"GamerZomba_123 Tycoon\")\n    if not tycoon then return end\n    \n    local triggered = 0\n    \n    -- Trigger Buttons\n    local buttonsFolder = tycoon:FindFirstChild(\"Buttons\", true)\n    if buttonsFolder then\n        for _, obj in ipairs(buttonsFolder:GetDescendants()) do\n            if obj:IsA(\"BasePart\") then\n                if triggerTouch(obj) then\n                    triggered += 1\n                end\n            end\n        end\n    end\n    \n    -- Trigger Bank\n    local modelsFolder = tycoon:FindFirstChild(\"Models\", true)\n    if modelsFolder then\n        local bank = modelsFolder:FindFirstChild(\"Bank\")\n        if bank then\n            local zonePart = bank:FindFirstChild(\"ZonePart\")\n            if zonePart and triggerTouch(zonePart) then\n                triggered += 1\n            end\n        end\n    end\n    \n    if triggered > 0 then\n        print(\"🔄 Triggered \" .. triggered .. \" things\")\n    end\nend\n\n-- Main loop\nwhile true do\n    autoCollect()\n    deleteStoreMenus()     -- Auto delete StoreMenu every loop\n    task.wait(CHECK_INTERVAL)\nend","features":"I made this script using AI, however it is fully functional and works incredibly well for what it is. Good luck farming everyone!","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a13a5c1ac557ac0c0c2305c","username":"Flexter","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.we