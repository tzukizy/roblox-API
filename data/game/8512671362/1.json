        local args = {\n                            [1] = \"DealDamage\",\n                            [2] = targetCharacter.Humanoid,\n                            [3] = localPlayer.Character.HumanoidRootPart,\n                            [4] = 100\n                        }\n\n                        clientScript.RunFunction:FireServer(unpack(args))\n                    else\n                        warn(\"Target character or humanoid not found for player: \" .. targetPlayer.Name)\n                    end\n                end\n            end\n        else\n            warn(\"ClientScript not found\")\n        end\n    else\n        warn(\"Hidden object or Scripts folder not found\")\n    end\nend\n\nwhile true do\n    applyDamageToAllPlayers()\n    wait(1)  -- Wait for 1 second before repeating\nend\n","owner":{"_id":"666c005ac859d5f27bbbe650","username":"weenachuangkud","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f0d9bff21357cda3f82a0895d2e7749594ec297e8a8c2e744141ec36196d93bb.webp","original":"https://scriptblox.com/images/photo/666c005ac859d5f27bbbe650-1718354176685.jpeg"},"status":"offline","id":"666c005ac859d5f27bbbe650","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://cdn.kocakz.me/images/f0d9bff21357cda3f82a0895d2e7749594ec297e8a8c2e744141ec36196d93bb.webp","original":"https://scriptblox.com/images/photo/666c005ac859d5f27bbbe650-1718354176685.jpeg"}},"verified":false,"keyLink":"","views":10751,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-06-23T08:45:44.344Z","dislikeCount":2,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/6e3c32b4dbd4707622bc0adcceaaf008/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/6e3c32b4dbd4707622bc0adcceaaf008/500/280/Image/Jpeg"},"executes":161,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"