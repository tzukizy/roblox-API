 \"EMPTY\" u have to replace it with any car num u want, like:\n\nSpawnVehiclesRE:FireServer(\n    \"GTA_Car_10\"\n\nand that will spawn the car u want, \n\nenjoy!.","tags":[],"discord":"https://discord.com/invite/amB9GCbYDj","keyLink":"","owner":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","verified":false,"profilePicture":{"url":"https://media.kocakz.me/64f1b3fc65386d1cf7e69bee45e07a492c47c0f499ac7d51bc7da9f3c60b0f76.webp","original":"https://scriptblox.com/images/photo/65f05c0f67f2033080cb423d-1782059529971.jpg"},"status":"offline","id":"65f05c0f67f2033080cb423d","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/64f1b3fc65386d1cf7e69bee45e07a492c47c0f499ac7d51bc7da9f3c60b0f76.webp","original":"https://scriptblox.com/images/photo/65f05c0f67f2033080cb423d-1782059529971.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:45:47.309Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"687ab3d1f3667103161c46e6","editBy":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","status":"offline","id":"65f05c0f67f2033080cb423d"},"message":"Create script","createdAt":"2025-07-18T20:51:29.333Z"},{"_id":"693b9759e4d748bf75ef6563","editBy":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","status":"offline","id":"65f05c0f67f2033080cb423d"},"message":"Update script","createdAt":"2025-12-12T04:17:29.133Z"},{"_id":"6946121270e65288c341b610","editBy":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","status":"offline","id":"65f05c0f67f2033080cb423d"},"message":"Update script","createdAt":"2025-12-20T03:03:46.458Z"}],"comments":[{"_id":"687ab40524ad7a417fb41444","commentBy":{"_id":"65f05c0f67f2033080cb423d","username":"Semyon","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/64f1b3fc65386d1cf7e69bee45e07a492c