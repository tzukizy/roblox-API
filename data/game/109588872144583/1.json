d":"69dc48a106f080219064f85b","title":"Tribe v1","game":{"_id":"67e5e1ffb360710ec3c7835d","gameId":109588872144583,"name":"Tribe Survival 🏝️","imageUrl":"/images/sb/rbx-a040d629a4c1dcdef0336099dd77b573-ea065c120a87.png","placeId":109588872144583},"features":"_Test","tags":["Adn"],"script":"loadstring(game:HttpGet(\"https://mod-ui.vercel.app/api/Mods/Folder_The_Tribe_Survival/Tribe_Survival\"))()","owner":{"_id":"68f9a2655b059a4c44097feb","username":"ADN_Mods","verified":false,"profilePicture":"/images/photo/68f9a2655b059a4c44097feb-1761191004362.png","status":"offline","id":"68f9a2655b059a4c44097feb","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":2234,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-a040d629a4c1dcdef0336099dd77b573-ea065c120a87.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-04-13T01:36:33.157Z","executes":764,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dc48a106f080219064f85e","editBy":{"_id":"68f9a2655b059a4c44097feb","username":"ADN_Mods","status":"offline","id":"68f9a2655b059a4c44097feb"},"message":"Create script","createdAt":"2026-04-13T01:36:33.159Z"}],"comments":[{"_id":"69ecfe686542e2bc813a5f6e","commentBy":{"_id":"69e97141428b46ad46c81fb6","username":"lucasggggbr953","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-05-06T21:36:10.115Z","createdAt":"2026-04-23T01:09:21.581Z","status":"offline","id":"69e97141428b46ad46c81fb6"},"text":"NO OPEN MENU","edited":true,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-25T17:48:24.800Z","liked":false,"disliked":false}]},{"slug":"UPD-Tribe-Survival-Aimbot-87580","_id":"696d6e1505a2e087b9f7dc5b","title":"Aimbot Tribe  Survival","game":{"_id":"67e5e1ffb360710ec3c7835d","gameId":109588872144583,"name":"Tribe Survival 🏝️","imageUrl":"/images/sb/rbx-a040d629a4c1dcdef0336099dd77b573-ea065c120a87.png","placeId":109588872144583},"features":"This is an aimbot! The shot won't be perfect if you're walking! But it works. 🔥 Explanation: It follows the person closest to you.","tags":["Aimbot Tribe Survival"],"script":"-- LocalScript: Aimbot com painel móvel para PC + MOBILE\n-- Coloque em StarterPlayerScripts\n\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal LP = Players.LocalPlayer\n\n-- GUI\nlocal ScreenGui = Instance.new(\"ScreenGui\", game.CoreGui)\nScreenGui.Name = \"AimbotGUI\"\n\nlocal Btn = Instance.new(\"TextButton\", ScreenGui)\nBtn.Size = UDim2.fromOffset(180,60)\nBtn.Position = UDim2.fromScale(0.03,0.35)\nBtn.BackgroundColor3 = Color3.fromRGB(150,0,0)\nBtn.TextColor3 = Color3.fromRGB(255,255,255)\nBtn.TextScaled = true\nBtn.Text = \"Aimbot OFF\"\n\nlocal UICorner = Instance.new(\"UICorner\", Btn)\nUICorner.CornerRadius = UDim.new(0,10)\n\nlocal enabled = false\n\n-- Função para achar player mais próximo\nlocal function getClosestPlayer()\n\tlocal closestDist = math.huge\n\tlocal closestPlr = nil\n\tif not LP.Character or not LP.Character:FindFirstChild(\"HumanoidRootPart\") then return nil end\n\tlocal myPos = LP.Character.HumanoidRootPart.Position\n\n\tfor _, plr in ipairs(Players:GetPlayers()) do\n\t\tif plr ~= LP and plr.Character and plr.Character:FindFirstChild(\"HumanoidRootPart\") then\n\t\t\tlocal dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude\n\t\t\tif dist < closestDist then\n\t\t\t\tclosestDist = dist\n\t\t\t\tclosestPlr = plr\n\t\t\tend\n\t\tend\n\tend\n\treturn closestPlr\nend\n\n-- Ativar / desativar aimbot\nBtn.MouseButton1Click:Connect(function()\n\tenabled = not enabled\n\tBtn.Text = enabled and \"Aimbot ON\" or \"Aimbot OFF\"\n\tBtn.BackgroundColor3 = enabled and Color3.fromRGB(0,180,0) or Color3.fromRGB(150,0,0)\nend)\n\n-- Aimbot\nRunService.RenderStepped:Connect(function()\n\tif not enabled then return end\n\tlocal target = getClosestPlayer()\n\tif not target or not target.Character then return end\n\n\tlocal myChar = LP.Character\n\tif not myChar then return end\n\n\tlocal hrp = myChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal thrp = target.Character:FindFirstChild(\"HumanoidRootPart\")\n\tif not hrp or not thrp then return end\n\n\thrp.CFrame = CFrame.lookAt(hrp.Position, thrp.Position)\nend)\n\n------------------------------------------------\n-- PAINEL MÓVEL (PC + CELULAR)\n------------------------------------------------\n\nlocal dragging = false\nlocal dragInput, dragStart, startPos\n\nBtn.InputBegan:Connect(function(input)\n\tif input.UserInputType == Enum.UserInputType.MouseButton1\n\tor input.UserInputType == Enum.UserInputType.Touch then\n\n\t\tdragging = true\n\t\tdragStart = input.Position\n\t\tstartPos = Btn.Position\n\n\t\tinput.Changed:Connect(function()\n\t\t\tif input.UserInputState == Enum.UserInputState.End then\n\t\t\t\tdragging = false\n\t\t\tend\n\t\tend)\n\tend\nend)\n\nBtn.InputChanged:Connect(function(input)\n\tif input.UserInputType == Enum.UserInputType.MouseMovement\n\tor input.UserInputType == Enum.UserInputType.Touch then\n\t\tdragInput = input\n\tend\nend)\n\nUserInputService.InputChanged:Connect(function(input)\n\tif dragging and input == dragInput then\n\t\tlocal delta = input.Position - dragStart\n\t\tBtn.Position = UDim2.new(\n\t\t\tstartPos.X.Scale,\n\t\t\tstartPos.X.Offset + delta.X,\n\t\t\tstartPos.Y.Scale,\n\t\t\tstartPos.Y.Offset + delta.Y\n\t\t)\n\tend\nend)","owner":{"_id":"690fbe3a34128879dd39fe97","username":"afk0830","verified":false,"profilePicture":"/images/photo/690fbe3a34128879dd39fe97-1776480597223.png","status":"offline","id":"690fbe3a34128879dd39fe97","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":2095,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/109588872144583-1768779285449.png","likeCount":3,"dislikeCount":0,"createdAt":"2026-01-18T23:34:45.469Z","keyLink":"","executes":807,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"696d6e1505a2e087b9f7dc5e","editBy":{"_id":"690fbe3a34128879dd39fe97","username":"afk0830","status":"offline","id":"690fbe3a34128879dd39fe97"},"message":"Aimbot","createdAt":"2026-01-18T23:34:45.471Z"}],"comments":[{"_id":"696d6ed53593559f36aea16e","commentBy":{"_id":"690fbe3a34128879dd39fe97","username":"afk0830","verified":false,"role":"user","profilePicture":"/images/photo/690fbe3a34128879dd39fe97-1776480597223.png","lastActive":"2026-09-28T02:29:37.034Z","createdAt":"2025-11-08T22:03:38.277Z","status":"offline","id":"690fbe3a34128879dd39fe97","topMilestone":{"key":"creator.scripts","tier":10}},"text":"Leave a like if you found it useful!👍","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-01-18T23:37:57.874Z","liked":false,"disliked":false},{"_id":"696e906389eac87a149d5108","commentBy":{"_id":"653dc058bde2cc49be442fd3","username":"pakupt","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-10-29T02:15:52.412Z","lastActive":"2026-08-23T20:48:00.196Z","status":"offline","id":"653dc058bde2cc49be442fd3","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Work - like script","edited":false,"likeCount":3,"dislikeCount":0,"createdAt":"2026-01-19T20:13:23.489Z","liked":false,"disliked":false},{"_id":"69eac9b36a383068d3d024d5","commentBy":{"_id":"69eac6519f99bf4b139c0885","username":"jacobhaberman","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-05-20T00:13:34.923Z","createdAt":"2026-04-24T01:24:33.302Z","status":"offline","id":"69eac6519f99bf4b139c0885"},"text":"so i clicked the executive now i am confused.","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-04-24T01:38:59.188Z","liked":false,"disliked":false},{"_id":"69eeb8f93bd3c6c4cc3667f9","commentBy":{"_id":"690fbe3a34128879dd39fe97","username"