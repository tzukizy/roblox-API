{"id":8122612051,"name":"Slendytubbies VS Redux","desc":"Based on Slendytubbies by ZeoWorks\n\nCollect and investigate all 15 Tubby Custards in each area as a Guardian, or quench your thirst for blood as a mutant Slendytubby.\n\nSlendytubbies VS Redux is a remaster of Slendytubbies VS, which I made in 2018. Redux was built from the ground up with a lot of passion and with tons more polish!\n\nI RECOMMEND THIS GAME! https://www.roblox.com/games/137110424556384/Slendytubbies-3-Multiplayer#!/game-instances","path":"/game/8122612051-slendytubbies-vs-redux","slug":"8122612051-slendytubbies-vs-redux","thumbnail":{"url":"https://cdn.kocakz.me/images/3c25580c21c2d552f4277cf505903b119bbb767463a6c6051f38aabd1ad07c9a.webp","original":"https://tr.rbxcdn.com/180DAY-2c91b3083f7747b7cd4d90310e9bcb79/150/150/Image/Png/noFilter"},"playing":1092,"visitor":93177933,"verified":false,"updatedAt":"2026-01-20T07:24:07.089Z","creator":{"name":"texbox","type":"Group"},"script":{"count":7,"freeCount":7,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Slendytubbies-VS-Redux-autofarm-87923","_id":"696e6bec1315781380d2c29f","title":"autofarm","game":{"_id":"67e5e1ffb360710ec3c78192","gameId":8122612051,"name":"Slendytubbies VS Redux","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":8122612051},"features":"autofarms custards\nopen source","tags":["slendytubbies","open source"],"script":"loadstring(game:HttpGet('https://raw.githubusercontent.com/WhateverNick7/slendytubies_farm/main/main.luau'))()","owner":{"_id":"65bd3d96cd3cb06a42017957","username":"nick7","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b9581e3635988a8df42266f4778730d3b833ba55b127fef73cd6425d8684b686.webp","original":"https://scriptblox.com/images/photo/65bd3d96cd3cb06a42017957-1752567867592.jpg"},"status":"offline","id":"65bd3d96cd3cb06a42017957","topMil