{"id":4951130016,"name":"The Kinetic Abilities","desc":"The Kinetic Abilities is a pvp game with kinetics as source of power. Gain experience from defeating players or npc's, change your reputation depending on your offense and gain or improve your moves by leveling up.\n\n- TAGS\nsuperpowers, superpower, powers, kinetics, kinetic, abilities, magic, fight, pvp, kinetic abilities, tka, TKA","path":"/game/4951130016-the-kinetic-abilities","slug":"4951130016-the-kinetic-abilities","thumbnail":{"url":"https://media.kocakz.me/748bd6f2e84ed9381de36c9f571424dc9159e9b35a2090dfb5b401956d6f4fce.webp","original":"https://tr.rbxcdn.com/180DAY-7a053d3105a5e6d370836fb896accaa3/150/150/Image/Png/noFilter"},"playing":65,"visitor":63442624,"verified":false,"updatedAt":"2026-08-31T23:18:26.541Z","creator":{"name":"The Kinetic Abilities","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"The-Kinetic-Abilities-TKA-Stamina-Booster-(Keyless)-226360","_id":"6a960bc26042eae79bc40347","title":"TKA Stamina Booster (Keyless)","game":{"_id":"67e5e1ffb360710ec3c7831b","gameId":4951130016,"name":"The Kinetic Abilities","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":4951130016},"features":"Just lets you gain stamina while it drains. Makes some weak moves like invis work forever, and some stronger moves work for longer. Entirely vibe-coded, but keyless.","tags":[],"script":"local UserInputService = game:GetService(\"UserInputService\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal Players = game:GetService(\"Players\")\n\nlocal player = Players.LocalPlayer\n\n-- Configuration\nlocal INTERVAL = 0.25 -- Delay between fires (increase if you experience lag, e.g. 0.5)\nlocal toggled = false\nlocal currentEvent = nil\n\n-- Screen Notification Helper\nlocal function notify(title, text, duration)\n    pcall(function()\n        StarterGui:SetCore(\"SendNotification\", {\n            Title = title,\n            Text = text,\n            Duration = duration or 2\n        })\n    end)\nend\n\n-- Cache Character & Event references to avoid performance drops\nlocal function updateCharacter(char)\n    currentEvent = nil\n    if not char then return end\n    \n    local stamina = char:WaitForChild(\"Stamina\", 5)\n    if stamina then\n        currentEvent = stamina:WaitForChild(\"StaminaEvent\", 5)\n    end\nend\n\nif player.Character then\n    updateCharacter(player.Character)\nend\nplayer.CharacterAdded:Connect(updateCharacter)\n\n-- Main Toggle Loop\nlocal function startLoop()\n    task.spawn(function()\n        while toggled do\n            if currentEvent then\n                currentEvent:FireServer(\"StaminaHold\", false)\n            end\n            task.wait(INTERVAL)\n        end\n    end)\nend\n\n-- Keybind Listener\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n    if gameProcessed then return end\n\n    if input.KeyCode == Enum.KeyCode.N then\n        toggled = not toggled\n\n        if toggled then\n            notify(\"Infinite Stamina\", \"Status: ENABLED\", 2)\n            startLoop()\n        else\n            notify(\"Infinite Stamina\", \"Status: DISABLED\", 2)\n        end\n    end\nend)","owner":{"_id":"6a3ef48b43350ff84d256f48","username":"Kenophobia","verified":false,"profilePicture":{"url":"https://media.kocakz.me/163cafb31bd54fead44338e7e2f83b88d9e6a49d9263c5cc7151e3448ac14307.webp","original":"https://scriptblox.com/images/photo/6a3ef48b43350ff84d256f48-1782510848513.png"},"lvl":5,"status":"offline","id":"6a3ef48b43350ff84d256f48","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/163cafb31bd54fead44338e7e2f83b88d9e6a49d9263c5cc7151e3448ac14307.webp","original":"https://scriptblox.com/images/photo/6a3ef48b43350ff84d256f48-1782510848513.png"}},"verified":false,"views":350,"executes":953,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/a1b9fe42c0479cae4b1ef64aa09cff3d89ee0adfd092ff9980a6ce1848d4498c.webp","original":"https://scriptblox.com/images/sb/rbx-7d47c9fd71d35f50935c4351bda20b0f-f7c6d719092a.png","scriptblox":"https://scriptblox.com/images/script/rbx-7d47c9fd71d35f50935c4351bda20b0f-f7c6d719092a.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-08-31T23:18:26.544Z","keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:02:00.737Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/a1b9fe42c0479cae4b1ef64aa09cff3d89ee0adfd092ff9980a6ce1848d4498c.webp","original":"https://scriptblox.com/images/sb/rbx-7d47c9fd71d35f50935c4351bda20b0f-f7c6d719092a.png","scriptblox":"https://scriptblox.com/images/script/rbx-7d47c9fd71d35f50935c4351bda20b0f-f7c6d719092a.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a960bc26042eae79bc40349","editBy":{"_id":"6a3ef48b43350ff84d256f48","username":"Kenophobia","status":"offline","id":"6a3ef48b43350ff84d256f48"},"message":"Create script","createdAt":"2026-08-31T23:18:26.556Z"}],"comments":[{"_id":"6a9b16cbfe27f947f5ad9b71","commentBy":{"_id":"6a3ef48b43350ff84d256f48","username":"Kenophobia","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/163cafb31bd54fead44338e7e2f83b88d9e6a49d9263c5cc7151e3448ac14307.webp","original":"https://scriptblox.com/images/photo/6a3ef48b43350ff84d256f48-1782510848513.png"},"lastActive":"2026-10-15T19:19:59.088Z","createdAt":"2026-06-26T21:52:11.635Z","lvl":5,"status":"offline","id":"6a3ef48b43350ff84d256f48","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/163cafb31bd54fead44338e7e2f83b88d9e6a49d9263c5cc7151e3448ac14307.webp","original":"https://scrip