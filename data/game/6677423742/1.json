{"id":6677423742,"name":"Five Nights At Your Friends [FNAF]","desc":"⚠️ [HUGE UPDATES COMING SOON] ⚠️\n\nCan you survive a night against your friends?\nThis game is basically FNAF but allows you to make the animatronics your friends :D\n\nThis is a fan game of Five Nights at Freddy's.\n\nTags: FNAF, Horror, Five Nights At Freddy's, FNAF Roblox, Friends, Scary","path":"/game/6677423742-five-nights-at-your-friends-fnaf","slug":"6677423742-five-nights-at-your-friends-fnaf","thumbnail":["https://tr.rbxcdn.com/180DAY-56557ee68d14b7de473d866ba39be612/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-af510f5a9451470b01d57ce1a3651996/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":41,"visitor":27644257,"verified":false,"updatedAt":"2025-02-20T15:54:57.436Z","creator":{"name":"Five Nights at Your Friends","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Five-Nights-At-Your-Friends-FNAF-Animronic-highlight-29855","_id":"67b75051813b8a301dd5b2cc","title":"Animatronic highlight","game":{"_id":"67e5e1ffb360710ec3c78af2","gameId":6677423742,"name":"Five Nights At Your Friends [FNAF]","imageUrl":"/images/sb/rbx-af510f5a9451470b01d57ce1a3651996-814574dfdc73.png","placeId":6677423742},"features":"Highlights all animatronics in both parts. Re-execute the script when night starts","tags":[],"script":"local workspace = game:GetService(\"Workspace\")\n\nlocal function createHighlight(character)\n\n    if not character:FindFirstChild(\"Highlight\") then\n        local highlight = Instance.new(\"Highlight\")\n        highlight.Parent = character \n        highlight.FillColor = Color3.new(1, 0, 0) \n        highlight.FillTransparency = 0.5 \n        highlight.OutlineColor = Color3.new(0, 0, 0) \n        highlight.OutlineTransparency = 0 \n    end\nend\n\nfor _, character in pairs(workspace.Characters:GetChildren()) do\n\n    if character:IsA(\"Model\") and character:FindFirstChildOfClass(\"Humanoid\") then\n        createHighlight(character) \n    end\nend\n","owner":{"_id":"6771403793a5452b6d8517cc","username":"Figure_play","verified":false,"profilePicture":"/images/photo/6771403793a5452b6d8517cc-1735475396247.jpg","status":"offline","id":"6771403793a5452b6d8517cc","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"keyLink":"","views":10093,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-20T15:54:57.436Z","dislikeCount":0,"likeCount":0,"image":"https://tr.rbxcdn.com/180DAY-36a73bffd4196e3c01f92816f1508fcd/500/280/Image/Jpeg/noFilter","executes":120,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4da4d","editBy":{"_id":"6771403793a5452b6d8517cc","username":"Figure_play","status":"offline","id":"6771403793a5452b6d8517cc"},"message":"Create script","createdAt":"2025-02-20T15:57:34.067Z"},{"_id":"67e5e1e7b360710ec3c54fef","editBy":{"_id":"6771403793a5452b6d8517cc","username":"Figure_play","status":"offline","id":"6771403793a5452b6d8517cc"},"message":"Update script","createdAt":"2025-03-27T17:20:33.034Z"}],"comments":[{"_id":"67b9ea4097d44a562240e331","commentBy":{"_id":"621d2eb28cf932ffdef0d7ee","username":"milowreisler","verified":false,"role":"user","profilePicture":"/images/photo/621d2eb28cf932ffdef0d7ee-1657807399796.png","createdAt":"2022-02-28T20:21:06.189Z","lastActive":"2025-06-05T14:59:17.317Z","status":"offline","id":"621d2eb28cf932ffdef0d7ee","topMilestone":{"key":"creator.first_script","tier":1}},"text":"dont work","createdAt":"2025-02-22T15:16:16.199Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"67bad0ee0d0d11fa2d556e9b","commentBy":{"_id":"6771403793a5452b6d8517cc","username":"Figure_play","verified":false,"role":"user","profilePicture":"/images/photo/6771403793a5452b6d8517cc-1735475396247.jpg","createdAt":"2024-12-29T12:27:35.601Z","lastActive":"2026-10-09T16:29: