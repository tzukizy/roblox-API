lse,"key":false,"keyless":false,"views":18826,"executes":8,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/37d9291cfd4d952caa01ee59f65813b83459be92e968bb987f5470110917a9ea.webp","original":"https://scriptblox.com/images/sb/11883610532-1695288653106.webp","scriptblox":"https://scriptblox.com/images/script/11883610532-1695288653106.webp"},"thumbnail":{"url":"https://media.kocakz.me/37d9291cfd4d952caa01ee59f65813b83459be92e968bb987f5470110917a9ea.webp","original":"https://scriptblox.com/images/sb/11883610532-1695288653106.webp","scriptblox":"https://scriptblox.com/images/script/11883610532-1695288653106.webp"},"likeCount":0,"dislikeCount":1,"createdAt":"2023-09-21T09:30:53.207Z","updatedAt":"2023-09-21T09:30:53.207Z","lastBump":"2023-09-21T09:30:53.207Z","script":"--[[\n   Made by Rileyy#0808\n   FiveDuels silent aim.lua\n   as for prediction, use basic velocity prediction sets, 0.1377 works pretty well though\n]]\n\ngetgenv().user_settings = {\n   enabled = true,\n   hitbox = 'HumanoidRootPart',\n\n   fov_radius = 200,\n   prediction = 0.1377 -- you can use this or 0,\n}\n\n--// VARIABLES\nlocal players = game:GetService('Players')\nlocal runservice = game:GetService('RunService')\nlocal userinputservice = game:GetService('UserInputService')\n\nlocal current_camera = workspace.CurrentCamera\nlocal local_player = players.LocalPlayer\nlocal mouse = local_player:GetMouse()\n\nlocal client = {}\n\nlocal fov_circle = Drawing.new('Circle')\nfov_circle.Visible = true\nfov_circle.Color = Color3.new(1, 1, 1)\nfov_circle.Thickness = 1\n\n\n\nrunservice.PostSimulation:Connect(function()\n   local mouse_position = userinputservice:GetMouseLocation()\n   \n   fov_circle.Radius = user_settings.fov_radius\n   fov_circle.Position = mouse_position\n\n   client.target = nil\n   client.target_distance = fov_circle.Radius\n\n   for _, player in next, players:GetChildren() do\n       local humanoidrootpart = player.Character and player.Character:FindFirstChild('HumanoidRootPart')\n       local humanoid = player.Character and player.Character:FindFirstChildWhichIsA('Humanoid')\n\n       if not humanoidrootpart or not humanoid then\n           continue\n       end\n\n       if humanoid.Health <= 0 then\n           continue\n       end\n\n       local screen_position, screen_visible = current_camera:WorldToViewportPoint(humanoidrootpart.Position); screen_position = Vector2.new(screen_position.X, screen_position.Y)\n       local mouse_distance = (screen_position - mouse_position).magnitude\n\n       if not screen_visible then\n           continue\n       end\n\n       if mouse_distance < client.target_distance then\n           client.target = player\n           client.target_distance = mouse_distance\n       end\n   end\nend)\n\nlocal namecall; namecall = hookmetamethod(game, '__namecall', function(obj, ...)\n   local args = {...}\n   local method = getnamecallmethod()\n\n   if method == 'FireServer' and obj.Name == 'RemoteEvent' and args[1] == 'shoot' and client.target and client.target.Character[user_settings.hitbox] then\n       args[2][1] = client.target.Character[user_settings.hitbox].Position + (client.target.Character.HumanoidRootPart.Velocity * user_settings.prediction)\n   end\n\n   return namecall(obj, unpack(args))\nend)","features":"Silent aim","tags":[],"discord":"","keyLink":"","owner":{"_id":"6506c53e2df0a158d6f2912c","username":"flownexploitss","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6506c53e2df0a158d6f2912c","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:10:40.288Z","last":"","win":14