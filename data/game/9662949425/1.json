iretouchinterest(player.Character.HumanoidRootPart, sell, 1)\n       end\n   end\n   if upgrade then\n       game:GetService(\"Workspace\").UpgradeBone:FireServer()\n   end\n   if rebirth then\n       game:GetService(\"ReplicatedStorage\").Rebirth:FireServer(tonumber(player.PlayerGui.RebirthShop.Frame.RebirthLevel.Text))\n   end\nend","owner":{"_id":"6315001f5ff1d45038a97852","username":"Kastr0Div1ne","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6315001f5ff1d45038a97852-1662320879598.jpg"},"status":"offline","id":"6315001f5ff1d45038a97852","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/6315001f5ff1d45038a97852-1662320879598.jpg"}},"verified":false,"views":13902,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-09-15T21:05:45.908Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/9f201d9199017e3616f98fb68b92f5f9/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/9f201d9199017e3616f98fb68b92f5f9/500/280/Image/Jpeg"},"executes":147,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T05:12:21.870Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/9f201d9199017e3616f98fb68b92f5f9/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/9f201d9199017e3616f98fb68b92f5f9/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4ed99","editBy":{"_id":"6315001f5ff1d45038a97852","username":"Kastr0Div1ne","status":"offline","id":"6315001f5ff1d45038a97852"},"message":"Create script","createdAt":"2025-03-27T15:20:19.834Z