":false,"supportedGames":[],"changelog":[{"_id":"68cb38da5c976c7558644f2c","editBy":{"_id":"67319fa068f35779227f3f39","username":"akifrzayev06","status":"offline","id":"67319fa068f35779227f3f39"},"message":"Create script","createdAt":"2025-09-17T22:40:26.373Z"}],"comments":[{"_id":"68cb8bdb0c580856cb50b3b2","commentBy":{"_id":"672a5e62efaa549629bc20c3","username":"indianmanindia8","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-11-05T18:05:22.278Z","lastActive":"2025-09-22T04:50:50.938Z","status":"offline","id":"672a5e62efaa549629bc20c3"},"text":"Hey can you make a inf lvl script for a game called Reds RPG","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-18T04:34:35.150Z","liked":false,"disliked":false},{"_id":"68cba2de2d77cf13f6095a05","commentBy":{"_id":"67deb8b3a30623be5b8040c9","username":"112nik22345","verified":false,"role":"user","profilePicture":"/images/photo/67deb8b3a30623be5b8040c9-1758205454330.png","createdAt":"2025-03-22T13:18:43.544Z","lastActive":"2025-11-22T21:43:29.008Z","status":"offline","id":"67deb8b3a30623be5b8040c9","topMilestone":{"key":"creator.scripts","tier":10}},"text":"script works","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-09-18T06:12:46.431Z","liked":false,"disliked":false},{"_id":"68d01d8114cbf6e718a503fb","commentBy":{"_id":"663647799f6b1fc4e47adf51","username":"ZERETET","verified":false,"role":"user","profilePicture":"/images/photo/663647799f6b1fc4e47adf51-1748065294571.jpg","createdAt":"2024-05-04T14:34:33.204Z","lastActive":"2026-09-10T00:44:04.046Z","status":"offline","id":"663647799f6b1fc4e47adf51","topMilestone":{"key":"creator.likes","tier":100}},"text":"script sucks","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-21T15:45:05.628Z","liked":false,"disliked":false},{"_id":"693332b484e710d93ce2ae25","commentBy":{"_id":"6921160644574deff0462f0e","username":"Blackknight","verified":false,"role":"user","profilePicture":"/images/photo/6921160644574deff0462f0e-1765041450071.jpg","lastActive":"2026-07-20T05:12:36.247Z","createdAt":"2025-11-22T01:46:46.270Z","status":"offline","id":"6921160644574deff0462f0e"},"text":"Funciona","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-12-05T19:29:56.207Z","liked":false,"disliked":false}]},{"slug":"Pick-or-Skip-Infinite-Money-And-Infinite-Super-likes-And-Lag-Server-53056","_id":"68c5eb264db66b890fa8b640","title":"Infinite Money And Infinite Super likes And Lag Server","game":{"_id":"68a43edd9d3c07cb16055bb6","gameId":131464068511329,"name":"Pick or Skip 🔥","imageUrl":"/images/sb/rbx-c143d7640476d9d9862c813e9b187221-b37aa7d1da3a.png","placeId":131464068511329},"features":"This was made within like 20 minutes so it can definitely be improved lol\nI left out a lot of stuff for the troll feature (annoy) so if anyone they can use Turtle Spy to add n work off this more\n\n- Infinite money\n- Infinite Super Likes\n- Lag server / Spam troll lobby, may need to rejoin every now and then","tags":["lag","autofarm","infinite","troll","money"],"script":"-- Script by 12slash25 or GachaOnlineScripter\n-- ClaimPlaytimeEvent spam with toggle + Annoy Server button\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal PlayerGui = LocalPlayer:WaitForChild(\"PlayerGui\")\n\n-- Remote references\nlocal ClaimPlaytimeEvent = ReplicatedStorage:WaitForChild(\"RemoteEvents\"):WaitForChild(\"ClaimPlaytimeEvent\")\nlocal TrollCashEvent = ReplicatedStorage:WaitForChild(\"RemoteEvents\"):WaitForChild(\"TrollEvent\"):WaitForChild(\"TrollCashEvent\")\n\n-- Rewards (skip Day3)\nlocal rewards = {\n    PlayerGui.MainGui.PlayTimeReword.Day1,\n    PlayerGui.MainGui.PlayTimeReword.Day2,\n    PlayerGui.MainGui.PlayTimeReword.Day4,\n    PlayerGui.MainGui.PlayTimeReword.Day5, -- super like\n    PlayerGui.MainGui.PlayTimeReword.Day6,\n    PlayerGui.MainGui.PlayTimeReword.Day7  -- 100 bucks\n}\n\n-- Troll types (added all new ones you asked for)\nlocal trolls = {\n    \"Clown\",\n    \"TinyHead\",\n    \"Dog\",\n    \"Asylum\",\n    \"ChickenPlayer\",\n    \"SnowMan\",\n    \"Cat\",\n    \"StikPlayer\",\n    \"BunnyHop\",\n    \"SpaceTroll\",\n    \"BaconHair\",\n    \"BigHeadClown\",\n    \"DinoRider\"\n}\n\n-- Toggle states\nlocal runningRewards = true\nlocal runningAnnoy = false\n\n-- GUI setup\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"PlaytimeToggleGUI\"\nscreenGui.ResetOnSpawn = false\nscreenGui.Parent = PlayerGui\n\n-- Rewards button\nlocal buttonRewards = Instance.new(\"TextButton\")\nbuttonRewards.Size = UDim2.new(0, 80, 0, 30)\nbuttonRewards.Position = UDim2.new(1, -90, 0, 10) -- top-right\nbuttonRewards.BackgroundColor3 = Color3.fromRGB(50, 150, 50)\nbuttonRewards.TextColor3 = Color3.fromRGB(255, 255, 255)\nbuttonRewards.Font = Enum.Font.SourceSansBold\nbuttonRewards.TextSize = 14\nbuttonRewards.Text = \"Pause\"\nbuttonRewards.Parent = screenGui\n\nbuttonRewards.MouseButton1Click:Connect(function()\n    runningRewards = not runningRewards\n    if runningRewards then\n        buttonRewards.Text = \"Pause\"\n        buttonRewards.BackgroundColor3 = Color3.fromRGB(50, 150, 50)\n    else\n        buttonRewards.Text = \"Start\"\n        buttonRewards.BackgroundColor3 = Color3.fromRGB(150, 50, 50)\n    end\nend)\n\n-- Annoy Server button\nlocal buttonAnnoy = Instance.new(\"TextButton\")\nbuttonAnnoy.Size = UDim2.new(0, 80, 0, 30)\nbuttonAnnoy.Position = UDim2.new(1, -90, 0, 50) -- under rewards button\nbuttonAnnoy.BackgroundColor3 = Color3.fromRGB(150, 50, 50)\nbuttonAnnoy.TextColor3 = Color3.fromRGB(255, 255, 255)\nbuttonAnnoy.Font = Enum.Font.SourceSansBold\nbuttonAnnoy.TextSize = 14\nbuttonAnnoy.Text = \"Annoy: OFF\"\nbuttonAnnoy.Parent = screenGui\n\nbuttonAnnoy.MouseButton1Click:Connect(function()\n    runningAnnoy = not runningAnnoy\n    if runningAnnoy then\n        buttonAnnoy.Text = \"Annoy: ON\"\n        buttonAnnoy.BackgroundColor3 = Color3.fromRGB(200, 50, 50)\n    else\n        buttonAnnoy.Text = \"Annoy: OFF\"\n        buttonAnnoy.BackgroundColor3 = Color3.fromRGB(150, 50, 50)\n    end\nend)\n\n-- Reward claim loop\ntask.spawn(function()\n    while true do\n        if runningRewards then\n            for _, reward in ipairs(rewards) do\n                for i = 1, 100 do -- claim 100x each\n                    ClaimPlaytimeEvent:FireServer(reward)\n                end\n            end\n        end\n        task.wait(0.01)\n    end\nend)\n\n-- Annoy server loop\ntask.spawn(function()\n    while true do\n        if runningAnnoy then\n            for _, player in ipairs(Players:GetPlayers()) do\n                if player.Name ~= LocalPlayer.Name then\n                    for _, troll in ipairs(trolls) do\n                        TrollCashEvent:FireServer(player.Name, troll)\n                    end\n                end\n            end\n        end\n        task.wait(0.1)\n    end\nend)\n","owner":{"_id":"62c3a66a1b5c9eb83fd06ead","username":"12slash25","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"62c3a66a1b5c9eb83fd06ead"},"verified":false,"views":3147,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-c143d7640476d9d9862c813e9b187221-b37aa7d1da3a.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-09-13T22:07:34.078Z","executes":51,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c5eb264db66b890fa8b642","editBy":{"_id":"62c3a66a1b5c9eb83fd06ead","username":"12slash25","status":"offline","id":"62c3a66a1b5c9eb83fd06ead"},"message":"Create script","createdAt":"2025-09-13T22:07:34.080Z"}],"comments":[{"_id":"68c5ed2132a63e6e3bb5be4b","commentBy":{"_id":"68c0bf33e5cde5525f88eaf3","username":"kirbyfan1213","verified":false,"role":"user","profilePicture":"/images/photo/68c0bf33e5cde5525f88eaf3-1757462462506.png","cre