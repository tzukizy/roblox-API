{"id":97765240439683,"name":"🦾SUPERMAN | Legacy Of Krypton [BETA] ","desc":"","path":"/game/97765240439683-superman-legacy-of-krypton-beta","slug":"97765240439683-superman-legacy-of-krypton-beta","thumbnail":["https://tr.rbxcdn.com/180DAY-5fd09f2c5c2d172b108735e3467ea0b0/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-b9c25016751825d0dd7149e99079f846/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":0,"visitor":0,"verified":false,"updatedAt":"2026-02-20T06:05:35.707Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"SUPERMAN-or-Legacy-Of-Krypton-BETA-INF-STAT-POINTS-114492","_id":"6997f9afee9430ea80c81c43","title":"INF STAT POINTS","game":{"_id":"6997f9afee9430ea80c81c40","gameId":97765240439683,"name":"🦾SUPERMAN | Legacy Of Krypton [BETA] ","imageUrl":"/images/sb/rbx-b9c25016751825d0dd7149e99079f846-cd71d7eb9a4d.png","placeId":97765240439683},"features":"DO NOT ABUSE!!!!\nINFINITE STAT POINTS","tags":["inf","stats","game","roblox"],"script":"local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()\n\ngetgenv().CustomPointsAmount = -10000  -- Default starting value\n\nlocal Window = Rayfield:CreateWindow({\n   Name = \"Sandman's Legacy Of Krypton | Stat Points ⚠️\",\n   LoadingTitle = \"Loading Custom Stat Points...\",\n   LoadingSubtitle = \"by Mr.Sandman - ALT ONLY\",\n   ConfigurationSaving = {\n      Enabled = true,\n      FolderName = \"SandManHub\",\n      FileName = \"Krypton_StatPoints\"\n   },\n   KeySystem = false\n})\n\nlocal MainTab = Window:CreateTab(\"Stat Points\", 4483362458)\n\n-- Slider: Negative values only (-1 to -1,000,000)\nMainTab:CreateSlider({\n   Name = \"Inf Stat Points (-1m is higher than -1)\",\n   Range = {-1000000, -1},          -- From -1,000,000 to -1\n   Increment = 1000,                -- Step by 1,000 for easier sliding\n   Suffix = \" Points\",\n   CurrentValue = -10000,           -- Starts at a moderate negative\n   Flag = \"StatPointsAmount\",\n   Callback = function(Value)\n      getgenv().CustomPointsAmount = Value\n      Rayfield:Notify({\n         Title = \"Amount Updated\",\n         Content = \"Set to: \" .. Value .. \" (more negative = bigger overflow)\",\n         Duration = 3\n      })\n   end,\n})\n\n-- Apply button\nMainTab:CreateButton({\n   Name = \"Apply to combatDamage\",\n   Callback = function()\n      pcall(function()\n         local args = {\n            \"Add\",\n            \"combatDamage\",\n            getgenv().CustomPointsAmount\n         }\n         game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Events\"):WaitForChild(\"ChangeValue\"):FireServer(unpack(args))\n      end)\n      Rayfield:Notify({\n         Title = \"Fired!\",\n         Content = \"Sent \" .. getgenv().CustomPointsAmount .. \" to combatDamage\",\n         Duration = 4,\n         Image = 4483362458\n      })\n   end,\n})\n\n-- Quick exit\nMainTab:CreateButton({\n   Name = \"Destroy GUI\",\n   Callback = function()\n      task.wait(1)\n      Rayfield:Destroy()\n   end,\n})\n\nRayfield:Notify({\n   Title = \"Loaded - Negative Stat Points\",\n   Content = \"Slide (more negative = stronger) → Apply • ALT account recommended\",\n   Duration = 5,\n   Image = 4483362458\n})","owner":{"_id":"6288134d5dc60d198ceb7c67","username":"TheSandMan","verified":false,"profilePicture":"/images/photo/6288134d5dc60d198ceb7c67-1771196043584.jpg","status":"offline","id":"6288134d5dc60d198ceb7c67","topMilestone":{"key":"creator.likes","tier":100}},"verified":false,"views":4101,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-b9c25016751825d0dd7149e99079f846-cd71d7eb9a4d.png","likeCount":19,"dislikeCount":2,"createdAt":"2026-02-20T06:05:35.708Z","executes":944,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6997f9afee9430ea80c81c46","editBy":{"_id":"6288134d5d