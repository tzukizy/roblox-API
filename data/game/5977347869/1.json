{"id":5977347869,"name":"Tower Battles: Battlefront","desc":"Welcome to Tower Battles: Battlefront. In this game, experience what it's like to be a tower or zombie from the tower defense game Tower Battles.\n\nGame icon and some badge icons made by DeseaTM\nRailgunner game thumbnail made by amyruan101\n\nPublic Testing: https://www.roblox.com/games/6403621507/TBBF-Public-Testing\nPre-Group: https://www.roblox.com/games/1869633269/TBBF-Pre-Group\nOriginal game: https://www.roblox.com/games/45146873/Tower-Battles","path":"/game/5977347869-tower-battles-battlefront","slug":"5977347869-tower-battles-battlefront","thumbnail":["https://tr.rbxcdn.com/180DAY-5fc5215d7cc80cb7322c45a92eafb87f/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-79f2cb8b9ef8fc71c7c687614c184a2e/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":123,"visitor":43340411,"verified":false,"updatedAt":"2025-05-19T15:49:54.991Z","creator":{"name":"Tower Battles: Battlefront","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Tower-Battles:-Battlefront-TBBF-Expand-Hitboxes-40340","_id":"682b53225538a79a534bb5e8","title":"TBBF Expand Hitboxes","game":{"_id":"682b53225538a79a534bb5e5","gameId":5977347869,"name":"Tower Battles: Battlefront","imageUrl":"/images/sb/rbx-79f2cb8b9ef8fc71c7c687614c184a2e-afd8bcdc73ac.png","placeId":5977347869},"features":"expands zombie hitboxes, works any executor\n\nmade by me and killa0731\n\nJOIN OUR DISCORD SERVER:\nhttps://discord.gg/QfbaKXHZyu","tags":["hitboxes","expand hitboxes","aimbot"],"script":"local runService = game:GetService(\"RunService\")\n\nlocal npcs = workspace.Game.Zombies\n\nrunService.RenderStepped:Connect(function()\n    for _, v in npcs:GetChildren() do\n        if not v:FindFirstChild(\"Head\") then continue end\n\n        v.Head.Size = Vector3.new(40, 40, 40)\n        v.Head.Material = \"Neon\"\n        v.Head.BrickColor = BrickColor.new(\"Really blue\")\n        v.Head.Transparency = 0.7\n        v.Head.CanCollide = false\n        v.Head.Massless = true\n    end\nend)","owner":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","verified":false,"profilePicture":"/images/photo/64ecc9401fb9a1bf9dc1410b-1694315248499.png","status":"offline","id":"64ecc9401fb9a1bf9dc1410b","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":8887,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/5977347869-1747669794946.webp","likeCount":4,"dislikeCount":0,"createdAt":"2025-05-19T15:49:54.992Z","executes":326,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"682b53225538a79a534bb5ea","editBy":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","status":"offline","id":"64ecc9401fb9a1bf9dc1410b"},"message":"Create script","createdAt":"2025-05-19T15:49:54.994Z"}],"comments":[{"_id":"682ca1c6529c9f3c379d56d3","commentBy":{"_id":"682c9f1373e9ef14402c626e","username":"377752452","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-05-20T15:26:11.108Z","lastActive":"2025-10-10T14:53:00.486Z","status":"offline","id":"682c9f1373e9ef14402c626e"},"text":"it doesnt work im using delta","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2025-05-20T15:37:42.247Z","liked":false,"disliked":false},{"_id":"682de8baf9777eddd8981031","commentBy":{"_id":"64ecc9401fb9a1bf9dc1410b","username":"serick","verified":false,"role":"user","profilePicture":"/images/photo/64ecc9401fb9a1bf9dc1410b-1694315248499.png","createdAt":"2023-08-28T16:20:16.491Z","lastActive":"2025-12-29T19:42:12.781Z","status":"offline","id":"64ecc9401fb9a1bf9dc1410b","topMilestone":{"key":"creator.scripts","tier":5}},"text":"seems like it works only on pc","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-05-21T14:52:42.565Z","liked":false,"disliked":false},{"_id":"6857b0cb3b5549c393556d0f","comme