editBy":{"_id":"6998914cf0045c3983e7ea18","username":"ROCTA","status":"offline","id":"6998914cf0045c3983e7ea18"},"message":"Update script","createdAt":"2026-03-19T21:42:31.942Z"}],"comments":[]},{"_id":"699f3c18aa6b611cc56d8702","title":"Stupid ai script","game":{"_id":"699cc0d83651cddb4f8095e8","gameId":100555622228395,"name":"Tripmine Trouble 💣","imageUrl":{"url":"https://media.kocakz.me/f60e4e7f5aceef8661a9ac40d7cb4744483fd00bf2b85207423843902b5784e6.webp","original":"https://tr.rbxcdn.com/180DAY-d53eacb8cfe819fff453ae37390a1d00/150/150/Image/Png/noFilter"},"slug":"100555622228395-tripmine-trouble","path":"/game/100555622228395-tripmine-trouble","thumbnail":{"url":"https://media.kocakz.me/f60e4e7f5aceef8661a9ac40d7cb4744483fd00bf2b85207423843902b5784e6.webp","original":"https://tr.rbxcdn.com/180DAY-d53eacb8cfe819fff453ae37390a1d00/150/150/Image/Png/noFilter"},"placeId":100555622228395},"slug":"Tripmine-Trouble-Stupid-ai-script-122034","verified":false,"key":false,"keyless":false,"views":624,"executes":112,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/799c8ce913ff808682c744b0725a83228faada46ea801f799cb9b20f5c16e20c.webp","original":"https://scriptblox.com/images/sb/100555622228395-1772043288302.jpg","scriptblox":"https://scriptblox.com/images/script/100555622228395-1772043288302.jpg"},"thumbnail":{"url":"https://media.kocakz.me/799c8ce913ff808682c744b0725a83228faada46ea801f799cb9b20f5c16e20c.webp","original":"https://scriptblox.com/images/sb/100555622228395-1772043288302.jpg","scriptblox":"https://scriptblox.com/images/script/100555622228395-1772043288302.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-25T18:14:48.333Z","updatedAt":"2026-02-25T18:14:48.333Z","lastBump":"2026-02-25T18:14:48.333Z","script":"local Workspace = game:GetService(\"Workspace\")\n\nlocal folders = {\n\tWorkspace:WaitForChild(\"TripMines\"),\n\tWorkspace:WaitForChild(\"Traps\")\n}\n\n-- Create 2D billboard\nlocal function addBillboard(model)\n\tif not model:IsA(\"Model\") then return end\n\t\n\t-- Prevent duplicates\n\tif model:FindFirstChild(\"TrapBillboard\") then return end\n\t\n\tlocal basePart = model:FindFirstChildWhichIsA(\"BasePart\", true)\n\tif not basePart then return end\n\t\n\t-- BillboardGui\n\tlocal billboard = Instance.new(\"BillboardGui\")\n\tbillboard.Name = \"TrapBillboard\"\n\tbillboard.Size = UDim2.new(0, 40, 0, 40)\n\tbillboard.StudsOffset = Vector3.new(0, 2.5, 0)\n\tbillboard.AlwaysOnTop = true\n\tbillboard.Parent = basePart\n\t\n\t-- Red circle\n\tlocal circle = Instance.new(\"Frame\")\n\tcircle.Size = UDim2.new(1, 0, 1, 0)\n\tcircle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)\n\tcircle.BorderSizePixel = 0\n\tcircle.Parent = billboard\n\t\n\t-- Make it circular\n\tlocal corner = Instance.new(\"UICorner\")\n\tcorner.CornerRadius = UDim.new(1, 0)\n\tcorner.Parent = circle\nend\n\n-- Connect folders\nfor _, folder in ipairs(folders) do\n\t\n\t-- Existing models\n\tfor _, child in ipairs(folder:GetChildren()) do\n\t\taddBillboard(child)\n\tend\n\t\n\t-- New models\n\tfolder.ChildAdded:Connect(function(child)\n\t\ttask.wait()\n\t\taddBillboard(child)\n\tend)\n\t\nend","features":"Basically shows every trap tripmine on the game","tags":["Ai","Skid","Tripmine"],"discord":"","keyLink":"","owner":{"_id":"68a31cfecb3bc793fa7a65d2","username":"John_Skibidi","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d730e1ce924ba06ba9e221754ecf91849f8bd268cc955c6e9076a6acdc3e3e24.webp","original":"https://scriptblox.com/images/photo/68a31cfecb3bc793fa7a65d2-1777056080690.png"},"status":"offline","id":"68a31cfecb3bc793fa7a65d2","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://media.kocakz.me/d730e1ce924ba06ba9e221754ecf91849f8bd268cc955c6e9076a6acdc3e3e24.webp","original":"https://scriptblox.com/images/photo/68a31cfecb3bc793fa7a65d2-1777056080690.png"}},"reviewed":null,"liked":false,"disliked":false