{"id":107453571103389,"name":"Forest: RPG","desc":"Forest: RPG is a modernized take on a classic sandboxed RPG game where you fight mobs, level up, and move to the next world.\n\n(Test game)","path":"/game/107453571103389-forest-rpg","slug":"107453571103389-forest-rpg","thumbnail":{"url":"https://cdn.kocakz.me/images/48a2ca8309c936753ee60b2a88384f04ac6a08ebf2acf1643238602c0ab77720.webp","original":"https://tr.rbxcdn.com/180DAY-5d296e751b13ed1f26d869c8312470b0/150/150/Image/Png/noFilter"},"playing":0,"visitor":708354,"verified":false,"updatedAt":"2025-10-31T01:35:59.919Z","creator":{"name":"Gamedub","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Forest:-RPG-Kill-Aura-52601","_id":"68c2b9aeb5df6d3e463b69cc","title":"Kill Aura","game":{"_id":"68c2b9aeb5df6d3e463b69c9","gameId":107453571103389,"name":"Forest: RPG","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":107453571103389},"features":"Kill Aura","tags":[],"script":"local RunService = game:GetService(\"RunService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal KillAura = false\nlocal Library = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/theneutral0ne/wally-modified/refs/heads/main/wally-modified.lua\"))()\nlocal Window = Library:CreateWindow(\"Credit: Neutral\")\nWindow:Toggle(\"Kill Aura\", {}, function(Value)\n    KillAura = Value\nend)\n\nRunService.RenderStepped:Connect(function(Delta)\n    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n    local HumanoidRootPart = Character and Character:FindFirstChild(\"HumanoidRootPart\")\n    if not (Character or HumanoidRootPart) then return end\n    if KillAura then\n        local NearestMob,NearestMobDistance = nil,20\n        for _, Mob in workspace.World.Mobs:GetChildren() do\n            if Mob:FindFirstChild(\"Humanoid\") and Mob.Humanoid.Health > 0 then\n                local Distance = (HumanoidRootPart.Position - Mob.HumanoidRootPart.Position).Magnitude\n                if Distance < NearestMobDistance then\n                    NearestMob = Mob\n                    NearestMobDistance = Distance\n                end\n            end\n        end\n        if NearestMob then\n            ReplicatedStorage.Network.Remotes.DamageFire:FireServer(NearestMob)\n        end\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"views":568691,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/604d248254c5cb19efd6a582ae580e6f13782dfd3e4ed9f65339b6ed92d124a1.webp","original":"https://scriptblox.com/images/sb/rbx-90646aee36a7e12c758838c6710e8b1a-d4114c26e1ae.png","scriptblox":"https://scriptblox.com/images/script/rbx-90646aee36a7e12c758838c6710e8b1a-d4114c26e1ae.png"},"likeCount":14,"dislikeCount":0,"createdAt":"2025-09-11T11:59:42.873Z","keyLink":"","executes":19,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":fal