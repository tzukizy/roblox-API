{"id":116965629608311,"name":"[🐰] Hood Wars","desc":"BECOME A LEGEND OF THE HOOD in Hood Wars!!\n\nChoose a class, jump into fast paced PvP, hit a lick to collect accessories, and sell them for cash. Outplay everyone and prove you run the streets.\n\nCODES: Find codes in our social links!\n\nThis is a work of fiction. Any resemblance to actual persons, living or dead, or actual events is purely coincidental.\n\n🎮CONTROLS:\nShoot - LCLICK [PC], R2 [CONSOLE]\nAim - RCLICK [PC], L2 [CONSOLE]\nReload - R [PC], X [CONSOLE]\nSneak - LSHIFT [PC], B [CONSOLE]\nMouse Lock - LCTRL [PC]\nEmote - T [PC], DPadDown [CONSOLE]\n\n💛LIKE, FAVORITE, and JOIN the group for REWARDS!","path":"/game/116965629608311-hood-wars","slug":"116965629608311-hood-wars","thumbnail":{"url":"https://media.kocakz.me/618c10566ca0301a811488a7383212981a7f9636d6361b4493435d9fe5ace87d.webp","original":"https://tr.rbxcdn.com/180DAY-6ee9f1bbcce36fead00459cb9b705cfa/150/150/Image/Png/noFilter"},"playing":12,"visitor":3290217,"verified":false,"updatedAt":"2026-04-13T12:45:28.488Z","creator":{"name":"Lego Gun Games","type":"Group"},"script":{"count":3,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"69dce568b11a4c4eace99202","title":"Huma HUB esp aimbot fov","game":{"_id":"697e82fb711cf3c912fc8eae","gameId":116965629608311,"name":"[🐰] Hood Wars","imageUrl":{"url":"https://media.kocakz.me/27200e592cca8fdf49d91e4f5137a9794c17781a9a4363c53dc61983f7deec71.webp","original":"https://scriptblox.com/images/sb/rbx-c842b07aab180412f073b52faf2c3591-c45ca97b4763.png"},"slug":"116965629608311-hood-wars","path":"/game/116965629608311-hood-wars","thumbnail":{"url":"https://media.kocakz.me/27200e592cca8fdf49d91e4f5137a9794c17781a9a4363c53dc61983f7deec71.webp","original":"https://scriptblox.com/images/sb/rbx-c842b07aab180412f073b52faf2c3591-c45ca97b4763.png"},"placeId":116965629608311},"slug":"Hood-Wars-Huma-HUB-esp-aimbot-fov-201015","verified":false,"key":false,"ke