Player = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Toggle = false\n\nlocal function GetPart(Model)\n    if Model and Model.ClassName == \"Model\" then\n        if Model.PrimaryPart then\n            return Model.PrimaryPart\n        elseif Model:FindFirstChild(\"Totem\") then\n            return Model:FindFirstChild(\"Totem\")\n        elseif Model:FindFirstChildWhichIsA(\"Part\") then\n            return Model:FindFirstChildWhichIsA(\"Part\")\n        elseif Model:FindFirstChildWhichIsA(\"BasePart\") then\n            return Model:FindFirstChildWhichIsA(\"BasePart\")\n        end\n    end\n    return nil\nend\n\nUserInputService.InputBegan:Connect(function(Input, GameProcessed)\n\tif GameProcessed then return end\n\tif Input.KeyCode == Enum.KeyCode.R then\n\t\tToggle = not Toggle\n\tend\nend)\n\nRunService.RenderStepped:Connect(function()\n    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\n    if Toggle and Character and Character:FindFirstChild(\"HumanoidRootPart\") then\n        local Closest\n        local ClosestDistance = 12.5\n        for _,v in workspace:GetChildren() do\n            local Part = GetPart(v)\n            if Part and Character and v ~= Character and (Character.HumanoidRootPart.Position - Part.Position).Magnitude < ClosestDistance and v:FindFirstChild(\"Health\") then\n                Closest = Part\n                ClosestDistance = (Character.HumanoidRootPart.Position - Part.Position).Magnitude\n            end\n        end\n        for _,v in workspace.Critters:GetChildren() do\n            local Part = GetPart(v)\n            if Part and Character and (Character.HumanoidRootPart.Position - Part.Position).Magnitude < ClosestDistance and v:FindFirstChild(\"Health\") then\n                Closest = Part\n                ClosestDistance = (Character.HumanoidRootPart.Position - Part.Position).Magnitude\n            end\n        end\n        if Closest then\n            ReplicatedStorage.Events.SwingTool:FireServer(os.clock(),{Closest})\n        end\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"views":8151,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-f81a4b4b285fefe37d3a55b42fa8e06d-b768581fa308.png","likeCount":4,"dislikeCount":1,"createdAt":"2025-09-10T00:36:08.047Z","executes":461,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68c0c7f8b5df6d3e46004e97","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2025-09-10T00:36:08.049Z"}],"comments":[{"_id":"68c0c8b123e3f7aa8e7a3e30","commentBy":{"_id":"688a5380a1389c48b220838c","username":"zyletrophene","verified":false,"role":"user","profilePicture":"/images/photo/688a5380a1389c48b220838c-1754967365213.png","createdAt":"2025-07-30T17:16:48.323Z","lastActive":"2025-10-29T02:19:59.980Z","status":"offline","id":"688a5380a1389c48b220838c"},"text":"@neutral","parent":null,"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-10T00:39:13.224Z","liked":false,"disliked":false},{"_id":"68c11e211b42f6775042705a","commentBy":{"_id":"67cc108d3af78db7c8024a81","username":"Babylia2289","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2025-03-08T09:40:29.193Z","lastActive":"2026-06-18T04:38:30.024Z","status":"offline","id":"67cc108d3af78db7c8024a81"},"text":"Not working","e