ryPart and v.PrimaryPart.Position or v:GetPivot().Position\n                elseif v:IsA(\"BasePart\") then\n                    pos = v.Position\n                end\n                if pos and (hrp.Position - pos).Magnitude <= 22.5 then\n                    ReplicatedStorage.Events.Pickup:FireServer(v)\n                end\n            end\n        end\n    end\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"views":6719,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/a64b5faaf3b12561175184fdd5e915ed23bff79dd0c1149ef835753ac6a33ae8.webp","original":"https://scriptblox.com/images/sb/rbx-f81a4b4b285fefe37d3a55b42fa8e06d-b768581fa308.png","scriptblox":"https://scriptblox.com/images/script/rbx-f81a4b4b285fefe37d3a55b42fa8e06d-b768581fa308.png"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-09-10T00:35:36.652Z","executes":101,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:12:05.436Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/a64b5faaf3b12561175184fdd5e915ed23bff79dd0c1149ef835753ac6a33ae8.webp","original":"https://scriptblox.com/images/sb/rbx-f81a4b4b285fefe37d3a55b42fa8e06d-b768581fa308.png","scriptblox":"ht