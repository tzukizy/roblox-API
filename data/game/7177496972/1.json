haracter,\n   [\"mouseHit\"] = mobPos\n   }\n   for i,v in pairs(game:GetService(\"Players\").LocalPlayer.PlayerGui.GameUI.HUD.Skills:GetChildren()) do\n       if v:IsA(\"ImageButton\") then\n           local remote = getSkill_remote()\n           remote:InvokeServer(v.Name,info)  \n       end\n   end\n   return skills\nend\nfunction getNPC()\n   pcall(function()\n       for i,v in pairs(game:GetService(\"Workspace\").Live.NPCs:GetChildren()) do\n           if v.HumanoidRootPart.Anchored == false then\n               local mag = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude\n               if mag < 1500 then\n                   repeat\n                       for _,partSkill in pairs(game:GetService(\"Workspace\").Effects:GetChildren()) do\n                           if partSkill:IsA(\"Model\") and string.find(tostring(partSkill.Name),\"indicator\") then\n                               print(\"Found Indicator\", partSkill:GetFullName())\n                               local indicatorArea = partSkill\n                               local d = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - partSkill:FindFirstChildOfClass(\"MeshPart\").Position).Magnitude\n                               if d < 50 then\n                                   print(\"Touching Area\")\n                                   setclipboard(tostring(partSkill:FindFirstChildOfClass(\"MeshPart\").BrickColor))\n                                   game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0,80,200)\n                                   task.wait(2)\n                               end\n                           end\n                       end\n                       game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5)\n                       game:GetService(\"Players\").LocalPlayer.ClientInputEvents.M1:Fire()\n                       useSkill(v.HumanoidRootPart.CFrame)\n                       task.wait()\n                   until (v.Humanoid.Health <= 0) or (not shared.Enable)\n               end\n           end\n       end\n   end)\nend\ntask.spawn(function()\n   while true do\n       if shared.Enable then\n           getNPC()\n       end\n       task.wait()\n   end\nend)","owner":{"_id":"6210bd826f7d80f15d0d8c03","username":"XAYXO","verified":false,"profilePicture":{"url":"https://media.kocakz.me/2233bffbf691168a99353324f8ad593275fc2e3412fd92e93e91dbde1284eb37.webp","original":"https://scriptblox.com/images/photo/6210bd826f7d80f15d0d8c03-1730035566797.jpg"},"status":"offline","id":"6210bd826f7d80f15d0d8c03","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/2233bffbf691168a99353324f8ad593275fc2e3412fd92e93e91dbde1284eb37.webp","original":"https://scriptblox.com/images/photo/6210bd826f7d80f15d0d8c03-1730035566797.jpg"}},"verified":false,"views":3804,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-07-30T17:54:47.355Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/2c7ad4a3f1abfbcdb91ba53e2a463bc2/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/2c7ad4a3f1abfbcdb91ba53e2a463bc2/500/280/Image/Jpeg"},"executes":2,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:18:48.098Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/2c7ad4a3f1abfbcdb91ba53e2a463bc2/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/2c7ad4a3f1abfbcdb91ba53e2a463bc2/500/280/Image/Jpeg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4e6a5","editBy":{"_id":"6210