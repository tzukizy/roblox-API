:GetDescendants()) do\n        if obj.Name == \"RadioMesh\" and obj:IsA(\"BasePart\") then\n            disableRadioMeshCollision(obj)\n        end\n    end\nend\n\n-- Initial scan on workspace\nscanAndDisable(workspace)\n\n-- Listen for new additions to workspace\nworkspace.DescendantAdded:Connect(function(obj)\n    if obj.Name == \"RadioMesh\" and obj:IsA(\"BasePart\") then\n        disableRadioMeshCollision(obj)\n    end\nend)","owner":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/6974c8fd209ec3e9c0503faa9395d4446ea3fa8eedba1d771c3b642b76c25696.webp","original":"https://scriptblox.com/images/photo/66e3becd388f07d7f50f3c50-1754958047296.png"},"status":"offline","id":"66e3becd388f07d7f50f3c50","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://cdn.kocakz.me/images/6974c8fd209ec3e9c0503faa9395d4446ea3fa8eedba1d771c3b642b76c25696.webp","original":"https://scriptblox.com/images/photo/66e3becd388f07d7f50f3c50-1754958047296.png"}},"verified":false,"views":11059,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-a9147668f33d319bd7b864a3f32286eb-243831361cb9.png","scriptblox":"https://scriptblox.com/images/script/rbx-a9147668f33d319bd7b864a3f32286eb-243831361cb9.png"},"likeCount":3,"dislikeCount":3,"createdAt":"2025-08-05T01:05:24.905Z","editBy":{"_id":"66e3becd388f07d7f50f3c50","username":"quantumlocked","status":"offline","id":"66e3becd388f07d7f50f3c50"},"executes":210,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:55:15.608Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-a9147668f33d319bd7b864a3f3