)\n    end\nelse\n    warn(\"RadioMesh not found! Might be a retard threw it to void.\")\n    game:GetService(\"StarterGui\"):SetCore(\"DevConsoleVisible\", true)\nend","owner":{"_id":"6654555cd037cb8694762b29","username":"Silver234","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/9cca49632650d4eb4e6ed9931895dc40baa9933bd43defd131c78be81ff32835.webp","original":"https://scriptblox.com/images/photo/6654555cd037cb8694762b29-1733397563786.jpg"},"status":"offline","id":"6654555cd037cb8694762b29","profile":{"url":"https://cdn.kocakz.me/images/9cca49632650d4eb4e6ed9931895dc40baa9933bd43defd131c78be81ff32835.webp","original":"https://scriptblox.com/images/photo/6654555cd037cb8694762b29-1733397563786.jpg"}},"verified":false,"keyLink":"","views":11579,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-12-11T22:47:31.791Z","dislikeCount":3,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-ceb062b27096de36a56a207731907bc9/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-ceb062b27096de36a56a207731907bc9/500/280/Image/Jpeg/noFilter"},"executes":180,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:13:22.957Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-ceb062b27096de36a56a207731907bc9/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-ceb062b27096de36a56a207731907bc9/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c537b9","editBy":{"_id":"6654555cd037cb8694762b29","username":"Silver234","status":"offline","id":"6654555cd037cb8694762b29"},"message":"Create script","createdAt":"2025-03-27T21:37:51.197Z"}],"comments":[{"_id":"675a1956a28d125