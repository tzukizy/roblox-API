lignment.Center\n\nlocal pad = Instance.new(\"UIPadding\", frame)\npad.PaddingTop = UDim.new(0, 8)\npad.PaddingBottom = UDim.new(0, 8)\npad.PaddingLeft = UDim.new(0, 8)\npad.PaddingRight = UDim.new(0, 8)\n\nlocal function btn(txt, color)\n    local b = Instance.new(\"TextButton\", frame)\n    b.Size = UDim2.new(0, 150, 0, 30)\n    b.BackgroundColor3 = color\n    b.Text = txt\n    b.TextColor3 = Color3.new(1, 1, 1)\n    b.Font = Enum.Font.GothamBold\n    b.TextSize = 12\n    Instance.new(\"UICorner\", b).CornerRadius = UDim.new(0, 6)\n    return b\nend\n\nlocal tBtn = btn(\"Trophy: OFF\", Color3.fromRGB(180, 50, 50))\ntBtn.MouseButton1Click:Connect(function()\n    trophy = not trophy\n    tBtn.Text = trophy and \"Trophy: ON\" or \"Trophy: OFF\"\n    tBtn.BackgroundColor3 = trophy and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)\n    while trophy do\n        pcall(function() knit.FightService.RE.GetTrophyEvent:FireServer() end)\n        task.wait(0.1)\n    end\nend)\n\nlocal rBtn = btn(\"Rewards: OFF\", Color3.fromRGB(180, 50, 50))\nrBtn.MouseButton1Click:Connect(function()\n    rewards = not rewards\n    rBtn.Text = rewards and \"Rewards: ON\" or \"Rewards: OFF\"\n    rBtn.BackgroundColor3 = rewards and Color3.fromRGB(100, 50, 180) or Color3.fromRGB(180, 50, 50)\n    while rewards do\n        pcall(function() knit.OnlineRewardService.RE.ResetOnlineRewards:FireServer() end)\n        for i = 1, 15 do pcall(function() knit.OnlineRewardService.RE.ClaimOnlineReward:FireServer(i) end) end\n        task.wait(0.5)\n    end\nend)\n\nlocal dBtn = btn(\"Get Diamonds\", Color3.fromRGB(50, 120, 200))\ndBtn.MouseButton1Click:Connect(function()\n    pcall(function() knit.RandomPotionService.RE.BuyPotionEvent:FireServer(-9e308) end)\n    dBtn.Text = \"Done!\"\n    task.wait(1)\n    dBtn.Text = \"Get Diamonds\"\nend)\n\nlocal sBtn = btn(\"Starter Pack\", Color3.fromRGB(200, 130, 50))\nsBtn.MouseButton1Click:Connect(function()\n    pcall(function() knit.OnlineRewardService.RF.ClaimStarterPack:InvokeServer() end)\n    sBtn.Text = \"Claimed!\"\n    sBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)\nend)\n\nlocal drag, start, pos = false, nil, nil\nframe.InputBegan:Connect(function(i)\n    if i.UserInputType == Enum.UserInputType.MouseButton1 then\n        drag, start, pos = true, i.Position, frame.Position\n    end\nend)\nUIS.InputEnded:Connect(function(i)\n    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end\nend)\nUIS.InputChanged:Connect(function(i)\n    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then\n        frame.Position = UDim2.new(pos.X.Scale, pos.X.Offset + (i.Position.X - start.X), pos.Y.Scale, pos.Y.Offset + (i.Position.Y - start.Y))\n    end\nend)","owner":{"_id":"681fcbd7aafe4b1b91fedac0","username":"VibeCoding","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c7c1398be9239b0958cb58637e4df44b3501c06a58c57f1d4668be7af4fde386.webp","original":"https://scriptblox.com/images/photo/681fcbd7aafe4b1b91fedac0-1754696386750.png"},"status":"offline","id":"681fcbd7aafe4b1b91fedac0","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://media.kocakz.me/c7c1398be9239b0958cb58637e4df44b3501c06a58c57f1d4668be7af4fde386.webp","original":"https://scriptblox.com/images/photo/681fcbd7aafe4b1b91fedac0-1754696386750.png"}},"verified":false,"views":2422,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/a83e64dc23fa4a8d8e4886c00131af3c33148c60809bd114593728fd1d16e971.webp","original":"https://scriptblox.com/images/sb/103571191458177-1769463743688.webp","scriptblox":"https://scriptblox.com/images/script/103571191458177-1769463743688.webp"},"likeCount":4,"dislikeCount":1,"createdAt":"2026-01-26T21:42:23.722Z","keyLink":"","executes":43,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false