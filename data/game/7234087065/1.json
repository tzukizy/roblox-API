9-10T17:09:56.498Z","status":"offline","id":"6aa2e4648a1a7e9e29ffc290"},"text":"according my complex \"math\" here, *uming the avg slaps per serverhop is 20 and the time to swap to another is 8 seconds (gathered from my testing), 8 * 7 = 56, 20 * 7 = 140, so 140 slaps per minute. 140 * 60 = 8,400, meaning 8,400 slaps per hour. every 24 hours, you can get up to 200k slaps. this is a * good farm. +rep","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-10T21:05:38.761Z","liked":false,"disliked":false}]},{"slug":"Slap-Battles-UI-v1-12403","_id":"661eaa85c9c3ae475f63b17b","title":"UI by GiamgoMC","game":{"_id":"67e5e1ffb360710ec3c785de","gameId":7234087065,"name":"Slap Battles👏","imageUrl":"/images/sb/no-script.webp","placeId":7234087065},"features":"SlapUI v1 - The best UI for slap battles","tags":[],"script":"loadstring(game:HttpGet((\"https://raw.githubusercontent.com/Giangplay/Slap_Battles/main/Slap_Battles.lua\"),true))()","owner":{"_id":"64d89a395113f49a8dd4ca83","username":"LlamaScriptz","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"64d89a395113f49a8dd4ca83","topMilestone":{"key":"creator.views","tier":1000000}},"verified":false,"keyLink":"","views":91290,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-04-16T16:42:45.320Z","dislikeCount":0,"likeCount":1,"image":"/images/sb/7234087065-1713285765273.webp","executes":1425,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c50a34","editBy":{"_id":"64d89a395113f49a8dd4ca83","username":"LlamaScriptz","status":"offline","id":"64d89a395113f49a8dd4ca83"},"message":"Create script","createdAt":"2025-03-27T22:16:35.478Z"}],"comments":[{"_id":"6621cec337023bc4c453fdb3","commentBy":{"_id":"6593c594ecf1f6e42b6a2b2c","username":"Tester","verified":false,"role":"user","profilePicture":"/images/photo/6593c594ecf1f6e42b6a2b2c-1704183307005.JPG","createdAt":"2