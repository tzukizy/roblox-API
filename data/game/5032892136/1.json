criptblox.com/images/sb/5032892136-1693634597443.webp","scriptblox":"https://scriptblox.com/images/script/5032892136-1693634597443.webp"},"thumbnail":{"url":"https://media.kocakz.me/1237950017e69c6b3e03da26077f6e7139b85f40d8ddb92fad759f2302f7efa5.webp","original":"https://scriptblox.com/images/sb/5032892136-1693634597443.webp","scriptblox":"https://scriptblox.com/images/script/5032892136-1693634597443.webp"},"likeCount":3,"dislikeCount":0,"createdAt":"2023-09-02T06:03:17.511Z","updatedAt":"2023-09-02T06:03:17.511Z","lastBump":"2023-09-02T06:03:17.511Z","script":"if game.PlaceId == 5032892136 then\n    local lp = game.Players.LocalPlayer\n\n    lp.Character:WaitForChild(\"antiSpeed/JumpHack\"):Destroy()\n    lp.PlayerGui.remoteEvents.fastStaticEffectScript:Destroy()\n\n    lp.CharacterAdded:Connect(function(character)\n        character:WaitForChild(\"antiSpeed/JumpHack\"):Destroy()\n        lp.PlayerGui.remoteEvents.fastStaticEffectScript:Destroy()\n    end)\n\n    local hs = game:GetService(\"HttpService\")\n    local soundList = hs:JSONDecode('['..readfile(\"sounds.txt\")..']')\n    local radioSound = game.Workspace.speakers.radio.sound\n    local newSoundId = ''\n    local AddSong = game.ReplicatedStorage.submitSong\n    local sg = game.StarterGui\n    local usedIdxs = {}\n\n    local function isElementInList(list, element)\n        for _, v in ipairs(list) do\n            if v == element then\n                return true\n            end\n        end\n        return false\n    end\n\n    local function main()\n        newSoundId = radioSound.SoundId:sub(14)\n        if radioSound.IsLoaded then\n            if not isElementInList(soundList, tonumber(newSoundId)) then\n                print(\"New music: \"..newSoundId)\n                sg:SetCore(\"SendNotification\",{\n                    Title = \"New music\",\n                    Text = \"New music: \"..newSoundId,\n                    Icon = \"rbxassetid://15694255693\"\n                })\n                table.insert(soundList, tonumber(newSoundId))\n                writefile(\"sounds.txt\", hs:JSONEncode(soundList):sub(2, -2))\n            end\n        end\n        if not radioSound.IsPlaying then\n            soundIndex = math.random(1, #soundList)\n            while isElementInList(usedIdxs, soundIndex) do\n                soundIndex = math.random(1, #soundList)\n                print('Retrying...')\n            end\n            sound = soundList[soundIndex]\n            result = AddSong:InvokeServer(sound)\n            if #usedIdxs >= #soundList - 10 then\n                usedIdxs = {}\n            end\n            print(\"Playing: \"..sound)\n            if result == 'PASSED' then\n                table.insert(usedIdxs, soundIndex)\n            elseif result == 'INVALID' or result == 'TOO LONG' then\n                print(\"INVALID music: \"..newSoundId)\n                sg:SetCore(\"SendNotification\",{\n                    Title = \"INVALID\",\n                    Text = \"INVALID music: \"..sound,\n                    Icon = \"rbxassetid://2592670412\"\n                })\n                table.remove(soundList, soundIndex)\n                writefile(\"sounds.txt\", hs:JSONEncode(soundList):sub(2, -2))\n            end\n            print(\"Response from the server: \"..result)\n        end\n        wait(1)\n    end\n\n    local needChange = false\n    for _, v in pairs(workspace.soundTest:GetChildren()) do\n        if v.IsLoaded then\n            newSoundId = v.SoundId:sub(14)\n            if not isElementInList(soundList, tonumber(newSoundId)) then\n                print(\"New music: \"..newSoundId)\n                sg:SetCore(\"SendNotification\",{\n                    Title = \"New music\",\n                    Text = \"New music: \"..newSoundId,\n                    Icon = \"rbxassetid://15694255693\"\n                })\n                table.insert(soundList, tonumber(newSoundId))\n                needChange = true\n            end\n        end\n    end\n    newSoundId = ''\n    if needChange then\n        writefile(\"sounds.txt\", hs:JSONEncode(soundList):sub(2, -2))\n    end\n\n    while true do\n        pcall(main)\n        --main()\n    end\nend","features":"Play random music every 3 minutes (U can change it in code LOL)\n\nPLS KEEP THIS A SECRET FROM THE DEVELOPERS, ADMINS AND MODERATORS OF THIS GAME!!! - ПОЖАЛУЙСТА ХРАНИТЕ ЭТО В СЕКРЕТЕ ОТ РАЗРАБОТЧИКОВ, АДМИНОВ И МОДЕРАТОРОВ ЭТОЙ ИГРЫ!!!\n\n1. Download this file: https://drive.google.com/file/d/13xY0JGdgLf4f9ou8fJefViLdgEHZLx7R/view?usp=sharing\n2. Put it in the workspace folder\n\nUpdate 12.06.2024\nOptimized\nDeleted useless things\nAdded light compression\nAdded anti-cheat bypass\n\nUpdate 14.06.2024\nAdded startup audio collector. Because the game logs audio IDs, you will have more audio IDs!\n\nUpdate 16.06.2024\nFixed bug with bad string cut in newSoundId. So no more invalid audio IDs will be saved.\n\nUpdate 13.07.2024:\nUpdated to new game update","tags":["random","music","player","ids","not universal"],"discord":"","keyLink":"","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"},"status":"offline","id":"64cde94eedb1b218a6931bfe","profile":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T23:31:09.897Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bc29","editBy":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTre