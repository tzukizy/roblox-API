54ac970c18a732f16a8377d0ecad9e7b.webp","original":"https://scriptblox.com/images/sb/5032892136-1697565763870.webp","scriptblox":"https://scriptblox.com/images/script/5032892136-1697565763870.webp"},"likeCount":1,"dislikeCount":0,"createdAt":"2023-10-17T18:02:43.939Z","updatedAt":"2023-10-17T18:02:43.939Z","lastBump":"2023-10-17T18:02:43.939Z","script":"_G.dc = 'Y'\n\nlocal train = workspace.train\nlocal car = train.car\nlocal camper = workspace.train.camper\n----------------------------------------\nlocal doorsChildren = car.doors:GetChildren()\nlocal doors = {}\nfor _, door in pairs(doorsChildren) do\n\ttable.insert(doors, door.click.ClickDetector)\nend\n\nlocal headLights = car.headlightsButton.buttonPart.ClickDetector\nlocal bathroomDoors = camper.bathroomDoor.click.ClickDetector\nlocal camperDoor = camper.door.click.ClickDetector\nlocal beanCola = train.trailer.vendingMachine.icons.beanColaIcon.ClickDetector\nlocal hatchDoor = camper.roof.emergencyHatch.hatch.clickPart.ClickDetector\n\nwhile _G.dc == 'Y' do\n\tfor _, door in pairs(doors) do\n\t\tfireclickdetector(door)\n\tend\n\tfireclickdetector(headLights)\n\tfireclickdetector(bathroomDoors)\n\tfireclickdetector(camperDoor)\n\tfireclickdetector(beanCola)\n    fireclickdetector(hatchDoor)\n    wait()\nend","features":"dancing car but very fast\n\nUPDATE:\nOptimized by remembering constants\nAdded hatch door\n\nPLS KEEP THIS A SECRET FROM THE DEVELOPERS, ADMINS AND MODERATORS OF THIS GAME!!! - ПОЖАЛУЙСТА ХРАНИТЕ ЭТО В СЕКРЕТЕ ОТ РАЗРАБОТЧИКОВ, АДМИНОВ И МОДЕРАТОРОВ ЭТОЙ ИГРЫ!!!","tags":["dancing","car","fast","very fast","trolling"],"discord":"","keyLink":"","owner":{"_id":"64cde94eedb1b218a6931bfe","username":"OuterTrees","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e0f9e6ece597bb04e488a01171a57bd2e64a9883613b46d86c4b15401da49e4e.webp","original":"https://scriptblox.com/images/photo/64cde94eedb1b218a6931bfe-1708350154774.jpg"},"status":"offline","id":"64cde94eedb1b218a6931bfe","profile":{"u