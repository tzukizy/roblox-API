eSandMan","verified":false,"role":"user","profilePicture":"/images/photo/6288134d5dc60d198ceb7c67-1771196043584.jpg","createdAt":"2022-05-20T22:16:45.476Z","lastActive":"2026-09-18T00:03:35.588Z","status":"offline","id":"6288134d5dc60d198ceb7c67","topMilestone":{"key":"creator.likes","tier":100}},"text":"@Levantopinto I will look at it, and see if i can","parent":{"_id":"699f7a533ab346790c7bb8e0","commentBy":{"_id":"68dd555a6098ada32fc7560a","username":"Levantopinto","profilePicture":"/images/user-default.webp","status":"offline","id":"68dd555a6098ada32fc7560a"},"text":"nice script! can you make a script for Hollow Era?"},"edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-02-26T01:03:32.096Z","liked":false,"disliked":false},{"_id":"69a67531bcedcd0f760e1ebb","commentBy":{"_id":"69a0dae87577d0747cfd4912","username":"mixallmee","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-03-15T05:13:18.351Z","createdAt":"2026-02-26T23:44:40.254Z","status":"offline","id":"69a0dae87577d0747cfd4912"},"text":"works","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-03-03T05:44:17.643Z","liked":false,"disliked":false}]},{"slug":"Brawl-Simulator!-inf-trophys-120272","_id":"699c5a6474c8df11d4379283","title":"inf trophys","game":{"_id":"689c570bd286ec892b9ca6cb","gameId":128802753636227,"name":"[UPD⭐] Brawl Simulator! ✨","imageUrl":"/images/sb/rbx-f1cdad3c506fc6327755cdf27c7067e2-99bd99fa114c.png","placeId":128802753636227},"features":"inf trophys and spam. i am gonna add an auto rebirth","tags":[],"script":"local player = game.Players.LocalPlayer\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\n-- CONFIGURAÇÃO DA UI (Estilo Dark Minimalista)\nlocal screenGui = Instance.new(\"ScreenGui\", player.PlayerGui)\nscreenGui.Name = \"ComboSpammer_V35\"\nscreenGui.ResetOnSpawn = false\n\nlocal main = Instance.new(\"Frame\", screenGui)\nmain.Size = UDim2.new(0, 250, 0, 150)\nmain.Position = UDim2.new(0.5, -125, 0.4, 0)\nmain.BackgroundColor3 = Color3.fromRGB(15, 15, 15)\nmain.Active = true\nmain.Draggable = true\nInstance.new(\"UICorner\", main).CornerRadius = UDim.new(0, 10)\nInstance.new(\"UIStroke\", main).Color = Color3.fromRGB(255, 200, 0) -- Cor Dourada (Combo)\n\nlocal title = Instance.new(\"TextLabel\", main)\ntitle.Text = \"COMBO SPAMMER V35\"\ntitle.Size = UDim2.new(1, 0, 0, 40)\ntitle.TextColor3 = Color3.new(1, 1, 1)\ntitle.Font = Enum.Font.GothamBold\ntitle.BackgroundTransparency = 1\n\nlocal active = false\nlocal btn = Instance.new(\"TextButton\", main)\nbtn.Text = \"SPAM COMBO (OFF)\"\nbtn.Size = UDim2.new(0.9, 0, 0, 50)\nbtn.Position = UDim2.new(0.05, 0, 0.4, 0)\nbtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nbtn.TextColor3 = Color3.new(1, 1, 1)\nbtn.Font = Enum.Font.GothamBold\nInstance.new(\"UICorner\", btn)\n\n-- LÓGICA DO BOTÃO\nbtn.MouseButton1Click:Connect(function()\n    active = not active\n    btn.Text = active and \"SPAMMING... (ON)\" or \"SPAM COMBO (OFF)\"\n    btn.BackgroundColor3 = active and Color3.fromRGB(255, 150, 0) or Color3.fromRGB(30, 30, 30)\nend)\n\n-- LOOP DE ALTA FREQUÊNCIA (OVERDRIVE)\ntask.spawn(function()\n    while true do\n        if active then\n            -- Dispara o seu código 10 vezes por ciclo para máxima velocidade\n            for i = 1, 10 do\n                pcall(function()\n                    ReplicatedStorage.TappingRemote.ComboBonus:FireServer(9e190)\n                end)\n            end\n        end\n        -- O wait() vazio permite que o jogo processe o clique de desligar\n        task.wait() \n    end\nend)\n\n-- ANTI-AFK (Para não ser kickado enquanto o combo sobe)\nplayer.Idled:Connect(function()\n    game:GetService(\"VirtualUser\"):Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)\nend)\n","owner":{"_id":"6983755235987d06cf96eeb4","username":"nagizaronagi","verified":false,"profilePicture":"/images/photo/6983755235987d06cf96eeb4-1774561168297.png","status":"offline","id":"6983755235987d06cf96eeb4","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":380,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/128802753636227-1771854436827.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-02-23T13:47:16.848Z","executes":13,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"699c5a6474c8df11d4379288","editBy":{"_id":"6983755235987d06cf96eeb4","username":"nagizaronagi","status":"offline","id":"6983755235987d06cf96eeb4"},"message":"Create script","createdAt":"2026-02-23T13:47:16.852Z"}],"comments":[]},{"slug":"Brawl-Simulator!-inf-top-120259","_id":"699c5761b277099039623ce8","title":"inf top","game":{"_id":"689c570bd286ec892b9ca6cb","gameId":128802753636227,"name":"[UPD⭐] Brawl Simulator! ✨","imageUrl":"/images/sb/rbx-f1cdad3c506fc6327755cdf27c7067e2-99bd99fa114c.png","placeId":128802753636227},"features":"inf :)","tags":["inf  top"],"script":"game.ReplicatedStorage.TappingRemote.ComboBonus:FireServer(9e190)","owner":{"_id":"6982ebe14bfacc346912616e","username":"111fotp10f","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6982ebe14bfacc346912616e","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":507,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/128802753636227-1771853665929.webp","likeCount":1,"dislikeCount":0,"createdAt":"2026-02-23T13:34:25.951Z","keyLink":"","executes":3,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"699c5761b277099039623ceb","editBy":{"_id":"6982ebe14bfacc346912616e","username":"111fotp10f","status":"offline","id":"6982ebe14bfacc346912616e"},"message":"inf top","createdAt":"2026-02-23T13:34:25.953Z"}],"comments":[]}]}