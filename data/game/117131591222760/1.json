d":"693478059ff55c1f081d8b27","username":"Vectuel","status":"offline","id":"693478059ff55c1f081d8b27"},"message":"Create script","createdAt":"2025-12-19T23:33:51.036Z"}],"comments":[]},{"_id":"68e77a9d103721b523c7f08e","title":"Rebirth UI OPEN SOURCE","game":{"_id":"68d4868e282f2829fa7098ce","gameId":117131591222760,"name":"+1 Size Every Second","imageUrl":{"url":"https://media.kocakz.me/eea5f33423f5a8da429cd5e3d963d3ddaf5be3b5327da9a1e568c19517171d5b.webp","original":"https://scriptblox.com/images/sb/rbx-431851fc419a5e3f4e2680f42525a3bb-783a09e9598a.png"},"slug":"117131591222760-1-size-every-second","path":"/game/117131591222760-1-size-every-second","thumbnail":{"url":"https://media.kocakz.me/eea5f33423f5a8da429cd5e3d963d3ddaf5be3b5327da9a1e568c19517171d5b.webp","original":"https://scriptblox.com/images/sb/rbx-431851fc419a5e3f4e2680f42525a3bb-783a09e9598a.png"},"placeId":117131591222760},"slug":"+1-Size-Every-Second-Rebirth-UI-OPEN-SOURCE-57294","verified":false,"key":false,"keyless":false,"views":5422,"executes":154,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-dbaf974163f56c5285e62c79d559247f-aeb0efe10368.png","scriptblox":"https://scriptblox.com/images/script/rbx-dbaf974163f56c5285e62c79d559247f-aeb0efe10368.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-dbaf974163f56c5285e62c79d559247f-aeb0efe10368.png","scriptblox":"https://scriptblox.com/images/script/rbx-dbaf974163f56c5285e62c79d559247f-aeb0efe10368.png"},"likeCount":3,"dislikeCount":0,"createdAt":"2025-10-09T09:04:29.782Z","updatedAt":"2025-10-09T09:04:29.782Z","lastBump":"2025-10-09T09:04:29.782Z","script":"local Fluent = loadstring(game:HttpGet(\"https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua\"))()\nlocal SaveManager = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua\"))()\nlocal InterfaceManager = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua\"))()\n\nlocal Window = Fluent:CreateWindow({\n\tTitle = \"Rebirth Hack\",\n\tSubTitle = \"by Plutomaster\",\n\tTabWidth = 160,\n\tSize = UDim2.fromOffset(580, 460),\n\tAcrylic = true,\n\tTheme = \"Dark\",\n\tMinimizeKey = Enum.KeyCode.LeftControl\n})\n\nlocal Tabs = {\n\tMain = Window:AddTab({Title = \"Main\", Icon = \"zap\"}),\n\tSettings = Window:AddTab({Title = \"Settings\", Icon = \"settings\"})\n}\n\nlocal RebirthList = {\n\t{Name = \"1 Rebirth\", ID = \"tier1\"},\n\t{Name = \"3 Rebirths\", ID = \"tier2\"},\n\t{Name = \"9 Rebirths\", ID = \"tier3\"},\n\t{Name = \"34 Rebirths\", ID = \"tier4\"},\n\t{Name = \"120 Rebirths\", ID = \"tier5\"},\n\t{Name = \"720 Rebirths\", ID = \"tier6\"},\n\t{Name = \"4k Rebirths\", ID = \"tier7\"},\n\t{Name = \"17k Rebirths\", ID = \"tier8\"},\n\t{Name = \"75k Rebirths\", ID = \"tier9\"},\n\t{Name = \"240k Rebirths\", ID = \"tier10\"},\n\t{Name = \"1.2M Rebirths\", ID = \"tier11\"},\n\t{Name = \"15M Rebirths\", ID = \"tier12\"},\n\t{Name = \"80M Rebirths\", ID = \"tier13\"},\n\t{Name = \"400M Rebirths\", ID = \"tier14\"},\n\t{Name = \"2B Rebirths\", ID = \"tier15\"},\n\t{Name = \"13B Rebirths\", ID = \"tier16\"},\n\t{Name = \"40B Rebirths\", ID = \"tier17\"},\n\t{Name = \"500B Rebirths\", ID = \"tier18\"},\n\t{Name = \"925B Rebirths\", ID = \"tier19\"},\n\t{Name = \"4.25T Rebirths\", ID = \"tier20\"},\n\t{Name = \"65T Rebirths\", ID = \"tier21\"},\n\t{Name = \"790T Rebirths\", ID = \"tier22\"},\n\t{Name = \"8.46qa Rebirths\", ID = \"tier23\"},\n\t{Name = \"50qa Rebirths\", ID = \"tier24\"}\n}\n\nlocal Names = {}\nfor _, v in ipairs(RebirthList) do\n\ttable.insert(Names, v.Name)\nend\n\nlocal tier = \"tier1\"\nlocal auto = false\nlocal speed = 0.1\n\nlocal drop = Tabs.Main:AddDropdown(\"Tier\", {\n\tTitle = \"Select Rebirth Tier\",\n\tValues = Names,\n\tDefault = \"1 Rebirth\"\n})\n\ndrop:OnChanged(function(v)\n\tfor _, d in ipairs(RebirthList) do\n\t\tif d.Name == v then\n\t\t\ttier = d.ID\n\t\t\tbreak\n\t\tend\n\tend\nend)\n\nTabs.Main:AddButton({\n\tTitle = \"Rebirth Now\",\n\tDescription = \"Instant rebirth with selected tier\",\n\tCallback = function()\n\t\tgame:GetService(\"ReplicatedStorage\"):WaitForChild(\"RebirthEvent\"):FireServer(tier)\n\t\tFluent:Notify({Title = \"Rebirth\", Content = \"Used \" .. tier, Duration = 3})\n\tend\n})\n\nlocal toggle = Tabs.Main:AddToggle(\"Auto\", {Title = \"Enable Auto Rebirth\", Default = false})\ntoggle:OnChanged(function(v)\n\tauto = v\nend)\n\nlocal slider = Tabs.Main:AddSlider(\"Speed\", {\n\tTitle = \"Auto Speed (Seconds)\",\n\tDefault = 0.1,\n\tMin = 0.1,\n\tMax = 5,\n\tRounding = 2\n})\n\nslider:OnChanged(function(v)\n\tspeed = v\nend)\n\ntask.spawn(function()\n\twhile true do\n\t\tif auto and tier then\n\t\t\tgame:GetService(\"ReplicatedStorage\"):WaitForChild(\"RebirthEvent\"):FireServer(tier)\n\t\tend\n\t\ttask.wait(speed)\n\tend\nend)\n\nSaveManager:SetLibrary(Fluent)\nInterfaceManager:SetLibrary(Fluent)\nSaveManager:IgnoreThemeSettings()\nSaveManager:SetIgnoreIndexes({})\nInterfaceManager:SetFolder(\"FluentScriptHub\")\nSaveManager:SetFolder(\"FluentScriptHub/RebirthGUI\")\nInterfaceManager:BuildInterfaceSection(Tabs.Settings)\nSaveManager:BuildConfigSection(Tabs.Settings)\nWindow:SelectTab(1)\nFluent:Notify({Title = \"Rebirth GUI\", Content = \"Loaded\", Duration = 4})\nSaveManager:LoadAutoloadConfig()","features":"[⚠ IF YOU HIT NEGATIVE REBIRTHS TURN ON AUTO REBIRTH AND TURN IT OFF WHEN YOU'RE REBIRTHS BECOME NORMAL AGAIN (9.5 or something around that QI IS THE MAX) ⚠]\n\nin the Rebirth Hack ui [Fluent UI (https://github.com/dawid-scripts/Fluent) ]\n\nYou have a Auto Rebirth toggle, Rebirth Button, Auto Speed (Seconds) Slider and the Select Rebirth Tier DropDown with the opitions\nbeing \n\n1 Rebirth\n\n3 Rebirths\