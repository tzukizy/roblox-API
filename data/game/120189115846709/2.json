{"id":120189115846709,"name":"TTK Testing [CUSTOMIZATION]","desc":"","path":"/game/120189115846709-ttk-testing-customization","slug":"120189115846709-ttk-testing-customization","thumbnail":["https://tr.rbxcdn.com/180DAY-592dafc750fd18baec6ac0cd1bfb4dce/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-e2d9185b9e2a1ea707053f0bc78713ab/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":4116,"visitor":0,"verified":false,"updatedAt":"2026-10-08T15:00:54.728Z","creator":{"name":"Roblox","type":"User"},"script":{"count":22,"freeCount":22,"keyCount":6,"verifiedCount":4},"page":2,"next":null,"total":2,"scripts":[{"slug":"TTK-Testing-M18-3-MILLION-Bullet-TP-237097","_id":"6a305fcdf09c56c11df13ba4","title":"Bullet TP","game":{"_id":"6a21e496f0c40fdd4b20ad40","gameId":120189115846709,"name":"TTK Testing [CUSTOMIZATION]","imageUrl":"/images/sb/rbx-e2d9185b9e2a1ea707053f0bc78713ab-739cfde37028.png","placeId":120189115846709},"features":"If you abuse with Rapid aim, you will be detected and removed from the game. This is likely based on the interval between kills","tags":["silent aim","kill all","ttk"],"script":"--!native\n-- depso\n\nconst Players = cloneref(game:GetService(\"Players\"))\n\nlocal Index = 0\nconst function GetJitsHead(): (Vector3?, Vector3?)\n\tconst PlayersArray = Players:GetPlayers()\n\tIndex = (Index + 1) % #PlayersArray \n\n\tconst Jit = PlayersArray[Index + 1]\n\tconst Character = Jit.Character\n\tif not Character then return end\n\n\tconst Position = Character:GetPivot().Position\n\tconst Offset = Vector3.new(0, 0, 2)\n\n\treturn Position + Offset, Offset * -1\nend\n\nconst function SpoofDischarge(Function)\n\tlocal Previous; Previous = hookfunction(Function, newcclosure(function(self, GunName, EyePosition, FireDirection, MuzzleWorldPosition, ...)\n\t\tconst FromOverride, DirOverride = GetJitsHead()\n\t\tif FromOverride then\n\t\t\tMuzzleWorldPosition = FromOverride\n\t\t\tEyePosition = FromOverride\n\t\t\tFireDirection = DirOverride\n\t\tend\n\t\t\n\t\treturn Previous(self, GunName, EyePosition, FireDirection, MuzzleWorldPosition, ...)\n\tend))\nend\n\nfor _, Jit in next, getgc(true) do\n\tif typeof(Jit) ~= \"table\" then continue end\n\n\t--// Bullet handler\n\tif rawget(Jit, \"Discharge\") then\n\t\tSpoofDischarge(rawget(Jit, \"Discharge\"))\n\tend\nend","owner":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","verified":true,"profilePicture":"/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg","status":"offline","id":"682d7e6cb9ed364b3a0bda05","topMilestone":{"key":"creator.followers","tier":100}},"verified":true,"views":4577,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png","likeCount":4,"dislikeCount":0,"createdAt":"2026-06-15T20:25:49.490Z","keyLink":"","executes":483,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a305fcdf09c56c11df13ba6","editBy":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","status":"offline","id":"682d7e6cb9ed364b3a0bda05"},"message":"Create script","createdAt":"2026-06-15T20:25:49.492Z"}],"comments":[{"_id":"6a3094aee8f9deecc95fff4f","commentBy":{"_id":"68425520343da7b997c83360","username":"Sander_NL","verified":false,"role":"user","profilePicture":"/images/photo/68425520343da7b997c83360-1754006111861.jpg","createdAt":"2025-06-06T02:40:32.893Z","lastActive":"2026-09-29T17:46:32.222Z","status":"offline","id":"68425520343da7b997c83360","leaderboard":{"tag":null},"topMilestone":{"key":"creator.executions","tier":1000000}},"text":"good","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-16T00:11:26.633Z","liked":false,"disliked":false},{"_id":"6a320b3f0cc2a9f914fc7183","commentBy":{"_id":"6a2fd144d7d7c359b8702cf8","username":"ARKless","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-07-13T02:05:06.966Z","createdAt":"2026-06-15T10:17:40.505Z","status":"offline","id":"6a2fd144d7d7c359b8702cf8","topMilestone":{"key":"creator.first_script","tier":1}},"text":"how does this work?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-17T02:49:35.175Z","liked":false,"disliked":false},{"_id":"6a324346365ad71908050f07","commentBy":{"_id":"6a2a0478b2807ec37e184199","username":"kikkmeperkzz","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-07-12T17:15:41.661Z","createdAt":"2026-06-11T00:42:32.677Z","status":"offline","id":"6a2a0478b2807ec37e184199"},"text":"ANTICHEAT IS DOG","edited":true,"likeCount":1,"dislikeCount":1,"createdAt":"2026-06-17T06:48:38.064Z","liked":false,"disliked":false},{"_id":"6a377a1b1950b89f7036c523","commentBy":{"_id":"697271017b4426d379bbd2c6","username":"Andradezera","verified":false,"role":"user","profilePicture":"/images/photo/697271017b4426d379bbd2c6-1781468004458.jpg","lastActive":"2026-08-17T00:05:54.829Z","createdAt":"2026-01-22T18:48:33.814Z","status":"offline","id":"697271017b4426d379bbd2c6","topMilestone":{"key":"creator.executions","tier":10000}},"text":"Pra mim tá safe único problema e que as vezes ele deixa de fazer a bala ir no aniversário que tá na minha frente e puxa pra um atrás da parede","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-21T05:43:55.328Z","liked":false,"disliked":false}]},{"slug":"TTK-Testing-SHOTTY-2-MILLION-TTK-FireRate-changer-235881","_id":"6a2c854cbd89f1208cadea9b","title":"Undetected Gun Mods + No Recoil + Inf Ammo + No Spread","game":{"_id":"6a21e496f0c40fdd4b20ad40","gameId":120189115846709,"name":"TTK Testing [CUSTOMIZATION]","imageUrl":"/images/sb/rbx-e2d9185b9e2a1ea707053f0bc78713ab-739cfde37028.png","placeId":120189115846709},"features":"( ‼️New server checks now detect the firerate change ‼️)\n\nTo use:\nRun this script ONCE and respawn!\n\nThe script will modify guns when you equip them\n\n( Some executors may not compile this, if you experience an error on executor this is not my fault. )","tags":["gun mods","hook","spoof","ttk","byp*ed"],"script":"--!native\n-- depso\nconst BlankCFunc = newcclosure(function() return end)\n\nconst function HookInitFromDef(Function)\n\tlocal Previous; Previous = hookfunction(Function, newcclosure(function(p2, ...)\n\t\tPrevious(p2, ...)\n\t\t--p2.FireRate = 0\n\t\tp2.RecoilRecovery = 0\n\t\tp2.SpreadAngle = 0\n\t\tp2.FireMode = \"auto\"\n\t\tp2.MagAmmo = 69420\n\n\t\tp2.RecoilSpring.s = 0\n\tend))\nend\n\nconst function HookWeaponHandler(Handler)\n\thookfunction(rawget(Handler, \"ApplyRecoil\"), BlankCFunc)\n\thookfunction(rawget(Handler, \"_FireScriptedRecoil\"), BlankCFunc)\n\thookfunction(rawget(Handler, \"_FireAdsShoulderImpact\"), BlankCFunc)\n\thookfunction(rawget(Handler, \"_ApplyFireDriftImpulse\"), BlankCFunc)\nend\n\nconst function HookCameraRecoil(Function)\n\tif debug.info(Function, \"s\"):find(\"CameraController\") then\n\t\thookfunction(Function, BlankCFunc)\n\tend\nend\n\nfor _, Thing in next, getgc(true) do\n\tif typeof(Thing) ~= \"table\" then continue end\n\n\t--// Weapon handler\n\tif rawget(Thing, \"ApplyRecoil\") then\n\t\tHookWeaponHandler(Thing)\n\t\t\n\t--// Camera handler\n\telseif rawget(Thing, \"Recoil\") and rawget(Thing, \"WeaponSwayPhase\") then\n\t\tHookCameraRecoil(rawget(Thing, \"Recoil\"))\n\t\n\t--// Gun Init\n\telseif rawget(Thing, \"InitFromDef\") then\n\t\tHookInitFromDef(rawget(Thing, \"InitFromDef\"))\n\tend\nend","owner":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","verified":true,"profilePicture":"/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg","status":"offline","id":"682d7e6cb9ed364b3a0bda05","topMilestone":{"key":"creator.followers","tier":100}},"verified":true,"views":8327,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":"/images/sb/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png","likeCount":7,"dislikeCount":5,"createdAt":"2026-06-12T22:16:44.753Z","keyLink":"","editBy":{"_id":"682d7e6