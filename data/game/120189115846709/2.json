reatedAt":"2026-07-13T05:09:46.800Z","liked":false,"disliked":false}]},{"_id":"6a305fcdf09c56c11df13ba4","title":"Bullet TP","game":{"_id":"6a21e496f0c40fdd4b20ad40","gameId":120189115846709,"name":"TTK Testing 🎃 [NEW AR15]","imageUrl":{"url":"https://media.kocakz.me/f2fccc90c627519737c7c3fc961c6f9e0c4ff2f00ed7316138f5513322286019.webp","original":"https://tr.rbxcdn.com/180DAY-ec7adc7dd391762df4821defcf17e8a5/150/150/Image/Png/noFilter"},"slug":"120189115846709-ttk-testing","path":"/game/120189115846709-ttk-testing","thumbnail":{"url":"https://media.kocakz.me/f2fccc90c627519737c7c3fc961c6f9e0c4ff2f00ed7316138f5513322286019.webp","original":"https://tr.rbxcdn.com/180DAY-ec7adc7dd391762df4821defcf17e8a5/150/150/Image/Png/noFilter"},"placeId":120189115846709},"slug":"TTK-Testing-M18-3-MILLION-Bullet-TP-237097","verified":true,"key":false,"keyless":false,"views":4661,"executes":575,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2bc47f1ad24b6d893094b6e2e25fa650e1c55dcc46859312babeec26c9c4e2dc.webp","original":"https://scriptblox.com/images/sb/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png","scriptblox":"https://scriptblox.com/images/script/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png"},"thumbnail":{"url":"https://media.kocakz.me/2bc47f1ad24b6d893094b6e2e25fa650e1c55dcc46859312babeec26c9c4e2dc.webp","original":"https://scriptblox.com/images/sb/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png","scriptblox":"https://scriptblox.com/images/script/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2026-06-15T20:25:49.490Z","updatedAt":"2026-06-15T20:25:49.490Z","lastBump":"2026-06-15T20:25:49.490Z","script":"--!native\n-- depso\n\nconst Players = cloneref(game:GetService(\"Players\"))\n\nlocal Index = 0\nconst function GetJitsHead(): (Vector3?, Vector3?)\n\tconst PlayersArray = Players:GetPlayers()\n\tIndex = (Index + 1) % #PlayersArray \n\n\tconst Jit = PlayersArray[Index + 1]\n\tconst Character = Jit.Character\n\tif not Character then return end\n\n\tconst Position = Character:GetPivot().Position\n\tconst Offset = Vector3.new(0, 0, 2)\n\n\treturn Position + Offset, Offset * -1\nend\n\nconst function SpoofDischarge(Function)\n\tlocal Previous; Previous = hookfunction(Function, newcclosure(function(self, GunName, EyePosition, FireDirection, MuzzleWorldPosition, ...)\n\t\tconst FromOverride, DirOverride = GetJitsHead()\n\t\tif FromOverride then\n\t\t\tMuzzleWorldPosition = FromOverride\n\t\t\tEyePosition = FromOverride\n\t\t\tFireDirection = DirOverride\n\t\tend\n\t\t\n\t\treturn Previous(self, GunName, EyePosition, FireDirection, MuzzleWorldPosition, ...)\n\tend))\nend\n\nfor _, Jit in next, getgc(true) do\n\tif typeof(Jit) ~= \"table\" then continue end\n\n\t--// Bullet handler\n\tif rawget(Jit, \"Discharge\") then\n\t\tSpoofDischarge(rawget(Jit, \"Discharge\"))\n\tend\nend","features":"If you abuse with Rapid aim, you will be detected and removed from the game. This is likely based on the interval between kills","tags":["silent aim","kill all","ttk"],"discord":"","keyLink":"","owner":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","verified":true,"profilePicture":{"url":"https://media.kocakz.me/1b35ef0065f63de7752aeed1639eb42485a1fab66658499cbc66da439d7aecd6.webp","original":"https://scriptblox.com/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg"},"lvl":9,"status":"offline","id":"682d7e6cb9ed364b3a0bda05","topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/1b35ef0065f63de7752aeed1639eb42485a1fab66658499cbc66da439d7aecd6.webp","original":"https://scriptblox.com/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:29: