ed7316138f5513322286019.webp","original":"https://tr.rbxcdn.com/180DAY-ec7adc7dd391762df4821defcf17e8a5/150/150/Image/Png/noFilter"},"placeId":120189115846709},"slug":"TTK-Testing-SHOTTY-2-MILLION-TTK-FireRate-changer-235881","verified":true,"key":false,"keyless":false,"views":8450,"executes":1244,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/2bc47f1ad24b6d893094b6e2e25fa650e1c55dcc46859312babeec26c9c4e2dc.webp","original":"https://scriptblox.com/images/sb/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png","scriptblox":"https://scriptblox.com/images/script/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png"},"thumbnail":{"url":"https://media.kocakz.me/2bc47f1ad24b6d893094b6e2e25fa650e1c55dcc46859312babeec26c9c4e2dc.webp","original":"https://scriptblox.com/images/sb/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png","scriptblox":"https://scriptblox.com/images/script/rbx-9335a70b7aad932cbac8e54d71835f12-3da040162c34.png"},"likeCount":7,"dislikeCount":5,"createdAt":"2026-06-12T22:16:44.753Z","updatedAt":"2026-06-12T22:16:44.753Z","lastBump":"2026-06-12T22:16:44.753Z","script":"--!native\n-- depso\nconst BlankCFunc = newcclosure(function() return end)\n\nconst function HookInitFromDef(Function)\n\tlocal Previous; Previous = hookfunction(Function, newcclosure(function(p2, ...)\n\t\tPrevious(p2, ...)\n\t\t--p2.FireRate = 0\n\t\tp2.RecoilRecovery = 0\n\t\tp2.SpreadAngle = 0\n\t\tp2.FireMode = \"auto\"\n\t\tp2.MagAmmo = 69420\n\n\t\tp2.RecoilSpring.s = 0\n\tend))\nend\n\nconst function HookWeaponHandler(Handler)\n\thookfunction(rawget(Handler, \"ApplyRecoil\"), BlankCFunc)\n\thookfunction(rawget(Handler, \"_FireScriptedRecoil\"), BlankCFunc)\n\thookfunction(rawget(Handler, \"_FireAdsShoulderImpact\"), BlankCFunc)\n\thookfunction(rawget(Handler, \"_ApplyFireDriftImpulse\"), BlankCFunc)\nend\n\nconst function HookCameraRecoil(Function)\n\tif debug.info(Function, \"s\"):find(\"CameraController\") then\n\t\thookfunction(Function, BlankCFunc)\n\tend\nend\n\nfor _, Thing in next, getgc(true) do\n\tif typeof(Thing) ~= \"table\" then continue end\n\n\t--// Weapon handler\n\tif rawget(Thing, \"ApplyRecoil\") then\n\t\tHookWeaponHandler(Thing)\n\t\t\n\t--// Camera handler\n\telseif rawget(Thing, \"Recoil\") and rawget(Thing, \"WeaponSwayPhase\") then\n\t\tHookCameraRecoil(rawget(Thing, \"Recoil\"))\n\t\n\t--// Gun Init\n\telseif rawget(Thing, \"InitFromDef\") then\n\t\tHookInitFromDef(rawget(Thing, \"InitFromDef\"))\n\tend\nend","features":"( ‼️New server checks now detect the firerate change ‼️)\n\nTo use:\nRun this script ONCE and respawn!\n\nThe script will modify guns when you equip them\n\n( Some executors may not compile this, if you experience an error on executor this is not my fault. )","tags":["gun mods","hook","spoof","ttk","byp*ed"],"discord":"","keyLink":"","owner":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","verified":true,"profilePicture":{"url":"https://media.kocakz.me/1b35ef0065f63de7752aeed1639eb42485a1fab66658499cbc66da439d7aecd6.webp","original":"https://scriptblox.com/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg"},"lvl":9,"status":"offline","id":"682d7e6cb9ed364b3a0bda05","topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/1b35ef0065f63de7752aeed1639eb42485a1fab66658499cbc66da439d7aecd6.webp","original":"https://scriptblox.com/images/photo/682d7e6cb9ed364b3a0bda05-1775164584479.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:29:48.765Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a2c854cbd89f1208cadea9d","editBy":{"_id":"682d7e6cb9ed364b3a0bda05","username":"depso","status":"offline","id":"682d7e6cb9ed364b3a0bda05"},"message":"Create script","createdAt":"2026-