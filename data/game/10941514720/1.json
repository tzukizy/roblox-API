nction()\n            teleportButton.Visible = true\n        end)\n    else\n        panel:TweenSize(UDim2.new(0, 220, 0, 0), \"Out\", \"Quad\", 0.3, true)\n        teleportButton.Visible = false\n    end\n    expanded = not expanded\nend)\n\nteleportButton.MouseButton1Click:Connect(function()\n    local player = game.Players.LocalPlayer\n    local character = player.Character\n    if not character then\n        warn(\"Character not found!\")\n        return\n    end\n    \n    local humanoidRootPart = character:FindFirstChild(\"HumanoidRootPart\")\n    if not humanoidRootPart then\n        warn(\"HumanoidRootPart not found!\")\n        return\n    end\n    \n    local targetButton = game.Workspace:FindFirstChild(\"Button\")\n    if targetButton and targetButton:IsA(\"BasePart\") then\n        humanoidRootPart.CFrame = targetButton.CFrame + Vector3.new(0, 5, 0)\n        print(\"Teleportation completed!\")\n    else\n        warn(\"Button object not found in Workspace!\")\n    end\nend)","features":"teleport","tags":[],"discord":"","keyLink":"","owner":{"_id":"690e681531a15f5f22143011","username":"Rini","verified":false,"profilePicture":{"url":"https://media.kocakz.me/a8d94782702f398edae97bcdc34712e25f0adb8bee6fb2fcebe38b3f4ddd37ff.webp","original":"https://scriptblox.com/images/photo/690e681531a15f5f22143011-1762852695636.png"},"status":"offline","id":"690e681531a15f5f22143011","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/a8d94782702f398edae97bcdc34712e25f0adb8bee6fb2fcebe38b3f4ddd37ff.webp","original":"https://scriptblox.com/images/photo/690e681531a15f5f22143011-1762852695636.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:49:12.929Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6918d6f19ad2870cb75b92bc","editBy":{"_id":"6