erTween = TweenService:Create(\n    copyButton,\n    TweenInfo.new(0.2),\n    {BackgroundColor3 = Color3.fromRGB(70, 82, 200)}\n)\n\nlocal unhoverTween = TweenService:Create(\n    copyButton,\n    TweenInfo.new(0.2),\n    {BackgroundColor3 = Color3.fromRGB(88, 101, 242)}\n)\n\ncopyButton.MouseEnter:Connect(function()\n    hoverTween:Play()\nend)\n\ncopyButton.MouseLeave:Connect(function()\n    unhoverTween:Play()\nend)\n\n-- Copy function\ncopyButton.MouseButton1Click:Connect(function()\n    setclipboard(DISCORD_LINK)\n    \n    copyButton.Text = \"✅ Copied!\"\n    copyButton.BackgroundColor3 = Color3.fromRGB(46, 160, 67)\n    \n    wait(1.5)\n    \n    copyButton.Text = \"📋 Copy Link\"\n    copyButton.BackgroundColor3 = Color3.fromRGB(88, 101, 242)\nend)","owner":{"_id":"6953133739aa8f16143dd0dd","username":"caresedbytherizz","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6953133739aa8f16143dd0dd","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":731,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/118614517739521-1767659160194.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2026-01-06T00:26:00.207Z","executes":46,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"695c56987006284592cbeb32","editBy":{"_id":"6953133739aa8f16143dd0dd","username":"caresedbytherizz","status":"offline","id":"6953133739aa8f16143dd0dd"},"message":"Create script","createdAt":"2026-01-06T00:26:00.215Z"}],"comments":[{"_id":"695c5d17b75108960acb9b9a","commentBy":{"_id":"693b3217e4d748bf75ea4386","username":"Kaysripts","verified":false,"role":"user","profilePicture":"/images/photo/693b3217e4d748bf75ea4386-1768045321563.jpg","lastActive":"2026-09-07T22:50:01.384Z","createdAt":"2025-12-11T21:05:27.004Z","status":"offline","id":"693b3217e4d748bf75ea4386"},"text":"Th*x","edited":false,"likeCount":1,"dislikeCount":0,"createdAt"