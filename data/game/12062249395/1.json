r.Character\nlocal HRP = Char.HumanoidRootPart\n\n--- \n\n\nlocal LoopFor = 50 -- Change this to however many times you want to go through.\n\n\n----\n\n\n-- Below this is the script, don't edit unless you know what you're doing.\n\n\nfor i = 0, LoopFor, 1 do\n\n\nfor i = 0, CheckpointNum, 1 do\nwait()\nif i ~= 52 then\nHRP.CFrame = Checkpoints[i].CFrame\nelse\ngame:GetService(\"ReplicatedStorage\"):WaitForChild(\"RebirthEvent\"):FireServer()\nend\nprint(i)\nend\n\nend","owner":{"_id":"61eb02b5ab391bb2c3d9db10","username":"dullsoulss","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/569f77030471b95973e8ca3e4d3ad3aa1cf9cd117d5e3572cdf713794f2f17a7.webp","original":"https://scriptblox.com/images/photo/61eb02b5ab391bb2c3d9db10-1738214960890.jpg"},"status":"offline","id":"61eb02b5ab391bb2c3d9db10","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/569f77030471b95973e8ca3e4d3ad3aa1cf9cd117d5e3572cdf713794f2f17a7.webp","original":"https://scriptblox.com/images/photo/61eb02b5ab391bb2c3d9db10-1738214960890.jpg"}},"verified":false,"keyLink":"","views":4304,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-30T05:32:27.782Z","dislikeCount":0,"likeCount":1,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-0fc1a9fbf8cc0699fc20aeb38ba23c5c/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-0fc1a9fbf8cc0699fc20aeb38ba23c5c/500/280/Image/Jpeg/noFilter"},"executes":3,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:10:37.681Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-0fc1a9fbf8cc0699fc20aeb38ba23c5c/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-0fc1a