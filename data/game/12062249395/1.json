2249395,"name":"Stud Long Jumps Obby","imageUrl":"/images/sb/rbx-6d23926f78771218e7fa10443f41ad65-62d8ea4c2e86.png","placeId":12062249395},"features":"Very very very fast, gets you a rebirth in ~1 second\n\nMight only work on xeno, im not sure yet as i havent tested it on anything else\n\nput _G.unrender to false if you don't want the game to be unrendered during this, I just put it there for boosting FPS","tags":["op","obby","script"],"script":"_G.unrender = true\n\nlocal rs = game:GetService(\"RunService\")\nlocal plr = game.Players.LocalPlayer\nlocal char = plr.Character or plr.CharacterAdded:Wait()\nlocal hrp = char:WaitForChild(\"HumanoidRootPart\")\nlocal rebirth = game.ReplicatedStorage:WaitForChild(\"RebirthEvent\")\nlocal cp = workspace:WaitForChild(\"Checkpoints\")\nlocal stats = plr:WaitForChild(\"leaderstats\")\nlocal stage = stats:WaitForChild(\"Stage\")\n\nif _G.unrender == true then \n\trs:Set3dRenderingEnabled(false) \nend\n\nlocal function touchCheckpoints()\n\tfor i = 1, 45 do\n\t\tif stage.Value >= 45 then\n\t\t\tbreak\n\t\tend\n\t\tlocal chk = cp:FindFirstChild(tostring(i))\n\t\tif chk then\n\t\t\tfiretouchinterest(chk, hrp, 0)\n\t\tend\n\tend\nend\n\nrs.Heartbeat:Connect(function()\n\tif stage.Value >= 45 then\n\t\trebirth:FireServer()\n\telse\n\t\ttouchCheckpoints()\n\tend\nend)","owner":{"_id":"677755b5b19eb392c8c9aff6","username":"icmp","verified":false,"profilePicture":"/images/photo/677755b5b19eb392c8c9aff6-1735874028176.jpg","status":"offline","id":"677755b5b19eb392c8c9aff6","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":2424,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-6d23926f78771218e7fa10443f41ad65-62d8ea4c2e86.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-04-27T02:40:35.910Z","executes":4,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"680d99238335c1f558a1efb6","editBy":{"_id":"677755b5