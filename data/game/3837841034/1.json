OUT RANDOMLY TO ANYONE! Please join to be able to get a key!\n\n\nnew ui including custom ui with 3d character boxes esp. Everything in nhack and new updates happening soon. Beta testers will be able to do everything and suggest!","tags":["beta","new","testers","give away","key"],"script":"using lua armor ^\n\nhttps://discord.gg/GvGuj66mxU","owner":{"_id":"61e813119175b1d5b891450a","username":"runraven","verified":false,"profilePicture":"/images/photo/61e813119175b1d5b891450a-1730109087057.png","status":"offline","id":"61e813119175b1d5b891450a","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord.gg/GvGuj66mxU","keyLink":"https://discord.gg/GvGuj66mxU","views":5526,"scriptType":"paid","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/3837841034-1745447344417.png","likeCount":0,"dislikeCount":0,"createdAt":"2025-04-23T22:29:04.470Z","editBy":{"_id":"61e813119175b1d5b891450a","username":"runraven","status":"offline","id":"61e813119175b1d5b891450a"},"executes":31,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"680969b00c691f15c044b556","editBy":{"_id":"61e813119175b1d5b891450a","username":"runraven","status":"offline","id":"61e813119175b1d5b891450a"},"message":"Advert","createdAt":"2025-04-23T22:29:04.473Z"},{"_id":"681d26bc43dcc7280d56b9b7","editBy":{"_id":"61e813119175b1d5b891450a","username":"runraven","status":"offline","id":"61e813119175b1d5b891450a"},"message":"Update script","createdAt":"2025-05-08T21:48:44.344Z"}],"comments":[{"_id":"681560673ddfe7f175711037","commentBy":{"_id":"66970aab8d681ef93115b90e","username":"zaidbaidaa","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-07-17T00:04:59.762Z","lastActive":"2025-05-25T18:21:55.377Z","status":"offline","id":"66970aab8d681ef93115b90e"},"text":"duddddeee , we need the discord","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-05-03T00:16:39.535Z","liked":false,"disliked":false}]},{"slug":"0.23.3-Deadline-Roblox-script-aimbot-deadline-open-source-36969","_id":"680842dba89fd911d974653a","title":"Roblox script aimbot  open source","game":{"_id":"67e5e1ffb360710ec3c77def","gameId":3837841034,"name":"[0.24.0] Deadline","imageUrl":"https://tr.rbxcdn.com/180DAY-4fb716609029d3b8f6ffed5c338c713c/480/270/GameIcon3/Png/noFilter","placeId":3837841034},"features":"aimbot\nfov\nsmoothness\naim_part\nYou need to hold down the right click or it won't work.","tags":["deadline","aimbot"],"script":"--// SETTINGS\ngetgenv().settings = {\n    fov_size = 200,\n    aimbot_enabled = true,\n    aim_part = \"head\",\n    smoothness = 0.15,\n    team_check = true,\n    prediction = 0.12 -- Optional (Used for shooting moving targets.)\n}\n\n--// SERVICES\nlocal players = game:GetService(\"Players\")\nlocal runservice = game:GetService(\"RunService\")\nlocal userinput = game:GetService(\"UserInputService\")\nlocal workspace = game:GetService(\"Workspace\")\n\n--// VARIABLES\nlocal camera = workspace.CurrentCamera\nlocal localPlayer = players.LocalPlayer\nlocal characters = workspace:WaitForChild(\"characters\")\n\n--// FOV CIRCLE\nlocal fov = Drawing.new(\"Circle\")\nfov.Radius = getgenv().settings.fov_size\nfov.Thickness = 1\nfov.Transparency = 1\nfov.Filled = false\nfov.Color = Color3.fromRGB(255, 255, 255)\nfov.Visible = true\n\n--// Helper: Get Player from Character\nlocal function getPlayerFromCharacter(character)\n    for _, player in ipairs(players:GetPlayers()) do\n        if characters:FindFirstChild(player.Name) == character then\n            return player\n        end\n    end\n    return nil\nend\n\n--// Check Enemy\nlocal function isEnemy(targetChar)\n    if not getgenv().settings.team_check then return true end\n    local targetPlayer = getPlayerFromCharacter(targetChar)\n    if not targetPlayer then return true end\n    if not targetPlayer.Team or not localPlayer.Team then return true end\n    return targetPlayer.Team ~= localPlayer.Team\nend\n\n--// Get Closest Target\nlocal function getClosestPlayer()\n    local closestPart, shortestDist = nil, getgenv().settings.fov_size\n    local mousePos = userinput:GetMouseLocation()\n\n    for _, char in ipairs(characters:GetChildren()) do\n        if char:IsA(\"Model\") and char.Name ~= localPlayer.Name and isEnemy(char) then\n            local targetPart = char:FindFirstChild(getgenv().settings.aim_part)\n            if targetPart and targetPart:IsA(\"BasePart\") then\n                local predictedPosition = targetPart.Position\n                if targetPart.Velocity then\n                    predictedPosition = predictedPosition + (targetPart.Velocity * getgenv().settings.prediction)\n                end\n\n                local screenPos, onScreen = camera:WorldToViewportPoint(predictedPosition)\n                if onScreen then\n                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude\n                    if dist < shortestDist then\n                        shortestDist = dist\n                        closestPart = targetPart\n                    end\n                end\n            end\n        end\n    end\n\n    return closestPart\nend\n\n--// Aimbot Variables\nlocal currentTarget = nil\n\n--// Aimbot Loop\nrunservice.RenderStepped:Connect(function()\n    fov.Position = userinput:GetMouseLocation()\n\n    if getgenv().settings.aimbot_enabled then\n        if userinput:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then\n            currentTarget = getClosestPlayer()\n        else\n            currentTarget = nil\n        end\n\n        if currentTarget then\n            local predictedPosition = currentTarget.Position\n            if currentTarget.Velocity then\n                predictedPosition = predictedPosition + (currentTarget.Velocity * getgenv().settings.prediction)\n            end\n\n            local screenPos = camera:WorldToViewportPoint(predictedPosition)\n            local mousePos = userinput:GetMouseLocation()\n            local delta = Vector2.new(screenPos.X, screenPos.Y) - mousePos\n\n            local move = delta * getgenv().settings.smoothness\n            move = Vector2.new(\n                math.clamp(move.X, -100, 100),\n                math.clamp(move.Y, -100, 100)\n            )\n\n            mousemoverel(move.X, move.Y)\n        end\n    end\nend)\n\n--// HOTKEY: Press X to toggle aim_part\nuserinput.InputBegan:Connect(function(input, processed)\n    if not processed and input.KeyCode == Enum.KeyCode.X then\n        getgenv().settings.aim_part = getgenv().settings.aim_part == \"head\" and \"torso\" or \"head\"\n        print(\"[Aimbot] Changed target to:\", getgenv().settings.aim_part)\n    end\nend)\n","owner":{"_id":"67fab7f4f2b897410493aab6","username":"Zemon07","verified":false,"profilePicture":"/images/photo/67fab7f4f2b897410493aab6-1790848179667.png","status":"offline","id":"67fab7f4f2b897410493aab6","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":7190,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-a401374957d565819d43102f896559c5-aad93166e3a4.png","likeCount":0,"dislikeCount":1,"createdAt":"2025-04-23T01:31:07.860Z","editBy":{"_id":"67fab7f4f2b897410493aab6","username":"Zemon07","status":"offline","id":"67fab7f4f2b897410493aab6"},"executes":72,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"680842dba89fd911d974653c","editBy":{"_id":"67fab7f4f2b897410493aab6","username":"Zemon07","status":"offline","id":"67fab7f4f2b897410493aab6"},"message":"Create script","createdAt":"2025-04-23T01:31:07.862Z"},{"_id":"680843e372b175908439b50e","editBy":{"_id":"67fab7f4f2b897410493aab6","username":"Zemon07","status":"offline","id":"67fab7f4f2b897410493aab6"},"message":"Update script","createdAt":"2025-04-23T01:35:31.839Z"},{"_id":"6818063d605aada39a9b6af6","editBy":{"_i