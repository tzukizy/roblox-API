p-at-rarity option, and crate sweeping, while Misc adds claim routines, teleports, and server tools. Everything the hub touches is restored on unload, including resized hitbox parts, patched punch configs, and all signal connections.\n\nJujustu Zero, Jiujistu Zero, Jujustu","tags":[],"script":"loadstring(game:HttpGet(\"https://jnkie.com/loaders/fishyhub\"))()","owner":{"_id":"6a3c5ce3e23ccd44d1db2827","username":"fishyzzz","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/618ce0ab4affa29322d7fd3de231a6378bb5b8f0e7195166e692d6b2689bb3b8.webp","original":"https://scriptblox.com/images/photo/6a3c5ce3e23ccd44d1db2827-1788304605349.jpeg"},"lvl":17,"status":"offline","id":"6a3c5ce3e23ccd44d1db2827","leaderboard":{"tag":{"kind":"hall","rank":3,"period":"all","metric":"likes","value":1744}},"topMilestone":{"key":"creator.likes","tier":1000},"profile":{"url":"https://cdn.kocakz.me/images/618ce0ab4affa29322d7fd3de231a6378bb5b8f0e7195166e692d6b2689bb3b8.webp","original":"https://scriptblox.com/images/photo/6a3c5ce3e23ccd44d1db2827-1788304605349.jpeg"}},"verified":false,"keyless":false,"discord":"https://discord.gg/fishyhub","keyLink":"https://fishyhub.online","views":2090,"executes":3733,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/883b9d7067bf55a0b9a98cc990f36acdf8c2a498da74db48c437bf7c593d3547.webp","original":"https://scriptblox.com/images/sb/rbx-336289b641a2ea11e93798652f89cc81-79c9000bab82.png","scriptblox":"https://scriptblox.com/images/script/rbx-336289b641a2ea11e93798652f89cc81-79c9000bab82.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-09-21T03:49:38.917Z","reviewed":{"name":"QueueSpeedDemon","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-09-21T08:07:41.785Z","profile":"/u/QueueSpeedDemon"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":