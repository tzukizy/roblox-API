{"id":105457570355541,"name":"[JANUARY] Corrupted Crossroads","desc":"OUTRUN THE KILLER. MASTER YOUR ABILITIES. SURVIVE.\n\nx1.25 more Coins & XP on the weekends!\n\nCorrupted Crossroads is an asymmetrical survival game featuring fully customizable loadouts for both killers and survivors.\nCraft your ultimate build by combining unique class stats, custom abilities, and a diverse selection of deadly blades!\n\n⚠️ This game is in BETA! Expect bugs to arise. You can report them in our community server. ⚠️\n\nThis game is inspired by Flee the Facility and several other asymmetrical games.","path":"/game/105457570355541-corrupted-crossroads","slug":"105457570355541-corrupted-crossroads","thumbnail":{"url":"https://media.kocakz.me/94b9d2ab4ee7d0844dcf245b32129d57d2924f78430881e6ae316af19ae45cc7.webp","original":"https://tr.rbxcdn.com/180DAY-255eaa1d23a08015bf724b23ac2ea241/150/150/Image/Png/noFilter"},"playing":242,"visitor":12126606,"verified":false,"updatedAt":"2026-02-01T17:27:04.133Z","creator":{"name":"Deveeon","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"JANUARY-Corrupted-Crossroads-speed-boost-with-gun-98742","_id":"697f8ce85f3a335491d3506c","title":"speed boost with gun","game":{"_id":"68dadeb4ef86c1ca0c5a25fd","gameId":105457570355541,"name":"[JANUARY] Corrupted Crossroads","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":105457570355541},"features":"ok so like you get a 30% speed boost when shooting the rifleption \"sword\" which is like speed III buff, easily get close to survivors\nDO NOT EXECUTE TWICE, YOU MAY FREEZE ROBLOX\ndisclaimer: ai was used please do not bully me","tags":["corrupted crossroads","corrupted","crossroads","speed","rifleption"],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\n\nlocal TARGET_VALUE = 1.3\nlocal currentSlowValue = nil\nlocal changeConnection = nil\n\nlocal playersFolder = workspace:WaitForChild(\"Players\", 10)\nif not playersFolder then\n    error(\"❌ 'players' folder not found in workspace!\")\nend\n\nlocal heartbeatConnection = RunService.Heartbeat:Connect(function()\n    pcall(function()\n        local playerFolder = playersFolder:FindFirstChild(player.Name)\n        if not playerFolder then return end \n        \n        local multipliers = playerFolder:FindFirstChild(\"_multipliers\")\n        if not multipliers then return end\n        \n        local rifleSlow = multipliers:FindFirstChild(\"rifleption.slow\")\n        if not rifleSlow or not (rifleSlow:IsA(\"NumberValue\") or rifleSlow:IsA(\"IntValue\")) then return end\n        \n        if currentSlowValue ~= rifleSlow then\n            if changeConnection then\n                changeConnection:Disconnect()\n            end\n            \n            currentSlowValue = rifleSlow\n            rifleSlow.Value = TARGET_VALUE\n            \n            changeConnection = rifleSlow:GetPropertyChangedSignal(\"Value\"):Connect(function()\n                if rifleSlow.Value ~= TARGET_VALUE then\n                    rifleSlow.Value = TARGET_VALUE\n                end\n            end)\n            \n            print(\"works → \" .. rifleSlow:GetFullName() .. \" = \" .. TARGET_VALUE .. \" (have fun)\")\n        end\n    end)\nend)","owner":{"_id":"69129c77231ade05b4833e83","username":"exploitsoneverything","verified":false,"profilePicture":{"url":"https://media.kocakz.me/e4d3598608d7a73e3b1e5577aba2389923c588e1d557fed301eeaa5c6999344c.webp","original":"https://scriptblox.com/images/photo/69129c77231ade05b4833e83-1762827498075.png"},"status":"offline","id":"69129c77231ade05b4833e83","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/e4d3598608d7a73e3b1e5577aba2389923c588e1d557fed301eeaa5c6999344c.webp","original":"https://scriptblox.com/images/photo/69129c77231ade05b4833e83-1762827498075.png"}},"verified":false,"views":1170,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/90c6ad2ce0f3f9d8ce8c40f155fff628a3096e3247f855aadc91062f446ee033.webp","original":"https://scriptblox.com/images/sb/rbx-132b129d6a4558fb21784aa4015be5dd-3e0690a7ea11.png","scriptblox":"https://scriptblox.com/images/script/rbx-132b129d6a4558fb21784aa4015be5dd-3e0690a7ea11.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-01T17:27:04.134Z","keyLink":"","editBy":{"_id":"69129c77231ade05b4833e83","username":"exploitsoneverything","status":"offline","id":"69129c77231ade05b4833e83"},"discord":"https://discord.gg/JDAm4FPW8k","executes":383,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:06:58.447Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/90c6ad2ce0f3f9d8ce8c40f155fff628a3096e3247f855aadc91062f446ee033.webp","original":"https://scriptblox.com/images/sb/rbx-132b129d6a4558fb21784aa4015be5dd-3e0690a7ea11.png","scriptblox":"https://scriptblox.com/images/script/rbx-132b129d6a4558fb21784aa4015be5dd-3e0690a7ea11.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"697f8ce85f3a335491d3506f","editBy":{"_id":"69129c77231ade05b4833e83","username":"exploitsoneverything","status":"offline","id":"69129c77231ade05b4833e83"},"message":"Create script","createdAt":"2026-02-01T17:27:04.135Z"},{"_id":"697f92494bfacc3469db3787","editBy":{"_id":"69129c77231ade05b4833e83","username":"exploitsoneverything","status":"offline","id":"69129c77231ade05b4833e83"},"message":"script actually works (go change the value if you wanna test it)","createdAt":"2026-02-01T17:50:01.834Z"},{"_id":"697f94aa711cf3c91212c541","editBy":{"_id":"69129c77231ade05b4833e83","username":"exploitsoneverything","status":"offline","id":"69129c77231ade05b4833e83"},"message":"100% works with proper testing now","createdAt":"2026-02-01T18:00:10.844Z"}],"comments":[]},{"slug":"SILENCER-Corrupted-Crossroads-super-speed-69632","_id":"69247b854905845061b3edff","title":"super speed","game":{"_id":"68dadeb4ef86c1ca0c5a25fd","gameId":105457570355541,"name":"[JANUARY] Corrupted Crossroads","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":105457570355541},"features":"super speed (customizable)","tags":["super speed","walkspeed","anticheat bypass"],"script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\n\nlocal SPEED = 100  -- Tweak this for faster speed\n\nlocal function getHumanoid()\n    return player.Character and player.Character:FindFirstChild(\"Humanoid\")\nend\n\n-- Initial set\nlocal humanoid = getHumanoid()\nif humanoid then\n    humanoid.WalkSpeed = SPEED\nend\n\n-- Loop: Enforces speed every frame (ignores game resets)\nRunService.Heartbeat:Connect(function()\n    local hum = getHumanoid()\n    if hum then\n        hum.WalkSpeed = SPEED\n    end\nend)\n\n-- Re-apply on respawn\nplayer.CharacterAdded:Connect(function(character)\n    character:WaitForChild(\"Humanoid\").WalkSpeed = SPEED\nend)","owner":{"_id":"67dea0a89a7e999f57399bfc","username":"titovvladislav623","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67dea0a89a7e999f57399bfc","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"views":1719,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-0e4f447a7