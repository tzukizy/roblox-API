nRunService.RenderStepped:Connect(function()\n\tif not Flags.KillAura then\n\t\tcurrentTarget = nil\n\t\treturn\n\tend\n\n\tlocal character = localPlayer.Character\n\tlocal playerRootPart = character and character:FindFirstChild(\"HumanoidRootPart\")\n\n\tif not playerRootPart then\n\t\tcurrentTarget = nil\n\t\treturn\n\tend\n\n\tlocal closestEnemy = nil\n\tlocal closestDistance = math.huge\n\n\tfor _, mobFolder in mobFolders do\n\t\tfor _, enemy in mobFolder:GetChildren() do\n\t\t\tlocal humanoid = enemy:FindFirstChildOfClass(\"Humanoid\")\n\t\t\tlocal enemyRootPart = enemy:FindFirstChild(\"HumanoidRootPart\")\n\n\t\t\tif humanoid\n\t\t\t\tand humanoid.Health > 0\n\t\t\t\tand enemyRootPart\n\t\t\t\tand enemyRootPart:IsA(\"BasePart\")\n\t\t\tthen\n\t\t\t\tlocal distance = (enemyRootPart.Position - playerRootPart.Position).Magnitude\n\n\t\t\t\tif distance < closestDistance then\n\t\t\t\t\tclosestDistance = distance\n\t\t\t\t\tclosestEnemy = enemy\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tcurrentTarget = closestEnemy\n\n\tif currentTarget then\n\t\tdealDamageRemote:FireServer({ buffer.fromstring(currentTarget.Name) })\n\tend\nend)\n","features":"Kill Aura","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detec