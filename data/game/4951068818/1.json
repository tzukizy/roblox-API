{"id":4951068818,"name":"Empty Baseplate R6","desc":"","path":"/game/4951068818-empty-baseplate-r6","slug":"4951068818-empty-baseplate-r6","thumbnail":["https://tr.rbxcdn.com/180DAY-90223760650eb6b0e2c3f9faf505e768/150/150/Image/Png/noFilter","https://scriptblox.com/images/no-script.webp","/brand/kocakz-logo.png"],"playing":0,"visitor":0,"verified":false,"updatedAt":"2024-01-22T07:04:37.353Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Empty-Baseplate-R6-Fe-executor-script-10094","_id":"65ae13850c6183813c3003fe","title":"Fe executor script","game":{"_id":"67e5e1ffb360710ec3c788c0","gameId":4951068818,"name":"Empty Baseplate R6","imageUrl":"/images/sb/no-script.webp","placeId":4951068818},"features":"It’s an executor","tags":[],"script":"-- FE Script Executor\n-- Executor Beta V.1\n\n-- Create the executor GUI\nlocal executorGui = Instance.new(\"ScreenGui\")\nexecutorGui.Name = \"ExecutorGui\"\nexecutorGui.Parent = game.Players.LocalPlayer.PlayerGui\n\nlocal mainFrame = Instance.new(\"Frame\")\nmainFrame.Size = UDim2.new(0, 300, 0, 200)\nmainFrame.Position = UDim2.new(0, 10, 0, 10)\nmainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)\nmainFrame.BorderSizePixel = 0\nmainFrame.Parent = executorGui\n\nlocal closeButton = Instance.new(\"TextButton\")\ncloseButton.Size = UDim2.new(0, 20, 0, 20)\ncloseButton.Position = UDim2.new(0, 5, 0, 5)\ncloseButton.Text = \"X\"\ncloseButton.TextColor3 = Color3.fromRGB(255, 255, 255)\ncloseButton.BackgroundColor3 = Color3.fromRGB(0, 0, 255)\ncloseButton.Parent = mainFrame\n\nlocal inputBox = Instance.new(\"TextBox\")\ninputBox.Size = UDim2.new(0, 200, 0, 30)\ninputBox.Position = UDim2.new(0, 50, 0, 100)\ninputBox.PlaceholderText = \"Type your FE script here...\"\ninputBox.Parent = mainFrame\n\nlocal executeButton = Instance.new(\"TextButton\")\nexecuteButton.Size = UDim2.new(0, 150, 0, 30)\nexecuteButton.Position = UDim2.new(0, 75, 0, 150)\nexecuteButton.Text = \"Press to Execute Script\"\nexecuteButton.TextColor3 = Color3.fromRGB(255, 255, 255)\nexecuteButton.BackgroundColor3 = Color3.fromRGB(0, 0, 100)\nexecuteButton.Parent = mainFrame\n\n-- Close button functionality\ncloseButton.MouseButton1Click:Connect(function()\n    executorGui:Destroy()\nend)\n\n-- Execute button functionality\nexecuteButton.MouseButton1Click:Connect(function()\n    local scriptToExecute = inputBox.Text\n    loadstring(scriptToExecute)()\nend)","owner":{"_id":"659e461c95529269afe9b70b","username":"Team8x8x8x8","verified":false,"profilePicture":"/images/photo/659e461c95529269afe9b70b-1704871652724.png","status":"offline","id":"659e461c95529269afe9b70b","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":41040,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-01-22T07:04:37.353Z","dislikeCount":0,"likeCount":0,"image":"/images/sb/4951068818-1705907077279.webp","executes":245,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e5b360710ec3c501b7","editBy":{"_id":"659e461c95529269afe9b70b","username":"Team8x8x8x8","status":"offline","id":"659e461c95529269afe9b70b"},"message":"Create script","createdAt":"2025-03-27T20:47:13.341Z"}],"comments":[{"_id":"65b2c38aabf0f026ea3a5ef3","commentBy":{"_id":"659dac9f5ee13fa29497e9d1","username":"sdfsdfasgerg","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-01-09T20:29:19.531Z","lastActive":"2026-05-11T01:18:11.743Z","status":"offline","id":"659dac9f5ee13fa29497e9d1","topMilestone":{"key":"creator.first_script","tier":1}},"text":"nice","createdAt":"2024-01-25T20:24:42.895Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"65b2c692f0a0412aeb4f0dcb","commentBy":{"_id":"659e461c95529269afe9b70b","username":"Team8x8x8x8","verified":false,"role":"user","profilePicture":"/im