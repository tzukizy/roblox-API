r\"):FireServer()\n    else\n        print(\"Gear Off\")\n    end\nend)\n\ngame:GetService(\"RunService\").RenderStepped:Connect(function()\n    if _G.on then\n        game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Events\"):WaitForChild(\"GiveGear\"):FireServer()\n    end\nend)\n\nSection:NewSlider(\"Speed\", \"Speed CHanger\", 200, 16, function(s) -- 500 (MaxValue) | 0 (MinValue)\n    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = s\nend)","features":"Script Gives Gears, Teleports you to the end, auto get gears, and walkspeed changer.\n\nI made this for testing, please like if you like the script and also its open-sourced!","tags":["Roblox","obby","OBBY","robloxgames","script"],"discord":"","keyLink":"","owner":{"_id":"64e89c00d8624d277b1b0fab","username":"EviIAlienWare","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"64e89c00d8624d277b1b0fab","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:10:45.702Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e4b360710ec3c4f8f0","editBy":{"_id":"64e89c00d8624d277b1b0fab","username":"EviIAlienWare","status":"offline","id":"64e89c00d8624d277b1b0fab"},"message":"Create script","createdAt":"2025-03-27T02:55:07.309Z"}],"comments":[]},{"_id":"64eb10202d7bfdfb2d89c2e5","title":"Skip Stage and me","game":{"_id":"67e5e1ffb360710ec3c78bda","gameId":14005305090,"name":"Good Or Bad Obby","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"14005305090-good-or-bad-obby","path":"/game/14005305090-good-or-bad-obby","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":140