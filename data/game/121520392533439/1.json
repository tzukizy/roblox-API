ocal character = player.Character\n    local humanoidRootPart = character and character:FindFirstChild(\"HumanoidRootPart\")\n\n    if humanoidRootPart then\n        local function simulateTouch(part)\n            if part and part:IsA(\"BasePart\") then\n                humanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)\n                wait()\n            end\n        end\n\n        for _, instance in pairs(game:GetDescendants()) do\n            if instance:IsA(\"BasePart\") and instance:FindFirstChildOfClass(\"TouchTransmitter\") then\n                simulateTouch(instance)\n            end\n        end\n    end\n\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"Rebirth\"):FireServer()\n    wait()\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"GemUpgrade\"):FireServer(\"2\")\nuntil not _G.run\n","features":"Thanks to @CryptPerson for the original script.\nI saw that the script uses firetouchinterest() that isn't supported in low UNC executors so I replaced it with manual tp (visible to other players!).","tags":["cool","autofarm","auto","clicker","easy"],"discord":"","keyLink":"","owner":{"_id":"66d0d014f86ef01518b30362","username":"Bjarnos","verified":false,"profilePicture":{"url":"https://media.kocakz.me/94fafa67ea5bd36f7ff91e42c4fa9748511e6c0b3ad3332c951a7607d1fd6157.webp","original":"https://scriptblox.com/images/photo/66d0d014f86ef01518b30362-1724960871449.jpg"},"status":"offline","id":"66d0d014f86ef01518b30362","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/94fafa67ea5bd36f7ff91e42c4fa9748511e6c0b3ad3332c951a7607d1fd6157.webp","original":"https://scriptblox.com/images/photo/66d0d014f86ef01518b30362-1724960871449.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:08:38.549Z","l