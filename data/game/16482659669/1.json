ne"],"script":"--Made By: Shag420\n\nlocal PERSONTOCLONE = game.Players[\"PutUsernameHere\"] --Replace with the persons exact username you want to copy [Cap Sensitive]\n\nlocal LocalPlayer = game.Players.LocalPlayer\nlocal MyPlotBoundary\nlocal OriginalPlotBoundary\n\nfor i, v in next, workspace.Plots:GetDescendants() do\n    if v.Name == \"Owner\" and v.Value == LocalPlayer then\n        MyPlotBoundary = v.Parent.PlotBoundary\n        break\n    end\nend\n\nfor i, v in next, workspace.Plots:GetDescendants() do\n    if v.Name == \"Owner\" and v.Value == PERSONTOCLONE then\n        OriginalPlotBoundary = v.Parent.PlotBoundary\n        local blocks = v.Parent.Assets:GetChildren()\n        local blockIndex = 1\n        \n        game:GetService(\"RunService\").Heartbeat:Connect(function()\n            if blockIndex <= #blocks then\n                local c = blocks[blockIndex]\n                blockIndex = blockIndex + 1\n                \n                local SHAG = OriginalPlotBoundary.CFrame:Inverse() * c.CFrame\n                \n                local NEWCLONEDPLACE = MyPlotBoundary.CFrame * SHAG\n                \n                local args = {\n                    [1] = {\n                        [\"CF\"] = NEWCLONEDPLACE,\n                        [\"Material\"] = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"BuildStorage\"):WaitForChild(\"Textures\"):WaitForChild(\"\"..c.Name),\n                        [\"Color\"] = c.Color\n                    }\n                }\n                \n                game:GetService(\"ReplicatedStorage\"):WaitForChild(\"BuildStorage\"):WaitForChild(\"RequestBlockPlace\"):InvokeServer(unpack(args))\n            end\n        end)\n    end\nend","owner":{"_id":"61f3119e4351a4a73afa7497","username":"Shag420","verified":false,"profilePicture":{"url":"https://media.kocakz.me/0adac1b8030c9ae6b2de87f79b164588085bcda13cb8f6a146efd5bcf6643f9e.webp","original":"https://scriptblox.com/images/photo/61f3119e4351a4a73afa7497-1691206414857.jpg"},"lvl":12,"status":"offline","id":"61f3119e4351a4a73afa7497","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/0adac1b8030c9ae6b2de87f79b164588085bcda13cb8f6a146efd5bcf6643f9e.webp","original":"https://scriptblox.com/images/photo/61f3119e4351a4a73afa7497-1691206414857.jpg"}},"verified":false,"keyLink":"","views":10146,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2024-12-05T02:47:22.728Z","dislikeCount":0,"likeCount":4,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter"},"executes":14,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:14:50.060Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-68fb7cf59c53db9c70c698c1bf1d089f/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4d284","editBy":{"_id":"61f3119e4351a4a73afa7497","username":"Shag420","status":"offline","id":"61f3119e4351a4a73afa7497"},"message":"Create script","createdAt":"2024-12-05T02:56:09.615Z"},{"_id":"67e5e1e6b360710ec3c53581","editBy":{"_id":"61f3119e4351a4a73afa7497","username":"Shag420","status":"offline","id":"61f3119e4351a4a73afa7497"},"message":"Update script","createdAt":"2025-03-27T20:58:18.810Z"}],"comments":[{"_id":"675123fe92729e3d21bbd543","commentBy":{"_id":"621ef5ed266624224dc02ee3","username":"TimTom777","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/83ce7c1d7ed573