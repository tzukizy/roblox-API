 do\ntask.wait(0.5)\ngame:GetService(\"ReplicatedStorage\").SwordDamage:FireServer(pl, -math.huge, \"fuck_nil\", pl.UserId)\nend\nend)\nend\nend)\n\n\nwindow:createButton(\"Kill-All\", function()\nfor _, plrs in next, (game.Players:GetPlayers()) do\nif plrs ~= game.Players.LocalPlayer and plrs.Character then\ngame:GetService(\"ReplicatedStorage\").SwordDamage:FireServer(plrs, math.huge, \"BlueEpicness\", pl.UserId)\nend\nend\nend)\n\nlocal n = game:GetService(\"ReplicatedStorage\").Modules.SwordInventory.Swords\nwindow:createButton(\"Unlock All Weapons\", function()\nfor _, folder in next, (n:GetChildren()) do\nif folder:IsA(\"Folder\")  then\nfor _, hack in next, (folder:GetChildren()) do\nif hack:IsA(\"Model\") then\ngame:GetService(\"ReplicatedStorage\").Events.Swords.UnlockSword:FireServer(hack.Name)\nend\nend\nend\nend\nend)\n\n\n\n\n","owner":{"_id":"6867e35d5ff8bc43bd1aaa9b","username":"astromascripts","verified":false,"profilePicture":"/images/photo/6867e35d5ff8bc43bd1aaa9b-1781662845930.png","status":"offline","id":"6867e35d5ff8bc43bd1aaa9b","topMilestone":{"key":"creator.scripts","tier":10}},"verified":false,"views":1468,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-a403deecce1c2ec5dd0907650cd398c4-ab89166f58aa.png","likeCount":3,"dislikeCount":1,"createdAt":"2026-03-09T11:38:52.438Z","editBy":{"_id":"6867e35d5ff8bc43bd1aaa9b","username":"astromascripts","status":"offline","id":"6867e35d5ff8bc43bd1aaa9b"},"keyLink":"","executes":154,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69aeb14c11afc6c1a5b31c85","editBy":{"_id":"6867e35d5ff8bc43bd1aaa9b","username":"astromascripts","status":"offline","id":"6867e35d5ff8bc43bd1aaa9b"},"message":"Create script","createdAt":"2026-03-09T11:38:52.440Z"},{"_id":"69aeb27006c4bd6aa8041478","editBy":{"_id":"6867e35d5ff8bc43bd1aaa9b","username":"astromascripts","status":"offline","id":"6867e35d5ff8bc43bd1aaa9b"},"