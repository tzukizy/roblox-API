, \"BlueEpicness\", pl.UserId)\nend\nend\nend)\n\nlocal n = game:GetService(\"ReplicatedStorage\").Modules.SwordInventory.Swords\nwindow:createButton(\"Unlock All Weapons\", function()\nfor _, folder in next, (n:GetChildren()) do\nif folder:IsA(\"Folder\")  then\nfor _, hack in next, (folder:GetChildren()) do\nif hack:IsA(\"Model\") then\ngame:GetService(\"ReplicatedStorage\").Events.Swords.UnlockSword:FireServer(hack.Name)\nend\nend\nend\nend\nend)\n\n\n\n\n","owner":{"_id":"6867e35d5ff8bc43bd1aaa9b","username":"astromascripts","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/4ba0b3711f33758390e76ad24f3c33bcc34846adb7c17525022995d949e74a35.webp","original":"https://scriptblox.com/images/photo/6867e35d5ff8bc43bd1aaa9b-1781662845930.png"},"status":"offline","id":"6867e35d5ff8bc43bd1aaa9b","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/4ba0b3711f33758390e76ad24f3c33bcc34846adb7c17525022995d949e74a35.webp","original":"https://scriptblox.com/images/photo/6867e35d5ff8bc43bd1aaa9b-1781662845930.png"}},"verified":false,"views":1475,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/80f2106f1d898d65fd4270586c51b18dc34e78ed2851e8ffe53e5b88c0b792ba.webp","original":"https://scriptblox.com/images/sb/rbx-a403deecce1c2ec5dd0907650cd398c4-ab89166f58aa.png","scriptblox":"https://scriptblox.com/images/script/rbx-a403deecce1c2ec5dd0907650cd398c4-ab89166f58aa.png"},"likeCount":3,"dislikeCount":1,"createdAt":"2026-03-09T11:38:52.438Z","editBy":{"_id":"6867e35d5ff8bc43bd1aaa9b","username":"astromascripts","status":"offline","id":"6867e35d5ff8bc43bd1aaa9b"},"keyLink":"","executes":177,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:28:36.346Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images