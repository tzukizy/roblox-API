d":"679ef1c1e70e2d89ee740520","title":"Klll Noob  Slmulator Give G Switch [Open Source ]","game":{"_id":"67e5e1ffb360710ec3c781e5","gameId":15706768845,"name":"Kill noobs simulator","imageUrl":"https://tr.rbxcdn.com/180DAY-dd0514814d6ec2c85901e9c4bd320288/500/280/Image/Jpeg/noFilter","placeId":15706768845},"features":"Basicly what is does is it triggers the BoolValue for the Switch (of the starter pistol) and its basicly you have G Switch but without really having it\n\nshould work every exploit\n\nONLY WORKS ON PISTOL (G17)","tags":[],"script":"local Player = game:GetService(\"Players\").LocalPlayer\n\nlocal GunNames = {\n    \"AK\", \"AUGA1\", \"ARP\", \"Beretta\", \"Bullpup\", \"CZ75\", \"Deagle\", \"DoubleBarrel\",\n    \"Draco\", \"Famas\", \"Glock18\", \"M1Grand\", \"M4A1\", \"MAC10\", \"MAG7\", \"MP5\", \"MP7\",\n    \"MP9\", \"Negev\", \"Nova\", \"P220\", \"PPBizon\", \"Pistol\", \"RPG\", \"Revolver\", \"SA58\",\n    \"SawnOff\", \"Shotgun\", \"Uzi\"\n}\n\nlocal SwitchValue = true\n\nlocal SetSwitch = function(Gun)\n    if not Gun:IsA(\"Tool\") or not table.find(GunNames, Gun.Name) then return end\n\n    local Switch = Gun:FindFirstChild(\"Switch\") then\n  \n        Switch.Value = SwitchValue\n    end\nend\n\n\nlocal OnChildAdded = function(Child)\n    SetSwitch(Child)\nend\n\nPlayer.Backpack.ChildAdded:Connect(OnChildAdded)\n\nfor _, Object in ipairs(Player.Backpack:GetChildren()) do\n    SetSwitch(Object)\nend","owner":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"profilePicture":"/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png","status":"offline","id":"66c63d08f2b2900a0fcb7b0a","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":6810,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-02T04:17:05.993Z","dislikeCount":0,"likeCount":0,"image":"https://tr.rbxcdn.com/180DAY-b86517f0d575f651de64f746bb729f2c/500/280/Image/Jpeg/noFilter","executes":36,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c548ce","editBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","status":"offline","id":"66c63d08f2b2900a0fcb7b0a"},"message":"Create script","createdAt":"2025-03-27T22:27:16.193Z"}],"comments":[{"_id":"679f1148838723a30814952e","commentBy":{"_id":"673deebb9562d9df0517f0e8","username":"tkdg","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2024-11-20T14:14:19.933Z","lastActive":"2026-10-09T15:25:33.727Z","status":"offline","id":"673deebb9562d9df0517f0e8","topMilestone":{"key":"creator.first_script","tier":1}},"text":"dude cant even write a script properly","createdAt":"2025-02-02T06:31:36.279Z","edited":true,"dislikeCount":1,"likeCount":1,"liked":false,"disliked":false}]},{"slug":"Kill-noobs-simulator-Noob-Infinite-Ammo-open-source-28248","_id":"679edbd7517cecbf318b941f","title":"Klll   Infinite Ammo [open source]","game":{"_id":"67e5e1ffb360710ec3c781e5","gameId":15706768845,"name":"Kill noobs simulator","imageUrl":"https://tr.rbxcdn.com/180DAY-dd0514814d6ec2c85901e9c4bd320288/500/280/Image/Jpeg/noFilter","placeId":15706768845},"features":"Just gives you crap ton of ammo, when running maybe ur gonna need to reset\n\nwith \"Infinite ammo\" you cant really reload\nshould work with every exploits (simple variables obviously)\nworks every guns (guns from test place :))","tags":[],"script":"local Player = game:GetService(\"Players\").LocalPlayer\n\nlocal GunNames = {\n    \"AK\", \"AUGA1\", \"ARP\", \"Beretta\", \"Bullpup\", \"CZ75\", \"Deagle\", \"DoubleBarrel\",\n    \"Draco\", \"Famas\", \"Glock18\", \"M1Grand\", \"M4A1\", \"MAC10\", \"MAG7\", \"MP5\", \"MP7\",\n    \"MP9\", \"Negev\", \"Nova\", \"P220\", \"PPBizon\", \"Pistol\", \"RPG\", \"Revolver\", \"SA58\",\n    \"SawnOff\", \"Shotgun\", \"Uzi\"\n}\n\nlocal AmmoValue = 1000 -- change the number to the ammo count that you wish ;)\n\nlocal SetAmmo = function(Gun)\n    if not Gun:IsA(\"Tool\") or not table.find(GunNames, Gun.Name) then return end\n\n    local Stats = Gun:FindFirstChild(\"Stats\")\n  \n    if not Stats then return end    \n\n    local Ammo = Stats.Ammo\n\n    if not Ammo then return end\n\n    Ammo.Value = AmmoValue\nend\n\nlocal OnChildAdded = function(Child)\n    SetAmmo(Child)\nend\n\nPlayer.Backpack.ChildAdded:Connect(OnChildAdded)\n\nfor _, Object in ipairs(Player.Backpack:GetChildren()) do\n    SetAmmo(Object)\nend","owner":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","verified":false,"profilePicture":"/images/photo/66c63d08f2b2900a0fcb7b0a-1751542091257.png","status":"offline","id":"66c63d08f2b2900a0fcb7b0a","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"keyLink":"","views":4477,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-02-02T02:43:35.385Z","dislikeCount":0,"likeCount":0,"image":"https://tr.rbxcdn.com/180DAY-b86517f0d575f651de64f746bb729f2c/500/280/Image/Jpeg/noFilter","executes":27,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c548c8","editBy":{"_id":"66c63d08f2b2900a0fcb7b0a","username":"SpxzyCDOT","status":"offline","id":"66c63d08f2b2900a0fcb7b0a"},"message":"Create script","createdAt":"2025-03-27T22:49:35.760Z"}],"comments":[]}]}