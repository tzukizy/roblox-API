ember🌟\n--- Circle Wall Tool!\n--- Extra Bomb Each Round!\n--- +25% Walk Speed!","path":"/game/394773622-revenge-of-the-slimes","slug":"394773622-revenge-of-the-slimes","thumbnail":{"url":"https://media.kocakz.me/528166d81dc40b54b925b491348d0bd1cb30af8664f9ac8d334852dfef6a62b5.webp","original":"https://tr.rbxcdn.com/180DAY-bdd6a17fd95cc9e9f41bf04c1968467f/150/150/Image/Png/noFilter"},"playing":21,"visitor":82407050,"verified":false,"updatedAt":"2024-09-24T11:40:53.733Z","creator":{"name":"Chillz Studios","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":0,"verifiedCount":0}}],"totalGames":14215,"totalPages":593,"currentPage":246}