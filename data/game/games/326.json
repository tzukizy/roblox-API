me\r\n💪Get bigger or smaller at the gym\r\n🕵Explore and discover secrets\r\n\r\nBasic Controls:\r\nHold down to charge your melee attacks.  Max damage when the fist glows.\r\nE, Stomp | G, Carry | Q Mouselock (must have mouselock active)\r\nF, Block | Ctrl, Crouch | Shift, Run\r\n\r\nGreen bar is your health.  Yellow bar is your stamina.\r\n💫Means you're knocked out, stomping someone knocked out will damage them\r\n⚠️Means you're down, stomping someone down will kill them\r\n☠️Means you're dead\r\n\r\nGame similar to Da Hood, Criminality and aspects of Ohio.","path":"/game/6924952561-clover-city","slug":"6924952561-clover-city","thumbnail":{"url":"https://media.kocakz.me/96521d8e815b5576e5799b810ad597e0c9ecd1f89b919818f94bc6098d36c50e.webp","original":"https://tr.rbxcdn.com/180DAY-815d523621d80c52f4d001e87698e398/150/150/Image/Png/noFilter"},"playing":3,"visitor":15646233,"verified":false,"updatedAt":"2023-08-18T17:56:59.691Z","creator":{"name":"Digital Cosmos","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":2,"verifiedCount":0}},{"id":23578803,"name":"Hotel Elephant","desc":"","path":"/game/23578803-hotel-elephant","slug":"23578803-hotel-elephant","thumbnail":{"url":"https://media.kocakz.me/8b096309174dc33c0df19d243b9e43e1c8d9dc23c8ae0b4b04b62d200d1fa9a7.webp","original":"https://tr.rbxcdn.com/180DAY-e4947630d29756f95fe78f426885f8f4/150/150/Image/Png/noFilter"},"playing":3,"visitor":0,"verified":false,"updatedAt":"2025-04-22T06:43:18.162Z","creator":{"name":"Roblox","type":"User"},"script":{"count":11,"freeCount":11,"keyCount":0,"verifiedCount":0}},{"id":4003872968,"name":"😱 Giant Survival! ","desc":"Can YOU survive the GIANTS?","path":"/game/4003872968-giant-survival","slug":"4003872968-giant-survival","thumbnail":{"url":"https://media.kocakz.me/85966ec8a958832740dc538fc1ca20bb20ccf21fe0d0299022ad30b407539ad0.webp","original":"https://tr.rbxcdn.com/180DAY-9d17d0f0bac33ebe59795158093dd8d6/150/150/Image/Png/noFilter"},"playing":3,"visitor":259200048,"ve