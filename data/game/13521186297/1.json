{"id":13521186297,"name":"Hot Pot Restaurant","desc":"Welcome to our Hot Pot restaurant! The experience offers a realistic visit to a hot pot restaurant, based in Hong Kong.\n\nQ: What is Hot Pot?\nA: Hot pot is popular across Asia. Ingredients are served raw and then cooked with boiling broth in a pot. It is enjoyed once cooked.\n\nJoin the group to Support! https://www.roblox.com/groups/7081575/Eagle-Studios#!/about\n\nAll audios are NON copy-righted.\n\nGame made by Johnpcps.\n\nTags: Restaurant, Hong Kong, Chinese, Showcase, The Asylum, Before Truth, The Obby Elevator, Relax, Chill, Vibe, Japan, Korean, Cafe, Food","path":"/game/13521186297-hot-pot-restaurant","slug":"13521186297-hot-pot-restaurant","thumbnail":["https://tr.rbxcdn.com/180DAY-efaf6813d723a064cced5957da209fe8/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-3e8e63a9ece9a8a64a0cc77727a56b2f/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":141,"visitor":52085870,"verified":false,"updatedAt":"2026-04-12T19:59:11.540Z","creator":{"name":"johnpcps","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Hot-Pot-Restaurant-Map-Destroyer-247357","_id":"69dbf7bbbee9400302a1e2d3","title":"Map Destroyer","game":{"_id":"68b447f19d3c07cb16e8e004","gameId":13521186297,"name":"Hot Pot Restaurant","imageUrl":"/images/sb/rbx-3e8e63a9ece9a8a64a0cc77727a56b2f-940dec2458c5.png","placeId":13521186297},"features":"Map go bye","tags":["ok","miketyson"],"script":"-- https://www.roblox.com/games/13521186297\n\nlocal PlacePlate = game:GetService(\"ReplicatedStorage\").PlacePlate\nlocal LP = game:GetService(\"Players\").LocalPlayer\nlocal Table = workspace.TablesChairs:GetChildren()[6].Table\n\nfor _, x in ipairs(workspace:GetDescendants()) do\n\tif x:IsA(\"BasePart\") and x.Anchored then\n\t\tPlacePlate:FireServer(LP,x,x.Position - Vector3.new(5,10,5),Table)\n\tend\nend\n\nwhile wait(1) do\n\tfor _, plr in next, game.Players:GetChildren() do\n\t\tif plr == LP then continue end\n\t\t\n\t\tpcall(function()\n\t\t\tPlacePlate:FireServer(LP,plr.Character[\"Left Arm\"],nil,Table)\n\t\t\tPlacePlate:FireServer(LP,plr.Character[\"Right Leg\"],nil,Table)\n\t\tend)\n\tend\nend","owner":{"_id":"6844e077059a9781e00e1ba7","username":"miketyson","verified":false,"profilePicture":"/images/photo/6844e077059a9781e00e1ba7-1757183112902.jpg","status":"offline","id":"6844e077059a9781e00e1ba7","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":751,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/13521186297-1776023483604.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-04-12T19:51:23.634Z","executes":617,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69dbf7bbbee9400302a1e2d7","editBy":{"_id":"6844e077059a9781e00e1ba7","username":"miketyson","status":"offline","id":"6844e077059a9781e00e1ba7"},"message":"Create script","createdAt":"2026-04-12T19:51:23.640Z"}],"comments":[{"_id":"6a361bb56d8d34f61825b4eb","commentBy":{"_id":"6a34ed09fc37bbab9df7acab","username":"67six_sevennnnnnnnn","verified":false,"role":"user","profilePicture":"/images/photo/6a34ed09fc37bbab9df7acab-1781853638611.jpg","lastActive":"2026-07-17T02:09:19.461Z","createdAt":"2026-06-19T07:17:29.976Z","status":"offline","id":"6a34ed09fc37bbab9df7acab"},"text":"?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-06-20T04:48:53.831Z","liked":false,"disliked":false}]},{"slug":"Hot-Pot-Restaurant-Get-All-Bdges-50976","_id":"68b447f19d3c07cb16e8e007","title":"Get All Bdges","game":{"_id":"68b447f19d3c07cb16e8e004","gameId":13521186297,"name":"Hot Pot Restaurant","imageUrl":"/images/sb/rbx-3e8e63a9ece9a8a64a0cc77727a56b2f-940dec2458c5.png","placeId":13521186297},"features":"Get all Badges","tags":[],"script":"loadstring(game:HttpGet('https://raw.githubusercontent.com/whosfrench0/pothot/refs/heads/m