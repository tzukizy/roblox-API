{"id":4789047554,"name":"Prison Escape v2","desc":"","path":"/game/4789047554-prison-escape-v2","slug":"4789047554-prison-escape-v2","thumbnail":["https://tr.rbxcdn.com/180DAY-492589e0f04a1cccedf53de7831e7ddb/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-3bc69bd1320c8982594abfd6f5fefce1/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":191,"visitor":0,"verified":false,"updatedAt":"2026-08-04T12:44:29.913Z","creator":{"name":"Roblox","type":"User"},"script":{"count":8,"freeCount":8,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Prison-Escape-v2-kill-all-226854","_id":"6a71dead9e5baa3f0426a4e1","title":"kill all","game":{"_id":"67e5e1ffb360710ec3c784ee","gameId":4789047554,"name":"Prison Escape v2","imageUrl":"/images/sb/rbx-3bc69bd1320c8982594abfd6f5fefce1-097c858c1cda.png","placeId":4789047554},"features":"Hit all players per use (weapon effect if held)","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character\nlocal Backpack = LocalPlayer:FindFirstChildOfClass(\"Backpack\")\nlocal Event = ReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"runThereJungle\")\n\nlocal function findGun(Container)\n    if not Container then\n        return nil\n    end\n    for _, Object in ipairs(Container:GetChildren()) do\n        if Object:IsA(\"Tool\") and Object:FindFirstChild(\"GunScript_Local\", true) then\n            return Object\n        end\n    end\n    return nil\nend\n\nlocal function getSettings(Tool)\n    for _, Object in ipairs(Tool:GetDescendants()) do\n        if Object:IsA(\"ModuleScript\") then\n            local Name = string.lower(Object.Name)\n            if Name == \"setting\"\n                or Name == \"settings\"\n                or Name == \"configuration\"\n                or Name == \"config\" then\n                local Success, Data = pcall(require, Object)\n                if Success and type(Data) == \"table\" and Data.BaseDamage ~= nil then\n                    return Data\n                end\n            end\n        end\n    end\n    return nil\nend\n\nlocal Tool = findGun(Character) or findGun(Backpack)\nif not Tool then\n    return\nend\n\nlocal Settings = getSettings(Tool)\nif not Settings then\n    return\nend\n\nlocal LocalRoot = Character and Character:FindFirstChild(\"HumanoidRootPart\")\nlocal GunVisualEffects = ReplicatedStorage:FindFirstChild(\"Miscs\")\nGunVisualEffects = GunVisualEffects and GunVisualEffects:FindFirstChild(\"GunVisualEffects\")\nlocal ToolEffects = GunVisualEffects and GunVisualEffects:FindFirstChild(Tool.Name)\nlocal GoreEffect = ToolEffects and ToolEffects:FindFirstChild(\"GoreEffect\")\n\nfor _, TargetPlayer in ipairs(Players:GetPlayers()) do\n    if TargetPlayer ~= LocalPlayer then\n        local TargetCharacter = TargetPlayer.Character\n        local Humanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass(\"Humanoid\")\n        local Root = TargetCharacter and (\n            TargetCharacter:FindFirstChild(\"HumanoidRootPart\")\n            or TargetCharacter:FindFirstChild(\"Head\")\n        )\n        local HitPart = TargetCharacter and (\n            TargetCharacter:FindFirstChild(\"Head\")\n            or TargetCharacter:FindFirstChild(\"UpperTorso\")\n            or TargetCharacter:FindFirstChild(\"Torso\")\n            or Root\n        )\n\n        if Humanoid and Humanoid.Health > 0 and Root and HitPart then\n            local Distance = LocalRoot and (LocalRoot.Position - HitPart.Position).Magnitude or 0\n            local DamageInfo = {\n                Settings.BaseDamage or 0,\n                Settings.HeadshotDamageMultiplier or 1,\n                Settings.HeadshotEnabled == true,\n                Distance,\n                Settings.DamageBasedOnDistance == true,\n                Settings.ZeroDamageDistance or 10000,\n                Settings.FullDamageDistance or 1000,\n                Settings.FriendlyFire == true\n            }\n            local StatusInfo = {\n                Settings.Lifesteal or 0,\n                Settings.Knockback or 0,\n                Settings.Affliction == true,\n                Settings.AfflictionName or \"\",\n                Settings.AfflictChance or 0\n            }\n            local CriticalInfo = {\n                Settings.CriticalDamageEnabled == true,\n                Settings.CriticalBaseChance or 0,\n                Settings.CriticalDamageMultiplier or 1\n            }\n            local GoreInfo = {\n                Settings.GoreEffectEnabled == true,\n                Settings.GoreSoundIDs or {},\n                Settings.GoreSoundPitchMin or 1,\n                Settings.GoreSoundPitchMax or 1,\n                Settings.GoreSoundVolume or 1,\n                GoreEffect,\n                Settings.FullyGibbedLimbChance or 0\n            }\n\n            task.spawn(function()\n                pcall(\n                    Event.InvokeServer,\n                    Event,\n                    Settings,\n                    Tool,\n                    LocalPlayer,\n                    Humanoid,\n                    Root,\n                    DamageInfo,\n                    StatusInfo,\n                    CriticalInfo,\n                    HitPart,\n                    GoreInfo\n                )\n            end)\n        end\n    end\nend\n","owner":{"_id":"6699134c55b63f5090c2fd42","username":"pagedcomic","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6699134c55b63f5090c2fd42","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":119,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/4789047554-1785847469914.webp","likeCount":0,"dislikeCount":0,"createdAt":"2026-08-04T12:44:29.940Z","executes":3659,"keyless":false,"liked":false,"dislik