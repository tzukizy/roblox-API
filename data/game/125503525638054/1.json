ations.\n- Rare Drop Alerts with adjustable rarity and detection range.\n- Build the Item Registry for rarity filtering and rare-drop alerts.\n- Export item rarities and monster drop information.\n- Track session changes in kills, Silver, Ichor, Offerings, Prestige, and Sins.\n- Server Hop, Rejoin, and Copy Job ID.\n- Save and load your preferred configurations.","tags":[],"discord":"https://discord.gg/axonhub","keyLink":"https://discord.gg/axonhub","owner":{"_id":"6695a7c69e7432524bdd5ece","username":"AxonHub","verified":true,"profilePicture":{"url":"https://media.kocakz.me/be778f9b422b14752293b779e984297eb2b2d3d961fd673dc32f2a4a2dcb900a.webp","original":"https://scriptblox.com/images/photo/6695a7c69e7432524bdd5ece-1766868990008.png"},"lvl":14,"status":"offline","id":"6695a7c69e7432524bdd5ece","leaderboard":{"tag":{"kind":"week","rank":14,"period":"week","metric":"views","value":42859}},"topMilestone":{"key":"creator.streak","tier":30},"profile":{"url":"https://media.kocakz.me/be778f9b422b14752293b779e984297eb2b2d3d961fd673dc32f2a4a2dcb900a.webp","original":"https://scriptblox.com/images/photo/6695a7c69e7432524bdd5ece-1766868990008.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T21:05:10.909Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6aac3dcf0656b064aa8f945d","editBy":{"_id":"6695a7c69e7432524bdd5ece","username":"AxonHub","status":"offline","id":"6695a7c69e7432524bdd5ece"},"message":"Create script","createdAt":"2026-09-17T19:21:51.628Z"}],"comments":[{"_id":"6aad3b0195e81d7458678afb","commentBy":{"_id":"693589f5e4d748bf75a1d979","username":"Hello183","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-10-10T16:33:43.104Z","createdAt":"2025-12-07T14:06:45.528Z","status":"offline","id":"6935