r.CFrame\n            end)\n            hu.CFrame = sav\n        end)\n    end)\nend)","owner":{"_id":"6919ff0e47c8b83f1bcab47b","username":"owlguy17","verified":false,"profilePicture":{"url":"https://media.kocakz.me/c20800025a2a680af953ff81115ed6d5373e038aab87eb35b8ed612192c765f5.webp","original":"https://scriptblox.com/images/photo/6919ff0e47c8b83f1bcab47b-1770843956742.jpg"},"status":"offline","id":"6919ff0e47c8b83f1bcab47b","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/c20800025a2a680af953ff81115ed6d5373e038aab87eb35b8ed612192c765f5.webp","original":"https://scriptblox.com/images/photo/6919ff0e47c8b83f1bcab47b-1770843956742.jpg"}},"verified":false,"views":2159,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/1235331c9cef8ea0eb9fc5c2f8967a264a4171e573b4f36dfae765e6872dacd3.webp","original":"https://scriptblox.com/images/sb/rbx-a842a4c0f2150d91de0f3a83c79425dc-936530f76f31.png","scriptblox":"https://scriptblox.com/images/script/rbx-a842a4c0f2150d91de0f3a83c79425dc-936530f76f31.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-31T02:14:29.361Z","executes":1196,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:08:07.313Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://media.kocakz.me/1235331c9cef8ea0eb9fc5c2f8967a264a4171e573b4f36dfae765e6872dacd3.webp","original":"https://scriptblox.com/images/sb/rbx-a842a4c0f2150d91de0f3a83c79425dc-936530f76f31.png","scriptblox":"https://scriptblox.com/images/script/rbx-a842a4c0f2150d91de0f3a83c79425dc-936530f76f31.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69548705bee61148678f23b6","editBy":{"_id":"6919ff0e47c8b83f1bcab47b","username":"owlguy17","status":"offline","id":"6919ff0e47c8b83f1bcab47b"},"message":"Create script","createdA