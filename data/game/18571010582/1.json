{"id":18571010582,"name":"Kaizen Battlegrounds","desc":"💥 Battle others in this action-packed game to become the server's strongest!\n\n👍 Join our group to be the FIRST to know about updates: https://www.roblox.com/communities/14502869/Kaizen-Developments#!\n\n💻 Supports Desktop, Mobile, and Tablet players\n\nG - Awakening\nF - Block\nQ - Dash\nB - Emote Wheel\nLeft Click - Punch\n\n⭐ Like and favorite the game; it helps the game grow!\n\nTags: Battleground, The strongest Battleground, Fighting, Recommended, Fun, Anime, Kaizen, Gojo, TSB, jjk","path":"/game/18571010582-kaizen-battlegrounds","slug":"18571010582-kaizen-battlegrounds","thumbnail":{"url":"https://media.kocakz.me/1ac9c431a75a712df808e7a3509df5ad9c3547e889a6e6bb24c8f397d34f76eb.webp","original":"https://tr.rbxcdn.com/180DAY-4890e888c974f7cbca1855363910b12b/150/150/Image/Png/noFilter"},"playing":0,"visitor":2328270,"verified":false,"updatedAt":"2026-02-03T07:51:00.229Z","creator":{"name":"Kaizen Developments","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"6981a8e435987d06cf7f92ce","title":"Kaizen Battleground","game":{"_id":"67e5e1ffb360710ec3c7826f","gameId":18571010582,"name":"Kaizen Battlegrounds","imageUrl":{"url":"https://media.kocakz.me/944646b56b099ce9a6e64d9a8cf4541973c9e5d1982f606b978db351b2cb1c9b.webp","original":"https://scriptblox.com/images/sb/rbx-7b79ee116ecba9a757be8a09409f9a57-7e0469a283ba.png"},"slug":"18571010582-kaizen-battlegrounds","path":"/game/18571010582-kaizen-battlegrounds","thumbnail":{"url":"https://media.kocakz.me/944646b56b099ce9a6e64d9a8cf4541973c9e5d1982f606b978db351b2cb1c9b.webp","original":"https://scriptblox.com/images/sb/rbx-7b79ee116ecba9a757be8a09409f9a57-7e0469a283ba.png"},"placeId":18571010582},"slug":"Kaizen-Battlegrounds-Kaizen-Battleground-100693","verified":false,"key":false,"keyless":false,"views":1732,"executes":61,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/8de70f41038caed69cc8e4ca0db4097c092eb29bd94627c4c52627183dddb7ab.webp","original":"https://scriptblox.com/images/sb/rbx-7b79ee116ecba9a757be8a09409f9a57-7e0469a283ba.png","scriptblox":"https://scriptblox.com/images/script/rbx-7b79ee116ecba9a757be8a09409f9a57-7e0469a283ba.png"},"thumbnail":{"url":"https://media.kocakz.me/8de70f41038caed69cc8e4ca0db4097c092eb29bd94627c4c52627183dddb7ab.webp","original":"https://scriptblox.com/images/sb/rbx-7b79ee116ecba9a757be8a09409f9a57-7e0469a283ba.png","scriptblox":"https://scriptblox.com/images/script/rbx-7b79ee116ecba9a757be8a09409f9a57-7e0469a283ba.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2026-02-03T07:51:00.231Z","updatedAt":"2026-02-03T07:51:00.231Z","lastBump":"2026-02-03T07:51:00.231Z","script":"local player = game.Players.LocalPlayer\nlocal replicated = game:GetService(\"ReplicatedStorage\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal gui = Instance.new(\"ScreenGui\", player.PlayerGui)\ngui.Name = \"TransparentCustomBackpack\"\ngui.ResetOnSpawn = false\n\npcall(function()\ngame:GetService(\"StarterGui\"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)\nend)\n\nlocal main = Instance.new(\"Frame\", gui)\nmain.Size = UDim2.new(0, 620, 0, 60)\nmain.Position = UDim2.new(0.5, -310, 1, -75)\nmain.BackgroundColor3 = Color3.fromRGB(0, 0, 0)\nmain.BackgroundTransparency = 0.5\nmain.BorderSizePixel = 0\n\nlocal corner = Instance.new(\"UICorner\", main)\ncorner.CornerRadius = UDim.new(0, 14)\n\nlocal stroke = Instance.new(\"UIStroke\", main)\nstroke.Color = Color3.fromRGB(255,255,255)\nstroke.Thickness = 1\nstroke.Transparency = 0.6\n\nlocal layout = Instance.new(\"UIListLayout\", main)\nlayout.FillDirection = Enum.FillDirection.Horizontal\nlayout.HorizontalAlignment = Enum.HorizontalAlignment.Center\nlayout.VerticalAlignment = Enum.VerticalAlignment.Center\nlayout.Padding = UDim.new(0, 10)\n\n-- ==========================================\n\nlocal function getDmgValue()\nlocal ls = player:FindFirstChild(\"leaderstats\")\nif ls and ls:FindFirstChild(\"Dmg\") then\n return ls.Dmg.Value\nend\n\nlocal stats = player:FindFirstChild(\"Stats\")\nif stats and stats:FindFirstChild(\"Dmg\") then\n return stats.Dmg.Value\nend\n\nlocal data = player:FindFirstChild(\"Data\")\nif data and data:FindFirstChild(\"Dmg\") then\n return data.Dmg.Value\nend\n\nlocal dmg = player:FindFirstChild(\"Dmg\")\nif dmg and dmg:IsA(\"NumberValue\") then\n return dmg.Value\nend\n\nreturn 0\nend\n\nlocal RedCharge = 0\nlocal MaxCharge = 5\n\nlocal lastDmg = getDmgValue()\nlocal dmgBuffer = 0\n\n-- ==========================================\n\nlocal function AuraSlashFunc()\nfor i = 1, 50 do\n replicated.Remotes.Yuta:FireServer(\"Rampage\")\n task.wait()\nend\nend\n\nlocal function TimeTeleportFunc()\nfor i = 1, 3 do\n replicated.Remotes.Yuta:FireServer(\"Strike\")\n task.wait()\nend\nend\n\nlocal function AtomicFaFunc()\nfor i = 1, 10 do\n replicated.Remotes.Yuta:FireServer(\"Slashes\")\n task.wait()\nend\nend\n\nlocal function LetsMeLoveYouFunc()\nfor i = 1, 10 do\n replicated.Remotes.Yuta:FireServer(\"Heal\")\nend\nend\n\nlocal function RedNukeFunc()\nif RedCharge <= 0 then return end\nRedCharge -= 1\nupdateChargeUI()\ngame:GetService(\"ReplicatedStorage\").Remotes.Combat:FireServer(\"SlamDown\")\nfor i = 1, 50 do\n replicated.Remotes.Gojo:FireServer(\"Red\")\n task.wait()\nend\nend\n\n-- ==========================================\n\nlocal function createSkill(name, callback)\nlocal btn = Instance.new(\"TextButton\", main)\nbtn.Size = UDim2.new(0, 105, 0, 40)\nbtn.Text = name\nbtn.TextScaled = true\nbtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)\nbtn.BackgroundTransparency = 0.35\nbtn.TextColor3 = Color3.fromRGB(255,255,255)\nbtn.BorderSizePixel = 0\n\nlocal c = Instance.new(\"UICorner\", btn)\nc.CornerRadius = UDim.new(0, 10)\n\nlocal s = Instance.new(\"UIStroke\", btn)\ns.Color = Color3.fromRGB(255,255,255)\ns.Thickness = 1\ns.Transparency = 0.6\n\nbtn.MouseButton1Click:Connect(callback)\nreturn btn\nend\n\ncreateSkill(\"Aura Slash [Z]\", AuraSlashFunc)\ncreateSkill(\"Time Teleport [X]\", TimeTeleportFunc)\ncreateSkill(\"Atomic Fa [C]\", AtomicFaFunc)\ncreateSkill(\"Let's Me Love You [V]\", LetsMeLoveYouFunc)\n\nlocal redBtn = createSkill(\"Red Nuke [H]\", RedNukeFunc)\n\n-- ==========================================\n\nlocal chargeText = Instance.new(\"TextLabel\", redBtn)\nchargeText.Size = UDim2.new(1, 0, 0, 22)\nchargeText.Position = UDim2.new(0, 0, -0.6, 0)\nchargeText.BackgroundTransparency = 1\nchargeText.Text = \"0\"\nchargeText.TextScaled = true\nchargeText.TextColor3 = Color3.fromRGB(255, 70, 70)\nchargeText.Font = Enum.Font.GothamBold\nchargeText.TextStrokeTransparency = 0\nchargeText.TextStrokeColor3 = Color3.fromRGB(0,0,0)\n\nfunction updateChargeUI()\nchargeText.Text = tostring(RedCharge)\nend\n\nupdateChargeUI()\n\n-- ==========================================\n\ntask.spawn(function()\nwhile true do\n local current = getDmgValue()\n local delta = current - lastDmg\n\n if delta > 0 then\n dmgBuffer += delta\n\n while dmgBuffer >= 100 do\n  if RedCharge < MaxCharge then\n  RedCharge += 1\n  updateChargeUI()\n  end\n  dmgBuffer -= 100\n end\n end\n\n lastDmg = current\n task.wait(0.15)\nend\nend)\n\n-- ==========================================\n\nUserInputService.InputBegan:Connect(function(input, gp)\nif gp then return end\n\nif input.KeyCode == Enum.KeyCode.Z then\n AuraSlashFunc()\nelseif input.KeyCode == Enum.KeyCode.X then\n TimeTeleportFunc()\nelseif input.KeyCode == Enum.KeyCode.C then\n AtomicFaFunc()\nelseif input.KeyCode == Enum.KeyCode.V then\n LetsMeLoveYouFunc()\nelseif input.KeyCode == Enum.KeyCode.H then\n if RedCharge > 0 then\n RedNukeFunc()\n end\nend\nend)","features":"Kaizen Battleground","tags":["isnone"],"discord":"","keyLink":"","owner":{"_id":"6839a53ef85943d0722f9053","username":"lalanone","verified":false,"pro