airs(backpack:GetChildren()) do\n\t\tif item:IsA(\"Tool\") then\n\t\t\tlocal role = checkTool(item)\n\t\t\tif role then return role end\n\t\tend\n\tend\n\n\treturn \"Inocente\"\nend\n\n\nlocal function getOrCreateHighlight(player)\n\tlocal existing = player.Character:FindFirstChild(\"RoleHighlight\")\n\tif existing then return existing end\n\n\t\n\tlocal highlight = Instance.new(\"Highlight\")\n\thighlight.Name = \"RoleHighlight\"\n\thighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n\thighlight.FillTransparency = 0.45\n\thighlight.OutlineTransparency = 0 \n\thighlight.OutlineColor = Color3.fromRGB(255, 255, 255) -- borda branca visível\n\thighlight.Adornee = player.Character\n\thighlight.Parent = player.Character\n\treturn highlight\nend\n\n\nlocal function updateHighlights()\n\tlocal foundMurder, foundSheriff = false, false\n\tlocal roles = {}\n\n\tfor _, player in pairs(Players:GetPlayers()) do\n\t\tif player ~= localPlayer then\n\t\t\tlocal role = getPlayerRole(player)\n\t\t\troles[player] = role\n\t\t\tif role == \"Murder\" then foundMurder = true end\n\t\t\tif role == \"Sheriff\" then foundSheriff = true end\n\t\tend\n\tend\n\n\tif foundMurder or foundSheriff then\n\t\tfor player, role in pairs(roles) do\n\t\t\tif player.Character then\n\t\t\t\tlocal hl = getOrCreateHighlight(player)\n\t\t\t\tif role == \"Murder\" then\n\t\t\t\t\thl.FillColor = Color3.fromRGB(255, 0, 0)\n\t\t\t\telseif role == \"Sheriff\" then\n\t\t\t\t\thl.FillColor = Color3.fromRGB(0, 0, 255)\n\t\t\t\telse\n\t\t\t\t\thl.FillColor = Color3.fromRGB(0, 255, 0)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\telse\n\n\t\tfor _, player in pairs(Players:GetPlayers()) do\n\t\t\tif player ~= localPlayer and player.Character then\n\t\t\t\tlocal hl = player.Character:FindFirstChild(\"RoleHighlight\")\n\t\t\t\tif hl then hl:Destroy() end\n\t\t\tend\n\t\tend\n\tend\nend\n\n\nRunService.RenderStepped:Connect(updateHighlights)\n\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function()\n\t\twait(1)\n\t\tupdateHighlights()\n\tend)\nend)\n","owner":{"_id":"64cd743296384140753c9eff","username":"ScriptNoKeys","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/f845dbeca8132f860353dbfc59a6068a9626471e1df9e19a01f0c872cafa4f63.webp","original":"https://scriptblox.com/images/photo/64cd743296384140753c9eff-1696279486573.jpg"},"status":"offline","id":"64cd743296384140753c9eff","topMilestone":{"key":"creator.executions","tier":1000000},"profile":{"url":"https://cdn.kocakz.me/images/f845dbeca8132f860353dbfc59a6068a9626471e1df9e19a01f0c872cafa4f63.webp","original":"https://scriptblox.com/images/photo/64cd743296384140753c9eff-1696279486573.jpg"}},"verified":false,"keyLink":"","views":119953,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"unlisted","createdAt":"2023-08-05T05:18:46.474Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/142823291-1691212726448.webp","scriptblox":"https://scriptblox.com/images/script/142823291-1691212726448.webp"},"editBy":{"_id":"64cd743296384140753c9eff","username":"ScriptNoKeys","status":"offline","id":"64cd743296384140753c9eff"},"executes":596,"keyless":false,"indexUnlisted":true,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:26:33.722Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/142823291-1691212726448.webp","scriptblox":"https://scriptblox.com/images/script/142823291-1691212726448.webp"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4bada","editBy":{"_id":"64cd743296384140753c9eff","username":"ScriptNoKeys","status":"offline","id":"64cd743296384140753c9eff"},"message":"Create script","createdAt":"2023-09-18T02:03:07.337Z"},{"_id":