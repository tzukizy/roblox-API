{"id":11380216916,"name":"STAR GLITCHER ~ REVITALIZED","desc":"(WARNING: This game has a lot of flashing lights.)\n\nWelcome to Star Glitcher ~ Revitalized!\n\nYou ventured out into space and came into contact with a weird-looking planet labeled \"Axuremn\". \nNow you're waking up with a star implanted in your chest and glowing wings by your sides.\nThings are quite unpredictable out there.. so be sure to adapt or else you might just lose your mind!\n\n(This game is an experimental non-linear+semi-sandbox RPG/Combat game where you can progress to be stronger from various means, such as fighting bosses found within the game)\nFor extra info on how to play, consult the terminal found in spawn.\n\nCONSOLE/GAMEPAD CONTROLS:\n[Y/Triangle] = M1\n[LT/L2] = Z\n[LB/L1] = X\n[RB/R1] = C\n[RT/R2] = V\n[B/Circle] = Ult \n[X/Square] = Sprint\n[Up] = Taunt\n\n[LeftThumbstick] = Open/Close Mode_Wheel\n[LeftThumbstick/RightThumbstick] = Select Mode\n[Right] = B submode\n[Down] = N submode\n[Left] = M submode","path":"/game/11380216916-star-glitcher-revitalized","slug":"11380216916-star-glitcher-revitalized","thumbnail":{"url":"https://cdn.kocakz.me/images/43a4c56e59f605f64ee595aea8a9e10113f4297983911f694f4ee832d7d378b6.webp","original":"https://tr.rbxcdn.com/180DAY-3101e85eb4c7d97d2aaae334be7c4d06/150/150/Image/Png/noFilter"},"playing":121,"visitor":14598267,"verified":false,"updatedAt":"2026-01-29T14:57:07.323Z","creator":{"name":"Star Glitcher - Revitalized","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"STAR-GLITCHER-~-REVITALIZED-Pt2-sgr-Skins-muisc-BETA-READ-DESC-95058","_id":"697b7543c00de87f03e6f4ba","title":"Pt2 sgr Skins muisc BETA READ DESC","game":{"_id":"691fc12b7a3af28730a93a7f","gameId":11380216916,"name":"STAR GLITCHER ~ REVITALIZED","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":11380216916},"features":"A Part 2 of the other script, you need use the other script because this is just for the skins music\n\nThis is still on beta, because is too much music","tags":[],"script":"--====================================================\n-- SERVICES\n--====================================================\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\n--====================================================\n-- WAIT\n--====================================================\nlocal function safeWait(parent, child)\n\twhile parent and not parent:FindFirstChild(child) do\n\t\tparent.ChildAdded:Wait()\n\tend\n\treturn parent:FindFirstChild(child)\nend\n\n--====================================================\n-- GROOVY\n--====================================================\nlocal playerGui = safeWait(player, \"PlayerGui\")\nlocal groovy = safeWait(playerGui, \"Groovy\")\n\nlocal playerUi = safeWait(playerGui, \"PlayerUi\")\nlocal rightUi = safeWait(playerUi, \"Right\")\nlocal musicLabel = safeWait(rightUi, \"Music\")\n\n--====================================================\n-- SKINS DATA\n--====================================================\nlocal Skins = {\n\t-- MAYHEM\n\tHAM = {Id=125443190466629, Name=\"t+pazolite & getty - Twisted drop party\"},\n\tMAY = {Id=137014398546441, Name=\"Camellia - Spin Eternally\"},\n\tTEST = {Id=13764407822, Name=\"t+pazolite - Cheatreal #TPZREMAKE\"},\n\tMAYHEM2 = {Id=10046618066, Name=\"moro - Folgore\"},\n\tDISORDER = {Id=10648806684, Name=\"m1dy - Mad Speed Disorder\"},\n\tDELUSIVE = {Id=11190425836, Name=\"Bokusatsu Shoujo Koubou - Designer Demon\"},\n\t[\"🅱️AYHEM\"] = {Id=9751367057, Name=\"ReDALICE & CosMo - Angel Halo\"},\n\tZENITH = {Id=106132241467298, Name=\"Azrael - Tune out\"},\n\tSKIN_L0L = {Id=1132772797, Name=\"DJ Striden - Lights\"},\n\tMAYHEMX = {Id=88500969704794, Name=\"Blanke - Immunity\"},\n\tMALEVOLENCE = {Id=118933850264498, Name=\"RoughSketch - MAYHEM (Extreme Full Ver.)\"},\n\tLIMITED = {Id=14400424108, Name=\"gmtn. - trappola bewitching (Extended)\"},\n\t[\"GREEN MAYS AND HEM\"] = {Id=16963357955, Name=\"Zelda Malo Mart\"},\n\tCRISIS = {Id=109283287305953, Name=\"The Sickest Squad - Hard Abuse\"},\n\tDESECRATION = {Id=75332651217744, Name=\"end of the world - explicit massacre over the body of a dead god\"},\n\t[\"MORTEM^2\"] = {Id=11886085333, Name=\"Roughsketch - Ill\"},\n\tMUTILATION = {Id=109024781122281, Name=\"Femtan** -- GIRL HELL 1999\"},\n\n\t-- VIOLENCE\n\tSTRESSED = {Id=9614333818, Name=\"The Quick Brown Fox - Electrohell\"},  \n\t[\"VIOLENCE?\"] = {Id=11749330011, Name=\"Team Grimoire - katahastrophe\"},  \n\tANIMOSITY = {Id=7442711894, Name=\"CANVAS feat.QuimärCarmina (FallenShepard Remix)\"},  \n\tANTAGONIZING = {Id=10099675843, Name=\"Laur - Exitium\"},  \n\tDEVASTATION = {Id=14046308736, Name=\"Big Jim - Voyage To Eternity\"},  \n\tSTRIFE = {Id=99818022733723, Name=\"A-Saph - CLAUDIA ~libertia~\"},  \n\tDYSPATHY = {Id=130109536794469, Name=\"Team Grimoire - Nightmare System\"},  \n\tDISASTER = {Id=140403531765526, Name=\"Ampongabendanitte - СAƊAƲƸⱤƖƇ\"},\n\n\t-- DEATH\n REVENANT = {Id=10099671052, Name=\"Juggernaut. - Revenant\"},  \n\tHARBINGER = {Id=97440480553675, Name=\"Clovis Reyes - ALWAYS DREAMING\"},  \n\tClosure = {Id=94699466301086, Name=\"muyu - Abyssal∴Factory\"},  \n\tCOAGULANT = {Id=12529893922, Name=\"Camellia - Bleed Blood\"},  \n\t  \n\t-- MALICE\n\tPULSE = {Id=122509965090221, Name=\"Quark - Kill Everybody\"},  \n\tHAVOC = {Id=16930390734, Name=\"NeLiME - Code Name: Gamma\"},  \n\tDECAY = {Id=13781396116, Name=\"Nero's Day At Disneyland - Sprawling Idiot Effigy\"},  \n\tDEFECTIVE = {Id=109934719751693, Name=\"Laur - ATAMA WARUI\"},  \n\tFORGOTTEN = {Id=13922497365, Name=\"Nagazaki - Suicide Simulator\"},  \n\tEXECRABLE = {Id=10046618066, Name=\"moro - Folgore\"},  \n\n\t-- MALEVOLENT\n\n\n\t-- VINDICTIVE\n\t\n\n\t-- PURITY\n\tCOMMON = {Id=101463939911764, Name=\"Kaizo Slumbed - Puddle of Nitrogen\"},  \n\tCOMPLEXITY = {Id=11602411545, Name=\"EBIMAYO - Badtek\"},  \n\tCYANIC = {Id=14309861829, Name=\"nuphory - Pearl Blue Soul\"},  \n\tEXCRALISITE = {Id=14381044478, Name=\"Kurokotei - Faurie\"},  \n\tEXQUISITE = {Id=11246398407, Name=\"Camellia - INSECTICIDE (Ext Ver)\"},  \n\tINTEGRIOUS = {Id=11665439078, Name=\"EBIMAYO - Ocean Abyss\"},  \n\tINTEGRIOUS2 = {Id=12775778039, Name=\"Akamasumi - Ressurection\"},  \n\tINVERSA = {Id=117422908285148, Name=\"Dj Kuroneko - I don't\"},  \n\tPOSTERITY = {Id=112545501536999, Name=\"fen - deep blue sunrise\"},  \n\tPULARY = {Id=13551323798, Name=\"Under Night In-Birth - Purity & Strictly\"},  \n\tPURIFIED = {Id=14400233209, Name=\"Kurokotei - Lussamine in a Perfect World\"},  \n\tPURITYX = {Id=126553820316661, Name=\"Black Sun Empire - Parallels\"},  \n\tSALUBRITY = {Id=10962236341, Name=\"FtlFrame - Speech Disorder\"},  \n\tSERENITY_JDR = {Id=78236039262842, Name=\"ENNWAY! - EDENIC WHISPERS\"},  \n\tTRANAXAS = {Id=10363574580, Name=\"TRAELMYX - Neon Island B-Side\"},  \n\n\t-- SANCTUARY\n\tSUSTAINABILITY = {Id=11907415829, Name=\"Camellia - Newspapers for Magicians\"},  \n\tHAVEN = {Id=7028518546, Name=\"Protostar - New Horizons\"},  \n\tSALVATION = {Id=81335699182106, Name=\"Yooh - Salvation\"},  \n\tANGELIC = {Id=133011586497796, Name=\"Clovis Reyes - Fluxxwave\"},  \n\n\t-- SHD\n}\n\n--====================================================\n-- PLAYER DATA\n--====================================================\nlocal Saving = safeWait(workspace, \"Saving\")\nlocal PlayerData = safeWait(Saving, player.Name .. \"'s Data\")\nlocal ModeData = safeWait(PlayerData, \"ModeData\")\n\nlocal Entities = safeWait(workspace, \"Entities\")\nlocal Entity = safeWait(Entities, player.Name)\nlocal Simulator = safeWait(Entity, \"NeonWingSimulator\")\nlocal SideValue = safeWait(Simulator, \"Side\")\nlocal ModeValue = safeWait(Simulator, \"Mode\")\n\n--====================================================\n-- SKON\n--====================================================\nlocal function getCurrentSkin()\n\tlocal sideFolder = ModeData:FindFirstChild(SideValue.Value)\n\tif not sideFolder then return nil end\n\n\tlocal modeFolder = sideFolder:FindFirstChild(ModeValue.Value)\n\tif not modeFolder then return nil end\n\n\tlocal skinValue = modeFolder:FindFirstChild(\"SkinEquipped\")\n\tif not skinValue then return nil end\n\n\treturn skinValue\nend\n\n--====================================================\n-- BEATBOX\n--====================================================\nlocal function updateMusic()\n\tlocal skinValue = getCurrentSkin()\n\tif not skinValue then return end\n\n\tif skinValue.Value == \"\" then\n\t\treturn\n\tend\n\n\tlocal data = Skins[skinValue.Value]\n\tif not data then return end\n\n\tlocal newId = \"rbxassetid://\" .. data.Id\n\tif groovy.SoundId ~= newId then\n\t\tmusicLabel.Text = data.Name\n\t\tgroovy:Stop()\n\t\tgroovy.SoundId = newId\n\t\tgroovy:Play()\n\tend\nend\n\n--====================================================\n-- INITIAL\n--====================================================\nupdateMusic()\n\n--====================================================\n-- LISTENERS\n--====================================================\nModeValue:GetPropertyChangedSignal(\"Value\"):Connect(updateMusic)\nSideValue:GetPropertyChangedSignal(\"Value\"):Connect(updateMusic)\n\nlocal function bindSkinListener()\n\tlocal skinValue = getCurrentSkin()\n\tif skinValue then\n\t\tskinValue:GetPropertyChangedSignal(\"Value\"):Connect(updateMusic)\n\tend\nend\n\nbindSkinListener()\nModeValue:GetPropertyChangedSignal(\"Value\"):Connect(bindSkinListener)\nSideValue:GetPropertyChangedSignal(\"Value\"):Connect(bindSkinListener)\n","owner":{"_id":"696599ea8dddd1f8e4ea28ae","username":"IHateAll","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"696599ea8dddd1f8e4ea28ae","topMilestone":{"key":"creator.fir