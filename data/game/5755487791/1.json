{"id":5755487791,"name":"Tower of Easy","desc":"✅ Welcome to Tower of Easy, the most easy tower game on Roblox! ✅\n\n🌟 Play over 350+ unique EASY stages!\n\n🎯 Unlock over TONS of UNIQUE pets!\n\n💾 Your progress will save AUTOMATICALLY!\n\n🏆 Get FREE coins for staying in the game, inviting friends, & from daily login streaks!\n\n🔒 Play in our FREE private servers!\n\nThis game is inspired by Tower of Hell and made by ToH fans.\n\nReach the top of the tower made of randomly generated stages before the clock runs out. Earn coins to purchase gears and server effects in the shop, and level up to climb your way up the leaderboard.","path":"/game/5755487791-tower-of-easy","slug":"5755487791-tower-of-easy","thumbnail":{"url":"https://cdn.kocakz.me/images/44c34c44accd608bbac884867d8a7a21e7b010226cfa3404872d82cdcc2ba324.webp","original":"https://tr.rbxcdn.com/180DAY-fe0cf2d98aa0dcced6deff449746d08b/150/150/Image/Png/noFilter"},"playing":0,"visitor":140857273,"verified":false,"updatedAt":"2023-09-10T06:03:55.386Z","creator":{"name":"SAIL STUDIO","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Tower-of-Easy-Get-INF-Coins-And-Tp-To-End-7768","_id":"64fd5c4be3e334bf0f6402c9","title":"Get INF Coins And Tp To End","game":{"_id":"67e5e1ffb360710ec3c78a3b","gameId":5755487791,"name":"Tower of Easy","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":5755487791},"features":"This script is insparation from: https://www.roblox.com/games/5755487791/Tower-of-Easy\n\nI just put it into a UiLib, with some more features!","tags":["roblox","tower","of","easy","script"],"script":"local WallyLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/wall%20v3')))()\n\nlocal Window = WallyLib:CreateWindow(\"Tower Of Easy OP\")\nlocal Folder = Window:CreateFolder(\"Main\")\n\nlocal enteredCoins = \"0\" -- Default value\n\nFolder:Box(\"Coins Amount To Get)\", enteredCoins, function(coinsValue)\n    enteredCoins = coinsValue\nend)\n\nFolder:Button(\"Button\", function()\n    local args = {\n        [1] = enteredCoins\n    }\n    game:GetService(\"ReplicatedStorage\"):WaitForChild(\"GrantCoins\"):InvokeServer(unpack(args))\nend)\n\nFolder:Button(\"Teleport To End\", function()\n    local player = game.Players.LocalPlayer\n\nif player and player.Character then\n    local humanoidRootPart = player.Character:FindFirstChild(\"HumanoidRootPart\")\n    if humanoidRootPart then\n        humanoidRootPart.CFrame = CFrame.new(77.6506348, 231.599915, 61.626442, -0.0347697996, -6.48372449e-08, -0.99939537, -6.84762824e-08, 1, -6.24941237e-08, 0.99939537, 6.62619755e-08, -0.0347697996)  -- This sets the CFrame to the origin (0, 0, 0)\n        print(\"CFrame set to new position!\")\n    else\n        warn(\"HumanoidRootPart not found!\")\n    end\nelse\n    warn(\"Player or Character not found!\")\nend\nend)","owner":{"_id":"64e89c00d8624d277b1b0fab","username":"EviIAlienWare","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"64e89c00d8624d277b1b0fab","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"keyLink":"","views":10076,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2023-09-10T06:03:55.386Z","dislikeCount":0,"likeCount":2,"image":{"url":"https://cdn.kocakz.me/images/34ed2e669ef303f68b0abf9d5d0e149e0d678ab1c1f4a289c59856de5648bcac.webp","original":"https://scriptblox.com/images/sb/5755487791-1694325835296.webp","scriptblox":"https://scriptblox.com/images/script/5755487791-1694325835296.webp"},"executes":4,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":