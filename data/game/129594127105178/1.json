{"id":129594127105178,"name":"Retro Mechanics [BETA]","desc":"Welcome to Retro Mecanica!\n\nThis game takes you directly to the past, to the 1970s, in Argentina, where you will experience the mechanics of vehicles in their highest splendor. Buy used cars, restore them, resell them, race with them, visit the race track and break records!\n\nTracks aren't your thing? The drag strip is waiting for you, with the best racing you'll find!\nWhat you want is high speed? You have the oval track at your disposal, where every lap is pedal to the metal!\nWould you rather go quiet? You can simply repair a used car and stroll around the countryside.","path":"/game/129594127105178-retro-mechanics","slug":"129594127105178-retro-mechanics","thumbnail":{"url":"https://media.kocakz.me/b7fada921f0f12881ebe8153119607e2489f302944c6d431e5b6378edc48157d.webp","original":"https://tr.rbxcdn.com/180DAY-3f74e7a6838f9ab1d9a10e07ad5b269a/150/150/Image/Png/noFilter"},"playing":22,"visitor":1214977,"verified":false,"updatedAt":"2026-03-23T02:31:39.063Z","creator":{"name":"Retro Mech Devs","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"69c0a60b72bf5061d0646ec3","title":"Autofarm v1","game":{"_id":"69c0a502a85209565a09bf14","gameId":129594127105178,"name":"Retro Mechanics [BETA]","imageUrl":{"url":"https://media.kocakz.me/beed6f4f02b0a9a5a4bd7838a753b16a91a4360063050b64cccf99d0ffd0bfcc.webp","original":"https://scriptblox.com/images/sb/rbx-c723d259b96e5b9d103d1c59c7b420e2-18a31781a610.png"},"slug":"129594127105178-retro-mechanics","path":"/game/129594127105178-retro-mechanics","thumbnail":{"url":"https://media.kocakz.me/beed6f4f02b0a9a5a4bd7838a753b16a91a4360063050b64cccf99d0ffd0bfcc.webp","original":"https://scriptblox.com/images/sb/rbx-c723d259b96e5b9d103d1c59c7b420e2-18a31781a610.png"},"placeId":129594127105178},"slug":"Retro-Mechanics-BETA-Autofarm-v1-143730","verified":false,"key":false,"keyless"