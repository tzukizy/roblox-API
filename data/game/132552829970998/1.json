calPlayer.Character\nlocal playerGui = localPlayer.PlayerGui\nlocal teleportService = game:GetService(\"TeleportService\")\nlocal userInputService = game:GetService(\"UserInputService\")\nlocal virtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal runService = game:GetService(\"RunService\")\nlocal replicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal guiService = game:GetService(\"GuiService\")\nlocal tweenService = game:GetService(\"TweenService\")\nlocal httpService = game:GetService(\"HttpService\")\nlocal placeId = game.PlaceId\nlocal coreGui = game:GetService(\"CoreGui\")\nlocal currentCamera = workspace.CurrentCamera\nlocal keyCode = Enum.KeyCode\nlocal instanceNew = Instance.new\nlocal uDim2New = UDim2.new\nlocal vector2New = Vector2.new\nlocal vector3New = Vector3.new\nlocal color3New = Color3.new\nlocal cFrameNew = CFrame.new\n\nrunService.RenderStepped:Connect(function(delta)\n    character = localPlayer.Character\n    for _,v in workspace:GetChildren() do\n        if v:FindFirstChild(\"MineHuman\") and not players:FindFirstChild(v.Name) and character:FindFirstChild(\"Scrap Pickaxe\")then\n            character[\"Scrap Pickaxe\"].RemoteFunction:InvokeServer(\"hit\",{v.MineHuman,1000000000000})\n        end\n    end\nend)\n","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"keyLink":"","views":5981,"scriptType":"free","is