ld(\"HumanoidRootPart\") then return end\n    local closest, closestDist = nil, 20\n    for _, player in pairs(Players:GetPlayers()) do\n        local char = player.Character\n        if player ~= LocalPlayer and char and char:FindFirstChild(\"HumanoidRootPart\") then\n            local dist = (char.HumanoidRootPart.Position - lpChar.HumanoidRootPart.Position).Magnitude\n            if dist <= closestDist then\n                closestDist = dist\n                closest = player\n            end\n        end\n    end\n    return closest\nend\nRunService.RenderStepped:Connect(function()\n    if _G.AutoSlap then\n        local target = getClosestPlayer()\n        if target then\n            getSlap():InvokeServer(target, Vector3.new(1,0,1))\n        end\n    end\nend)","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"},"lvl":18,"status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://cdn.kocakz.me/images/c40e8b292c0598c106e040ee8c018c2903788bd5d24c52ab14a5ed80362e86f6.webp","original":"https://scriptblox.com/images/photo/665152598dd22f2885e42ceb-1770235984127.png"}},"verified":false,"views":14805,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/451384d35d91e2cc10d1dd5e0651e63972f83c15fb85b7da7c8325b861c9c4e6.webp","original":"https://scriptblox.com/images/sb/rbx-bfa4bf9f1e295c53b0886026bd07d9d6-1c6cdb10d8f4.png","scriptblox":"https://scriptblox.com/images/script/rbx-bfa4bf9f1e295c53b0886026bd07d9d6-1c6cdb10d8f4.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2025-09-24T19:35:04.286Z","discord":"https://discord.gg/UFC4RJCfUx","executes":1104,"keyless":