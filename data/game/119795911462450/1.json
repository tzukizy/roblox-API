{"id":119795911462450,"name":"Steal a SpongeBob","desc":"","path":"/game/119795911462450-steal-a-spongebob","slug":"119795911462450-steal-a-spongebob","thumbnail":["https://tr.rbxcdn.com/180DAY-9430fb851c23a8e42c31f8cb8a5cd680/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-bfa4bf9f1e295c53b0886026bd07d9d6/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":235,"visitor":0,"verified":false,"updatedAt":"2025-09-24T19:35:04.285Z","creator":{"name":"Roblox","type":"User"},"script":{"count":2,"freeCount":2,"keyCount":1,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Steal-a-SpongeBob-Slap-Aura-54718","_id":"68d447e8abe6f485a9165df9","title":"Slap Aura","game":{"_id":"6899af4a0f1b7793afff31b2","gameId":119795911462450,"name":"Steal a SpongeBob","imageUrl":"/images/sb/rbx-bfa4bf9f1e295c53b0886026bd07d9d6-1c6cdb10d8f4.png","placeId":119795911462450},"features":"# Open Source\n\nFeatures:\nAutomatically slap someone or prevent them from getting up!","tags":[],"script":"_G.AutoSlap = true\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal function getSlap()\n    return LocalPlayer.Character:WaitForChild(\"SLAPtula\"):WaitForChild(\"SlapTool_Comm\"):WaitForChild(\"RF\"):WaitForChild(\"Slap\")\nend\nlocal function getClosestPlayer()\n    local lpChar = LocalPlayer.Character\n    if not lpChar or not lpChar:FindFirstChild(\"HumanoidRootPart\") then return end\n    local closest, closestDist = nil, 20\n    for _, player in pairs(Players:GetPlayers()) do\n        local char = player.Character\n        if player ~= LocalPlayer and char and char:FindFirstChild(\"HumanoidRootPart\") then\n            local dist = (char.HumanoidRootPart.Position - lpChar.HumanoidRootPart.Position).Magnitude\n            if dist <= closestDist then\n                closestDist = dist\n                closest = player\n            end\n        end\n    end\n    return closest\nend\nRunService.RenderStepped:Connect(function()\n    if _G.AutoSlap then\n        local target = getClosestPlayer()\n        if target then\n            getSlap():InvokeServer(target, Vector3.new(1,0,1))\n        end\n    end\nend)","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":"/images/photo/665152598dd22f2885e42ceb-1770235984127.png","status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":14789,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-bfa4bf9f1e295c53b0886026bd07d9d6-1c6cdb10d8f4.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-09-24T19:35:04.286Z","discord":"https://discord.gg/UFC4RJCfUx","executes":1066,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68d447e8abe6f485a9165dfb","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Yeah","createdAt":"2025-09-24T19:35:04.291Z"}],"comments":[]},{"slug":"Steal-a-SpongeBob-Bloxify-Hub-X-Steal-A-Spongebob-48756","_id":"68a009736bc1e6d14cfd3ef6","title":"Bloxify Hub X","game":{"_id":"6899af4a0f1b7793afff31b2","gameId":119795911462450,"name":"Steal a SpongeBob","imageUrl":"/images/sb/rbx-bfa4bf9f1e295c53b0886026bd07d9d6-1c6cdb10d8f4.png","placeId":119795911462450},"features":"STEAL A SPONGEBOB\n\nOP SCRIPT\n\nJOIN DISCORD FOR MORE","tags":["roblox","op","script","game","steal"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/vxperity/Bloxify/refs/heads/main/loader.lua\"))()","owner":{"_id":"6869e94072e8e01d00377ec5","username":"bloxify","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6869e94072e8e01d00377ec5","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"discord":"https://discord