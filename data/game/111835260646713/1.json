acter:FindFirstChild(\"HumanoidRootPart\")\n            if root then\n                if _G.HitboxEnabled then\n                    root.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)\n                    root.Transparency = _G.HitboxTransp\n                    root.Color = Color3.fromRGB(255, 0, 0)\n                    root.Material = Enum.Material.Neon\n                    root.CanCollide = false\n                else\n                    root.Size = Vector3.new(2, 2, 1)\n                    root.Transparency = 0\n                end\n            end\n        end\n    end\nend)\n","features":"Simple hitbox expander\nMade with ai btw","tags":["Hitbox","GBRF","Simple"],"discord":"","keyLink":"","owner":{"_id":"690c044ff412504e129b9b35","username":"Lei777","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"690c044ff412504e129b9b35","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-23T02:30:31.570Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69ec2912ff5116ed5bbfdbcd","editBy":{"_id":"690c044ff412504e129b9b35","username":"Lei777","status":"offline","id":"690c044ff412504e129b9b35"},"message":"Create script","createdAt":"2026-04-25T02:38:10.945Z"}],"comments":[{"_id":"6a434d02f128255ffdf86d7e","commentBy":{"_id":"669aae8a6573efd3b9432840","username":"Sus_piciousMan","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/da63f53671c6232375e0ddbe59fc32c4b7a48628fb4034fdc8aa9966fbc23b72.webp","original":"https://scriptblox.com/images/photo/669aae8a6573efd3b9432840-1753825106886.jpg"},"createdAt":"2024-07-19T18:20:58.715Z","lastActive":"2026-09-13T1