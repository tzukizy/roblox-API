a\")\n    local remote = game.ReplicatedStorage.Assets.Remotes.Hit\n\n    for _, target in pairs(game.Players:GetPlayers()) do\n        if target ~= player then\n            local humanoid = target.Character and target.Character:FindFirstChild(\"Humanoid\")\n            if humanoid then\n                remote:FireServer(weapon, humanoid, 2)\n            end\n        end\n    end\nend","owner":{"_id":"68a06dc42c8d3af45a271e43","username":"18654","verified":false,"profilePicture":"/images/photo/68a06dc42c8d3af45a271e43-1787573654688.jpg","status":"offline","id":"68a06dc42c8d3af45a271e43","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":3457,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/111835260646713-1768886223047.png","likeCount":2,"dislikeCount":1,"createdAt":"2026-01-20T05:17:03.088Z","executes":817,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"696f0fcfc2959559a8c545a7","editBy":{"_id":"68a06dc42c8d3af45a271e43","username":"18654","status":"offline","id":"68a06dc42c8d3af45a271e43"},"message":"Create script","createdAt":"2026-01-20T05:17:03.090Z"}],"comments":[{"_id":"696f101cac00f0bb1f862006","commentBy":{"_id":"68a06dc42c8d3af45a271e43","username":"18654","verified":false,"role":"user","profilePicture":"/images/photo/68a06dc42c8d3af45a271e43-1787573654688.jpg","createdAt":"2025-08-16T11:38:44.404Z","lastActive":"2026-09-13T03:26:56.905Z","status":"offline","id":"68a06dc42c8d3af45a271e43","topMilestone":{"key":"creator.executions","tier":10000}},"text":"W script❤️","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-01-20T05:18:20.790Z","liked":false,"disliked":false},{"_id":"696f10234f257b2fddce32c2","commentBy":{"_id":"68a06dc42c8d3af45a271e43","username":"18654","verified":false,"role":"user","profilePicture":"/images/photo/68a06dc42c8d3af45a271e43-1787573654688.jpg","createdAt":"2025-08-16T11:38:44.404Z","