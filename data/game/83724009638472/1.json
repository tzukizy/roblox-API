{"id":83724009638472,"name":"Become an scp [Event + 3x Kills!]","desc":"CONSOLE : R1 - Switch tools | R2 - Shoot | R1 - AIM\nThis game was released pretty recently so expect bugs, maybe alot.\nAvailable Scps : Scp 096, 457, 076, 106, 173, 966, 049.\nThis game is inspired by Scp Retrobreach and Scp Roleplay\nHOW TO PLAY\nYou will spawn in as a guard, your objective is to kill SCPS. every second you play your chances of becoming an scp increases.\nEvery 4 people in server (Spectators don't count) Will be selected as an scp!\n\nScp containment breach","path":"/game/83724009638472-become-an-scp","slug":"83724009638472-become-an-scp","thumbnail":{"url":"https://media.kocakz.me/a3941f73fa4310119ad3acdf7288323eed622e7379d8a1854487b5e868d70dbb.webp","original":"https://tr.rbxcdn.com/180DAY-1ba2e3b847d28eafff574356c33a1021/150/150/Image/Png/noFilter"},"playing":0,"visitor":1183214,"verified":false,"updatedAt":"2026-04-11T01:52:36.952Z","creator":{"name":"Azeroances Games","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Become-an-scp-Event-+-3x-Kills!-Get-all-Tools-But-May-not-work-at-all-205244","_id":"69d9a964a16e0215924f5ca5","title":"Get all Tools But May not work at all","game":{"_id":"69d9a964a16e0215924f5ca2","gameId":83724009638472,"name":"Become an scp [Event + 3x Kills!]","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":83724009638472},"features":"This script give you all tools but Sadly Not work at All\n\n(Still W.I.P)\n\nAnd I trying to bypass it","tags":["Tools"],"script":"game.StarterGui:SetCore(\"SendNotification\", {\n    Title = \"Get All Tool\";\n    Text = \"I still find a way to bypass The Tool, May not work at all\";\n    Icon = \"rbxassetid://6031075938\";\n    Duration = 100;\n    Button1 = \"Thanks\";      \n    Button2 = \"Ok I will wait\";        \n    Callback = callback;        \n})\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Players = game:GetService(\"Players\")\n\nlocal toolsFolder = ReplicatedStorage:WaitForChild(\"Tools\")\n\n\nlocal function giveToolsToPlayer(player)\n\tlocal backpack = player:WaitForChild(\"Backpack\")\n\t\n\tfor _, tool in ipairs(toolsFolder:GetChildren()) do\n\t\tif tool:IsA(\"Tool\") then\n\t\t\ttool:Clone().Parent = backpack\n\t\tend\n\tend\nend\n\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function()\n\t\ttask.wait(0.5) \n\t\tgiveToolsToPlayer(player)\n\tend)\n\t\n\t\n\tif player.Character then\n\t\ttask.wait(0.5)\n\t\tgiveToolsToPlayer(player)\n\tend\nend)\n\n\nfor _, player in ipairs(Players:GetPlayers()) do\n\tif player.Character then\n\t\ttask.wait(0.5)\n\t\tgiveToolsToPlayer(player)\n\tend\nend","owner":{"_id":"69369d525d930bd43fc1cb5f","username":"Scripterblabla","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6a9b2a21cf549984c4d308dd5f6908b0b05b0ea170cfd6dba70fcfb4fb888a84.webp","original":"https://scriptblox.com/images/photo/69369d525d930bd43fc1cb5f-1784338560695.png"},"lvl":11,"status":"offline","id":"69369d525d930bd43fc1cb5f","topMilestone":{"key":"creator.executions","tier":100000},"profile":{"url":"https://media.kocakz.me/6a9b2a21cf549984c4d308dd5f6908b0b05b0ea170cfd6dba70fcfb4fb888a84.webp","original":"https://scriptblox.com/images/photo/69369d525d930bd43fc1cb5f-1784338560695.png"}},"verified":false,"views":1565,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/24d5e021a3cf5f81f63e4259c17448bed7b118467ad4f469b4c749852e497bff.webp","original":"https://scriptblox.com/images/sb/83724009638472-1775872546192.png","scriptblox":"https://scriptblox.com/images/script/83724009638472-1775872546192.png"},"likeCount":4,"dislikeCount":0,"createdAt":"2026-04-11T01:52:36.955Z","keyLink":"","executes":196,"keyless":false,"liked":false,"disl