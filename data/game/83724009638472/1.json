ct(function()\n\t\ttask.wait(0.5) \n\t\tgiveToolsToPlayer(player)\n\tend)\n\t\n\t\n\tif player.Character then\n\t\ttask.wait(0.5)\n\t\tgiveToolsToPlayer(player)\n\tend\nend)\n\n\nfor _, player in ipairs(Players:GetPlayers()) do\n\tif player.Character then\n\t\ttask.wait(0.5)\n\t\tgiveToolsToPlayer(player)\n\tend\nend","owner":{"_id":"69369d525d930bd43fc1cb5f","username":"Scripterblabla","verified":false,"profilePicture":"/images/photo/69369d525d930bd43fc1cb5f-1784338560695.png","status":"offline","id":"69369d525d930bd43fc1cb5f","topMilestone":{"key":"creator.executions","tier":100000}},"verified":false,"views":1536,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/83724009638472-1775872546192.png","likeCount":4,"dislikeCount":0,"createdAt":"2026-04-11T01:52:36.955Z","keyLink":"","executes":184,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d9a964a16e0215924f5ca8","editBy":{"_id":"69369d525d930bd43fc1cb5f","username":"Scripterblabla","status":"offline","id":"69369d525d930bd43fc1cb5f"},"message":"Create script","createdAt":"2026-04-11T01:52:36.958Z"}],"comments":[{"_id":"69ea52845d34dda1c43a490a","commentBy":{"_id":"69bdb9dfcb0ac45a12dbbfb0","username":"OwenPlayzRoblox","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-04-29T20:25:56.554Z","createdAt":"2026-03-20T21:19:27.426Z","status":"offline","id":"69bdb9dfcb0ac45a12dbbfb0"},"text":"IT WORKS","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-04-23T17:10:28.499Z","liked":false,"disliked":false},{"_id":"6a01bdbd92bc2dedbee616ee","commentBy":{"_id":"69eb03326b5843e2d6f87300","username":"Andrei_23","verified":false,"role":"user","profilePicture":"/images/photo/69eb03326b5843e2d6f87300-1777009515548.jpg","lastActive":"2026-05-21T04:33:05.578Z","createdAt":"2026-04-24T05:44:18.881Z","status":"offline","id":"69eb03326b5843e2d6f87300","topMilestone":{"key":"c