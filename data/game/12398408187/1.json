{"id":12398408187,"name":"Vyasa","desc":"Vyasa is canceled, y u guys still playing [insert crying emoji]\n\nVyasa is an RPG game made with droplets rpg kit and heavily modified by Veennoid, with the help of YoiYai for doing the maps.\n\nIn Vyasa, you will use your Weapons, Abilities, and Passives to defeat Enemies to get rewards, and continue to sail to different islands.\n\nVyasa's world is made of many different islands.  Your mission is to conquer those islands and become the strongest captain there is!\n\n[This is our first project]","path":"/game/12398408187-vyasa","slug":"12398408187-vyasa","thumbnail":{"url":"https://media.kocakz.me/ab6ef0dfbc005bf8018bd01980f1c8383dd26d52aa0807f2c1a4c328d8981aac.webp","original":"https://tr.rbxcdn.com/180DAY-9ddb956bc1be0e763191239a27445491/150/150/Image/Png/noFilter"},"playing":0,"visitor":429737,"verified":false,"updatedAt":"2024-09-03T06:10:57.302Z","creator":{"name":"VY BOX","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"66d6a871546813bad9eb304e","title":"kill all mobs ok nerd","game":{"_id":"67e5e1ffb360710ec3c78b64","gameId":12398408187,"name":"Vyasa","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"12398408187-vyasa","path":"/game/12398408187-vyasa","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":12398408187},"slug":"Vyasa-kill-all-mobs-ok-nerd-17870","verified":false,"key":false,"keyless":false,"views":59238,"executes":27,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/5ad10bf74a72483575feea1dee7ce1cb/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5ad10bf74a72483575feea1dee7ce1cb/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/5ad10bf74a72483575feea1dee7ce1cb/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5ad10bf74a72483575feea1dee7ce1cb/500/280/Image/Jpeg"},"likeCount":4,"dislikeCount":1,"createdAt":"2024-09-03T06:10:57.302Z","updatedAt":"2024-09-03T06:10:57.302Z","lastBump":"2024-09-03T06:10:57.302Z","script":"\nlocal mobsFolder = workspace:WaitForChild(\"Mobs\")\n\n\nlocal damageEvent = game:GetService(\"ReplicatedStorage\"):WaitForChild(\"GameRemotes\"):WaitForChild(\"DamageEvent\")\n\nwhile true do\n\n    local mobs = mobsFolder:GetChildren()\n\n    for i = 1, #mobs, 2 do\n        local mob = mobs[i]\n\n        if mob:FindFirstChild(\"Torso\") and mob:FindFirstChild(\"Enemy\") then\n\n            local args = {\n                [1] = mob:WaitForChild(\"Torso\"),\n                [2] = mob:WaitForChild(\"Enemy\")\n            }\n            \n\n            damageEvent:FireServer(unpack(args))\n        end\n    end\n\n\n    wait(0.1) \nend\n","features":"title u blind orrr , move arounds island to spawn the mobs","tags":[],"discord":"","keyLink":"","owner":{"_id":"660aed3f3ac90cfbaaa0ef0f","username":"tiam","verified":false,"profilePicture":{"url":"https://media.kocakz.me/d4fac5d01733ece9f2b1571cf0fc05534c14a2defe143e16cc8ada5462600635.webp","original":"https://scriptblox.com/images/photo/660aed3f3ac90cfbaaa0ef0f-1717016771142.png"},"status":"offline","id":"660aed3f3ac90cfbaaa0ef0f","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/d4fac5d01733ece9f2b1571cf0fc05534c14a2defe143e16cc8ada5462600635.webp","original":"https://scriptblox.com/images/photo/660aed3f3ac90cfbaaa0ef0f-1717016771142.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-24T02:57:39.994Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e6b360710ec3c51f4c","editBy":{"_id":"660aed3f3ac9