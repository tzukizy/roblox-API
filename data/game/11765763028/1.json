          local Head = NPC:FindFirstChild(\"Head\")\n            if not Head then continue end\n\n            local Humanoid = NPC:FindFirstChildOfClass(\"Humanoid\")\n            if not Humanoid or Humanoid.Health <= 0 then continue end\n\n            Fired:FireServer()\n            RegisterHit:FireServer(\n                {{\n                    amount = 9e9,\n                    target = NPC,\n                    is_friendly = false,\n                    part = Head,\n                    cast_results = nil\n                }},\n                {{\n                    normal = Vector3.new(0,0,0),\n                    part = Head,\n                    distance = 0,\n                    material = Enum.Material.Plastic,\n                    pos = Head.Position\n                }}\n            )\n        end\n    end\nend","features":"-Free\n-OP\n-Kill All Zombie\n-Auto Kill All Zombie\n-Open Source\n-Enjoy","tags":["kill all","free","op","keyless","kill aura"],"discord":"","keyLink":"","owner":{"_id":"6a3c3b0bff01c65a89f1c044","username":"imnotcheatingdude68","verified":false,"profilePicture":{"url":"https://media.kocakz.me/12d902a22e1f7562cbf9ca741bfaa9923d1cb42d2c9b03967df358190c7b5743.webp","original":"https://scriptblox.com/images/photo/6a3c3b0bff01c65a89f1c044-1784115626655.png"},"status":"offline","id":"6a3c3b0bff01c65a89f1c044","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/12d902a22e1f7562cbf9ca741bfaa9923d1cb42d2c9b03967df358190c7b5743.webp","original":"https://scriptblox.com/images/photo/6a3c3b0bff01c65a89f1c044-1784115626655.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T17:19:00.571Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a57712d654b8494cf430b7d","editBy":{"_id":"6a3c3b0bff01c65a89f1c044","username":"imn