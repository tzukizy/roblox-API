sion started...\")\n\tfor i = IntermissionLength, 1, -1 do\n\t\tprint(\"Match starting in: \" .. i)\n\t\ttask.wait(1)\n\tend\n\n\t-- 2. Start the Match\n\tGameActive = true\n\tprint(\"The Battle Begins!\")\n\t\n\t-- Logic to teleport players to the arena would go here\n\t\n\tfor i = MatchLength, 1, -1 do\n\t\tif not GameActive then break end -- Exit early if everyone dies\n\t\tprint(\"Time remaining: \" .. i)\n\t\ttask.wait(1)\n\tend\n\n\t-- 3. End the Match\n\tGameActive = false\n\tprint(\"Match Over! Returning to lobby.\")\n\t\n\t-- Logic to clean up the arena and reward the winner goes here\n\t\n\ttask.wait(5) -- Short pause before the next intermission\nend\n","owner":{"_id":"65350b0d6b8c3b15d54ddb7d","username":"Adammohamedgamal27","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"65350b0d6b8c3b15d54ddb7d","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":4014,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/122593073500987-1769952872201.png","likeCount":0,"dislikeCount":1,"createdAt":"2026-02-01T13:34:32.225Z","executes":492,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"697f566892a480228442caf5","editBy":{"_id":"65350b0d6b8c3b15d54ddb7d","username":"Adammohamedgamal27","status":"offline","id":"65350b0d6b8c3b15d54ddb7d"},"message":"Battle minigames","createdAt":"2026-02-01T13:34:32.227Z"}],"comments":[{"_id":"697f567728b1bd57abafb7fd","commentBy":{"_id":"65350b0d6b8c3b15d54ddb7d","username":"Adammohamedgamal27","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"2023-10-22T11:44:13.766Z","lastActive":"2026-02-01T13:43:50.492Z","status":"offline","id":"65350b0d6b8c3b15d54ddb7d","topMilestone":{"key":"creator.first_script","tier":1}},"text":"Hi","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-01T13:34:47.063Z","liked":false,"disliked":f