my.HumanoidRootPart)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\treturn enemies\nend\n\nlocal function run(character)\n\tlocal root = character:WaitForChild(\"HumanoidRootPart\")\n\n\twhile character.Parent do\n\t\tif auraEnabled then\n\t\t\tlocal enemies = getEnemiesInRange(root)\n\n\t\t\tfor _, enemyRoot in ipairs(enemies) do\n\t\t\t\tlocal args = { enemyRoot.Position }\n\n\t\t\t\tfor _, remote in ipairs(projectileRemotes) do\n\t\t\t\t\tremote:FireServer(unpack(args))\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\ttask.wait(fireRate)\n\tend\nend\n\nif player.Character then\n\ttask.spawn(run, player.Character)\nend\n\nplayer.CharacterAdded:Connect(function(char)\n\ttask.wait(1)\n\ttask.spawn(run, char)\nend)","owner":{"_id":"698e81e93384bf4618026322","username":"Rob666","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/b5b9de4edf25e302732a4b1f34ad93c9345fb87c99dfc009abe59f4e15e145af.webp","original":"https://scriptblox.com/images/photo/698e81e93384bf4618026322-1776646233535.png"},"status":"offline","id":"698e81e93384bf4618026322","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/b5b9de4edf25e302732a4b1f34ad93c9345fb87c99dfc009abe59f4e15e145af.webp","original":"https://scriptblox.com/images/photo/698e81e93384bf4618026322-1776646233535.png"}},"verified":false,"views":4356,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/1ddb6bb9c1bcf9984ac6927a07844c1613b0190bb19fa000e257384373ff4077.webp","original":"https://scriptblox.com/images/sb/rbx-74559ef2484f9763be829a26c771077d-b55987d29789.png","scriptblox":"https://scriptblox.com/images/script/rbx-74559ef2484f9763be829a26c771077d-b55987d29789.png"},"likeCount":9,"dislikeCount":0,"createdAt":"2026-04-24T05:25:53.879Z","keyLink":"","executes":127,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":