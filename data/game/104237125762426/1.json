hook in the water, then click the button for it to work.\n\n•Yes it will definitely lag🤓","tags":["weaponfishing","script","free"],"script":"\nlocal Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\n\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Name = \"RodEventGui\"\nscreenGui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0, 140, 0, 40)\nbutton.Position = UDim2.new(0.5, -70, 0.5, -20)\nbutton.Text = \"Catch With Rods\"\nbutton.BackgroundColor3 = Color3.fromRGB(40, 170, 255)\nbutton.TextColor3 = Color3.new(1,1,1)\nbutton.Font = Enum.Font.SourceSansBold\nbutton.TextScaled = true\nbutton.Parent = screenGui\nbutton.Active = true\n\nlocal dragging\nlocal dragInput\nlocal dragStart\nlocal startPos\n\nlocal function update(input)\n    local delta = input.Position - dragStart\n    button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\nend\n\nbutton.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n        dragging = true\n        dragStart = input.Position\n        startPos = button.Position\n\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\nbutton.InputChanged:Connect(function(input)\n    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then\n        dragInput = input\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputChanged:Connect(function(input)\n    if dragging and input == dragInput then\n        update(input)\n    end\nend)\n\n\nbutton.MouseButton1Click:Connect(function()\n    for _, tool in ipairs(player.Character:GetChildren()) do\n        if tool:FindFirstChild(\"RodEvent\") and tool.RodEvent.FireServer then\n            local args = {\n                [1] = { [\"action\"] = \"Catch\" }\n            }\n            for i = 1, 1000 do\n                tool.RodEvent:FireServer(unpack(args))\n            end\n        end\n    end\nend)","owner":{"_id":"6649aca304e17bb63806e0ea","username":"1kzuya","verified":false,"profilePicture":"/images/photo/6649aca304e17bb63806e0ea-1771732170530.jpg","status":"offline","id":"6649aca304e17bb63806e0ea","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":4469,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-b32a15285561a359464497a84986e9f1-f7f165225f32.png","likeCount":15,"dislikeCount":3,"createdAt":"2025-12-01T10:29:06.432Z","keyLink":"","executes":26,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"692d6df23f362f81e6c0aeab","editBy":{"_id":"6649aca304e17bb63806e0ea","username":"1kzuya","status":"offline","id":"6649aca304e17bb63806e0ea"},"message":"Create script","createdAt":"2025-12-01T10:29:06.435Z"}],"comments":[{"_id":"692d740c44f3024c3d4f77d3","commentBy":{"_id":"6924643842838574d88bcfd4","username":"Skozzzyyy","verified":false,"role":"user","profilePicture":"/images/photo/6924643842838574d88bcfd4-1763992897595.jpg","lastActive":"2026-01-25T07:19:51.643Z","createdAt":"2025-11-24T13:57:12.254Z","status":"offline","id":"6924643842838574d88bcfd4"},"text":"It's not too laggy, just a few seconds , W script I got a lot of fish (sword)","edited":true,"likeCount":2,"dislikeCount":0,"createdAt":"2025-12-01T10:55:08.612Z","liked":false,"disliked":false},{"_id":"692d7b7d2e1b26ed821d4de2","commentBy":{"_id":"6649aca304e17bb63806e0ea","username":"1kzuya","verified":false,"role":"user","profilePicture":"/images/photo/6649aca304e17bb63806e0ea-1771732170530.jpg","createdAt":"2024-05-19T07:39:15.130Z","lastActive":"2026-03-07T12:28:32.932Z","status":"offline","id":"