 input.Position - dragStart\n    button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\nend\n\nbutton.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then\n        dragging = true\n        dragStart = input.Position\n        startPos = button.Position\n\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\nbutton.InputChanged:Connect(function(input)\n    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then\n        dragInput = input\n    end\nend)\n\ngame:GetService(\"UserInputService\").InputChanged:Connect(function(input)\n    if dragging and input == dragInput then\n        update(input)\n    end\nend)\n\n\nbutton.MouseButton1Click:Connect(function()\n    for _, tool in ipairs(player.Character:GetChildren()) do\n        if tool:FindFirstChild(\"RodEvent\") and tool.RodEvent.FireServer then\n            local args = {\n                [1] = { [\"action\"] = \"Catch\" }\n            }\n            for i = 1, 3500 do\n                tool.RodEvent:FireServer(unpack(args))\n            end\n        end\n    end\nend)\n\n\n\n      ","owner":{"_id":"68f088efff2f2fd411e52cd1","username":"DuyVn_HUB","verified":false,"profilePicture":"/images/photo/68f088efff2f2fd411e52cd1-1760594456150.jpg","status":"offline","id":"68f088efff2f2fd411e52cd1"},"verified":false,"views":761,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-b32a15285561a359464497a84986e9f1-f7f165225f32.png","likeCount":1,"dislikeCount":0,"createdAt":"2025-12-07T10:05:15.479Z","keyLink":"","editBy":{"_id":"68f088efff2f2fd411e52cd1","username":"DuyVn_HUB","status":"offline","id":