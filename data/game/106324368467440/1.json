,"id":"6859365997903068d845f00a"},"message":"Create script","createdAt":"2025-07-27T11:40:25.944Z"}],"comments":[]},{"slug":"UPDATE-Lost-Currents-Alpha-Speed-and-Esp-Free-script-46415","_id":"68855209e6fc2abcb6ff6724","title":"Speed and Esp Free script","game":{"_id":"68474d0d343da7b99761b304","gameId":106324368467440,"name":"Lost Currents [Alpha]  ","imageUrl":"/images/sb/rbx-7805bc51c9e26be63aaf4347da06ba5a-b749a18216b6.png","placeId":106324368467440},"features":"ESP ( Gold + Scrap )\nSpeed","tags":["LostCurrents","Lost","LC","Lost Currents ALPHA","Lost Currents"],"script":"-- get key from discord its Free\n-- https://discord.gg/gDTT766Mv8\nloadstring(game:HttpGet(\"https://pastebin.com/raw/86DBsi6g\"))()\n","owner":{"_id":"6879f14bfcb06a6d3538b039","username":"Dream_Scripts","verified":false,"profilePicture":"/images/photo/6879f14bfcb06a6d3538b039-1780184967439.png","status":"offline","id":"6879f14bfcb06a6d3538b039","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"discord":"https://discord.gg/gDTT766Mv8","keyLink":"https://discord.gg/gDTT766Mv8","views":4070,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/106324368467440-1753567752952.webp","likeCount":2,"dislikeCount":0,"createdAt":"2025-07-26T22:09:13.039Z","executes":152,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"68855209e6fc2abcb6ff6726","editBy":{"_id":"6879f14bfcb06a6d3538b039","username":"Dream_Scripts","status":"offline","id":"6879f14bfcb06a6d3538b039"},"message":"Create script","createdAt":"2025-07-26T22:09:13.042Z"}],"comments":[]},{"slug":"UPDATE-Lost-Currents-Alpha-Auto-Farm-open-source-45875","_id":"687f50738cd55918985f7b84","title":"Auto Farm open source","game":{"_id":"68474d0d343da7b99761b304","gameId":106324368467440,"name":"Lost Currents [Alpha]  ","imageUrl":"/images/sb/rbx-7805bc51c9e26be63aaf4347da06ba5a-b749a18216b6.png","placeId":106324368467440},"features":"Made by 1o4q half from Chatgpt \nOpen source easy to use","tags":["lost","currents","auto","farm","Gold"],"script":"-- CONFIG\nlocal goldFolder = workspace:WaitForChild(\"Gold\")\nlocal teleportDelay = 7 -- seconds\nlocal teleportHeight = 0 -- above the part\nlocal maxRange = 200 -- max distance in studs\n\nlocal players = game:GetService(\"Players\")\nlocal lp = players.LocalPlayer\nlocal uis = game:GetService(\"UserInputService\")\n\n-- STATE\nlocal enabled = false\n\n-- Function to simulate E key press\nlocal function pressE()\n    keypress(0x45)\n    wait(0.1)\n    keyrelease(0x45)\nend\n\n-- TP to gold part\nlocal function teleportTo(part)\n    if lp.Character and lp.Character:FindFirstChild(\"HumanoidRootPart\") then\n        lp.Character:MoveTo(part.Position + Vector3.new(0, teleportHeight, 0))\n    end\nend\n\n-- Loop for farming gold with range check\ntask.spawn(function()\n    while true do\n        if enabled then\n            if lp.Character and lp.Character:FindFirstChild(\"HumanoidRootPart\") then\n                local hrpPos = lp.Character.HumanoidRootPart.Position\n                for _, gold in ipairs(goldFolder:GetChildren()) do\n                    if enabled and gold:IsA(\"BasePart\") then\n                        local distance = (gold.Position - hrpPos).Magnitude\n                        if distance <= maxRange then\n                            teleportTo(gold)\n                            wait(1)\n                            pressE()\n                            wait(teleportDelay)\n                        end\n                    end\n                end\n            end\n        end\n        task.wait(0.5)\n    end\nend)\n\nlocal ScreenGui = Instance.new(\"ScreenGui\", game.CoreGui)\nScreenGui.Name = \"GoldFarmUI\"\n\nlocal Frame = Instance.new(\"Frame\", ScreenGui)\nFrame.Size = UDim2.new(0, 150, 0, 50)\nFrame.Position = UDim2.new(0, 200, 0, 200)\nFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)\nFrame.BorderSizePixel = 0\nFrame.Active = true\nFrame.Draggable = true\n\nlocal ToggleButton = Instance.new(\"TextButton\", Frame)\nToggleButton.Size = UDim2.new(1, 0, 1, 0)\nToggleButton.BackgroundTransparency = 1\nToggleButton.Font = Enum.Font.GothamBold\nToggleButton.TextSize = 16\nToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)\nToggleButton.Text = \"AutoFarm: OFF\"\n\nlocal function updateUI()\n    if enabled then\n        Frame.BackgroundColor3 = Color3.fromRGB(0, 200, 0)\n        ToggleButton.Text = \"AutoFarm: ON\"\n    else\n        Frame.BackgroundColor3 = Color3.fromRGB(200, 0, 0)\n        ToggleButton.Text = \"AutoFarm: OFF\"\n    end\nend\n\nToggleButton.MouseButton1Click:Connect(function()\n    enabled = not enabled\n    updateUI()\nend)\n\nupdateUI()\n","owner":{"_id":"66460336062c67df42392f03","username":"1o4q","verified":false,"profilePicture":"/images/photo/66460336062c67df42392f03-1753220128397.png","status":"offline","id":"66460336062c67df42392f03","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":6352,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-4f5eac72c3fadae56ba1372e6ae7a521-c8e50f92fda7.png","likeCount":3,"dislikeCount":0,"createdAt":"2025-07-22T08:48:51.385Z","executes":168,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"687f50738cd55918985f7b86","editBy":{"_id":"66460336062c67df42392f03","username":"1o4q","status":"offline","id":"66460336062c67df42392f03"},"message":"Lost Currents script ","createdAt":"2025-07-22T08:48:51.386Z"}],"comments":[{"_id":"688175652d8a8932d4ade926","commentBy":{"_id":"67e82dfaa2db1dac6a423d24","username":"ChudBear67","verified":false,"role":"user","profilePicture":"/images/photo/67e82dfaa2db1dac6a423d24-1743269418288.jpg","createdAt":"2025-03-29T17:29:30.541Z","lastActive":"2026-07-08T00:00:48.012Z","status":"offline","id":"67e82dfaa2db1dac6a423d24","topMilestone":{"key":"creator.first_script","tier":1}},"text":