dn.com/5c6b085a0058ae83f8dabe2dc84c6b36/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5c6b085a0058ae83f8dabe2dc84c6b36/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/5c6b085a0058ae83f8dabe2dc84c6b36/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/5c6b085a0058ae83f8dabe2dc84c6b36/500/280/Image/Jpeg"},"likeCount":0,"dislikeCount":0,"createdAt":"2024-05-30T17:57:50.908Z","updatedAt":"2024-05-30T17:57:50.908Z","lastBump":"2024-05-30T17:57:50.908Z","script":"local StaffRank = {\"Staff\", \"High Staff\", \"Admin\", \"Developer [ Drag Project ]\", \"Developer [ The Ride ]\", \"Owner\"}\n\nlocal Id = 33138186\n\n\n\nlocal function Verify(player)\n  if player:IsInGroup(Id) then\n        local role = player:GetRoleInGroup(Id)\n        for _, staffRole in ipairs(StaffRank) do\n            if role == staffRole then\n                game.Players.LocalPlayer:Kick(\"STAFF IN GAME [\"..player.name..\" Is Staff\")\n            else\n              print(player.name..\" Not\" ..role.. \"[ Safe ]\")\n              \n            end\n          \n        end\n  else\n    print(player.name..\" not in group\")\n  end\nend\n\nfor _, BB in game.Players:GetPlayers() do\n  \n  Verify(BB)\nend\n\ngame.Players.PlayerAdded:Connect(function(player)\n  Verify(player)\nend)","features":"Safe you from staff when you auto farm","tags":[],"discord":"","keyLink":"","owner":{"_id":"664913c559d7566e81b3cb20","username":"ethandazy","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"664913c559d7566e81b3cb20","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:17:13.428Z","last":"