{"id":82347957379349,"name":"صيد الضبّان","desc":"🏜️ صيد الضبان 🦎\n\nاطلع البر، وصِد الضبان، وبيعها بالسوق وكوّن ثروتك 💰\n\n👑 فيه ضب اسمه أبو الضبان، يطلع كل فترة… اللي يصيده يصير أسطورة\n🦎 أكثر من 120 نوع ضب، وكل ما بعدت عن الديرة يطلع لك أندر وأغلى\n🛻 اشترِ ونيتك وطعّس فيها، بس انتبه لا تغرز بالرمل\n🔥 خيّم بالبر وشب نارك وتقهوى مع أخوياك\n🏚️ فيه أماكن مهجورة فيها معادن نادرة تطوّر فيها سلاحك\n🏮 وبالليل إذا شفت فانوس يمشي بنفسه… لا تلحقه 👀\n\nالعب مع أخوياك، وخلّك من كبار الصيادين 🔥","path":"/game/82347957379349-game","slug":"82347957379349-game","thumbnail":{"url":"https://media.kocakz.me/64c66e70e6d92086cf5e60ebf896ab59ffba873290017b8aedfbd8163d7f3ccb.webp","original":"https://tr.rbxcdn.com/180DAY-159168bb48dbfa43598208e6cc29c258/150/150/Image/Png/noFilter"},"playing":18278,"visitor":22294457,"verified":false,"updatedAt":"2026-10-23T14:50:42.061Z","creator":{"name":"LL's Studio","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"6ad8be0244bfa4a59541c010","title":"Zyphora Dhab","game":{"_id":"6ad8be0244bfa4a59541c00f","gameId":82347957379349,"name":"صيد الضبّان","imageUrl":{"url":"https://media.kocakz.me/64c66e70e6d92086cf5e60ebf896ab59ffba873290017b8aedfbd8163d7f3ccb.webp","original":"https://tr.rbxcdn.com/180DAY-159168bb48dbfa43598208e6cc29c258/150/150/Image/Png/noFilter"},"slug":"82347957379349","path":"/game/82347957379349","thumbnail":{"url":"https://media.kocakz.me/64c66e70e6d92086cf5e60ebf896ab59ffba873290017b8aedfbd8163d7f3ccb.webp","original":"https://tr.rbxcdn.com/180DAY-159168bb48dbfa43598208e6cc29c258/150/150/Image/Png/noFilter"},"placeId":82347957379349},"slug":"syd-aldhban-Zyphora-Dhab-232851","verified":false,"key":false,"keyless":false,"views":386,"executes":56,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/91d7956f74d11867b068fdfe744f85034d134b3d52d8f5f55b9e7f