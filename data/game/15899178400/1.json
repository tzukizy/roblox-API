ion:Disconnect()\n            connection = nil\n        end\n    end\nend)\n\ngui.Destroying:Connect(function()\n    if connection then\n        connection:Disconnect()\n    end\nend)","owner":{"_id":"61b2c8f13e52ec538b264e93","username":"autogclass","verified":false,"profilePicture":"/images/user-default.png","status":"offline","id":"61b2c8f13e52ec538b264e93","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":5603,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/15899178400-1755143779829.png","likeCount":2,"dislikeCount":0,"createdAt":"2025-08-14T03:56:19.844Z","editBy":{"_id":"61b2c8f13e52ec538b264e93","username":"autogclass","status":"offline","id":"61b2c8f13e52ec538b264e93"},"executes":498,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"689d5e635bf6151f6771bec1","editBy":{"_id":"61b2c8f13e52ec538b264e93","username":"autogclass","status":"offline","id":"61b2c8f13e52ec538b264e93"},"message":"Create script","createdAt":"2025-08-14T03:56:19.847Z"},{"_id":"689dae1d0d997a813216f5b1","editBy":{"_id":"61b2c8f13e52ec538b264e93","username":"autogclass","status":"offline","id":"61b2c8f13e52ec538b264e93"},"message":"Update script","createdAt":"2025-08-14T09:36:29.326Z"}],"comments":[{"_id":"689d68bc5bf6151f6772b0bc","commentBy":{"_id":"6683c51d23de1884448ac37b","username":"sjsjke394","verified":false,"role":"user","profilePicture":"/images/photo/6683c51d23de1884448ac37b-1750295931711.jpg","createdAt":"2024-07-02T09:15:09.099Z","lastActive":"2026-07-12T01:04:00.168Z","status":"offline","id":"6683c51d23de1884448ac37b"},"text":"tysm","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2025-08-14T04:40:28.754Z","liked":false,"disliked":false},{"_id":"68bcc4f074e0d0888d856311","commentBy":{"_id":"68af2df97fed70a08e45cd97","username":"noahgymhverdag","verified":false,"role":"user","profilePicture":"/images/user-default.webp","createdAt":"20