rvice(\"RunService\").Heartbeat:Connect(function()\n            game:GetService(\"ReplicatedStorage\"):WaitForChild(\"AbilityRE\"):FireServer()\n        end)\n    else\n        button.Text = \"OFF\"\n        button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)\n        \n\n        if connection then\n            connection:Disconnect()\n            connection = nil\n        end\n    end\nend)\n\ngui.Destroying:Connect(function()\n    if connection then\n        connection:Disconnect()\n    end\nend)","owner":{"_id":"61b2c8f13e52ec538b264e93","username":"autogclass","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null},"status":"offline","id":"61b2c8f13e52ec538b264e93","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":null}},"verified":false,"views":5653,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/c2a16018b70420fddf45ca5c763c1c3cf01d54712a2271aed56f81ac110dbb6a.webp","original":"https://scriptblox.com/images/sb/15899178400-1755143779829.png","scriptblox":"https://scriptblox.com/images/script/15899178400-1755143779829.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2025-08-14T03:56:19.844Z","editBy":{"_id":"61b2c8f13e52ec538b264e93","username":"autogclass","status":"offline","id":"61b2c8f13e52ec538b264e93"},"executes":588,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:54:20.943Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/c2a16018b70420fddf45ca5c763c1c3cf01d54712a2271aed56f81ac110dbb6a.webp","original":"https://scriptblox.com/images/sb/15899178400-1755143779829.png","scriptblox":"https://scriptblox.com/images/script/15899178400-1755143779829.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id"