{"id":122712103009609,"name":"[💸] Push Stuff to Get Rich!","desc":"Earn CASH by pushing ITEMS off the MAP!\n\n🚧 Push items off the map to earn money\n💪 Train to become strong enough to push heavy items\n🌲Unlock new worlds\n🥚 Open Eggs to hatch amazing pets\n💵Premium users get 50% Cash boost!\n\n💸 Pushes Items OFFLINE! Join daily to claim 💸 \n💻 Available on ALL platforms\n👥 Join the group for an exclusive reward!","path":"/game/122712103009609-push-stuff-to-get-rich","slug":"122712103009609-push-stuff-to-get-rich","thumbnail":{"url":"https://cdn.kocakz.me/images/f109154b204e8638a52b4da2ff389aa6709cd7b0bb61bff165d9cf0caec7497f.webp","original":"https://tr.rbxcdn.com/180DAY-d54293e4203ff4b2326c14b0f965d6ac/150/150/Image/Png/noFilter"},"playing":2,"visitor":1115245,"verified":false,"updatedAt":"2026-01-28T15:12:30.617Z","creator":{"name":"PX Simulators","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Push-Stuff-to-Get-Rich!-Fast-Train-94354","_id":"697a275e92a4802284e4a977","title":"Fast Train","game":{"_id":"697a275e92a4802284e4a970","gameId":122712103009609,"name":"[💸] Push Stuff to Get Rich!","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":122712103009609},"features":"Allows you to train really (and I mean REALLY) fast, at a configurable rate.","tags":["push","rich","slop","fast","op"],"script":"--- {settings} ---\nlocal TrainPriority = 0 -- time to wait when binding stuff with runservice (priority = time to wait basically)\nlocal EvenFasterTraining = false\n--------------------------------------------------------------\n\nlocal Players = game:GetService(\"Players\")\nlocal Player = Players.LocalPlayer\nlocal Character = Player.Character or Player.CharacterAdded:Wait()\nlocal Humanoid = Character:FindFirstChildWhichIsA(\"Humanoid\")\nlocal HumanoidRootPart = Character:FindFirstChild(\"HumanoidRootPart\")\n\nlocal CurrentWorld = Player[\"worlds\"].currentworld\n\nlocal Benchpress = nil\nlocal CurrentMap = nil\n\nfor num, item in workspace.maps:GetChildren() do\n\tif item.Name:gsub(\"%D\", \"\") == CurrentWorld.Value:gsub(\"%D\", \"\") then\n\t\tCurrentMap = item\n\t\tBenchpress = CurrentMap.training.benchpress\n\tend\nend\n\ngame.RunService:BindToRenderStep(\"FastTrain\", TrainPriority, function()\n\nlocal omginstance1 = Benchpress\nlocal omgboolean2 = true\n\ngame:GetService(\"ReplicatedStorage\").remotes.train:FireServer(omginstance1, omgboolean2)\n\nlocal omginstance1 = Benchpress\nlocal omgboolean2 = EvenFasterTraining\n\ngame:GetService(\"ReplicatedStorage\").remotes.train:FireServer(omginstance1, omgboolean2)\nend)","owner":{"_id":"672d8d708c508a1395e21d2d","username":"thisisaname","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/ea818d4f4d92033c932b2ccdda6ad95711819f5d860d01eabf0aa0394d75c7ea.webp","original":"https://scriptblox.com/images/photo/672d8d708c508a1395e21d2d-1731038713593.png"},"status":"offline","id":"672d8d708c508a1395e21d2d","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://cdn.kocakz.me/images/ea818d4f4d92033c932b2ccdda6ad95711819f5d860d01eabf0aa0394d75c7ea.webp","original":"https://scriptblox.com/images/photo/672d8d708c508a1395e21d2d-1731038713593.png"}},"verified":false,"views":999,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/6e3d1e174cd29e8919dc6a80d8e85ca1f4c9ec83bcf163dfc8a4ec48ebc0925e.webp","original":"https://scriptblox.com/images/sb/122712103009609-1769613150594.webp","scriptblox":"https://scriptblox.com/images/script/122712103009609-1769613150594.webp"},"likeCount":1,"dislikeCount":1,"createdAt":"2026-01-28T15:12:30.618Z","editBy":{"_id":"672d8d708c508a1395e21d2d","username":"thisisaname","status":"offline","id":"672d8d708c508a1395e21d2d"},"keyLink":"","executes":346,"