{"id":128662368175518,"name":"[SANDEVISTAN COUNTER] DUMMY COUNTER YOUR FRIENDS","desc":"FULL GAME REWORK COMING SOON!!\n\nCODES: NOBLOOD, BESTDEV, HATCH, MELON, FRAMES, MEH, GOAT, DEATH, KAGE\n\nCOUNTER ANYONE\n\nUPDATES EVERY OTHER SUNDAY AT 3:30 CST!\n\nA showcase of the best fighting animations on Roblox.\n\nSwing:\nPC - Click\nMobile - Tap\nConsole - R2 (Right Bumper)\n\nDodge Trashcan:\nPC - E\nMobile - Tap\nConsole - Square / X\n\nAll assets and code in this game were made by humans, ZERO generative AI was used in the creation of this game, and it never will.","path":"/game/128662368175518-dummy-counter-your-friends","slug":"128662368175518-dummy-counter-your-friends","thumbnail":{"url":"https://media.kocakz.me/345b26de71a1720c5d6af61a6d64821f5f35925975741262dda4d46e31c86f69.webp","original":"https://tr.rbxcdn.com/180DAY-44e3231a9ecd65cf7dbd2c30d8e28bd1/150/150/Image/Png/noFilter"},"playing":2081,"visitor":175349704,"verified":false,"updatedAt":"2026-10-14T11:52:11.525Z","creator":{"name":"Uperscuzzi","type":"Group"},"script":{"count":3,"freeCount":3,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"SANDEVISTAN-COUNTER-DUMMY-COUNTER-YOUR-FRIENDS-Auto-farm-for-DCYF-231866","_id":"6ac809aab12a6a6fa7f51b41","title":"Auto-farm for DCYF","game":{"_id":"67e5e1ffb360710ec3c78098","gameId":128662368175518,"name":"[SANDEVISTAN COUNTER] DUMMY COUNTER YOUR FRIENDS","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":128662368175518},"features":"A script for auto-farming in DUMMY COUNTER YOUR FRIENDS allows you to accumulate 1,000 counters for yourself in 1 hour of work, which allows you to get all the counters in 5 hours or get all the emotes in 14 hours of farming. It is also recommended to use this script on a private server if you have the opportunity to spend 10 Robux. Also, if you want to get a counter for being in the top three for a month, you definitely need a private server.","tags":["DCYF","auto farm","Counter Farm","AFK Farm","Auto Farm Counters"],"script":"local Players = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal VirtualInputManager = game:GetService(\"VirtualInputManager\")\nlocal player = Players.LocalPlayer\n\nprint(\"✅ АВТОМАТ ЗАПУЩЕН!\")\n\n-- ========== НАСТРОЙКИ ==========\nlocal attackDelay = 1950 -- ЗАДЕРЖКА УДАРА (мс)\nlocal teleportDelay = 700 -- ЗАДЕРЖКА ТЕЛЕПОРТА (мс)\n\n-- ========== КООРДИНАТЫ ==========\nlocal POINT_1 = Vector3.new(66, 441, -110)\nlocal POINT_2 = Vector3.new(243.81, 440.89, -323.50)\nlocal ANGLE_2 = 25\n\n-- ========== ПЕРЕМЕННЫЕ ==========\nlocal isRunning = false\nlocal cycleThread = nil\n\n-- ========== ФУНКЦИИ ==========\nlocal function Jump()\n    local character = player.Character\n    if character then\n        local humanoid = character:FindFirstChild(\"Humanoid\")\n        if humanoid then\n            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\n        end\n    end\nend\n\nlocal function Attack()\n    pcall(function()\n        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)\n        task.wait(0.05)\n        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)\n    end)\n    task.wait(0.1)\n    pcall(function()\n        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)\n        task.wait(0.05)\n        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)\n    end)\nend\n\nlocal function Teleport1()\n    local character = player.Character\n    if not character then return end\n    local root = character:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return end\n    root.CFrame = CFrame.new(66, 441, -110)\nend\n\nlocal function Teleport2()\n    local character = player.Character\n    if not character then return end\n    local root = character:FindFirstChild(\"HumanoidRootPart\")\n    if not root then return end\n    local angleRad = math.rad(ANGLE_2)\n    root.CFrame = CFrame.new(POINT_2) * CFrame.Angles(0, angleRad, 0)\nend\n\nlocal function StartCycle()\n    if isRunning then return end\n    isRunning = true\n    cycleThread = task.spawn(function()\n        while isRunning do\n            Jump()\n            task.wait(0.001)\n            if not isRunning then break end\n            Teleport1()\n            task.wait(teleportDelay / 1000)\n            if not isRunning then break end\n            Attack()\n            task.wait(attackDelay / 1000)\n            if not isRunning then break end\n            Teleport2()\n            task.wait(teleportDelay / 1000)\n            if not isRunning then break end\n            Attack()\n            task.wait(attackDelay / 1000)\n            if not isRunning then break end\n        end\n        isRunning = false\n    end)\nend\n\nlocal function StopCycle()\n    if not isRunning then return end\n    isRunning = false\n    if cycleThread then\n        task.cancel(cycleThread)\n        cycleThread = nil\n    end\nend\n\n-- ========== СОЗДАЁМ КНОПКИ ==========\nlocal screenGui = Instance.new(\"ScreenGui\")\nscreenGui.Parent = game:GetService(\"CoreGui\")\nscreenGui.Name = \"AutoCycleGUI\"\n\nlocal startBtn = Instance.new(\"TextButton\")\nstartBtn.Parent = screenGui\nstartBtn.Size = UDim2.new(0, 150, 0, 50)\nstartBtn.Position = UDim2.new(0.5, -160, 0.5, -25)\nstartBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 50)\nstartBtn.Text = \"▶ СТАРТ\"\nstartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nstartBtn.TextSize = 18\nstartBtn.Font = Enum.Font.GothamBold\n\nlocal stopBtn = Instance.new(\"TextButton\")\nstopBtn.Parent = screenGui\nstopBtn.Size = UDim2.new(0, 150, 0, 50)\nstopBtn.Position = UDim2.new(0.5, 10, 0.5, -25)\nstopBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)\nstopBtn.Text = \"⏹ СТОП\"\nstopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nstopBtn.TextSize = 18\nstopBtn.Font = Enum.Font.GothamBold\n\nlocal closeBtn = Instance.new(\"TextButton\")\ncloseBtn.Parent = screenGui\ncloseBtn.Size = UDim2.new(0, 30, 0, 30)\ncloseBtn.Position = UDim2.new(0.9, 0, 0, 0)\ncloseBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)\ncloseBtn.Text = \"✕\"\ncloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)\ncloseBtn.TextSize = 18\ncloseBtn.Font = Enum.Font.GothamBold\n\ncloseBtn.MouseButton1Click:Connect(function()\n    isRunning = false\n    if cycleThread then\n        task.cancel(cycleThread)\n        cycleThread = nil\n    end\n    screenGui:Destroy()\nend)\n\nstartBtn.MouseButton1Click:Connect(StartCycle)\nstopBtn.MouseButton1Click:Connect(StopCycle)\n\nprint(\"✅ АВТОМАТ ГОТОВ!\")\nprint(\"⚔️ УДАР: \" .. attackDelay .. \" мс | 🚀 ТЕЛЕПОРТ: \" .. teleportDelay .. \" мс\")","owner":{"_id":"678a2e319c7bd8961aaa9079","username":"killnik12345678","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lvl":6,"status":"offline","id":"678a2e319c7bd8961aaa9079","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verified":false,"keyless":false,"views":640,"executes":663,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://media.kocakz.me/e4b55f3b2f78e9c5bf6b13bec7ed63cf44b8aa5518860d2abd5d23bbadd6bdbb.webp","original":"https://scriptblox.com/images/sb/128662368175518-1791494570825.jpg","scriptblox":"https://scriptblox.com/images/script/128662368175518-1791494570825.jpg"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-08T21:22:50.953Z","reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-14T11:52:11.524Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":0,"conf":0.1,"n":{"w":0,"b":1,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-17T00:05:30.124Z","last":"b","win":14,"math":2},"t