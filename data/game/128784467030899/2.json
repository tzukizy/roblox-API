Font = Enum.Font.GothamBold\ntitleLbl.TextSize = 13; titleLbl.TextXAlignment = Enum.TextXAlignment.Left\n\nlocal CloseBtn = Instance.new(\"TextButton\", titleBar)\nCloseBtn.Size = UDim2.new(0,26,0,26); CloseBtn.Position = UDim2.new(1,-34,0.5,-13)\nCloseBtn.BackgroundColor3 = Color3.fromRGB(80,0,0); CloseBtn.Text = \"✕\"\nCloseBtn.TextColor3 = Color3.fromRGB(255,80,80); CloseBtn.TextSize = 13\nCloseBtn.Font = Enum.Font.GothamBold; CloseBtn.BorderSizePixel = 0\nInstance.new(\"UICorner\", CloseBtn).CornerRadius = UDim.new(0,6)\nCloseBtn.MouseButton1Click:Connect(function() gui:Destroy() end)\n\n-- Reset button\nlocal btn = Instance.new(\"TextButton\", frame)\nbtn.Size = UDim2.new(1, -24, 0, 40)\nbtn.Position = UDim2.new(0, 12, 0, 50)\nbtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\nbtn.Text = \"RESET CHARACTER\"\nbtn.TextColor3 = Color3.fromRGB(255, 255, 255)\nbtn.Font = Enum.Font.GothamBold\nbtn.TextSize = 14\nbtn.BorderSizePixel = 0\nbtn.AutoButtonColor = false\nInstance.new(\"UICorner\", btn).CornerRadius = UDim.new(0, 7)\nlocal btnStroke = Instance.new(\"UIStroke\", btn)\nbtnStroke.Color = Color3.fromRGB(255, 60, 60); btnStroke.Thickness = 1\n\nbtn.MouseButton1Click:Connect(function()\n    local char = player.Character\n    if char then\n        local hum = char:FindFirstChildOfClass(\"Humanoid\")\n        if hum then\n            hum.Health = 0\n            btn.Text = \"✓  RESETTING...\"\n            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\n            task.delay(1.5, function()\n                btn.Text = \"RESET CHARACTER\"\n                btn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)\n            end)\n        end\n    end\nend)\n\nprint(\"[Reset GUI] Loaded!\")\n","features":"For beelz","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a317354b01a2d9aff730799","username":"Rblxexploiterrr","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a317354b01a2d9aff730799","top