d(\"EnemyMain\") and v.Humanoid.Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"RemoteFunction\") then\n                weapon.RemoteFunction:InvokeServer(\"hit\",{v.Humanoid,10000000000000000000000})\n            end\n        end\n        cd = 0\n    end\n    cd += delta\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100},"profile":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"}},"verified":false,"keyLink":"","views":6160,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-22T17:58:37.132Z","dislikeCount":3,"likeCount":1,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-e07976d4c09376f0906b4a279f806a20/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-e07976d4c09376f0906b4a279f806a20/500/280/Image/Jpeg/noFilter"},"executes":68,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-18T02:17:04.084Z","last":"","win":14,"math":3},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-e07976d4c09376f0906b4a279f806a20/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-e07976d4c09376f0906b4a279f806a20/500/280/Image/Jpeg/noFilter"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"