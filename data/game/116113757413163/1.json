Health > 0 and not players:FindFirstChild(v.Name) and weapon and weapon:FindFirstChild(\"RemoteFunction\") then\n                weapon.RemoteFunction:InvokeServer(\"hit\",{v.Humanoid,10000000000000000000000})\n            end\n        end\n        cd = 0\n    end\n    cd += delta\nend)","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","status":"offline","id":"663f0f8448d95881c33f2023","leaderboard":{"tag":null},"topMilestone":{"key":"creator.followers","tier":100}},"verified":false,"keyLink":"","views":6150,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-22T17:58:37.132Z","dislikeCount":3,"likeCount":1,"image":"https://tr.rbxcdn.com/180DAY-e07976d4c09376f0906b4a279f806a20/500/280/Image/Jpeg/noFilter","executes":57,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e7b360710ec3c54507","editBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","status":"offline","id":"663f0f8448d95881c33f2023"},"message":"Create script","createdAt":"2025-03-27T22:24:07.121Z"}],"comments":[{"_id":"679393e49370962893cd4d72","commentBy":{"_id":"66fd3f119b248b637fab40f6","username":"zivrbu","verified":false,"role":"user","profilePicture":"/images/photo/66fd3f119b248b637fab40f6-1758212670622.png","createdAt":"2024-10-02T12:39:45.587Z","lastActive":"2026-10-10T05:52:27.007Z","status":"online","id":"66fd3f119b248b637fab40f6","topMilestone":{"key":"account.years","tier":2}},"text":"ey bro what happened to the PCW post","createdAt":"2025-01-24T13:21:40.594Z","edited":true,"likeCount":1,"liked":false,"disliked":false},{"_id":"6793f99048d7220904fccf32","commentBy":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"role":"user","profilePicture":"/images/photo/663f0f8448d95881c33f2023-1752693968457.png","createdAt":"2024-05-11T06:26:12.061Z","lastActive":"2