{"id":85247362414047,"name":"💥 Prisoner Life","desc":"Welcome to Prison Breakout!  Be a Prisoner trying to escape the prison, be a Guard keeping the prison safe, or be a Criminal trying to raid the prison and free the prisoners. 🔫\n\n⭐ Roblox PLUS Subscribers get access to a free supercar!\n\n🔓 Break free and escape the prison!\n👮 Become a cop and keep order with sirens, cuffs, and force!\n🦹 Plan escapes, rob the armory!\n🧠 Outsmart guards and other players in a high-stakes prison!\n\n⚙️ Check the Settings Menu, you can customize gameplay features!","path":"/game/85247362414047-prisoner-life","slug":"85247362414047-prisoner-life","thumbnail":{"url":"https://media.kocakz.me/b0af97cb997f100ea6f811e5c027a00661624fc5752b3bd027cf84256b5144cd.webp","original":"https://tr.rbxcdn.com/180DAY-7848ee81f67dd08a7c144a0facf519ca/150/150/Image/Png/noFilter"},"playing":0,"visitor":52696209,"verified":false,"updatedAt":"2026-03-30T07:11:29.748Z","creator":{"name":"Breakout: Community","type":"Group"},"script":{"count":3,"freeCount":3,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"_id":"69ca222180e0e9c47e948c72","title":"Open source Op","game":{"_id":"67ec5671c2a37f8c86c59193","gameId":85247362414047,"name":"💥 Prisoner Life","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"slug":"85247362414047-prisoner-life","path":"/game/85247362414047-prisoner-life","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":85247362414047},"slug":"Prisoner-Life-Open-source-Op-165875","verified":false,"key":false,"keyless":false,"views":881,"executes":198,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/1a7185e4bf9f78b88dc8df3feb684d760dabb3904a1e5f15a22a0d78f647179e.webp","original":"https://scriptblox.com/images/sb/rbx-34e37ecdce93f1aa3c456a35498b61ae-f8cd4cf1b51f.png","scriptblox":"https://scriptblox.com/images/script/rbx-34