\n                end\n            end\n        end\n    end\nend\n\nSection:CreateToggle(\"Remove DoorsToilets\", function(value)\n    local doors = workspace:FindFirstChild(\"NewDoors\")\n    local breakables = workspace:FindFirstChild(\"Prison_ITEMS\") and workspace.Prison_ITEMS:FindFirstChild(\"breakables\")\n\n    setState(doors, value)\n    setState(breakables, value)\nend)\n\nSection:CreateButton(\"Instant Proximity\", function()\nloadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Instantly-interact-with-proximity-prompt-73901\"))()\nend)\n\nSection:CreateButton(\"Nameless admin\", function()\nloadstring(game:HttpGet(\"https://rawscripts.net/raw/Universal-Script-Nameless-admin-reworked-75477\"))()\nend)","owner":{"_id":"699669611a5b231013d0fff7","username":"enadla2","verified":false,"profilePicture":"/images/photo/699669611a5b231013d0fff7-1771731297692.jpg","status":"offline","id":"699669611a5b231013d0fff7","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":869,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-34e37ecdce93f1aa3c456a35498b61ae-f8cd4cf1b51f.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-03-30T07:11:29.750Z","executes":165,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69ca222180e0e9c47e948c75","editBy":{"_id":"699669611a5b231013d0fff7","username":"enadla2","status":"offline","id":"699669611a5b231013d0fff7"},"message":"Create script","createdAt":"2026-03-30T07:11:29.755Z"}],"comments":[{"_id":"69ca2e56bf3c5796ab61d831","commentBy":{"_id":"67863a52bd886a55d6ecbde2","username":"_AAA","verified":false,"role":"user","profilePicture":"/images/photo/67863a52bd886a55d6ecbde2-1765076908108.jpg","createdAt":"2025-01-14T10:20:02.055Z","lastActive":"2026-10-06T03:09:20.293Z","status":"offline","id":"67863a52bd886a55d6ecbde2","topMilestone":{"key":"creator.scripts","tier":5}},"text":"If you do