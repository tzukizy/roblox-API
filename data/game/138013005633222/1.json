ript":"game:GetService(\"ReplicatedStorage\"):WaitForChild(\"Remotes\"):WaitForChild(\"Heal\"):FireServer()\n\nlocal Players = game:GetService(\"Players\")\nlocal LocalPlayer = Players.LocalPlayer\nlocal Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal GodMode = false\nlocal Library = loadstring(game:HttpGet((\"https://raw.githubusercontent.com/theneutral0ne/wally-modified/refs/heads/main/wally-modified.lua\")))()\nlocal Window = Library:CreateWindow('Credit: Neutral')\nWindow:Toggle(\"God Mode\", {}, function(value)\n    GodMode = value\n    if GodMode then\n        for i = 1,1000 do\n            ReplicatedStorage.Remotes.Choice:FireServer(\"Tower\")\n        end\n    end\nend)\nWindow:Button(\"Inf HP (Must be Lvl 2+)\", function()\n    for i = 1,1000 do\n        ReplicatedStorage.Remotes.Choice:FireServer(\"Tower\")\n    end\nend)\nWindow:Button(\"Inf Damage (Must be Lvl 2+)\", function()\n    for i = 1,100 do\n        ReplicatedStorage.Remotes.Choice:FireServer(\"Giant\")\n    end\nend)\nWindow:Button(\"Inf Attack Speed (Must be Lvl 2+)\", function()\n    for i = 1,100 do\n        ReplicatedStorage.Remotes.Choice:FireServer(\"Trident\")\n    end\nend)\nWindow:Button(\"Inf Luck (Must be Lvl 2+)\", function()\n    for i = 1,100 do\n        ReplicatedStorage.Remotes.Choice:FireServer(\"Spades\")\n    end\nend)\n\nRunService.RenderStepped:Connect(function()\n    if GodMode then\n        ReplicatedStorage.Remotes.Heal:FireServer()\n    end\nend)\n","features":"GOd Mode \nInf stats","tags":[],"discord":"","keyLink":"","owner":{"_id":"663f0f8448d95881c33f2023","username":"neutral","verified":false,"profilePicture":{"url":"https://media.kocakz.me/fb2d781f83540dd2002b0f49277107b000390aabdc18306e78d3483e6b45ee58.webp","original":"https://scriptblox.com/images/photo/663f0f8448d95881c33f2023-1752693968457.png"},"lvl":23,"status":"