           firetouchinterest(player.Character.HumanoidRootPart, knife.Handle, 1)\n                    end)\n                    wait(0.2)\n                end\n            end\n        end\n    end)\n    wait()\nend\n\n-- by: t.me/arceusxscripts","owner":{"_id":"61f96cc63ede52bf4f7e299d","username":"Bac0nH1ckOff","verified":true,"profilePicture":{"url":"https://cdn.kocakz.me/images/4c296a9201f9551996a357d62ae1913747bd75c28208290884e9e394f442f870.webp","original":"https://scriptblox.com/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png"},"lvl":24,"status":"offline","id":"61f96cc63ede52bf4f7e299d","leaderboard":{"tag":{"kind":"hall","rank":1,"period":"all","metric":"views","value":17476254}},"topMilestone":{"key":"creator.likes","tier":1000},"profile":{"url":"https://cdn.kocakz.me/images/4c296a9201f9551996a357d62ae1913747bd75c28208290884e9e394f442f870.webp","original":"https://scriptblox.com/images/photo/61f96cc63ede52bf4f7e299d-1697219756847.png"}},"verified":true,"keyLink":"","views":571153,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2025-01-02T14:00:11.031Z","dislikeCount":2,"likeCount":10,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-d9f9ed40a1cc663cbc2429959e32faad/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/180DAY-d9f9ed40a1cc663cbc2429959e32faad/500/280/Image/Jpeg/noFilter"},"executes":16927,"keyless":false,"milestones":[{"key":"script.executions","tier":10000,"value":13493,"at":"2026-09-29T05:45:00.006Z"}],"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T03:10:46.372Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://tr.rbxcdn.com/180DAY-d9f9ed40a1cc663cbc2429959e32faad/500/280/Image/Jpeg/noFilter","scriptblox":"https://tr.rbxcdn.com/18