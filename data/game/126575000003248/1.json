ntitle.Font = Enum.Font.GothamBold\ntitle.TextScaled = true\ntitle.Parent = frame\n\n--// Credit\nlocal credit = Instance.new(\"TextLabel\")\ncredit.Size = UDim2.new(1, 0, 0.15, 0)\ncredit.Position = UDim2.new(0, 0, 0.18, 0)\ncredit.BackgroundTransparency = 1\ncredit.Text = \"Made by _OpenSource_\"\ncredit.TextColor3 = Color3.fromRGB(150,150,200)\ncredit.Font = Enum.Font.Gotham\ncredit.TextScaled = true\ncredit.Parent = frame\n\n--// Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0.8, 0, 0.35, 0)\nbutton.Position = UDim2.new(0.1, 0, 0.55, 0)\nbutton.BackgroundColor3 = Color3.fromRGB(70, 70, 120)\nbutton.Text = \"Kill Aura: OFF\"\nbutton.TextColor3 = Color3.fromRGB(255,255,255)\nbutton.Font = Enum.Font.GothamBold\nbutton.TextScaled = true\nbutton.Parent = frame\n\nInstance.new(\"UICorner\", button).CornerRadius = UDim.new(0, 10)\n\n--// Toggle System\nlocal enabled = false\n\nbutton.MouseButton1Click:Connect(function()\n    enabled = not enabled\n    button.Text = \"Kill Aura: \" .. (enabled and \"ON\" or \"OFF\")\nend)\n\n--// DRAG SYSTEM (PC + MOBILE FIXED)\nlocal dragging = false\nlocal dragInput, dragStart, startPos\n\nlocal function update(input)\n    local delta = input.Position - dragStart\n    frame.Position = UDim2.new(\n        startPos.X.Scale,\n        startPos.X.Offset + delta.X,\n        startPos.Y.Scale,\n        startPos.Y.Offset + delta.Y\n    )\nend\n\nframe.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 \n    or input.UserInputType == Enum.UserInputType.Touch then\n        \n        dragging = true\n        dragStart = input.Position\n        startPos = frame.Position\n\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\nframe.InputChanged:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseMovement \n    or input.UserInputType == Enum.UserInputType.Touch then\n        dragInput = input\n    end\nend)\n\nUIS.InputChanged:Connect(function(input)\n    if input == dragInput and dragging then\n        update(input)\n    end\nend)","features":"idk havent tested it. can someone test it for me and see if it works","tags":[],"discord":"","keyLink":"","owner":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","verified":false,"profilePicture":{"url":"https://media.kocakz.me/894d822911f4fa841c1b8eabe2761fb69bfc8b297da7b12d3eb46a3e261b5f0d.webp","original":"https://scriptblox.com/images/photo/67cbc14c6e7623d225a5710a-1773700040553.jpg"},"status":"offline","id":"67cbc14c6e7623d225a5710a","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/894d822911f4fa841c1b8eabe2761fb69bfc8b297da7b12d3eb46a3e261b5f0d.webp","original":"https://scriptblox.com/images/photo/67cbc14c6e7623d225a5710a-1773700040553.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:37:35.352Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c46737ff35529a742e62db","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status":"offline","id":"67cbc14c6e7623d225a5710a"},"message":"Create script","createdAt":"2026-03-25T22:52:39.362Z"},{"_id":"69c46d20ac7bc510b6e5a0fa","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status":"offline","id":"67cbc14c6e7623d225a5710a"},"message":"Update script","createdAt":"2026-03-25T23:17:52.602Z"},{"_id":"69c472ccac7bc510b6e5f28c","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status":"offline","id":"67cbc14c6e7623d225a5710a"},"message":"Update script","createdAt":"2026-03-25T23:42:04.432Z"}],"comments":[{"_id":"69c468a18edc2a4aa66e443f","commentBy":{"_id":"69bc56e3ed9548b2834aa8dc","