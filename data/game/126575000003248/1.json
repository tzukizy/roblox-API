{"id":126575000003248,"name":"Noob Invaders","desc":"Defend your tacos against hungry noobs! How many waves can you last?\n\n🪄 Unlock new classes, which give special weapons and abilities for battle\n⏫ Unlock permanent upgrades that make you stronger\n🗡️Try out lots of different weapon combinations\n\nReach the highest wave you possibly can, keep defending your tacos\n\nProudly made by\n@lollypop99p\n@jenowo0","path":"/game/126575000003248-noob-invaders","slug":"126575000003248-noob-invaders","thumbnail":["https://tr.rbxcdn.com/180DAY-62ca47965a014de38efb838c24e795a0/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-423a75e7847c98e217f32fca76560383/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":146,"visitor":53934328,"verified":false,"updatedAt":"2026-03-25T22:52:39.346Z","creator":{"name":"Devs Devs Devs","type":"Group"},"script":{"count":5,"freeCount":5,"keyCount":2,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Noob-Invaders-Kill-aura-on-gun-and-melee-148634","_id":"69c46737ff35529a742e62d7","title":"Kill aura on gun and melee","game":{"_id":"69406538efa5e4fa558ea1eb","gameId":126575000003248,"name":"Noob Invaders","imageUrl":"/images/sb/rbx-423a75e7847c98e217f32fca76560383-67ce65db0455.png","placeId":126575000003248},"features":"idk havent tested it. can someone test it for me and see if it works","tags":[],"script":"--[[ \n    OpenSource Hub (Executor Compatible)\n    Made by _OpenSource_\n]]\n\n--// Services (IMPORTANT for executors)\nlocal Players = game:GetService(\"Players\")\nlocal CoreGui = game:GetService(\"CoreGui\")\nlocal UIS = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\n\n--// Remove old GUI (prevents duplicates)\nif CoreGui:FindFirstChild(\"AuraHub\") then\n    CoreGui:FindFirstChild(\"AuraHub\"):Destroy()\nend\n\n--// GUI\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"AuraHub\"\ngui.Parent = CoreGui\ngui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\ngui.ResetOnSpawn = false\n\n--// Main Frame\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0.3, 0, 0.25, 0)\nframe.Position = UDim2.new(0.35, 0, 0.35, 0)\nframe.BackgroundColor3 = Color3.fromRGB(25, 25, 35)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Parent = gui\n\nInstance.new(\"UICorner\", frame).CornerRadius = UDim.new(0, 12)\n\n--// UI Scale (mobile support)\nlocal uiScale = Instance.new(\"UIScale\")\nuiScale.Scale = 1\nuiScale.Parent = frame\n\n--// Title\nlocal title = Instance.new(\"TextLabel\")\ntitle.Size = UDim2.new(1, 0, 0.2, 0)\ntitle.BackgroundTransparency = 1\ntitle.Text = \"OpenSource Hub\"\ntitle.TextColor3 = Color3.fromRGB(220,220,255)\ntitle.Font = Enum.Font.GothamBold\ntitle.TextScaled = true\ntitle.Parent = frame\n\n--// Credit\nlocal credit = Instance.new(\"TextLabel\")\ncredit.Size = UDim2.new(1, 0, 0.15, 0)\ncredit.Position = UDim2.new(0, 0, 0.18, 0)\ncredit.BackgroundTransparency = 1\ncredit.Text = \"Made by _OpenSource_\"\ncredit.TextColor3 = Color3.fromRGB(150,150,200)\ncredit.Font = Enum.Font.Gotham\ncredit.TextScaled = true\ncredit.Parent = frame\n\n--// Button\nlocal button = Instance.new(\"TextButton\")\nbutton.Size = UDim2.new(0.8, 0, 0.35, 0)\nbutton.Position = UDim2.new(0.1, 0, 0.55, 0)\nbutton.BackgroundColor3 = Color3.fromRGB(70, 70, 120)\nbutton.Text = \"Kill Aura: OFF\"\nbutton.TextColor3 = Color3.fromRGB(255,255,255)\nbutton.Font = Enum.Font.GothamBold\nbutton.TextScaled = true\nbutton.Parent = frame\n\nInstance.new(\"UICorner\", button).CornerRadius = UDim.new(0, 10)\n\n--// Toggle System\nlocal enabled = false\n\nbutton.MouseButton1Click:Connect(function()\n    enabled = not enabled\n    button.Text = \"Kill Aura: \" .. (enabled and \"ON\" or \"OFF\")\nend)\n\n--// DRAG SYSTEM (PC + MOBILE FIXED)\nlocal dragging = false\nlocal dragInput, dragStart, startPos\n\nlocal function update(input)\n    local delta = input.Position - dragStart\n    frame.Position = UDim2.new(\n        startPos.X.Scale,\n        startPos.X.Offset + delta.X,\n        startPos.Y.Scale,\n        startPos.Y.Offset + delta.Y\n    )\nend\n\nframe.InputBegan:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseButton1 \n    or input.UserInputType == Enum.UserInputType.Touch then\n        \n        dragging = true\n        dragStart = input.Position\n        startPos = frame.Position\n\n        input.Changed:Connect(function()\n            if input.UserInputState == Enum.UserInputState.End then\n                dragging = false\n            end\n        end)\n    end\nend)\n\nframe.InputChanged:Connect(function(input)\n    if input.UserInputType == Enum.UserInputType.MouseMovement \n    or input.UserInputType == Enum.UserInputType.Touch then\n        dragInput = input\n    end\nend)\n\nUIS.InputChanged:Connect(function(input)\n    if input == dragInput and dragging then\n        update(input)\n    end\nend)","owner":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","verified":false,"profilePicture":"/images/photo/67cbc14c6e7623d225a5710a-1773700040553.jpg","status":"offline","id":"67cbc14c6e7623d225a5710a","topMilestone":{"key":"creator.scripts","tier":25}},"verified":false,"views":1441,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-423a75e7847c98e217f32fca76560383-67ce65db0455.png","likeCount":1,"dislikeCount":3,"createdAt":"2026-03-25T22:52:39.347Z","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status":"offline","id":"67cbc14c6e7623d225a5710a"},"keyLink":"","executes":177,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69c46737ff35529a742e62db","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status":"offline","id":"67cbc14c6e7623d225a5710a"},"message":"Create script","createdAt":"2026-03-25T22:52:39.362Z"},{"_id":"69c46d20ac7bc510b6e5a0fa","editBy":{"_id":"67cbc14c6e7623d225a5710a","username":"_OpenSource_","status