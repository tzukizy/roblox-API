\nnever sell list\nterritory scout\nauto buy best property\nauto upgrade safehouse\nauto claim daily playtime rewards\nauto attack war enemies\nauto attack territory","tags":["Idle Mafia Game","Keyless","Free","Auto List","Auto Snipe"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/f3a2/Idle-Mafia-Game/refs/heads/main/IdleMafiaScript.lua\"))()","owner":{"_id":"67ebcc9b312e30aa45902abd","username":"wowgoodbr","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/abefd921d04057017eabc4cad0e2891d611c4a79ed4d957dcebde5fe6f65aa71.webp","original":"https://scriptblox.com/images/photo/67ebcc9b312e30aa45902abd-1743506616487.png"},"lvl":8,"status":"offline","id":"67ebcc9b312e30aa45902abd","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://cdn.kocakz.me/images/abefd921d04057017eabc4cad0e2891d611c4a79ed4d957dcebde5fe6f65aa71.webp","original":"https://scriptblox.com/images/photo/67ebcc9b312e30aa45902abd-1743506616487.png"}},"verified":false,"keyless":false,"views":2103,"executes":2217,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/5b7318eaf10c145b40f99c688fedcd6f577e897ea8566556e366cc245983cb99.webp","original":"https://scriptblox.com/images/sb/73897506680154-1791035939297.png","scriptblox":"https://scriptblox.com/images/script/73897506680154-1791035939297.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-09-30T12:31:35.337Z","discord":"https://discord.gg/MRVawwUeJc","keyLink":"","reviewed":{"name":"QueueSherlock","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-10T06:16:10.259Z","profile":"/u/QueueSherlock"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-14T00:29:03.776Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/5b7318eaf10c145b40f99c688fedcd6f577e897ea8566556e366cc245983cb99