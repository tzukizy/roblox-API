es/photo/61aab6cf72e7ccc48b8290cd-1638592761084.png"}},"verified":false,"views":11796,"scriptType":"free","isUniversal":false,"createdAt":"2021-12-04T10:12:00.489Z","visibility":"public","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/1899149341-1638612720485.jpg","scriptblox":"https://scriptblox.com/images/script/1899149341-1638612720485.jpg"},"executes":4,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:37:36.576Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/1899149341-1638612720485.jpg","scriptblox":"https://scriptblox.com/images/script/1899149341-1638612720485.jpg"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4de84","editBy":{"_id":"61aab6cf72e7ccc48b8290cd","username":"ROBLOX","status":"offline","id":"61aab6cf72e7ccc48b8290cd"},"message":"Create script","createdAt":"2025-03-27T21:22:21.350Z"}],"comments":[]},{"slug":"Auto-Collect-orbs_53","_id":"61ab3d4a580e3bd962d70083","title":"Auto Collect orbs","game":{"_id":"67e5e1ffb360710ec3c787fe","gameId":1899149341,"name":"🏁 Vehicle Tycoon ","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":1899149341},"features":"Auto Collect Coins For you","tags":[],"script":"---TP COINS\n_G.UoU= true\nwhile _G.UoU do\nlocal UwU = game.Players.LocalPlayer.Character.HumanoidRootPart\nfor i,v in pairs(game.workspace.CoinEvent.Coins:GetChildren()) do\nv.CFrame = UwU.CFrame \nwait(0.2)\nend\nend\n\n---CAR SPEED\nlocal name = game.Players.LocalPlayer.Name\ngame:GetService(\"Workspace\").Vehicles[name].Stats.MaxSpeed.Value = 9999999999\ngame:GetService(\"Workspace\").Vehicles[name].Stats.AccelerateTorque.Value = 9999999999\n\n\n---AUTO FARM\nlocal car = game.workspace.Vehicles[game.Players.LocalPlayer.Name]\nlocal part1 = Instance.new(\"Part\")\npart1.Anchored = true\npart1.Position = Vector3.new(-4000, 250, -4000)\npart1.Size = Vector3.new(50000, 1, 50000)\nlocal part2 = Instance.new(\"Part\")\npart2.Anchored = true\npart2.Position = Vector3.new(4000, 250, 4000)\npart2.Size = Vector3.new(50000, 1, 50000)\npart1.Parent = workspace\npart2.Parent = workspace\nwait(1)\nwhile wait(1.5) do\ncar:SetPrimaryPartCFrame(CFrame.new(part1.Position + Vector3.new(0, 1, 0)))\nwait(1.5)\ncar:SetPrimaryPartCFrame(CFrame.new(part2.Position + Vector3.new(0, 1, 0)))\nend","owner":{"_id":"61aab6cf72e7ccc48b8290cd","username":"ROBLOX","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61aab6cf72e7ccc48b8290cd-1638592761084.png"},"status":"offline","id":"61aab6cf72e7ccc48b8290cd","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/no-profile.webp","original":"https://scriptblox.com/images/photo/61aab6cf72e7ccc48b8290cd-1638592761084.png"}},"verified":false,"views":3275,"scriptType":"free","isUniversal":false,"createdAt":"2021-12-04T10:04:58.753Z","visibility":"public","dislikeCount":0,"likeCount":0,"image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/1899149341-1638612298749.jpg","scriptblox":"https://scriptblox.com/images/script/1899149341-1638612298749.jpg"},"executes":0,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:37:36.578Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/1899149341-1638612298749.jpg","scriptblox":"https://scriptblox.com/images/script/1899149341-163861229874