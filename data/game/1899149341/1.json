-tycoon","thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":1899149341},"slug":"Auto-Collect-orbs_53","verified":false,"key":false,"keyless":false,"views":3280,"executes":0,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/1899149341-1638612298749.jpg","scriptblox":"https://scriptblox.com/images/script/1899149341-1638612298749.jpg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/1899149341-1638612298749.jpg","scriptblox":"https://scriptblox.com/images/script/1899149341-1638612298749.jpg"},"likeCount":0,"dislikeCount":0,"createdAt":"2021-12-04T10:04:58.753Z","updatedAt":"2021-12-04T10:04:58.753Z","lastBump":"2021-12-04T10:04:58.753Z","script":"---TP COINS\n_G.UoU= true\nwhile _G.UoU do\nlocal UwU = game.Players.LocalPlayer.Character.HumanoidRootPart\nfor i,v in pairs(game.workspace.CoinEvent.Coins:GetChildren()) do\nv.CFrame = UwU.CFrame \nwait(0.2)\nend\nend\n\n---CAR SPEED\nlocal name = game.Players.LocalPlayer.Name\ngame:GetService(\"Workspace\").Vehicles[name].Stats.MaxSpeed.Value = 9999999999\ngame:GetService(\"Workspace\").Vehicles[name].Stats.AccelerateTorque.Value = 9999999999\n\n\n---AUTO FARM\nlocal car = game.workspace.Vehicles[game.Players.LocalPlayer.Name]\nlocal part1 = Instance.new(\"Part\")\npart1.Anchored = true\npart1.Position = Vector3.new(-4000, 250, -4000)\npart1.Size = Vector3.new(50000, 1, 50000)\nlocal part2 = Instance.new(\"Part\")\npart2.Anchored = true\npart2.Position = Vector3.new(4000, 250, 4000)\npart2.Size = Vector3.new(50000, 1, 50000)\npart1.Parent = workspace\npart2.Parent = workspace\nwait(1)\nwhile wait(1.5) do\ncar:SetPrimaryPartCFrame(CFrame.new(part1.Position + Vector3.new(0, 1, 0)))\nwait(1.5)\ncar:SetPrimaryPartCFrame(CFrame.new(part2.Position + Vector3.new(0, 1, 0)))\nend","features":"Auto Collect Coins For you","tags":[],"discord":"","keyLink":"","owner":{"_id":"61aab6cf72e7ccc48b8290cd","username":"ROBLOX","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"61aab6cf72e7ccc48b8290cd","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T03:14:50.261Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e3b360710ec3c4de82","editBy":{"_id":"61aab6cf72e7ccc48b8290cd","username":"ROBLOX","status":"offline","id":"61aab6cf72e7ccc48b8290cd"},"message":"Create script","createdAt":"2025-03-27T18:34:55.409Z"}],"comments":[]}]}