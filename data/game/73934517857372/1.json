n.MouseButton1Click:Connect(function()\n\teggsPanel.Visible = true\n\tmoneyPanel.Visible = false\n\teggsTabBtn.BackgroundColor3 = Color3.fromRGB(90,90,90)\n\tmoneyTabBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)\nend)\n\nmoneyTabBtn.MouseButton1Click:Connect(function()\n\teggsPanel.Visible = false\n\tmoneyPanel.Visible = true\n\teggsTabBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)\n\tmoneyTabBtn.BackgroundColor3 = Color3.fromRGB(90,90,90)\nend)\n\neggsTabBtn.BackgroundColor3 = Color3.fromRGB(90,90,90)\nmoneyTabBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)\neggsPanel.Visible = true\nmoneyPanel.Visible = false\n","features":"Open Robux Egg (need 99 dollars)\nOpen Event Egg","tags":["Free","Bloxfruits","Grow A Garden","Dead Rails","Bloxburg"],"discord":"","keyLink":"","owner":{"_id":"66afe23d030fd4bf7253ee65","username":"Voyx","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"66afe23d030fd4bf7253ee65","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:55:41.521Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"685efe37b817f46491ee0ca6","editBy":{"_id":"66afe23d030fd4bf7253ee65","username":"Voyx","status":"offline","id":"66afe23d030fd4bf7253ee65"},"message":"Create script","createdAt":"2025-06-27T20:25:27.364Z"},{"_id":"685efedf4d7758ab4d91a804","editBy":{"_id":"66afe23d030fd4bf7253ee65","username":"Voyx","status":"offline","id":"66afe23d030fd4bf7253ee65"},"message":"Update script","createdAt":"2025-06-27T20:28:15.899Z"},{"_id":"685f26513f22202dfd49f607","editBy":{"_id":"66afe23d030fd4bf7253ee65","username":"Voyx","status":"offline","id":"66afe23d030fd4bf7253ee65"},"message":"Upd