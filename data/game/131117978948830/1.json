mages/sb/0-1791494127196.png","scriptblox":"https://scriptblox.com/images/script/0-1791494127196.png"},"likeCount":2,"dislikeCount":0,"createdAt":"2026-10-08T21:15:27.679Z","updatedAt":"2026-10-08T21:15:27.679Z","lastBump":"2026-10-08T21:15:27.679Z","script":"local Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal player = Players.LocalPlayer\n\nlocal disabled = {}\nlocal floorY = nil\nlocal floor = Instance.new(\"Part\")\nfloor.Size = Vector3.new(10, 1, 10)\nfloor.Anchored = true\nfloor.CanQuery = false\nfloor.CanTouch = false\nfloor.Transparency = 1\nfloor.Parent = workspace.CurrentCamera\n\nlocal params = RaycastParams.new()\nparams.RespectCanCollide = true\n\nlocal function check(part)\n\tif not part:IsA(\"BasePart\") or not floorY then\n\t\treturn\n\tend\n\tlocal cf, size = part.CFrame, part.Size\n\tlocal halfHeight = math.abs(cf.RightVector.Y) * size.X / 2\n\t\t+ math.abs(cf.UpVector.Y) * size.Y / 2\n\t\t+ math.abs(cf.LookVector.Y) * size.Z / 2\n\tif cf.Position.Y + halfHeight > floorY + 1.5 then\n\t\tif part.CanCollide then\n\t\t\tdisabled[part] = true\n\t\t\tpart.CanCollide = false\n\t\tend\n\telseif disabled[part] then\n\t\tdisabled[part] = nil\n\t\tpart.CanCollide = true\n\tend\nend\n\nlocal function scan()\n\tfor _, name in ipairs({ \"ActiveMaps\", \"Lobby\" }) do\n\t\tlocal root = workspace:FindFirstChild(name)\n\t\tif root then\n\t\t\tfor _, part in ipairs(root:GetDescendants()) do\n\t\t\t\tcheck(part)\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal elapsed = 3\nRunService.Heartbeat:Connect(function(dt)\n\tlocal char = player.Character\n\tlocal root = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tlocal humanoid = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not (root and humanoid) then\n\t\treturn\n\tend\n\tlocal height = humanoid.HipHeight + root.Size.Y / 2\n\tparams.FilterDescendantsInstances = { char, workspace.CurrentCamera }\n\tlocal hit = workspace:Raycast(root.Position, Vector3.new(0, -(height + 30), 0), params)\n\tfloorY = hit and hit.Position.Y or floorY or root.Position.Y - height\n\tfloor.CFrame = CFrame.new(root.Position.X, floorY - 0.5, root.Position.Z)\n\telapsed = elapsed + dt\n\tif elapsed >= 3 then\n\t\telapsed = 0\n\t\tscan()\n\tend\nend)","features":"Noclip","tags":[],"discord":"","keyLink":"","owner":{"_id":"6a15380073db367019602a1e","username":"noctra","verified":false,"profilePicture":{"url":"https://media.kocakz.me/5fd2fc1be14f97c1a7d2ab11c2456e62dcd391e47131112b1fc1f65ae5e7a8f7.webp","original":"https://scriptblox.com/images/photo/6a15380073db367019602a1e-1780426277875.jpg"},"lvl":4,"status":"offline","id":"6a15380073db367019602a1e","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/5fd2fc1be14f97c1a7d2ab11c2456e62dcd391e47131112b1fc1f65ae5e7a8f7.webp","original":"https://scriptblox.com/images/photo/6a15380073db367019602a1e-1780426277875.jpg"}},"reviewed":{"name":"QueueHero","role":"reviewer","roleLabel":"Paid reviewer","at":"2026-10-16T15:33:43.216Z","profile":"/u/QueueHero"},"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":100,"conf":0.1,"n":{"w":1,"b":0,"p":0,"d":0,"k":0},"total":1,"detected":false,"key":false,"recent":0,"at":"2026-10-21T23:32:56.668Z","last":"w","win":14,"math":4,"upd":0},"isHub":true,"supportedGames":[{"_id":"6960d7e0467e0f755e11b83f","gameId":131117978948830,"placeId":131117978948830,"name":"[Testing] DMvsS","imageUrl":{"url":"https://media.kocakz.me/c208beb7851732e7daae191743d466e9ec7bedcc7f74f86ff53c8fe4c9f38fa1.webp","original":"https://tr.rbxcdn.com/180DAY-2cbd294327e54f01e449d220ef4c5c63/150/150/Image/Png/noFilter"},"thumbnail":{"url":"https://media.kocakz.me/c208beb7851732e7daae191743d466e9ec7bedcc7f74f86ff53c8fe4c9f38fa1.webp","original":"https://tr.rbxcdn.com/180DAY-2cbd294327e54f01e449d220ef4c5c63/150/150/Image/Png/noFilter"}},{"_id":"68a9b5139d3c07cb16ac1e21","gameId":135856908115931,"placeId":135856908115931,"name":"[🎃DUELS] Murderers VS