x.com/images/sb/rbx-ee3bc52d2714e45b3a2fb24a56a3073c-bb97d30adffa.png"},"placeId":135644209505876},"slug":"Disventure-ROBLOX-Camp:-DEMO-Totem-Finder-49688","verified":false,"key":false,"keyless":false,"views":2998,"executes":7,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-32e094aeb259f6f8458f3d69d58a7b84-35e7e5e4a3fe.png","scriptblox":"https://scriptblox.com/images/script/rbx-32e094aeb259f6f8458f3d69d58a7b84-35e7e5e4a3fe.png"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-32e094aeb259f6f8458f3d69d58a7b84-35e7e5e4a3fe.png","scriptblox":"https://scriptblox.com/images/script/rbx-32e094aeb259f6f8458f3d69d58a7b84-35e7e5e4a3fe.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-08-22T20:00:03.787Z","updatedAt":"2025-08-22T20:00:03.787Z","lastBump":"2025-08-22T20:00:03.787Z","script":"local Players = game:GetService(\"Players\")\nlocal player = Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal hrp = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal function setupTotem(part, text, textColor, fillColor, outlineColor)\n    local highlight = Instance.new(\"Highlight\")\n    highlight.Parent = part\n    highlight.Adornee = part\n    highlight.FillColor = fillColor\n    highlight.OutlineColor = outlineColor\n    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\n    local billboard = Instance.new(\"BillboardGui\")\n    billboard.Size = UDim2.new(5, 0, 2.5, 0)\n    billboard.AlwaysOnTop = true\n    billboard.StudsOffset = Vector3.new(0, 3, 0)\n    billboard.Parent = part\n    billboard.Adornee = part\n    local textLabel = Instance.new(\"TextLabel\")\n    textLabel.Size = UDim2.new(1, 0, 1, 0)\n    textLabel.BackgroundTransparency = 1\n    textLabel.Text = text\n    textLabel.TextColor3 = textColor\n    textLabel.TextStrokeTransparency = 0\n    textLabel.TextScaled = true\n    textLabel.Font = Enum.Font.Montserrat\n    textLabel.Parent = billboard\nend\nlocal realTotem = workspace:WaitForChild(\"Totem\"):WaitForChild(\"Totem\")\nsetupTotem(\n    realTotem,\n    \"TOTEM\",\n    Color3.fromRGB(0, 255, 0), -- green text\n    Color3.fromRGB(0, 255, 0), -- green fill\n    Color3.fromRGB(255, 0, 0)  -- red outline\n)\n\n-- Fake Totem\nlocal fakeTotem = workspace:WaitForChild(\"FakeTotemTotem\"):WaitForChild(\"Totem\")\nsetupTotem(\n    fakeTotem,\n    \"FAKE Totem\",\n    Color3.fromRGB(255, 0, 0),\n    Color3.fromRGB(255, 0, 0), \n    Color3.fromRGB(0, 0, 0)    \n)\n","features":"shows you where & who has the immunity totem!","tags":["disventure camp","disventure roblox camp","dc","disventure island"],"discord":"","keyLink":"","owner":{"_id":"678a2be337bd3df27072ca18","username":"nabnab","verified":false,"profilePicture":{"url":"https://media.kocakz.me/470fc45f16eff0d6c95ccf41cb3f716e6d624327be75939a216fe954e12bf939.webp","original":"https://scriptblox.com/images/photo/678a2be337bd3df27072ca18-1744724463486.jpg"},"lvl":12,"status":"offline","id":"678a2be337bd3df27072ca18","topMilestone":{"key":"creator.scripts","tier":10},"profile":{"url":"https://media.kocakz.me/470fc45f16eff0d6c95ccf41cb3f716e6d624327be75939a216fe954e12bf939.webp","original":"https://scriptblox.com/images/photo/678a2be337bd3df27072ca18-1744724463486.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-19T22:46:14.439Z","last":"","win":14,"math":3},"isHub":false,"supportedGames":[],"changelog":[{"_id":"68a8cc4351651381683cfa11","editBy":{"_id":"678a2be337bd3df27072ca18","username":"nabnab","status":"offline","id":"678a2be337bd3df27072ca18"},"message":"Create script","createdAt":"2025-08-22T20:00:03.789Z"},{"_id":"68a8cc6d51651381683cff11","editBy":{"_id