f #names == 1 then\n\t\treturn names[1]\n\telseif #names == 2 then\n\t\treturn names[1] .. \" and \" .. names[2]\n\telse\n\t\tlocal text = \"\"\n\t\tfor i = 1, #names - 1 do\n\t\t\ttext ..= names[i] .. \", \"\n\t\tend\n\t\treturn text .. \"and \" .. names[#names]\n\tend\nend\n\nlocal function checkAndKick()\n\tlocal found = getBadPlayers()\n\n\tif #found > 0 then\n\t\tgame.Players.LocalPlayer:Kick(formatNames(found) .. \" joined\")\n\tend\nend\n\n-- Check immediately in case they're already here.\ncheckAndKick()\n\n-- Check whenever someone joins.\nPlayers.PlayerAdded:Connect(function(player)\n\tif badUsers[player.Name] then\n\t\tcheckAndKick()\n\tend\nend)","features":"Automatically kicks you if a mod (or a known snitch that reports people) joins the server. Deltarune Connected only.","tags":["deltarune","deltarune connected","troll","trolling","kick"],"discord":"","keyLink":"","owner":{"_id":"6a3c638ce41b28e695e4146a","username":"resecle","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"6a3c638ce41b28e695e4146a","topMilestone":{"key":"creator.executions","tier":10000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:32:23.407Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a6e97ef19dc0592c9f11f8c","editBy":{"_id":"6a3c638ce41b28e695e4146a","username":"resecle","status":"offline","id":"6a3c638ce41b28e695e4146a"},"message":"Create script","createdAt":"2026-08-02T01:05:51.905Z"}],"comments":[]},{"_id":"6972648763b88be833af1f9e","title":"Noclip and Show Collisions","game":{"_id":"6972648763b88be833af1f9b","gameId":12880465992,"name":"Deltarune: Connected","imageUrl":{"url":"https://media.kocakz.me/de842f51f87bbc40e47f43a825932055b