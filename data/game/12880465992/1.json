:"6aa6f1f10b5b37eb50ce36a9"},"text":"@RandomKJuser yes i got banned because of it","parent":{"_id":"6ac1714da85c62afb189c4ee","commentBy":{"_id":"6898d88a1239d5b7b946045b","username":"RandomKJuser","profilePicture":"/images/photo/6898d88a1239d5b7b946045b-1754847450714.jpg","status":"offline","id":"6898d88a1239d5b7b946045b"},"text":"@Y3llowkiddLoreAccur really?"},"edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-10-04T21:30:57.812Z","liked":false,"disliked":false}]},{"slug":"Deltarune:-Connected-Auto-Leave-If-Mod-Joins-246247","_id":"6a6e97ef19dc0592c9f11f8a","title":"Auto Leave If Mod Joins","game":{"_id":"6972648763b88be833af1f9b","gameId":12880465992,"name":"Deltarune: Connected","imageUrl":"/images/sb/rbx-f6b90b9687f23dda8e09a3b0e38fc65d-7423e972453f.png","placeId":12880465992},"features":"Automatically kicks you if a mod (or a known snitch that reports people) joins the server. Deltarune Connected only.","tags":["deltarune","deltarune connected","troll","trolling","kick"],"script":"print(\"Working\")\n\nlocal Players = game:GetService(\"Players\")\n\nlocal badUsers = {\n\t[\"bankjinnavat\"] = true,\n\t[\"TROC_Fan\"] = true,\n\t[\"ObviousSmug\"] = true,\n\t[\"Bashoosh\"] = true,\n\t[\"billiejoe29\"] = true,\n\t[\"JoandreM\"] = true,\n\t[\"Holk2030\"] = true,\n}\n\nlocal function getBadPlayers()\n\tlocal found = {}\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tif badUsers[player.Name] then\n\t\t\ttable.insert(found, player.Name)\n\t\tend\n\tend\n\n\treturn found\nend\n\nlocal function formatNames(names)\n\tif #names == 1 then\n\t\treturn names[1]\n\telseif #names == 2 then\n\t\treturn names[1] .. \" and \" .. names[2]\n\telse\n\t\tlocal text = \"\"\n\t\tfor i = 1, #names - 1 do\n\t\t\ttext ..= names[i] .. \", \"\n\t\tend\n\t\treturn text .. \"and \" .. names[#names]\n\tend\nend\n\nlocal function checkAndKick()\n\tlocal found = getBadPlayers()\n\n\tif #found > 0 then\n\t\tgame.Players.LocalPlayer:Kick(formatNames(found) .. \" joined\")\n\tend\nend\n\n-- Check immediately in case they're already here.\ncheckAndKick()\n\n-- Check whenever someone joins.\nPlayers.PlayerAdded:Connect(function(player)\n\tif badUsers[player.Name] then\n\t\tcheckAndKick()\n\tend\nend)","owner":{"_id":"6a3c638ce41b28e695e4146a","username":"resecle","verified":false,"profilePicture":"/images/user-default.webp","status":"offline","id":"6a3c638ce41b28e695e4146a","topMilestone":{"key":"creator.executions","tier":10000}},"verified":false,"views":295,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/12880465992-1785632751884.png","likeCount":0,"dislikeCount":0,"createdAt":"2026-08-02T01:05:51.902Z","executes":860,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a6e97ef19dc0592c9f11f8c","editBy":{"_id":"6a3c638ce41b28e695e4146a","username":"resecle","status":"offline","id":"6a3c638ce41b28e695e4146a"},"message":"Create script","createdAt":"2026-08-02T01:05:51.905Z"}],"comments":[]},{"slug":"Deltarune:-Connected-Noclip-and-Show-Collisions-89692","_id":"6972648763b88be833af1f9e","title":"Noclip and Show Collisions","game":{"_id":"6972648763b88be833af1f9b","gameId":12880465992,"name":"Deltarune: Connected","imageUrl":"/images/sb/rbx-f6b90b9687f23dda8e09a3b0e38fc65d-7423e972453f.png","placeId":12880465992},"features":"makes you noclip","tags":[],"script":"-- i didnt encrypt it because its easy to make such thing\nlocal collisions = game:GetService(\"Players\").LocalPlayer.PlayerGui.GameViewport.Main:WaitForChild(\"workspace\", 500):WaitForChild(\"Collisions\", 500)\nwhile task.wait() do\n    game:GetService(\"Players\").LocalPlayer.PlayerGui.GameViewport.Fade.BackgroundTransparency = 1\n    local collisions = game:GetService(\"Players\").LocalPlayer.PlayerGui.GameViewport.Main:WaitForChild(\"workspace\", 500):WaitForChild(\"Collisions\", 500)\n    for _, collision in ipairs(collisions:GetChildren()) do\n        if collision.Name == \"Collision\" then\n            collision:SetAttribute(\"CanCollide\", false)\n            collision.Visible = true\n        end\n        if collision.Name == \"Triangle\" then\n            collision:SetAttribute(\"CanCollide\", false)\n            collision.Visible = true\n        end\n        if collision.Name == \"DoorCollision\" then\n            collision.Visible = true\n            collision:SetAttribute(\"CanCollide\", true)\n        end\n        if collision.Name == \"SpawnMarker\" then\n            collision.Visible = true\n        end\n    end\nend","owner":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","verified":false,"profilePicture":"/images/photo/685d45da2206934a9cdfd06c-1756559314331.png","status":"offline","id":"685d45da2206934a9cdfd06c","topMilestone":{"key":"creator.scripts","tier":5}},"verified":false,"views":2756,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/12880465992-1769117335481.png","likeCount":3,"dislikeCount":0,"createdAt":"2026-01-22T17:55:19.752Z","editBy":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","status":"offline","id":"685d45da2206934a9cdfd06c"},"keyLink":"","executes":838,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6972648763b88be833af1fa1","editBy":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","status":"offline","id":"685d45da2206934a9cdfd06c"},"message":"Create script - everything","createdAt":"2026-01-22T17:55:19.756Z"},{"_id":"697265537b4426d379baefb2","editBy":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","status":"offline","id":"685d45da2206934a9cdfd06c"},"message":"Update script - added more stuff","createdAt":"2026-01-22T17:58:43.275Z"},{"_id":"6972679e069388e3d09e5f88","editBy":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","status":"offline","id":"685d45da2206934a9cdfd06c"},"message":"Update script - lil thing cuz yes","createdAt":"2026-01-22T18:08:30.837Z"}],"c