sion\" then\n            collision:SetAttribute(\"CanCollide\", false)\n            collision.Visible = true\n        end\n        if collision.Name == \"Triangle\" then\n            collision:SetAttribute(\"CanCollide\", false)\n            collision.Visible = true\n        end\n        if collision.Name == \"DoorCollision\" then\n            collision.Visible = true\n            collision:SetAttribute(\"CanCollide\", true)\n        end\n        if collision.Name == \"SpawnMarker\" then\n            collision.Visible = true\n        end\n    end\nend","features":"makes you noclip","tags":[],"discord":"","keyLink":"","owner":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","verified":false,"profilePicture":{"url":"https://media.kocakz.me/8798e784fe2be2f4c75995fb53379e6d00badb4bff0db94d36a963fc3388976a.webp","original":"https://scriptblox.com/images/photo/685d45da2206934a9cdfd06c-1756559314331.png"},"status":"offline","id":"685d45da2206934a9cdfd06c","topMilestone":{"key":"creator.scripts","tier":5},"profile":{"url":"https://media.kocakz.me/8798e784fe2be2f4c75995fb53379e6d00badb4bff0db94d36a963fc3388976a.webp","original":"https://scriptblox.com/images/photo/685d45da2206934a9cdfd06c-1756559314331.png"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":1,"k":0},"total":1,"detected":false,"key":false,"recent":1,"at":"2026-10-22T02:42:41.858Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6972648763b88be833af1fa1","editBy":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","status":"offline","id":"685d45da2206934a9cdfd06c"},"message":"Create script - everything","createdAt":"2026-01-22T17:55:19.756Z"},{"_id":"697265537b4426d379baefb2","editBy":{"_id":"685d45da2206934a9cdfd06c","username":"espresso","status":"offline","id":"685d45da2206934a9cdfd06c"},"message":"Update script - added more stuff","createdAt":"2026-01-22T17:58:43.275Z"},{"_id":"6972679e06