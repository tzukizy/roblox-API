{"id":14350413280,"name":"[UPD] Ice Fishing Simulator 🐟","desc":"🪙 Use code 'COOKING' for 5,000 Coins\n\n🎉 Friend and Group Bonuses!\nGet a 10% coin bonus for having a friend in your server and an additional 10% for being a group member. 💰 Note: Rejoin the server for these bonuses to take effect.\n\n🐟 Catch Fish, Collect Fish, Cash In Fish!\nDrill your ice hole and dive into your fishing adventure! Fill your coolers with fish of all kinds and sell your catches at the fish market for coins. 🐠💰\n\n🛠️ Upgrade Your Fishing Gear!\nStart with basic fishing tools and work your way up! Buy bigger coolers to store more fish, advanced fishing rods, and even automated fishing poles that fish for you! 🎣🔧\n\n🎨 Customize Your Fishing Space!\nBuy furnishings with special buffs for fishing and use the Color Bar to make your space unique! 🛋️","path":"/game/14350413280-ice-fishing-simulator","slug":"14350413280-ice-fishing-simulator","thumbnail":{"url":"https://media.kocakz.me/8accaccf30967d92b7a8f7a186443ad924c5a32f291f75085eaaf59185c37716.webp","original":"https://tr.rbxcdn.com/180DAY-857bc22c38705ca26645cc8c88d24819/150/150/Image/Png/noFilter"},"playing":368,"visitor":76333671,"verified":false,"updatedAt":"2024-09-19T15:19:19.490Z","creator":{"name":"WildGuest Games","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":1},"page":1,"next":null,"total":1,"scripts":[{"slug":"UPD-Ice-Fishing-Simulator-Money-Farm-18624","_id":"66ec40f7cd7b5985c752d5da","title":"Money Farm","game":{"_id":"67e5e1ffb360710ec3c78083","gameId":14350413280,"name":"[UPD] Ice Fishing Simulator 🐟","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":14350413280},"features":"Hi just join execute the first script a couple times then the second script and get an Anti afk","tags":[],"script":"--First Script \nfor i,v in pairs(workspace.CaveObby.Stages:GetDescendants()) do \n    if v.Name == \"Lava\" or  v.Name == \"KillPart\" or  v.Name == \"SpikeLog\" then\n        v:Destroy()\n    end\nend\n\n--Second Script \nlocal TweenService = game:GetService(\"TweenService\")\nlocal player = game.Players.LocalPlayer\nlocal character = player.Character or player.CharacterAdded:Wait()\nlocal humanoidRootPart = character:WaitForChild(\"HumanoidRootPart\")\n\nlocal stages = {\n    workspace.CaveObby.Stages[\"1\"].Spawn,\n    workspace.CaveObby.Stages[\"2\"].Checkpoint,\n    workspace.CaveObby.Stages[\"3\"].Checkpoint,\n    workspace.CaveObby.Stages[\"4\"].Checkpoint,\n}\n\nlocal function tweenToPosition(position)\n    local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)\n    local goal = {CFrame = position.CFrame}\n\n    local tween = TweenService:Create(humanoidRootPart, tweenInfo, goal)\n    tween:Play()\n    tween.Completed:Wait() \nend\n\nwhile true do\n    for _, stage in ipairs(stages) do\n        if stage then\n            tweenToPosition(stage)\n            task.wait(1) \n        end\n    end\nend\n","owner":{"_id":"6227c42f7944271798ea1b15","username":"BeboMods","verified":true,"profilePicture":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"},"lvl":15,"status":"offline","id":"6227c42f7944271798ea1b15","leaderboard":{"tag":null},"topMilestone":{"key":"creator.chart_topper","tier":1},"profile":{"url":"https://media.kocakz.me/2aa44350e3b5d4cb2aaffa5729675d006e73d3cebcfc1df90a01fe40b402064a.webp","original":"https://scriptblox.com/images/photo/6227c42f7944271798ea1b15-1744552011109.jpeg"}},"verified":true,"keyLink":"","views":160465,"scriptType":"free","isUniversal":false,"isPatched":true,"visibility":"public","createdAt":"2024-09-19T15:19:19.490Z","dislikeCount":4,"likeCount":3,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/25b1222c44