{"id":123728734372819,"name":"(QOL + DESTRUCTION) NPC Builders Demo","desc":"","path":"/game/123728734372819-qol-destruction-npc-builders-demo","slug":"123728734372819-qol-destruction-npc-builders-demo","thumbnail":["https://tr.rbxcdn.com/180DAY-95aea212da8af6bab1fcd71b91b29997/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-72f64efcd354ecff0807a49265997650/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":48,"visitor":0,"verified":false,"updatedAt":"2026-07-29T02:39:55.751Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"(QOL-+-DESTRUCTION)-NPC-Builders-Demo-Auto-Destroy-all-Builds-246186","_id":"6a6967fb4aac101356428eb1","title":"Auto Destroy all Builds","game":{"_id":"6a6967fb4aac101356428eb0","gameId":123728734372819,"name":"(QOL + DESTRUCTION) NPC Builders Demo","imageUrl":"/images/sb/rbx-72f64efcd354ecff0807a49265997650-112aa8abe198.png","placeId":123728734372819},"features":"Automatically destroys everyone's build extremely fast\n() Opensourced","tags":[],"script":"_G.Enabled = true\n\n-- hold out the fists tool upon exection\n-- Also works as a server lagger/crasher\n\nlocal idk = game:GetService(\"ReplicatedStorage\").RemoteEvent\nlocal wows = game:GetService(\"RunService\")\n\nlocal function gab()\n    local parts = {}\n    local buildFolder = workspace:FindFirstChild(\"NPCBuildFolder\")\n    if not buildFolder then return parts end\n    for _, folder in pairs(buildFolder:GetChildren()) do\n        if string.match(folder.Name, \"'s Folder$\") then\n            for _, child in pairs(folder:GetChildren()) do\n                if child.Name == \"Model\" then\n                    for _, part in pairs(child:GetChildren()) do\n                        if part:IsA(\"BasePart\") then\n                            table.insert(parts, part)\n                        end\n                    end\n                end\n            end\n        end\n    end\n    return parts\nend\n\nlocal function damn()\n    local parts = gab()\n    if #parts == 0 then return end\n    for _, part in pairs(parts) do\n        if not _G.Enabled then break end\n        local punchCFrame = CFrame.new(\n            part.Position.X,\n            part.Position.Y + 1,\n            part.Position.Z\n        )\n        idk:FireServer(\"BreakFists\", punchCFrame)\n    end\nend\n\nwow = wows.Heartbeat:Connect(function()\n    if _G.Enabled then\n        damn()\n    end\nend)","owner":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","verified":false,"profilePicture":"/images/photo/665152598dd22f2885e42ceb-1770235984127.png","status":"offline","id":"665152598dd22f2885e42ceb","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50}},"verified":false,"views":3317,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-72f64efcd354ecff0807a49265997650-112aa8abe198.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-07-29T02:39:55.752Z","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"keyLink":"","executes":400,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a6967fb4aac101356428eb3","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Create script","createdAt":"2026-07-29T02:39:55.755Z"},{"_id":"6a696849a5286d69a5e2931d","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Update script","createdAt":"2026-07-29T02:41:13.619Z"},{"_id":"6a69690615f905cc57562562","editBy":{"_id":"665152598dd22f2885e42ceb","username":"mcdaggitt","status":"offline","id":"665152598dd22f2885e42ceb"},"message":"Switched to older method","createdAt":"2026-07-29T02:44:22.096Z"}],"comments":[{"_id":"6a696c223adc63b