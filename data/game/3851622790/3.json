:24130,"executes":87,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/9c0959da959a19329cc4383686941b57/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/9c0959da959a19329cc4383686941b57/500/280/Image/Jpeg"},"thumbnail":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/9c0959da959a19329cc4383686941b57/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/9c0959da959a19329cc4383686941b57/500/280/Image/Jpeg"},"likeCount":2,"dislikeCount":1,"createdAt":"2022-04-17T20:36:46.044Z","updatedAt":"2022-04-17T20:36:46.044Z","lastBump":"2022-04-17T20:36:46.044Z","script":"game:GetService(\"Players\").LocalPlayer.Chatted:Connect(function(Msg)\n    local RepStorage = game:GetService(\"ReplicatedStorage\")\n    local RepEvents = RepStorage:FindFirstChild(\"RemoteEvents\")\n    -- Tool-Controls\n    if Msg == \"/e pizza\" then\n    RepEvents.GiveTool:FireServer(\"Pizza3\")\n    elseif Msg == \"/e epicpizza\" then\n        RepEvents.GiveTool:FireServer(\"EpicPizza\")\n    elseif Msg == \"/e chips\" then\n        RepEvents.GiveTool:FireServer(\"Chips\")\n    elseif Msg == \"/e pie\" then\n       RepEvents.GiveTool:FireServer(\"Pie\")\n    elseif Msg == \"/e apple\" then\n        RepEvents.GiveTool:FireServer(\"Apple\")\n    elseif Msg == \"/e bloxycola\" then\n        RepEvents.GiveTool:FireServer(\"BloxyCola\")\n    elseif Msg == \"/e superheal\" then\n        RepEvents.GiveTool:FireServer(\"Cure\")\n    elseif Msg == \"/e medkit\" then\n        RepEvents.GiveTool:FireServer(\"MedKit\")\n    elseif Msg == \"/e bat\" then\n        RepEvents.GiveTool:FireServer(\"Bat\")\n    elseif Msg == \"/e linkedsword\" then\n        RepEvents.GiveTool:FireServer(\"LinkedSword\")\n    elseif Msg == \"/e lollipop\" then\n        RepEvents.GiveTool:FireServer(\"Lollipop\")\n    -- Kitchen-Controls\n    elseif Msg == \"/e foodevent\" then\n        RepEvents.BloxyPack:FireServer(1)\n    -- Basement-Controls\n    elseif Msg == \"/e unlockbasement\" then\n        RepEvents.UnlockDoor:FireServer()\n    elseif Msg == \"/e basementlights\" then\n        RepEvents.BasementMission:FireServer()\n        RepEvents.basementLights:FireServer()\n    elseif Msg == \"/e equipladder\" then\n        RepEvents.Ladder:FireServer(1)\n    elseif Msg == \"/e dropladder\" then\n        RepEvents.Ladder:FireServer(2)\n      end\n  end)","features":"-- Tool-Controls\n/e pizza\n/e epicpizza\n/e chips\n/e pie\n/e apple\n/e bloxycola\n/e superheal\n/e medkit\n/e bat\n/e linkedsword\n/e lollipop\n-- Kitchen-Controls\n/e foodevent\n-- Basement-Controls\n/e unlockbasement\n/e basementlights\n/e equipladder\n/e dropladder","tags":["Private Commands","Basement Controls","Tool Controls","Multiple Execution"],"discord":"","keyLink":"","owner":{"_id":"625c73d4c4c4f04e7b53c1db","username":"ryanjtparker","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"625c73d4c4c4f04e7b53c1db","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T03:23:46.080Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"67e5e1e2b360710ec3c4b345","editBy":{"_id":"625c73d4c4c4f04e7b53c1db","username":"ryanjtparker","status":"offline","id":"625c73d4c4c4f04e7b53c1db"},"message":"Create script","createdAt":"2022-04-17T21:09:18.871Z"},{"_id":"67e5e1e2b360710ec3c4b346","editBy":{"_id":"625c73d4c4c4f04e7b53c1db","username":"ryanjtparker","status":"offline","id":"625c73d4c4c4f04e7b53c1db"},"message":"Update script","createdAt":"2022-04-17T21:22:56.345Z"},{"_id":"67e5e1e2b360