input\n\tend\nend)\n\nUserInputService.InputChanged:Connect(function(input)\n\tif input == dragInput and dragging then\n\t\tlocal delta = input.Position - dragStart\n\t\tframe.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)\n\tend\nend)\n\nupdateLang()","features":"This is a simple script with 3 main buttons:\n\n1. A teleport button that moves you directly .\n\n\n2. An auto teleport toggle button that teleports you automatically \n\n\n3. A language switch button to toggle between Arabic and English.\n\n\n🔐 License:\nThis script is open source. You are free to modify, improve, or use it in any project without restrictions","tags":[],"discord":"","keyLink":"","owner":{"_id":"66a19de42368ec6bf0c3cc5a","username":"1w69","verified":false,"profilePicture":{"url":"https://media.kocakz.me/6e719d1ae34b0879781017bec068f0956ffdba9e8820a702ad43a08260e2610a.webp","original":"https://scriptblox.com/images/photo/66a19de42368ec6bf0c3cc5a-1768169675441.jpg"},"status":"offline","id":"66a19de42368ec6bf0c3cc5a","leaderboard":{"tag":null},"topMilestone":{"key":"creator.scripts","tier":50},"profile":{"url":"https://media.kocakz.me/6e719d1ae34b0879781017bec068f0956ffdba9e8820a702ad43a08260e2610a.webp","original":"https://scriptblox.com/images/photo/66a19de42368ec6bf0c3cc5a-1768169675441.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-22T02:58:44.333Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6873faea8b04a560d8bd20ca","editBy":{"_id":"66a19de42368ec6bf0c3cc5a","username":"1w69","status":"offline","id":"66a19de42368ec6bf0c3cc5a"},"message":"Create script","createdAt":"2025-07-13T18:28:58.986Z"}],"comments":[{"_id":"6874007c1657faeb5e0334f8","commentBy":{"_id":"6871b68691f266e2634f7296","username":"Tester_script","verified":false,"r