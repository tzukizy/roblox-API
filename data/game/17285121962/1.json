em\")\nlocal TroopsFolder = ReplicatedStorage:WaitForChild(\"Assets\"):WaitForChild(\"Troops\")\n\nlocal function buyTower(towerName)\n    local args = { towerName }\n    local success, err = pcall(function()\n        InteractItem:InvokeServer(unpack(args))\n    end)\n    if success then\n        print(\"Bought tower:\", towerName)\n    else\n        warn(\"Failed to buy tower:\", towerName, err)\n    end\nend\n\nfor _, tower in ipairs(TroopsFolder:GetChildren()) do\n    buyTower(tower.Name)\n    task.wait(0.2)\nend\n","owner":{"_id":"6585d90c72939a8434f2a7ae","username":"SkidRBLX","verified":false,"profilePicture":"/images/photo/6585d90c72939a8434f2a7ae-1741422465123.jpg","status":"offline","id":"6585d90c72939a8434f2a7ae","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":3343,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-82650727ebf01d8ab3d69647577ad5f3-69804072ceca.png","likeCount":3,"dislikeCount":2,"createdAt":"2026-02-03T17:30:44.793Z","keyLink":"","executes":457,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"698230c4e08449ad12e2329c","editBy":{"_id":"6585d90c72939a8434f2a7ae","username":"SkidRBLX","status":"offline","id":"6585d90c72939a8434f2a7ae"},"message":"Create script","createdAt":"2026-02-03T17:30:44.795Z"}],"comments":[{"_id":"698237b04bfacc3469085283","commentBy":{"_id":"6951bbe29e76483198e3ebe5","username":"A_dummy0","verified":false,"role":"user","profilePicture":"/images/photo/6951bbe29e76483198e3ebe5-1766964465789.jpg","lastActive":"2026-04-04T16:49:06.024Z","createdAt":"2025-12-28T23:23:14.966Z","status":"offline","id":"6951bbe29e76483198e3ebe5"},"text":"How does this work?","edited":false,"likeCount":1,"dislikeCount":0,"createdAt":"2026-02-03T18:00:16.284Z","liked":false,"disliked":false},{"_id":"69823922f168b5c5b08f1925","commentBy":{"_id":"697cb282424ae5ab0f1a556c","username":"arriekley3","verified":fal