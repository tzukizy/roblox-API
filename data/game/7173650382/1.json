{"id":7173650382,"name":"Kingdom Life™ II ","desc":"Make sure to favorite and like! It lets me know that you want to see more!\r\n\r\nThis is a re-up of the original version of Kingdom Life II created by Boopbot. The original which has been broken due to ROBLOX updates. I thought it would be nice to fix it for us all seeing as we absolutely loved playing this game and it really sucked to see this game go. Anyway, by re-scripting everything, I managed to get the game working again! ","path":"/game/7173650382-kingdom-lifetm-ii","slug":"7173650382-kingdom-lifetm-ii","thumbnail":{"url":"https://cdn.kocakz.me/images/9bd6f9452a00541ee6b79d7dc11f11b57605ca5eea193554b9eead1315630e01.webp","original":"https://tr.rbxcdn.com/180DAY-ea2e80f86f3ee22ddf718ebc51109afa/150/150/Image/Png/noFilter"},"playing":0,"visitor":2130551,"verified":false,"updatedAt":"2025-12-11T06:41:13.902Z","creator":{"name":"AgeOfReclamationn","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Kingdom-Lifetm-II-Kingdom-life-fling-all-74121","_id":"693a678906da572cb7fb8aa9","title":"Kingdom life fling all","game":{"_id":"693a678906da572cb7fb8aa6","gameId":7173650382,"name":"Kingdom Life™ II ","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":7173650382},"features":"Flings everyone","tags":[],"script":"function Destroy(instance)\n    spawn(function()\n        for _, folder in ipairs(game.ReplicatedStorage.Remotes:GetChildren()) do\n            if folder:IsA(\"Folder\") then\n                for _, obj in ipairs(folder:GetChildren()) do\n                    if obj:IsA(\"RemoteEvent\") then\n                        pcall(function()\n                            obj:FireServer(instance)\n                        end)\n                    end\n                end\n            end\n        end\n    end)\nend\n\n-- Call Destroy for every Instance in workspace\nfor _, v in ipairs(workspace:GetDescendants()) do\n    if v:IsA(\"Instance\") then\n        Destroy(v)\n    end\nend","owner":{"_id":"6918112007b364b4dfcad33b","username":"tungtunggods808s","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/449b93e7d8aeee44c763cf6e1018f31332060697a5ebb0475623d6a3b98c002d.webp","original":"https://scriptblox.com/images/photo/6918112007b364b4dfcad33b-1791312313738.jpg"},"status":"offline","id":"6918112007b364b4dfcad33b","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://cdn.kocakz.me/images/449b93e7d8aeee44c763cf6e1018f31332060697a5ebb0475623d6a3b98c002d.webp","original":"https://scriptblox.com/images/photo/6918112007b364b4dfcad33b-1791312313738.jpg"}},"verified":false,"views":922,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/fef61424de64caaab7e344ad695da51c8677862ef8bb5c93b8912a800649538e.webp","original":"https://scriptblox.com/images/sb/7173650382-1765435273880.webp","scriptblox":"https://scriptblox.com/images/script/7173650382-1765435273880.webp"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-12-11T06:41:13.904Z","editBy":{"_id":"6918112007b364b4dfcad33b","username":"tungtunggods808s","status":"offline","id":"6918112007b364b4dfcad33b"},"keyLink":"","executes":125,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T02:42:09.682Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/fef61424de64caaab7e344ad695da51c8677862ef8bb5c93b8912a800649538e.webp","original":"https://scriptblox.com/images/sb/7173650382-1765435273880.webp","scriptblox":"https://scriptblox.com/images/script/7173650382-1765435273880.webp"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"693a678906da572cb7fb8aab","editBy":{"_id":"6918112007b364b4d