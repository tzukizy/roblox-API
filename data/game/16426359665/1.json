{"id":16426359665,"name":"PARANORMAL [HORROR]","desc":"","path":"/game/16426359665-paranormal-horror","slug":"16426359665-paranormal-horror","thumbnail":["https://tr.rbxcdn.com/180DAY-bc3932457ed28af169579ee56861298b/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-4892c186c71872ebf3cb2f27707c3ce1/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":186,"visitor":0,"verified":false,"updatedAt":"2026-05-14T05:09:42.408Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"PARANORMAL-HORROR-Esp-215466","_id":"6a05591662d19136a9586dea","title":"Esp","game":{"_id":"699fdb005cb5d29f784dfcf2","gameId":16426359665,"name":"PARANORMAL [HORROR]","imageUrl":"/images/sb/rbx-4892c186c71872ebf3cb2f27707c3ce1-82214713a785.png","placeId":16426359665},"features":"esp \nitems\nmannequin\nbuddy","tags":[],"script":"local workspace = game:GetService(\"Workspace\")\nlocal runService = game:GetService(\"RunService\")\n\nlocal function createHighlight(obj)\n\tif obj then\n\t\tlocal highlight = Instance.new(\"Highlight\")\n\t\thighlight.OutlineColor = Color3.fromRGB(255, 255, 255)\n\t\thighlight.FillTransparency = 0.4\n\t\thighlight.Parent = obj\n\t\treturn highlight\n\tend\n\treturn nil\nend\n\nlocal mannequin = workspace:FindFirstChild(\"Mannequin\")\nlocal items = workspace:FindFirstChild(\"Items\")\nlocal buddy = workspace:FindFirstChild(\"Buddy\")\n\nlocal mannequinHighlight = createHighlight(mannequin)\nlocal itemsHighlight = createHighlight(items)\nlocal buddyHighlight = createHighlight(buddy)\n\nlocal hue = 0\nlocal speed = 0.5\n\nrunService.RenderStepped:Connect(function(deltaTime)\n\thue = (hue + deltaTime * speed) % 1\n\t\n\tif mannequinHighlight then\n\t\tmannequinHighlight.FillColor = Color3.fromHSV(hue, 1, 1)\n\tend\n\t\n\tif itemsHighlight then\n\t\titemsHighlight.FillColor = Color3.fromHSV((hue + 0.33) % 1, 1, 1)\n\tend\n\t\n\tif buddyHighlight then\n\t\tbuddyHighlight.FillColor = Color3.fromHSV((hue + 0.67) % 1, 1, 1)\n\tend\nend)","owner":{"_id":"666d21be51d909111135e725","username":"cocom","verified":false,"profilePicture":"/images/photo/666d21be51d909111135e725-1779682574201.jpg","status":"offline","id":"666d21be51d909111135e725","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":2661,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/16426359665-1778735382395.jpg","likeCount":2,"dislikeCount":0,"createdAt":"2026-05-14T05:09:42.412Z","executes":492,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a05591662d19136a9586ded","editBy":{"_id":"666d21be51d909111135e725","username":"cocom","status":"offline","id":"666d21be51d909111135e725"},"message":"Create script","createdAt":"2026-05-14T05:09:42.416Z"}],"comments":[{"_id":"6a1ba0a2e282a53163a02fc5","commentBy":{"_id":"6a1ba0650937056f4ee34406","username":"Lithiumbattery","verified":false,"role":"user","profilePicture":"/images/user-default.webp","lastActive":"2026-06-01T02:09:58.872Z","createdAt":"2026-05-31T02:43:49.441Z","status":"offline","id":"6a1ba0650937056f4ee34406"},"text":"Good script ngl","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-05-31T02:44:50.296Z","liked":false,"disliked":false},{"_id":"6a233bdf3ceebed6ce4c90d0","commentBy":{"_id":"666d21be51d909111135e725","username":"cocom","verified":false,"role":"user","profilePicture":"/images/photo/666d21be51d909111135e725-1779682574201.jpg","createdAt":"2024-06-15T05:08:14.120Z","lastActive":"2026-06-11T02:21:27.034Z","status":"offline","id":"666d21be51d909111135e725","topMilestone":{"key":"creator.first_script","tier":1}},"text":"@Lithiumbattery Thank You","parent":{"_id":"6a1ba0a2e282a53163a02fc5","commentBy":{"_id":"6a1ba0650937056f4ee34406","username":"Lithiumbattery","profilePicture":"/images/user-default.webp","status":"offline","id":"6a1ba0650937056