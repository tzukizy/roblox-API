\n\tend\n\t\n\tif itemsHighlight then\n\t\titemsHighlight.FillColor = Color3.fromHSV((hue + 0.33) % 1, 1, 1)\n\tend\n\t\n\tif buddyHighlight then\n\t\tbuddyHighlight.FillColor = Color3.fromHSV((hue + 0.67) % 1, 1, 1)\n\tend\nend)","features":"esp \nitems\nmannequin\nbuddy","tags":[],"discord":"","keyLink":"","owner":{"_id":"666d21be51d909111135e725","username":"cocom","verified":false,"profilePicture":{"url":"https://media.kocakz.me/9989d5de469aea860b31bd99c1e6101a1034264cf35e5a93e5288384ec3cfed3.webp","original":"https://scriptblox.com/images/photo/666d21be51d909111135e725-1779682574201.jpg"},"status":"offline","id":"666d21be51d909111135e725","topMilestone":{"key":"creator.first_script","tier":1},"profile":{"url":"https://media.kocakz.me/9989d5de469aea860b31bd99c1e6101a1034264cf35e5a93e5288384ec3cfed3.webp","original":"https://scriptblox.com/images/photo/666d21be51d909111135e725-1779682574201.jpg"}},"reviewed":null,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-21T02:31:13.621Z","last":"","win":14,"math":4},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a05591662d19136a9586ded","editBy":{"_id":"666d21be51d909111135e725","username":"cocom","status":"offline","id":"666d21be51d909111135e725"},"message":"Create script","createdAt":"2026-05-14T05:09:42.416Z"}],"comments":[{"_id":"6a1ba0a2e282a53163a02fc5","commentBy":{"_id":"6a1ba0650937056f4ee34406","username":"Lithiumbattery","verified":false,"role":"user","profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"lastActive":"2026-06-01T02:09:58.872Z","createdAt":"2026-05-31T02:43:49.441Z","status":"offline","id":"6a1ba0650937056f4ee34406","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"text":"Good script ngl","edited":false,"likeCount":2,"dislikeCount":0,"createdAt":"2026-05-31T02:44:50.296Z","liked":false,"disliked":false}