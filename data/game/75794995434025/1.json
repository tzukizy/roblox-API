/main/GrowaBusiness\"))()","owner":{"_id":"682cc6e6713426a91fc9cda5","username":"Emre58","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/35164c3c0c7e84b0ca57b5c4cfcf5e5c2ae3e103baf9f5bd31c98be00e3b297d.webp","original":"https://scriptblox.com/images/photo/682cc6e6713426a91fc9cda5-1747765033507.jpeg"},"status":"offline","id":"682cc6e6713426a91fc9cda5","topMilestone":{"key":"creator.likes","tier":100},"profile":{"url":"https://cdn.kocakz.me/images/35164c3c0c7e84b0ca57b5c4cfcf5e5c2ae3e103baf9f5bd31c98be00e3b297d.webp","original":"https://scriptblox.com/images/photo/682cc6e6713426a91fc9cda5-1747765033507.jpeg"}},"verified":false,"views":9190,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-2fdbcccfef43209c42aa30275ae2bee6-8946a8f61973.png","scriptblox":"https://scriptblox.com/images/script/rbx-2fdbcccfef43209c42aa30275ae2bee6-8946a8f61973.png"},"likeCount":1,"dislikeCount":2,"createdAt":"2025-05-30T19:33:55.626Z","executes":14,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:00:51.942Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-2fdbcccfef43209c42aa30275ae2bee6-8946a8f61973.png","scriptblox":"https://scriptblox.com/images/script/rbx-2fdbcccfef43209c42aa30275ae2bee6-8946a8f61973.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"683a0823901cfa8ce8dd1008","editBy":{"_id":"682cc6e6713426a91fc9cda5","username":"Emre58","status":"offline","id":"682cc6e6713426a91fc9cda5"},"message":"Create script","createdAt":"2025-05-30T19:33:55.629Z"}],"comments":[]},{"slug":"Grow-a-Business-Grow-a-Business-Open-Source-41331","_id":"68394401fa26c838042244cd","title":"Open Source","game":{"_id":"683451fbfa26c83804a1c0a1","gameId":75794995434025,"name":"[⏰] Grow a Business💸","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":75794995434025},"features":"[+] Auto Place\n[+] Auto Buy\n[+] Auto Collect","tags":[],"script":"--// Services\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal player = Players.LocalPlayer\nlocal userid = player.UserId\n\n--// Remotes\nlocal RemoteEvents = ReplicatedStorage:WaitForChild(\"RemoteEvents\")\nlocal BuyEmployee = RemoteEvents:WaitForChild(\"BuyEmployee\")\nlocal PlaceEmployee = RemoteEvents:WaitForChild(\"PlaceEmployee\")\nlocal GetShopData = ReplicatedStorage:WaitForChild(\"RemoteFunctions\"):WaitForChild(\"GetShopData\")\n\n--// Flags\nlocal autoBuy = false\nlocal autoPlace = false\nlocal autoCollect = false\n\n--// Create UI\nlocal screenGui = Instance.new(\"ScreenGui\", player:WaitForChild(\"PlayerGui\"))\nscreenGui.Name = \"EmployeeAutoGui\"\n\nlocal function createButton(name, position, callback)\n\tlocal button = Instance.new(\"TextButton\")\n\tbutton.Size = UDim2.new(0, 150, 0, 40)\n\tbutton.Position = position\n\tbutton.Text = name .. \": OFF\"\n\tbutton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)\n\tbutton.TextColor3 = Color3.fromRGB(255, 255, 255)\n\tbutton.Font = Enum.Font.Gotham\n\tbutton.TextSize = 18\n\tbutton.Parent = screenGui\n\t\n\tlocal state = false\n\tbutton.MouseButton1Click:Connect(function()\n\t\tstate = not state\n\t\tbutton.Text = name .. \": \" .. (state and \"ON\" or \"OFF\")\n\t\tcallback(state)\n\tend)\nend\n\n--// Auto Buy\ncreateButton(\"Auto Buy\", UDim2.new(0, 20, 0, 100), function(state)\n\tautoBuy = state\n\tif autoBuy then\n\t\ttask.spawn(function()\n\t\t\twhile autoBuy do\n\t\t\t\tlocal shopInfo = GetShopData:InvokeServer()\n\t\t\t\tfor _, v in pairs(shopInfo) do\n\t\t\t\t\tBuyEmployee:FireServer(v[\"Name\"])\n\t\t\t\t\ttask.wait(0.1)\n\t\t\t\tend\n\t\t\t\ttask.wait(2)\n\t\t\tend\n\t\tend)\n\tend\nend)\n\n--// Auto Place\n-- Auto Place\ncreateButton(\"Auto Place\", UDim2.new(0, 20, 0, 150), function(state)\n\tautoPlace = state\n\tif autoPlace then\n\t\ttask.spawn(function()\n\t\t\twhile autoPlace do\n\t\t\t\tlocal assignedPlot = player:GetAttribute(\"AssignedPlot\")\n\t\t\t\tif assignedPlot then\n\t\t\t\t\tfor _, plot in pairs(workspace.BasePlots:GetChildren()) do\n\t\t\t\t\t\tif plot.Name == assignedPlot then\n\t\t\t\t\t\t\tlocal placement = plot:FindFirstChild(\"Placement\")\n\t\t\t\t\t\t\tif not placement then return end\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tlocal baseCFrame = placement.CFrame\n\t\t\t\t\t\t\tlocal size = placement.Size\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- Grid spacing\n\t\t\t\t\t\t\tlocal spacing = 5\n\t\t\t\t\t\t\tlocal maxX = math.floor(size.X / spacing)\n\t\t\t\t\t\t\tlocal maxZ = math.floor(size.Z / spacing)\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tlocal index = 0\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tfor _, pack in pairs(player.Backpack:GetChildren()) do\n\t\t\t\t\t\t\t\tlocal EmployeeType = pack:GetAttribute(\"EmployeeType\")\n\t\t\t\t\t\t\t\tlocal Variant = pack:GetAttribute(\"Variant\")\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tif EmployeeType and Variant then\n\t\t\t\t\t\t\t\t\tlocal x = (index % maxX - maxX / 2) * spacing\n\t\t\t\t\t\t\t\t\tlocal z = (math.floor(index / maxX) - maxZ / 2) * spacing\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tlocal pos = baseCFrame * CFrame.new(x, 5, z)\n\t\t\t\t\t\t\t\t\tPlaceEmployee:FireServer(EmployeeType, Variant, pos)\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tindex += 1\n\t\t\t\t\t\t\t\t\ttask.wait(0.1)\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(2)\n\t\t\tend\n\t\tend)\n\tend\nend)\n\n--// Auto Collect\ncreateButton(\"Auto Collect\", UDim2.new(0, 20, 0, 200), function(state)\n\tautoCollect = state\n\tif autoCollect then\n\t\ttask.spawn(function()\n\t\t\twhile autoCollect do\n\t\t\t\tfor _, v in pairs(workspace.PlacedEmployees:GetChildren()) do\n\t\t\t\t\tif v:IsA(\"Model\") and v:GetAttribute(\"OwnerUserId\") == userid then\n\t\t\t\t\t\tlocal CollectCash = v:FindFirstChild(\"CollectCash\")\n\t\t\t\t\t\tif CollectCash then\n\t\t\t\t\t\t\tlocal prompt = CollectCash:FindFirstChildOfClass(\"ProximityPrompt\")\n\t\t\t\t\t\t\tif prompt and prompt.Enabled then\n\t\t\t\t\t\t\t\tfireproximityprompt(prompt, 1)\n\t\t\t\t\t\t\t\ttask.wait(0.05)\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(1)\n\t\t\tend\n\t\tend)\n\tend\nend)\n","owner":{"_id":"67fab7f4f2b897410493aab6","username":"Zemon07","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/1bd5c19ec889a4feca5cca4502a9a21a121aacae9f67d0f6da220d78b88850a8.webp","original":"https://scriptblox.com/images/photo/67fab7f4f2b897410493aab6-1790848179667.png"},"lvl":12,"status":"offline","id":"67fab7f4f2b897410493aab6","topMilestone":{"key":"creator.scripts","tier":25},"profile":{"url":"https://cdn.kocakz.me/images/1bd5c19ec889a4feca5cca4502a9a21a121aacae9f67d0f6da220d78b88850a8.webp","original":"https://scriptblox.com/images/photo/67fab7f4f2b897410493aab6-1790848179667.png"}},"verified":false,"views":6480,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-90f3c69e318d28327afef20bf5823836-83ff72cd5529.png","scriptblox":"https://scriptblox.com/images/script/rbx-90f3c69e318d28327afef20bf5823836-83ff72cd5529.png"},"likeCount":0,"dislikeCount":0,"createdAt":"2025-05-30T05:37:05.239Z","executes":14,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-15T03:00:53.162Z"},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-script.webp","original":"https://scriptblox.com/images/sb/rbx-90f3c6