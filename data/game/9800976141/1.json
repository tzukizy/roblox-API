{"id":9800976141,"name":"Pandi's Aim Trainer","desc":"Welcome to Pandi's Aim Trainer! 🐼\n\n[In case you encounter a bug, have suggestions or see a cheater on the leaderboard, please let us know by writing feedback!]\n\nController & Mobile support has been added!\n\nControls:\nR - Start/Restart Scenario\nG - End Scenario\n\nWant to improve your aim? Then this is the right place for you! A Great Aim Trainer made to help improve your aiming skills and make you one of the best players in games such as Rivals, Arsenal and Bad Business. 🎯💪\n(A WIP experience inspired by Aimbeast & KovaaK's)","path":"/game/9800976141-pandi-s-aim-trainer","slug":"9800976141-pandi-s-aim-trainer","thumbnail":{"url":"https://media.kocakz.me/005173a6302121e50de95d01f47661a6abb1f702ac7987a98f9b98ee8a323216.webp","original":"https://tr.rbxcdn.com/180DAY-66c005e82327ea0b73b5e742355d5e4c/150/150/Image/Png/noFilter"},"playing":86,"visitor":9538298,"verified":false,"updatedAt":"2026-05-10T18:15:02.577Z","creator":{"name":"deersaim","type":"User"},"script":{"count":5,"freeCount":5,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Pandi's-Aim-Trainer-Aim-trainer-213951","_id":"6a00cb26e68ccb0bb6a86829","title":"Aim trainer","game":{"_id":"6953ea0148932c30bb5020fa","gameId":9800976141,"name":"Pandi's Aim Trainer","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":9800976141},"features":"Aimlock in pandis aim trainer","tags":["lock","aimbot"],"script":"loadstring(game:HttpGet(\"https://raw.githubusercontent.com/dosonggiakhanh-png/Aim-trainer/refs/heads/main/Lock\"))()\n","owner":{"_id":"67a8770d751757e8e4e5bc7c","username":"mikarosr","verified":false,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":null},"status":"offline","id":"67a8770d751757e8e4e5bc7c","profile":{"url":"https://media.kocakz.me/no-profile.webp","original":null}},"verifie