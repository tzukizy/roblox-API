{"id":82983707799188,"name":"[🚨LIMITED] WEAPON DUELS [Murderers vs Sheriffs]","desc":"🎃USE CODE \"PUMPKIN SPICE\"\n🍡USE CODE \"DANGO\"\n🦄USE CODE \"PONY\"\n\n🔥Welcome to Weapon Duels, where players compete in 1v1 to 4v4 duels using knives, guns, and abilities!\n\n1. Step on a duels pad to play!\n2. Earn coins to purchase cosmetics & abilities!\n3. Compete to reach the top of the leaderboards!\n4. Collect weapon skins, effects, finishers, titles, abilities, and reach level 50!\n\nJoin our server for codes!\nAsk one of the owners for a secret code😱\n\n⚠️Cheating, exploiting, alt farming, and abusing glitches will result in a permanent ban!\n\nInspired by Murder Mystery 2 (MM2), Murderers vs Sheriff Duels (MVSD), and Rivals. Credits to those games.","path":"/game/82983707799188-weapon-duels","slug":"82983707799188-weapon-duels","thumbnail":{"url":"https://media.kocakz.me/52183459ceed089309369d0f2c841bf10e1b45772817ebcece8e5487b194a172.webp","original":"https://tr.rbxcdn.com/180DAY-bb665484d5337127b39eb336c9c9471b/150/150/Image/Png/noFilter"},"playing":2737,"visitor":41428712,"verified":false,"updatedAt":"2026-10-19T14:42:39.952Z","creator":{"name":"Twin Comets","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"totalPages":1,"scripts":[{"_id":"6ad51dd0a8c1daa8d61902a5","title":"[LIMITED]  [Murderers vs Sheriffs]","game":{"_id":"698060bc10146ba1ee015381","gameId":82983707799188,"name":"[🚨LIMITED] WEAPON DUELS [Murderers vs Sheriffs]","imageUrl":{"url":"https://media.kocakz.me/52183459ceed089309369d0f2c841bf10e1b45772817ebcece8e5487b194a172.webp","original":"https://tr.rbxcdn.com/180DAY-bb665484d5337127b39eb336c9c9471b/150/150/Image/Png/noFilter"},"slug":"82983707799188-weapon-duels","path":"/game/82983707799188-weapon-duels","thumbnail":{"url":"https://media.kocakz.me/52183459ceed089309369d0f2c841bf10e1b45772817ebcece8e5487b194a172.webp","original":"https://tr.rbxcdn.com/180DAY-bb665484d5337127b39eb336c9c9471b/150/150/Image/Png/noFilter"},"placeId":82983707799188},"slug":"LIMITED-WEAPON-DUELS-Murderers-vs-Sheriffs-LIMITED-Murderers-vs-Sheriffs-232416","verified":false,"key":false,"keyless":false,"views":811,"executes":1211,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","indexUnlisted":false,"image":{"url":"https://media.kocakz.me/fe980621eb9a5d6c6c88b91e12ded28e8b7df6d2a82202c49cb317d511148045.webp","original":"https://scriptblox.com/images/sb/rbx-e2f42bf57d84e4bd4b802840a1c53bbf-932cd000878e.png","scriptblox":"https://scriptblox.com/images/script/rbx-e2f42bf57d84e4bd4b802840a1c53bbf-932cd000878e.png"},"thumbnail":{"url":"https://media.kocakz.me/fe980621eb9a5d6c6c88b91e12ded28e8b7df6d2a82202c49cb317d511148045.webp","original":"https://scriptblox.com/images/sb/rbx-e2f42bf57d84e4bd4b802840a1c53bbf-932cd000878e.png","scriptblox":"https://scriptblox.com/images/script/rbx-e2f42bf57d84e4bd4b802840a1c53bbf-932cd000878e.png"},"likeCount":7,"dislikeCount":0,"createdAt":"2026-10-18T19:28:16.355Z","updatedAt":"2026-10-18T19:28:16.355Z","lastBump":"2026-10-18T19:28:16.355Z","script":"-- Opens owned cases, including case rewards, until inventory is empty.\nlocal OPEN_LIMIT = math.huge\nlocal INTERVAL = 10\nlocal TIMEOUT = 20\nlocal env = getgenv()\nassert(game.PlaceId == 82983707799188, \"Unexpected place.\")\nassert(not env.WeaponDuelsCasesRunning, \"Opener already running.\")\nlocal RS = game:GetService(\"ReplicatedStorage\")\nlocal R = RS:WaitForChild(\"Remotes\", 10)\nassert(R and R:FindFirstChild(\"Crate\") and R:FindFirstChild(\"Inventory\"), \"Interface missing.\")\nlocal definitions = require(RS.Database.Modules.Crate)\nlocal Http = game:GetService(\"HttpService\")\nlocal report = {status=\"running\",sent=0,verified=0,rewards={}}\nenv.WeaponDuelsCaseReport = report\nenv.WeaponDuelsCasesRunning = true\nenv.WeaponDuelsCasesStop = false\nlocal active, unexpected, connection\n\nlocal function snapshot()\n    local done, ok, result = false, false, nil\n    task.spawn(function()\n        ok, result = pcall(function() return R.Inventory.GetInventory:InvokeServer() end)\n        done = true\n    end)\n    local deadline = os.clock() + TIMEOUT\n    repeat task.wait(0.1) until done or os.clock() >= deadline\n    assert(done and ok and type(result)==\"table\" and type(result.Crate)==\"table\", \"Inventory query failed.\")\n    local copy = {}\n    for name,n in pairs(result.Crate) do\n        assert(type(n)==\"number\" and n>=0 and n<math.huge and n%1==0, \"Invalid count.\")\n        copy[name]=n\n    end\n    return copy\nend\n\nlocal function matches(before, after, result)\n    local expected = table.clone(before)\n    expected[result.case] = (expected[result.case] or 0)-1\n    if definitions[result.reward] then\n        local d = definitions[result.case]\n        local item = d and d.Dictionary and d.Items[result.reward]\n        local amount = type(item)==\"table\" and (item.Amount or 1) or 1\n        expected[result.reward]=(expected[result.reward] or 0)+amount\n        result.awardedCases=amount\n    end\n    for name,n in pairs(expected) do if (after[name] or 0)~=n then return false end end\n    for name,n in pairs(after) do if (expected[name] or 0)~=n then return false end end\n    return true\nend\n\nlocal ok, err = xpcall(function()\n    connection=R.Crate.OnClientEvent:Connect(function(reward,name,chance)\n        if not active or active.result or name~=active.name or type(reward)~=\"string\" then\n            unexpected=true\n            return\n        end\n        active.result={case=name,reward=reward,chance=tonumber(chance)}\n    end)\n    local nextAllowed = os.clock() + INTERVAL\n    local lastName = \"\"\n    while report.verified < OPEN_LIMIT and not env.WeaponDuelsCasesStop do\n        while os.clock()<nextAllowed and not env.WeaponDuelsCasesStop do task.wait(0.2) end\n        if env.WeaponDuelsCasesStop then break end\n        assert(not unexpected, \"Unrelated opening detected; queue stopped.\")\n        local before=snapshot()\n        local names={}\n        for name,n in pairs(before) do if n>0 then table.insert(names,name) end end\n        table.sort(names)\n        report.remaining=before\n        if #names==0 then report.status=\"complete\"; return end\n        local name=names[1]\n        for _,candidate in ipairs(names) do\n            if candidate>lastName then name=candidate; break end\n        end\n        lastName=name\n        active={name=name}\n        report.sent+=1\n        R.Crate:FireServer(name)\n        nextAllowed=os.clock()+INTERVAL\n        local deadline=os.clock()+TIMEOUT\n        repeat task.wait(0.1) until active.result or unexpected or os.clock()>=deadline\n        assert(not unexpected, \"Unexpected result; stopped.\")\n        assert(active.result, \"No server acknowledgment; stopped without retrying.\")\n        local result=active.result\n        local after\n        repeat\n            after=snapshot()\n            if matches(before,after,result) then break end\n            task.wait(0.5)\n        until os.clock()>=deadline\n        assert(matches(before,after,result), \"Inventory mismatch; stopped.\")\n        assert(not unexpected, \"Extra result; stopped.\")\n        report.verified+=1\n        report.remaining=after\n        table.insert(report.rewards,result)\n        active=nil\n        print(\"[Cases] Verified\",report.verified,name,\"->\",result.reward)\n    end\n    report.status=env.WeaponDuelsCasesStop and \"stopped\" or \"test complete\"\nend,debug.traceback)\nif connection then connection:Disconnect() end\nenv.WeaponDuelsCasesRunning=false\nif not ok then report.status=\"error\"; report.error=tostring(err); warn(report.error) end\nprint(\"[Cases] Queue summary\",Http:JSONEncode(report))","features":"macro/auto open case","tags":[],"discord":"","keyLink":"","owner":{"_id":"69e2703d32b8b52c98cd7f33","username":"1kin","verified":false,"profilePicture":{"url":"https://media.kocakz.me/b54848ecc16fced4b74dc97d9