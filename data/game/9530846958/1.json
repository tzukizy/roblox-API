)\nlocal function getTRINKET()\n    local dist, thing = math.huge\n    for _,v in pairs(game:GetService(\"Workspace\").MouseIgnore:GetDescendants()) do\n        if v.Name == \"Clicker\" and v:IsA\"ClickDetector\" and v.Parent.Name == \"ClickPart\" then\n            local mag = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - v.Parent.Position).magnitude\n            if mag < dist then\n                dist = mag\n                thing = v\n            end\n        end\n    end\n    return thing\nend\n    Y.Toggle({\n    Text = \"Auto Pickup\",\n    Callback = function(Value)\n        a = Value\n        while a do task.wait()\n            pcall(function()\n                fireclickdetector(getTRINKET())\n                wait()\n            end)\n        end\n    end,\n    Enabled = false\n})\n","owner":{"_id":"624deedec1fdf4604e8735c0","username":"Keybrew","verified":true,"profilePicture":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/624deedec1fdf4604e8735c0-1658836770382.png"},"status":"offline","id":"624deedec1fdf4604e8735c0","topMilestone":{"key":"creator.views","tier":1000000},"profile":{"url":"https://media.kocakz.me/no-profile.webp","original":"https://scriptblox.com/images/photo/624deedec1fdf4604e8735c0-1658836770382.png"}},"verified":true,"views":12172,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","createdAt":"2022-06-21T21:35:36.908Z","dislikeCount":0,"likeCount":0,"image":{"url":"https://media.kocakz.me/no-script.webp","original":"https://tr.rbxcdn.com/29024709247d68089eec0e1585a1aa1e/500/280/Image/Jpeg","scriptblox":"https://tr.rbxcdn.com/29024709247d68089eec0e1585a1aa1e/500/280/Image/Jpeg"},"executes":27,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-17T02:18:53.701Z","last":"","win":14,"math":2},"thumbnail":{"u