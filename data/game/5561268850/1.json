{"id":5561268850,"name":"Randomly Generated Droids","desc":"","path":"/game/5561268850-randomly-generated-droids","slug":"5561268850-randomly-generated-droids","thumbnail":["https://tr.rbxcdn.com/180DAY-da39d8d76b8cf981b82e408b518599ef/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-01654b3b83d58d416d5764376ebb8f0a/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":393,"visitor":0,"verified":false,"updatedAt":"2026-05-06T18:51:19.706Z","creator":{"name":"Roblox","type":"User"},"script":{"count":7,"freeCount":7,"keyCount":0,"verifiedCount":1},"page":1,"next":null,"total":1,"scripts":[{"slug":"Randomly-Generated-Droids-AutoPlay-192609","_id":"69d32491d5b893ba7f2af952","title":"AutoPlay","game":{"_id":"67e5e1ffb360710ec3c7800a","gameId":5561268850,"name":"Randomly Generated Droids","imageUrl":"/images/sb/rbx-01654b3b83d58d416d5764376ebb8f0a-989a7aa3b802.png","placeId":5561268850},"features":"Automatically kills all droids\nPresses buttons\nCollects circuits\nAutomatically skips shops\nAutomatically kills friendly and lucky droids.\n\n(This script may die, but it is very very unlikely. This script only goes for Wrath, and you can't leave it running for it to do everything. You will have to use the Bat Wing, do slot machines for it.)\n\n(You need to walk near enemies for them to die.)\n\n(This script requires \"fireclickdetectors\" in your executor.)","tags":[],"script":"if not game.PlaceId == 6312903733 then\n    game:GetService(\"StarterGui\"):SetCore(\"SendNotification\",{\n        Title = \"RGD AutoPlay\",\n        Text = \"You must be in a match for this script to work.\"\n    })\n    return\nelse\n    game:GetService(\"StarterGui\"):SetCore(\"SendNotification\",{\n        Title = \"RGD AutoPlay\",\n        Text = \"Activated! Thank you for using my script!\"\n    })\n    print(\"RGD AutoPlay by @prefire\")\nend\n\nlocal player = game.Players.LocalPlayer\n\nlocal function killAll()\n    for _, v in workspace:GetChildren() do\n        if v:IsA(\"Model\") and v.Name == \"Room\" then\n            if v:FindFirstChild(\"Enemies\") then\n                for _, v in v.Enemies:GetChildren() do\n                    local hum = v:FindFirstChildOfClass(\"Humanoid\")\n                    if hum then\n                        hum.Health = 0\n                        if v.Name == \"Hunter Droid 3.0\" then\n                            player.Character.HumanoidRootPart.CFrame = v.Head.CFrame\n                        end\n                    else\n                        if v:FindFirstChildOfClass(\"ClickDetector\") then\n                            coroutine.wrap(function()\n                                player.Character.HumanoidRootPart.CFrame = v.CFrame\n                                task.wait(0.5)\n                                fireclickdetector(v:FindFirstChildOfClass(\"ClickDetector\"))\n                            end)()\n                        end\n                        if v.Name == \"SlotMachine\" then\n                            if v:FindFirstChild(\"Handle\") then\n                                if v:FindFirstChild(\"Ball\") then\n                                    if v:FindFirstChild(\"Attachment\") then\n                                        if v:FindFirstChild(\"ProximityPrompt\") then\n                                            fireproximityprompt(v:FindFirstChild(\"ProximityPrompt\"))\n                                        end\n                                    end\n                                end\n                            end\n                        end\n                        if v.Name == \"Bat Wing\" then\n                            player.Character.HumanoidRootPart.CFrame = v.Handle.CFrame\n                        end\n                    end\n                end\n            end\n            for _, v in v:GetChildren() do\n                if v.Name == \"Crystal\" then\n                    local hum = v:FindFirstChildOfClass(\"Humanoid\")\n                    if hum then\n                        hum.Health = 0\n                    end\n                end\n                if v.Name == \"Circuit\" or v.Name == \"BigCircuit\" then\n                    v.CanCollide = false\n                    v.CFrame = player.Character.HumanoidRootPart.CFrame\n                end\n                if v.Name == \"Laser\" then\n                    v.CanTouch = false\n                end\n            end\n        end\n    end\n\n    for _, v in workspace.PassiveDroids:GetChildren() do\n        if v.Name == \"Lucky Droid\" or v.Name == \"Friendly Droid\" then\n            local hum = v:FindFirstChildOfClass(\"Humanoid\")\n            if hum then\n                hum.Health = 0\n            end\n        end\n    end\nend\n\nlocal function bringCircuits()  \n    for _, v in workspace:GetChildren() do\n        if v.Name == \"Circuit\" or v.Name == \"BigCircuit\" then\n            v.CanCollide = false\n            v.CFrame = player.Character.HumanoidRootPart.CFrame\n        end\n    end\nend\n\nwhile task.wait(0.5) do\n    killAll()\n    bringCircuits()\nend","owner":{"_id":"67e4e9cc8f4e0d29f931647e","username":"prefire","verified":false,"profilePicture":"/images/photo/67e4e9cc8f4e0d29f931647e-1771912760185.png","status":"offline","id":"67e4e9cc8f4e0d29f931647e","topMilestone":{"key":"creator.first_script","tier":1}},"verified":false,"views":1300,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-01654b3b83d58d416d5764376ebb8f0a-989a7aa3b802.png","likeCount":2,"dislikeCount":0,"createdAt":"2026-04-06T03:12:17.918Z","keyLink":"","executes":362,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"69d32491d5b893ba7f2af955","editBy":{"_id":"67e4e9cc8f4e0d29f931647e","username":"prefire","status":"offline","id":"67e4e9cc8f4e0d29f931647e"},"message":"Create script","createdAt":"2026-04-06T03:12:17.922Z"}],"comments":[{"_id":"69d8e81df7f97e47aa3845b2","commentBy":{"_id