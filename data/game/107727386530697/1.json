{"id":107727386530697,"name":"[🏖️] Noob Mayhem!","desc":"The noobs are causing mayhem! Stop them before they take over Roblox!\n\nYou can play on any device. (CONSOLE, PC, MOBILE)\ndash = left shift\nshift lock = left ctrl\nemote = g\n\n[ THIS GAME IS IN ALPHA! EXPECT EVERYTHING TO CHANGE & FOR LOTS OF BUGS ]\nFrom the creators of Statue Defenders Go! Inspired by combat initiation!","path":"/game/107727386530697-noob-mayhem","slug":"107727386530697-noob-mayhem","thumbnail":{"url":"https://media.kocakz.me/f505ee9c817b69323ae698c9316c09e91fc283a5c1daa33af07933548cd1b7ab.webp","original":"https://tr.rbxcdn.com/180DAY-4f8be0420db55ab6d73f297f6aa85e65/150/150/Image/Png/noFilter"},"playing":658,"visitor":36454996,"verified":false,"updatedAt":"2026-08-08T23:16:42.543Z","creator":{"name":"Game Thing","type":"Group"},"script":{"count":2,"freeCount":2,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Noob-Mayhem!-Auto-kill-nearby-noobs-223028","_id":"6a77b8da6ac34beebc3276d3","title":"Auto kill nearby noobs","game":{"_id":"68830ec4d763eb3c46d0b6d2","gameId":107727386530697,"name":"[🏖️] Noob Mayhem!","imageUrl":{"url":"https://media.kocakz.me/no-game.webp","original":null},"thumbnail":{"url":"https://media.kocakz.me/no-game.webp","original":null},"placeId":107727386530697},"features":"all u do is enable it get close to a noob and it dies instantly.","tags":[],"script":"local Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal player = Players.LocalPlayer\n\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"NoobKiller\"\ngui.ResetOnSpawn = false\ngui.Parent = player:WaitForChild(\"PlayerGui\")\n\nlocal frame = Instance.new(\"Frame\")\nframe.Size = UDim2.new(0, 190, 0, 70)\nframe.Position = UDim2.new(0.5, -95, 0.5, -35)\nframe.BackgroundColor3 = Color3.fromRGB(25, 25, 25)\nframe.BorderSizePixel = 0\nframe.Active = true\nframe.Draggable = true\nframe.Parent = gui\n\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = UDim.new(0, 10)\ncorner.Parent = frame\n\nlocal title = Instance.new(\"TextLabel\")\ntitle.Size = UDim2.new(1, 0, 0, 28)\ntitle.BackgroundTransparency = 1\ntitle.Text = \"NOOB KILLER\"\ntitle.TextColor3 = Color3.fromRGB(255, 255, 255)\ntitle.TextSize = 16\ntitle.Font = Enum.Font.GothamBold\ntitle.Parent = frame\n\nlocal toggle = Instance.new(\"TextButton\")\ntoggle.Size = UDim2.new(1, -20, 0, 30)\ntoggle.Position = UDim2.new(0, 10, 0, 32)\ntoggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)\ntoggle.BorderSizePixel = 0\ntoggle.Text = \"OFF\"\ntoggle.TextColor3 = Color3.fromRGB(255, 255, 255)\ntoggle.TextSize = 14\ntoggle.Font = Enum.Font.GothamBold\ntoggle.Parent = frame\n\nlocal toggleCorner = Instance.new(\"UICorner\")\ntoggleCorner.CornerRadius = UDim.new(0, 7)\ntoggleCorner.Parent = toggle\n\nlocal enabled = false\n\nlocal function isNoobFolder(instance)\n\tif not instance:IsA(\"Folder\") then\n\t\treturn false\n\tend\n\n\tlocal name = instance.Name:lower()\n\n\treturn name == \"allnoobs\" or name:find(\"noob\", 1, true) ~= nil\nend\n\nlocal function killNoobs()\n\tfor _, object in ipairs(Workspace:GetDescendants()) do\n\t\tif isNoobFolder(object) then\n\t\t\tfor _, descendant in ipairs(object:GetDescendants()) do\n\t\t\t\tif descendant:IsA(\"Humanoid\") then\n\t\t\t\t\tdescendant.Health = 0\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\ntoggle.MouseButton1Click:Connect(function()\n\tenabled = not enabled\n\n\tif enabled then\n\t\ttoggle.Text = \"ON\"\n\t\ttoggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)\n\t\tkillNoobs()\n\telse\n\t\ttoggle.Text = \"OFF\"\n\t\ttoggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)\n\tend\nend)\n\ntask.spawn(function()\n\twhile gui.Parent do\n\t\tif enabled then\n\t\t\tkillNoobs()\n\t\tend\n\n\t\ttask.wait(0.15)\n\tend\nend)","owner":{"_id":"6808f55fd4e07b87e2c8d451","username":"darkonreal","verified":false,"profilePicture":{"url":"https://media.kocakz.me/cb9ded56ff4a5e8892b52035b5ca859414c5