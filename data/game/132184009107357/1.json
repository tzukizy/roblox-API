{"id":132184009107357,"name":"Slime Incremental: Revived","desc":"","path":"/game/132184009107357-slime-incremental-revived","slug":"132184009107357-slime-incremental-revived","thumbnail":["https://tr.rbxcdn.com/180DAY-a6a49f45036f4969ec0082b71c7a904a/150/150/Image/Png/noFilter","https://tr.rbxcdn.com/180DAY-3f1f59e74c5cc2f3a61acac026dcd081/150/150/Image/Png/noFilter","/brand/kocakz-logo.png"],"playing":0,"visitor":0,"verified":false,"updatedAt":"2026-07-10T17:25:42.921Z","creator":{"name":"Roblox","type":"User"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Slime-Incremental:-Revived-Auto-Collector-242255","_id":"6a512b168fddf2c57938f104","title":"Auto Collector","game":{"_id":"6a512b168fddf2c57938f103","gameId":132184009107357,"name":"Slime Incremental: Revived","imageUrl":"/images/sb/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png","placeId":132184009107357},"features":"for stop: reset\nmode: snake","tags":["vhs"],"script":"local step = 0.5\n\nlocal rs = game.RunService.RenderStepped\nlocal hrp = game.Players.LocalPlayer.Character.HumanoidRootPart\nlocal b = workspace.World.Map.MainBase\nlocal range = workspace.Collector.Size.Z\nlocal n = b.Size.X / range\nlocal s = range*n*-1/2\nlocal offset = Vector3.new(b.Position.X,0,b.Position.Z)\nwhile task.wait() do\n    for x=0.5,n,step do \n        for z=0.5,n,step do\n            hrp.CFrame = CFrame.new(s+(x*range),3,s+(z*range)) + offset\n            rs:wait()\n        end\n    end\nend\n","owner":{"_id":"66b9f4ca2fb4155fd40add65","username":"VHCK","verified":false,"profilePicture":"/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg","status":"offline","id":"66b9f4ca2fb4155fd40add65","topMilestone":{"key":"creator.followers","tier":10}},"verified":false,"views":1522,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":"/images/sb/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png","likeCount":1,"dislikeCount":0,"createdAt":"2026-07-10T17:25:42.922Z","executes":63,"keyless":false,"liked":false,"disliked":false,"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a512b168fddf2c57938f106","editBy":{"_id":"66b9f4ca2fb4155fd40add65","username":"VHCK","status":"offline","id":"66b9f4ca2fb4155fd40add65"},"message":"Create script","createdAt":"2026-07-10T17:25:42.924Z"}],"comments":[]}]}