{"id":132184009107357,"name":"Slime Incremental: Revived","desc":"Slime Incremental: Revived is a slime-collecting incremental simulator.\n\n💚 Collect Slimes  \n🛠️ Buy powerful upgrades  \n🔓 Unlock new systems by leveling up  \n💎 Find rare Slimes with special upgrades  \n🔮 Summon Amulets for extra boosts  \n✨ Use abilities to progress faster  \n🏆 Climb the leaderboards  \n\n✧ Premium players get a x1.5 Slimes boost!  \n✧ Join the group for a x1.2 Slimes boost!  \n\n👥 Credits Development  \nkomy4k, vvvjuniper, NotVoidWisp, 110Robin011\n\n🎶 Credits Music: @DMDOKURO\n\n👍 Like, ⭐ Favorite, and 🔔 Follow for updates,","path":"/game/132184009107357-slime-incremental-revived","slug":"132184009107357-slime-incremental-revived","thumbnail":{"url":"https://cdn.kocakz.me/images/74b33ba023c49f810f18be6df4e578f3130f3424c1992e11f64952de33e2ff6d.webp","original":"https://tr.rbxcdn.com/180DAY-a6a49f45036f4969ec0082b71c7a904a/150/150/Image/Png/noFilter"},"playing":0,"visitor":693206,"verified":false,"updatedAt":"2026-07-10T17:25:42.921Z","creator":{"name":"Dynasoft: Slime Incremental","type":"Group"},"script":{"count":1,"freeCount":1,"keyCount":0,"verifiedCount":0},"page":1,"next":null,"total":1,"scripts":[{"slug":"Slime-Incremental:-Revived-Auto-Collector-242255","_id":"6a512b168fddf2c57938f104","title":"Auto Collector","game":{"_id":"6a512b168fddf2c57938f103","gameId":132184009107357,"name":"Slime Incremental: Revived","imageUrl":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"thumbnail":{"url":"https://cdn.kocakz.me/images/no-game.webp","original":null},"placeId":132184009107357},"features":"for stop: reset\nmode: snake","tags":["vhs"],"script":"local step = 0.5\n\nlocal rs = game.RunService.RenderStepped\nlocal hrp = game.Players.LocalPlayer.Character.HumanoidRootPart\nlocal b = workspace.World.Map.MainBase\nlocal range = workspace.Collector.Size.Z\nlocal n = b.Size.X / range\nlocal s = range*n*-1/2\nlocal offset = Vector3.new(b.Position.X,0,b.Position.Z)\nwhile task.wait() do\n    for x=0.5,n,step do \n        for z=0.5,n,step do\n            hrp.CFrame = CFrame.new(s+(x*range),3,s+(z*range)) + offset\n            rs:wait()\n        end\n    end\nend\n","owner":{"_id":"66b9f4ca2fb4155fd40add65","username":"VHCK","verified":false,"profilePicture":{"url":"https://cdn.kocakz.me/images/d0edfeac08f938c79017d90334749732b736cf0325b29470d481486b0c28c44f.webp","original":"https://scriptblox.com/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg"},"status":"offline","id":"66b9f4ca2fb4155fd40add65","topMilestone":{"key":"creator.followers","tier":10},"profile":{"url":"https://cdn.kocakz.me/images/d0edfeac08f938c79017d90334749732b736cf0325b29470d481486b0c28c44f.webp","original":"https://scriptblox.com/images/photo/66b9f4ca2fb4155fd40add65-1726310501522.jpg"}},"verified":false,"views":1532,"scriptType":"free","isUniversal":false,"isPatched":false,"visibility":"public","image":{"url":"https://cdn.kocakz.me/images/77aa7d3764122fffbe4849fe139ca15f7f99f51aa5e242aefd56db6e04eccc1b.webp","original":"https://scriptblox.com/images/sb/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png","scriptblox":"https://scriptblox.com/images/script/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png"},"likeCount":1,"dislikeCount":0,"createdAt":"2026-07-10T17:25:42.922Z","executes":81,"keyless":false,"liked":false,"disliked":false,"cstatus":{"verdict":"none","pct":null,"conf":0,"n":{"w":0,"b":0,"p":0,"d":0,"k":0},"total":0,"detected":false,"key":false,"recent":0,"at":"2026-10-16T02:13:51.603Z","last":"","win":14,"math":2},"thumbnail":{"url":"https://cdn.kocakz.me/images/77aa7d3764122fffbe4849fe139ca15f7f99f51aa5e242aefd56db6e04eccc1b.webp","original":"https://scriptblox.com/images/sb/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png","scriptblox":"https://scriptblox.com/images/script/rbx-3f1f59e74c5cc2f3a61acac026dcd081-daa490cbc172.png"},"isHub":false,"supportedGames":[],"changelog":[{"_id":"6a512b168fddf2c57938f106","editBy":{"_id":"66b9f